<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.DropdownButton.DropdownButtonShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.DropdownButton"
             x:DataType="vm:DropdownButtonViewModel"
             x:CompileBindings="True">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="DropdownButton"
                    Category="{gallery:DropdownButtonShowCaseLangResource ComponentCategory}"
                    Status="{gallery:DropdownButtonShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:DropdownButtonShowCaseLangResource PageSubtitle}"
                    Description="{gallery:DropdownButtonShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="Button" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:DropdownButtonViewModel">
                    <gallery:SemanticPartPreview Name="DropdownButtonSemanticPreview"
                                                 Title="DropdownButton"
                                                 Loaded="HandleSemanticPreviewLoaded"
                                                 Unloaded="HandleSemanticPreviewUnloaded"
                                                 SemanticOwner="{Binding #DropdownButtonSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:DropdownButton}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:DropdownButton Name="DropdownButtonSemanticOwner"
                                                 ButtonType="Link"
                                                 TriggerType="Hover"
                                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentHoverMe}"
                                                 IsMotionEnabled="False"
                                                 IsPopupPinnedOpen="True">
                                <atom:DropdownButton.DropdownFlyout>
                                    <atom:MenuFlyout>
                                        <atom:MenuItemGroup Header="{gallery:DropdownButtonShowCaseLangResource SemanticPreviewGroupTitle}">
                                            <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticPreviewFirstMenuItem}"
                                                           Icon="{antdicons:AntDesignIconProvider Kind=SaveOutlined}" />
                                            <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticPreviewSecondMenuItem}"
                                                           Icon="{antdicons:AntDesignIconProvider Kind=EditOutlined}" />
                                        </atom:MenuItemGroup>
                                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticPreviewSubMenu}"
                                                       IsSubMenuOpen="True">
                                            <atom:MenuItemGroup Header="{gallery:DropdownButtonShowCaseLangResource SemanticPreviewItem1}">
                                                <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticPreviewOption1}" />
                                                <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticPreviewOption2}" />
                                            </atom:MenuItemGroup>
                                        </atom:MenuItem>
                                        <atom:MenuSeparator />
                                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}"
                                                       Foreground="{atom:SharedTokenResource ColorError}"
                                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                                    </atom:MenuFlyout>
                                </atom:DropdownButton.DropdownFlyout>
                            </atom:DropdownButton>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription Path="popup.root"
                                Description="{gallery:DropdownButtonShowCaseLangResource SemanticPopupRootDescription}" />
                            <gallery:SemanticPartDescription Path="itemTitle"
                                Description="{gallery:DropdownButtonShowCaseLangResource SemanticItemTitleDescription}" />
                            <gallery:SemanticPartDescription Path="item"
                                Description="{gallery:DropdownButtonShowCaseLangResource SemanticItemDescription}" />
                            <gallery:SemanticPartDescription Path="itemContent"
                                Description="{gallery:DropdownButtonShowCaseLangResource SemanticItemContentDescription}" />
                            <gallery:SemanticPartDescription Path="itemIcon"
                                Description="{gallery:DropdownButtonShowCaseLangResource SemanticItemIconDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:DropdownButtonShowCaseLangResource BasicTitle}"
        Description="{gallery:DropdownButtonShowCaseLangResource BasicDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DropdownButtonViewModel">
        <atom:DropdownButton ButtonType="Link" TriggerType="Hover" x:Name="Test" Content="{gallery:DropdownButtonShowCaseLangResource P2ContentHoverMe}">
            <atom:DropdownButton.DropdownFlyout>
                <atom:MenuFlyout>
                    <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                   Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                    <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C" Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                    <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                   Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderPaste}">
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderPaste}" InputGesture="Ctrl+P"
                                       Icon="{antdicons:AntDesignIconProvider Kind=FileDoneOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderPasteFromHistory}" InputGesture="Ctrl+Shift+V" />
                    </atom:MenuItem>
                </atom:MenuFlyout>
            </atom:DropdownButton.DropdownFlyout>
        </atom:DropdownButton>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DropdownButtonShowCaseLangResource ButtonTypesTitle}"
        Description="{gallery:DropdownButtonShowCaseLangResource ButtonTypesDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DropdownButtonViewModel">
        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
            <atom:DropdownButton ButtonType="Primary" TriggerType="Click" Content="{gallery:DropdownButtonShowCaseLangResource P2ContentEditFile}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderPaste}">
                            <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderPaste}" InputGesture="Ctrl+P"
                                           Icon="{antdicons:AntDesignIconProvider Kind=FileDoneOutlined}" />
                            <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderPasteFromHistory}" InputGesture="Ctrl+Shift+V" />
                        </atom:MenuItem>
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Primary" Shape="Round" TriggerType="Click" Content="{gallery:DropdownButtonShowCaseLangResource P2ContentEditFile}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Click" Content="{gallery:DropdownButtonShowCaseLangResource P2ContentEditFile}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Text" TriggerType="Click" Content="{gallery:DropdownButtonShowCaseLangResource P2ContentEditFile}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>
        </WrapPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DropdownButtonShowCaseLangResource SizeTypeTitle}"
        Description="{gallery:DropdownButtonShowCaseLangResource SizeTypeDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DropdownButtonViewModel">
        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
            <atom:DropdownButton ButtonType="Primary"
                                 SizeType="Large"
                                 TriggerType="Click"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentLarge}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default"
                                 SizeType="Middle"
                                 TriggerType="Click"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentMiddle}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default"
                                 SizeType="Small"
                                 TriggerType="Click"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentSmall}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Primary"
                                 SizeType="Custom"
                                 Height="44"
                                 Padding="18,0"
                                 FontSize="15"
                                 TriggerType="Click"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentCustom}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>
        </WrapPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DropdownButtonShowCaseLangResource ArrowTitle}"
        Description="{gallery:DropdownButtonShowCaseLangResource ArrowDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.Styles>
            <Style Selector="atom|DropdownButton">
                <Setter Property="Margin" Value="5" />
            </Style>
        </gallery:ShowCaseItem.Styles>
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DropdownButtonViewModel">
        <WrapPanel>
            <atom:DropdownButton ButtonType="Default" TriggerType="Hover" IsArrowVisible="True"
                                 Placement="BottomEdgeAlignedLeft"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentBottomLeft}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover" IsArrowVisible="True"
                                 Placement="Bottom"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentBottom}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover" IsArrowVisible="True"
                                 Placement="BottomEdgeAlignedRight"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentBottomRight}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover" IsArrowVisible="True"
                                 Placement="TopEdgeAlignedLeft"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentTopLeft}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover" IsArrowVisible="True"
                                 Placement="Top"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentTop}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover" IsArrowVisible="True"
                                 Placement="TopEdgeAlignedRight"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentTopRight}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>
        </WrapPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DropdownButtonShowCaseLangResource PlacementTitle}"
        Description="{gallery:DropdownButtonShowCaseLangResource PlacementDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.Styles>
            <Style Selector="atom|DropdownButton">
                <Setter Property="Margin" Value="5" />
            </Style>
        </gallery:ShowCaseItem.Styles>
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DropdownButtonViewModel">
        <WrapPanel>
            <atom:DropdownButton ButtonType="Default" TriggerType="Hover"
                                 Placement="BottomEdgeAlignedLeft"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentBottomLeft}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover"
                                 Placement="Bottom"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentBottom}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover"
                                 Placement="BottomEdgeAlignedRight"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentBottomRight}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover"
                                 Placement="TopEdgeAlignedLeft"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentTopLeft}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover"
                                 Placement="Top"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentTop}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>

            <atom:DropdownButton ButtonType="Default" TriggerType="Hover"
                                 Placement="TopEdgeAlignedRight"
                                 Content="{gallery:DropdownButtonShowCaseLangResource P2ContentTopRight}">
                <atom:DropdownButton.DropdownFlyout>
                    <atom:MenuFlyout>
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C"
                                       Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    </atom:MenuFlyout>
                </atom:DropdownButton.DropdownFlyout>
            </atom:DropdownButton>
        </WrapPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DropdownButtonShowCaseLangResource SemanticStylesTitle}"
        Description="{gallery:DropdownButtonShowCaseLangResource SemanticStylesDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DropdownButtonViewModel">
                <StackPanel Spacing="24">
                    <atom:DropdownButton Classes="semantic-object-style-demo"
                                         IsPopupMatchSelectWidth="True"
                                         Content="{gallery:DropdownButtonShowCaseLangResource SemanticStylesObjectButton}">
                        <atom:DropdownButton.DropdownFlyout>
                            <atom:MenuFlyout>
                                <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticStylesItemProfile}" />
                                <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticStylesItemSettings}"
                                               Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}" />
                                <atom:MenuSeparator />
                                <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticStylesItemLogout}"
                                               Foreground="{atom:SharedTokenResource ColorError}"
                                               Icon="{antdicons:AntDesignIconProvider Kind=LogoutOutlined}" />
                            </atom:MenuFlyout>
                        </atom:DropdownButton.DropdownFlyout>
                        <atom:DropdownButton.Styles>
                            <Style Selector="atom|DropdownButton.semantic-object-style-demo">
                                <atom:DropdownButtonPopupRootStyle x:SetterTargetType="atom:ArrowDecoratedBox">
                                    <Setter Property="BorderBrush" Value="#d9d9d9" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="4" />
                                </atom:DropdownButtonPopupRootStyle>
                                <atom:DropdownButtonItemStyle x:SetterTargetType="atom:MenuItem">
                                    <Setter Property="Foreground" Value="#1677ff" />
                                </atom:DropdownButtonItemStyle>
                                <atom:DropdownButtonItemIconStyle x:SetterTargetType="atom:IconPresenter">
                                    <Setter Property="Opacity" Value="0.6" />
                                </atom:DropdownButtonItemIconStyle>
                                <atom:DropdownButtonItemContentStyle x:SetterTargetType="ContentPresenter">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </atom:DropdownButtonItemContentStyle>
                            </Style>
                        </atom:DropdownButton.Styles>
                    </atom:DropdownButton>

                    <atom:DropdownButton Classes="semantic-function-style-demo"
                                         ButtonType="Primary"
                                         TriggerType="Click"
                                         IsPopupMatchSelectWidth="True"
                                         Content="{gallery:DropdownButtonShowCaseLangResource SemanticStylesFunctionButton}">
                        <atom:DropdownButton.DropdownFlyout>
                            <atom:MenuFlyout>
                                <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticStylesItemProfile}" />
                                <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticStylesItemSettings}"
                                               Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}" />
                                <atom:MenuSeparator />
                                <atom:MenuItem Header="{gallery:DropdownButtonShowCaseLangResource SemanticStylesItemLogout}"
                                               Foreground="{atom:SharedTokenResource ColorError}"
                                               Icon="{antdicons:AntDesignIconProvider Kind=LogoutOutlined}" />
                            </atom:MenuFlyout>
                        </atom:DropdownButton.DropdownFlyout>
                        <atom:DropdownButton.Styles>
                            <Style Selector="atom|DropdownButton.semantic-function-style-demo">
                                <atom:DropdownButtonPopupRootStyle x:SetterTargetType="atom:ArrowDecoratedBox">
                                    <Setter Property="BorderBrush" Value="#1890ff" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </atom:DropdownButtonPopupRootStyle>
                            </Style>
                        </atom:DropdownButton.Styles>
                    </atom:DropdownButton>
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
