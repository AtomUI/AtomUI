<ControlTheme xmlns:tokeninputs="using:AtomUI.Desktop.Controls.Internal.DateViewer" xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:viewer="clr-namespace:AtomUI.Desktop.Controls.Internal.DateViewer"
              x:Class="AtomUI.Desktop.Controls.Themes.DateViewerCellTheme"
              x:ClassModifier="internal" TargetType="viewer:DateViewerCell">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <ControlTheme.Resources>
        <atom:CornerRadiusFilterConverter x:Key="StartCorners" TopRight="False" BottomRight="False" />
        <atom:CornerRadiusFilterConverter x:Key="EndCorners" TopLeft="False" BottomLeft="False" />
    </ControlTheme.Resources>
    <Setter Property="MinHeight" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.CellRowHeight)}" />
    <Setter Property="Template">
        <ControlTemplate TargetType="viewer:DateViewerCell">
            <Border Name="PART_CellRoot" Background="Transparent">
                <Grid Name="PART_Layout" RowDefinitions="Auto,*">
                    <Border Name="PART_CellSurface" Grid.RowSpan="2" />
                    <Grid Grid.Row="0" ColumnDefinitions="*,*">
                        <Border Name="PART_RangeMiddle" Grid.ColumnSpan="2" IsVisible="False"
                                Background="{CompiledBinding $self.(tokeninputs:DateViewerCell.RangeCellBackground)}" />
                        <Border Name="PART_RangeStart" Grid.Column="1" IsVisible="False"
                                Background="{CompiledBinding $self.(tokeninputs:DateViewerCell.RangeCellBackground)}" />
                        <Border Name="PART_RangeEnd" Grid.Column="0" IsVisible="False"
                                Background="{CompiledBinding $self.(tokeninputs:DateViewerCell.RangeCellBackground)}" />
                        <Border Name="PART_WeekSelection" Grid.ColumnSpan="2" />
                    </Grid>
                    <!-- The cell has no focus visual of its own, so the shared outline wraps the rounded value
                         frame instead of the whole column-wide cell. -->
                    <Border Name="PART_ValueFrame" Grid.Row="0"
                            TemplatedControl.IsTemplateFocusTarget="True"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <atom:TextBlock Name="PART_Value" Text="{TemplateBinding DisplayText}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ContentControl Name="PART_CellContent" Classes.semantic-cell-content="True" Grid.Row="1"
                                    Content="{TemplateBinding Context}" ContentTemplate="{TemplateBinding CellTemplate}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    IsVisible="False" />
                </Grid>
            </Border>
        </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
    <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
    <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
    <Style Selector="^ /template/ Border#PART_ValueFrame">
        <Setter Property="Background" Value="{TemplateBinding Background}" />
        <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
        <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}" />
        <Setter Property="MinWidth" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.CellWidth)}" />
        <Setter Property="MinHeight" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.CellHeight)}" />
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
    </Style>
    <Style Selector="^[IsMotionEnabled=True] /template/ Border#PART_ValueFrame">
        <Setter Property="Transitions">
            <atom:TokenTransitions>
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="StateTransitionDuration" />
                </Transitions>
            </atom:TokenTransitions>
        </Setter>
    </Style>
    <!-- The compact cell's text (the contrast colour on a selected cell) changes with the value frame's background,
         over the same duration, so light text never sits on the not-yet-filled background. The content presentation
         sets its own transitions below. -->
    <Style Selector="^[IsMotionEnabled=True][Presentation=Compact] /template/ atom|TextBlock#PART_Value">
        <Setter Property="Transitions">
            <atom:TokenTransitions>
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="StateTransitionDuration" />
                </Transitions>
            </atom:TokenTransitions>
        </Setter>
    </Style>
    <Style Selector="^ /template/ Border#PART_WeekSelection">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:week-mode /template/ Border#PART_WeekSelection">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[IsMotionEnabled=True]:week-mode /template/ Border#PART_WeekSelection">
        <Setter Property="Transitions">
            <atom:TokenTransitions>
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="StateTransitionDuration" />
                </Transitions>
            </atom:TokenTransitions>
        </Setter>
    </Style>
    <Style Selector="^:date">
        <Setter Property="CornerRadius" Value="{CompiledBinding $parent[viewer:DatePanel].CellCornerRadius}" />
    </Style>
    <!-- Today's fill and text sit before the hover, selected, range, outside and disabled styles, which win over them. -->
    <Style Selector="^:today:date:not(:disabled)">
        <Setter Property="Background" Value="{CompiledBinding $parent[viewer:DatePanel].CellTodayBg}" />
        <Setter Property="Foreground" Value="{CompiledBinding $parent[viewer:DatePanel].CellTodayColor}" />
        <Setter Property="BorderBrush" Value="{CompiledBinding $parent[viewer:DatePanel].CellTodayBorderColor}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
    </Style>
    <Style Selector="^:month /template/ Border#PART_ValueFrame, ^:quarter /template/ Border#PART_ValueFrame, ^:year /template/ Border#PART_ValueFrame">
        <Setter Property="Width" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.PeriodCellWidth)}" />
        <Setter Property="Padding" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.PeriodCellPadding)}" />
    </Style>
    <!-- The range middle draws the selected-item text (ControlItemColorActive, the body text by default) where its
         CellRangeBg (ControlItemBgActive) background is shown; keyboard-current, week-selection, outside and disabled
         cells set their own colours after this style. -->
    <Style Selector="^:range-middle:not(:week-mode):not(:has-preview):not(:outside), ^:range-preview-middle:not(:week-mode):not(:outside), ^:week-mode:range-middle, ^:week-mode:range-preview-middle">
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ControlItemColorActive}" />
    </Style>
    <Style Selector="^:visual-endpoint:not(:disabled), ^:navigation-current:not(:disabled)">
        <Setter Property="Background" Value="{atom:OwnerTokenResource ColorPrimary}" />
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextLightSolid}" />
    </Style>
    <Style Selector="^:range-middle:not(:week-mode):not(:has-preview):not(:outside) /template/ Border#PART_RangeMiddle, ^:range-preview-middle:not(:week-mode):not(:outside) /template/ Border#PART_RangeMiddle">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:range-start:not(:week-mode):not(:range-end):not(:has-preview):not(:outside) /template/ Border#PART_RangeStart, ^:range-preview-start:not(:week-mode):not(:range-preview-end):not(:outside) /template/ Border#PART_RangeStart">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:range-end:not(:week-mode):not(:range-start):not(:has-preview):not(:outside) /template/ Border#PART_RangeEnd, ^:range-preview-end:not(:week-mode):not(:range-preview-start):not(:outside) /template/ Border#PART_RangeEnd">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:week-mode /template/ Border#PART_RangeMiddle, ^:week-mode /template/ Border#PART_RangeStart, ^:week-mode /template/ Border#PART_RangeEnd">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:range-start:not(:range-end):not(:range-preview-end) /template/ Border#PART_ValueFrame, ^:range-preview-start:not(:range-end):not(:range-preview-end) /template/ Border#PART_ValueFrame">
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=viewer:DateViewerCell}, Converter={StaticResource StartCorners}}" />
    </Style>
    <Style Selector="^:range-end:not(:range-start):not(:range-preview-start) /template/ Border#PART_ValueFrame, ^:range-preview-end:not(:range-start):not(:range-preview-start) /template/ Border#PART_ValueFrame">
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=viewer:DateViewerCell}, Converter={StaticResource EndCorners}}" />
    </Style>
    <Style Selector="^:week-selection-start, ^:week-selection-middle, ^:week-selection-end, ^:week-mode:hovered">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextLightSolid}" />
    </Style>
    <Style Selector="^:week-selection-start /template/ Border#PART_WeekSelection, ^:week-selection-middle /template/ Border#PART_WeekSelection, ^:week-selection-end /template/ Border#PART_WeekSelection, ^:week-mode:hovered /template/ Border#PART_WeekSelection">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="{atom:OwnerTokenResource ColorPrimary}" />
    </Style>
    <Style Selector="^:week-mode:range-middle /template/ Border#PART_WeekSelection, ^:week-mode:range-preview-middle /template/ Border#PART_WeekSelection">
        <Setter Property="Background" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.RangeCellBackground)}" />
    </Style>
    <Style Selector="^:week-selection-start /template/ Border#PART_WeekSelection">
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource StartCorners}}" />
    </Style>
    <Style Selector="^:week-selection-end /template/ Border#PART_WeekSelection">
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource EndCorners}}" />
    </Style>
    <Style Selector="^:week-mode:week /template/ Border#PART_WeekSelection">
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource StartCorners}}" />
    </Style>
    <Style Selector="^:week-mode:last-week-day /template/ Border#PART_WeekSelection">
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource EndCorners}}" />
    </Style>
    <Style Selector="^ /template/ Border#PART_RangeMiddle, ^ /template/ Border#PART_RangeStart, ^ /template/ Border#PART_RangeEnd, ^ /template/ Border#PART_WeekSelection">
        <Setter Property="Height" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.CellHeight)}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <!-- :hovered also marks the cell a picker input reaches with navigation keys while the pointer is elsewhere. -->
    <Style Selector="^:pointerover:not(:week-mode):not(:selected):not(:disabled):not(:navigation-current):not(:range-start):not(:range-middle):not(:range-end):not(:range-preview-start):not(:range-preview-middle):not(:range-preview-end):not(:week-selection-start):not(:week-selection-middle):not(:week-selection-end), ^:hovered:not(:week-mode):not(:selected):not(:disabled):not(:navigation-current):not(:range-start):not(:range-middle):not(:range-end):not(:range-preview-start):not(:range-preview-middle):not(:range-preview-end):not(:week-selection-start):not(:week-selection-middle):not(:week-selection-end)">
        <Setter Property="Background" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.CellHoverBackground)}" />
    </Style>
    <Style Selector="^:outside">
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
    </Style>
    <Style Selector="^:week">
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
    </Style>
    <Style Selector="^:week-selection-start, ^:week-selection-middle, ^:week-selection-end, ^:week-mode:hovered">
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextLightSolid}" />
    </Style>
    <Style Selector="^:week-mode:week /template/ atom|TextBlock#PART_Value">
        <Setter Property="Opacity" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.WeekNumberOpacity)}" />
    </Style>
    <Style Selector="^:disabled">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
    </Style>
    <Style Selector="^:cell-template /template/ ContentControl#PART_CellContent">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:full-template /template/ ContentControl#PART_CellContent">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.RowSpan" Value="2" />
        <Setter Property="ContentTemplate" Value="{TemplateBinding EffectiveFullCellTemplate}" />
    </Style>
    <Style Selector="^:full-template /template/ Border#PART_ValueFrame">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[Presentation=Content]">
        <Setter Property="MinHeight" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.ContentCellMinHeight)}" />
    </Style>
    <Style Selector="^[Presentation=Content] /template/ Border#PART_CellSurface">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorSplit}" />
        <Setter Property="BorderThickness" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.ContentCellTopBorderThickness)}" />
        <Setter Property="Margin" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.ContentCellSurfaceMargin)}" />
    </Style>
    <Style Selector="^[Presentation=Content] /template/ Border#PART_ValueFrame">
        <Setter Property="Margin" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.ContentCellValueMargin)}" />
    </Style>
    <Style Selector="^[Presentation=Content] /template/ ContentControl#PART_CellContent">
        <Setter Property="Margin" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.ContentCellContentMargin)}" />
    </Style>
    <Style Selector="^[Presentation=Content]:full-template /template/ ContentControl#PART_CellContent">
        <Setter Property="Margin" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.ContentCellValueMargin)}" />
    </Style>
    <Style Selector="^[Presentation=Content][IsMotionEnabled=True] /template/ Border#PART_CellSurface">
        <Setter Property="Transitions">
            <atom:TokenTransitions>
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="StateTransitionDurationSlow" />
                </Transitions>
            </atom:TokenTransitions>
        </Setter>
    </Style>
    <Style Selector="^[Presentation=Content][IsMotionEnabled=True] /template/ atom|TextBlock#PART_Value">
        <Setter Property="Transitions">
            <atom:TokenTransitions>
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="StateTransitionDurationSlow" />
                </Transitions>
            </atom:TokenTransitions>
        </Setter>
    </Style>
    <Style Selector="^[Presentation=Content] /template/ Border#PART_ValueFrame">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="^[Presentation=Content]:today:date:not(:disabled) /template/ Border#PART_CellSurface">
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorPrimary}" />
    </Style>
    <Style Selector="^[Presentation=Content]:today:date:not(:week-mode):not(:visual-endpoint):not(:range-middle):not(:range-preview-middle)">
        <Setter Property="Foreground" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.ActiveCellForeground)}" />
    </Style>
    <Style Selector="^[Presentation=Content]:today:date:not(:week-mode):not(:visual-endpoint):not(:range-middle):not(:range-preview-middle) /template/ Border#PART_CellSurface">
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorPrimary}" />
        <Setter Property="Background" Value="{atom:OwnerTokenResource ControlItemBgActive}" />
    </Style>
    <Style Selector="^[Presentation=Content]:selected:not(:range-start):not(:range-end)">
        <Setter Property="Foreground" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.ActiveCellForeground)}" />
    </Style>
    <Style Selector="^[Presentation=Content]:selected:not(:range-start):not(:range-end) /template/ Border#PART_CellSurface">
        <Setter Property="Background" Value="{atom:OwnerTokenResource ControlItemBgActive}" />
    </Style>
    <Style Selector="^[Presentation=Content]:range-start /template/ Border#PART_ValueFrame">
        <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
    <Style Selector="^[Presentation=Content]:range-end /template/ Border#PART_ValueFrame">
        <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
    <Style Selector="^[Presentation=Content]:range-preview-start /template/ Border#PART_ValueFrame">
        <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
    <Style Selector="^[Presentation=Content]:range-preview-end /template/ Border#PART_ValueFrame">
        <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
    <Style Selector="^[Presentation=Content]:range-start /template/ Border#PART_ValueFrame, ^[Presentation=Content]:range-end /template/ Border#PART_ValueFrame, ^[Presentation=Content]:range-preview-start /template/ Border#PART_ValueFrame, ^[Presentation=Content]:range-preview-end /template/ Border#PART_ValueFrame">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[Presentation=Content]:pointerover:not(:selected):not(:disabled):not(:week) /template/ Border#PART_CellSurface">
        <Setter Property="Background" Value="{atom:OwnerTokenResource ControlItemBgHover}" />
    </Style>
    <Style Selector="^[Presentation=Compact] /template/ Grid#PART_Layout">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ControlTheme>
