<!-- owner: public TextArea keeps its identity; internal Mentions/AutoComplete textarea parts inherit their host. -->
<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal"
    x:Class="AtomUI.Desktop.Controls.Themes.TextAreaTheme" TargetType="atom:TextArea">
    <ControlTheme.Resources>
        <atom:PlaceholderHorizontalAlignmentConverter x:Key="PlaceholderHorizontalAlignmentConverter" />
    </ControlTheme.Resources>

    <!-- Focus is shown by the input frame (border + outline shadow), not a separate adorner. -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <!-- The focus outline shadow is drawn outside the input frame and must not be clipped by the host. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:TextArea">
            <atom:InputAccessoryDockPanel LastChildFill="True"
                       Height="{TemplateBinding Height}">
                <atom:InputAccessoryDockPanel.CountTemplate>
                    <DataTemplate>
                        <atom:TextBlock Name="TextCountIndicator"
                                        Classes.semantic-count="True"
                                        DockPanel.Dock="Bottom"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Text="{Binding $parent[atom:TextArea].CountText}"
                                        IsVisible="{Binding $parent[atom:TextArea].IsShowCount}" />
                    </DataTemplate>
                </atom:InputAccessoryDockPanel.CountTemplate>
                <Panel>
                    <atom:TextAreaDecoratedBox
                        Name="{x:Static atom:AddOnDecoratedBox.AddOnDecoratedBoxPart}"
                        Classes.semantic-scope-input-frame="True"
                        StyleVariant="{TemplateBinding StyleVariant}"
                        SizeType="{TemplateBinding SizeType}"
                        Status="{TemplateBinding Status}"
                        FormStatus="{TemplateBinding FormStatus}"
                        IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                        HostBorderBrush="{TemplateBinding BorderBrush}"
                        HostBackground="{TemplateBinding Background}"
                        DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                        Focusable="True"
                        IsTabStop="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsResizable="{TemplateBinding IsResizable}"
                        IsAllowAutoHide="{TemplateBinding ScrollViewer.AllowAutoHide}"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                        IsScrollChainingEnabled="{TemplateBinding ScrollViewer.IsScrollChainingEnabled}">
                        <atom:TextAreaDecoratedBox.ContentLeftAddOn>
                            <atom:AddOnContentPresenter
                                Classes.semantic-prefix="True"
                                Content="{Binding InnerLeftContent, RelativeSource={RelativeSource AncestorType=atom:TextArea}}"
                                ContentTemplate="{Binding InnerLeftContentTemplate, RelativeSource={RelativeSource AncestorType=atom:TextArea}}"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"
                                Focusable="False" />
                        </atom:TextAreaDecoratedBox.ContentLeftAddOn>
                        <atom:TextAreaDecoratedBox.ContentRightAddOn>
                            <atom:InputAccessoryPanel Orientation="Vertical"
                                        Classes.semantic-suffix="True"
                                        Spacing="{atom:OwnerTokenResource UniformlyPaddingXXS}">
                                <atom:InputAccessoryPanel.ClearButtonTemplate>
                                    <DataTemplate>
                                        <atom:InputClearIconButton
                                            Name="PART_ClearButton"
                                            Classes.semantic-clear="True"
                                            VerticalAlignment="Center"
                                            Icon="{Binding $parent[atom:TextArea].ClearIcon}"
                                            IsVisible="{Binding $parent[atom:TextArea].IsEffectiveShowClearButton}"
                                            IsMotionEnabled="{Binding $parent[atom:TextArea].IsMotionEnabled}" />
                                    </DataTemplate>
                                </atom:InputAccessoryPanel.ClearButtonTemplate>
                                <ContentPresenter
                                    Name="PART_FormFeedBack"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Content="{Binding $parent[atom:TextArea].FormFeedback}"
                                    IsVisible="{Binding $parent[atom:TextArea].IsFormFeedbackVisible}" />
                                <atom:AddOnContentPresenter
                                    Name="PART_InnerRightContentPresenter"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Focusable="False"
                                    Content="{Binding $parent[atom:TextArea].InnerRightContent}"
                                    ContentTemplate="{Binding $parent[atom:TextArea].InnerRightContentTemplate}" />
                            </atom:InputAccessoryPanel>
                        </atom:TextAreaDecoratedBox.ContentRightAddOn>

                        <Panel Name="ContentLayout" Classes.semantic-content="True">
                            <atom:TextBlock
                                Name="Placeholder"
                                Classes.semantic-placeholder="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment, Converter={StaticResource PlaceholderHorizontalAlignmentConverter}}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Text="{TemplateBinding PlaceholderText}"
                                Foreground="{TemplateBinding PlaceholderForeground}"
                                LineHeight="{TemplateBinding LineHeight}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextWrapping="{TemplateBinding TextWrapping}"
                                IsVisible="{TemplateBinding IsPlaceholderTextVisible}" />
                            <TextPresenter
                                Name="PART_TextPresenter"
                                Classes.semantic-textarea="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                CaretBrush="{TemplateBinding CaretBrush}"
                                CaretIndex="{TemplateBinding CaretIndex}"
                                LineHeight="{TemplateBinding LineHeight}"
                                PasswordChar="{TemplateBinding PasswordChar}"
                                RevealPassword="{TemplateBinding RevealPassword}"
                                SelectionBrush="{TemplateBinding SelectionBrush}"
                                SelectionStart="{TemplateBinding SelectionStart}"
                                SelectionEnd="{TemplateBinding SelectionEnd}"
                                SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                Text="{TemplateBinding Text, Mode=TwoWay}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextWrapping="{TemplateBinding TextWrapping}"
                                Focusable="False" />
                        </Panel>
                    </atom:TextAreaDecoratedBox>
                    <atom:ResizeHandle Name="PART_ResizeHandle"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Cursor="SizeNorthSouth"
                                       IsVisible="{TemplateBinding IsResizable}" />
                </Panel>
            </atom:InputAccessoryDockPanel>
        </ControlTemplate>
    </Setter>

    <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
    <Setter Property="SelectionBrush" Value="{atom:OwnerTokenResource SelectionBackground}" />
    <Setter Property="CaretBrush" Value="{atom:OwnerTokenResource ColorText}" />
    <Setter Property="SelectionForegroundBrush"
            Value="{atom:OwnerTokenResource SelectionForeground}" />
    <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
    <Setter Property="PlaceholderForeground"
            Value="{atom:OwnerTokenResource ColorTextPlaceholder}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="MinLines" Value="1" />

    <Style Selector="^ /template/ Panel#ContentLayout">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Ibeam" />
    </Style>

    <Style Selector="^[StyleVariant=Borderless]">
        <Style Selector="^[Status=Error]">
            <Style Selector="^ /template/ Panel#ContentLayout">
                <Setter Property="TemplatedControl.Foreground"
                        Value="{atom:OwnerTokenResource ColorErrorText}" />
            </Style>
        </Style>
        <Style Selector="^:error">
            <Style Selector="^ /template/ Panel#ContentLayout">
                <Setter Property="TemplatedControl.Foreground"
                        Value="{atom:OwnerTokenResource ColorErrorText}" />
            </Style>
        </Style>
        <Style Selector="^:warning">
            <Style Selector="^ /template/ Panel#ContentLayout">
                <Setter Property="TemplatedControl.Foreground"
                        Value="{atom:OwnerTokenResource ColorWarningText}" />
            </Style>
        </Style>
    </Style>
    <Style Selector="^[StyleVariant=Filled]">
        <Style Selector="^[Status=Error]">
            <Style Selector="^ /template/ Panel#ContentLayout">
                <Setter Property="TemplatedControl.Foreground"
                        Value="{atom:OwnerTokenResource ColorErrorText}" />
            </Style>
        </Style>
        <Style Selector="^:error">
            <Style Selector="^ /template/ Panel#ContentLayout">
                <Setter Property="TemplatedControl.Foreground"
                        Value="{atom:OwnerTokenResource ColorErrorText}" />
            </Style>
        </Style>
        <Style Selector="^:warning">
            <Style Selector="^ /template/ Panel#ContentLayout">
                <Setter Property="TemplatedControl.Foreground"
                        Value="{atom:OwnerTokenResource ColorWarningText}" />
            </Style>
        </Style>
    </Style>

    <Style Selector="^[SizeType=Large]">
        <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeightLG}" />
    </Style>
    <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
        <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeight}" />
    </Style>
    <Style Selector="^[SizeType=Small]">
        <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeightSM}" />
        <Style Selector="^ /template/ TextPresenter#PART_TextPresenter">
            <!-- layout: centres the small line box in the small frame padding -->
            <Setter Property="Margin" Value="0, 1, 0, 1" />
        </Style>
    </Style>

    <Style Selector="^[SizeType=Large]">
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeLG}" />
    </Style>
    <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}" />
    </Style>
    <Style Selector="^[SizeType=Small]">
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeSM}" />
    </Style>

    <Style Selector="^ /template/ TextPresenter#PART_TextPresenter">
        <!-- layout: gutter that keeps the caret off the frame padding at both text ends -->
        <Setter Property="Margin"
                Value="2 0 2 0" />
    </Style>

    <Style
        Selector="^ /template/ StackPanel#PART_LeftAddOnLayout, ^ /template/ StackPanel#PART_RightAddOnLayout">
        <Setter Property="Spacing"
                Value="{atom:OwnerTokenResource UniformlyPaddingXXS}" />
    </Style>

    <Style Selector="^ /template/ atom|TextBlock#TextCountIndicator">
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextPlaceholder}" />
    </Style>

<Style Selector="^:disabled">
        <Setter Property="Foreground"
                Value="{atom:OwnerTokenResource ColorTextDisabled}" />
    </Style>

</ControlTheme>
