<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CardTabControl}" TargetType="atom:CardTabControl">
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSize" Value="{atom:CardTabControlTokenResource TitleFontSize}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSizeLG" Value="{atom:CardTabControlTokenResource TitleFontSizeLG}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSizeSM" Value="{atom:CardTabControlTokenResource TitleFontSizeSM}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemMargin" Value="{atom:CardTabControlTokenResource HorizontalItemMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemColor" Value="{atom:CardTabControlTokenResource ItemColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemHoverColor" Value="{atom:CardTabControlTokenResource ItemHoverColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemSelectedColor" Value="{atom:CardTabControlTokenResource ItemSelectedColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemIconMargin" Value="{atom:CardTabControlTokenResource ItemIconMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeMenuIndicatorPaddingHorizontal" Value="{atom:CardTabControlTokenResource MenuIndicatorPaddingHorizontal}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeMenuIndicatorPaddingVertical" Value="{atom:CardTabControlTokenResource MenuIndicatorPaddingVertical}" />

        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowLeft" Value="{atom:CardTabControlTokenResource BoxShadowTabsOverflowLeft}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowRight" Value="{atom:CardTabControlTokenResource BoxShadowTabsOverflowRight}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowTop" Value="{atom:CardTabControlTokenResource BoxShadowTabsOverflowTop}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowBottom" Value="{atom:CardTabControlTokenResource BoxShadowTabsOverflowBottom}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCloseIconMargin" Value="{atom:CardTabControlTokenResource CloseIconMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardBg" Value="{atom:CardTabControlTokenResource CardBg}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardSize" Value="{atom:CardTabControlTokenResource CardSize}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardPadding" Value="{atom:CardTabControlTokenResource CardPadding}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardPaddingSM" Value="{atom:CardTabControlTokenResource CardPaddingSM}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardPaddingLG" Value="{atom:CardTabControlTokenResource CardPaddingLG}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeVerticalItemPadding" Value="{atom:CardTabControlTokenResource VerticalItemPadding}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardGutter" Value="{atom:CardTabControlTokenResource CardGutter}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginHorizontal" Value="{atom:CardTabControlTokenResource AddTabButtonMarginHorizontal}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginVertical" Value="{atom:CardTabControlTokenResource AddTabButtonMarginVertical}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTabAndContentGutter" Value="{atom:CardTabControlTokenResource TabAndContentGutter}" />

        <ControlTheme.BasedOn>
            <themes:BaseTabControlTheme TargetType="atom:CardTabControl" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame"
                                         Background="{TemplateBinding Background}"
                                         BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         Padding="{TemplateBinding Padding}"
                                         StrokeDashArray="{TemplateBinding BorderDashArray}"
                                         StrokeDaskOffset="{TemplateBinding BorderDashOffset}">
                    <DockPanel>
                        <Panel Name="PART_AlignWrapper"
                               DockPanel.Dock="{TemplateBinding TabStripPlacement}"
                               Margin="{TemplateBinding TabStripMargin}">
                            <Border Classes.semantic-header="True"
                                    Padding="{TemplateBinding EffectiveHeaderPadding}">
                                <DockPanel LastChildFill="True" Name="HeaderLayout">
                                    <ContentPresenter Name="HeaderStartExtraContent"
                                                      Content="{TemplateBinding HeaderStartExtraContent}"
                                                      ContentTemplate="{TemplateBinding HeaderStartExtraContentTemplate}" />
                                    <ContentPresenter Name="HeaderEndExtraContent"
                                                      Content="{TemplateBinding HeaderEndExtraContent}"
                                                      ContentTemplate="{TemplateBinding HeaderEndExtraContentTemplate}" />
                                    <atom:TabsContainerPanel
                                        Name="PART_TabsContainer"
                                        TabStripPlacement="{TemplateBinding TabStripPlacement}">
                                        <atom:TabsContainerPanel.TabScrollViewer>
                                    <atom:TabScrollViewer
                                        Name="PART_CardTabStripScrollViewer"
                                        IsScrollChainingEnabled="False"
                                        TabStripPlacement="{TemplateBinding TabStripPlacement}"
                                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                        IsPopupPinnedOpen="{TemplateBinding IsPopupPinnedOpen}"
                                        OverflowPopupTemplate="{TemplateBinding OverflowPopupTemplate}">
                                                <ItemsPresenter
                                                    Name="PART_ItemsPresenter"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </atom:TabScrollViewer>
                                        </atom:TabsContainerPanel.TabScrollViewer>
                                        <atom:TabsContainerPanel.AddTabButton>
                                            <atom:IconButton
                                                Name="PART_AddTabButton"
                                                Classes.semantic-add="True"
                                                Icon="{antdicons:AntDesignIconProvider PlusOutlined}"
                                                BorderThickness="{TemplateBinding CardBorderThickness}"
                                                CornerRadius="{TemplateBinding EffectiveCardBorderRadius}"
                                                IsVisible="{TemplateBinding IsShowAddTabButton}" />
                                        </atom:TabsContainerPanel.AddTabButton>
                                    </atom:TabsContainerPanel>
                                </DockPanel>
                            </Border>
                        </Panel>

                        <ContentPresenter Classes.semantic-content="True"
                                          Padding="{TemplateBinding ContentPadding}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="CardSize"
                Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardSize)}" />
        <Setter Property="CardBorderThickness"
                Value="{atom:CardTabControlTokenResource BorderThickness}" />
        
        <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
            <Setter Property="IconBrush"
                    Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeItemColor)}" />
            <Setter Property="IconWidth"
                    Value="{atom:CardTabControlTokenResource IconSize}" />
            <Setter Property="IconHeight"
                    Value="{atom:CardTabControlTokenResource IconSize}" />
            <Setter Property="BorderBrush"
                    Value="{atom:CardTabControlTokenResource ColorBorderSecondary}" />
        </Style>
                
        <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton:pointerover">
            <Setter Property="IconBrush"
                    Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeItemHoverColor)}" />
        </Style>

        <Style Selector="^[TabStripPlacement=Top]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="HorizontalSpacing" Value="{atom:CardTabControlTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ atom|TabsContainerPanel#PART_TabsContainer">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardGutter)}" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>

            <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
                <Setter Property="Margin"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginHorizontal)}" />
            </Style>

        </Style>

        <Style Selector="^[TabStripPlacement=Right]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="VerticalSpacing" Value="{atom:CardTabControlTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Bottom"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ atom|TabsContainerPanel#PART_TabsContainer">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardGutter)}" />
                <Setter Property="Orientation" Value="Vertical" />
            </Style>

            <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
                <Setter Property="Margin"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginVertical)}" />
            </Style>

        </Style>

        <Style Selector="^[TabStripPlacement=Bottom]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="HorizontalSpacing" Value="{atom:CardTabControlTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ atom|TabsContainerPanel#PART_TabsContainer">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardGutter)}" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>

            <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
                <Setter Property="Margin"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginHorizontal)}" />
            </Style>

        </Style>

        <Style Selector="^[TabStripPlacement=Left]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="VerticalSpacing" Value="{atom:CardTabControlTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ atom|TabsContainerPanel#PART_TabsContainer">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardGutter)}" />
                <Setter Property="Orientation" Value="Vertical" />
            </Style>

            <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
                <Setter Property="Margin"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginVertical)}" />
            </Style>

        </Style>
        
        <Style Selector="^[SizeType=Large]">
            <Setter Property="CardBorderRadius"
                    Value="{atom:CardTabControlTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Setter Property="CardBorderRadius"
                    Value="{atom:CardTabControlTokenResource BorderRadius}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="CardBorderRadius"
                    Value="{atom:CardTabControlTokenResource BorderRadiusSM}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
