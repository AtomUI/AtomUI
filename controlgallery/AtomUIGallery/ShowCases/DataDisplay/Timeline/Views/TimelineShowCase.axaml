<UserControl
    x:Class="AtomUIGallery.ShowCases.Timeline.TimelineShowCase"
    xmlns="https://github.com/avaloniaui"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    xmlns:gallery="https://atomui.net/oss-controls/gallery"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AtomUIGallery.ShowCases.Timeline"
    x:DataType="vm:TimelineViewModel"
    x:CompileBindings="True">

    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Timeline"
                    Category="{gallery:TimelineShowCaseLangResource ComponentCategory}"
                    Status="{gallery:TimelineShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:TimelineShowCaseLangResource PageSubtitle}"
                    Description="{gallery:TimelineShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="AbstractTimeline" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:TimelineViewModel">
                    <StackPanel Orientation="Vertical" Spacing="16">
                        <gallery:SemanticPartPreview
                            Name="TimelineSemanticPreview"
                            SemanticOwner="{Binding #TimelineSemanticOwner}"
                            SemanticOwnerType="{x:Type atom:Timeline}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:Timeline Name="TimelineSemanticOwner"
                                               Width="400"
                                               HorizontalAlignment="Left">
                                    <atom:TimelineItem Label="2015-09-01"
                                                       Content="{gallery:TimelineShowCaseLangResource P2ContentCreateAServices}" />
                                    <atom:TimelineItem Label="2015-09-01 09:12:11"
                                                       Content="{gallery:TimelineShowCaseLangResource P2ContentSolveInitialNetworkProblems}" />
                                    <atom:TimelineItem Content="{gallery:TimelineShowCaseLangResource P2ContentTechnicalTesting}" />
                                    <atom:TimelineItem Label="2015-09-01 09:12:11"
                                                       Content="{gallery:TimelineShowCaseLangResource P2ContentNetworkProblemsBeingSolved}" />
                                </atom:Timeline>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="item"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemWrapper"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemWrapperDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemIcon"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemIconDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemSection"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemSectionDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemHeader"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemHeaderDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemTitle"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemTitleDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemContent"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemContentDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemRail"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemRailDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <gallery:SemanticPartPreview
                            Name="TimelineItemsSemanticPreview"
                            SemanticOwner="{Binding #TimelineItemsSemanticOwner}"
                            SemanticOwnerType="{x:Type atom:Timeline}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:Timeline Name="TimelineItemsSemanticOwner"
                                               Width="400"
                                               HorizontalAlignment="Left">
                                    <atom:TimelineItem Label="2015-09-01 09:12:11"
                                                       Content="{gallery:TimelineShowCaseLangResource P2ContentSolveInitialNetworkProblems}" />
                                    <atom:TimelineItem Label="2015-09-01 11:11:11"
                                                       Content="{gallery:TimelineShowCaseLangResource P2ContentTechnicalTesting}" />
                                </atom:Timeline>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemsRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="item"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemsItemDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemWrapper"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemsWrapperDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemIcon"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemsIconDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemSection"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemsSectionDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemHeader"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemsHeaderDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemTitle"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemsTitleDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemContent"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemsContentDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemRail"
                                    Description="{gallery:TimelineShowCaseLangResource SemanticTimelineItemsRailDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
<gallery:ShowCaseItem Description="{gallery:TimelineShowCaseLangResource BasicUsageDescription}" Title="{gallery:TimelineShowCaseLangResource BasicUsageTitle}"
                      IsDeferredContentEnabled="True">
    <gallery:ShowCaseItem.DeferredContentTemplate>
        <DataTemplate x:DataType="vm:TimelineViewModel">
    <atom:Timeline>
        <atom:TimelineItem Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
        <atom:TimelineItem IndicatorColor="green" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N08N12AfterMoreThanN7Months}" />
        <atom:TimelineItem IndicatorColor="red" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N10N01ReleaseOfTheN0N0}" />
    </atom:Timeline>
        </DataTemplate>
    </gallery:ShowCaseItem.DeferredContentTemplate>
</gallery:ShowCaseItem>

<gallery:ShowCaseItem Description="{gallery:TimelineShowCaseLangResource ColorDescription}" Title="{gallery:TimelineShowCaseLangResource ColorTitle}"
                      IsDeferredContentEnabled="True">
    <gallery:ShowCaseItem.DeferredContentTemplate>
        <DataTemplate x:DataType="vm:TimelineViewModel">
    <atom:Timeline>
        <atom:TimelineItem IndicatorColor="green" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
        <atom:TimelineItem IndicatorColor="blue" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
        <atom:TimelineItem IndicatorColor="Red" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
        <atom:TimelineItem IndicatorColor="gray" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
        <atom:TimelineItem IndicatorColor="#00CCFF" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
    </atom:Timeline>
        </DataTemplate>
    </gallery:ShowCaseItem.DeferredContentTemplate>
</gallery:ShowCaseItem>

    <gallery:ShowCaseItem Description="{gallery:TimelineShowCaseLangResource LastNodeAndReversingDescription}" Title="{gallery:TimelineShowCaseLangResource LastNodeAndReversingTitle}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimelineViewModel">
        <StackPanel>
            <atom:Timeline
                Pending="{gallery:TimelineShowCaseLangResource P2ContentRecording}"
                IsReverse="{Binding ReverseTimelineIsReverse}"
                x:Name="ReverseTimeline">
                <atom:TimelineItem Label="2024-01-01" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiatedN1}" />
                <atom:TimelineItem Label="2024-08-12" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiatedN2}" />
                <atom:TimelineItem Label="2024-10-01" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiatedN3}" />
            </atom:Timeline>
            <DockPanel>
                <atom:Button ButtonType="Primary"
                             x:Name="ReverseButton"
                             Click="ReverseButtonClick"
                             Content="{gallery:TimelineShowCaseLangResource P2ContentToggleReverse}" />
            </DockPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Description="{gallery:TimelineShowCaseLangResource AlternateDescription}" Title="{gallery:TimelineShowCaseLangResource AlternateTitle}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimelineViewModel">
        <atom:Timeline Mode="Alternate">
            <atom:TimelineItem Label="2024-01-01" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
            <atom:TimelineItem Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
            <atom:TimelineItem Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
            <atom:TimelineItem IndicatorIcon="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                               IndicatorColor ="Red"
                               Label="2024-01-01" Content="{gallery:TimelineShowCaseLangResource P2ContentN2024N01N01AtomuiOfficiallyInitiated}" />
        </atom:Timeline>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Description="{gallery:TimelineShowCaseLangResource DynamicModeDescription}" Title="{gallery:TimelineShowCaseLangResource DynamicModeTitle}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimelineViewModel">
        <StackPanel>
            <WrapPanel Margin="0,0,0,20" Orientation="Horizontal">
                <WrapPanel.Styles>
                    <Style Selector="atom|RadioButton">
                        <Setter Property="Margin" Value="5" />
                    </Style>
                </WrapPanel.Styles>
                <atom:RadioButton IsChecked="True"
                                  x:Name="ModeStart"
                                  Tag="{x:Static atom:TimelineMode.Start}"
                                  IsCheckedChanged="ModeChecked"
                                  Content="{gallery:TimelineShowCaseLangResource P2ContentStart}" />
                <atom:RadioButton x:Name="ModeEnd"
                                  Tag="{x:Static atom:TimelineMode.End}"
                                  IsCheckedChanged="ModeChecked"
                                  Content="{gallery:TimelineShowCaseLangResource P2ContentEnd}" />
                <atom:RadioButton x:Name="ModeAlternate"
                                  Tag="{x:Static atom:TimelineMode.Alternate}"
                                  IsCheckedChanged="ModeChecked"
                                  Content="{gallery:TimelineShowCaseLangResource P2ContentAlternate}" />
            </WrapPanel>
            <atom:Timeline Mode="{Binding SelectedTimelineMode}" x:Name="LabelTimeline">
                <atom:TimelineItem Label="2024-01-01" Content="{gallery:TimelineShowCaseLangResource P2ContentAtomuiOfficiallyInitiated}" />
                <atom:TimelineItem Label="2015-09-01 09:12:11" Content="{gallery:TimelineShowCaseLangResource P2ContentCreateAServicesSite}" />
                <atom:TimelineItem Content="{gallery:TimelineShowCaseLangResource P2ContentQinwareWebsiteOnline}" />
                <atom:TimelineItem Label="2029-09-01" Content="{gallery:TimelineShowCaseLangResource P2ContentNetworkProblemsBeingSolved}" />
            </atom:Timeline>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Description="{gallery:TimelineShowCaseLangResource HorizontalDescription}" Title="{gallery:TimelineShowCaseLangResource HorizontalTitle}" Span="Full"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimelineViewModel">
        <StackPanel Spacing="24">
            <StackPanel Spacing="8">
                <atom:TextBlock Text="{gallery:TimelineShowCaseLangResource P2ContentStart}" />
                <atom:Timeline Orientation="Horizontal" Mode="Start">
                    <atom:TimelineItem Label="2024-01-01" Content="{gallery:TimelineShowCaseLangResource P2ContentAtomuiOfficiallyInitiated}" />
                    <atom:TimelineItem Label="2024-08-12" Content="{gallery:TimelineShowCaseLangResource P2ContentCreateAServicesSite}" />
                    <atom:TimelineItem Label="2024-10-01" Content="{gallery:TimelineShowCaseLangResource P2ContentQinwareWebsiteOnline}" />
                </atom:Timeline>
            </StackPanel>
            <StackPanel Spacing="8">
                <atom:TextBlock Text="{gallery:TimelineShowCaseLangResource P2ContentEnd}" />
                <atom:Timeline Orientation="Horizontal" Mode="End">
                    <atom:TimelineItem Label="2024-01-01" Content="{gallery:TimelineShowCaseLangResource P2ContentAtomuiOfficiallyInitiated}" />
                    <atom:TimelineItem Label="2024-08-12" Content="{gallery:TimelineShowCaseLangResource P2ContentCreateAServicesSite}" />
                    <atom:TimelineItem Label="2024-10-01" Content="{gallery:TimelineShowCaseLangResource P2ContentQinwareWebsiteOnline}" />
                </atom:Timeline>
            </StackPanel>
            <StackPanel Spacing="8">
                <atom:TextBlock Text="{gallery:TimelineShowCaseLangResource P2ContentAlternate}" />
                <atom:Timeline Orientation="Horizontal" Mode="Alternate">
                    <atom:TimelineItem Label="2024-01-01" Content="{gallery:TimelineShowCaseLangResource P2ContentAtomuiOfficiallyInitiated}" />
                    <atom:TimelineItem Label="2024-08-12" Content="{gallery:TimelineShowCaseLangResource P2ContentCreateAServicesSite}" />
                    <atom:TimelineItem Label="2024-10-01" Content="{gallery:TimelineShowCaseLangResource P2ContentQinwareWebsiteOnline}" />
                </atom:Timeline>
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
    <gallery:ShowCaseItem SourceKey="timeline-semantic-part"
                          Title="{gallery:TimelineShowCaseLangResource SemanticPartStyleTitle}"
                          Description="{gallery:TimelineShowCaseLangResource SemanticPartStyleDescription}"
                          BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                          Span="Full"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimelineViewModel">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Stretch"
                            Spacing="24">
                    <StackPanel.Styles>
                        <Style Selector="atom|Timeline.semantic-object">
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="CornerRadius" Value="4" />
                            <atom:TimelineItemIconStyle x:SetterTargetType="Border">
                                <Setter Property="BorderBrush" Value="#1890ff" />
                            </atom:TimelineItemIconStyle>
                        </Style>
                        <Style Selector="atom|Timeline.semantic-function">
                            <Setter Property="Padding" Value="6,10" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="BorderBrush" Value="#A294F9" />
                            <Setter Property="BorderThickness" Value="1" />
                            <atom:TimelineItemIconStyle x:SetterTargetType="Border">
                                <Setter Property="BorderBrush" Value="#A294F9" />
                            </atom:TimelineItemIconStyle>
                        </Style>
                    </StackPanel.Styles>
                    <atom:Timeline Classes="semantic-object" Orientation="Horizontal">
                        <atom:TimelineItem Label="2015-09-01"
                                           Content="{gallery:TimelineShowCaseLangResource P2ContentCreateAServicesSite}" />
                        <atom:TimelineItem Label="2015-09-01 09:12:11"
                                           Content="{gallery:TimelineShowCaseLangResource P2ContentSolveInitialNetworkProblems}" />
                        <atom:TimelineItem Content="{gallery:TimelineShowCaseLangResource P2ContentTechnicalTesting}" />
                    </atom:Timeline>
                    <atom:Timeline Classes="semantic-function">
                        <atom:TimelineItem Label="2015-09-01"
                                           Content="{gallery:TimelineShowCaseLangResource P2ContentCreateAServicesSite}" />
                        <atom:TimelineItem Label="2015-09-01 09:12:11"
                                           Content="{gallery:TimelineShowCaseLangResource P2ContentSolveInitialNetworkProblems}" />
                        <atom:TimelineItem Content="{gallery:TimelineShowCaseLangResource P2ContentTechnicalTesting}" />
                    </atom:Timeline>
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
