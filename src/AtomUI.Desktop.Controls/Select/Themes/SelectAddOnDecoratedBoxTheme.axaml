<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:converters="using:AtomUI.Desktop.Controls.Converters"
    x:ClassModifier="internal">
    <converters:SelectTagFramePaddingConverter x:Key="TagFramePaddingConverter" />
    <ControlTheme x:Key="{x:Type atom:SelectAddOnDecoratedBox}" TargetType="atom:SelectAddOnDecoratedBox">
        <ControlTheme.BasedOn>
            <atom:AddOnDecoratedBoxTheme TargetType="atom:SelectAddOnDecoratedBox" />
        </ControlTheme.BasedOn>

        <Style Selector="^:is(atom|SelectAddOnDecoratedBox)">
            <Style Selector="^:not(^[Mode=Single])">
                <Style Selector="^[IsSelectionEmpty=False]">
                    <Setter Property="ContentFramePadding"
                            Value="{CompiledBinding $self.(atom:SelectTag.ThemeMultiModePadding)}" />
                    <Setter Property="CompactContentFramePadding"
                            Value="{CompiledBinding $self.(atom:SelectTag.ThemeCompactMultiModePadding)}" />
                    <Setter Property="ContentMinHeight"
                            Value="{CompiledBinding $self.(atom:SelectTag.ThemeMultipleItemHeight)}" />
                    <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentLeftAddOn">
                        <Setter Property="Margin"
                                Value="{CompiledBinding $self.(atom:SelectTag.ThemeMultiModePrefixIndent)}" />
                    </Style>
                    <Style Selector="^[SizeType=Custom] /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                        <Setter Property="Padding"
                                Value="{Binding (atom:AddOnDecoratedBox).EffectiveContentFramePadding, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Style>
                    <Style Selector="^[SizeType=Small] /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame,
                                     ^[SizeType=Middle] /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                        <Setter Property="Padding">
                            <MultiBinding Converter="{StaticResource TagFramePaddingConverter}" x:CompileBindings="True">
                                <Binding Path="$parent[atom:SelectAddOnDecoratedBox].EffectiveContentFramePadding" />
                                <Binding Path="$parent[atom:SelectAddOnDecoratedBox].ContentMinHeight" />
                                <atom:OwnerTokenResource Kind="FontHeight" />
                            </MultiBinding>
                        </Setter>
                    </Style>
                    <Style Selector="^[SizeType=Large] /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                        <Setter Property="Padding">
                            <MultiBinding Converter="{StaticResource TagFramePaddingConverter}" x:CompileBindings="True">
                                <Binding Path="$parent[atom:SelectAddOnDecoratedBox].EffectiveContentFramePadding" />
                                <Binding Path="$parent[atom:SelectAddOnDecoratedBox].ContentMinHeight" />
                                <atom:OwnerTokenResource Kind="FontHeightLG" />
                            </MultiBinding>
                        </Setter>
                    </Style>
                </Style>

                <Style Selector="^[IsSelectionEmpty=True] /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                    <Setter Property="Padding" Value="{CompiledBinding $self.(atom:SelectTag.ThemeSingleModePadding)}" />
                </Style>
            </Style>

            <!-- The frame theme (InputControlFrameTheme) owns the variant and status state machine and reads it from
                 the owner; an open drop-down keeps the active border while the input itself may not hold focus. -->
            <Style Selector="^:outline[IsDropDownOpen=True], ^:filled[IsDropDownOpen=True]">
                <Setter Property="BorderBrush" Value="{atom:SelectTokenResource ColorPrimary}" />
                <Style Selector="^[EffectiveStatus=Error]">
                    <Setter Property="BorderBrush" Value="{atom:SelectTokenResource ColorError}" />
                </Style>
                <Style Selector="^[EffectiveStatus=Warning]">
                    <Setter Property="BorderBrush" Value="{atom:SelectTokenResource ColorWarning}" />
                </Style>
            </Style>

            <!-- Re-project the root border of the Select after the open state above (see InputControlFrameTheme). -->
            <Style Selector="^:host-border-brush">
                <Setter Property="BorderBrush"
                        Value="{Binding (atom:InputControlFrame).HostBorderBrush, RelativeSource={RelativeSource Self}}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
