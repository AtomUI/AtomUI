    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>The embedded panel surface and instance layout.</source>
      </segment>
    </unit>
    <unit id="SemanticHeaderDescription">
      <segment>
        <source>Navigation or custom header content; hidden when ShowHeader is false.</source>
      </segment>
    </unit>
    <unit id="SemanticBodyDescription">
      <segment>
        <source>The date body that contains the visible panels.</source>
      </segment>
    </unit>
    <unit id="SemanticContentDescription">
      <segment>
        <source>The single panel for browsing and selecting dates.</source>
      </segment>
    </unit>
    <unit id="SemanticCellDescription">
      <segment>
        <source>Interactive date, period, or week-number containers.</source>
      </segment>
    </unit>
    <unit id="SemanticCellContentDescription">
      <segment>
        <source>Typed template content within the interactive cell.</source>
      </segment>
    </unit>
    <unit id="SemanticFooterDescription">
      <segment>
        <source>The Today action below the date panel; shown for standalone date selection.</source>
      </segment>
    </unit>
