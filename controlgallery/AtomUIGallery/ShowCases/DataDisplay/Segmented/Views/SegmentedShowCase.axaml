<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Segmented.SegmentedShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Segmented"
             x:DataType="vm:SegmentedViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Segmented"
                    Category="{gallery:SegmentedShowCaseLangResource ComponentCategory}"
                    Status="{gallery:SegmentedShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:SegmentedShowCaseLangResource PageSubtitle}"
                    Description="{gallery:SegmentedShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="AbstractSegmented" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:SegmentedViewModel">
                    <gallery:SemanticPartPreview
                        Name="SegmentedSemanticPreview"
                        SemanticOwner="{Binding #SegmentedSemanticOwner}"
                        SemanticOwnerType="{x:Type atom:Segmented}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Left"
                                        Spacing="16">
                                <atom:Segmented Name="SegmentedSemanticOwner">
                                    <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}"
                                                        Content="{gallery:SegmentedShowCaseLangResource P2ContentList}" />
                                    <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentKanban}"
                                                        Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" />
                                    <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=SunOutlined}" />
                                </atom:Segmented>
                                <atom:Segmented Name="VerticalSegmentedSemanticOwner"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Left">
                                    <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}"
                                                        Content="{gallery:SegmentedShowCaseLangResource P2ContentList}" />
                                    <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentKanban}"
                                                        Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" />
                                    <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}"
                                                        Icon="{antdicons:AntDesignIconProvider Kind=WindowsOutlined}" />
                                </atom:Segmented>
                            </StackPanel>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:SegmentedShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="item"
                                Description="{gallery:SegmentedShowCaseLangResource SemanticItemDescription}" />
                            <gallery:SemanticPartDescription
                                Path="icon"
                                Description="{gallery:SegmentedShowCaseLangResource SemanticIconDescription}" />
                            <gallery:SemanticPartDescription
                                Path="label"
                                Description="{gallery:SegmentedShowCaseLangResource SemanticLabelDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:SegmentedShowCaseLangResource BasicTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource BasicDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                    <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Spacing="10">
                        <atom:Segmented Margin="20">
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                        </atom:Segmented>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SegmentedShowCaseLangResource VerticalTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource VerticalDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                            <atom:Segmented Orientation="Vertical"
                                            HorizontalAlignment="Left"
                                            Margin="20">
                                <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}" />
                                <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" />
                            </atom:Segmented>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SegmentedShowCaseLangResource BlockSegmentedTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource BlockSegmentedDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                    <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                        <atom:Segmented IsExpanding="True" Margin="20">
                            <atom:SegmentedItem>123</atom:SegmentedItem>
                            <atom:SegmentedItem>456</atom:SegmentedItem>
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentLongtextLongtextLongtextLongtext}" />
                        </atom:Segmented>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SegmentedShowCaseLangResource RoundShapeTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource RoundShapeDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                            <StackPanel HorizontalAlignment="Left"
                                        Orientation="Vertical"
                                        Spacing="8"
                                        Margin="20">
                                <atom:Segmented SelectionChanged="HandleRoundShapeSizeSelectionChanged">
                                    <atom:SegmentedItem Content="small" />
                                    <atom:SegmentedItem Content="medium" IsSelected="True" />
                                    <atom:SegmentedItem Content="large" />
                                </atom:Segmented>
                                <atom:Segmented SizeType="{Binding RoundShapeSizeType}"
                                                Shape="Round">
                                    <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=SunOutlined}" />
                                    <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=MoonOutlined}" />
                                </atom:Segmented>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SegmentedShowCaseLangResource DisabledTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource DisabledDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                    <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical" Spacing="10">
                        <atom:Segmented Margin="20">
                            <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentMap}" />
                            <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentTransit}" />
                            <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentSatellite}" />
                        </atom:Segmented>
                        <atom:Segmented>
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                            <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                            <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                        </atom:Segmented>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="segmented-dynamic"
                    Title="{gallery:SegmentedShowCaseLangResource DynamicTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource DynamicDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                            <StackPanel HorizontalAlignment="Left"
                                        Orientation="Vertical"
                                        Spacing="8"
                                        Margin="20">
                                <atom:Segmented ItemsSource="{Binding DynamicOptions}" />
                                <atom:Button ButtonType="Primary"
                                             HorizontalAlignment="Left"
                                             IsEnabled="{Binding IsDynamicOptionsLoaded, Converter={x:Static BoolConverters.Not}}"
                                             Command="{Binding LoadMoreOptionsCommand}"
                                             Content="Load more options" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SegmentedShowCaseLangResource ThreeSizesTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource ThreeSizesDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                    <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Spacing="10">
                        <atom:Segmented SizeType="Large" Margin="20">
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                        </atom:Segmented>

                        <atom:Segmented Margin="20">
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                        </atom:Segmented>

                        <atom:Segmented SizeType="Small" Margin="20">
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                        </atom:Segmented>

                        <atom:Segmented SizeType="Custom"
                                        Margin="20"
                                        Padding="3"
                                        CornerRadius="8">
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}"
                                                MinHeight="36"
                                                Padding="16,0"
                                                FontSize="15"
                                                CornerRadius="6" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}"
                                                IsSelected="True"
                                                MinHeight="36"
                                                Padding="16,0"
                                                FontSize="15"
                                                CornerRadius="6" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}"
                                                MinHeight="36"
                                                Padding="16,0"
                                                FontSize="15"
                                                CornerRadius="6" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}"
                                                MinHeight="36"
                                                Padding="16,0"
                                                FontSize="15"
                                                CornerRadius="6" />
                        </atom:Segmented>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SegmentedShowCaseLangResource IconOnlyTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource IconOnlyDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                    <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Spacing="10">
                        <atom:Segmented Margin="20">
                            <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}" />
                            <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" />
                        </atom:Segmented>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SegmentedShowCaseLangResource WithIconTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource WithIconDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                    <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Spacing="10">
                        <atom:Segmented Margin="20">
                            <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}" Content="{gallery:SegmentedShowCaseLangResource P2ContentList}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentKanban}" Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" />
                        </atom:Segmented>

                        <atom:Segmented Margin="20">
                            <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}" Content="{gallery:SegmentedShowCaseLangResource P2ContentAva}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}" Icon="{antdicons:AntDesignIconProvider Kind=WechatOutlined}" IsEnabled="False"/>

                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}"
                                                Icon="{antdicons:AntDesignIconProvider Kind=WindowsOutlined}" />

                        </atom:Segmented>

                        <atom:Segmented SizeType="Large" Margin="20">
                            <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}" Content="{gallery:SegmentedShowCaseLangResource P2ContentAva}" />
                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}" Icon="{antdicons:AntDesignIconProvider Kind=WechatOutlined}" />

                            <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}"
                                                Icon="{antdicons:AntDesignIconProvider Kind=WindowsOutlined}" />

                        </atom:Segmented>

                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
                <gallery:ShowCaseItem
                    SourceKey="segmented-semantic-part"
                    Title="{gallery:SegmentedShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:SegmentedShowCaseLangResource SemanticPartStyleDescription}"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    Span="Full"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SegmentedViewModel">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Spacing="12">
                                <StackPanel.Styles>
                                    <Style Selector="atom|Segmented.semantic-object">
                                        <Setter Property="Background" Value="#e6f4ff" />
                                        <atom:SegmentedItemStyle x:SetterTargetType="atom:SegmentedItem">
                                            <Setter Property="FontStyle" Value="Italic" />
                                            <Setter Property="CornerRadius" Value="6" />
                                        </atom:SegmentedItemStyle>
                                        <atom:SegmentedIconStyle x:SetterTargetType="atom:IconPresenter">
                                            <Setter Property="IconBrush" Value="#1677ff" />
                                        </atom:SegmentedIconStyle>
                                        <atom:SegmentedLabelStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="8,0,0,0" />
                                        </atom:SegmentedLabelStyle>
                                    </Style>
                                </StackPanel.Styles>
                                <atom:Segmented Classes="semantic-object"
                                                Margin="0,4,0,0">
                                    <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}"
                                                        Content="{gallery:SegmentedShowCaseLangResource P2ContentList}" />
                                    <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentKanban}"
                                                        Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" />
                                    <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=SunOutlined}" />
                                </atom:Segmented>

                                <atom:Segmented Classes="semantic-object"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Left"
                                                Margin="0,4,0,0">
                                    <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}"
                                                        Content="{gallery:SegmentedShowCaseLangResource P2ContentList}" />
                                    <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentKanban}"
                                                        Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" />
                                    <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}"
                                                        Icon="{antdicons:AntDesignIconProvider Kind=WindowsOutlined}" />
                                </atom:Segmented>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
