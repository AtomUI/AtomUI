<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:MessageCard}" TargetType="atom:MessageCard">
        <Setter Property="Template">
            <ControlTemplate>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{TemplateBinding BoxShadow}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel Name="PART_HeaderContainer"
                                   Classes.semantic-wrapper="True"
                                   LastChildFill="True">
                            <atom:IconPresenter Name="PART_IconContent"
                                                Classes.semantic-icon="True"
                                                DockPanel.Dock="Left"
                                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Icon="{TemplateBinding Icon}" />
                            <SelectableTextBlock Name="PART_Message"
                                                 Classes.semantic-title="True"
                                                 Text="{TemplateBinding Message}" />
                        </DockPanel>
                    </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled" Value="{atom:MessageCardTokenResource EnableMotion}" />
        
        <Style Selector="^ /template/ atom|IconPresenter">
            <Setter Property="Width" Value="{atom:MessageCardTokenResource MessageIconSize}" />
            <Setter Property="Height" Value="{atom:MessageCardTokenResource MessageIconSize}" />
        </Style>

        <Style Selector="^[MessageType=Information]">
            <Setter Property="BoxShadow" Value="{atom:MessageCardTokenResource InformationShadows}" />
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:MessageCardTokenResource InformationIconColor}" />
            </Style>
        </Style>

        <Style Selector="^[MessageType=Loading]">
            <Setter Property="BoxShadow" Value="{atom:MessageCardTokenResource LoadingShadows}" />
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:MessageCardTokenResource LoadingIconColor}" />
            </Style>
        </Style>

        <Style Selector="^[MessageType=Error]">
            <Setter Property="BoxShadow" Value="{atom:MessageCardTokenResource ErrorShadows}" />
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:MessageCardTokenResource ErrorIconColor}" />
            </Style>
        </Style>

        <Style Selector="^[MessageType=Success]">
            <Setter Property="BoxShadow" Value="{atom:MessageCardTokenResource SuccessShadows}" />
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:MessageCardTokenResource SuccessIconColor}" />
            </Style>
        </Style>

        <Style Selector="^[MessageType=Warning]">
            <Setter Property="BoxShadow" Value="{atom:MessageCardTokenResource WarningShadows}" />
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:MessageCardTokenResource WarningIconColor}" />
            </Style>
        </Style>

        <Setter Property="OpenCloseMotionDuration"
                Value="{atom:MessageCardTokenResource MotionDurationMid}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <atom:TokenTransitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   atom:TokenTransitions.Duration="MotionDurationMid"
                                                   Easing="0.645,0.045,0.355,1" />
                    <DoubleTransition Property="Opacity"
                                      atom:TokenTransitions.Duration="MotionDurationMid"
                                      Easing="0.645,0.045,0.355,1" />
                </Transitions>
            </atom:TokenTransitions>
        </Setter>

        <Style Selector="^[IsMotionEnabled=False]">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>

        <!-- The root surface defaults live at owner level: PART_Frame reads them through TemplateBinding, so the
        ControlTheme only supplies the default look and an override through an owner-scoped Semantic Style really
        reaches the card frame. BorderBrush and BorderThickness get no default (they stay null / 0), the same
        default look as before the pass-through.
        -->
        <Setter Property="Background" Value="{atom:MessageCardTokenResource ContentBg}" />
        <Setter Property="Padding" Value="{atom:MessageCardTokenResource ContentPadding}" />
        <Setter Property="CornerRadius" Value="{atom:MessageCardTokenResource BorderRadiusLG}" />
        <!-- The card shadow comes from the slot of the current MessageType (every value has one); there is no
             severity-less base shadow. -->

        <Style Selector="^ /template/ Border#PART_Frame">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="^[IsClosed=True]">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="^ /template/ SelectableTextBlock#PART_Message">
            <Setter Property="LineHeight" Value="{atom:MessageCardTokenResource FontHeight}" />
            <Setter Property="FontSize" Value="{atom:MessageCardTokenResource FontSize}" />
            <Setter Property="Foreground" Value="{atom:MessageCardTokenResource ColorText}" />
            <Setter Property="SelectionBrush" Value="{atom:MessageCardTokenResource SelectionBackground}" />
            <Setter Property="SelectionForegroundBrush" Value="{atom:MessageCardTokenResource SelectionForeground}" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconPresenter#PART_IconContent">
            <Setter Property="Margin" Value="{atom:MessageCardTokenResource MessageIconMargin}" />
        </Style>

        <!-- ========================= severity surfaces ========================= -->
        <!-- After the generic message rule so a severity keeps its colours. -->
        <Style Selector="^[MessageType=Information]">
            <Setter Property="Background" Value="{atom:MessageCardTokenResource InformationBg}" />
            <Style Selector="^ /template/ SelectableTextBlock#PART_Message">
                <Setter Property="Foreground" Value="{atom:MessageCardTokenResource InformationColor}" />
            </Style>
        </Style>
        <Style Selector="^[MessageType=Success]">
            <Setter Property="Background" Value="{atom:MessageCardTokenResource SuccessBg}" />
            <Style Selector="^ /template/ SelectableTextBlock#PART_Message">
                <Setter Property="Foreground" Value="{atom:MessageCardTokenResource SuccessColor}" />
            </Style>
        </Style>
        <Style Selector="^[MessageType=Warning]">
            <Setter Property="Background" Value="{atom:MessageCardTokenResource WarningBg}" />
            <Style Selector="^ /template/ SelectableTextBlock#PART_Message">
                <Setter Property="Foreground" Value="{atom:MessageCardTokenResource WarningColor}" />
            </Style>
        </Style>
        <Style Selector="^[MessageType=Error]">
            <Setter Property="Background" Value="{atom:MessageCardTokenResource ErrorBg}" />
            <Style Selector="^ /template/ SelectableTextBlock#PART_Message">
                <Setter Property="Foreground" Value="{atom:MessageCardTokenResource ErrorColor}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
