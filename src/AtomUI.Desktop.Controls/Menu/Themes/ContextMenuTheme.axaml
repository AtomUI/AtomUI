<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ContextMenu}" TargetType="atom:ContextMenu" x:DataType="atom:ContextMenu">
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupContentPadding" Value="{atom:ContextMenuTokenResource MenuPopupContentPadding}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupMinWidth" Value="{atom:ContextMenuTokenResource MenuPopupMinWidth}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupMaxWidth" Value="{atom:ContextMenuTokenResource MenuPopupMaxWidth}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupBgColor" Value="{atom:ContextMenuTokenResource MenuPopupBgColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemColor" Value="{atom:ContextMenuTokenResource ItemColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeKeyGestureColor" Value="{atom:ContextMenuTokenResource KeyGestureColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemMargin" Value="{atom:ContextMenuTokenResource ItemMargin}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemHoverColor" Value="{atom:ContextMenuTokenResource ItemHoverColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemDisabledColor" Value="{atom:ContextMenuTokenResource ItemDisabledColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeDangerItemColor" Value="{atom:ContextMenuTokenResource DangerItemColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeDangerItemHoverColor" Value="{atom:ContextMenuTokenResource DangerItemHoverColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemBg" Value="{atom:ContextMenuTokenResource ItemBg}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemHoverBg" Value="{atom:ContextMenuTokenResource ItemHoverBg}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemHeight" Value="{atom:ContextMenuTokenResource ItemHeight}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemIconSize" Value="{atom:ContextMenuTokenResource ItemIconSize}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemIconMarginInlineEnd" Value="{atom:ContextMenuTokenResource ItemIconMarginInlineEnd}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeGroupTitlePadding" Value="{atom:ContextMenuTokenResource GroupTitlePadding}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemBorderRadius" Value="{atom:ContextMenuTokenResource ItemBorderRadius}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemPaddingInline" Value="{atom:ContextMenuTokenResource ItemPaddingInline}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeSeparatorItemHeight" Value="{atom:ContextMenuTokenResource SeparatorItemHeight}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupShadows" Value="{atom:ContextMenuTokenResource MenuPopupShadows}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        MaxHeight="{TemplateBinding MaxPopupHeight}">
                    <atom:MenuPopupScrollHost IsScrollEnabled="{TemplateBinding IsScrollEnabled}"
                                              IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              atom:ScrollViewer.IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                              AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        KeyboardNavigation.TabNavigation="Continue"
                                        Grid.IsSharedSizeScope="True" />
                    </atom:MenuPopupScrollHost>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="HorizontalOffset" Value="{atom:ContextMenuTokenResource ContextMenuOffsetX}" />
        <Setter Property="VerticalOffset" Value="{atom:ContextMenuTokenResource ContextMenuOffsetY}" />
        <Setter Property="CornerRadius" Value="{atom:PopupTokenResource PopupCornerRadius}" />
        <Setter Property="IsMotionEnabled" Value="{atom:ContextMenuTokenResource EnableMotion}" />
        <Setter Property="OpenMotion" Value="{x:Static atom:PopupMotionDefaults.DropdownOpen}" />
        <Setter Property="CloseMotion" Value="{x:Static atom:PopupMotionDefaults.DropdownClose}" />
        <Setter Property="Padding" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ThemeMenuPopupContentPadding)}" />
        <Setter Property="Background" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ThemeMenuPopupBgColor)}" />
        <Setter Property="MinWidth" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ThemeMenuPopupMinWidth)}" />
        <Setter Property="MaxWidth" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ThemeMenuPopupMaxWidth)}" />
        <Setter Property="ItemHeight" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ThemeItemHeight)}" />
        <Setter Property="DisplayPageSize" Value="8" />
        <Setter Property="ShouldUseOverlayPopup" Value="True" />
        <Setter Property="MotionDuration" Value="{atom:ContextMenuTokenResource MotionDurationMid}"/>
        <!-- Menus take their own popup frame (MenuPopupShadows; by default the Popup Token's BoxShadowsSecondary). -->
        <Setter Property="PopupRootShadow"
                Value="{atom:ContextMenuTokenResource MenuPopupShadows}" />
        <Setter Property="OverlayHostShadow"
                Value="{atom:ContextMenuTokenResource MenuPopupShadows}" />

    </ControlTheme>
</ResourceDictionary>
