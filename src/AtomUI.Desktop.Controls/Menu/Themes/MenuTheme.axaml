<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Menu}" TargetType="atom:Menu">
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupContentPadding" Value="{atom:MenuTokenResource MenuPopupContentPadding}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupMinWidth" Value="{atom:MenuTokenResource MenuPopupMinWidth}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupMaxWidth" Value="{atom:MenuTokenResource MenuPopupMaxWidth}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupBgColor" Value="{atom:MenuTokenResource MenuPopupBgColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemColor" Value="{atom:MenuTokenResource ItemColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeKeyGestureColor" Value="{atom:MenuTokenResource KeyGestureColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemMargin" Value="{atom:MenuTokenResource ItemMargin}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemHoverColor" Value="{atom:MenuTokenResource ItemHoverColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemDisabledColor" Value="{atom:MenuTokenResource ItemDisabledColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeDangerItemColor" Value="{atom:MenuTokenResource DangerItemColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeDangerItemHoverColor" Value="{atom:MenuTokenResource DangerItemHoverColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemBg" Value="{atom:MenuTokenResource ItemBg}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemHoverBg" Value="{atom:MenuTokenResource ItemHoverBg}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemHeight" Value="{atom:MenuTokenResource ItemHeight}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemIconSize" Value="{atom:MenuTokenResource ItemIconSize}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemIconMarginInlineEnd" Value="{atom:MenuTokenResource ItemIconMarginInlineEnd}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeGroupTitlePadding" Value="{atom:MenuTokenResource GroupTitlePadding}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemBorderRadius" Value="{atom:MenuTokenResource ItemBorderRadius}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemPaddingInline" Value="{atom:MenuTokenResource ItemPaddingInline}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeSeparatorItemHeight" Value="{atom:MenuTokenResource SeparatorItemHeight}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupShadows" Value="{atom:MenuTokenResource MenuPopupShadows}" />

        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder HorizontalAlignment="Stretch"
                                         Padding="{TemplateBinding Padding}"
                                         Background="{TemplateBinding Background}"
                                         BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding CornerRadius}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    KeyboardNavigation.TabNavigation="Continue">
                        <ItemsPresenter.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsPresenter.ItemsPanel>
                    </ItemsPresenter>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsMotionEnabled" Value="{atom:MenuTokenResource EnableMotion}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{atom:MenuTokenResource ColorBorder}" />
        <Setter Property="ShouldUseOverlayPopup" Value="True" />
        
        <Style Selector="^[SizeType=Large]">
            <Setter Property="MinHeight" Value="{atom:MenuTokenResource ControlHeightLG}" />
            <Setter Property="CornerRadius" Value="{atom:MenuTokenResource BorderRadius}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="MinHeight" Value="{atom:MenuTokenResource ControlHeight}" />
            <Setter Property="CornerRadius" Value="{atom:MenuTokenResource BorderRadius}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="MinHeight" Value="{atom:MenuTokenResource ControlHeightSM}" />
            <Setter Property="CornerRadius" Value="{atom:MenuTokenResource BorderRadiusSM}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
