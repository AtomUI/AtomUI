<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StringToTextBlockConverter" VerticalAlignment="Center" />
    <ControlTheme x:Key="{x:Type atom:PaginationNavItem}" TargetType="atom:PaginationNavItem">
        <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSize}" />
        <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSize}" />
        <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
            <Setter Property="Width" Value="{atom:OwnerTokenResource Kind=IconSize, AnchorControlType={x:Type atom:PaginationNavItem}}" />
            <Setter Property="Height" Value="{atom:OwnerTokenResource Kind=IconSize, AnchorControlType={x:Type atom:PaginationNavItem}}" />
        </Style>
        <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
            <Setter Property="Width" Value="{atom:OwnerTokenResource Kind=IconSize, AnchorControlType={x:Type atom:PaginationNavItem}}" />
            <Setter Property="Height" Value="{atom:OwnerTokenResource Kind=IconSize, AnchorControlType={x:Type atom:PaginationNavItem}}" />
        </Style>

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:PixelAlignedBorder Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}"
                                             CornerRadius="{TemplateBinding CornerRadius}"
                                             Padding="{TemplateBinding Padding}"
                                             BorderThickness="{TemplateBinding BorderThickness}" />
                    <atom:IconPresenter Name="IconPresenter"
                                         IsVisible="False"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Icon="{TemplateBinding Icon}"
                                         IsEnabled="{TemplateBinding IsEnabled}" />
                    <atom:IconPresenter Name="JumpIconPresenter"
                                         IsVisible="False"
                                         Opacity="0"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Icon="{TemplateBinding JumpIcon}"
                                         IsEnabled="{TemplateBinding IsEnabled}" />
                    <ContentPresenter Name="ContentPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Content="{TemplateBinding Content, Mode=Default, Converter={StaticResource StringToTextBlockConverter}}"
                                      IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadius, AnchorControlType={x:Type atom:PaginationNavItem}}" />
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource Kind=FontSize, AnchorControlType={x:Type atom:PaginationNavItem}}" />
        <Setter Property="Padding"
                Value="{atom:PaginationTokenResource PaginationItemPaddingInline}" />
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource Kind=ColorTransparent, AnchorControlType={x:Type atom:PaginationNavItem}}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource Kind=BorderThickness, AnchorControlType={x:Type atom:PaginationNavItem}}" />
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource Kind=ColorText, AnchorControlType={x:Type atom:PaginationNavItem}}" />
        <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
            <Setter Property="IconBrush" Value="{TemplateBinding Foreground}" />
        </Style>
        <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
            <Setter Property="IconBrush" Value="{atom:OwnerTokenResource Kind=ColorPrimary, AnchorControlType={x:Type atom:PaginationNavItem}}" />
        </Style>

        <Style Selector="^[PaginationItemType=PageIndicator]">
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="^[PaginationItemType=Previous], ^[PaginationItemType=Next]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[PaginationItemType=JumpPrevious], ^[PaginationItemType=JumpNext]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="IconBrush" Value="{atom:OwnerTokenResource Kind=ColorTextDisabled, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Opacity" Value="0" />
            </Style>
            <Style Selector="^:pointerover, ^:focus-visible">
                <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[IsEnabled=True]">
            <Setter Property="Cursor" Value="Hand" />

            <Style Selector="^[PaginationItemType=PageIndicator]">
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{atom:OwnerTokenResource Kind=ColorPrimary, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                    <Setter Property="Background"
                            Value="{atom:PaginationTokenResource ItemActiveBg}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderBrush"
                            Value="{atom:OwnerTokenResource Kind=ColorPrimary, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Foreground"
                                Value="{atom:OwnerTokenResource Kind=ColorPrimaryHover, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:OwnerTokenResource Kind=ColorPrimaryHover, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                    </Style>
                </Style>
                <Style Selector="^:not(:selected)">
                    <Setter Property="Background" Value="{atom:PaginationTokenResource ItemBg}" />
                    <Setter Property="Foreground" Value="{atom:OwnerTokenResource Kind=ColorText, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Background"
                                Value="{atom:OwnerTokenResource Kind=ColorBgTextHover, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                    </Style>
                    <Style Selector="^:pressed">
                        <Setter Property="Background"
                                Value="{atom:OwnerTokenResource Kind=ColorBgTextActive, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                    </Style>
                </Style>
            </Style>

            <Style Selector="^[PaginationItemType=Previous], ^[PaginationItemType=Next]">
                <Setter Property="Background"
                        Value="{atom:OwnerTokenResource Kind=ColorTransparent, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                <Setter Property="Foreground"
                        Value="{atom:OwnerTokenResource Kind=ColorText, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                <Style Selector="^:pointerover">
                    <Setter Property="Background"
                            Value="{atom:OwnerTokenResource Kind=ColorBgTextHover, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background"
                            Value="{atom:OwnerTokenResource Kind=ColorBgTextActive, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSize}" />
            <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSize}" />

            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width" Value="{atom:OwnerTokenResource Kind=IconSizeLG, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource Kind=IconSizeLG, AnchorControlType={x:Type atom:PaginationNavItem}}" />
            </Style>
            <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
                <Setter Property="Width" Value="{atom:OwnerTokenResource Kind=IconSizeLG, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource Kind=IconSizeLG, AnchorControlType={x:Type atom:PaginationNavItem}}" />
            </Style>

        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSize}" />
            <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSize}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width" Value="{atom:OwnerTokenResource Kind=IconSize, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource Kind=IconSize, AnchorControlType={x:Type atom:PaginationNavItem}}" />
            </Style>
            <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
                <Setter Property="Width" Value="{atom:OwnerTokenResource Kind=IconSize, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource Kind=IconSize, AnchorControlType={x:Type atom:PaginationNavItem}}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSizeSM}" />
            <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSizeSM}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width" Value="{atom:OwnerTokenResource Kind=IconSizeSM, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource Kind=IconSizeSM, AnchorControlType={x:Type atom:PaginationNavItem}}" />
            </Style>
            <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
                <Setter Property="Width" Value="{atom:OwnerTokenResource Kind=IconSizeSM, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource Kind=IconSizeSM, AnchorControlType={x:Type atom:PaginationNavItem}}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:PaginationTokenResource ItemActiveColorDisabled}" />
            <Style Selector="^:selected">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background"
                        Value="{atom:PaginationTokenResource ItemActiveBgDisabled}" />
            </Style>

            <Style Selector="^[PaginationItemType=JumpPrevious], ^[PaginationItemType=JumpNext]">
                <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IconBrush" Value="{atom:OwnerTokenResource Kind=ColorTextDisabled, AnchorControlType={x:Type atom:PaginationNavItem}}" />
                </Style>
            </Style>

        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="BorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="Foreground" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </atom:TokenTransitions>
            </Setter>
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter, ^ /template/ atom|IconPresenter#JumpIconPresenter">
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <DoubleTransition Property="Opacity" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    </atom:TokenTransitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
