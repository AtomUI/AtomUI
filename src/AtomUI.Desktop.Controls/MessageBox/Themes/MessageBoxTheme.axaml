<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:MessageBox}" TargetType="atom:MessageBox">
        <Setter Property="atom:DialogSurface.ThemeHeaderBg" Value="{atom:MessageBoxTokenResource HeaderBg}" />
        <Setter Property="atom:DialogSurface.ThemeHeaderMarginBottom" Value="{atom:MessageBoxTokenResource HeaderMarginBottom}" />
        <Setter Property="atom:DialogSurface.ThemeLogoSize" Value="{atom:MessageBoxTokenResource LogoSize}" />
        <Setter Property="atom:DialogSurface.ThemeHeaderFontSize" Value="{atom:MessageBoxTokenResource HeaderFontSize}" />
        <Setter Property="atom:DialogSurface.ThemeHeaderColor" Value="{atom:MessageBoxTokenResource HeaderColor}" />
        <Setter Property="atom:DialogSurface.ThemeContentBg" Value="{atom:MessageBoxTokenResource ContentBg}" />
        <Setter Property="atom:DialogSurface.ThemeHeaderPadding" Value="{atom:MessageBoxTokenResource HeaderPadding}" />
        <Setter Property="atom:DialogSurface.ThemeContentPadding" Value="{atom:MessageBoxTokenResource ContentPadding}" />
        <Setter Property="atom:DialogSurface.ThemeWindowContentPadding" Value="{atom:MessageBoxTokenResource WindowContentPadding}" />
        <Setter Property="atom:DialogSurface.ThemeFooterBg" Value="{atom:MessageBoxTokenResource FooterBg}" />
        <Setter Property="atom:DialogSurface.ThemeFooterPadding" Value="{atom:MessageBoxTokenResource FooterPadding}" />
        <Setter Property="atom:DialogSurface.ThemeFooterMarginTop" Value="{atom:MessageBoxTokenResource FooterMarginTop}" />
        <Setter Property="atom:DialogSurface.ThemeCloseBtnSize" Value="{atom:MessageBoxTokenResource CloseBtnSize}" />
        <Setter Property="atom:DialogSurface.ThemeMinHeight" Value="{atom:MessageBoxTokenResource MinHeight}" />
        <Setter Property="atom:DialogSurface.ThemeMinWidth" Value="{atom:MessageBoxTokenResource MinWidth}" />
        <Setter Property="atom:DialogSurface.ThemeButtonGroupSpacing" Value="{atom:MessageBoxTokenResource ButtonGroupSpacing}" />
        <Setter Property="atom:DialogSurface.ThemeLoadingIndicatorMargin" Value="{atom:MessageBoxTokenResource LoadingIndicatorMargin}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel />
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled" Value="{atom:MessageBoxTokenResource EnableMotion}"/>
        <Setter Property="HostMinWidth" Value="{atom:MessageBoxTokenResource MinWidth}"/>
        
    </ControlTheme>
</ResourceDictionary>
