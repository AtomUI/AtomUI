<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type EmbeddableControlRoot}" TargetType="EmbeddableControlRoot">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                    <Border Background="{TemplateBinding Background}">
                        <VisualLayerManager>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"/>
                        </VisualLayerManager>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="Background" Value="{atom:OwnerTokenResource ColorBgContainer}" />
        <Setter Property="TransparencyBackgroundFallback" Value="{atom:OwnerTokenResource ColorBgContainer}" />
        <Setter Property="TopLevel.SystemBarColor">
            <MultiBinding Converter="{x:Static themes:EmbeddingThemeConstants.SystemBarBrushConverter}">
                <atom:OwnerTokenResource Kind="ColorBgContainer" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}" />
        <Setter Property="FontFamily" Value="{atom:OwnerTokenResource FontFamily}" />
        
    </ControlTheme>
</ResourceDictionary>
