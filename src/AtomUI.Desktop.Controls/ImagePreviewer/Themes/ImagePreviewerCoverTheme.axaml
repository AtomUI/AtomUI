<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImagePreviewerCover}" TargetType="atom:ImagePreviewerCover">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Background="{TemplateBinding Background}"
                                         Padding="{TemplateBinding Padding}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding OwnerCornerRadius}">
                    <Panel>
                        <atom:ImagePreviewRenderer Source="{TemplateBinding ImageSource}"
                                                   Classes.semantic-image="True"
                                                   Stretch="Uniform"
                                                   IsVisible="{TemplateBinding ImageSource, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Border Name="PART_LoadingPresenter"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="{CompiledBinding $self.(atom:ImageViewer.CoverImageSize)}"
                                MinHeight="{CompiledBinding $self.(atom:ImageViewer.CoverImageSize)}"
                                Background="{CompiledBinding $self.(atom:ImageViewer.TertiaryFill)}"
                                CornerRadius="{TemplateBinding OwnerCornerRadius}"
                                IsVisible="False">
                            <Panel HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                                <atom:SkeletonImage Name="PART_LoadingSkeleton"
                                                    IsActive="False"
                                                    IsVisible="{TemplateBinding LoadingContent, Converter={x:Static ObjectConverters.IsNull}}" />
                                <ContentPresenter Content="{TemplateBinding LoadingContent}"
                                                  ContentTemplate="{TemplateBinding LoadingContentTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{TemplateBinding LoadingContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>
                        </Border>
                        <Border Name="PART_ErrorPresenter"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="{CompiledBinding $self.(atom:ImageViewer.CoverImageSize)}"
                                MinHeight="{CompiledBinding $self.(atom:ImageViewer.CoverImageSize)}"
                                Background="{CompiledBinding $self.(atom:ImageViewer.TertiaryFill)}"
                                CornerRadius="{TemplateBinding OwnerCornerRadius}"
                                IsVisible="{TemplateBinding HasError}">
                            <Panel HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                                <StackPanel Name="DefaultErrorLayout"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="{CompiledBinding $self.(atom:ImageViewer.SpacingXXS)}"
                                            IsVisible="{TemplateBinding ErrorContent, Converter={x:Static ObjectConverters.IsNull}}">
                                    <antdicons:PictureOutlined Name="DefaultErrorIcon"
                                                              HorizontalAlignment="Center" />
                                    <TextBlock Name="DefaultErrorText"
                                               Text="{atom:ImagePreviewerLangResource ImageLoadFailed}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </StackPanel>
                                <ContentPresenter Content="{TemplateBinding ErrorContent}"
                                                  ContentTemplate="{TemplateBinding ErrorContentTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{TemplateBinding ErrorContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>
                        </Border>
                        <Border Name="Mask"
                                Classes.semantic-cover="True"
                                Opacity="{TemplateBinding MaskOpacity}"
                                IsVisible="{TemplateBinding IsCoverMaskVisible}"
                                Background="{CompiledBinding $self.(atom:ImageViewer.MaskBackground)}"
                                TextBlock.Foreground="{CompiledBinding $self.(atom:ImageViewer.InverseTextForeground)}"
                                CornerRadius="{TemplateBinding OwnerCornerRadius}"
                                Margin="{Binding OwnerMaskMargin, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter Name="MaskContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </Panel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[IsCoverMaskVisible=True]">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
      
        <Setter Property="IsMotionEnabled" Value="{CompiledBinding $self.(atom:ImageViewer.DefaultMotionEnabled)}" />
        <Style Selector="^ /template/ TextBlock#DefaultErrorText">
            <Setter Property="Foreground" Value="{CompiledBinding $self.(atom:ImageViewer.TertiaryTextForeground)}" />
        </Style>
        <Style Selector="^ /template/ atom|Icon#DefaultErrorIcon">
            <Setter Property="Width" Value="{CompiledBinding $self.(atom:ImageViewer.ErrorIconSize)}" />
            <Setter Property="Height" Value="{CompiledBinding $self.(atom:ImageViewer.ErrorIconSize)}" />
            <Setter Property="StrokeBrush" Value="{CompiledBinding $self.(atom:ImageViewer.TertiaryTextForeground)}" />
        </Style>

        <Style Selector="^:loading:not(:has-image) /template/ Border#PART_LoadingPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:loading-skeleton /template/ atom|SkeletonImage#PART_LoadingSkeleton">
            <Setter Property="IsActive" Value="True" />
        </Style>

        <Style Selector="^[IsCoverMaskVisible=True]:pointerover">
            <Setter Property="MaskOpacity" Value="1" />
        </Style>

        <!-- Preview visibility contract of the semantic part: the Gallery highlight session sets
        SemanticPartPreviewState.IsPreviewTarget on targets of RestHidden parts (the hover mask, transparent at
        rest, becomes visible in the preview). Each control theme decides how it appears. The style outranks the
        TemplateBinding, and the state falls back to the MaskOpacity binding automatically once it is removed.
        -->
        <Style Selector="^ /template/ Border#Mask[(atom|SemanticPartPreviewState.IsPreviewTarget)=True]">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <DoubleTransition Property="MaskOpacity" atom:TokenTransitions.Duration="StateTransitionDurationSlow" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

    </ControlTheme>
</ResourceDictionary>
