<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:Class="AtomUI.Desktop.Controls.Themes.WindowTitleBarButtonTheme"
    x:ClassModifier="internal"
    TargetType="atom:WindowTitleBarButton">
    <ControlTheme.BasedOn>
        <themes:IconButtonTheme TargetType="{x:Type atom:WindowTitleBarButton}" />
    </ControlTheme.BasedOn>

    <!-- 复用 managed caption 的共享几何外壳：背景层与内容层由 CaptionButtonFrame 拥有，
         这里只声明 AddOn 自己的 presenter 契约，因此不复制 caption band 的几何结构。 -->
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:WindowTitleBarButton">
            <atom:CaptionButtonFrame Background="{TemplateBinding Background}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Padding="{TemplateBinding Padding}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch">
                <atom:IconPresenter Name="IconPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding IconBrush}"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}" />
            </atom:CaptionButtonFrame>
        </ControlTemplate>
    </Setter>

    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="{atom:WindowTitleBarTokenResource CaptionButtonPadding}" />
    <Setter Property="IconWidth" Value="{atom:WindowTitleBarTokenResource CaptionButtonIconSize}" />
    <Setter Property="IconHeight" Value="{atom:WindowTitleBarTokenResource CaptionButtonIconSize}" />
    <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
    <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource ActiveBgColor}" />
    <Setter Property="IconBrush" Value="{atom:WindowTitleBarTokenResource ActiveColor}" />

    <Style Selector="^[IsWindowActive=False]">
        <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource InactiveBgColor}" />
        <Setter Property="IconBrush" Value="{atom:WindowTitleBarTokenResource InactiveColor}" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource InactiveHoverBgColor}" />
        </Style>
    </Style>

    <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource ActiveHoverBgColor}" />
    </Style>

    <Style Selector="^:pressed">
        <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource ActivePressedBgColor}" />
    </Style>

    <Style Selector="^:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorTextDisabled}" />
    </Style>

    <Style Selector="^[IsWindowActive=False]:disabled">
        <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorTextDisabled}" />
    </Style>

    <Style Selector="^[HostMotionEnabled=False]">
        <Setter Property="IsMotionEnabled" Value="False" />
    </Style>

    <Style Selector="^[HostOsType=macOS]">
        <Setter Property="CornerRadius" Value="{atom:WindowTitleBarTokenResource CaptionButtonCornerRadius}" />
    </Style>

    <Style Selector="^[HostOsType=Linux]">
        <Setter Property="CornerRadius" Value="{atom:WindowTitleBarTokenResource CaptionButtonCornerRadius}" />
        <Style Selector="^ /template/ atom|CaptionButtonFrame">
            <Setter Property="BackgroundInset" Value="{atom:WindowTitleBarTokenResource CaptionButtonBackgroundInset}" />
        </Style>
    </Style>

    <Style Selector="^[HostOsType=Windows]">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource ActiveHoverBgColor}" />
        </Style>

        <Style Selector="^[IsWindowActive=False]">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IconBrush" Value="{atom:WindowTitleBarTokenResource InactiveColor}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource InactiveHoverBgColor}" />
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource ActivePressedBgColor}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorTextDisabled}" />
        </Style>
    </Style>
</ControlTheme>
