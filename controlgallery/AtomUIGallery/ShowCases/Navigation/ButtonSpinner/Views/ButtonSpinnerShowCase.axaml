<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.ButtonSpinner.ButtonSpinnerShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.ButtonSpinner"
             x:DataType="vm:ButtonSpinnerViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="ButtonSpinner"
                    Category="{gallery:ButtonSpinnerShowCaseLangResource ComponentCategory}"
                    Status="{gallery:ButtonSpinnerShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:ButtonSpinnerShowCaseLangResource PageSubtitle}"
                    Description="{gallery:ButtonSpinnerShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="Spinner" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:ButtonSpinnerViewModel">
                    <gallery:SemanticPartPreview Name="ButtonSpinnerSemanticPreview"
                                                 SemanticOwner="{Binding #ButtonSpinnerSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:ButtonSpinner}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:ButtonSpinner Name="ButtonSpinnerSemanticOwner"
                                                Width="320"
                                                InnerLeftContent="￥"
                                                InnerRightContent="RMB">
                                <atom:TextBlock HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="床前明月光" />
                            </atom:ButtonSpinner>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:ButtonSpinnerShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:ButtonSpinnerShowCaseLangResource SemanticContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="innerLeftContent"
                                Description="{gallery:ButtonSpinnerShowCaseLangResource SemanticInnerLeftContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="innerRightContent"
                                Description="{gallery:ButtonSpinnerShowCaseLangResource SemanticInnerRightContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="actions"
                                Description="{gallery:ButtonSpinnerShowCaseLangResource SemanticActionsDescription}" />
                            <gallery:SemanticPartDescription
                                Path="increaseButton"
                                Description="{gallery:ButtonSpinnerShowCaseLangResource SemanticIncreaseButtonDescription}" />
                            <gallery:SemanticPartDescription
                                Path="decreaseButton"
                                Description="{gallery:ButtonSpinnerShowCaseLangResource SemanticDecreaseButtonDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:ButtonSpinnerShowCaseLangResource BasicTitle}"
        Description="{gallery:ButtonSpinnerShowCaseLangResource BasicDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ButtonSpinnerViewModel">
        <atom:ButtonSpinner>
            <atom:TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="床前明月光" />
        </atom:ButtonSpinner>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ButtonSpinnerShowCaseLangResource ThreeSizesTitle}"
        Description="{gallery:ButtonSpinnerShowCaseLangResource ThreeSizesDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ButtonSpinnerViewModel">
        <Grid ColumnDefinitions="Auto,Auto"
              RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="10"
              Margin="0,0,20,0">
            <atom:TextBlock VerticalAlignment="Center"
                            Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                            Text="{gallery:ButtonSpinnerShowCaseLangResource P2LabelSizeTypeLarge}" />
            <atom:ButtonSpinner Grid.Column="1" SizeType="Large">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:TextBlock Grid.Row="1"
                            VerticalAlignment="Center"
                            Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                            Text="{gallery:ButtonSpinnerShowCaseLangResource P2LabelSizeTypeMiddle}" />
            <atom:ButtonSpinner Grid.Row="1" Grid.Column="1" SizeType="Middle">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:TextBlock Grid.Row="2"
                            VerticalAlignment="Center"
                            Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                            Text="{gallery:ButtonSpinnerShowCaseLangResource P2LabelSizeTypeSmall}" />
            <atom:ButtonSpinner Grid.Row="2" Grid.Column="1" SizeType="Small">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:TextBlock Grid.Row="3"
                            VerticalAlignment="Center"
                            Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                            Text="{gallery:ButtonSpinnerShowCaseLangResource P2LabelSizeTypeCustom}" />
            <atom:ButtonSpinner Grid.Row="3"
                                Grid.Column="1"
                                SizeType="Custom"
                                Height="36"
                                SpinnerHandleWidth="28">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Text="床前明月光" />
            </atom:ButtonSpinner>
        </Grid>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ButtonSpinnerShowCaseLangResource VariantsTitle}"
        Description="{gallery:ButtonSpinnerShowCaseLangResource VariantsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ButtonSpinnerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ButtonSpinner StyleVariant="Outlined">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>
            <atom:ButtonSpinner StyleVariant="Filled">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>
            <atom:ButtonSpinner StyleVariant="Borderless">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ButtonSpinnerShowCaseLangResource DisabledTitle}"
        Description="{gallery:ButtonSpinnerShowCaseLangResource DisabledDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ButtonSpinnerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ButtonSpinner StyleVariant="Outlined" IsEnabled="False">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>
            <atom:ButtonSpinner StyleVariant="Filled" IsEnabled="False">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>
            <atom:ButtonSpinner StyleVariant="Borderless" IsEnabled="False">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ButtonSpinnerShowCaseLangResource PrePostTabTitle}"
        Description="{gallery:ButtonSpinnerShowCaseLangResource PrePostTabDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ButtonSpinnerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ButtonSpinner
                LeftAddOn="http://"
                RightAddOn=".com"
                Width="400"
                HorizontalAlignment="Left">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                RightAddOn="{antdicons:AntDesignIconProvider Kind=SettingOutlined}"
                Width="400"
                HorizontalAlignment="Left">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                LeftAddOn="http://"
                Width="400"
                HorizontalAlignment="Left"
                InnerRightContent=".com">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ButtonSpinnerShowCaseLangResource PrefixSuffixTitle}"
        Description="{gallery:ButtonSpinnerShowCaseLangResource PrefixSuffixDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ButtonSpinnerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">

            <atom:ButtonSpinner
                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=UserOutlined, FillBrush=#D7D7D7}"
                InnerRightContent="{antdicons:AntDesignIconProvider Kind=InfoCircleOutlined, FillBrush=#8C8C8C}"
                Width="400"
                HorizontalAlignment="Left">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                InnerLeftContent="￥"
                InnerRightContent="RMB"
                Width="400"
                HorizontalAlignment="Left">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                InnerLeftContent="￥" InnerRightContent="RMB" IsEnabled="False"
                Width="400"
                HorizontalAlignment="Left">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ButtonSpinnerShowCaseLangResource StatusTitle}"
        Description="{gallery:ButtonSpinnerShowCaseLangResource StatusDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ButtonSpinnerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:ButtonSpinner
                Status="Error"
                Width="400"
                HorizontalAlignment="Left">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>
            <atom:ButtonSpinner
                Status="Warning"
                Width="400"
                HorizontalAlignment="Left">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                Status="Error"
                Width="400"
                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                HorizontalAlignment="Left">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                Status="Warning"
                Width="400"
                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                HorizontalAlignment="Left">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                Status="Error"
                Width="400"
                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                HorizontalAlignment="Left"
                StyleVariant="Filled">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                Status="Warning"
                Width="400"
                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                HorizontalAlignment="Left"
                StyleVariant="Filled">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                Status="Error"
                Width="400"
                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                HorizontalAlignment="Left"
                StyleVariant="Borderless">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

            <atom:ButtonSpinner
                Status="Warning"
                Width="400"
                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined, FillBrush=Red}"
                HorizontalAlignment="Left"
                StyleVariant="Borderless">
                <atom:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="床前明月光" />
            </atom:ButtonSpinner>

        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ButtonSpinnerShowCaseLangResource SemanticPartStyleTitle}"
        Description="{gallery:ButtonSpinnerShowCaseLangResource SemanticPartStyleDescription}"
        SourceKey="buttonspinner-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        Span="Full"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ButtonSpinnerViewModel">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Left"
                            Spacing="12">
                    <StackPanel.Styles>
                        <Style Selector="atom|ButtonSpinner.semantic-object">
                            <Setter Property="BorderBrush" Value="#1677FF" />
                            <atom:ButtonSpinnerActionsStyle x:SetterTargetType="TemplatedControl">
                                <Setter Property="Background" Value="#F0F5FF" />
                                <Setter Property="BorderBrush" Value="#1677FF" />
                            </atom:ButtonSpinnerActionsStyle>
                            <atom:ButtonSpinnerInnerLeftContentStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="Foreground" Value="#1677FF" />
                            </atom:ButtonSpinnerInnerLeftContentStyle>
                            <atom:ButtonSpinnerIncreaseButtonStyle x:SetterTargetType="atom:IconButton">
                                <Setter Property="IconBrush" Value="#1677FF" />
                            </atom:ButtonSpinnerIncreaseButtonStyle>
                            <atom:ButtonSpinnerDecreaseButtonStyle x:SetterTargetType="atom:IconButton">
                                <Setter Property="IconBrush" Value="#1677FF" />
                            </atom:ButtonSpinnerDecreaseButtonStyle>
                        </Style>
                        <Style Selector="atom|ButtonSpinner.semantic-function">
                            <Setter Property="BorderBrush" Value="#722ED1" />
                            <atom:ButtonSpinnerActionsStyle x:SetterTargetType="TemplatedControl">
                                <Setter Property="Background" Value="#F9F0FF" />
                                <Setter Property="BorderBrush" Value="#722ED1" />
                            </atom:ButtonSpinnerActionsStyle>
                            <atom:ButtonSpinnerInnerLeftContentStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="Foreground" Value="#722ED1" />
                            </atom:ButtonSpinnerInnerLeftContentStyle>
                            <atom:ButtonSpinnerIncreaseButtonStyle x:SetterTargetType="atom:IconButton">
                                <Setter Property="IconBrush" Value="#722ED1" />
                            </atom:ButtonSpinnerIncreaseButtonStyle>
                            <atom:ButtonSpinnerDecreaseButtonStyle x:SetterTargetType="atom:IconButton">
                                <Setter Property="IconBrush" Value="#722ED1" />
                            </atom:ButtonSpinnerDecreaseButtonStyle>
                        </Style>
                    </StackPanel.Styles>

                    <atom:ButtonSpinner Classes="semantic-object"
                                        Width="360"
                                        HorizontalAlignment="Left"
                                        IsButtonSpinnerFloatable="False"
                                        InnerLeftContent="Object">
                        <atom:TextBlock HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="床前明月光" />
                    </atom:ButtonSpinner>
                    <atom:ButtonSpinner Classes="semantic-function"
                                        Width="360"
                                        HorizontalAlignment="Left"
                                        IsButtonSpinnerFloatable="False"
                                        InnerLeftContent="Function">
                        <atom:TextBlock HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="床前明月光" />
                    </atom:ButtonSpinner>
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
        </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
