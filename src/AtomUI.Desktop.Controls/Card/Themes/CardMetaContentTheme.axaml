<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CardMetaContent}" TargetType="atom:CardMetaContent">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True" 
                           HorizontalSpacing="{atom:CardMetaContentTokenResource Spacing}">
                    <ContentPresenter Name="AvatarContentPresenter"
                                      Classes.semantic-avatar="True"
                                      DockPanel.Dock="Left"
                                      Content="{TemplateBinding Avatar}"
                                      VerticalAlignment="Top"/>
                    <DockPanel Classes.semantic-section="True"
                               LastChildFill="True"
                               VerticalSpacing="{atom:CardMetaContentTokenResource SpacingXS}">
                        <ContentPresenter Name="TitleContentPresenter"
                                          Classes.semantic-title="True"
                                          DockPanel.Dock="Top"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                        <ContentPresenter Name="DescriptionContentPresenter"
                                          Classes.semantic-description="True"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </DockPanel>
                </DockPanel>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ ContentPresenter#TitleContentPresenter">
            <Setter Property="Foreground" Value="{atom:CardMetaContentTokenResource ColorTextHeading}" />
            <Setter Property="FontWeight" Value="{atom:CardMetaContentTokenResource FontWeightStrong}" />
            <Setter Property="FontSize" Value="{atom:CardMetaContentTokenResource FontSizeLG}" />
        </Style>
        
        <Style Selector="^ /template/ ContentPresenter#DescriptionContentPresenter">
            <Setter Property="Foreground" Value="{atom:CardMetaContentTokenResource ColorTextDescription}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
