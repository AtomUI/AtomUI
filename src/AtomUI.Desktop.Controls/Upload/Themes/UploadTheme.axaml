<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Upload}" TargetType="atom:Upload">
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>


        <Style Selector="^[ListType=Text], ^[ListType=Picture]">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
        <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Name="RootLayout"
                                Orientation="Vertical"
                                Spacing="{atom:UploadTokenResource SpacingXS}">
                        <ContentPresenter Name="PART_TriggerContent"
                                          Content="{TemplateBinding TriggerContent}"
                                          ContentTemplate="{TemplateBinding TriggerContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <atom:UploadList Name="PART_UploadList"
                                         Classes.semantic-list="True"
                                         ListType="{TemplateBinding ListType}"
                                         IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                         IsVisible="{TemplateBinding IsShowUploadList}"
                                         ListMaxHeight="{TemplateBinding ListMaxHeight}"
                                         ListScrollBarVisibility="{TemplateBinding ListScrollBarVisibility}"
                                         ItemsSource="{TemplateBinding EffectiveFiles}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[ListType=PictureCard], ^[ListType=PictureCircle]">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Name="RootLayout"
                                Orientation="Vertical"
                                Spacing="{atom:UploadTokenResource SpacingXS}">
                        <atom:UploadPictureShapeList Name="PART_UploadList"
                                                     Classes.semantic-list="True"
                                                     ListType="{TemplateBinding ListType}"
                                                     IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                     IsShowUploadList="{TemplateBinding IsShowUploadList}"
                                                     ListMaxHeight="{TemplateBinding ListMaxHeight}"
                                                     ListScrollBarVisibility="{TemplateBinding ListScrollBarVisibility}"
                                                     ItemsSource="{TemplateBinding EffectivePictureItems}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^[ListType=PictureCard]">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="^[ListType=PictureCircle]">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:UploadTokenResource ColorTextDisabled}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
