<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal"
    xmlns:atom="https://atomui.net">
    <ControlTheme x:Key="{x:Type atom:TimePicker}" TargetType="atom:TimePicker">
        <ControlTheme.BasedOn>
            <atom:InfoPickerInputTheme TargetType="atom:TimePicker" />
        </ControlTheme.BasedOn>
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:TimePickerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:TimePickerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="AmText" Value="{atom:TimePickerLangResource AMText}" />
        <Setter Property="PmText" Value="{atom:TimePickerLangResource PMText}" />
        <Setter Property="BorderThickness" Value="{atom:TimePickerTokenResource BorderThickness}" />
        <Style Selector="^[SizeType=Large]">
            <Setter Property="Padding" Value="{atom:TimePickerTokenResource InputPaddingLG}" />
            <Setter Property="CornerRadius" Value="{atom:TimePickerTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="Padding" Value="{atom:TimePickerTokenResource InputPadding}" />
            <Setter Property="CornerRadius" Value="{atom:TimePickerTokenResource BorderRadius}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Padding" Value="{atom:TimePickerTokenResource InputPaddingSM}" />
            <Setter Property="CornerRadius" Value="{atom:TimePickerTokenResource BorderRadiusSM}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>