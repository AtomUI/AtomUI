<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:UploadPictureShapeList}" TargetType="atom:UploadPictureShapeList">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="True">
                    <ScrollViewer MaxHeight="{TemplateBinding ListMaxHeight}"
                                  VerticalScrollBarVisibility="{TemplateBinding ListScrollBarVisibility}">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel LineSpacing="{atom:OwnerTokenResource SpacingXS, SourceControlType={x:Type atom:Upload}}"
                           ItemSpacing="{atom:OwnerTokenResource SpacingXS, SourceControlType={x:Type atom:Upload}}"/>
            </ItemsPanelTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
