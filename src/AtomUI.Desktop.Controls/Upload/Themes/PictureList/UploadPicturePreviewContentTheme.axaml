<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:UploadPicturePreviewContent}" TargetType="atom:UploadPicturePreviewContent">
        <ControlTheme.BasedOn>
            <atom:AbstractUploadPictureContentTheme TargetType="atom:UploadPicturePreviewContent" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         Padding="{TemplateBinding Padding}">
                    <DockPanel LastChildFill="True" Name="ContentLayout">
                        <atom:UploadImagePreviewer Name="PART_ImagePreviewer"
                                                   IsShowCoverMask="False"
                                                   DockPanel.Dock="Left"
                                                   ItemsSource="{TemplateBinding ItemsSource}"
                                                   VerticalAlignment="Stretch" />
                        <atom:IconButton Icon="{antdicons:AntDesignIconProvider DeleteOutlined}"
                                         DockPanel.Dock="Right"
                                         VerticalAlignment="Center"
                                         Tag="{x:Static atom:UploadListActions.Remove}" />
                        <atom:HyperLinkTextBlock Name="PART_FileName"
                                                 Text="{TemplateBinding FileName}"
                                                 VerticalAlignment="Center"
                                                 TextTrimming="{x:Static TextTrimming.CharacterEllipsis}" />
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ atom|ImagePreviewer#PART_ImagePreviewer">
            <Setter Property="Width" Value="{atom:UploadTokenResource PictureListPreviewerSize}" />
            <Setter Property="Height" Value="{atom:UploadTokenResource PictureListPreviewerSize}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="^ /template/ DockPanel#ContentLayout">
            <Setter Property="HorizontalSpacing" Value="{atom:OwnerTokenResource SpacingXS, SourceControlType={x:Type atom:Upload}}" />
        </Style>

        <Style Selector="^ /template/ atom|IconButton">
            <Setter Property="IconBrush" Value="{atom:OwnerTokenResource ColorTextSecondary, SourceControlType={x:Type atom:Upload}}" />
            <Setter Property="Padding" Value="{atom:OwnerTokenResource PaddingXXS, SourceControlType={x:Type atom:Upload}}" />
        </Style>

        <Style Selector="^ /template/ atom|IconButton:pointerover">
            <Setter Property="IconBrush" Value="{atom:OwnerTokenResource ColorTextSecondary, SourceControlType={x:Type atom:Upload}}" />
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorBgTextHover, SourceControlType={x:Type atom:Upload}}" />
        </Style>

        <Style Selector="^[Status=Failed]">
            <Style Selector="^ /template/ atom|IconButton">
                <Setter Property="IconBrush" Value="{atom:OwnerTokenResource ColorError, SourceControlType={x:Type atom:Upload}}" />
            </Style>
        </Style>

        <Style Selector="^[Status=Cancelled]">
            <Style Selector="^ /template/ atom|IconButton">
                <Setter Property="IconBrush" Value="{atom:OwnerTokenResource ColorError, SourceControlType={x:Type atom:Upload}}" />
            </Style>
        </Style>
        
    </ControlTheme>
</ResourceDictionary>
