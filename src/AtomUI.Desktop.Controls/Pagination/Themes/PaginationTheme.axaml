<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StringToTextBlockConverter" VerticalAlignment="Center"/>
    <ControlTheme x:Key="{x:Type atom:Pagination}" TargetType="atom:Pagination">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ItemSize" Value="{atom:PaginationTokenResource ItemSize}" />
        <Setter Property="ItemColor" Value="{atom:PaginationTokenResource ItemColor}" />
        <Setter Property="ItemHoverColor" Value="{atom:PaginationTokenResource ItemHoverColor}" />
        <Setter Property="ItemHoverBg" Value="{atom:PaginationTokenResource ItemHoverBg}" />
        <Setter Property="ItemBorderRadius" Value="{atom:PaginationTokenResource ItemBorderRadius}" />
        <Setter Property="ItemActiveColorDisabled" Value="{atom:PaginationTokenResource ItemActiveColorDisabled}" />
        <Setter Property="LayoutSpacing" Value="{atom:PaginationTokenResource PaginationLayoutSpacing}" />
        <Setter Property="QuickJumperInputWidth" Value="{atom:PaginationTokenResource PaginationQuickJumperInputWidth}" />
        <Setter Property="ItemPaddingInline" Value="{atom:PaginationTokenResource PaginationItemPaddingInline}" />

        <Setter Property="QuickJumperSpacing" Value="{atom:PaginationTokenResource PaginationLayoutSpacing}" />

        <Style Selector="^[SizeType=Small]">
            <Setter Property="ItemSize" Value="{atom:PaginationTokenResource ItemSizeSM}" />
            <Setter Property="LayoutSpacing" Value="{atom:PaginationTokenResource PaginationLayoutMiniSpacing}" />
            <Setter Property="QuickJumperInputWidth" Value="{atom:PaginationTokenResource PaginationMiniQuickJumperInputWidth}" />
        </Style>

        <Setter Property="Template">
            <ControlTemplate>
                <atom:DashedBorder Background="{TemplateBinding Background}"
                                  BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  StrokeDashArray="{TemplateBinding BorderDashArray}"
                                  StrokeDaskOffset="{TemplateBinding BorderDashOffset}">
                    <StackPanel Name="PART_RootLayout"
                                Orientation="Horizontal"
                                IsVisible="{TemplateBinding IsEffectiveVisible}">
                        <ContentPresenter Name="PART_TotalInfoPresenter"
                                          IsVisible="{TemplateBinding IsShowTotalInfo}"
                                          Content="{TemplateBinding TotalInfoText, Mode=Default, Converter={StaticResource StringToTextBlockConverter}}" />
                        <atom:PaginationNav
                            Name="PART_Nav"
                            Classes.semantic-scope-nav="True"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                            SizeType="{TemplateBinding SizeType}"
                            ItemSize="{TemplateBinding ItemSize}"
                            ItemActiveColorDisabled="{TemplateBinding ItemActiveColorDisabled}"
                            ItemPaddingInline="{TemplateBinding ItemPaddingInline}"
                            ItemColor="{TemplateBinding ItemColor}"
                            ItemHoverColor="{TemplateBinding ItemHoverColor}"
                            ItemHoverBg="{TemplateBinding ItemHoverBg}"
                            ItemBorderRadius="{TemplateBinding ItemBorderRadius}" />
                        <ContentPresenter Name="PART_SizeChangerPresenter"
                                          IsVisible="{TemplateBinding IsShowSizeChanger}"
                                          Content="{TemplateBinding EffectiveSizeChangerContent}"
                                          ContentTemplate="{TemplateBinding EffectiveSizeChangerTemplate}" />
                        <ContentPresenter Name="PART_QuickJumperBarPresenter"
                                          IsVisible="{TemplateBinding IsShowQuickJumper}"
                                          Content="{TemplateBinding QuickJumperBar}" />
                    </StackPanel>
                </atom:DashedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="IsMotionEnabled" Value="{atom:PaginationTokenResource EnableMotion}"/>
        <Setter Property="PageText" Value="{atom:PaginationLangResource PageText}"/>
        <Setter Property="TotalInfoTemplate" Value="{atom:PaginationLangResource TotalInfoFormat}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Style Selector="^[Align=Start]">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="^[Align=Center]">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="^[Align=End]">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        
        <!-- Every size type reads the spacing its root setters chose. -->
        <Style Selector="^ /template/ StackPanel#PART_RootLayout">
            <Setter Property="Spacing" Value="{TemplateBinding LayoutSpacing}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{CompiledBinding $self.ItemActiveColorDisabled}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
