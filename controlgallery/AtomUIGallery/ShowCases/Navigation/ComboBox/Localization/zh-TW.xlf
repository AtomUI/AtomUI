    <unit id="PrefixSuffixDescription">
      <segment>
        <source>Add a prefix or suffix icons inside input.</source>
        <target state="translated">在輸入框內部添加前綴或後綴圖標。</target>
      </segment>
    </unit>
    <unit id="PrefixSuffixTitle">
