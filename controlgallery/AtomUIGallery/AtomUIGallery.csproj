<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(AtomUIDevelopTargetFramework)</TargetFramework>
        <Nullable>enable</Nullable>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>GeneratedFiles</CompilerGeneratedFilesOutputPath>
        <AtomUILanguageTemplateOutputRootDirectory>$(MSBuildProjectDirectory)</AtomUILanguageTemplateOutputRootDirectory>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/**/*.*"/>
        <AtomUIThemeDefinition Include="Assets/Themes/PolarGreen.theme.xml" />
        <AtomUIThemeDefinition Include="Assets/Themes/SunsetOrange.theme.xml" />
        <AtomUIThemeDefinition Include="Assets/Themes/GoldenPurple.theme.xml" />
        <AtomUIThemeDefinition Include="Assets/Themes/Magenta.theme.xml" />
        <GallerySourceCodeDisplaySource Include="ShowCases/**/*.axaml" />
        <GallerySourceCodeDisplaySource Include="ShowCases/**/*.axaml.cs" />
        <GallerySourceCodeDisplaySource Include="ShowCases/**/ViewModels/**/*.cs" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="GallerySourceOriginalPath" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>AtomUIVersion</_Parameter1>
            <_Parameter2>$(AtomUIVersion)</_Parameter2>
        </AssemblyAttribute>
        <InternalsVisibleTo Include="AtomUIGallery.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/AtomUI.Toolkits.GalleryBase/AtomUI.Toolkits.GalleryBase.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Desktop.Controls/AtomUI.Desktop.Controls.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Desktop.Controls.ColorPicker/AtomUI.Desktop.Controls.ColorPicker.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Desktop.Controls.DataGrid/AtomUI.Desktop.Controls.DataGrid.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Desktop.Controls.Extras/AtomUI.Desktop.Controls.Extras.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Generator/AtomUI.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="../../src/AtomUI.Toolkits.GalleryBase.Generator/AtomUI.Toolkits.GalleryBase.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport"/>
    </ItemGroup>

    <Target Name="PrepareGallerySourceCodeDisplayAdditionalFiles"
            BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile">
        <ItemGroup>
            <_GallerySourceCodeDisplayFile Include="@(GallerySourceCodeDisplaySource)">
                <GallerySourceOriginalPath>%(FullPath)</GallerySourceOriginalPath>
                <GallerySourceMirrorPath>$(IntermediateOutputPath)GallerySourceCodeDisplay/%(Identity).gallerysource</GallerySourceMirrorPath>
            </_GallerySourceCodeDisplayFile>
        </ItemGroup>

        <Copy SourceFiles="@(_GallerySourceCodeDisplayFile)"
              DestinationFiles="@(_GallerySourceCodeDisplayFile->'%(GallerySourceMirrorPath)')"
              SkipUnchangedFiles="true" />

        <ItemGroup>
            <AdditionalFiles Include="@(_GallerySourceCodeDisplayFile->'%(GallerySourceMirrorPath)')">
                <GallerySourceOriginalPath>%(_GallerySourceCodeDisplayFile.GallerySourceOriginalPath)</GallerySourceOriginalPath>
            </AdditionalFiles>
        </ItemGroup>
    </Target>

</Project>
