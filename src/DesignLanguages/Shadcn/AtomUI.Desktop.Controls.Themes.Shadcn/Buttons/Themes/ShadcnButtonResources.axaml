<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net">
    <ControlTheme x:Key="AtomUI.Theme.Shadcn.AtomUI.Desktop.Controls.Button"
                  TargetType="atom:Button">
        <ControlTheme.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceInclude Source="avares://AtomUI.Desktop.Controls/Buttons/Themes/ButtonAppearanceResources.axaml" />
                    <ResourceInclude Source="ShadcnButtonTemplateResources.axaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </ControlTheme.Resources>
        <ControlTheme.BasedOn>
            <StaticResource ResourceKey="AtomUI.Button.Appearance" />
        </ControlTheme.BasedOn>
        <Setter Property="Template" Value="{StaticResource AtomUI.Shadcn.Button.Template}" />
    </ControlTheme>
</ResourceDictionary>
