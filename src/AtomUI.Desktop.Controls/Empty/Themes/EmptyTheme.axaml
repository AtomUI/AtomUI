<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Empty}" TargetType="atom:Empty">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:DashedBorder Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   CornerRadius="{TemplateBinding CornerRadius}"
                                   Padding="{TemplateBinding Padding}"
                                   StrokeDashArray="{TemplateBinding StrokeDashArray}">
                    <StackPanel Orientation="Vertical">
                        <Svg Name="PART_SvgImage"
                             Classes.semantic-image="True"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsVisible="{TemplateBinding Image, Converter={x:Static ObjectConverters.IsNull}}"/>
                        <!-- Image (the image node of Ant Design) sits in a container as high as the built-in
                        illustration
                        -->
                        <ContentPresenter Name="ImageContent"
                                          HorizontalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding Image}"
                                          ContentTemplate="{TemplateBinding ImageTemplate}"
                                          IsVisible="{TemplateBinding Image, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <!-- One description node for text and custom content (Ant Design .ant-empty-description):
                             text styles set on it inherit to the string text and to text inside custom content. -->
                        <ContentPresenter Name="Description"
                                          Classes.semantic-description="True"
                                          HorizontalAlignment="Center"
                                          TextWrapping="Wrap"
                                          Content="{TemplateBinding EffectiveDescription}"
                                          IsVisible="{TemplateBinding IsDescriptionVisible}">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate x:DataType="x:String">
                                    <atom:TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>
                        <ContentPresenter Name="Footer"
                                          Classes.semantic-footer="True"
                                          HorizontalAlignment="Center"
                                          Content="{TemplateBinding Footer}"
                                          ContentTemplate="{TemplateBinding FooterTemplate}"
                                          IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </atom:DashedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="Description" Value="{atom:CommonLangResource NoData}"/>
        
        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ Svg#PART_SvgImage, ^ /template/ ContentPresenter#ImageContent">
                <Setter Property="Height" Value="{atom:EmptyTokenResource EmptyImgHeight}"/>
            </Style>
        </Style>
        
        <Style Selector="^[SizeType=Middle]">
            <Style Selector="^ /template/ Svg#PART_SvgImage, ^ /template/ ContentPresenter#ImageContent">
                <Setter Property="Height" Value="{atom:EmptyTokenResource EmptyImgHeightMD}"/>
            </Style>
        </Style>
        
        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ Svg#PART_SvgImage, ^ /template/ ContentPresenter#ImageContent">
                <Setter Property="Height" Value="{atom:EmptyTokenResource EmptyImgHeightSM}"/>
            </Style>
        </Style>
        
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="UsePresetPaletteTokenResources" Value="True"/>
        
        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ ContentPresenter#Description">
                <Setter Property="Margin" Value="{atom:EmptyTokenResource DescriptionMargin}"/>
            </Style>
        </Style>
        
        <Style Selector="^[SizeType=Middle]">
            <Style Selector="^ /template/ ContentPresenter#Description">
                <Setter Property="Margin" Value="{atom:EmptyTokenResource DescriptionMarginSM}"/>
            </Style>
        </Style>
        
        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ ContentPresenter#Description">
                <Setter Property="Margin" Value="{atom:EmptyTokenResource DescriptionMarginSM}"/>
            </Style>
        </Style>
        
        <Style Selector="^ /template/ ContentPresenter#Description">
            <Setter Property="Foreground" Value="{atom:EmptyTokenResource ColorTextDescription}"/>
        </Style>

        <Style Selector="^ /template/ ContentPresenter#Footer">
            <Setter Property="Margin" Value="{atom:EmptyTokenResource FooterMargin}"/>
        </Style>
        
    </ControlTheme>
</ResourceDictionary>
