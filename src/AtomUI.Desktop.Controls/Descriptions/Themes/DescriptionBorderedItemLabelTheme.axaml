<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:DescriptionBorderedItemLabel}" TargetType="atom:DescriptionBorderedItemLabel">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}">
                    <ContentPresenter Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontFamily="{TemplateBinding FontFamily}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontStyle="{TemplateBinding FontStyle}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      LineHeight="{TemplateBinding LineHeight}"
                                      Padding="{TemplateBinding Padding}"
                                      TextWrapping="Wrap"
                                      VerticalContentAlignment="Center" />
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="RelativeLineHeight" Value="{atom:OwnerTokenResource Kind=RelativeLineHeight, SourceControlType={x:Type atom:Descriptions}}"/>
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource Kind=BorderThickness, SourceControlType={x:Type atom:Descriptions}}" />
        
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource Kind=ColorSplit, SourceControlType={x:Type atom:Descriptions}}" />
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource Kind=ColorTextSecondary, SourceControlType={x:Type atom:Descriptions}}"/>
        <Setter Property="Background" Value="{atom:DescriptionsTokenResource LabelBg}"/>
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource Kind=FontSize, SourceControlType={x:Type atom:Descriptions}}"/>
        
        <Style Selector="^[SizeType=Large]">
            <Setter Property="Padding" Value="{atom:DescriptionsTokenResource ItemPaddingLG}"/>
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Setter Property="Padding" Value="{atom:DescriptionsTokenResource ItemPadding}"/>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Padding" Value="{atom:DescriptionsTokenResource ItemPaddingSM}"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
