  <file id="AtomUIGallery.Localization.DatePickerShowCaseLangResourceKind">
    <unit id="BasicDescription">
      <segment>
        <source>Click DatePicker, and then we could select or input a date in panel.</source>
        <target state="translated">点击 DatePicker 后，可以在面板中选择或输入日期。</target>
      </segment>
    </unit>
    <unit id="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基础用法</target>
      </segment>
    </unit>
    <unit id="BindingDescription">
      <segment>
        <source>SelectedDateTime, RangeStartSelectedDate, and RangeEndSelectedDate synchronize with the ViewModel without explicitly setting Binding Mode=TwoWay.</source>
        <target state="translated">SelectedDateTime、RangeStartSelectedDate 与 RangeEndSelectedDate 默认与 ViewModel 双向同步，无需显式设置 Binding Mode=TwoWay。</target>
      </segment>
    </unit>
    <unit id="BindingTitle">
      <segment>
        <source>SelectedDateTime binding</source>
        <target state="translated">SelectedDateTime 绑定</target>
      </segment>
    </unit>
    <unit id="ChooseTimeDescription">
      <segment>
        <source>This property provides an additional time selection. When showTime is an Object, its properties will be passed on to the built-in TimePicker.</source>
        <target state="translated">该属性提供额外的时间选择。当 showTime 为对象时，其属性会传递给内置 TimePicker。</target>
      </segment>
    </unit>
    <unit id="ChooseTimeTitle">
      <segment>
        <source>Choose Time</source>
        <target state="translated">选择时间</target>
      </segment>
    </unit>
