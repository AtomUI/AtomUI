<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:converters="clr-namespace:AtomUI.Desktop.Controls.Converters"
    x:ClassModifier="internal">
    <converters:TextAreaFramePaddingConverter x:Key="TextAreaFramePaddingConverter"/>
    <ControlTheme x:Key="{x:Type atom:TextAreaDecoratedBox}" TargetType="atom:TextAreaDecoratedBox">
        <ControlTheme.BasedOn>
            <atom:AddOnDecoratedBoxTheme TargetType="atom:TextAreaDecoratedBox" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:AddOnDecoratedBoxContentFrame Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentFramePart}"
                                                    BorderThickness="{TemplateBinding InnerBoxBorderThickness}"
                                                    CornerRadius="{TemplateBinding InnerBoxCornerRadius}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Background="{TemplateBinding Background}"
                                                    BoxShadow="{TemplateBinding BoxShadow}"
                                                    BackgroundSizing="InnerBorderEdge">
                    <Border Name="TextAreaContentFrame"
                            Padding="{TemplateBinding TextAreaFramePadding, Converter={StaticResource TextAreaFramePaddingConverter}}">
                        <DockPanel Name="ContentLayout" LastChildFill="True">
                            <atom:AddOnContentPresenter
                                Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentLeftAddOnPart}"
                                Classes.semantic-scope-prefix="True"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"
                                Focusable="False"
                                Content="{TemplateBinding ContentLeftAddOn}"
                                ContentTemplate="{TemplateBinding ContentLeftAddOnTemplate}" />
                            <Panel>
                                <atom:ScrollViewer Name="PART_ScrollViewer"
                                                   IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                                   AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}"
                                                   HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                                   VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                                   IsScrollChainingEnabled="{TemplateBinding IsScrollChainingEnabled}"
                                                   Padding="{TemplateBinding ScrollerPadding}">
                                    <ContentPresenter
                                        Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentPresenterPart}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </atom:ScrollViewer>
                                <atom:AddOnContentPresenter
                                    Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentRightAddOnPart}"
                                    Classes.semantic-scope-suffix="True"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Focusable="False"
                                    Content="{TemplateBinding ContentRightAddOn}"
                                    ContentTemplate="{TemplateBinding ContentRightAddOnTemplate}" />
                            </Panel>
                        </DockPanel>
                    </Border>
                </atom:AddOnDecoratedBoxContentFrame>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:is(atom|TextAreaDecoratedBox)">
            <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
            <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="ResizeIndicatorLineBrush"
                    Value="{atom:TextAreaTokenResource ResizeIndicatorLineColor}" />
            <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentLeftAddOn">
                <Setter Property="Margin" Value="{atom:TextAreaTokenResource LeftInnerAddOnMargin}" />
            </Style>
            <Style Selector="^[SizeType=Large]">
                <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Setter Property="TextAreaFramePadding"
                        Value="{atom:SharedTokenResource InputPaddingLG}" />
                <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentRightAddOn">
                    <Setter Property="Padding" Value="{atom:TextAreaTokenResource RightAddOnPaddingLG}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Setter Property="TextAreaFramePadding"
                        Value="{atom:SharedTokenResource InputPadding}" />
                <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentRightAddOn">
                    <Setter Property="Padding" Value="{atom:TextAreaTokenResource RightAddOnPadding}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentRightAddOn">
                    <Setter Property="Padding" Value="{atom:TextAreaTokenResource RightAddOnPaddingSM}" />
                </Style>
                <Setter Property="TextAreaFramePadding"
                        Value="{atom:SharedTokenResource InputPaddingSM}" />
            </Style>

        </Style>
    </ControlTheme>
</ResourceDictionary>
