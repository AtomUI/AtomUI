                            FontWeight="Bold" />
            <atom:DataGrid x:Name="DragColumnDataGrid2"
                           CanUserReorderColumns="True"
                           x:DataType="vm:DragColumnDataType"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
