<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:WindowNotificationManager}"
                  TargetType="atom:WindowNotificationManager"
                  x:DataType="atom:WindowNotificationManager">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.ForegroundConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedForeground" />
                <atom:OwnerTokenResource Kind="ColorText" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="ColorText" />
            </MultiBinding>
        </Setter>

        <!--
            manager 的 Padding 投影为列表外边距，保持 presenter 的命中范围紧贴可见卡片。
            卡片之间的间距由 FeedbackStackPanel 管理，卡片自身保持零外边距。
        -->
        <Setter Property="ThemePadding" Value="{atom:NotificationCardTokenResource NotificationTopMargin}" />
        <Setter Property="Padding" Value="{CompiledBinding ThemePadding, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <ControlTemplate>
                <atom:FeedbackStackPresenter Name="PART_Items"
                                            Position="{TemplateBinding Position}"
                                            IsStackEnabled="{TemplateBinding IsStackEnabled}"
                                            StackThreshold="{TemplateBinding StackThreshold}"
                                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                            StackMode="Notification"
                                            Margin="{TemplateBinding Padding}"
                                            Classes.semantic-list-content="True" />
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />

        <Style Selector="^[Position=BottomLeft], ^[Position=BottomCenter], ^[Position=BottomRight]">
            <Setter Property="ThemePadding" Value="{atom:NotificationCardTokenResource NotificationBottomMargin}" />
        </Style>

        <Style Selector="^[Position=TopLeft] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=TopCenter] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=TopRight] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=BottomLeft] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[Position=BottomCenter] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[Position=BottomRight] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
