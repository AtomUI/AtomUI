<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.TextBoxTheme"
              x:ClassModifier="internal"
              TargetType="atom:TextBox">
    <!-- Focus is shown by the input frame (border + outline shadow), not a separate adorner. -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:TextBox">
            <atom:InputControlFrame
                Name="PART_InputControlFrame"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="{TemplateBinding Padding}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                StyleVariant="{TemplateBinding StyleVariant}"
                SizeType="{TemplateBinding SizeType}"
                Status="{TemplateBinding Status}"
                FormStatus="{TemplateBinding FormStatus}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                IsMotionEnabled="{Binding $parent[atom:TextBox].IsMotionEnabled}"
                CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                <atom:AdaptiveSpacingDockPanel Name="ContentLayout"
                                              LastChildFill="True"
                                              Classes.has-inner-left-content="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              Classes.has-inner-right-content="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentPresenter
                        Name="InnerLeftContentPresenter"
                        DockPanel.Dock="Left"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Focusable="False"
                        IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Content="{TemplateBinding InnerLeftContent}" />
                    <atom:InputAccessoryPanel
                        Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        Spacing="{atom:SharedTokenResource UniformlyPaddingXXS}">
                        <atom:InputAccessoryPanel.ClearButtonTemplate>
                            <DataTemplate>
                                <atom:InputClearIconButton
                                    Name="PART_ClearButton"
                                    IsVisible="{Binding $parent[atom:TextBox].IsEffectiveShowClearButton}"
                                    IsMotionEnabled="{Binding $parent[atom:TextBox].IsMotionEnabled}"
                                    Icon="{Binding $parent[atom:TextBox].ClearIcon}"
                                    VerticalAlignment="Center"/>
                            </DataTemplate>
                        </atom:InputAccessoryPanel.ClearButtonTemplate>
                        <atom:RevealButton
                            Name="PART_RevealButton"
                            IsChecked="{TemplateBinding RevealPassword, Mode=TwoWay}"
                            IsVisible="{TemplateBinding IsEnableRevealButton}" 
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                            VerticalAlignment="Center"/>
                        <ContentPresenter
                            Name="FormFeedBack"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Right"
                            IsVisible="{TemplateBinding IsFormFeedbackVisible}"
                            Content="{TemplateBinding FormFeedback}"/>
                        <ContentPresenter
                            Name="InnerRightContentPresenter"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="{TemplateBinding InnerRightContent}" />
                        <atom:InputAccessoryPanel.CountTemplate>
                            <DataTemplate>
                                <atom:TextBlock Name="TextCountIndicator"
                                                VerticalAlignment="Center"
                                                Text="{Binding $parent[atom:TextBox].CountText}"
                                                IsVisible="{Binding $parent[atom:TextBox].IsShowCount}"/>
                            </DataTemplate>
                        </atom:InputAccessoryPanel.CountTemplate>
                    </atom:InputAccessoryPanel>
            
                    <atom:ScrollViewer
                        Name="ScrollViewer"
                        Cursor="Ibeam"
                        IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                        AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                        IsScrollChainingEnabled="{TemplateBinding ScrollViewer.IsScrollChainingEnabled}">
                        <Panel>
                            <atom:TextBlock
                                Name="Placeholder"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Text="{TemplateBinding PlaceholderText}"
                                Foreground="{TemplateBinding PlaceholderForeground}"
                                LineHeight="{TemplateBinding LineHeight}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="{TemplateBinding TextWrapping}"
                                IsVisible="{TemplateBinding IsPlaceholderTextVisible}" />
                            <TextPresenter
                                Name="PART_TextPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                CaretBrush="{TemplateBinding CaretBrush}"
                                CaretIndex="{TemplateBinding CaretIndex}"
                                LineHeight="{TemplateBinding LineHeight}"
                                PasswordChar="{TemplateBinding PasswordChar}"
                                RevealPassword="{TemplateBinding RevealPassword}"
                                SelectionBrush="{TemplateBinding SelectionBrush}"
                                SelectionStart="{TemplateBinding SelectionStart}"
                                SelectionEnd="{TemplateBinding SelectionEnd}"
                                SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                Text="{TemplateBinding Text, Mode=TwoWay}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextWrapping="{TemplateBinding TextWrapping}" />
                        </Panel>
                    </atom:ScrollViewer>
                </atom:AdaptiveSpacingDockPanel>
            </atom:InputControlFrame>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|TextBox)">
        <Style Selector="^ /template/ atom|AdaptiveSpacingDockPanel#ContentLayout.has-inner-left-content, ^ /template/ atom|AdaptiveSpacingDockPanel#ContentLayout.has-inner-right-content">
            <Setter Property="HorizontalSpacing" Value="{atom:SharedTokenResource SpacingXXS}" />
        </Style>

        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        <Setter Property="SelectionBrush" Value="{atom:SharedTokenResource SelectionBackground}" />
        <Setter Property="CaretBrush" Value="{atom:SharedTokenResource ColorText}" />
        <Setter Property="SelectionForegroundBrush"
                Value="{atom:SharedTokenResource SelectionForeground}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="ClipToBounds" Value="False" />
    
        <Style Selector="^[SizeType=Large]">
            <Setter Property="LineHeight" Value="{atom:SharedTokenResource FontHeightLG}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
            <Setter Property="Padding" Value="{atom:TextBoxTokenResource ContentPaddingLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Setter Property="LineHeight" Value="{atom:SharedTokenResource FontHeight}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
            <Setter Property="Padding" Value="{atom:TextBoxTokenResource ContentPadding}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="LineHeight" Value="{atom:SharedTokenResource FontHeightSM}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
            <Setter Property="Padding" Value="{atom:TextBoxTokenResource ContentPaddingSM}" />
        </Style>
        <Style Selector="^[SizeType=Custom]">
            <Setter Property="LineHeight" Value="{atom:SharedTokenResource FontHeight}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
        </Style>
    
        <Style Selector="^[IsCustomFontSize=False]">
            <Style Selector="^[SizeType=Large]">
                <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeLG}" />
                <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
                <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
                <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
            </Style>
        </Style>
    
        <Setter Property="PlaceholderForeground" Value="{atom:SharedTokenResource ColorTextPlaceholder}" />

        <Style Selector="^ /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="Margin"
                    Value="2 0 2 0" />
        </Style>
    
        <Style Selector="^ /template/ atom|TextBlock#TextCountIndicator">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextPlaceholder}" />
        </Style>

        <!-- TextBox keeps its control-local token scope while the shared frame
             remains the single owner of input surface state. -->
        <Style Selector="^ /template/ atom|InputControlFrame#PART_InputControlFrame[EffectiveStatus=Default][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:TextBoxTokenResource ColorPrimaryHover}" />
        </Style>
        <Style Selector="^ /template/ atom|InputControlFrame#PART_InputControlFrame[EffectiveStatus=Default]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:TextBoxTokenResource ColorPrimary}" />
        </Style>
        <!-- Ant Design: only the outlined variant draws the focus outline shadow; embedded
             (borderless) text boxes inside a host input must never show one. -->
        <Style Selector="^[StyleVariant=Outlined] /template/ atom|InputControlFrame#PART_InputControlFrame[EffectiveStatus=Default]:focus-within">
            <Setter Property="BoxShadow"
                    Value="{atom:TextBoxTokenResource InputActiveShadow}" />
        </Style>

    </Style>
</ControlTheme>
