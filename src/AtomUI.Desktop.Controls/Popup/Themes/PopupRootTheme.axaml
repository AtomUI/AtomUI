<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:Class="AtomUI.Desktop.Controls.Themes.PopupRootTheme"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type PopupRoot}" TargetType="PopupRoot">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The standard presenter exposes only the transparent motion
                     margin as positioning Deflate, preserving content geometry. -->
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{x:Null}"
                                  BorderBrush="{x:Null}"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch">
                    <atom:PopupSurface Name="PART_PopupSurface" ClipToBounds="False"
                                       Margin="{CompiledBinding $parent[atom:Popup].MotionMargin}">
                        <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                        <VisualLayerManager ClipToBounds="False">
                            <atom:ShadowsAwareContainer>
                                <!-- The static motion surface is Content of the
                                     host presenter, outside its template chain. -->
                                <ContentPresenter Content="{CompiledBinding $parent[PopupRoot].Content}"
                                                  ContentTemplate="{CompiledBinding $parent[PopupRoot].ContentTemplate}" />
                            </atom:ShadowsAwareContainer>
                        </VisualLayerManager>
                    </atom:PopupSurface>
                </ContentPresenter>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
        <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        <Setter Property="FontFamily" Value="{atom:SharedTokenResource FontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />

    </ControlTheme>
</ResourceDictionary>
