<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SelectTag}" TargetType="atom:SelectTag">
        <ControlTheme.BasedOn>
            <themes:TagTheme TargetType="atom:SelectTag" />
        </ControlTheme.BasedOn>

        <Style Selector="^:is(atom|SelectTag)">
            <Setter Property="Background" Value="{CompiledBinding $self.(atom:SelectTag.TagBackground)}" />
            <!-- The chip text is the field text on the selector's item background, not the standalone tag's default
                 colour (which a theme may pair with a solid tag fill). -->
            <Setter Property="CalculatedForeground" Value="{atom:OwnerTokenResource ColorText}" />
            <Setter Property="IsClosable" Value="True" />
            <Setter Property="FontSize" Value="{CompiledBinding $self.(atom:SelectTag.OptionFontSize)}" />

            <Style Selector="^:disabled">
                <Setter Property="Background"
                        Value="{CompiledBinding $self.(atom:SelectTag.DisabledSelectorBackground)}" />
                <Setter Property="Foreground"
                        Value="{CompiledBinding $self.(atom:SelectTag.DisabledTagForeground)}" />
                <Setter Property="IsClosable" Value="False" />
            </Style>

            <Style Selector="^[SizeType=Large]">
                <Setter Property="Height" Value="{CompiledBinding $self.(atom:SelectTag.TagHeight)}" />
            </Style>

            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="Height" Value="{CompiledBinding $self.(atom:SelectTag.TagHeight)}" />
            </Style>

            <Style Selector="^[SizeType=Custom][HasCustomTagHeight=True]">
                <Setter Property="Height"
                        Value="{Binding CustomTagHeight, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Height" Value="{CompiledBinding $self.(atom:SelectTag.TagHeight)}" />
            </Style>

        </Style>

    </ControlTheme>
</ResourceDictionary>
