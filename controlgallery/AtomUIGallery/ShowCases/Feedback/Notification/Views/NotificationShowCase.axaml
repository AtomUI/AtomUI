<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Notification.NotificationShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:viewModels="clr-namespace:AtomUIGallery.ShowCases.Notification"
             x:DataType="viewModels:NotificationViewModel">
    <UserControl.Resources>
        <!-- 默认样式示例：浅绿卡片 + 2px 绿边 + 圆角 16 + 硬阴影，icon / title / description 绿字；
             error 分支整卡转红。 -->
        <Styles x:Key="NotificationSemanticStyleStyles">
            <Style Selector="atom|NotificationCard.semantic-default-style-demo">
                <Setter Property="Background" Value="#F6FFED" />
                <Setter Property="BorderBrush" Value="#95DE64" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BoxShadow" Value="4 4 0 #D9F7BE" />
                <atom:NotificationCardIconStyle x:SetterTargetType="atom:IconPresenter">
                    <Setter Property="IconBrush" Value="#237804" />
                </atom:NotificationCardIconStyle>
                <atom:NotificationCardTitleStyle x:SetterTargetType="atom:SelectableTextBlock">
                    <Setter Property="Foreground" Value="#237804" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </atom:NotificationCardTitleStyle>
                <atom:NotificationCardDescriptionStyle x:SetterTargetType="ContentPresenter">
                    <Setter Property="Foreground" Value="#3F6600" />
                </atom:NotificationCardDescriptionStyle>
            </Style>
            <!-- error 分支只覆盖背景色 / 边框色 / 阴影色，边框粗细与圆角沿用默认样式的那两个 Setter，
                 所以这里必须重复声明 BorderThickness 与 CornerRadius；否则会回落到主题默认值
                 （零边框 / 半径 8），卡片边框更细、圆角更小。 -->
            <Style Selector="atom|NotificationCard.semantic-error-style-demo:error">
                <Setter Property="Background" Value="#FFF2F0" />
                <Setter Property="BorderBrush" Value="#FFCCC7" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BoxShadow" Value="4 4 0 #FFCCC7" />
                <atom:NotificationCardIconStyle x:SetterTargetType="atom:IconPresenter">
                    <Setter Property="IconBrush" Value="#CF1322" />
                </atom:NotificationCardIconStyle>
                <atom:NotificationCardTitleStyle x:SetterTargetType="atom:SelectableTextBlock">
                    <Setter Property="Foreground" Value="#CF1322" />
                </atom:NotificationCardTitleStyle>
                <atom:NotificationCardDescriptionStyle x:SetterTargetType="ContentPresenter">
                    <Setter Property="Foreground" Value="#5C0011" />
                </atom:NotificationCardDescriptionStyle>
            </Style>
        </Styles>
    </UserControl.Resources>
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Notification"
                    Category="{gallery:NotificationShowCaseLangResource ComponentCategory}"
                    Status="{gallery:NotificationShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:NotificationShowCaseLangResource PageSubtitle}"
                    Description="{gallery:NotificationShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="WindowNotificationManager" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="viewModels:NotificationViewModel">
                    <!-- 单个预览舞台同时承载「通知列表宿主」与「通知卡片」两个公开 owner 的 Part，
                         右侧按 owner 顺序列出全部 11 个 Part。
                         NotificationCard 没有声明式构造入口（只能由 manager 创建），因此卡片实例由
                         code-behind 在舞台内播种并挂到下方 Owner 锚点上；manager 用无宿主实例铺满舞台。 -->
                    <gallery:SemanticPartPreview Name="NotificationSemanticPreview"
                                                 Title="Notification"
                                                 SemanticOwner="{Binding #NotificationSemanticAnchor}">
                        <gallery:SemanticPartPreview.SemanticOwners>
                            <gallery:SemanticPartPreviewOwner Owner="{Binding #NotificationCardSemanticOwner}"
                                                             OwnerType="{x:Type atom:NotificationCard}" />
                            <gallery:SemanticPartPreviewOwner Owner="{Binding #NotificationManagerSemanticOwner}"
                                                             OwnerType="{x:Type atom:WindowNotificationManager}" />
                        </gallery:SemanticPartPreview.SemanticOwners>
                        <gallery:SemanticPartPreview.PreviewContent>
                            <Panel MinHeight="320"
                                   Background="{atom:SharedTokenResource ColorFillAlter}">
                                <!-- manager 无宿主实例拉伸铺满舞台；root 高亮 = 列表宿主本身。 -->
                                <atom:WindowNotificationManager Name="NotificationManagerSemanticOwner"
                                                               MaxItems="3"
                                                               IsMotionEnabled="False" />
                                <!-- 卡片锚点：NotificationCard 有公开无参构造，可声明式实例化两张常驻卡片。 -->
                                <StackPanel Name="NotificationSemanticAnchor"
                                            Orientation="Vertical"
                                            Spacing="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <atom:NotificationCard Name="NotificationCardSemanticOwner"
                                                           NotificationType="Success"
                                                           Title="Notification Title"
                                                           Content="This is a notification description."
                                                           IsMotionEnabled="False"
                                                           Expiration="0:0:4.5"
                                                           IsShowProgress="True">
                                        <atom:NotificationCard.Actions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <atom:Button ButtonType="Primary" SizeType="Small" Content="Confirm" />
                                            </StackPanel>
                                        </atom:NotificationCard.Actions>
                                    </atom:NotificationCard>
                                </StackPanel>
                            </Panel>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription Path="root"
                                                             OwnerType="{x:Type atom:NotificationCard}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription Path="wrapper"
                                                             OwnerType="{x:Type atom:NotificationCard}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticWrapperDescription}" />
                            <gallery:SemanticPartDescription Path="icon"
                                                             OwnerType="{x:Type atom:NotificationCard}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticIconDescription}" />
                            <gallery:SemanticPartDescription Path="section"
                                                             OwnerType="{x:Type atom:NotificationCard}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticSectionDescription}" />
                            <gallery:SemanticPartDescription Path="title"
                                                             OwnerType="{x:Type atom:NotificationCard}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticTitleDescription}" />
                            <gallery:SemanticPartDescription Path="description"
                                                             OwnerType="{x:Type atom:NotificationCard}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticDescriptionDescription}" />
                            <gallery:SemanticPartDescription Path="close"
                                                             OwnerType="{x:Type atom:NotificationCard}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticCloseDescription}" />
                            <gallery:SemanticPartDescription Path="actions"
                                                             OwnerType="{x:Type atom:NotificationCard}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticActionsDescription}" />
                            <gallery:SemanticPartDescription Path="progress"
                                                             OwnerType="{x:Type atom:NotificationCard}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticProgressDescription}" />
                            <gallery:SemanticPartDescription Path="root"
                                                             OwnerType="{x:Type atom:WindowNotificationManager}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticListRootDescription}" />
                            <gallery:SemanticPartDescription Path="listContent"
                                                             OwnerType="{x:Type atom:WindowNotificationManager}"
                                                             Description="{gallery:NotificationShowCaseLangResource SemanticListContentDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem Title="{gallery:NotificationShowCaseLangResource BasicTitle}" Description="{gallery:NotificationShowCaseLangResource BasicDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationViewModel">
                            <atom:Button ButtonType="Primary" Click="ShowSimpleNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentShowNotification}" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:NotificationShowCaseLangResource DurationTitle}"
                                  Description="{gallery:NotificationShowCaseLangResource DurationDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationViewModel">
                            <atom:Button ButtonType="Primary" Click="ShowNeverCloseNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentOpenTheNotificationBox}" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:NotificationShowCaseLangResource WithIconTitle}"
                                  Description="{gallery:NotificationShowCaseLangResource WithIconDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <atom:Button ButtonType="Default" Click="ShowSuccessNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentSuccess}" />
                                <atom:Button ButtonType="Default" Click="ShowInfoNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentInfo}" />
                                <atom:Button ButtonType="Default" Click="ShowWarningNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentWarning}" />
                                <atom:Button ButtonType="Default" Click="ShowErrorNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentError}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:NotificationShowCaseLangResource PlacementTitle}"
                                  Description="{gallery:NotificationShowCaseLangResource PlacementDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button ButtonType="Primary" Click="ShowTopNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentTop}" />
                                    <atom:Button ButtonType="Primary" Click="ShowBottomNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentBottom}" />
                                </StackPanel>
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button ButtonType="Primary" Click="ShowTopLeftNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentTopleft}" />
                                    <atom:Button ButtonType="Primary" Click="ShowTopRightNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentTopright}" />
                                </StackPanel>
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button ButtonType="Primary" Click="ShowBottomLeftNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentBottomleft}" />
                                    <atom:Button ButtonType="Primary" Click="ShowBottomRightNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentBottomright}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:NotificationShowCaseLangResource StackTitle}"
                    Description="{gallery:NotificationShowCaseLangResource StackDescription}"
                    BadgeText="v6.1.9"
                    SourceKey="notification-stack"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationViewModel">
                            <StackPanel Spacing="24">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="32">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="12">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{gallery:NotificationShowCaseLangResource StackEnabledLabel}" />
                                        <atom:ToggleSwitch Name="NotificationStackEnabledSwitch"
                                                           VerticalAlignment="Center"
                                                           IsChecked="True"
                                                           IsCheckedChanged="HandleStackEnabledChanged" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="12">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{gallery:NotificationShowCaseLangResource StackThresholdLabel}" />
                                        <atom:NumericUpDown Name="NotificationStackThresholdInput"
                                                            Width="100"
                                                            VerticalAlignment="Center"
                                                            Minimum="1"
                                                            Maximum="10"
                                                            Increment="1"
                                                            FormatString="0"
                                                            Value="3"
                                                            IsEnabled="{Binding #NotificationStackEnabledSwitch.IsChecked}"
                                                            ValueChanged="HandleStackThresholdChanged" />
                                    </StackPanel>
                                </StackPanel>
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button Name="OpenStackNotificationButton"
                                                 ButtonType="Primary"
                                                 Click="ShowStackNotification"
                                                 Content="{gallery:NotificationShowCaseLangResource P2ContentOpenTheNotificationBox}" />
                                    <atom:Button Name="DestroyStackNotificationsButton"
                                                 ButtonType="Default"
                                                 Click="DestroyStackNotifications"
                                                 Content="{gallery:NotificationShowCaseLangResource P2ContentDestroyAll}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:NotificationShowCaseLangResource CustomizedIconTitle}"
                                  Description="{gallery:NotificationShowCaseLangResource CustomizedIconDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationViewModel">
                            <atom:Button ButtonType="Primary" Click="ShowCustomIconNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentOpenTheNotificationBox}" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:NotificationShowCaseLangResource ProgressTitle}"
                                  Description="{gallery:NotificationShowCaseLangResource ProgressDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <atom:OptionButtonGroup Name="HoverOptionGroup" ButtonStyle="Outline">
                                    <atom:OptionButton IsChecked="True" Content="{gallery:NotificationShowCaseLangResource P2ContentPauseOnHover}" />
                                    <atom:OptionButton Content="{gallery:NotificationShowCaseLangResource P2ContentDonTPauseOnHover}" />
                                </atom:OptionButtonGroup>
                                <atom:Button ButtonType="Primary" Click="ShowProgressNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentShowNotification}" />
                            </StackPanel>

                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:NotificationShowCaseLangResource ActionsTitle}"
                                  Description="{gallery:NotificationShowCaseLangResource ActionsDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationViewModel">
                            <atom:Button ButtonType="Primary" Click="ShowActionsNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentOpenTheNotificationBox}" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:NotificationShowCaseLangResource SemanticPartStyleTitle}"
                                  Description="{gallery:NotificationShowCaseLangResource SemanticPartStyleDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <atom:Button ButtonType="Primary" Click="HandleShowDefaultStyleNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentDefaultNotification}" />
                                <atom:Button ButtonType="Default" Click="HandleShowErrorStyleNotification" Content="{gallery:NotificationShowCaseLangResource P2ContentErrorNotification}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
