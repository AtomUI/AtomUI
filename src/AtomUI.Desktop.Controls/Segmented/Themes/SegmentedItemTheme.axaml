<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SegmentedItem}" TargetType="atom:SegmentedItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <DockPanel LastChildFill="True">
                        <atom:IconPresenter Name="IconPresenter"
                                            Classes.semantic-icon="True"
                                            Icon="{TemplateBinding Icon}"
                                            IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter Name="Content"
                                          Classes.semantic-label="True"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          TextTrimming="CharacterEllipsis"
                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
            <Setter Property="IconBrush"
                    Value="{atom:SegmentedTokenResource ItemColor}" />
        </Style>

        <Style Selector="^:selected">
            <!-- 选中背景始终由轨道层滑块承载（含滑块飞行途中），item 自身不绘制选中背景，避免目标项提前点亮 -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{atom:SegmentedTokenResource ItemSelectedColor}" />

            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:SegmentedTokenResource ItemSelectedColor}" />
            </Style>
        </Style>

        <Style Selector="^:not(^:selected)">
            <Setter Property="Foreground" Value="{atom:SegmentedTokenResource ItemColor}" />
            <Setter Property="Background" Value="Transparent" />

            <Style Selector="^:pointerover">
                <Setter Property="Foreground"
                        Value="{atom:SegmentedTokenResource ItemHoverColor}" />
                <Setter Property="Background"
                        Value="{atom:SegmentedTokenResource ItemHoverBg}" />
                <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                    <Setter Property="IconBrush"
                            Value="{atom:SegmentedTokenResource ItemHoverColor}" />
                </Style>
            </Style>

            <Style Selector="^:pressed">
                <Setter Property="Background"
                        Value="{atom:SegmentedTokenResource ItemActiveBg}" />
                <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                    <Setter Property="IconBrush"
                            Value="{atom:SegmentedTokenResource ItemSelectedColor}" />
                </Style>
            </Style>
        </Style>

        <!-- 滑块飞行期间屏蔽非选中项的 hover/pressed 遮罩，对齐 antd thumb ~ item::after transparent 规则 -->
        <Style Selector="^[IsThumbMotionActive=True]:not(^:selected)">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <!-- 文字颜色即时跟随选中值并柔化切换（antd item color transition） -->
                    <atom:SolidColorBrushTransition Property="Foreground"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Transitions">
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="IconBrush"
                                                        Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius"
                    Value="{atom:SharedTokenResource BorderRadius}" />
            <Setter Property="FontSize"
                    Value="{atom:SharedTokenResource FontSizeLG}" />
            <Setter Property="MinHeight"
                    Value="{atom:SegmentedTokenResource ItemMinHeightLG}" />
            <Setter Property="Padding"
                    Value="{atom:SegmentedTokenResource SegmentedItemPadding}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius"
                    Value="{atom:SharedTokenResource BorderRadiusSM}" />
            <Setter Property="FontSize"
                    Value="{atom:SharedTokenResource FontSize}" />
            <Setter Property="MinHeight"
                    Value="{atom:SegmentedTokenResource ItemMinHeight}" />
            <Setter Property="Padding"
                    Value="{atom:SegmentedTokenResource SegmentedItemPadding}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius"
                    Value="{atom:SharedTokenResource BorderRadiusXS}" />
            <Setter Property="FontSize"
                    Value="{atom:SharedTokenResource FontSize}" />
            <Setter Property="MinHeight"
                    Value="{atom:SegmentedTokenResource ItemMinHeightSM}" />
            <Setter Property="Padding"
                    Value="{atom:SegmentedTokenResource SegmentedItemPaddingSM}" />
        </Style>

        <Style Selector="^[Shape=Round]">
            <Setter Property="CornerRadius" Value="9999" />
        </Style>

        <Style Selector="^:has-icon">
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Margin"
                        Value="{atom:SegmentedTokenResource SegmentedItemContentMargin}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width"
                        Value="{atom:SharedTokenResource IconSizeLG}" />
                <Setter Property="Height"
                        Value="{atom:SharedTokenResource IconSizeLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width"
                        Value="{atom:SharedTokenResource IconSize}" />
                <Setter Property="Height"
                        Value="{atom:SharedTokenResource IconSize}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width"
                        Value="{atom:SharedTokenResource IconSizeSM}" />
                <Setter Property="Height"
                        Value="{atom:SharedTokenResource IconSizeSM}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:SharedTokenResource ColorTextDisabled}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:SharedTokenResource ColorTextDisabled}" />
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
