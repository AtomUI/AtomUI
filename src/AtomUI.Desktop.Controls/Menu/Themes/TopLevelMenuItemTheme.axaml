<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="TopLevelMenuItemTheme" TargetType="atom:MenuItem">
        <Setter Property="OpenMotion" Value="{atom:MotionResource HorizontalMenuOpen}" />
        <Setter Property="CloseMotion" Value="{atom:MotionResource HorizontalMenuClose}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Frame"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Each menu bar item is laid out by its own content, without aligning an icon column
                                across items: it takes no part in SharedSizeGroup, otherwise items without an icon
                                would be forced to reserve the icon column width and leave a ghost gap.
                                -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <atom:IconPresenter Name="ItemIconPresenter"
                                                Classes.semantic-item-icon="True"
                                                Classes.semantic-sub-menu-item-icon="True"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="{TemplateBinding IconMarginInlineEnd, Converter={x:Static atom:MenuItemTheme.InlineEndMarginConverter}}"
                                                Icon="{TemplateBinding Icon}"
                                                IconBrush="{TemplateBinding Foreground}"
                                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Grid.Column="0" />
                            <ContentPresenter Name="HeaderPresenter"
                                              Classes.semantic-item-content="True"
                                              Classes.semantic-sub-menu-item-content="True"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Grid.Column="1" />
                        </Grid>
                    </Border>
                    <atom:Popup Name="PART_Popup"
                                OpenMotion="{TemplateBinding OpenMotion}"
                                CloseMotion="{TemplateBinding CloseMotion}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                WindowManagerAddShadowHint="False"
                                IsLightDismissEnabled="False"
                                RequestedPlacement="BottomEdgeAlignedLeft"
                                ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}">
                        <Border Name="PopupFrame"
                                Classes.semantic-popup-root="True"
                                MaxHeight="{TemplateBinding MaxPopupHeight}"
                                Padding="{TemplateBinding PopupPadding}">
                            <atom:MenuPopupScrollHost
                                IsScrollEnabled="{TemplateBinding IsScrollEnabled}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                atom:ScrollViewer.IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}">
                                <ItemsPresenter
                                    Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    Grid.IsSharedSizeScope="True"
                                    KeyboardNavigation.TabNavigation="Continue" />
                            </atom:MenuPopupScrollHost>
                        </Border>
                    </atom:Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:toplevel">
            <Style Selector="^ /template/ Border#Frame">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Setter Property="Foreground" Value="{atom:MenuTokenResource TopLevelItemColor}" />
            <Setter Property="Background" Value="{atom:MenuTokenResource TopLevelItemBg}" />
            <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
            <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />

            <Setter Property="PopupPadding"
                    Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupContentPadding)}" />
            <Setter Property="ItemHeight" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ItemHeight)}" />

            <Style Selector="^:pointerover">
                <Setter Property="Background"
                        Value="{atom:MenuTokenResource TopLevelItemHoverBg}" />
                <Setter Property="Foreground"
                        Value="{atom:MenuTokenResource TopLevelItemHoverColor}" />
            </Style>

            <!-- An open top-level item is the menu bar's selected item. -->
            <Style Selector="^[IsSubMenuOpen=True]">
                <Setter Property="Background"
                        Value="{atom:MenuTokenResource TopLevelItemSelectedBg}" />
                <Setter Property="Foreground"
                        Value="{atom:MenuTokenResource TopLevelItemSelectedColor}" />
            </Style>

            <Style Selector="^[SizeType=Large]">
                <Setter Property="CornerRadius"
                        Value="{atom:MenuTokenResource TopLevelItemBorderRadiusLG}" />
                <Setter Property="MinHeight" Value="{atom:MenuItemTokenResource ControlHeightLG}" />
                <Setter Property="Padding" Value="{atom:MenuTokenResource TopLevelItemPaddingLG}" />
                <Setter Property="FontSize"
                        Value="{atom:MenuTokenResource TopLevelItemFontSizeLG}" />
                <Style Selector="^ /template/ ContentPresenter#HeaderPresenter">
                    <Setter Property="LineHeight"
                            Value="{atom:MenuTokenResource TopLevelItemLineHeightLG}" />
                </Style>
            </Style>

            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="CornerRadius"
                        Value="{atom:MenuTokenResource TopLevelItemBorderRadius}" />
                <Setter Property="MinHeight" Value="{atom:MenuItemTokenResource ControlHeight}" />
                <Setter Property="Padding" Value="{atom:MenuTokenResource TopLevelItemPadding}" />
                <Setter Property="FontSize" Value="{atom:MenuTokenResource TopLevelItemFontSize}" />
                <Style Selector="^ /template/ ContentPresenter#HeaderPresenter">
                    <Setter Property="LineHeight"
                            Value="{atom:MenuTokenResource TopLevelItemLineHeight}" />
                </Style>
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="CornerRadius"
                        Value="{atom:MenuTokenResource TopLevelItemBorderRadiusSM}" />
                <Setter Property="MinHeight" Value="{atom:MenuItemTokenResource ControlHeightSM}" />
                <Setter Property="Padding" Value="{atom:MenuTokenResource TopLevelItemPaddingSM}" />
                <Setter Property="FontSize"
                        Value="{atom:MenuTokenResource TopLevelItemFontSizeSM}" />
                <Style Selector="^ /template/ ContentPresenter#HeaderPresenter">
                    <Setter Property="LineHeight"
                            Value="{atom:MenuTokenResource TopLevelItemLineHeightSM}" />
                </Style>
            </Style>

            <Style Selector="^ /template/ Border#PopupFrame">
                <Setter Property="Background"
                        Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupBackground)}" />
                <Setter Property="CornerRadius"
                        Value="{atom:PopupTokenResource PopupCornerRadius}" />
                <Setter Property="MinWidth"
                        Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupMinWidth)}" />
                <Setter Property="MaxWidth"
                        Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupMaxWidth)}" />
            </Style>

            <Style Selector="^ /template/ atom|Popup#PART_Popup">
                <Setter Property="MarginToAnchor"
                        Value="{atom:MenuTokenResource TopLevelItemPopupMarginToAnchor}" />
                <Setter Property="PopupRootShadow"
                        Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupShadows)}" />
                <Setter Property="OverlayHostShadow"
                        Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupShadows)}" />
            </Style>

            <Style Selector="^[ShouldUseOverlayPopup=False] /template/ atom|Popup#PART_Popup">
                <Setter Property="MarginToAnchor" Value="1" />
            </Style>

            <Style Selector="^:disabled">
                <Setter Property="Foreground"
                        Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ItemDisabledForeground)}" />
            </Style>

            <Style Selector="^[IsMotionEnabled=True]">
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="StateTransitionDurationSlow" Easing="0.25,0.1,0.25,1" atom:TokenTransitions.Easing="StateTransitionEasingOverride" />
                            <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="StateTransitionDurationSlow" Easing="0.25,0.1,0.25,1" atom:TokenTransitions.Easing="StateTransitionEasingOverride" />
                            <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="StateTransitionDuration" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>
        </Style>

        <!-- The icon of a first-level menu bar item must be sized explicitly, like the icons of the menu items inside
        popups: IconPresenter does not measure the icon itself, and without a size the icon renders as 0x0 while
        the gap between icon and text still takes space, pushing the menu bar text to the right for nothing. When
        the icon is empty it collapses through IsVisible and the gap disappears with the node.
        -->
        <Setter Property="IconMarginInlineEnd" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ItemIconEndMargin)}" />
        <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
            <Setter Property="Width" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ItemIconSize)}" />
            <Setter Property="Height" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ItemIconSize)}" />
        </Style>


</ControlTheme>
</ResourceDictionary>
