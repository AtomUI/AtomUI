<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Dialog}" TargetType="atom:Dialog">
        <Setter Property="OpenMotion" Value="{atom:MotionResource DialogOpen}" />
        <Setter Property="CloseMotion" Value="{atom:MotionResource DialogClose}" />
        <Setter Property="atom:DialogSurface.HeaderBackground" Value="{atom:DialogTokenResource HeaderBg}" />
        <Setter Property="atom:DialogSurface.HeaderBottomMargin" Value="{atom:DialogTokenResource HeaderMarginBottom}" />
        <Setter Property="atom:DialogSurface.LogoSize" Value="{atom:DialogTokenResource LogoSize}" />
        <Setter Property="atom:DialogSurface.HeaderFontSize" Value="{atom:DialogTokenResource HeaderFontSize}" />
        <Setter Property="atom:DialogSurface.HeaderForeground" Value="{atom:DialogTokenResource HeaderColor}" />
        <Setter Property="atom:DialogSurface.ContentBackground" Value="{atom:DialogTokenResource ContentBg}" />
        <Setter Property="atom:DialogSurface.HeaderPadding" Value="{atom:DialogTokenResource HeaderPadding}" />
        <Setter Property="atom:DialogSurface.ContentPadding" Value="{atom:DialogTokenResource ContentPadding}" />
        <Setter Property="atom:DialogSurface.WindowContentPadding" Value="{atom:DialogTokenResource WindowContentPadding}" />
        <Setter Property="atom:DialogSurface.FooterBackground" Value="{atom:DialogTokenResource FooterBg}" />
        <Setter Property="atom:DialogSurface.FooterPadding" Value="{atom:DialogTokenResource FooterPadding}" />
        <Setter Property="atom:DialogSurface.FooterTopMargin" Value="{atom:DialogTokenResource FooterMarginTop}" />
        <Setter Property="atom:DialogSurface.CloseButtonSize" Value="{atom:DialogTokenResource CloseBtnSize}" />
        <Setter Property="atom:DialogSurface.DefaultViewportMinHeight" Value="{atom:DialogTokenResource MinHeight}" />
        <Setter Property="atom:DialogSurface.DefaultViewportMinWidth" Value="{atom:DialogTokenResource MinWidth}" />
        <Setter Property="atom:DialogSurface.ButtonGroupSpacing" Value="{atom:DialogTokenResource ButtonGroupSpacing}" />
        <Setter Property="atom:DialogSurface.LoadingIndicatorMargin" Value="{atom:DialogTokenResource LoadingIndicatorMargin}" />

        <Setter Property="IsMotionEnabled" Value="{atom:DialogTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Width" Value="0"/>
        <Setter Property="Height" Value="0"/>
        
        <Style Selector="^[IsModal=True]">
            <Setter Property="IsMinimizable" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>