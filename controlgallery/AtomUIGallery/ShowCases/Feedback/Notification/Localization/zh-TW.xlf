    <unit id="ActionsDescription">
      <segment>
        <source>Add action buttons to the bottom-right of the notification through the Actions API.</source>
        <target state="translated">透過 Actions API 在通知右下角加入操作按鈕。</target>
      </segment>
    </unit>
    <unit id="ActionsTitle">
      <segment>
        <source>Notification with actions</source>
        <target state="translated">帶操作的通知</target>
      </segment>
    </unit>
    <unit id="ApiMethodManagerShow">
