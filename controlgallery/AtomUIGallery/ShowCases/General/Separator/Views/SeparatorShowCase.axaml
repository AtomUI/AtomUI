<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Separator.SeparatorShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:atomc="https://atomui.net/common-controls"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Separator"
             x:DataType="vm:SeparatorViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Separator"
                    Category="{gallery:SeparatorShowCaseLangResource ComponentCategory}"
                    Status="{gallery:SeparatorShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:SeparatorShowCaseLangResource PageSubtitle}"
                    Description="{gallery:SeparatorShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="AbstractSeparator" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:SeparatorViewModel">
                    <gallery:SemanticPartPreview Name="SeparatorSemanticPreview"
                                                 SemanticOwner="{Binding #SeparatorSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:Separator}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Spacing="16">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
                                <atom:Separator />
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
                                <atom:Separator Name="SeparatorSemanticOwner"
                                                Title="{gallery:SeparatorShowCaseLangResource P2TitleSolid}" />
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
                                <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleDotted}"
                                                TitlePosition="Left"
                                                Variant="Dotted" />
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
                                <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleDashed}"
                                                TitlePosition="Right"
                                                Variant="Dashed" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <atom:TextBlock Text="These" />
                                    <atom:VerticalSeparator />
                                    <atom:TextBlock Text="are" />
                                    <atom:VerticalSeparator />
                                    <atom:TextBlock Text="vertical" />
                                    <atom:VerticalSeparator />
                                    <atom:TextBlock Text="Dividers" />
                                </StackPanel>
                            </StackPanel>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:SeparatorShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="rail"
                                Description="{gallery:SeparatorShowCaseLangResource SemanticRailDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:SeparatorShowCaseLangResource SemanticContentDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:SeparatorShowCaseLangResource HorizontalTitle}"
        Description="{gallery:SeparatorShowCaseLangResource HorizontalDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SeparatorViewModel">
        <StackPanel Orientation="Vertical">
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:SeparatorShowCaseLangResource DividerWithTitleTitle}"
        Description="{gallery:SeparatorShowCaseLangResource DividerWithTitleDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SeparatorViewModel">
        <StackPanel Orientation="Vertical">
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleText}" FontStyle="Italic" IsVisible="False"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleLeftText}" TitlePosition="Left" FontWeight="Bold" />
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleRightText}" TitlePosition="Right" FontStyle="Oblique" />
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleLeftTextWithN0Orientationmargin}" TitlePosition="Left" FontStyle="Oblique"
                            FontWeight="Medium" OrientationMargin="0" />
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />

            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleRightTextWithN50pxOrientationmargin}" TitlePosition="Right" TitleColor="Coral"
                            FontWeight="Medium"
                            OrientationMargin="50" />
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:SeparatorShowCaseLangResource PlainTextTitle}"
        Description="{gallery:SeparatorShowCaseLangResource PlainTextDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SeparatorViewModel">
        <StackPanel Orientation="Vertical">
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleText}" IsPlain="True"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleLeftText2}" TitlePosition="Left" IsPlain="True"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleRightText2}" TitlePosition="Right" IsPlain="True"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:SeparatorShowCaseLangResource SpacingSizeTitle}"
        Description="{gallery:SeparatorShowCaseLangResource SpacingSizeDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SeparatorViewModel">
        <StackPanel Orientation="Vertical">
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator SizeType="Small"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator SizeType="Middle"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator SizeType="Large"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:SeparatorShowCaseLangResource VerticalTitle}"
        Description="{gallery:SeparatorShowCaseLangResource VerticalDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SeparatorViewModel">
        <StackPanel Orientation="Horizontal">
            <atom:TextBlock Text="{gallery:SeparatorShowCaseLangResource P2TextItem1}" />
            <atom:VerticalSeparator Title="{gallery:SeparatorShowCaseLangResource P2TitleRightText}" />
            <atom:TextBlock Text="{gallery:SeparatorShowCaseLangResource P2TextItem2}" />
            <atom:VerticalSeparator />
            <atom:TextBlock Text="{gallery:SeparatorShowCaseLangResource P2TextItem3}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:SeparatorShowCaseLangResource VariantTitle}"
        Description="{gallery:SeparatorShowCaseLangResource VariantDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SeparatorViewModel">
        <StackPanel Orientation="Vertical">
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleSolid}" LineColor="#7cb305"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleDotted}" LineColor="#7cb305" Variant="Dotted"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
            <atom:Separator Title="{gallery:SeparatorShowCaseLangResource P2TitleDashed}" LineColor="#7cb305" Variant="Dashed"/>
            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:SeparatorShowCaseLangResource P2TextLoremIpsumDolorSitAmetConsecteturAdipiscingElit}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:SeparatorShowCaseLangResource SemanticPartStyleTitle}"
        Description="{gallery:SeparatorShowCaseLangResource SemanticPartStyleDescription}"
        SourceKey="separator-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        Span="Full"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SeparatorViewModel">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Stretch"
                            Spacing="16">
                    <StackPanel.Styles>
                        <Style Selector="atom|Separator.semantic-demo">
                            <Setter Property="LineColor" Value="#7cb305" />
                            <atom:SeparatorRailStyle x:SetterTargetType="atomc:SeparatorRail">
                                <Setter Property="LineColor" Value="#7cb305" />
                            </atom:SeparatorRailStyle>
                            <atom:SeparatorContentStyle x:SetterTargetType="atom:TextBlock">
                                <Setter Property="FontStyle" Value="Italic" />
                            </atom:SeparatorContentStyle>
                        </Style>
                        <Style Selector="atom|Separator.semantic-demo[TitlePosition=Left]">
                            <Setter Property="LineColor" Value="#722ed1" />
                            <atom:SeparatorContentStyle x:SetterTargetType="atom:TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                            </atom:SeparatorContentStyle>
                        </Style>
                        <Style Selector="atom|Separator.semantic-demo.semantic-variant">
                            <Setter Property="Variant" Value="Dashed" />
                            <atom:SeparatorRailStyle x:SetterTargetType="atomc:SeparatorRail">
                                <Setter Property="Opacity" Value="0.85" />
                            </atom:SeparatorRailStyle>
                        </Style>
                        <Style Selector="atom|Separator.semantic-demo[SizeType=Small]">
                            <Setter Property="Opacity" Value="0.6" />
                        </Style>
                    </StackPanel.Styles>

                    <atom:Separator Classes="semantic-demo"
                                    Title="{gallery:SeparatorShowCaseLangResource SemanticPartAllPartsTitle}" />
                    <atom:Separator Classes="semantic-demo"
                                    Title="{gallery:SeparatorShowCaseLangResource SemanticPartTitlePlacementTitle}"
                                    TitlePosition="Left" />
                    <atom:Separator Classes="semantic-demo semantic-variant"
                                    Title="{gallery:SeparatorShowCaseLangResource SemanticPartDashedRailTitle}" />
                    <atom:Separator Classes="semantic-demo"
                                    Title="{gallery:SeparatorShowCaseLangResource SemanticPartSmallSizeTitle}"
                                    SizeType="Small" />
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
