<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              TargetType="atom:ImagePreviewerTitleBar"
              x:Class="AtomUI.Desktop.Controls.Themes.ImagePreviewerTitleBarTheme"
              x:ClassModifier="internal">
    <ControlTheme.BasedOn>
        <atom:WindowTitleBarTheme TargetType="atom:ImagePreviewerTitleBar" />
    </ControlTheme.BasedOn>

    <ControlTheme.Resources>
        <atom:BorderThicknessFilterConverter x:Key="WindowTitleBarLeftPaddingConverter"
                                             Right="False"
                                             Top="False"
                                             Bottom="False" />
    </ControlTheme.Resources>

    <Setter Property="Background" Value="{atom:ImagePreviewerTokenResource TitleBarBackgroundColor}" />

    <Style Selector="^[OsType=Linux]">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:ImagePreviewerTitleBar">
                <Border Name="Frame" Background="{TemplateBinding Background}">
                    <atom:WindowTitleBarLayoutPanel
                        Padding="{TemplateBinding Padding}"
                        TitleAlignment="{TemplateBinding TitleAlignment}"
                        OsType="{TemplateBinding OsType}"
                        NativeChromeInsets="{TemplateBinding NativeChromeInsets}"
                        IsCsdEnabled="{TemplateBinding IsCsdEnabled}"
                        WindowState="{TemplateBinding HostWindowState}"
                        HorizontalSpacing="{atom:WindowTitleBarTokenResource HeaderHorizontalSpacing}"
                        ClipToBounds="True">
                        <ContentPresenter Name="PART_LeftAddOn"
                                          atom:WindowTitleBarLayoutPanel.Role="Leading"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding LeftAddOn}"
                                          ContentTemplate="{TemplateBinding LeftAddOnTemplate}"
                                          IsVisible="{TemplateBinding LeftAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <DockPanel Name="PART_TitleLayout"
                                   atom:WindowTitleBarLayoutPanel.Role="Title"
                                   LastChildFill="True"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True"
                                   HorizontalSpacing="{atom:WindowTitleBarTokenResource LogoAndTitleSpacing}">
                            <atom:IconPresenter Name="PART_IconPresenter"
                                                DockPanel.Dock="Left"
                                                Width="{atom:SharedTokenResource IconSize}"
                                                Height="{atom:SharedTokenResource IconSize}"
                                                Icon="{TemplateBinding Icon}"
                                                IconBrush="{TemplateBinding Foreground}"
                                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              ClipToBounds="True"
                                              TextWrapping="NoWrap"
                                              TextTrimming="CharacterEllipsis"
                                              Content="{TemplateBinding Title}"
                                              ContentTemplate="{TemplateBinding TitleTemplate}"
                                              IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </DockPanel>
                        <StackPanel atom:WindowTitleBarLayoutPanel.Role="Trailing"
                                    Orientation="Horizontal">
                            <ContentPresenter Name="PART_RightAddOn"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Content="{TemplateBinding RightAddOn}"
                                              ContentTemplate="{TemplateBinding RightAddOnTemplate}"
                                              IsVisible="{TemplateBinding RightAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <atom:CaptionButtonGroup Name="PART_CaptionButtonGroup"
                                                     OsType="{TemplateBinding OsType}"
                                                     IsWindowActive="{TemplateBinding IsWindowActive}"
                                                     IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                     HostWindowState="{TemplateBinding HostWindowState}"
                                                     IsWindowTopmost="{TemplateBinding IsWindowTopmost}"
                                                     IsMinimizeCaptionButtonVisible="{TemplateBinding IsMinimizeCaptionButtonVisible}"
                                                     IsMaximizeCaptionButtonVisible="{TemplateBinding IsMaximizeCaptionButtonVisible}"
                                                     IsCloseCaptionButtonVisible="{TemplateBinding IsCloseCaptionButtonVisible}"
                                                     IsFullScreenCaptionButtonVisible="{TemplateBinding IsFullScreenCaptionButtonVisible}"
                                                     IsPinCaptionButtonVisible="{TemplateBinding IsPinCaptionButtonVisible}"
                                                     CanMinimize="{TemplateBinding CanMinimize}"
                                                     CanMaximize="{TemplateBinding CanMaximize}"
                                                     IsPinCaptionButtonSupported="{TemplateBinding IsPinCaptionButtonSupported}"
                                                     CaptionButtonCommand="{TemplateBinding CaptionButtonCommand}" />
                        </StackPanel>
                    </atom:WindowTitleBarLayoutPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="^[OsType=Windows]">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:ImagePreviewerTitleBar">
                <Border Name="Frame" Background="{TemplateBinding Background}">
                    <atom:WindowTitleBarLayoutPanel
                        Padding="{TemplateBinding Padding, Converter={StaticResource WindowTitleBarLeftPaddingConverter}}"
                        TitleAlignment="{TemplateBinding TitleAlignment}"
                        OsType="{TemplateBinding OsType}"
                        NativeChromeInsets="{TemplateBinding NativeChromeInsets}"
                        IsCsdEnabled="{TemplateBinding IsCsdEnabled}"
                        WindowState="{TemplateBinding HostWindowState}"
                        HorizontalSpacing="{atom:WindowTitleBarTokenResource HeaderHorizontalSpacing}"
                        ClipToBounds="True">
                        <ContentPresenter Name="PART_LeftAddOn"
                                          atom:WindowTitleBarLayoutPanel.Role="Leading"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding LeftAddOn}"
                                          ContentTemplate="{TemplateBinding LeftAddOnTemplate}"
                                          IsVisible="{TemplateBinding LeftAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <DockPanel Name="PART_TitleLayout"
                                   atom:WindowTitleBarLayoutPanel.Role="Title"
                                   LastChildFill="True"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True"
                                   HorizontalSpacing="{atom:WindowTitleBarTokenResource LogoAndTitleSpacing}">
                            <atom:IconPresenter Name="PART_IconPresenter"
                                                DockPanel.Dock="Left"
                                                Width="{atom:SharedTokenResource IconSize}"
                                                Height="{atom:SharedTokenResource IconSize}"
                                                Icon="{TemplateBinding Icon}"
                                                IconBrush="{TemplateBinding Foreground}"
                                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              ClipToBounds="True"
                                              TextWrapping="NoWrap"
                                              TextTrimming="CharacterEllipsis"
                                              Content="{TemplateBinding Title}"
                                              ContentTemplate="{TemplateBinding TitleTemplate}"
                                              IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </DockPanel>
                        <StackPanel atom:WindowTitleBarLayoutPanel.Role="Trailing"
                                    Orientation="Horizontal">
                            <ContentPresenter Name="PART_RightAddOn"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Content="{TemplateBinding RightAddOn}"
                                              ContentTemplate="{TemplateBinding RightAddOnTemplate}"
                                              IsVisible="{TemplateBinding RightAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <atom:CaptionButtonGroup Name="PART_CaptionButtonGroup"
                                                     OsType="{TemplateBinding OsType}"
                                                     IsWindowActive="{TemplateBinding IsWindowActive}"
                                                     IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                     HostWindowState="{TemplateBinding HostWindowState}"
                                                     IsWindowTopmost="{TemplateBinding IsWindowTopmost}"
                                                     IsMinimizeCaptionButtonVisible="{TemplateBinding IsMinimizeCaptionButtonVisible}"
                                                     IsMaximizeCaptionButtonVisible="{TemplateBinding IsMaximizeCaptionButtonVisible}"
                                                     IsCloseCaptionButtonVisible="{TemplateBinding IsCloseCaptionButtonVisible}"
                                                     IsFullScreenCaptionButtonVisible="{TemplateBinding IsFullScreenCaptionButtonVisible}"
                                                     IsPinCaptionButtonVisible="{TemplateBinding IsPinCaptionButtonVisible}"
                                                     CanMinimize="{TemplateBinding CanMinimize}"
                                                     CanMaximize="{TemplateBinding CanMaximize}"
                                                     IsPinCaptionButtonSupported="{TemplateBinding IsPinCaptionButtonSupported}"
                                                     CaptionButtonCommand="{TemplateBinding CaptionButtonCommand}" />
                        </StackPanel>
                    </atom:WindowTitleBarLayoutPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="^[OsType=macOS]">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:ImagePreviewerTitleBar">
                <Border Name="Frame" Background="{TemplateBinding Background}">
                    <atom:WindowTitleBarLayoutPanel
                        Padding="{TemplateBinding Padding}"
                        TitleAlignment="{TemplateBinding TitleAlignment}"
                        OsType="{TemplateBinding OsType}"
                        NativeChromeInsets="{TemplateBinding NativeChromeInsets}"
                        IsCsdEnabled="{TemplateBinding IsCsdEnabled}"
                        WindowState="{TemplateBinding HostWindowState}"
                        HorizontalSpacing="{atom:WindowTitleBarTokenResource HeaderHorizontalSpacing}"
                        ClipToBounds="True">
                        <ContentPresenter Name="PART_LeftAddOn"
                                          atom:WindowTitleBarLayoutPanel.Role="Leading"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding LeftAddOn}"
                                          ContentTemplate="{TemplateBinding LeftAddOnTemplate}"
                                          IsVisible="{TemplateBinding LeftAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <DockPanel Name="PART_TitleLayout"
                                   atom:WindowTitleBarLayoutPanel.Role="Title"
                                   LastChildFill="True"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True"
                                   HorizontalSpacing="{atom:WindowTitleBarTokenResource LogoAndTitleSpacing}">
                            <atom:IconPresenter Name="PART_IconPresenter"
                                                DockPanel.Dock="Left"
                                                Width="{atom:SharedTokenResource IconSize}"
                                                Height="{atom:SharedTokenResource IconSize}"
                                                Icon="{TemplateBinding Icon}"
                                                IconBrush="{TemplateBinding Foreground}"
                                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              ClipToBounds="True"
                                              TextWrapping="NoWrap"
                                              TextTrimming="CharacterEllipsis"
                                              Content="{TemplateBinding Title}"
                                              ContentTemplate="{TemplateBinding TitleTemplate}"
                                              IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </DockPanel>
                        <StackPanel atom:WindowTitleBarLayoutPanel.Role="Trailing"
                                    Orientation="Horizontal">
                            <ContentPresenter Name="PART_RightAddOn"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Content="{TemplateBinding RightAddOn}"
                                              ContentTemplate="{TemplateBinding RightAddOnTemplate}"
                                              IsVisible="{TemplateBinding RightAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <atom:CaptionButtonGroup Name="PART_CaptionButtonGroup"
                                                     OsType="{TemplateBinding OsType}"
                                                     IsWindowActive="{TemplateBinding IsWindowActive}"
                                                     IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                     HostWindowState="{TemplateBinding HostWindowState}"
                                                     IsWindowTopmost="{TemplateBinding IsWindowTopmost}"
                                                     IsMinimizeCaptionButtonVisible="{TemplateBinding IsMinimizeCaptionButtonVisible}"
                                                     IsMaximizeCaptionButtonVisible="{TemplateBinding IsMaximizeCaptionButtonVisible}"
                                                     IsCloseCaptionButtonVisible="{TemplateBinding IsCloseCaptionButtonVisible}"
                                                     IsFullScreenCaptionButtonVisible="{TemplateBinding IsFullScreenCaptionButtonVisible}"
                                                     IsPinCaptionButtonVisible="{TemplateBinding IsPinCaptionButtonVisible}"
                                                     CanMinimize="{TemplateBinding CanMinimize}"
                                                     CanMaximize="{TemplateBinding CanMaximize}"
                                                     IsPinCaptionButtonSupported="{TemplateBinding IsPinCaptionButtonSupported}"
                                                     CaptionButtonCommand="{TemplateBinding CaptionButtonCommand}" />
                        </StackPanel>
                    </atom:WindowTitleBarLayoutPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</ControlTheme>
