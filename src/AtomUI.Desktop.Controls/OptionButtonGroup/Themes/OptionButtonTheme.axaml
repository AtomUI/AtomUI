<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:OptionButton}" TargetType="atom:OptionButton">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OptionButtonTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OptionButtonTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                              CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                              IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}" />
                    <DockPanel Name="ContentLayout"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="{TemplateBinding Padding}"
                               LastChildFill="True">
                        <atom:IconPresenter Name="IconPresenter"
                                            DockPanel.Dock="Left"
                                            IconBrush="{TemplateBinding Foreground}"
                                            IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Icon="{TemplateBinding Icon}" />
                        <atom:TextBlock Padding="0"
                                        VerticalAlignment="Center"
                                        Text="{TemplateBinding Content}" />
                    </DockPanel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FontSize" Value="{atom:OptionButtonTokenResource ContentFontSize}" />
        <Setter Property="Padding" Value="{atom:OptionButtonTokenResource ContentPadding}" />
        <Setter Property="CornerRadius" Value="{atom:OptionButtonTokenResource BorderRadius}" />

        <Style Selector="^ /template/ DockPanel#ContentLayout">
            <Setter Property="HorizontalSpacing" Value="{atom:OptionButtonTokenResource SpacingXXS}" />
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
            <Setter Property="Width" Value="{atom:OptionButtonTokenResource IconSizeLG}" />
            <Setter Property="Height" Value="{atom:OptionButtonTokenResource IconSizeLG}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="FontSize"
                    Value="{atom:OptionButtonTokenResource ContentFontSizeLG}" />
            <Setter Property="Padding" Value="{atom:OptionButtonTokenResource ContentPaddingLG}" />
            <Setter Property="CornerRadius" Value="{atom:OptionButtonTokenResource BorderRadiusLG}" />
            
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width" Value="{atom:OptionButtonTokenResource IconSizeLG}" />
                <Setter Property="Height" Value="{atom:OptionButtonTokenResource IconSizeLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="FontSize" Value="{atom:OptionButtonTokenResource ContentFontSize}" />
            <Setter Property="Padding" Value="{atom:OptionButtonTokenResource ContentPadding}" />
            <Setter Property="CornerRadius" Value="{atom:OptionButtonTokenResource BorderRadius}" />
            
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width" Value="{atom:OptionButtonTokenResource IconSizeLG}" />
                <Setter Property="Height" Value="{atom:OptionButtonTokenResource IconSizeLG}" />
            </Style>
        </Style>

        <Style Selector="^[GroupOrientation=Vertical]">
            <Setter Property="Height" Value="{atom:OptionButtonTokenResource ControlHeight}" />

            <Style Selector="^ /template/ DockPanel#ContentLayout">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style Selector="^[SizeType=Large]">
                <Setter Property="Height" Value="{atom:OptionButtonTokenResource ControlHeightLG}" />
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Setter Property="Height" Value="{atom:OptionButtonTokenResource ControlHeight}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Height" Value="{atom:OptionButtonTokenResource ControlHeightSM}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize"
                    Value="{atom:OptionButtonTokenResource ContentFontSizeSM}" />
            <Setter Property="Padding" Value="{atom:OptionButtonTokenResource ContentPaddingSM}" />
            <Setter Property="CornerRadius" Value="{atom:OptionButtonTokenResource BorderRadiusSM}" />
                    
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width" Value="{atom:OptionButtonTokenResource IconSizeSM}" />
                <Setter Property="Height" Value="{atom:OptionButtonTokenResource IconSizeSM}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ atom|WaveSpiritDecorator#PART_WaveSpirit">
            <Setter Property="WaveType" Value="RoundRectWave" />
        </Style>
        <Style Selector="^[ButtonStyle=Solid]">
            <Style Selector="^[IsMotionEnabled=True]">
                <Setter Property="Transitions">
                    <atom:TokenTransitions DurationKind="MotionDurationMid">
                        <atom:SolidColorBrushTransition Property="BorderBrush" />
                        <atom:SolidColorBrushTransition Property="Background" />
                        <atom:SolidColorBrushTransition Property="Foreground" />
                    </atom:TokenTransitions>
                </Setter>
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Foreground"
                        Value="{atom:OptionButtonTokenResource ButtonSolidCheckedColor}" />
                <Setter Property="Background"
                        Value="{atom:OptionButtonTokenResource ButtonSolidCheckedBackground}" />

                <Style Selector="^:pointerover">
                    <Setter Property="Background"
                            Value="{atom:OptionButtonTokenResource ButtonSolidCheckedHoverBackground}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="Background"
                            Value="{atom:OptionButtonTokenResource ButtonSolidCheckedActiveBackground}" />
                </Style>
            </Style>

            <Style Selector="^:unchecked">
                <Setter Property="Foreground" Value="{atom:OptionButtonTokenResource ButtonColor}" />
                <Setter Property="Background">
                    <MultiBinding Converter="{x:Static atom:OptionButtonThemeConverters.OptionalBackground}">
                        <atom:OptionButtonTokenResource Kind="ButtonBackground" WhenExplicit="True" />
                        <atom:OptionButtonTokenResource Kind="ButtonBackground" />
                    </MultiBinding>
                </Setter>

                <Style Selector="^:pointerover">
                    <Setter Property="Foreground"
                            Value="{atom:OptionButtonTokenResource ColorPrimaryHover}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="Foreground"
                            Value="{atom:OptionButtonTokenResource ColorPrimaryActive}" />
                </Style>
            </Style>

            <Style Selector="^:disabled">
                <Setter Property="BorderBrush" Value="{atom:OptionButtonTokenResource ColorBorder}" />
                <Setter Property="Foreground"
                        Value="{atom:OptionButtonTokenResource ColorTextDisabled}" />
                <Setter Property="Background"
                        Value="{atom:OptionButtonTokenResource ColorBgContainerDisabled}" />

                <Style Selector="^:checked">
                    <Setter Property="Foreground"
                            Value="{atom:OptionButtonTokenResource ButtonCheckedColorDisabled}" />
                    <Setter Property="Background"
                            Value="{atom:OptionButtonTokenResource ButtonCheckedBgDisabled}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[ButtonStyle=Outline]">
            <Style Selector="^[IsMotionEnabled=True]">
                <Setter Property="Transitions">
                    <atom:TokenTransitions DurationKind="MotionDurationMid">
                        <atom:SolidColorBrushTransition Property="BorderBrush" />
                        <atom:SolidColorBrushTransition Property="Foreground" />
                    </atom:TokenTransitions>
                </Setter>
            </Style>
            <Setter Property="Background">
                <MultiBinding Converter="{x:Static atom:OptionButtonThemeConverters.OptionalBackground}">
                    <atom:OptionButtonTokenResource Kind="ButtonBackground" WhenExplicit="True" />
                    <atom:OptionButtonTokenResource Kind="ButtonBackground" />
                </MultiBinding>
            </Setter>
            <Style Selector="^:checked">
                <Setter Property="Background">
                    <MultiBinding Converter="{x:Static atom:OptionButtonThemeConverters.OptionalBackground}">
                        <atom:OptionButtonTokenResource Kind="ButtonBackground" WhenExplicit="True" />
                        <atom:OptionButtonTokenResource Kind="ButtonBackground" />
                        <atom:OptionButtonTokenResource Kind="ButtonCheckedBackground" WhenExplicit="True" />
                        <atom:OptionButtonTokenResource Kind="ButtonCheckedBackground" />
                    </MultiBinding>
                </Setter>
                <Setter Property="Foreground"
                        Value="{atom:OptionButtonTokenResource ColorPrimary}" />
                <Setter Property="BorderBrush"
                        Value="{atom:OptionButtonTokenResource ColorPrimary}" />
            </Style>

            <Style Selector="^:unchecked">
                <Setter Property="Foreground"
                        Value="{atom:OptionButtonTokenResource ButtonColor}" />
                <Setter Property="BorderBrush"
                        Value="{atom:OptionButtonTokenResource ColorBorder}" />
            </Style>

            <Style Selector="^:pointerover">
                <Setter Property="Foreground"
                        Value="{atom:OptionButtonTokenResource ColorPrimaryHover}" />
                <Setter Property="BorderBrush"
                        Value="{atom:OptionButtonTokenResource ColorPrimaryHover}" />
            </Style>

            <Style Selector="^:pressed">
                <Setter Property="Foreground"
                        Value="{atom:OptionButtonTokenResource ColorPrimaryActive}" />
                <Setter Property="BorderBrush"
                        Value="{atom:OptionButtonTokenResource ColorPrimaryActive}" />
            </Style>

            <Style Selector="^:disabled">
                <Setter Property="BorderBrush" Value="{atom:OptionButtonTokenResource ColorBorder}" />
                <Setter Property="Foreground"
                        Value="{atom:OptionButtonTokenResource ColorTextDisabled}" />
                <Setter Property="Background"
                        Value="{atom:OptionButtonTokenResource ColorBgContainerDisabled}" />

                <Style Selector="^:checked">
                    <Setter Property="Foreground"
                            Value="{atom:OptionButtonTokenResource ButtonCheckedColorDisabled}" />
                    <Setter Property="Background"
                            Value="{atom:OptionButtonTokenResource ButtonCheckedBgDisabled}" />
                </Style>
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
