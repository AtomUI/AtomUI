<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.MenuFlyoutPresenterTheme"
              TargetType="atom:MenuFlyoutPresenter"
              x:ClassModifier="internal">
    <Setter Property="FontFamily">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
            <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontFamily" />
        </MultiBinding>
    </Setter>
    <Setter Property="FontSize">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
            <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontSize" />
        </MultiBinding>
    </Setter>
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:MenuFlyoutPresenter">
            <atom:ArrowDecoratedBox Name="{x:Static atom:AbstractArrowDecoratedBox.ArrowDecoratorPart}"
                                    IsArrowVisible="{TemplateBinding IsArrowVisible}"
                                    ArrowPosition="{TemplateBinding ArrowPosition}"
                                    Padding="{TemplateBinding Padding}"
                                    MaxHeight="{TemplateBinding MaxPopupHeight}">
                <atom:MenuPopupScrollHost IsScrollEnabled="{TemplateBinding IsScrollEnabled}"
                                          IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                          atom:ScrollViewer.IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                          AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    Grid.IsSharedSizeScope="True" />
                </atom:MenuPopupScrollHost>
            </atom:ArrowDecoratedBox>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|MenuFlyoutPresenter)">
        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgElevated}" />
        <Setter Property="CornerRadius" Value="{atom:PopupTokenResource PopupCornerRadius}" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="Padding" Value="{atom:MenuTokenResource MenuPopupContentPadding}" />
        <Setter Property="ItemHeight" Value="{atom:MenuTokenResource ItemHeight}" />

        <Style Selector="^ /template/ atom|ArrowDecoratedBox#PART_ArrowDecorator">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgElevated}" />
            <Setter Property="MinWidth" Value="{atom:MenuTokenResource MenuPopupMinWidth}" />
            <Setter Property="MaxWidth" Value="{atom:MenuTokenResource MenuPopupMaxWidth}" />
        </Style>
    </Style>

</ControlTheme>
