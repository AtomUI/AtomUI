    <unit id="PageDescription">
      <segment>
        <source>DatePicker supports single and range selection, confirmation flows, time selection, disabled states, size variants, validation status, visual variants, and custom popup placement.</source>
        <target state="translated">DatePicker 支援單選與範圍選擇、確認流程、時間選擇、禁用狀態、尺寸變體、校驗狀態、視覺變體和自定義彈出位置。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Select dates, ranges, and optional times from calendar panels.</source>
        <target state="translated">從日曆面板中選擇日期、日期範圍和可選時間。</target>
      </segment>
    </unit>
    <unit id="PickerDisplayDateDescription">
      <segment>
        <source>Open the popup panel at a specific display date without committing a selected value.</source>
        <target state="translated">打開彈出面板時定位到指定日期，但不提交選中值。</target>
      </segment>
    </unit>
    <unit id="PickerDisplayDateTitle">
      <segment>
        <source>Popup display date</source>
        <target state="translated">彈出面板顯示日期</target>
      </segment>
    </unit>
    <unit id="PlacementDescription">
      <segment>
        <source>You can manually specify the position of the popup via placement.</source>
        <target state="translated">可以通過 placement 手動指定彈出層位置。</target>
      </segment>
    </unit>
    <unit id="PlacementTitle">
      <segment>
        <source>Placement</source>
        <target state="translated">彈出位置</target>
      </segment>
    </unit>
    <unit id="RangePickerDescription">
      <segment>
        <source>Set range picker type by picker prop.</source>
        <target state="translated">通過 picker 屬性設置範圍選擇器類型。</target>
      </segment>
    </unit>
    <unit id="RangePickerTitle">
      <segment>
        <source>Range Picker</source>
        <target state="translated">範圍選擇器</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="SemanticClearDescription">
      <segment>
        <source>Clear button in the suffix area, rendered in clear mode.</source>
        <target state="translated">後綴區清除按鈕,進入清除模式時渲染。</target>
      </segment>
    </unit>
    <unit id="SemanticInputDescription">
      <segment>
        <source>Start date text input of the picker.</source>
        <target state="translated">選擇器的起始日期文字輸入框。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupBodyDescription">
      <segment>
        <source>Date panel table container; in dual-month layout it hosts both month tables.</source>
        <target state="translated">日期面板表格容器;雙月佈局時同時承載兩張月表。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupCellDescription">
      <segment>
        <source>Date cell button carrying selected, range, today and disabled states.</source>
        <target state="translated">日期格子按鈕,承載選中、範圍、今天與停用等狀態。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupContainerDescription">
      <segment>
        <source>Panel content container organizing the calendar body and the footer buttons.</source>
        <target state="translated">日曆面板內容容器,組織主體區與底部按鈕區佈局。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupContentDescription">
      <segment>
        <source>One month date table with the day cells and the week number column variant.</source>
        <target state="translated">單個月份的日期表格,含日期格子與週序號列變體。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupFooterDescription">
      <segment>
        <source>Footer area with the Now, Today and OK buttons.</source>
        <target state="translated">面板底部操作區,承載此刻、今天與確定按鈕。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupHeaderDescription">
      <segment>
        <source>Calendar header with the year/month title and the navigation buttons.</source>
        <target state="translated">日曆年月導航頭部,承載年月標題與導航按鈕。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupRootDescription">
      <segment>
        <source>Root visual box of the popup layer with the floating arrow.</source>
        <target state="translated">彈層內容根視覺盒子,帶浮動箭頭。</target>
      </segment>
    </unit>
    <unit id="SemanticPrefixDescription">
      <segment>
        <source>Prefix area hosting the ContentLeftAddOn content inside the input.</source>
        <target state="translated">輸入區內容前綴區域,承載 ContentLeftAddOn 使用者內容。</target>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>The RangeDatePicker owner itself.</source>
        <target state="translated">RangeDatePicker 控制項本體。</target>
      </segment>
    </unit>
    <unit id="SemanticSecondaryInputDescription">
      <segment>
        <source>End date text input of the range picker.</source>
        <target state="translated">範圍選擇的結束日期文字輸入框。</target>
      </segment>
    </unit>
    <unit id="SemanticSuffixDescription">
      <segment>
        <source>Suffix area hosting the clear button, the form feedback and the user suffix content.</source>
        <target state="translated">輸入區後綴區域,承載清除按鈕、表單回饋與使用者後綴內容。</target>
      </segment>
    </unit>
    <unit id="StatusDescription">
      <segment>
        <source>Add status to DatePicker with status, which could be error or warning.</source>
        <target state="translated">通過 status 為 DatePicker 添加狀態，可設置為錯誤或警告。</target>
      </segment>
    </unit>
    <unit id="StatusTitle">
      <segment>
        <source>Status</source>
        <target state="translated">狀態</target>
      </segment>
    </unit>
    <unit id="StyleClassDescription">
      <segment>
        <source>Apply owner-scoped styles with the public Semantic Parts of the picker to customize the prefix, both inputs, the date cells and the popup layer.</source>
        <target state="translated">透過 owner 作用域樣式與控制項公開的語義部件,自訂前綴、兩端輸入、日期格子與彈層視覺。</target>
      </segment>
    </unit>
    <unit id="StyleClassTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
        <target state="translated">自訂語義結構的樣式</target>
      </segment>
    </unit>
    <unit id="SwitchableDescription">
      <segment>
        <source>Switch between TimePicker and DatePicker modes from a single selector.</source>
        <target state="translated">透過一個選擇器在 TimePicker 和 DatePicker 各類型之間切換，常用於日期篩選場景。</target>
      </segment>
    </unit>
    <unit id="SwitchableTitle">
      <segment>
        <source>Switchable picker</source>
        <target state="translated">切換不同的選擇器</target>
      </segment>
    </unit>
    <unit id="ThreeSizesDescription">
      <segment>
        <source>The input box comes in three sizes: small, middle and large. The middle size will be used if size is omitted.</source>
        <target state="translated">輸入框提供小號、中號和大號三種尺寸。省略 size 時使用中號。</target>
      </segment>
    </unit>
    <unit id="ThreeSizesTitle">
      <segment>
        <source>Three Sizes</source>
        <target state="translated">三種尺寸</target>
      </segment>
    </unit>
    <unit id="VariantsDescription">
      <segment>
        <source>Bordered-less style component.</source>
        <target state="translated">無邊框風格組件。</target>
      </segment>
    </unit>
    <unit id="VariantsTitle">
      <segment>
        <source>Variants</source>
