<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:MessageCard}" TargetType="atom:MessageCard">
        <Setter Property="Template">
            <ControlTemplate>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{TemplateBinding BoxShadow}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel Name="PART_HeaderContainer"
                                   Classes.semantic-wrapper="True"
                                   LastChildFill="True">
                            <atom:IconPresenter Name="PART_IconContent"
                                                Classes.semantic-icon="True"
                                                DockPanel.Dock="Left"
                                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Icon="{TemplateBinding Icon}" />
                            <SelectableTextBlock Name="PART_Message"
                                                 Classes.semantic-title="True"
                                                 Text="{TemplateBinding Message}" />
                        </DockPanel>
                    </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        
        <Style Selector="^ /template/ atom|IconPresenter">
            <Setter Property="Width" Value="{atom:MessageCardTokenResource MessageIconSize}" />
            <Setter Property="Height" Value="{atom:MessageCardTokenResource MessageIconSize}" />
        </Style>

        <Style Selector="^[MessageType=Information]">
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:SharedTokenResource ColorPrimary}" />
            </Style>
        </Style>

        <Style Selector="^[MessageType=Loading]">
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:SharedTokenResource ColorPrimary}" />
            </Style>
        </Style>

        <Style Selector="^[MessageType=Error]">
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:SharedTokenResource ColorError}" />
            </Style>
        </Style>

        <Style Selector="^[MessageType=Success]">
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:SharedTokenResource ColorSuccess}" />
            </Style>
        </Style>

        <Style Selector="^[MessageType=Warning]">
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:SharedTokenResource ColorWarning}" />
            </Style>
        </Style>

        <Setter Property="OpenCloseMotionDuration"
                Value="{atom:SharedTokenResource MotionDurationMid}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}"
                                               Easing="0.645,0.045,0.355,1" />
                <DoubleTransition Property="Opacity"
                                  Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}"
                                  Easing="0.645,0.045,0.355,1" />
            </Transitions>
        </Setter>

        <Style Selector="^[IsMotionEnabled=False]">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>

        <!--
            root 表面默认值放在 owner 级：PART_Frame 通过 TemplateBinding 取用，因此 ControlTheme
            只提供默认视觉，用户经 owner-scoped Semantic Style 覆盖时能真正投影到卡片外框。
            BorderBrush / BorderThickness 不设默认值（保持 null / 0），与透传前的默认外观一致。
        -->
        <Setter Property="Background" Value="{atom:MessageCardTokenResource ContentBg}" />
        <Setter Property="Padding" Value="{atom:MessageCardTokenResource ContentPadding}" />
        <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
        <Setter Property="BoxShadow" Value="{atom:SharedTokenResource BoxShadows}" />

        <Style Selector="^ /template/ Border#PART_Frame">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="^[IsClosed=True]">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="^ /template/ SelectableTextBlock#PART_Message">
            <Setter Property="LineHeight" Value="{atom:SharedTokenResource FontHeight}" />
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
            <Setter Property="SelectionBrush" Value="{atom:SharedTokenResource SelectionBackground}" />
            <Setter Property="SelectionForegroundBrush" Value="{atom:SharedTokenResource SelectionForeground}" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconPresenter#PART_IconContent">
            <Setter Property="Margin" Value="{atom:MessageCardTokenResource MessageIconMargin}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
