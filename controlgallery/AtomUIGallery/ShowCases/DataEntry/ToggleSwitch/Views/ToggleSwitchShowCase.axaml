<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.ToggleSwitch.ToggleSwitchShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:showCase="clr-namespace:AtomUIGallery.ShowCases.ToggleSwitch"
             xmlns:vm="using:AtomUIGallery.ShowCases.ToggleSwitch"
             x:DataType="vm:ToggleSwitchViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="ToggleSwitch"
                    Category="{gallery:ToggleSwitchShowCaseLangResource ComponentCategory}"
                    Status="{gallery:ToggleSwitchShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:ToggleSwitchShowCaseLangResource PageSubtitle}"
                    Description="{gallery:ToggleSwitchShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="AbstractToggleSwitch" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                    <gallery:SemanticPartPreview Name="ToggleSwitchSemanticPreview"
                                                 SemanticOwner="{Binding #ToggleSwitchSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:ToggleSwitch}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:ToggleSwitch Name="ToggleSwitchSemanticOwner"
                                               OnContent="ON"
                                               OffContent="OFF"
                                               IsChecked="True" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:ToggleSwitchShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:ToggleSwitchShowCaseLangResource SemanticContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="indicator"
                                Description="{gallery:ToggleSwitchShowCaseLangResource SemanticIndicatorDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:ToggleSwitchShowCaseLangResource BasicTitle}"
                    Description="{gallery:ToggleSwitchShowCaseLangResource BasicDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                    <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Horizontal">
                        <atom:ToggleSwitch />
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ToggleSwitchShowCaseLangResource DisabledTitle}"
                    Description="{gallery:ToggleSwitchShowCaseLangResource DisabledDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                    <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                        <atom:ToggleSwitch x:Name="ToggleDisabledSwitch"
                                           IsEnabled="{Binding IsDisabledDemoEnabled}" />
                        <atom:Button ButtonType="Primary"
                                     Click="HandleToggleDisabledButtonClick"
                                     Content="{gallery:ToggleSwitchShowCaseLangResource P2ContentToggleDisabled}" />
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ToggleSwitchShowCaseLangResource TextAndIconTitle}"
                    Description="{gallery:ToggleSwitchShowCaseLangResource TextAndIconDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                    <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                        <atom:ToggleSwitch
                            OnContent="{gallery:ToggleSwitchShowCaseLangResource P2OnContentOn}"
                            OffContent="{gallery:ToggleSwitchShowCaseLangResource P2OffContentOff}"
                            IsChecked="True" />
                        <atom:ToggleSwitch
                            OnContent="{gallery:ToggleSwitchShowCaseLangResource P2OnContentText}"
                            OffContent="{gallery:ToggleSwitchShowCaseLangResource P2OffContentText}" />
                        <atom:ToggleSwitch
                            OnContent="{antdicons:AntDesignIconProvider Kind=TwitterOutlined}"
                            OffContent="{antdicons:AntDesignIconProvider Kind=WechatOutlined}"/>
                        <atom:ToggleSwitch
                            SizeType="Small"
                            OnContent="{antdicons:AntDesignIconProvider Kind=CheckOutlined}"
                            OffContent="{antdicons:AntDesignIconProvider Kind=WechatOutlined}"/>
                        <atom:ToggleSwitch SizeType="Small">
                            <atom:ToggleSwitch.OnContent>
                                <antdicons:CheckOutlined/>
                            </atom:ToggleSwitch.OnContent>
                            <atom:ToggleSwitch.OffContent>
                                <antdicons:CloseOutlined/>
                            </atom:ToggleSwitch.OffContent>
                        </atom:ToggleSwitch>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ToggleSwitchShowCaseLangResource TwoSizesTitle}"
                    Description="{gallery:ToggleSwitchShowCaseLangResource TwoSizesDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                    <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                        <atom:ToggleSwitch />
                        <atom:ToggleSwitch SizeType="Small" />
                        <atom:ToggleSwitch Name="CustomSizeTypeToggleSwitch"
                                           SizeType="Custom"
                                           IsChecked="True"
                                           OnContent="{gallery:ToggleSwitchShowCaseLangResource P2ContentCustom}"
                                           OffContent="{gallery:ToggleSwitchShowCaseLangResource P2ContentCustom}" />
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ToggleSwitchShowCaseLangResource LoadingTitle}"
                    Description="{gallery:ToggleSwitchShowCaseLangResource LoadingDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                    <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                        <atom:ToggleSwitch IsLoading="{Binding IsLoadingDemoLoading}" IsChecked="true" x:Name="ToggleSwitchDefault" />
                        <atom:ToggleSwitch SizeType="Small" IsLoading="{Binding IsLoadingDemoLoading}" x:Name="ToggleSwitchSmall" />
                        <atom:Button ButtonType="Primary"
                                     Click="HandleToggleLoadingButtonClick"
                                     Content="{gallery:ToggleSwitchShowCaseLangResource P2ContentToggleLoading}" />
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
                <gallery:ShowCaseItem
                    Title="{gallery:ToggleSwitchShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:ToggleSwitchShowCaseLangResource SemanticPartStyleDescription}"
                    SourceKey="toggleswitch-semantic-part"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    Span="Full"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Left"
                                        Spacing="12">
                                <StackPanel.Styles>
                                    <Style Selector="atom|ToggleSwitch.semantic-object">
                                        <Setter Property="GrooveBackground" Value="#F5D2D2" />
                                    </Style>
                                    <Style Selector="atom|ToggleSwitch.semantic-function">
                                        <Setter Property="GrooveBackground" Value="#BDE3C3" />
                                    </Style>
                                    <Style Selector="atom|ToggleSwitch.semantic-mui">
                                        <Setter Property="TrackHeight" Value="14" />
                                        <Setter Property="TrackMinWidth" Value="32" />
                                        <Setter Property="TrackPadding" Value="-3" />
                                        <Setter Property="KnobSize" Value="20,20" />
                                        <atom:ToggleSwitchIndicatorStyle x:SetterTargetType="TemplatedControl">
                                            <Setter Property="Background" Value="#1976d2" />
                                            <Setter Property="Effect">
                                                <DropShadowEffect OffsetX="0"
                                                                  OffsetY="1"
                                                                  BlurRadius="4"
                                                                  Color="#4D000000" />
                                            </Setter>
                                        </atom:ToggleSwitchIndicatorStyle>
                                    </Style>
                                    <Style Selector="atom|ToggleSwitch.semantic-mui:checked">
                                        <Setter Property="GrooveBackground" Value="#801976d2" />
                                    </Style>
                                </StackPanel.Styles>

                                <atom:ToggleSwitch Classes="semantic-object"
                                                   SizeType="Small"
                                                   Width="40"
                                                   OnContent="on"
                                                   OffContent="off" />
                                <atom:ToggleSwitch Classes="semantic-function"
                                                   OnContent="on"
                                                   OffContent="off" />
                                <atom:ToggleSwitch Classes="semantic-mui"
                                                   IsChecked="True" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
