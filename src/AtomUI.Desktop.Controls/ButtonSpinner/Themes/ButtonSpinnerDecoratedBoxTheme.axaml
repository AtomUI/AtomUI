<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ButtonSpinnerDecoratedBox}"
                  TargetType="atom:ButtonSpinnerDecoratedBox">
        <ControlTheme.BasedOn>
            <atom:AddOnDecoratedBoxTheme TargetType="atom:ButtonSpinnerDecoratedBox" />
        </ControlTheme.BasedOn>

        <Setter Property="Template">
            <ControlTemplate TargetType="atom:ButtonSpinnerDecoratedBox">
                <DockPanel Name="RootLayout" LastChildFill="True"> 
                    <atom:PixelAlignedBorder
                        Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.LeftAddOnPart}"
                        VerticalAlignment="Stretch"
                        Focusable="False"
                        DockPanel.Dock="Left"
                        BackgroundSizing="InnerBorderEdge"
                        BorderThickness="{TemplateBinding LeftAddOnBorderThickness}"
                        CornerRadius="{TemplateBinding LeftAddOnCornerRadius}"
                        IsVisible="{Binding Child, ElementName=PART_LeftAddOnPresenter, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <atom:AddOnContentPresenter
                            Name="PART_LeftAddOnPresenter"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Focusable="False"
                            Content="{TemplateBinding LeftAddOn}"
                            ContentTemplate="{TemplateBinding LeftAddOnTemplate}" />
                    </atom:PixelAlignedBorder>
                    <atom:PixelAlignedBorder
                        Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.RightAddOnPart}"
                        VerticalAlignment="Stretch"
                        DockPanel.Dock="Right"
                        Focusable="False"
                        BorderThickness="{TemplateBinding RightAddOnBorderThickness}"
                        BackgroundSizing="InnerBorderEdge"
                        CornerRadius="{TemplateBinding RightAddOnCornerRadius}"
                        IsVisible="{Binding Child, ElementName=PART_RightAddOnPresenter, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <atom:AddOnContentPresenter
                            Name="PART_RightAddOnPresenter"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Focusable="False"
                            Content="{TemplateBinding RightAddOn}"
                            ContentTemplate="{TemplateBinding RightAddOnTemplate}" />
                    </atom:PixelAlignedBorder>

                    <Panel>
                        <atom:AddOnDecoratedBoxContentFrame Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentFramePart}"
                                                            BorderThickness="{TemplateBinding InnerBoxBorderThickness}"
                                                            CornerRadius="{TemplateBinding InnerBoxCornerRadius}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            Background="{TemplateBinding Background}"
                                                            BackgroundSizing="InnerBorderEdge">
                            <atom:ButtonSpinnerContentPanel Name="ContentLayout"
                                                            LastChildFill="True"
                                                            HandleLocation="{TemplateBinding ButtonSpinnerLocation}"
                                                            IsHandleFloatable="{TemplateBinding IsHandleFloatable}"
                                                            HandleWidth="{TemplateBinding SpinnerHandleWidth}"
                                                            Background="Transparent"
                                                            ContentPadding="{TemplateBinding EffectiveContentPadding}"
                                                            IsHover="{TemplateBinding IsSpinnerContentHover}">
                                <atom:AddOnContentPresenter
                                    Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentLeftAddOnPart}"
                                    Classes.semantic-scope-prefix="True"
                                    Classes.semantic-inner-left-content="True"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Focusable="False"
                                    Content="{TemplateBinding ContentLeftAddOn}"
                                    ContentTemplate="{TemplateBinding ContentLeftAddOnTemplate}"
                                    ZIndex="{x:Static atom:AddOnDecoratedBoxThemeConstants.ActivatedZIndex}">
                                    <atom:AddOnContentPresenter.RenderTransform>
                                        <TranslateTransform X="{Binding ContentLeftShift, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </atom:AddOnContentPresenter.RenderTransform>
                                </atom:AddOnContentPresenter>

                                <atom:AddOnContentPresenter
                                    DockPanel.Dock="Right"
                                    Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentRightAddOnPart}"
                                    Classes.semantic-scope-suffix="True"
                                    Classes.semantic-inner-right-content="True"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Focusable="False"
                                    Content="{TemplateBinding ContentRightAddOn}"
                                    ContentTemplate="{TemplateBinding ContentRightAddOnTemplate}"
                                    ZIndex="{x:Static atom:AddOnDecoratedBoxThemeConstants.ActivatedZIndex}">
                                    <atom:AddOnContentPresenter.RenderTransform>
                                        <TranslateTransform X="{Binding ContentRightShift, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </atom:AddOnContentPresenter.RenderTransform>
                                </atom:AddOnContentPresenter>

                                <ContentPresenter
                                    Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentPresenterPart}"
                                    Classes.semantic-content="True"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </atom:ButtonSpinnerContentPanel>
                        </atom:AddOnDecoratedBoxContentFrame>

                        <ContentPresenter
                            Name="PART_SpinnerHandle"
                            ZIndex="{x:Static atom:AddOnDecoratedBoxThemeConstants.ActivatedZIndex}"
                            Content="{TemplateBinding SpinnerContent}"
                            Opacity="{TemplateBinding HandleOpacity}">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform X="{Binding HandleOffset, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Panel>
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:is(atom|ButtonSpinnerDecoratedBox)">

            <Setter Property="SpinnerBorderThickness"
                    Value="{atom:SharedTokenResource BorderThickness}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SpinnerHandleWidth"
                    Value="{atom:ButtonSpinnerTokenResource HandleWidth}" />

            <Style Selector="^[IsMotionEnabled=True]">
                <Setter Property="Transitions">
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="BorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                        <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                        <DoubleTransition Property="HandleOpacity" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                        <DoubleTransition Property="HandleOffset" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                        <DoubleTransition Property="ContentLeftShift" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                        <DoubleTransition Property="ContentRightShift" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="^[ButtonSpinnerLocation=Left]">
                <Style Selector="^ /template/ ContentPresenter#PART_SpinnerHandle">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                </Style>
            </Style>
            <Style Selector="^[ButtonSpinnerLocation=Right]">
                <Style Selector="^ /template/ ContentPresenter#PART_SpinnerHandle">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
            </Style>

            <Style Selector="^ /template/ atom|ButtonSpinnerContentPanel#ContentLayout">
                <Setter Property="HorizontalSpacing" Value="{atom:SharedTokenResource SpacingXXS}" />
            </Style>

            <Style Selector="^[SizeType=Large]">
                <Setter Property="ContentPadding"
                        Value="{atom:ButtonSpinnerTokenResource InputPaddingLG}" />
                <Setter Property="MinHeight" Value="{atom:SharedTokenResource ControlHeightLG}" />
            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="ContentPadding"
                        Value="{atom:ButtonSpinnerTokenResource InputPadding}" />
                <Setter Property="MinHeight" Value="{atom:SharedTokenResource ControlHeight}" />
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Setter Property="ContentPadding"
                        Value="{atom:ButtonSpinnerTokenResource InputPaddingSM}" />
                <Setter Property="MinHeight" Value="{atom:SharedTokenResource ControlHeightSM}" />
            </Style>
            <Style Selector="^[SizeType=Large], ^[SizeType=Middle], ^[SizeType=Custom], ^[SizeType=Small]">
                <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                    <Setter Property="Padding"
                            Value="{Binding (atom:ButtonSpinnerDecoratedBox).EffectiveContentPadding, RelativeSource={RelativeSource TemplatedParent}}" />
                </Style>
            </Style>

        </Style>
    </ControlTheme>
</ResourceDictionary>
