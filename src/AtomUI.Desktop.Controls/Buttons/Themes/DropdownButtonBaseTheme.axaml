<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:antdicons="https://atomui.net/icons/antdesign"
              xmlns:documents="using:Avalonia.Controls.Documents"
              x:Class="AtomUI.Desktop.Controls.Themes.DropdownButtonBaseTheme"
              TargetType="atom:DropdownButton">
    <Setter Property="OpenMotion" Value="{atom:MotionResource DropdownOpen}" />
    <Setter Property="CloseMotion" Value="{atom:MotionResource DropdownClose}" />
    <Style Selector="^:is(atom|Button)">
        <Style Selector="^[ButtonType=Default], ^[ButtonType=Link], ^[ButtonType=Primary], ^[ButtonType=Text]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}" />
                        <Border Padding="{TemplateBinding Padding}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    VerticalAlignment="Center"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    VerticalAlignment="Center"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding EffectiveIconVisible}" />
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </DockPanel>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[ButtonType=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    VerticalAlignment="Center"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    VerticalAlignment="Center"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding EffectiveIconVisible}" />
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[EffectiveVariant=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    VerticalAlignment="Center"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    VerticalAlignment="Center"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding EffectiveIconVisible}" />
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Shared styles start -->

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background"
                                                        atom:TokenTransitions.Duration="StateTransitionDuration" />
                        <atom:SolidColorBrushTransition Property="Foreground"
                                                        atom:TokenTransitions.Duration="StateTransitionDuration" />
                        <atom:SolidColorBrushTransition Property="BorderBrush"
                                                        atom:TokenTransitions.Duration="StateTransitionDuration" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{atom:DropdownButtonTokenResource BorderThickness}" />
        <Setter Property="IsMotionEnabled" Value="{atom:DropdownButtonTokenResource EnableMotion}" />
        <Setter Property="IsInteractionEffectEnabled"
                Value="{atom:DropdownButtonTokenResource EnableInteractionEffect}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^[SizeType=Large]">
            <Setter Property="Height" Value="{atom:DropdownButtonTokenResource ControlHeightLG}" />
            <Setter Property="FontSize" Value="{atom:DropdownButtonTokenResource ContentFontSizeLG}" />
            <Setter Property="CornerRadius" Value="{atom:DropdownButtonTokenResource BorderRadiusLG}" />
            <Setter Property="IconWidth" Value="{atom:DropdownButtonTokenResource IconSizeLG}" />
            <Setter Property="IconHeight" Value="{atom:DropdownButtonTokenResource IconSizeLG}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:DropdownButtonTokenResource ContentPaddingLG}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:DropdownButtonTokenResource IconOnyPaddingLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="Height" Value="{atom:DropdownButtonTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{atom:DropdownButtonTokenResource ContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:DropdownButtonTokenResource BorderRadius}" />
            <Setter Property="IconWidth" Value="{atom:DropdownButtonTokenResource IconSize}" />
            <Setter Property="IconHeight" Value="{atom:DropdownButtonTokenResource IconSize}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:DropdownButtonTokenResource ContentPadding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:DropdownButtonTokenResource IconOnyPadding}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="Height" Value="{atom:DropdownButtonTokenResource ControlHeightSM}" />
            <Setter Property="FontSize" Value="{atom:DropdownButtonTokenResource ContentFontSizeSM}" />
            <Setter Property="CornerRadius" Value="{atom:DropdownButtonTokenResource BorderRadiusSM}" />
            <Setter Property="IconWidth" Value="{atom:DropdownButtonTokenResource IconSizeSM}" />
            <Setter Property="IconHeight" Value="{atom:DropdownButtonTokenResource IconSizeSM}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:DropdownButtonTokenResource ContentPaddingSM}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:DropdownButtonTokenResource IconOnyPaddingSM}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Custom]">
            <Setter Property="Height" Value="{atom:DropdownButtonTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{atom:DropdownButtonTokenResource ContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:DropdownButtonTokenResource BorderRadius}" />
            <Setter Property="IconWidth" Value="{atom:DropdownButtonTokenResource IconSize}" />
            <Setter Property="IconHeight" Value="{atom:DropdownButtonTokenResource IconSize}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:DropdownButtonTokenResource ContentPadding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:DropdownButtonTokenResource IconOnyPadding}" />
            </Style>
        </Style>

        <Style Selector="^:icononly">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon, ^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Margin" Value="0" />
            </Style>
        </Style>

        <Style Selector="^:icononly:loading[SizeType=Large]">
            <Setter Property="IconWidth" Value="{atom:DropdownButtonTokenResource OnlyIconSizeLG}" />
            <Setter Property="IconHeight" Value="{atom:DropdownButtonTokenResource OnlyIconSizeLG}" />
        </Style>
        <Style Selector="^:icononly:loading[SizeType=Middle]">
            <Setter Property="IconWidth" Value="{atom:DropdownButtonTokenResource OnlyIconSize}" />
            <Setter Property="IconHeight" Value="{atom:DropdownButtonTokenResource OnlyIconSize}" />
        </Style>
        <Style Selector="^:icononly:loading[SizeType=Custom]">
            <Setter Property="IconWidth" Value="{atom:DropdownButtonTokenResource OnlyIconSize}" />
            <Setter Property="IconHeight" Value="{atom:DropdownButtonTokenResource OnlyIconSize}" />
        </Style>
        <Style Selector="^:icononly:loading[SizeType=Small]">
            <Setter Property="IconWidth" Value="{atom:DropdownButtonTokenResource OnlyIconSizeSM}" />
            <Setter Property="IconHeight" Value="{atom:DropdownButtonTokenResource OnlyIconSizeSM}" />
        </Style>

        <Style Selector="^[IconPlacement=Start]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="DockPanel.Dock" Value="Left" />
            </Style>
        </Style>

        <Style Selector="^[IconPlacement=End]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="DockPanel.Dock" Value="Right" />
            </Style>
        </Style>

        <Style Selector="^:not(:icononly)">
            <Style
                Selector="^[IconPlacement=Start] /template/ atom|IconPresenter#PART_ButtonIcon, ^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Margin" Value="{atom:DropdownButtonTokenResource IconMargin}" />
            </Style>
            <Style Selector="^[IconPlacement=End] /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="Margin" Value="{atom:DropdownButtonTokenResource IconEndMargin}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:loading">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Setter Property="Opacity" Value="{atom:DropdownButtonTokenResource OpacityLoading}" />
        </Style>

        <Style Selector="^[Shape=Circle]">
            <Setter Property="Padding" Value="{atom:DropdownButtonTokenResource CirclePadding}" />
        </Style>

        <Style Selector="^:disabled[DisablesWithOpacity=False]">
            <Setter Property="Foreground"
                    Value="{atom:DropdownButtonTokenResource ColorTextDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{atom:DropdownButtonTokenResource BorderColorDisabled}" />

            <Setter Property="Background"
                    Value="{atom:DropdownButtonTokenResource ColorBgContainerDisabled}" />
        </Style>
        <Style Selector="^:disabled[DisablesWithOpacity=True]">
            <Setter Property="Opacity" Value="{CompiledBinding $self.ThemeDisabledOpacity}" />
        </Style>
        <!-- Shared styles end -->

        <!-- Color / Variant visual variables start -->
        <Style Selector="^:not(:disabled), ^[DisablesWithOpacity=True]">
            <Setter Property="Foreground"
                    Value="{Binding VariantAppearance.Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Background"
                    Value="{Binding VariantAppearance.Background, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding VariantAppearance.Border, RelativeSource={RelativeSource Self}}" />

            <Style Selector="^:is(atom|Button):pointerover:not(:disabled)">
                <Setter Property="Foreground"
                        Value="{Binding VariantAppearance.TextHover, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantAppearance.BackgroundHover, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantAppearance.BorderHover, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style Selector="^:is(atom|Button):pressed[PressMoves=False]">
                <Setter Property="Foreground"
                        Value="{Binding VariantAppearance.TextPressed, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantAppearance.BackgroundPressed, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantAppearance.BorderPressed, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^:is(atom|Button)[PressMoves=True]:pressed:not(:disabled)">
                <Style Selector="^:pressed-text">
                    <Setter Property="Foreground"
                            Value="{Binding VariantAppearance.TextPressed, RelativeSource={RelativeSource Self}}" />
                </Style>
                <Style Selector="^:pressed-background">
                    <Setter Property="Background"
                            Value="{Binding VariantAppearance.BackgroundPressed, RelativeSource={RelativeSource Self}}" />
                </Style>
                <Style Selector="^:pressed-border">
                    <Setter Property="BorderBrush"
                            Value="{Binding VariantAppearance.BorderPressed, RelativeSource={RelativeSource Self}}" />
                </Style>
            </Style>
        </Style>

        <Style
            Selector="^[EffectiveVariant=Text]:disabled[DisablesWithOpacity=False], ^[EffectiveVariant=Link]:disabled[DisablesWithOpacity=False]">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style
            Selector="^[UnderlinesLinkOnHover=True][EffectiveVariant=Link]:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, ^[EffectiveVariant=Link]:link-underlined /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="documents:Inline.TextDecorations" Value="{x:Static atom:ButtonStyleValues.LinkUnderline}" />
        </Style>

        <Style Selector="^[UsesThemeRecipe=True][EffectiveColor=Default]:not(:disabled)">
            <Style Selector="^:flyout-open, ^[IsExternalPopupOpen=True]">
                <Style Selector="^[EffectiveVariant=Outlined], ^[EffectiveVariant=Text]">
                    <Setter Property="Foreground" Value="{atom:DropdownButtonTokenResource ColorText}" />
                    <Setter Property="Background" Value="{atom:DropdownButtonTokenResource ColorFillContent}" />
                </Style>
                <Style Selector="^:is(atom|Button)[EffectiveVariant=Filled]">
                    <Setter Property="Foreground"
                            Value="{Binding VariantAppearance.Text, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="Background"
                            Value="{Binding VariantAppearance.Background, RelativeSource={RelativeSource Self}}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^ /template/ Border#ShadowsFrame">
            <Setter Property="BoxShadow"
                    Value="{Binding VariantAppearance.Shadow, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
        <!-- Color / Variant visual variables end -->
    </Style>
</ControlTheme>
