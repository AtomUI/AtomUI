<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.InfoPickerInputTheme"
              TargetType="atom:InfoPickerInput">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:InfoPickerInput">
            <Panel>
                <atom:AddOnDecoratedBox
                    Name="{x:Static atom:AddOnDecoratedBox.AddOnDecoratedBoxPart}"
                    Focusable="True"
                    Classes.semantic-scope-input="True"
                    MinWidth="{TemplateBinding MinWidth}"
                    StyleVariant="{TemplateBinding StyleVariant}"
                    SizeType="{TemplateBinding SizeType}"
                    Status="{TemplateBinding Status}"
                    FormStatus="{TemplateBinding FormStatus}"
                    IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                    DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    LeftAddOn="{TemplateBinding LeftAddOn}"
                    LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                    RightAddOn="{TemplateBinding RightAddOn}"
                    RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    ContentLeftAddOnTemplate="{TemplateBinding ContentLeftAddOnTemplate}"
                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                    <atom:AddOnDecoratedBox.ContentLeftAddOn>
                        <atom:AddOnContentPresenter
                            Classes.semantic-prefix="True"
                            Content="{CompiledBinding $parent[atom:InfoPickerInput].ContentLeftAddOn}"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            Focusable="False" />
                    </atom:AddOnDecoratedBox.ContentLeftAddOn>
                    <atom:AddOnDecoratedBox.ContentRightAddOn>
                        <StackPanel Orientation="Horizontal"
                                    Classes.semantic-suffix="True"
                                    Spacing="{atom:SharedTokenResource SpacingXS}">
                            <atom:PickerClearUpButton
                                Name="PART_ClearUpButton"
                                Classes.semantic-scope-handle="True" />
                            <atom:AddOnContentPresenter Name="PART_ContentRightAddOnPresenter" />
                        </StackPanel>
                    </atom:AddOnDecoratedBox.ContentRightAddOn>
                    <atom:InfoPickerTextBox Name="PART_InfoInputBox"
                                          Classes.semantic-input="True"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          TextWrapping="NoWrap"
                                          AcceptsReturn="False"
                                          Width="{TemplateBinding PreferredInputWidth}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontStyle="{TemplateBinding FontStyle}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Text="{TemplateBinding Text}"
                                          PlaceholderText="{TemplateBinding PlaceholderText}"
                                          DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                                          IsReadOnly="{TemplateBinding IsReadOnly}" />
                </atom:AddOnDecoratedBox>

                <atom:Popup Name="PART_Popup"
                            WindowManagerAddShadowHint="False"
                            IsLightDismissEnabled="True"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                            ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                            RequestedPlacement="{TemplateBinding PickerPlacement}"
                            IsPointAtCenter="{TemplateBinding IsPointAtCenter}"
                            IsHorizontalFlipped="{TemplateBinding IsPopupHorizontalFlipped, Mode=TwoWay}"
                            IsVerticalFlipped="{TemplateBinding IsPopupVerticalFlipped, Mode=TwoWay}"
                            MarginToAnchor="{TemplateBinding MarginToAnchor}">
                    <atom:ArrowDecoratedBox Classes.semantic-popup-root="True"
                                            Content="{TemplateBinding PickerPresenter}"
                                            IsArrowVisible="{TemplateBinding IsArrowVisibleEffective}"
                                            ArrowPosition="{TemplateBinding ArrowPosition}"
                                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"/>
                </atom:Popup>
            </Panel>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|InfoPickerInput)">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsArrowVisible" Value="True" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="MarginToAnchor" Value="{atom:PopupTokenResource MarginToAnchor}" />
        <Setter Property="ShouldUseOverlayPopup" Value="True" />
        
        <Style Selector="^:flyout-open">
            <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_InfoInputBox">
                <Setter Property="Foreground"
                        Value="{atom:SharedTokenResource ColorTextTertiary}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ atom|InfoPickerTextBox">
                <Setter Property="Foreground"
                        Value="{atom:SharedTokenResource ColorTextDisabled}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeLG}" />
            <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_InfoInputBox">
                <Setter Property="MaxHeight" Value="{atom:SharedTokenResource FontHeightLG}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_InfoInputBox">
                <Setter Property="MaxHeight" Value="{atom:SharedTokenResource FontHeight}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
            <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_InfoInputBox">
                <Setter Property="MaxHeight" Value="{atom:SharedTokenResource FontHeightSM}" />
            </Style>
        </Style>

    </Style>

</ControlTheme>
