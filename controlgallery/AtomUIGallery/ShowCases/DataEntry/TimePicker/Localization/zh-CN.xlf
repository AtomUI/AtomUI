    <unit id="PageDescription">
      <segment>
        <source>TimePicker supports 12-hour and 24-hour clocks, size variants, disabled states, stepped minute and second options, visual variants, validation status, and range selection.</source>
        <target state="translated">TimePicker 支持 12 小时和 24 小时制、尺寸变体、禁用状态、分钟和秒的步进选项、视觉变体、校验状态以及范围选择。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Select a time or a time range from a popup time panel.</source>
        <target state="translated">从弹出时间面板中选择单个时间或时间范围。</target>
      </segment>
    </unit>
    <unit id="PickerDisplayTimeDescription">
      <segment>
        <source>Open the popup panel at a specific display time without committing a selected value.</source>
        <target state="translated">打开弹出面板时定位到指定时间，但不提交选中值。</target>
      </segment>
    </unit>
    <unit id="PickerDisplayTimeTitle">
      <segment>
        <source>Popup display time</source>
        <target state="translated">弹出面板显示时间</target>
      </segment>
