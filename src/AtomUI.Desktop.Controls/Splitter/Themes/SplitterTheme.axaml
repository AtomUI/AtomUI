<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Splitter}" TargetType="atom:Splitter">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         StrokeDashArray="{TemplateBinding BorderDashArray}"
                                         StrokeDaskOffset="{TemplateBinding BorderDashOffset}">
                    <atom:SplitterPanel Name="PART_SplitterPanel"
                                        Classes.semantic-scope-panel="True"
                                        HandleSize="{TemplateBinding HandleSize}" 
                                        LineThickness="{TemplateBinding LineThickness}"
                                        LineCornerRadius="{TemplateBinding LineCornerRadius}"
                                        Orientation="{TemplateBinding Orientation}"
                                        IsLazy="{TemplateBinding IsLazy}"
                                        CollapsePreviousIcon="{TemplateBinding CollapsePreviousIcon}"
                                        CollapseNextIcon="{TemplateBinding CollapseNextIcon}"/>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HandleSize" Value="{atom:SplitterTokenResource SplitBarHandleSize}" />
        <Setter Property="LineThickness" Value="{atom:SplitterTokenResource HandleLineThickness}" />
        <Setter Property="LineCornerRadius" Value="{atom:SharedTokenResource BorderRadiusXS}" />
    </ControlTheme>
</ResourceDictionary>
