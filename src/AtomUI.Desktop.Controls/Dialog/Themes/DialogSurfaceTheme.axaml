<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:DialogSurface}" TargetType="atom:DialogSurface">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}" />
        <Setter Property="ContentViewportMinWidth" Value="{CompiledBinding $self.(atom:DialogSurface.DefaultViewportMinWidth)}" />
        <Setter Property="ContentViewportMinHeight" Value="{CompiledBinding $self.(atom:DialogSurface.DefaultViewportMinHeight)}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:DialogSurface">
                <Panel>
                    <atom:ShadowsAwareContainer Name="PART_ShadowHost"
                                                Classes.semantic-scope-frame-host="True"
                                                IsOverlayMode="True">
                        <Border Name="Frame"
                                Classes.semantic-container="True"
                                ClipToBounds="True">
                            <DockPanel Name="PART_SurfaceContentLayer"
                                       Classes.semantic-scope-content-layer="True"
                                       LastChildFill="True">
                                <atom:OverlayDialogHeader Name="PART_Header"
                                                          Classes.semantic-scope-header="True"
                                                          DockPanel.Dock="Top"
                                                          IsVisible="{TemplateBinding IsHeaderVisible}"
                                                          Title="{TemplateBinding Title}"
                                                          Logo="{TemplateBinding TitleIcon}"
                                                          IsCloseButtonEnabled="{TemplateBinding IsClosable}"
                                                          IsMaximizeButtonEnabled="{TemplateBinding IsMaximizable}"
                                                          IsDialogMaximized="{TemplateBinding IsDialogMaximized}"
                                                          IsMotionEnabled="{TemplateBinding IsMotionEnabled}" />
                                <Border Name="FooterFrame"
                                        Classes.semantic-footer="True"
                                        DockPanel.Dock="Bottom"
                                        IsVisible="{TemplateBinding IsEffectiveFooterVisible}">
                                    <atom:DialogButtonBox Name="PART_ButtonBox"
                                                          IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                          StandardButtons="{TemplateBinding StandardButtons}"
                                                          DefaultStandardButton="{TemplateBinding DefaultStandardButton}"
                                                          EscapeStandardButton="{TemplateBinding EscapeStandardButton}" />
                                </Border>
                                <Border Name="ContentFrame"
                                        Classes.semantic-body="True"
                                        ClipToBounds="True">
                                    <atom:Skeleton IsLoading="{TemplateBinding IsLoading}"
                                                   IsActive="True"
                                                   ParagraphRows="4"
                                                   IsShowTitle="False"
                                                   ClipToBounds="False"
                                                   Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Border>
                            </DockPanel>
                        </Border>
                    </atom:ShadowsAwareContainer>
                    <atom:OverlayDialogResizer Name="PART_Resizer"
                                               IsVisible="{TemplateBinding IsResizable}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The background and corner radius of container must go through ControlTheme styles, not local template
        values: a local value outranks any style setter, so DialogContainerStyle (the instance-level semantic style
        of the owner) could never override them. CornerRadius is bound through TemplatedParent so that it keeps
        following runtime changes of Surface, such as zeroing on maximize.
        -->
        <Style Selector="^ /template/ Border#Frame">
            <Setter Property="Background" Value="{CompiledBinding $self.(atom:DialogSurface.ContentBackground)}" />
            <Setter Property="CornerRadius"
                    Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>

        <Style Selector="^ /template/ atom|OverlayDialogHeader#PART_Header">
            <Setter Property="TitleFontSize" Value="{CompiledBinding $self.(atom:DialogSurface.HeaderFontSize)}" />
            <Setter Property="TitleFontWeight" Value="{atom:OwnerTokenResource FontWeightStrong}" />
            <Setter Property="Margin" Value="{CompiledBinding $self.(atom:DialogSurface.HeaderBottomMargin)}" />
        </Style>

        <Style Selector="^.overlay-hosted /template/ atom|ShadowsAwareContainer#PART_ShadowHost">
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource BoxShadows}" />
        </Style>

        <Style Selector="^.window-hosted">
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- A maximized overlay surface fills the host without rounded corners. -->
        <Style Selector="^[IsDialogMaximized=True]">
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="^ /template/ Border#ContentFrame">
            <Setter Property="Padding" Value="{CompiledBinding $self.(atom:DialogSurface.ContentPadding)}" />
        </Style>

        <!-- Window host hides the Overlay header because the native window owns the title bar.
             Keep the body vertically separated from that title bar and preserve the same
             horizontal content inset used by the Overlay host. -->
        <Style Selector="^.window-hosted /template/ Border#ContentFrame">
            <Setter Property="Padding" Value="{CompiledBinding $self.(atom:DialogSurface.WindowContentPadding)}" />
        </Style>

        <Style Selector="^ /template/ atom|Skeleton">
            <Setter Property="Margin" Value="{CompiledBinding $self.(atom:DialogSurface.LoadingIndicatorMargin)}" />
        </Style>

        <Style Selector="^ /template/ Border#FooterFrame">
            <Setter Property="Background" Value="{CompiledBinding $self.(atom:DialogSurface.FooterBackground)}" />
            <Setter Property="Margin" Value="{CompiledBinding $self.(atom:DialogSurface.FooterTopMargin)}" />
            <Setter Property="Padding" Value="{CompiledBinding $self.(atom:DialogSurface.FooterPadding)}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
