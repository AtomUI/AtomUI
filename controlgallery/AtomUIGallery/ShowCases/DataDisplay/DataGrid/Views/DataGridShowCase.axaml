                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderGender}" FieldId="{x:Static vm:DataGridShowCaseFields.Gender}" Binding="{Binding Gender}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderEmail}" FieldId="{x:Static vm:DataGridShowCaseFields.Email}" Binding="{Binding Email}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn1}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn2}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn3}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn4}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn5}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn6}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn7}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn8}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn9}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>

            <atom:Separator Title="{gallery:DataGridShowCaseLangResource P2TitleDragReorderWithFrozenColumns}" TitlePosition="Left" Margin="0, 20, 0, 0"
                            FontWeight="Bold" />
            <atom:DataGrid x:Name="DragColumnDataGrid3"
                           CanUserReorderColumns="True"
                           LeftFrozenColumnCount="2"
                           RightFrozenColumnCount="2"
                           x:DataType="vm:DragColumnDataType"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderGender}" FieldId="{x:Static vm:DataGridShowCaseFields.Gender}" Binding="{Binding Gender}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderEmail}" FieldId="{x:Static vm:DataGridShowCaseFields.Email}" Binding="{Binding Email}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn1}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn2}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn3}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn4}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn5}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn6}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn7}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn8}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderColumn9}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource DragSortingWithHandlerTitle}"
                          Description="{gallery:DataGridShowCaseLangResource DragSortingWithHandlerDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Separator Title="{gallery:DataGridShowCaseLangResource P2TitleNormal}" TitlePosition="Left"
                            FontWeight="Bold" />
            <atom:DataGrid x:Name="DragRowDataGrid1"
                           CanUserReorderRows="True"
                           x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridRowReorderColumn />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>

            <atom:Separator Title="{gallery:DataGridShowCaseLangResource P2TitleNormal}" TitlePosition="Left"
                            FontWeight="Bold"
                            Margin="0, 20, 0, 0" />
            <atom:DataGrid x:Name="DragRowDataGrid2"
                           CanUserReorderRows="True"
                           Height="400"
                           x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridRowReorderColumn />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource CustomEmptyAndLoadingTitle}"
                          Description="{gallery:DataGridShowCaseLangResource CustomEmptyAndLoadingDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Button ButtonType="Primary" Click="HandleToggleEmptyGridSource" Content="{gallery:DataGridShowCaseLangResource P2ContentToggleData}" />
                <atom:Button ButtonType="Primary" Click="HandleToggleLoadingState" Content="{gallery:DataGridShowCaseLangResource P2ContentToggleLoading}" />
            </StackPanel>
            <atom:DataGrid x:Name="CustomEmptyDataGrid"
                           CanUserReorderRows="True"
                           x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource EditableCellsTitle}"
                          Description="{gallery:DataGridShowCaseLangResource EditableCellsDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <StackPanel Spacing="10">
            <atom:Button ButtonType="Primary" Click="HandleAddARowToCellsEditableGrid" Content="{gallery:DataGridShowCaseLangResource P2ContentAddARow}" />
            <atom:DataGrid x:Name="EditableCellsDataGrid"
                                   x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridNumericColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" FormatString="0" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAction}">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="15">
                                    <atom:PopupConfirm
                                        Title="{gallery:DataGridShowCaseLangResource P2TitleSureToDelete}"
                                        Confirmed="HandleRemoveRowCellsEditableGrid"
                                        DataContext="{Binding Index, RelativeSource={RelativeSource AncestorType=atom:DataGridRow}}">
                                        <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextDelete}" />
                                    </atom:PopupConfirm>
                                </StackPanel>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource BasicPagingTitle}"
                          Description="{gallery:DataGridShowCaseLangResource BasicPagingDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <StackPanel Spacing="20">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:TextBlock Width="180" VerticalAlignment="Center" Text="{gallery:DataGridShowCaseLangResource P2TextPaginationvisibility}" />
                    <atom:CheckBox Name="ShowTopPaginationCheckBox" IsCheckedChanged="HandleShowTopPaginationCheckBoxChanged" Content="{gallery:DataGridShowCaseLangResource P2ContentTopPagination}" />
                    <atom:CheckBox Name="ShowBottomPaginationCheckBox" IsCheckedChanged="HandleShowBottomPaginationCheckBoxChanged" IsChecked="True" Content="{gallery:DataGridShowCaseLangResource P2ContentBottomPagination}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:TextBlock Width="180" VerticalAlignment="Center" Text="{gallery:DataGridShowCaseLangResource P2TextTopPaginationAlign}" />
                    <atom:OptionButtonGroup ButtonStyle="Solid" Name="TopPaginationOptionGroup" OptionCheckedChanged="HandleTopPaginationAlignChanged">
                        <atom:OptionButton Content="{gallery:DataGridShowCaseLangResource P2ContentStart}" />
                        <atom:OptionButton Content="{gallery:DataGridShowCaseLangResource P2ContentCenter}" />
                        <atom:OptionButton IsChecked="True" Content="{gallery:DataGridShowCaseLangResource P2ContentEnd}" />
                    </atom:OptionButtonGroup>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:TextBlock Width="180" VerticalAlignment="Center" Text="{gallery:DataGridShowCaseLangResource P2TextBottomPaginationAlign}" />
                    <atom:OptionButtonGroup ButtonStyle="Solid" Name="BottomPaginationOptionGroup" OptionCheckedChanged="HandleBottomPaginationAlignChanged">
                        <atom:OptionButton Content="{gallery:DataGridShowCaseLangResource P2ContentStart}" />
                        <atom:OptionButton Content="{gallery:DataGridShowCaseLangResource P2ContentCenter}" />
                        <atom:OptionButton IsChecked="True" Content="{gallery:DataGridShowCaseLangResource P2ContentEnd}" />
                    </atom:OptionButtonGroup>
                </StackPanel>

            </StackPanel>
            <atom:DataGrid x:Name="BasicPagingCaseGrid" Height="400" PaginationVisibility="Bottom"
                           IsShowPageSizeSelector="True"
                           PageSize="10"
                           x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.BottomPaginationExtraContent>
                    <atom:Button Content="{gallery:DataGridShowCaseLangResource BasicPagingExtraContentText}" />
                </atom:DataGrid.BottomPaginationExtraContent>
                <atom:DataGrid.Columns>
                    <atom:DataGridTemplateColumn MinWidth="170" Header="{gallery:DataGridShowCaseLangResource P2HeaderName}">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:DataGridBaseInfo">
                                <atom:HyperLinkTextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTextColumn MinWidth="64" Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                    <atom:DataGridTextColumn MinWidth="280" Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTemplateColumn MinWidth="300" Header="{gallery:DataGridShowCaseLangResource P2HeaderTags}">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:DataGridBaseInfo">
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagInfo">
                                            <atom:Tag Text="{Binding Name}" TagColor="{Binding Color}"></atom:Tag>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn MinWidth="220" Header="{gallery:DataGridShowCaseLangResource P2HeaderAction}">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="15">
                                    <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextInvite}" />
                                    <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextModify}" />
                                    <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextDelete}" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource RemoteRangeTitle}"
                          Description="{gallery:DataGridShowCaseLangResource RemoteRangeDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Button ButtonType="Primary"
                             Click="HandleReloadRemoteRangeSource"
                             Content="{gallery:DataGridShowCaseLangResource RemoteRangeReload}" />
                <atom:Button Click="HandleFailRemoteRangeSource"
                             Content="{gallery:DataGridShowCaseLangResource RemoteRangeFailNext}" />
                <atom:Button Click="HandleExpireRemoteRangeSnapshot"
                             Content="{gallery:DataGridShowCaseLangResource RemoteRangeExpireSnapshot}" />
            </StackPanel>
            <atom:DataGrid x:Name="RemoteRangeDataGrid"
                           Height="400"
                           x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Name}"
                                             Binding="{Binding Name}" />
                    <atom:DataGridNumericColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}"
                                                FieldId="{x:Static vm:DataGridShowCaseFields.Age}"
                                                Binding="{Binding Age}"
                                                FormatString="0" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Address}"
                                             Binding="{Binding Address}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource SemanticPartStyleTitle}"
                                      Description="{gallery:DataGridShowCaseLangResource SemanticPartStyleDescription}"
                                      SourceKey="datagrid-semantic-part"
                                      BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridBaseInfo">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Spacing="12">
                                <StackPanel.Styles>
                                    <Style Selector="atom|DataGrid.semantic-info-table-demo">
                                        <Setter Property="IsFrameBorderVisible" Value="True" />
                                        <atom:DataGridTitleStyle x:SetterTargetType="atom:PixelAlignedBorder">
                                            <Setter Property="Background" Value="#E6F4FF" />
                                        </atom:DataGridTitleStyle>
                                        <atom:DataGridHeaderWrapperStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="#E6F4FF" />
                                        </atom:DataGridHeaderWrapperStyle>
                                        <atom:DataGridHeaderCellStyle x:SetterTargetType="ContentControl">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="#0958D9" />
                                        </atom:DataGridHeaderCellStyle>
                                        <atom:DataGridBodyRowStyle x:SetterTargetType="TemplatedControl">
                                            <Setter Property="Foreground" Value="#003EB3" />
                                        </atom:DataGridBodyRowStyle>
                                        <atom:DataGridBodyCellStyle x:SetterTargetType="atom:DataGridCell">
                                            <Setter Property="Foreground" Value="#003EB3" />
                                        </atom:DataGridBodyCellStyle>
                                        <atom:DataGridFooterStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#0958D9" />
                                        </atom:DataGridFooterStyle>
                                        <atom:DataGridPaginationRootStyle x:SetterTargetType="atom:Pagination">
                                            <Setter Property="Foreground" Value="#0958D9" />
                                        </atom:DataGridPaginationRootStyle>
                                        <atom:DataGridPaginationItemStyle x:SetterTargetType="ContentControl">
                                            <Setter Property="Foreground" Value="#003EB3" />
                                        </atom:DataGridPaginationItemStyle>
                                    </Style>
                                    <Style Selector="atom|DataGrid.semantic-alert-table-demo">
                                        <Setter Property="IsFrameBorderVisible" Value="True" />
                                        <atom:DataGridSectionStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="#FFFBE6" />
                                        </atom:DataGridSectionStyle>
                                        <atom:DataGridContentStyle x:SetterTargetType="Grid">
                                            <Setter Property="Background" Value="#FFF1F0" />
                                        </atom:DataGridContentStyle>
                                        <atom:DataGridHeaderCellStyle x:SetterTargetType="ContentControl">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="#D46B08" />
                                        </atom:DataGridHeaderCellStyle>
                                        <atom:DataGridBodyRowStyle x:SetterTargetType="TemplatedControl">
                                            <Setter Property="Foreground" Value="#873800" />
                                        </atom:DataGridBodyRowStyle>
                                        <atom:DataGridBodyCellStyle x:SetterTargetType="atom:DataGridCell">
                                            <Setter Property="Foreground" Value="#873800" />
                                        </atom:DataGridBodyCellStyle>
                                        <atom:DataGridTitleStyle x:SetterTargetType="atom:PixelAlignedBorder">
                                            <Setter Property="Background" Value="#FFF1F0" />
                                        </atom:DataGridTitleStyle>
                                    </Style>
                                </StackPanel.Styles>

                                <!-- 对齐上游 style-class 演示的两张卡:4 列 + title/footer + pageSize 3,自然高度不裁剪 -->
                                <atom:DataGrid x:Name="SemanticStyleCaseGridA"
                                               x:DataType="vm:ExpandableRowDataType"
                                               Classes="semantic-info-table-demo"
                                               SizeType="Small"
                                               PageSize="3"
                                               IsHideOnSinglePage="True"
                                               Title="{gallery:DataGridShowCaseLangResource SemanticPreviewTitleText}"
                                               Footer="{gallery:DataGridShowCaseLangResource SemanticPreviewFooterText}"
                                               AttachedToVisualTree="HandleExampleDataGridAttached">
                                    <atom:DataGrid.Columns>
                                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderDescription}" FieldId="{x:Static vm:DataGridShowCaseFields.Description}" Binding="{Binding Description}" />
                                    </atom:DataGrid.Columns>
                                </atom:DataGrid>
                                <atom:DataGrid x:Name="SemanticStyleCaseGridB"
                                               x:DataType="vm:ExpandableRowDataType"
                                               Classes="semantic-alert-table-demo"
                                               PageSize="3"
                                               IsHideOnSinglePage="True"
                                               Title="{gallery:DataGridShowCaseLangResource SemanticPreviewTitleText}"
                                               Footer="{gallery:DataGridShowCaseLangResource SemanticPreviewFooterText}"
                                               AttachedToVisualTree="HandleExampleDataGridAttached">
                                    <atom:DataGrid.Columns>
                                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderDescription}" FieldId="{x:Static vm:DataGridShowCaseFields.Description}" Binding="{Binding Description}" />
                                    </atom:DataGrid.Columns>
                                </atom:DataGrid>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
