# Theme consumption analyzers are errors for control families whose migration is complete
# (docs/engineering/development/control-token-guidelines.md, "诊断与启动校验"). Other families keep the
# migration-time warning severity until their own migration finishes. Section globs are relative to this file.

# Button family: Button, HyperLinkButton, IconButton, ToggleIconButton, DropdownButton, SplitButton,
# FloatButton (FloatButtonGroup, BackTop and hosts), OptionButton and OptionButtonGroup.
[{Buttons,DropdownButton,SplitButton,FloatButton,OptionButtonGroup}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Input family: TextBox, LineEdit, SearchEdit, TextArea, ButtonSpinner, NumericUpDown, AutoComplete
# (AutoCompleteSearchEdit, AutoCompleteTextArea) and the shared InputControlFrame / AddOnDecoratedBox primitives.
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{Input,ButtonSpinner,NumericUpDown,AutoComplete,Primitives/AddOnDecoratedBox}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

[Primitives/InputControlFrame.cs]
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Select family: Select, ComboBox (ComboBoxItem), Cascader (CascaderView, CascaderViewItem), TreeSelect and their
# identity-less parts (decorated boxes, handles, option items, filter / tag boxes).
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{Select,ComboBox,Cascader,TreeSelect}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Choice family: CheckBox (CheckBoxGroup), RadioButton (RadioButtonGroup), ToggleSwitch, Slider (SliderTrack, SliderThumb)
# and Rate. Their identity-less parts (indicators, SwitchKnob, RateItem) live in src/AtomUI.Controls, gated by its
# .editorconfig. Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{CheckBox,RadioButton,Switch,Slider,Rate}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Steps / Progress family: Steps (StepsItem and its identity-less parts), ProgressBar, StepsProgressBar, CircleProgress and
# DashboardProgress. The shared abstract progress bases live in src/AtomUI.Controls/ProgressBar, gated by its .editorconfig.
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{ProgressBar,Steps}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Tag / Badge family: Tag, CheckableTag, CheckableTagGroup (CheckableTagItemsControl), CountBadge, DotBadge and RibbonBadge
# with their identity-less indicators (adorners, DotBadgeIndicator theme). The shared abstract bases live in
# src/AtomUI.Controls/{Tag,Badge}, gated by its .editorconfig.
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{Tag,Badge}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Feedback family: Alert, Popup (Token-owner transparent; OverlayPopupHost / PopupRoot themes), ToolTip, Dialog (DialogButtonBox
# and the identity-less surface parts), MessageBox, MessageCard / WindowMessageManager, NotificationCard /
# WindowNotificationManager and PopupConfirm (PopupConfirmContainer).
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{Alert,Popup,Tooltip,Dialog,MessageBox,Message,Notifications,PopupConfirm}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Navigation family: NavMenu (identity-less items, groups, dividers, popup frame and vertical header; the horizontal and
# inline headers are registered and Token-owner transparent), Menu (MenuItem, MenuItemGroup, MenuSeparator, ContextMenu,
# MenuPopupScrollHost) and the MenuFlyoutPresenter of drop-down flyouts (its theme lives in Flyouts/Themes).
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{NavMenu,Menu}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

[Flyouts/{MenuFlyoutPresenter.cs,Themes/MenuFlyoutPresenterTheme.cs}]
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error
