<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <!--
        我们需要在这个切换按钮显示几种状态的图标
        1、展开和收缩两种状态的图标
        2、只设置一个图标，展开和收缩通过旋转开表示
        3、当节点是叶子节点的时候，没有展开和收缩的概念，直接显示叶子节点的图标
        4、加载状态的图标
    -->
    <ControlTheme x:Key="{x:Type atom:NodeSwitcherButton}" TargetType="atom:NodeSwitcherButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="RootLayout"
                       IsHitTestVisible="False">
                    <atom:IconPresenter Name="CurrentIconPresenter"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransform="{TemplateBinding RotationIconRenderTransform}"
                                        Icon="{TemplateBinding CurrentIcon}"
                                        Width="{TemplateBinding IconSize}"
                                        Height="{TemplateBinding IconSize}"
                                        IconBrush="{TemplateBinding IconBrush}"
                                        IsVisible="{TemplateBinding IsCurrentIconVisible}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}"/>

        <!-- The icon size and brush are read on the switcher (the tree is its owner) and bound down to the registered
             IconPresenter. The switcher icon takes the node text colour, as in antd. -->
        <Setter Property="IconSize" Value="{atom:OwnerTokenResource IconSize}"/>
        <Setter Property="IconBrush" Value="{atom:OwnerTokenResource ColorText}"/>

        <Style Selector="^[IconMode=Rotation]">
            <Setter Property="IconSize" Value="{atom:OwnerTokenResource IconSizeXS}"/>
        </Style>

        <Style Selector="^[IconMode=Loading]">
            <Setter Property="IconBrush" Value="{atom:OwnerTokenResource ColorPrimary}"/>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="IconBrush" Value="{atom:OwnerTokenResource ColorTextDisabled}"/>
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{atom:TreeViewTokenResource NodeHoverBg}"/>
        </Style>

        <Style Selector="^:checked[IconMode=Rotation]">
            <Setter Property="RotationIconRenderTransform" Value="rotate(90deg)"/>
        </Style>
        
        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <TransformOperationsTransition Property="RotationIconRenderTransform" atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
