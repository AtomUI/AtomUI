<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Alert}" TargetType="atom:Alert">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.ForegroundConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedForeground" />
                <atom:OwnerTokenResource Kind="ColorText" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="ColorText" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         StrokeDashArray="{TemplateBinding StrokeDashArray}"
                                         Padding="{TemplateBinding Padding}">
                    <DockPanel Name="RootLayout" LastChildFill="True">
                        <Panel IsVisible="{TemplateBinding IsShowIcon}"
                               DockPanel.Dock="Left">
                            <antdicons:CheckCircleFilled Name="SuccessIcon"
                                                         Classes.semantic-icon="True"
                                                         FillBrush="{atom:OwnerTokenResource ColorSuccess, SourceControlType={x:Type atom:Alert}, Priority=Template}"
                                                         IsVisible="False"/>
                            <antdicons:InfoCircleFilled Name="InfoIcon"
                                                        Classes.semantic-icon="True"
                                                        FillBrush="{atom:OwnerTokenResource ColorPrimary, SourceControlType={x:Type atom:Alert}, Priority=Template}"
                                                        IsVisible="False"/>
                            <antdicons:ExclamationCircleFilled Name="WarningIcon"
                                                               Classes.semantic-icon="True"
                                                               FillBrush="{atom:OwnerTokenResource ColorWarning, SourceControlType={x:Type atom:Alert}, Priority=Template}"
                                                               IsVisible="False"/>
                            <antdicons:CloseCircleFilled Name="ErrorIcon"
                                                         Classes.semantic-icon="True"
                                                         FillBrush="{atom:OwnerTokenResource ColorError, SourceControlType={x:Type atom:Alert}, Priority=Template}"
                                                         IsVisible="False"/>
                        </Panel>
                        
                        <atom:IconButton
                            Name="PART_CloseBtn"
                            Classes.semantic-close="True"
                            IsVisible="{TemplateBinding IsClosable}"
                            Icon="{TemplateBinding CloseIcon}"
                            DockPanel.Dock="Right" />
                        <ContentPresenter Name="ExtraActionPresenter"
                                          Classes.semantic-actions="True"
                                          DockPanel.Dock="Right" 
                                          IsVisible="{TemplateBinding ExtraAction, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          Content="{TemplateBinding ExtraAction}" />
                        <StackPanel Orientation="Vertical"
                                    Classes.semantic-section="True"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True">
                            <Label Name="MessageLabel"
                                   Classes.semantic-title="True"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   VerticalContentAlignment="Center"
                                   Padding="0"
                                   TextBlock.TextWrapping="Wrap"
                                   Content="{TemplateBinding Message}" />
                            <atom:MarqueeLabel
                                Name="MarqueeLabel"
                                Classes.semantic-title="True"
                                HorizontalAlignment="Stretch"
                                Padding="0"
                                IsVisible="{TemplateBinding IsMessageMarqueeEnabled}"
                                Text="{TemplateBinding Message}" />
                            <Label Name="DescriptionLabel"
                                   Classes.semantic-description="True"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   VerticalContentAlignment="Center"
                                   Padding="0"
                                   IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextBlock.TextWrapping="Wrap"
                                   Content="{TemplateBinding Description}" />
                        </StackPanel>
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG, SourceControlType={x:Type atom:Alert}}" />
        
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness, SourceControlType={x:Type atom:Alert}}" />
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        
        <Style Selector="^ /template/ DockPanel#RootLayout">
            <Setter Property="HorizontalSpacing" Value="{atom:OwnerTokenResource SpacingXXS, SourceControlType={x:Type atom:Alert}}" />
        </Style>
 
        <Style Selector="^[Type=Success]">
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorSuccessBg, SourceControlType={x:Type atom:Alert}}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorSuccessBorder, SourceControlType={x:Type atom:Alert}}" />
        </Style>

        <Style Selector="^[Type=Info]">
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorInfoBg, SourceControlType={x:Type atom:Alert}}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorInfoBorder, SourceControlType={x:Type atom:Alert}}" />
        </Style>

        <Style Selector="^[Type=Warning]">
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorWarningBg, SourceControlType={x:Type atom:Alert}}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorWarningBorder, SourceControlType={x:Type atom:Alert}}" />
        </Style>

        <Style Selector="^[Type=Error]">
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorErrorBg, SourceControlType={x:Type atom:Alert}}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorErrorBorder, SourceControlType={x:Type atom:Alert}}" />
        </Style>

        <Style Selector="^:not(:has-description)">
            <Setter Property="Padding" Value="{atom:AlertTokenResource DefaultPadding}" />
        </Style>

        <Style Selector="^:has-description">
            <Setter Property="Padding" Value="{atom:AlertTokenResource WithDescriptionPadding}" />
        </Style>
        
        <Style Selector="^:has-description">
            <Style Selector="^ /template/ Label#MessageLabel, ^ /template/ atom|MarqueeLabel#MarqueeLabel">
                <Setter Property="TemplatedControl.FontSize"
                        Value="{atom:OwnerTokenResource FontSizeLG, SourceControlType={x:Type atom:Alert}}" />
                <Setter Property="Margin" Value="{atom:AlertTokenResource MessageWithDescriptionMargin, WhenExplicit=True}" />
                <Setter Property="TemplatedControl.VerticalAlignment" Value="Top" />
            </Style>
        </Style>
        <Style Selector="^:not(:has-description)">
            <Style Selector="^ /template/ Label#MessageLabel, ^ /template/ atom|MarqueeLabel#MarqueeLabel">
                <Setter Property="TemplatedControl.FontSize"
                        Value="{atom:OwnerTokenResource FontSize, SourceControlType={x:Type atom:Alert}}" />
                <Setter Property="TemplatedControl.VerticalAlignment" Value="Stretch" />
            </Style>
        </Style>
        <Style Selector="^ /template/ Label#MessageLabel">
            <Setter Property="TextBox.LineHeight" Value="{atom:OwnerTokenResource FontHeight, SourceControlType={x:Type atom:Alert}}" />
        </Style>
         <!-- 根据是否显示 MarqueeLabel 是指对应的样式 -->
         <Style Selector="^[IsMessageMarqueeEnabled=True]">
             <Style Selector="^ /template/ Label#MessageLabel">
                 <Setter Property="IsVisible" Value="False" />
             </Style>
         </Style>
        
        <Style Selector="^ /template/ Label#DescriptionLabel">
            <Setter Property="TextBox.LineHeight" Value="{atom:OwnerTokenResource FontHeight, SourceControlType={x:Type atom:Alert}}" />
            <Setter Property="Margin" Value="{atom:AlertTokenResource DescriptionLabelMargin}" />
        </Style>
 
        <Style Selector="^:has-description">
            <Style Selector="^ /template/ atom|IconButton#PART_CloseBtn">
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^:not(:has-description)">
            <Style Selector="^ /template/ atom|IconButton#PART_CloseBtn">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>
        <Style Selector="^ /template/ atom|IconButton#PART_CloseBtn">
            <!-- Optional double presence preserves the original glyph default. -->
            <Setter Property="IconWidth">
                <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                    <atom:OwnerTokenResource Kind="IconSizeSM" SourceControlType="{x:Type atom:Alert}" />
                    <atom:AlertTokenResource Kind="CloseIconSize" WhenExplicit="True" />
                    <atom:AlertTokenResource Kind="CloseIconSize" />
                </MultiBinding>
            </Setter>
            <!-- Optional double presence preserves the original glyph default. -->
            <Setter Property="IconHeight">
                <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                    <atom:OwnerTokenResource Kind="IconSizeSM" SourceControlType="{x:Type atom:Alert}" />
                    <atom:AlertTokenResource Kind="CloseIconSize" WhenExplicit="True" />
                    <atom:AlertTokenResource Kind="CloseIconSize" />
                </MultiBinding>
            </Setter>
            <Setter Property="Margin" Value="{atom:AlertTokenResource ExtraElementMargin}" />
        </Style>

        <Style Selector="^[Type=Success]">
            <Style Selector="^ /template/ atom|Icon#SuccessIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[Type=Info]">
            <Style Selector="^ /template/ atom|Icon#InfoIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[Type=Warning]">
            <Style Selector="^ /template/ atom|Icon#WarningIcon">
                <Setter Property="IsVisible" Value="True" /> 
            </Style>
        </Style>

        <Style Selector="^[Type=Error]">
            <Style Selector="^ /template/ atom|Icon#ErrorIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="^:has-description">
            <Style Selector="^ /template/ atom|Icon">
                <Setter Property="Width"
                        Value="{atom:AlertTokenResource WithDescriptionIconSize}" />
                <Setter Property="Height"
                        Value="{atom:AlertTokenResource WithDescriptionIconSize}" />
                <Setter Property="Margin"
                        Value="{atom:AlertTokenResource IconWithDescriptionMargin}" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^:not(:has-description)">
            <Style Selector="^ /template/ atom|Icon">
                <Setter Property="Width" Value="{atom:AlertTokenResource DefaultIconSize}" />
                <Setter Property="Height" Value="{atom:AlertTokenResource DefaultIconSize}" />
                <Setter Property="Margin" Value="{atom:AlertTokenResource IconDefaultMargin}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
