  <file id="AtomUIGallery.Localization.SpinShowCaseLangResourceKind">
    <unit id="BasicUsageDescription">
      <segment>
        <source>A simple loading status.</source>
        <target state="translated">簡單的加載狀態。</target>
      </segment>
    </unit>
    <unit id="BasicUsageTitle">
      <segment>
        <source>Basic Usage</source>
        <target state="translated">基礎用法</target>
      </segment>
    </unit>
    <unit id="ComponentCategory">
      <segment>
        <source>Feedback</source>
        <target state="translated">反饋</target>
      </segment>
    </unit>
    <unit id="ComponentStatusStable">
      <segment>
        <source>.NET 10</source>
        <target state="translated">.NET 10</target>
      </segment>
    </unit>
    <unit id="CustomIndicatorDescription">
      <segment>
        <source>Use custom loading indicator.</source>
        <target state="translated">使用自定義加載指示器。</target>
      </segment>
    </unit>
    <unit id="CustomIndicatorTitle">
      <segment>
        <source>Custom spinning indicator</source>
        <target state="translated">自定義加載指示器</target>
      </segment>
    </unit>
    <unit id="CustomizedDescriptionDescription">
      <segment>
        <source>Customized description</source>
        <target state="translated">自定義描述。</target>
      </segment>
    </unit>
    <unit id="CustomizedDescriptionTitle">
      <segment>
        <source>Customized description</source>
        <target state="translated">自定義描述</target>
      </segment>
    </unit>
    <unit id="EmbeddedModeDescription">
      <segment>
        <source>Embedding content into Spin will set it into loading state.</source>
        <target state="translated">將內容嵌入 Spin 後會進入加載狀態。</target>
      </segment>
    </unit>
    <unit id="EmbeddedModeTitle">
      <segment>
        <source>Embedded mode</source>
        <target state="translated">嵌入模式</target>
      </segment>
    </unit>
    <unit id="P2DescriptionFurtherDetailsAboutTheContextOfThisAlert">
      <segment>
        <source>Further details about the context of this alert.</source>
        <target state="translated">關於這條提示上下文的更多詳細信息。</target>
      </segment>
    </unit>
    <unit id="P2MessageAlertMessageTitle">
      <segment>
        <source>Alert message title</source>
        <target state="translated">提示消息標題</target>
      </segment>
    </unit>
    <unit id="P2TextLoadingState">
      <segment>
        <source>Loading state：</source>
        <target state="translated">加載狀態：</target>
      </segment>
    </unit>
    <unit id="P2TipLoading">
      <segment>
        <source>Loading...</source>
        <target state="translated">加載中...</target>
      </segment>
    </unit>
    <unit id="PageDescription">
      <segment>
        <source>Spin and SpinIndicator display activity while a region, card, or page is waiting for data, with optional tips, masks, and custom indicators.</source>
        <target state="translated">Spin 和 SpinIndicator 用於區域、卡片或頁面等待數據時展示加載狀態，並支持提示文本、遮罩和自定義指示器。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Loading indicators for asynchronous content.</source>
        <target state="translated">用於異步內容的加載指示器。</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="SemanticContainerDescription">
      <segment>
        <source>Container element with opacity and blur transition styles for the nested content.</source>
        <target state="translated">容器元素，包含嵌套內容的透明度和模糊過渡樣式。</target>
      </segment>
    </unit>
    <unit id="SemanticDescriptionDescription">
      <segment>
        <source>Description element with font size, foreground and line height styles for the tip text.</source>
        <target state="translated">描述元素，包含提示文字的字號、前景色和行高樣式。</target>
      </segment>
    </unit>
    <unit id="SemanticIndicatorContentDescription">
      <segment>
        <source>Content element with the built-in dot indicator or custom indicator presenter styles.</source>
        <target state="translated">內容元素，包含內建圓點指示器或自訂指示器呈現內容的樣式。</target>
      </segment>
    </unit>
    <unit id="SemanticIndicatorDescription">
      <segment>
        <source>Indicator element with size, motion duration and other spinning indicator styles.</source>
        <target state="translated">指示器元素，包含尺寸、動效時長以及其他載入指示樣式。</target>
      </segment>
    </unit>
    <unit id="SemanticIndicatorRootDescription">
      <segment>
        <source>Root element of a SpinIndicator component.</source>
        <target state="translated">SpinIndicator 元件的根元素。</target>
      </segment>
    </unit>
    <unit id="SemanticMaskDescription">
      <segment>
        <source>Mask element with background, opacity and other overlay dimming styles.</source>
        <target state="translated">遮罩元素，包含背景、透明度以及其他遮罩變暗樣式。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Use owner-scoped styles to customize Spin's published Semantic Parts.</source>
        <target state="translated">使用 owner 作用域樣式自訂 Spin 已發佈的 Semantic Part。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
        <target state="translated">自訂語義結構的樣式</target>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>Root element with the loading region's base layout, alignment and theme entry styles.</source>
        <target state="translated">根元素，包含載入區域的基礎佈局、對齊和主題入口樣式。</target>
      </segment>
    </unit>
    <unit id="SemanticSectionDescription">
      <segment>
        <source>Section element with centered alignment, spacing and other loading area layout styles.</source>
        <target state="translated">載入區域元素，包含居中對齊、間距以及其他載入區域佈局樣式。</target>
      </segment>
    </unit>
    <unit id="SizeDescription">
      <segment>
        <source>SpinIndicator supports small, middle, large, and custom size types; the custom type follows the middle metrics by default and can override indicator metrics.</source>
        <target state="translated">SpinIndicator 支持小號、中號、大號和自定義尺寸類型；自定義類型默認沿用中號尺寸指標，也可以覆蓋指示器尺寸指標。</target>
      </segment>
    </unit>
    <unit id="SizeTitle">
      <segment>
        <source>Size</source>
        <target state="translated">尺寸</target>
      </segment>
    </unit>
  </file>
