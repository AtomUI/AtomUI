<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.ProgressBar.ProgressBarShowCase"
             xmlns:vm="using:AtomUIGallery.ShowCases.ProgressBar"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             x:DataType="vm:ProgressBarViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="SemanticProgressToolbarTemplate"
                      x:DataType="vm:ProgressBarViewModel">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="{atom:SharedTokenResource Spacing}">
                <atom:Segmented SelectedIndex="{Binding SemanticPreviewIndex, Mode=TwoWay}"
                                VerticalAlignment="Center">
                    <atom:SegmentedItem Content="line" />
                    <atom:SegmentedItem Content="steps" />
                    <atom:SegmentedItem Content="circle" />
                    <atom:SegmentedItem Content="dashboard" />
                </atom:Segmented>
                <atom:ToggleSwitch IsChecked="{Binding IsSemanticGradientEnabled, Mode=TwoWay}"
                                   VerticalAlignment="Center"
                                   OnContent="Gradient"
                                   OffContent="Gradient" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="ProgressBar"
                    Category="{gallery:ProgressBarShowCaseLangResource ComponentCategory}"
                    Status="{gallery:ProgressBarShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:ProgressBarShowCaseLangResource PageSubtitle}"
                    Description="{gallery:ProgressBarShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="AbstractProgressBar" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:ProgressBarViewModel">
                    <StackPanel HorizontalAlignment="Stretch"
                                Spacing="{atom:SharedTokenResource Spacing}">
                        <StackPanel.Styles>
                            <Style Selector="atom|ProgressBar.gradient-preview, atom|StepsProgressBar.gradient-preview, atom|CircleProgress.gradient-preview, atom|DashboardProgress.gradient-preview">
                                <Setter Property="StrokeBrush" Value="{Binding SemanticPreviewGradientBrush}" />
                            </Style>
                        </StackPanel.Styles>
                        <gallery:SemanticPartPreview Name="ProgressBarSemanticPreview"
                                                     IsVisible="{Binding IsLineSemanticPreviewVisible}"
                                                     SemanticOwner="{Binding #ProgressBarSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:ProgressBar}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <StackPanel HorizontalAlignment="Stretch"
                                            Spacing="{atom:SharedTokenResource Spacing}">
                                    <ContentControl Content="{Binding}"
                                                    HorizontalAlignment="Center"
                                                    ContentTemplate="{StaticResource SemanticProgressToolbarTemplate}" />
                                    <Grid Height="200" HorizontalAlignment="Stretch">
                                        <atom:ProgressBar Name="ProgressBarSemanticOwner"
                                                          Classes.gradient-preview="{Binding IsSemanticGradientEnabled}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Top"
                                                          Value="80" />
                                    </Grid>
                                </StackPanel>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription Path="root"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription Path="body"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticBodyDescription}" />
                                <gallery:SemanticPartDescription Path="rail"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticRailDescription}" />
                                <gallery:SemanticPartDescription Path="track"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticTrackDescription}" />
                                <gallery:SemanticPartDescription Path="indicator"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticIndicatorDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <gallery:SemanticPartPreview Name="StepsProgressBarSemanticPreview"
                                                     IsVisible="{Binding IsStepsSemanticPreviewVisible}"
                                                     SemanticOwner="{Binding #StepsProgressBarSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:StepsProgressBar}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <StackPanel HorizontalAlignment="Stretch"
                                            Spacing="{atom:SharedTokenResource Spacing}">
                                    <ContentControl Content="{Binding}"
                                                    HorizontalAlignment="Center"
                                                    ContentTemplate="{StaticResource SemanticProgressToolbarTemplate}" />
                                    <Grid Height="200" HorizontalAlignment="Stretch">
                                        <atom:StepsProgressBar Name="StepsProgressBarSemanticOwner"
                                                               Classes.gradient-preview="{Binding IsSemanticGradientEnabled}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top"
                                                               Value="80"
                                                               Steps="5" />
                                    </Grid>
                                </StackPanel>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription Path="root"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription Path="body"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticBodyDescription}" />
                                <gallery:SemanticPartDescription Path="track"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticTrackDescription}" />
                                <gallery:SemanticPartDescription Path="indicator"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticIndicatorDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <gallery:SemanticPartPreview Name="CircleProgressSemanticPreview"
                                                     IsVisible="{Binding IsCircleSemanticPreviewVisible}"
                                                     SemanticOwner="{Binding #CircleProgressSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:CircleProgress}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <StackPanel HorizontalAlignment="Stretch"
                                            Spacing="{atom:SharedTokenResource Spacing}">
                                    <ContentControl Content="{Binding}"
                                                    HorizontalAlignment="Center"
                                                    ContentTemplate="{StaticResource SemanticProgressToolbarTemplate}" />
                                    <Grid Height="200" HorizontalAlignment="Stretch">
                                        <atom:CircleProgress Name="CircleProgressSemanticOwner"
                                                             Classes.gradient-preview="{Binding IsSemanticGradientEnabled}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top"
                                                             Value="80" />
                                    </Grid>
                                </StackPanel>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription Path="root"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription Path="body"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticBodyDescription}" />
                                <gallery:SemanticPartDescription Path="rail"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticRailDescription}" />
                                <gallery:SemanticPartDescription Path="track"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticTrackDescription}" />
                                <gallery:SemanticPartDescription Path="indicator"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticIndicatorDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <gallery:SemanticPartPreview Name="DashboardProgressSemanticPreview"
                                                     IsVisible="{Binding IsDashboardSemanticPreviewVisible}"
                                                     SemanticOwner="{Binding #DashboardProgressSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:DashboardProgress}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <StackPanel HorizontalAlignment="Stretch"
                                            Spacing="{atom:SharedTokenResource Spacing}">
                                    <ContentControl Content="{Binding}"
                                                    HorizontalAlignment="Center"
                                                    ContentTemplate="{StaticResource SemanticProgressToolbarTemplate}" />
                                    <Grid Height="200" HorizontalAlignment="Stretch">
                                        <atom:DashboardProgress Name="DashboardProgressSemanticOwner"
                                                                Classes.gradient-preview="{Binding IsSemanticGradientEnabled}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Top"
                                                                Value="80" />
                                    </Grid>
                                </StackPanel>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription Path="root"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription Path="body"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticBodyDescription}" />
                                <gallery:SemanticPartDescription Path="rail"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticRailDescription}" />
                                <gallery:SemanticPartDescription Path="track"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticTrackDescription}" />
                                <gallery:SemanticPartDescription Path="indicator"
                                                                 Description="{gallery:ProgressBarShowCaseLangResource SemanticIndicatorDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCasePanel.Styles>
                    <Style Selector="atom|CircleProgress">
                        <Setter Property="Margin" Value="5" />
                    </Style>
                    <Style Selector="atom|DashboardProgress">
                        <Setter Property="Margin" Value="5" />
                    </Style>
                    <Style Selector="#CircleWithStep atom|StepsProgressBar">
                        <Setter Property="Margin" Value="5" />
                    </Style>
                </gallery:ShowCasePanel.Styles>
    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource ProgressBarTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource ProgressBarDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ProgressBar Value="30" Minimum="0" Maximum="100" />
            <atom:ProgressBar Value="50" Minimum="0" Maximum="100" />
            <atom:ProgressBar Value="70" Minimum="0" Maximum="100" Status="Exception" />
            <atom:ProgressBar Value="100" Minimum="0" Maximum="100" />
            <atom:ProgressBar Value="50" Minimum="0" Maximum="100" IsProgressInfoVisible="False" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource CircularProgressBarTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource CircularProgressBarDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <WrapPanel Orientation="Horizontal">
            <atom:CircleProgress Value="75" Minimum="0" Maximum="100" />
            <atom:CircleProgress Value="70" Minimum="0" Maximum="100" Status="Exception" />
            <atom:CircleProgress Value="100" Minimum="0" Maximum="100" />
        </WrapPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource MiniSizeTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource MiniSizeDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <WrapPanel Orientation="Horizontal" Width="180" HorizontalAlignment="Left">
            <atom:ProgressBar Value="30" Minimum="0" Maximum="100" SizeType="Middle" />
            <atom:ProgressBar Value="50" Minimum="0" Maximum="100" SizeType="Middle" />
            <atom:ProgressBar Value="70" Minimum="0" Maximum="100" Status="Exception" SizeType="Middle" />
            <atom:ProgressBar Value="100" Minimum="0" Maximum="100" SizeType="Middle" />
            <atom:ProgressBar Value="50" Minimum="0" Maximum="100" IsProgressInfoVisible="False" SizeType="Middle" />
        </WrapPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource SmallerCircularProgressBarTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource SmallerCircularProgressBarDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <WrapPanel Orientation="Horizontal">
            <atom:CircleProgress Value="75" Minimum="0" Maximum="100" SizeType="Middle" />
            <atom:CircleProgress Value="70" Minimum="0" Maximum="100" Status="Exception" SizeType="Middle" />
            <atom:CircleProgress Value="100" Minimum="0" Maximum="100" SizeType="Middle" />
        </WrapPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource DynamicTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource DynamicDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" IsProgressInfoVisible="False" />
            <atom:CircleProgress Value="{Binding ProgressValue}" Minimum="0" Maximum="100" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Button SizeType="Small" Command="{Binding SubProgressValue}" Content="{gallery:ProgressBarShowCaseLangResource P2ContentSub}" />
                <atom:Button SizeType="Small" Command="{Binding AddProgressValue}" Content="{gallery:ProgressBarShowCaseLangResource P2ContentAdd}" />
            </StackPanel>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource CustomTextFormatTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource CustomTextFormatDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <WrapPanel Orientation="Horizontal">
            <atom:CircleProgress Value="75" Minimum="0" Maximum="100" ProgressTextFormat="\{0\} Days" />
            <atom:CircleProgress Value="100" Minimum="0" Maximum="100" />
        </WrapPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource DashboardTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource DashboardDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <WrapPanel Orientation="Horizontal">
            <atom:DashboardProgress Value="75" Minimum="0" Maximum="100" DashboardGapPosition="Left" />
            <atom:DashboardProgress Value="60" Minimum="0" Maximum="100" DashboardGapPosition="Top" />
            <atom:DashboardProgress Value="75" Minimum="0" Maximum="100" DashboardGapPosition="Right"
                                    GapDegree="40" />
            <atom:DashboardProgress Value="100" Minimum="0" Maximum="100" DashboardGapPosition="Bottom"
                                    GapDegree="40" />
        </WrapPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource SuccessSegmentTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource SuccessSegmentDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ProgressBar Value="60" Minimum="0" Maximum="100" SuccessThreshold="30" />
            <WrapPanel Orientation="Horizontal">
                <atom:CircleProgress Value="60" Minimum="0" Maximum="100" SuccessThreshold="30" />
                <atom:DashboardProgress Value="60" Minimum="0" Maximum="100" SuccessThreshold="30"
                                        SuccessStrokeBrush="Chocolate" />
            </WrapPanel>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource StrokeLinecapTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource StrokeLinecapDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ProgressBar Value="75" Minimum="0" Maximum="100" StrokeLineCap="Square" />
            <WrapPanel Orientation="Horizontal">
                <atom:CircleProgress Value="75" Minimum="0" Maximum="100" StrokeLineCap="Square" />
                <atom:DashboardProgress Value="75" Minimum="0" Maximum="100" StrokeLineCap="Square" />
            </WrapPanel>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource CustomLineGradientTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource CustomLineGradientDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ProgressBar Value="99" Minimum="0" Maximum="100"
                              StrokeBrush="{Binding TwoStopsGradientStrokeColor}" />
            <atom:ProgressBar Value="50" Minimum="0" Maximum="100"
                              StrokeBrush="{Binding TwoStopsGradientStrokeColor}" Status="Active" />
            <WrapPanel Orientation="Horizontal">
                <atom:CircleProgress Value="90" Minimum="0" Maximum="100"
                                     StrokeBrush="{Binding TwoStopsGradientStrokeColor}" />
                <atom:CircleProgress Value="100" Minimum="0" Maximum="100"
                                     StrokeBrush="{Binding TwoStopsGradientStrokeColor}" />
                <atom:CircleProgress Value="93" Minimum="0" Maximum="100"
                                     StrokeBrush="{Binding ThreeStopsGradientStrokeColor}" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
                <atom:DashboardProgress Value="90" Minimum="0" Maximum="100" StrokeLineCap="Square"
                                        StrokeBrush="{Binding TwoStopsGradientStrokeColor}" />
                <atom:DashboardProgress Value="100" Minimum="0" Maximum="100" StrokeLineCap="Square"
                                        StrokeBrush="{Binding TwoStopsGradientStrokeColor}" />
                <atom:DashboardProgress Value="93" Minimum="0" Maximum="100" StrokeLineCap="Square"
                                        StrokeBrush="{Binding ThreeStopsGradientStrokeColor}" />
            </WrapPanel>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource StepsTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource StepsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="5">
            <atom:StepsProgressBar Value="50" Minimum="0" Maximum="100" Steps="3" />
            <atom:StepsProgressBar Value="30" Minimum="0" Maximum="100" Steps="5" />
            <atom:StepsProgressBar Value="100" Minimum="0" Maximum="100" Steps="5" SizeType="Middle" />
            <atom:StepsProgressBar Value="80" Minimum="0" Maximum="100" Steps="8" SizeType="Small" />
            <atom:StepsProgressBar Value="60" Minimum="0" Maximum="100" Steps="5"
                                   StepsStrokeBrush="{Binding StepsChunkBrushes}" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource CircularStepsTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource CircularStepsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="5">
            <WrapPanel Orientation="Horizontal">
                <atom:CircleProgress Value="50" Minimum="0" Maximum="100" StepCount="4" StepGap="8"
                                     IndicatorThickness="20" />
                <atom:CircleProgress Value="100" Minimum="0" Maximum="100" StepCount="10" StepGap="8"
                                     IndicatorThickness="20" />
                <atom:CircleProgress Value="77" Minimum="0" Maximum="100" StepCount="8" StepGap="10"
                                     IndicatorThickness="20" Status="Exception" />
                <atom:CircleProgress Value="77" Minimum="0" Maximum="100" StepCount="8" StepGap="10"
                                     IndicatorThickness="20"
                                     SuccessThreshold="30" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
                <atom:DashboardProgress Value="50" Minimum="0" Maximum="100" StepCount="4" StepGap="8"
                                        IndicatorThickness="20" />
                <atom:DashboardProgress Value="70" Minimum="0" Maximum="100" StepCount="10" StepGap="8"
                                        IndicatorThickness="20" />
                <atom:DashboardProgress Value="77" Minimum="0" Maximum="100" StepCount="8" StepGap="10"
                                        IndicatorThickness="20" Status="Exception" />
                <atom:DashboardProgress Value="77" Minimum="0" Maximum="100" StepCount="8" StepGap="10"
                                        IndicatorThickness="20"
                                        SuccessThreshold="30" />
            </WrapPanel>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource CircularStepsTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource CircularStepsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="5" x:Name="CircleWithStep">
            <StackPanel Orientation="Vertical" Spacing="5">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="300">
                    <atom:ProgressBar Value="50" Minimum="0" Maximum="100" SizeType="Large" />
                    <atom:ProgressBar Value="50" Minimum="0" Maximum="100" SizeType="Middle" />
                    <atom:ProgressBar Value="50" Minimum="0" Maximum="100" SizeType="Small" />
                    <atom:ProgressBar Value="50" Minimum="0" Maximum="100" IndicatorThickness="20" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <atom:CircleProgress Value="50" Minimum="0" Maximum="100" SizeType="Large" />
                    <atom:CircleProgress Value="50" Minimum="0" Maximum="100" SizeType="Middle" />
                    <atom:CircleProgress Value="50" Minimum="0" Maximum="100" SizeType="Small" />
                    <atom:CircleProgress Value="50" Minimum="0" Maximum="100" Width="20" Height="20" />
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                    <atom:DashboardProgress Value="50" Minimum="0" Maximum="100" SizeType="Large" />
                    <atom:DashboardProgress Value="50" Minimum="0" Maximum="100" SizeType="Middle" />
                    <atom:DashboardProgress Value="50" Minimum="0" Maximum="100" SizeType="Small" />
                    <atom:DashboardProgress Value="50" Minimum="0" Maximum="100" Width="20" Height="20" />
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <atom:StepsProgressBar Value="50" Minimum="0" Maximum="100" Steps="3" SizeType="Large" />
                    <atom:StepsProgressBar Value="50" Minimum="0" Maximum="100" Steps="3" SizeType="Middle" />
                    <atom:StepsProgressBar Value="50" Minimum="0" Maximum="100" Steps="3" SizeType="Small" />
                    <atom:StepsProgressBar Value="50" Minimum="0" Maximum="100" Steps="3" ChunkHeight="20"
                                           ChunkWidth="20" />
                    <atom:StepsProgressBar Value="50" Minimum="0" Maximum="100" Steps="3" ChunkHeight="30"
                                           ChunkWidth="20" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource PercentPositionTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource PercentPositionDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ProgressBar Value="30" Minimum="0" Maximum="100" Width="300"
                              PercentPosition="{Binding InnerStartPercentPosition}" />
            <atom:ProgressBar Value="60" Minimum="0" Maximum="100" Width="300"
                              PercentPosition="{Binding InnerCenterPercentPosition}" />
            <atom:ProgressBar Value="50" Minimum="0" Maximum="100" Width="300"
                              PercentPosition="{Binding InnerEndPercentPosition}" />
            <atom:ProgressBar Value="70" Minimum="0" Maximum="100" Width="300" StrokeBrush="#001342"
                              PercentPosition="{Binding InnerEndPercentPosition}" />
            <atom:ProgressBar Value="100" Minimum="0" Maximum="100" Width="400"
                              PercentPosition="{Binding InnerCenterPercentPosition}" />
            <atom:ProgressBar Value="100" Minimum="0" Maximum="100"
                              PercentPosition="{Binding OuterStartPercentPosition}" />
            <atom:ProgressBar Value="60" Minimum="0" Maximum="100"
                              PercentPosition="{Binding OuterCenterPercentPosition}" SizeType="Small" />
            <atom:ProgressBar Value="100" Minimum="0" Maximum="100"
                              PercentPosition="{Binding OuterCenterPercentPosition}" />
            <atom:ProgressBar Value="55" Minimum="0" Maximum="100"
                              PercentPosition="{Binding OuterStartPercentPosition}" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource StepsPercentPositionTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource StepsPercentPositionDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:StepsProgressBar Value="100" Minimum="0" Maximum="100" Steps="8" PercentPosition="Start" />
            <atom:StepsProgressBar Value="100" Minimum="0" Maximum="100" Steps="8" PercentPosition="Center" />
            <atom:StepsProgressBar Value="60" Minimum="0" Maximum="100" Steps="8" PercentPosition="Center"
                                   SizeType="Middle" />
            <atom:StepsProgressBar Value="60" Minimum="0" Maximum="100" Steps="8" PercentPosition="Center"
                                   SizeType="Small" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="8" PercentPosition="Center" />
            <atom:StepsProgressBar Value="100" Minimum="0" Maximum="100" Steps="8" PercentPosition="End" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="8" PercentPosition="End"
                                   Status="Exception" />
            <atom:StepsProgressBar Value="99" Minimum="0" Maximum="100" Steps="8" PercentPosition="Start" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource VerticalLinearTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource VerticalLinearDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10" Height="300">
            <atom:ProgressBar Value="100" Minimum="0" Maximum="100" Orientation="Vertical" />
            <atom:ProgressBar Value="55" Minimum="0" Maximum="100" Orientation="Vertical" />
            <atom:ProgressBar Value="55" Minimum="0" Maximum="100" Orientation="Vertical" SizeType="Small" />
            <atom:ProgressBar Value="55" Minimum="0" Maximum="100" Orientation="Vertical"
                              PercentPosition="{Binding OuterStartPercentPosition}" />
            <atom:ProgressBar Value="55" Minimum="0" Maximum="100" Orientation="Vertical"
                              PercentPosition="{Binding OuterCenterPercentPosition}" />
            <atom:ProgressBar Value="100" Minimum="0" Maximum="100" Orientation="Vertical"
                              PercentPosition="{Binding OuterStartPercentPosition}" />

            <atom:ProgressBar Value="55" Minimum="0" Maximum="100" Orientation="Vertical"
                              PercentPosition="{Binding InnerStartPercentPosition}" />
            <atom:ProgressBar Value="55" Minimum="0" Maximum="100" Orientation="Vertical"
                              PercentPosition="{Binding InnerCenterPercentPosition}" />
            <atom:ProgressBar Value="100" Minimum="0" Maximum="100" Orientation="Vertical"
                              PercentPosition="{Binding InnerStartPercentPosition}" />
            <atom:ProgressBar Value="70" Minimum="0" Maximum="100" Orientation="Vertical"
                              PercentPosition="{Binding InnerEndPercentPosition}" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource VerticalStepsTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource VerticalStepsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10" Height="300">
            <atom:StepsProgressBar Value="100" Minimum="0" Maximum="100" Steps="10" Orientation="Vertical"
                                   PercentPosition="End" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="5" Orientation="Vertical" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="10" Orientation="Vertical"
                                   SizeType="Small" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="6" Orientation="Vertical"
                                   PercentPosition="Start" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="6" Orientation="Vertical"
                                   PercentPosition="Center" />
            <atom:StepsProgressBar Value="100" Minimum="0" Maximum="100" Steps="6" Orientation="Vertical"
                                   PercentPosition="Start" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource VerticalStepsTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource VerticalStepsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10" Height="300">
            <atom:StepsProgressBar Value="100" Minimum="0" Maximum="100" Steps="10" Orientation="Vertical"
                                   PercentPosition="End" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="5" Orientation="Vertical" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="10" Orientation="Vertical"
                                   SizeType="Small" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="6" Orientation="Vertical"
                                   PercentPosition="Start" />
            <atom:StepsProgressBar Value="55" Minimum="0" Maximum="100" Steps="6" Orientation="Vertical"
                                   PercentPosition="Center" />
            <atom:StepsProgressBar Value="100" Minimum="0" Maximum="100" Steps="6" Orientation="Vertical"
                                   PercentPosition="Start" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ProgressBarShowCaseLangResource ToggleDisabledStatusTitle}"
        Description="{gallery:ProgressBarShowCaseLangResource ToggleDisabledStatusDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ProgressBarViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ProgressBar Value="30" Minimum="0" Maximum="100" IsEnabled="{Binding ToggleStatus}" />
            <atom:ProgressBar Value="50" Minimum="0" Maximum="100" IsEnabled="{Binding ToggleStatus}" />
            <atom:ProgressBar Value="70" Minimum="0" Maximum="100" Status="Exception"
                              IsEnabled="{Binding ToggleStatus}" />
            <atom:ProgressBar Value="100" Minimum="0" Maximum="100" IsEnabled="{Binding ToggleStatus}" />

            <atom:StepsProgressBar Value="30" Minimum="0" Maximum="100" Steps="10"
                                   IsEnabled="{Binding ToggleStatus}" />
            <atom:StepsProgressBar Value="50" Minimum="0" Maximum="100" Steps="10"
                                   IsEnabled="{Binding ToggleStatus}" />
            <atom:StepsProgressBar Value="70" Minimum="0" Maximum="100" Steps="10" Status="Exception"
                                   IsEnabled="{Binding ToggleStatus}" />
            <atom:StepsProgressBar Value="100" Minimum="0" Maximum="100" Steps="10"
                                   IsEnabled="{Binding ToggleStatus}" />

            <WrapPanel Orientation="Horizontal">
                <atom:CircleProgress Value="75" Minimum="0" Maximum="100" SizeType="Middle"
                                     IsEnabled="{Binding ToggleStatus}" />
                <atom:CircleProgress Value="70" Minimum="0" Maximum="100" SizeType="Middle" Status="Exception"
                                     IsEnabled="{Binding ToggleStatus}" />
                <atom:CircleProgress Value="100" Minimum="0" Maximum="100" SizeType="Middle"
                                     IsEnabled="{Binding ToggleStatus}" />
            </WrapPanel>

            <WrapPanel Orientation="Horizontal">
                <atom:DashboardProgress Value="75" Minimum="0" Maximum="100" SizeType="Middle"
                                        IsEnabled="{Binding ToggleStatus}" />
                <atom:DashboardProgress Value="70" Minimum="0" Maximum="100" SizeType="Middle" Status="Exception"
                                        IsEnabled="{Binding ToggleStatus}" />
                <atom:DashboardProgress Value="100" Minimum="0" Maximum="100" SizeType="Middle"
                                        IsEnabled="{Binding ToggleStatus}" />
            </WrapPanel>

            <atom:Button Margin="0, 10, 0, 0"
                         Content="{Binding ToggleDisabledText}"
                         Command="{Binding ToggleEnabledStatus}" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ProgressBarShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:ProgressBarShowCaseLangResource SemanticPartStyleDescription}"
                    SourceKey="progress-bar-semantic-part"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    Span="Full"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ProgressBarViewModel">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Spacing="0">
                                <StackPanel.Styles>
                                    <Style Selector="atom|ProgressBar.semantic-style-demo">
                                        <Setter Property="Padding" Value="2" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <atom:ProgressBarRailStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="#1A000000" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </atom:ProgressBarRailStyle>
                                        <atom:ProgressBarTrackStyle x:SetterTargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                            <Setter Property="Transitions">
                                                <Transitions>
                                                    <BrushTransition Property="Background" Duration="0:0:0.3">
                                                        <BrushTransition.Easing>
                                                            <SplineEasing X1="0.25" Y1="0.1" X2="0.25" Y2="1" />
                                                        </BrushTransition.Easing>
                                                    </BrushTransition>
                                                    <DoubleTransition Property="Width" Duration="0:0:0.3">
                                                        <DoubleTransition.Easing>
                                                            <SplineEasing X1="0.25" Y1="0.1" X2="0.25" Y2="1" />
                                                        </DoubleTransition.Easing>
                                                    </DoubleTransition>
                                                </Transitions>
                                            </Setter>
                                        </atom:ProgressBarTrackStyle>
                                    </Style>
                                    <Style Selector="atom|ProgressBar.semantic-style-demo[Value=10]">
                                        <atom:ProgressBarTrackStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="{Binding SemanticTrackBrush10}" />
                                        </atom:ProgressBarTrackStyle>
                                    </Style>
                                    <Style Selector="atom|ProgressBar.semantic-style-demo[Value=20]">
                                        <atom:ProgressBarTrackStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="{Binding SemanticTrackBrush20}" />
                                        </atom:ProgressBarTrackStyle>
                                    </Style>
                                    <Style Selector="atom|ProgressBar.semantic-style-demo[Value=40]">
                                        <atom:ProgressBarTrackStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="{Binding SemanticTrackBrush40}" />
                                        </atom:ProgressBarTrackStyle>
                                    </Style>
                                    <Style Selector="atom|ProgressBar.semantic-style-demo[Value=60]">
                                        <atom:ProgressBarTrackStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="{Binding SemanticTrackBrush60}" />
                                        </atom:ProgressBarTrackStyle>
                                    </Style>
                                    <Style Selector="atom|ProgressBar.semantic-style-demo[Value=80]">
                                        <atom:ProgressBarTrackStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="{Binding SemanticTrackBrush80}" />
                                        </atom:ProgressBarTrackStyle>
                                    </Style>
                                    <Style Selector="atom|ProgressBar.semantic-style-demo[Value=99]">
                                        <atom:ProgressBarTrackStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="{Binding SemanticTrackBrush99}" />
                                        </atom:ProgressBarTrackStyle>
                                    </Style>
                                </StackPanel.Styles>

                                <atom:ProgressBar Classes="semantic-style-demo" Value="10" />
                                <atom:ProgressBar Classes="semantic-style-demo" Value="20" />
                                <atom:ProgressBar Classes="semantic-style-demo" Value="40" />
                                <atom:ProgressBar Classes="semantic-style-demo" Value="60" />
                                <atom:ProgressBar Classes="semantic-style-demo" Value="80" />
                                <atom:ProgressBar Classes="semantic-style-demo" Value="99" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
