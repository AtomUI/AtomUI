<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net">
    <ControlTheme x:Key="{x:Type atom:SubmitButton}" TargetType="atom:SubmitButton">
        <Setter Property="DisabledBorderBrush" Value="{atom:SubmitButtonTokenResource BorderColorDisabled}" />
        <Setter Property="CirclePadding" Value="{atom:SubmitButtonTokenResource CirclePadding}" />
        <Setter Property="ContentFontSize" Value="{atom:SubmitButtonTokenResource ContentFontSize}" />
        <Setter Property="ContentPadding" Value="{atom:SubmitButtonTokenResource ContentPadding}" />
        <Setter Property="DefaultDisabledBorderBrush" Value="{atom:SubmitButtonTokenResource DefaultBorderColorDisabled}" />
        <Setter Property="DefaultFontWeight" Value="{atom:SubmitButtonTokenResource FontWeight}" />
        <Setter Property="IconEndMargin" Value="{atom:SubmitButtonTokenResource IconEndMargin}" />
        <Setter Property="IconMargin" Value="{atom:SubmitButtonTokenResource IconMargin}" />
        <Setter Property="IconOnlyPadding" Value="{atom:SubmitButtonTokenResource IconOnyPadding}" />
        <Setter Property="IconOnlySize" Value="{atom:SubmitButtonTokenResource OnlyIconSize}" />

        <Style Selector="^[SizeType=Small]">
            <Setter Property="ContentFontSize" Value="{atom:SubmitButtonTokenResource ContentFontSizeSM}" />
            <Setter Property="ContentPadding" Value="{atom:SubmitButtonTokenResource ContentPaddingSM}" />
            <Setter Property="IconOnlyPadding" Value="{atom:SubmitButtonTokenResource IconOnyPaddingSM}" />
            <Setter Property="IconOnlySize" Value="{atom:SubmitButtonTokenResource OnlyIconSizeSM}" />
        </Style>
        <Style Selector="^[SizeType=Large]">
            <Setter Property="ContentFontSize" Value="{atom:SubmitButtonTokenResource ContentFontSizeLG}" />
            <Setter Property="ContentPadding" Value="{atom:SubmitButtonTokenResource ContentPaddingLG}" />
            <Setter Property="IconOnlyPadding" Value="{atom:SubmitButtonTokenResource IconOnyPaddingLG}" />
            <Setter Property="IconOnlySize" Value="{atom:SubmitButtonTokenResource OnlyIconSizeLG}" />
        </Style>

        <ControlTheme.BasedOn>
            <atom:ButtonTheme TargetType="{x:Type atom:SubmitButton}" />
        </ControlTheme.BasedOn>
        
        <Setter Property="ButtonType" Value="Primary"/>
        <Setter Property="Content" Value="{atom:CommonLangResource Submit}"/>
        
    </ControlTheme>
</ResourceDictionary>