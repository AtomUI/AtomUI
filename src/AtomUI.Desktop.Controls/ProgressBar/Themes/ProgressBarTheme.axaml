<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ProgressBar}" TargetType="atom:ProgressBar">
        <ControlTheme.BasedOn>
            <themes:AbstractLineProgressTheme TargetType="atom:ProgressBar" />
        </ControlTheme.BasedOn>

        <Setter Property="LineSizeTokenResourceMode" Value="FontAndStrokePresets" />
        <Setter Property="GrooveBrush" Value="{atom:ProgressBarTokenResource RemainingColor}" />
        <Setter Property="StrokeBrush" Value="{atom:ProgressBarTokenResource DefaultColor}" />
        <Setter Property="LineInfoIconSize" Value="{atom:ProgressBarTokenResource LineInfoIconSize}" />

        <Style Selector="^[EffectiveSizeType=Middle], ^[EffectiveSizeType=Small]">
            <Setter Property="LineInfoIconSize" Value="{atom:ProgressBarTokenResource LineInfoIconSizeSM}" />
        </Style>

        <Setter Property="Template">
            <ControlTemplate TargetType="atom:ProgressBar">
                <atomc:LineProgressPanel Name="PART_ProgressBody"
                                         Classes.semantic-body="True">
                    <Border Name="PART_ProgressRail"
                            Classes.semantic-rail="True" />
                    <Border Name="PART_ProgressTrack"
                            Classes.semantic-track="True" />
                    <Border Name="PART_ProgressSuccess" />
                    <Canvas Name="PART_ProgressIndicator"
                            Classes.semantic-indicator="True"
                            IsVisible="{TemplateBinding IsProgressInfoPresented}">
                        <LayoutTransformControl Name="PART_LayoutTransformControl">
                            <Label Name="PART_PercentageLabel"
                                   Padding="0"
                                   Margin="0"
                                   VerticalContentAlignment="Center"
                                   Foreground="{TemplateBinding PercentageLabelColor}"
                                   IsEnabled="{TemplateBinding IsEnabled}" />
                        </LayoutTransformControl>

                        <atom:IconPresenter
                            Name="PART_ExceptionCompletedIconPresenter"
                            Icon="{TemplateBinding ExceptionCompletedIcon}"
                            HorizontalAlignment="Left" />

                        <atom:IconPresenter
                            Name="PART_SuccessCompletedIconPresenter"
                            Icon="{TemplateBinding SuccessCompletedIcon}"
                            HorizontalAlignment="Left" />
                        <atomc:ProgressInfoPresenter Name="PART_ProgressInfoContentPresenter"
                                          IsVisible="False" />
                    </Canvas>
                </atomc:LineProgressPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_ProgressRail">
            <Setter Property="Background"
                    Value="{TemplateBinding GrooveBrush}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_ProgressTrack">
            <Setter Property="Background"
                    Value="{TemplateBinding StrokeBrush}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_ProgressSuccess">
            <Setter Property="Background"
                    Value="{TemplateBinding SuccessStrokeBrush}" />
        </Style>

        <Style Selector="^[StrokeLineCap=Round]">
            <Style Selector="^ /template/ Border#PART_ProgressRail, ^ /template/ Border#PART_ProgressTrack, ^ /template/ Border#PART_ProgressSuccess">
                <Setter Property="CornerRadius" Value="{atom:ProgressBarTokenResource LineBorderRadius}" />
            </Style>
        </Style>
        
        <Style Selector="^[IsProgressInfoVisible=True]">
            <Style Selector="^[Orientation=Horizontal]">
                <Style Selector="^:labelinner-start">
                    <Style Selector="^ /template/ atom|IconPresenter">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </Style>
                </Style>

                <Style Selector="^:labelinner-end">
                    <Style Selector="^ /template/ atom|IconPresenter">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                    </Style>
                </Style>

                <Style Selector="^:labelinner-center">
                    <Style Selector="^ /template/ atom|IconPresenter">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                </Style>
            </Style>

            <Style Selector="^[Orientation=Vertical]">
                <Style Selector="^:labelinner-start">
                    <Style Selector="^ /template/ atom|IconPresenter">
                        <Setter Property="VerticalAlignment" Value="Top" />
                    </Style>
                </Style>

                <Style Selector="^:labelinner-end">
                    <Style Selector="^ /template/ atom|IconPresenter">
                        <Setter Property="VerticalAlignment" Value="Bottom" />
                    </Style>
                </Style>

                <Style Selector="^:labelinner-center">
                    <Style Selector="^ /template/ atom|IconPresenter">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Style>
            </Style>
        </Style>

        <!-- At 0 the inner label sits on the empty track; InnerLabelEmptyOpacity (1 by default) can hide it. -->
        <Style Selector="^:labelinner:value-zero /template/ Label#PART_PercentageLabel">
            <Setter Property="Opacity" Value="{atom:ProgressBarTokenResource InnerLabelEmptyOpacity}" />
        </Style>

        <Style Selector="^:labelinner">
            <!-- In Inner mode the success icon is not shown in the success state -->
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^[Orientation=Vertical]">
                <Style Selector="^ /template/ LayoutTransformControl">
                    <Setter Property="IsVisible" Value="True" />
                    <Setter Property="LayoutTransform" Value="rotate(90deg)" />
                </Style>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
