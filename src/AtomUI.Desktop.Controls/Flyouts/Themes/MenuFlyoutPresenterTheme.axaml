<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.MenuFlyoutPresenterTheme"
              TargetType="atom:MenuFlyoutPresenter"
              x:ClassModifier="internal">
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupContentPadding" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupContentPadding}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupMinWidth" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupMinWidth}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupMaxWidth" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupMaxWidth}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupBgColor" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupBgColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemColor" Value="{atom:MenuFlyoutPresenterTokenResource ItemColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeKeyGestureColor" Value="{atom:MenuFlyoutPresenterTokenResource KeyGestureColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemMargin" Value="{atom:MenuFlyoutPresenterTokenResource ItemMargin}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemHoverColor" Value="{atom:MenuFlyoutPresenterTokenResource ItemHoverColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemDisabledColor" Value="{atom:MenuFlyoutPresenterTokenResource ItemDisabledColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeDangerItemColor" Value="{atom:MenuFlyoutPresenterTokenResource DangerItemColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeDangerItemHoverColor" Value="{atom:MenuFlyoutPresenterTokenResource DangerItemHoverColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemBg" Value="{atom:MenuFlyoutPresenterTokenResource ItemBg}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemHoverBg" Value="{atom:MenuFlyoutPresenterTokenResource ItemHoverBg}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemHeight" Value="{atom:MenuFlyoutPresenterTokenResource ItemHeight}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemIconSize" Value="{atom:MenuFlyoutPresenterTokenResource ItemIconSize}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemIconMarginInlineEnd" Value="{atom:MenuFlyoutPresenterTokenResource ItemIconMarginInlineEnd}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeGroupTitlePadding" Value="{atom:MenuFlyoutPresenterTokenResource GroupTitlePadding}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemBorderRadius" Value="{atom:MenuFlyoutPresenterTokenResource ItemBorderRadius}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeItemPaddingInline" Value="{atom:MenuFlyoutPresenterTokenResource ItemPaddingInline}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeSeparatorItemHeight" Value="{atom:MenuFlyoutPresenterTokenResource SeparatorItemHeight}" />
        <Setter Property="atom:MenuPopupScrollHost.ThemeMenuPopupShadows" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupShadows}" />

    <Setter Property="Template">
        <ControlTemplate TargetType="atom:MenuFlyoutPresenter">
            <atom:ArrowDecoratedBox Name="{x:Static atom:AbstractArrowDecoratedBox.ArrowDecoratorPart}"
                                    IsArrowVisible="{TemplateBinding IsArrowVisible}"
                                    ArrowPosition="{TemplateBinding ArrowPosition}"
                                    Padding="{TemplateBinding Padding}"
                                    MaxHeight="{TemplateBinding MaxPopupHeight}">
                <atom:MenuPopupScrollHost IsScrollEnabled="{TemplateBinding IsScrollEnabled}"
                                          IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                          atom:ScrollViewer.IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                          AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    Grid.IsSharedSizeScope="True" />
                </atom:MenuPopupScrollHost>
            </atom:ArrowDecoratedBox>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|MenuFlyoutPresenter)">
        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="Background" Value="{Binding $self.(atom:MenuPopupScrollHost.ThemeMenuPopupBgColor)}" />
        <Setter Property="CornerRadius" Value="{atom:PopupTokenResource PopupCornerRadius}" />
        <Setter Property="IsMotionEnabled" Value="{atom:MenuFlyoutPresenterTokenResource EnableMotion}" />
        <Setter Property="Padding" Value="{Binding $self.(atom:MenuPopupScrollHost.ThemeMenuPopupContentPadding)}" />
        <Setter Property="ItemHeight" Value="{Binding $self.(atom:MenuPopupScrollHost.ThemeItemHeight)}" />

        <Style Selector="^ /template/ atom|ArrowDecoratedBox#PART_ArrowDecorator">
            <Setter Property="Background" Value="{Binding $self.(atom:MenuPopupScrollHost.ThemeMenuPopupBgColor)}" />
            <Setter Property="BorderBrush" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupBorderColor}" />
            <Setter Property="BorderThickness" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupBorderThickness}" />
            <Setter Property="MinWidth" Value="{Binding $self.(atom:MenuPopupScrollHost.ThemeMenuPopupMinWidth)}" />
            <Setter Property="MaxWidth" Value="{Binding $self.(atom:MenuPopupScrollHost.ThemeMenuPopupMaxWidth)}" />
        </Style>
    </Style>

</ControlTheme>
