<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes">
    <ControlTheme x:Key="{x:Type atom:DataGridMenuFilterFlyoutPresenter}"
                  TargetType="atom:DataGridMenuFilterFlyoutPresenter">
        <ControlTheme.BasedOn>
            <themes:MenuFlyoutPresenterTheme TargetType="atom:DataGridMenuFilterFlyoutPresenter" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:ArrowDecoratedBox Name="{x:Static atom:AbstractArrowDecoratedBox.ArrowDecoratorPart}"
                                        IsArrowVisible="{TemplateBinding IsArrowVisible}"
                                        ArrowPosition="{TemplateBinding ArrowPosition}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                    <DockPanel LastChildFill="True">
                        <StackPanel Name="ButtonLayout"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            DockPanel.Dock="Bottom">
                            <atom:Button
                                Name="{x:Static atom:DataGridFilterFlyoutPresenterThemeConstants.ResetButtonPart}"
                                SizeType="Small"
                                Margin="0"
                                Content="{atom:CommonLangResource Reset}" />
                            
                            <atom:Button
                                Name="{x:Static atom:DataGridFilterFlyoutPresenterThemeConstants.OkButtonPart}"
                                SizeType="Small"
                                ButtonType="Primary"
                                Margin="0"
                                Content="{atom:CommonLangResource Ok}" />
                        </StackPanel>
                        
                        <atom:PixelAlignedBorder Name="ButtonLayoutSeparator"
                                                 Height="1.0"
                                                 BorderThickness="0,0,0,1"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Stretch"
                                                 DockPanel.Dock="Bottom"/>
                        
                        <atom:ScrollViewer IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                           IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                           AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}"
                                           IsScrollChainingEnabled="False">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                            KeyboardNavigation.TabNavigation="Continue"
                                            Grid.IsSharedSizeScope="True" />
                        </atom:ScrollViewer>
                    </DockPanel>
                </atom:ArrowDecoratedBox>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        
        <Style Selector="^ /template/ StackPanel#ButtonLayout">
            <Setter Property="Spacing" Value="{atom:DataGridTokenResource TableFilterButtonSpacing}" />
            <Setter Property="Margin"
                    Value="{atom:DataGridTokenResource TableFilterButtonContainerMargin}" /> 
        </Style>
        
        <Style Selector="^ /template/ atom|PixelAlignedBorder#ButtonLayoutSeparator">
            <Setter Property="BorderBrush" Value="{atom:DataGridTokenResource TableBorderColor}" />
            <Setter Property="Margin"
                    Value="{atom:DataGridTokenResource TableFilterButtonLayoutSeparatorMargin}" /> 
        </Style>
        

        <Setter Property="Foreground" Value="{atom:OwnerTokenResource Kind=ColorText, SourceControlType={x:Type atom:DataGrid}}" />
        <Setter Property="Background" Value="{atom:DataGridTokenResource TableFilterDropdownBg}" />
        <Setter Property="Padding" Value="{atom:DataGridTokenResource TableFilterDropdownPadding}" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadius, SourceControlType={x:Type atom:DataGrid}}" />
    </ControlTheme>
    
</ResourceDictionary>
