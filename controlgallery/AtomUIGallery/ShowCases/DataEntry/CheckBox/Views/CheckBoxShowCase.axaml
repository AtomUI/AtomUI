<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.CheckBox.CheckBoxShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.CheckBox"
             x:DataType="vm:CheckBoxViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="CheckBox"
                    Category="{gallery:CheckBoxShowCaseLangResource ComponentCategory}"
                    Status="{gallery:CheckBoxShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:CheckBoxShowCaseLangResource PageSubtitle}"
                    Description="{gallery:CheckBoxShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="AbstractCheckBox" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:CheckBoxViewModel">
                    <gallery:SemanticPartPreview Name="CheckBoxSemanticPreview"
                                                 SemanticOwner="{Binding #CheckBoxSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:CheckBox}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:CheckBox Name="CheckBoxSemanticOwner"
                                           Content="{gallery:CheckBoxShowCaseLangResource P2ContentCheckbox}" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:CheckBoxShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="icon"
                                Description="{gallery:CheckBoxShowCaseLangResource SemanticIconDescription}" />
                            <gallery:SemanticPartDescription
                                Path="label"
                                Description="{gallery:CheckBoxShowCaseLangResource SemanticLabelDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCasePanel.Styles>
                    <Style Selector="atom|CheckBox">
                        <Setter Property="Margin" Value="0, 0, 5, 5" />
                    </Style>
                </gallery:ShowCasePanel.Styles>
                <gallery:ShowCaseItem
                    Title="{gallery:CheckBoxShowCaseLangResource BasicTitle}"
                    Description="{gallery:CheckBoxShowCaseLangResource BasicDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CheckBoxViewModel">
                            <StackPanel HorizontalAlignment="Left" Spacing="10">
                                <atom:CheckBox Content="{gallery:CheckBoxShowCaseLangResource P2ContentCheckbox}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CheckBoxShowCaseLangResource DisabledTitle}"
                    Description="{gallery:CheckBoxShowCaseLangResource DisabledDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CheckBoxViewModel">
                            <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                                <atom:CheckBox IsChecked="False" IsEnabled="False"
                                               Content="{gallery:CheckBoxShowCaseLangResource P2ContentUnchecked}" />
                                <atom:CheckBox IsChecked="{x:Null}" IsEnabled="False"
                                               Content="{gallery:CheckBoxShowCaseLangResource P2ContentIndeterminate}" />
                                <atom:CheckBox IsChecked="True" IsEnabled="False"
                                               Content="{gallery:CheckBoxShowCaseLangResource P2ContentChecked}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CheckBoxShowCaseLangResource ControlledCheckboxTitle}"
                    Description="{gallery:CheckBoxShowCaseLangResource ControlledCheckboxDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CheckBoxViewModel">
                            <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                                <atom:CheckBox Name="ControlledCheckbox"
                                               IsChecked="{Binding ControlledCheckBoxCheckedStatus}"
                                               IsEnabled="{Binding ControlledCheckBoxEnabledStatus}"
                                               Command="{Binding CheckBoxCommand}"
                                               Content="{Binding ControlledCheckBoxText}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0, 10, 0, 0">
                                    <atom:Button SizeType="Small" ButtonType="Primary"
                                                 Name="CheckStatusBtn"
                                                 Command="{Binding CheckStatusCommand}"
                                                 Content="{Binding CheckStatusBtnText}" />
                                    <atom:Button SizeType="Small" ButtonType="Primary"
                                                 Name="EnableStatusBtn"
                                                 Command="{Binding EnableStatusCommand}"
                                                 Content="{Binding EnableStatusBtnText}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CheckBoxShowCaseLangResource CheckboxGroupTitle}"
                    Description="{gallery:CheckBoxShowCaseLangResource CheckboxGroupDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CheckBoxViewModel">
                            <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                                <atom:CheckBoxGroup>
                                    <atom:CheckBox IsChecked="True"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentApple}" />
                                    <atom:CheckBox IsChecked="True"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentPear}" />
                                    <atom:CheckBox IsChecked="True"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentOrange}" />
                                </atom:CheckBoxGroup>
                                <atom:CheckBoxGroup>
                                    <atom:CheckBox Content="{gallery:CheckBoxShowCaseLangResource P2ContentApple}" />
                                    <atom:CheckBox IsChecked="True"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentPear}" />
                                    <atom:CheckBox Content="{gallery:CheckBoxShowCaseLangResource P2ContentOrange}" />
                                </atom:CheckBoxGroup>
                                <atom:CheckBoxGroup>
                                    <atom:CheckBox IsChecked="True" IsEnabled="False"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentApple}" />
                                    <atom:CheckBox IsEnabled="False"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentPear}" />
                                    <atom:CheckBox IsEnabled="False"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentOrange}" />
                                </atom:CheckBoxGroup>
                                <atom:CheckBoxGroup Name="BasicCheckBoxGroup"
                                                    ItemsSource="{Binding CheckBoxOptions}"
                                                    CheckedItems="{Binding DefaultCheckBoxOptions}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CheckBoxShowCaseLangResource CheckedItemsBindingTitle}"
                    Description="{gallery:CheckBoxShowCaseLangResource CheckedItemsBindingDescription}"
                    BadgeText="v6.0.8"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CheckBoxViewModel">
                            <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                                <atom:CheckBoxGroup ItemsSource="{Binding TwoWayCheckBoxOptions}"
                                                    CheckedItems="{Binding TwoWayCheckedOptions}" />
                                <atom:TextBlock Text="{Binding TwoWayCheckedSummary}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button SizeType="Small"
                                                 Command="{Binding AddPearToTwoWayCheckedItemsCommand}"
                                                 Content="{gallery:CheckBoxShowCaseLangResource P2ContentAddPear}" />
                                    <atom:Button SizeType="Small"
                                                 Command="{Binding ClearTwoWayCheckedItemsCommand}"
                                                 Content="{gallery:CheckBoxShowCaseLangResource P2ContentClear}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CheckBoxShowCaseLangResource CheckAllTitle}"
                    Description="{gallery:CheckBoxShowCaseLangResource CheckAllDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CheckBoxViewModel">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="10">
                                <StackPanel>
                                    <atom:CheckBox Name="CheckAllCheckbox"
                                                   Command="{Binding CheckedAllStatusCommand}"
                                                   IsChecked="{Binding CheckedAllStatus}"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentCheckAll}" />
                                </StackPanel>
                                <WrapPanel Margin="0, 20, 0, 0">
                                    <atom:CheckBox Name="AppleCheckBox"
                                                   Command="{Binding CheckedItemStatusCommand1}"
                                                   IsChecked="{Binding AppleCheckedStatus}"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentApple}" />
                                    <atom:CheckBox Name="PearCheckBox"
                                                   Command="{Binding CheckedItemStatusCommand2}"
                                                   IsChecked="{Binding PearCheckedStatus}"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentPear}" />
                                    <atom:CheckBox Name="OrangeCheckBox"
                                                   Command="{Binding CheckedItemStatusCommand3}"
                                                   IsChecked="{Binding OrangeCheckedStatus}"
                                                   Content="{gallery:CheckBoxShowCaseLangResource P2ContentOrange}" />
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CheckBoxShowCaseLangResource UseWithGridTitle}"
                    Description="{gallery:CheckBoxShowCaseLangResource UseWithGridDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CheckBoxViewModel">
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="10">
                                <atom:CheckBox Grid.Row="0" Grid.Column="0"
                                               Content="{gallery:CheckBoxShowCaseLangResource P2ContentA}" />
                                <atom:CheckBox Grid.Row="0" Grid.Column="1"
                                               Content="{gallery:CheckBoxShowCaseLangResource P2ContentB}" />
                                <atom:CheckBox Grid.Row="0" Grid.Column="2"
                                               Content="{gallery:CheckBoxShowCaseLangResource P2ContentC}" />
                                <atom:CheckBox Grid.Row="1" Grid.Column="0"
                                               Content="{gallery:CheckBoxShowCaseLangResource P2ContentD}" />
                                <atom:CheckBox Grid.Row="1" Grid.Column="1"
                                               Content="{gallery:CheckBoxShowCaseLangResource P2ContentD}" />
                            </Grid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CheckBoxShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:CheckBoxShowCaseLangResource SemanticPartStyleDescription}"
                    SourceKey="checkbox-semantic-part"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    Span="Full"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CheckBoxViewModel">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Left"
                                        Spacing="12">
                                <StackPanel.Styles>
                                    <Style Selector="atom|CheckBox.semantic-fixed">
                                        <atom:CheckBoxIconStyle x:SetterTargetType="TemplatedControl">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </atom:CheckBoxIconStyle>
                                        <atom:CheckBoxLabelStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#1677ff" />
                                        </atom:CheckBoxLabelStyle>
                                    </Style>
                                    <Style Selector="atom|CheckBox.semantic-conditional">
                                        <atom:CheckBoxIconStyle x:SetterTargetType="TemplatedControl">
                                            <Setter Property="BorderBrush" Value="#faad14" />
                                        </atom:CheckBoxIconStyle>
                                    </Style>
                                    <Style Selector="atom|CheckBox.semantic-conditional:checked">
                                        <atom:CheckBoxIconStyle x:SetterTargetType="TemplatedControl">
                                            <Setter Property="Background" Value="#faad14" />
                                        </atom:CheckBoxIconStyle>
                                        <atom:CheckBoxLabelStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#faad14" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </atom:CheckBoxLabelStyle>
                                    </Style>
                                </StackPanel.Styles>

                                <atom:CheckBox Classes="semantic-fixed"
                                               Content="{gallery:CheckBoxShowCaseLangResource SemanticPartFixedTitle}" />
                                <atom:CheckBox Classes="semantic-conditional"
                                               IsChecked="True"
                                               Content="{gallery:CheckBoxShowCaseLangResource SemanticPartConditionalTitle}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
