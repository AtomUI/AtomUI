<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    >
    <ControlTheme x:Key="{x:Type atom:PickerClearUpButton}" TargetType="atom:PickerClearUpButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:InputClearIconButton
                        Name="PART_ClearButton"
                        Classes.semantic-clear="True"
                        IsVisible="{TemplateBinding IsInClearMode}" />
                    <StackPanel Name="IconLayout"
                                Orientation="Horizontal"
                                IsVisible="{TemplateBinding IsInClearMode, Converter={x:Static BoolConverters.Not}}">
                        <atom:IconPresenter
                            Name="PART_InfoIconPresenter"
                            Icon="{TemplateBinding Icon}" />
                        <ContentPresenter
                            Name="FormFeedBack"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Right"
                            IsVisible="{TemplateBinding IsFormFeedbackVisible}"
                            Content="{TemplateBinding FormFeedback}" />
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ atom|IconPresenter#PART_InfoIconPresenter">
            <Setter Property="Width" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="Height" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="IconBrush"
                    Value="{atom:OwnerTokenResource ColorTextQuaternary}" />
        </Style>

        <Style Selector="^ /template/ StackPanel#IconLayout">
            <Setter Property="Spacing" Value="{atom:OwnerTokenResource SpacingXS}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>