    <unit id="PageDescription">
      <segment>
        <source>TabControl and CardTabControl provide document-style navigation, item-template tabs, closable tabs, flexible placement, and optional tab bar actions.</source>
        <target state="translated">TabControl e CardTabControl fornecer document-estilo navegação, item-template guias, closable guias, flexible posicionamento, e opcional guia barra ações.</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Organize related content into switchable tab panes.</source>
        <target state="translated">Organize related conteúdo into switchable guia panes.</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">Exemplos</target>
      </segment>
    </unit>
    <unit id="SemanticAddDescription">
      <segment>
        <source>Add element, set size, color and corner radius styles for the plus button</source>
        <target state="translated">Elemento de adição, define tamanho, cor e estilos de raio de canto para o botão de mais</target>
      </segment>
    </unit>
    <unit id="SemanticCloseDescription">
      <segment>
        <source>Close element, set size and color styles for the close button</source>
        <target state="translated">Elemento de fechamento, define tamanho e estilos de cor para o botão de fechar</target>
      </segment>
    </unit>
    <unit id="SemanticContentDescription">
      <segment>
        <source>Content element, set padding, background and alignment styles for the content panel</source>
        <target state="translated">Elemento de conteúdo, define preenchimento, fundo e estilos de alinhamento para o painel de conteúdo</target>
      </segment>
    </unit>
    <unit id="SemanticHeaderDescription">
      <segment>
        <source>Header container, set background, padding and alignment styles for the tab strip region</source>
        <target state="translated">Contêiner de cabeçalho, define fundo, preenchimento e estilos de alinhamento para a região da faixa de abas</target>
      </segment>
    </unit>
    <unit id="SemanticIconDescription">
      <segment>
        <source>Icon element, set size and margin styles for the tab icon</source>
        <target state="translated">Elemento de ícone, define tamanho e estilos de margem para o ícone da aba</target>
      </segment>
    </unit>
    <unit id="SemanticIndicatorDescription">
      <segment>
        <source>Indicator element, set color styles for the selected tab ink bar</source>
        <target state="translated">Elemento indicador, define estilos de cor para a barra de tinta da aba selecionada</target>
      </segment>
    </unit>
    <unit id="SemanticItemDescription">
      <segment>
        <source>Item element, set size, padding, hover state and selected state styles for each tab</source>
        <target state="translated">Elemento de item, define tamanho, preenchimento, estado de foco e estado selecionado para cada aba</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Style the root frame, header and content panel through generated Semantic Part styles and root visual properties: dashed frame, header background, bold primary tab labels, item padding, content padding and background. The active ink bar color and thickness are customized through the InkBarColor and InkBarThickness tokens.</source>
        <target state="translated">Estilize o quadro raiz, o cabeçalho e o painel de conteúdo por meio dos estilos Semantic Part gerados e das propriedades visuais raiz: moldura tracejada, fundo do cabeçalho, rótulos de aba primários em negrito, preenchimento do item, preenchimento e fundo do conteúdo. A cor e a espessura da barra de tinta ativa são personalizadas pelos tokens InkBarColor e InkBarThickness.</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
        <target state="translated">Estilo personalizado de Semantic Part</target>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>Root element, set overall size, padding, border and background styles</source>
        <target state="translated">Elemento raiz, define tamanho geral, preenchimento, borda e estilos de fundo</target>
      </segment>
    </unit>
    <unit id="TabControlAddCloseDescription">
      <segment>
        <source>Hide default plus icon, and bind event for customized trigger.</source>
        <target state="translated">Hide padrão plus ícone, e bind event para customized gatilho.</target>
      </segment>
    </unit>
    <unit id="TabControlAddCloseTitle">
      <segment>
        <source>Add and close tab</source>
        <target state="translated">Adicionar e fechar guia</target>
      </segment>
    </unit>
