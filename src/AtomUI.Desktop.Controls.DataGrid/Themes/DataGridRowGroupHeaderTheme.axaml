<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal"
    xmlns:atom="https://atomui.net"
    xmlns:converters="using:AtomUI.Controls.Converters">
    <ControlTheme x:Key="{x:Type atom:DataGridRowGroupHeader}" TargetType="atom:DataGridRowGroupHeader">
        <ControlTheme.Resources>
            <converters:BorderThicknessFilterConverter x:Key="InlineStartMarginConverter"
                Top="False" Right="False" Bottom="False" />
        </ControlTheme.Resources>
        <Setter Property="ExpanderMargin" Value="{atom:DataGridTokenResource MarginSM}" />
        <Setter Property="PropertyMargin" Value="{atom:DataGridTokenResource MarginXXS}" />
        <Setter Property="Template">
            <ControlTemplate>
                <atom:DataGridFrozenGrid Name="RootLayout"
                                         RowDefinitions="*, Auto"
                                         ColumnDefinitions="Auto, Auto, Auto, Auto, *">
                    <Rectangle Name="{x:Static atom:DataGridRowGroupHeaderThemeConstants.IndentSpacerPart}"
                               Grid.Row="0"
                               Grid.Column="1"/>
                    <ToggleButton Name="{x:Static atom:DataGridRowGroupHeaderThemeConstants.ExpanderButtonPart}"
                                  Grid.Row="0"
                                  Grid.Column="2"
                                  Width="{atom:DataGridTokenResource IconSizeSM}"
                                  Height="{atom:DataGridTokenResource IconSizeSM}"
                                  Margin="{TemplateBinding ExpanderMargin, Converter={StaticResource InlineStartMarginConverter}}"
                                  IsTabStop="False"/>
                    <!-- PropertyInfo -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding ExpanderMargin, Converter={StaticResource InlineStartMarginConverter}}">
                        <atom:TextBlock Name="{x:Static atom:DataGridRowGroupHeaderThemeConstants.PropertyNameElementPart}"
                                        Margin="{TemplateBinding PropertyMargin, Converter={StaticResource InlineStartMarginConverter}}"/>
                        <atom:TextBlock Margin="{TemplateBinding PropertyMargin, Converter={StaticResource InlineStartMarginConverter}}"/>
                        <atom:TextBlock Margin="{TemplateBinding PropertyMargin, Converter={StaticResource InlineStartMarginConverter}}"/>
                    </StackPanel>

                    <Rectangle Name="CurrencyVisual"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="5"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Fill="Transparent"
                               IsHitTestVisible="False"
                               StrokeThickness="{atom:DataGridTokenResource LineWidth}" />

                    <Grid Name="FocusVisual"
                          Grid.Row="0"
                          Grid.Column="0"
                          Grid.ColumnSpan="5"
                          IsVisible="False"
                          IsHitTestVisible="False">
                        <Rectangle Name="FocusVisualPrimary"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Fill="Transparent"
                                   IsHitTestVisible="False"
                                   StrokeThickness="{atom:DataGridTokenResource LineWidthBold}"/>
                        <Rectangle Name="FocusVisualSecondary"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Fill="Transparent"
                                   IsHitTestVisible="False"
                                   StrokeThickness="{atom:DataGridTokenResource LineWidth}"/>
                    </Grid>

                    <atom:DataGridRowHeader
                        Name="RowHeader"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.RowSpan="2"
                        atom:DataGridFrozenGrid.IsFrozen="True"
                        />
                    <Rectangle
                        Name="BottomGridLine"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="5"
                        Height="{atom:DataGridTokenResource LineWidth}"
                        />

                </atom:DataGridFrozenGrid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
