<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SelectFilterTextBox}" TargetType="atom:SelectFilterTextBox">
        <ControlTheme.BasedOn>
            <themes:EmbeddedTextBoxTheme TargetType="{x:Type atom:SelectFilterTextBox}" />
        </ControlTheme.BasedOn>

        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
        <Setter Property="CaretBrush" Value="{atom:OwnerTokenResource ColorText}" />
        <Setter Property="SelectionBrush" Value="{atom:OwnerTokenResource SelectionBackground}" />
        <Setter Property="SelectionForegroundBrush" Value="{atom:OwnerTokenResource SelectionForeground}" />
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
        </Style>

        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />

        <Style Selector="^[IsCustomFontSize=False]">
            <Style Selector="^[SizeType=Large]">
                <Setter Property="FontSize" Value="{atom:LineEditTokenResource InputFontSizeLG}" />
            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="FontSize" Value="{atom:LineEditTokenResource InputFontSize}" />
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Setter Property="FontSize" Value="{atom:LineEditTokenResource InputFontSize}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ :is(TextPresenter)#PART_TextPresenter">
            <Setter Property="Margin" Value="2 0 2 0" />
        </Style>

        <Style Selector="^ /template/ atom|TextBlock#Placeholder">
            <Setter Property="Margin" Value="2 0 2 0" />
        </Style>

        <Style Selector="^[Focusable=False][IsReadOnly=True]">
            <Setter Property="Cursor" Value="Hand" />
            <Style Selector="^ /template/ atom|ScrollViewer#ScrollViewer">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
