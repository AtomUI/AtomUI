<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:converters="using:Avalonia.Controls.Converters"
    x:ClassModifier="internal">
    <converters:CornerRadiusFilterConverter x:Key="CornerRadiusFilterConverter" Filter="TopLeft, TopRight" />
    <ControlTheme x:Key="{x:Type atom:Card}" TargetType="atom:Card">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame"
                                         BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                         Background="{TemplateBinding Background}"
                                         ClipToBounds="False"
                                         BoxShadow="{TemplateBinding BoxShadow}">
                    <DockPanel LastChildFill="True">
                        <atom:PixelAlignedBorder Name="HeaderFrame"
                                                 Classes.semantic-header="True"
                                                 DockPanel.Dock="Top"
                                                 BorderThickness="{TemplateBinding HeaderBorderThickness}">
                            <DockPanel LastChildFill="True">
                                <ContentPresenter Name="HeaderExtra"
                                                  Classes.semantic-extra="True"
                                                  DockPanel.Dock="Right"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Extra}"
                                                  ContentTemplate="{TemplateBinding ExtraTemplate}" />
                                <ContentPresenter Name="TitlePresenter"
                                                  Classes.semantic-title="True"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  VerticalAlignment="Center" />
                            </DockPanel>
                        </atom:PixelAlignedBorder>
                        <atom:CardActionPanel Name="PART_ActionPanel"
                                              Classes.semantic-actions="True"
                                              DockPanel.Dock="Bottom"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              IsVisible="{TemplateBinding IsActionsPanelVisible}" />
                        <Border Name="CoverFrame"
                                Classes.semantic-cover="True"
                                CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource CornerRadiusFilterConverter}}"
                                ClipToBounds="True"
                                DockPanel.Dock="Top">
                            <ContentPresenter Name="CoverContentPresenter"
                                              Content="{TemplateBinding Cover}"
                                              ContentTemplate="{TemplateBinding CoverTemplate}"
                                              VerticalContentAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch" />
                        </Border>
                        <Border Name="CardContent"
                                Classes.semantic-body="True">
                            <Panel Name="PART_LoadingHost">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  IsVisible="{TemplateBinding IsContentVisible}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Panel>
                        </Border>
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="IsMotionEnabled" Value="{atom:CardTokenResource EnableMotion}" />
        <Setter Property="CornerRadius" Value="{atom:CardTokenResource BorderRadiusLG}" />
        <Setter Property="BorderBrush" Value="{atom:CardTokenResource ColorBorderSecondary}" />
        <Setter Property="BorderThickness" Value="{atom:CardTokenResource BorderThickness}" />
        <Setter Property="Background" Value="{atom:CardTokenResource ColorBgContainer}" />

        <Style Selector="^:headerless">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <!-- The resting shadow of an outlined card (transparent layers by default, matching CardShadows so the hover
             transition keeps its layer count); borderless cards rest on BoxShadowsTertiary, hover swaps to CardShadows. -->
        <Setter Property="BoxShadow" Value="{atom:CardTokenResource RestingShadows}" />
        <Style Selector="^[StyleVariant=Borderless]">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="{atom:CardTokenResource BoxShadowsTertiary}" />
        </Style>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
            <Setter Property="Background" Value="{atom:CardTokenResource HeaderBg}" />
            <Setter Property="BorderBrush"
                    Value="{atom:CardTokenResource ColorBorderSecondary}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#TitlePresenter">
            <Setter Property="TextElement.FontWeight"
                    Value="{atom:CardTokenResource FontWeightStrong}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#HeaderExtra">
            <Setter Property="Foreground" Value="{atom:CardTokenResource ExtraColor}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="MinHeight" Value="{atom:CardTokenResource HeaderHeightLG}" />
                <Setter Property="Padding" Value="{atom:CardTokenResource HeaderPaddingLG}" />
                <Setter Property="TextElement.FontSize"
                        Value="{atom:CardTokenResource HeaderFontSizeLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="MinHeight" Value="{atom:CardTokenResource HeaderHeight}" />
                <Setter Property="Padding" Value="{atom:CardTokenResource HeaderPadding}" />
                <Setter Property="TextElement.FontSize"
                        Value="{atom:CardTokenResource HeaderFontSize}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="MinHeight" Value="{atom:CardTokenResource HeaderHeightSM}" />
                <Setter Property="Padding" Value="{atom:CardTokenResource HeaderPaddingSM}" />
                <Setter Property="TextElement.FontSize"
                        Value="{atom:CardTokenResource HeaderFontSizeSM}" />
            </Style>
            <Style Selector="^ /template/ Border#CardContent">
                <Setter Property="Padding" Value="{atom:CardTokenResource BodyPaddingSM}" />
            </Style>
        </Style>

        <Style Selector="^[IsInnerMode=True]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="Background" Value="{atom:CardTokenResource ColorFillAlter}" />
            </Style>
        </Style>

        <Style Selector="^[ContentType=Meta],^[ContentType=Default]">
            <Style Selector="^[SizeType=Large]">
                <Style Selector="^ /template/ Border#CardContent">
                    <Setter Property="Padding" Value="{atom:CardTokenResource BodyPaddingLG}" />
                </Style>
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Style Selector="^ /template/ Border#CardContent">
                    <Setter Property="Padding" Value="{atom:CardTokenResource BodyPadding}" />
                </Style>
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ Border#CardContent">
                    <Setter Property="Padding" Value="{atom:CardTokenResource BodyPaddingSM}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[IsHoverable=True]">
            <Setter Property="Cursor" Value="Hand" />
            <Style Selector="^:pointerover">
                <Setter Property="BoxShadow" Value="{atom:CardTokenResource CardShadows}" />
                <Setter Property="BorderBrush" Value="{CompiledBinding $self.Background}" />
            </Style>
            <Style Selector="^[IsMotionEnabled=True] /template/ atom|PixelAlignedBorder#Frame">
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="MotionDurationFast" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>
        </Style>

        <Style Selector="^:not(:headerless)">
            <Style Selector="^ /template/ Border#CoverFrame">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:BoxShadowsTransition Property="BoxShadow" atom:TokenTransitions.Duration="MotionDurationFast" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

    </ControlTheme>
</ResourceDictionary>
