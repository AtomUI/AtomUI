<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.InfoPickerTextBoxTheme"
              x:ClassModifier="internal"
              TargetType="atom:InfoPickerTextBox">
    <ControlTheme.BasedOn>
        <themes:EmbeddedTextBoxTheme TargetType="{x:Type atom:InfoPickerTextBox}" />
    </ControlTheme.BasedOn>

    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />

    <Style Selector="^ /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>
    <!-- The shared input frame sets its own text color, which would cut the picker's text color (for example the
         dimmed hover preview) off from the text presenter; the frame follows this text box instead. -->
    <Style Selector="^ /template/ atom|InputControlFrame#PART_InputControlFrame">
        <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
    </Style>
</ControlTheme>
