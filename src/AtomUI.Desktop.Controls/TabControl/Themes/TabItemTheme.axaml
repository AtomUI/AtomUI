<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="TabItemTheme" TargetType="atom:TabItem">
        <ControlTheme.BasedOn>
            <themes:BaseTabItemTheme TargetType="atom:TabItem" />
        </ControlTheme.BasedOn>

        <Style Selector="^[TabStripPlacement=Top], ^[TabStripPlacement=Bottom]">
            <Setter Property="Margin" Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeHorizontalItemMargin)}" />
            <Style Selector="^[SizeType=Large]">
                <Setter Property="Padding"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeHorizontalItemPaddingLG)}" />
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Setter Property="Padding"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeHorizontalItemPadding)}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Padding"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeHorizontalItemPaddingSM)}" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Left], ^[TabStripPlacement=Right]">
            <Style Selector="^[SizeType=Large]">
                <!-- layout: compact line-tab padding for left / right placement (theme-internal, see token.md) -->
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <!-- layout: compact line-tab padding for left / right placement (theme-internal, see token.md) -->
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <!-- layout: compact line-tab padding for left / right placement (theme-internal, see token.md) -->
                <Setter Property="Padding" Value="8,4" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
