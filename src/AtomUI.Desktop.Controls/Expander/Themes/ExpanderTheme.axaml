<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StringToTextBlockConverter"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap" />
    <ControlTheme x:Key="{x:Type atom:Expander}" TargetType="atom:Expander">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- ClipContentToCornerRadius 是必需的，不是可选优化：PART_Frame 自己画圆角，
                     但 header/body 是它的子节点且各自带背景。ClipToBounds 只做矩形裁剪，不做圆角裁剪，
                     所以不开启时子节点的不透明背景会平铺到方形边界、覆盖掉圆角，视觉上圆角失效。
                     默认主题的 HeaderBg 是 alpha≈2% 的 ColorFillAlter，缺陷几乎不可见；一旦用户通过
                     Semantic Part 或 IsGhostStyle 设置不透明背景就会显形。开启后由本节点统一把
                     整棵子树裁到圆角内框，与展开状态、ExpandDirection 无关。 -->
                <atom:PixelAlignedBorder Name="PART_Frame"
                                         ClipToBounds="True"
                                         ClipContentToCornerRadius="True"
                                         BorderThickness="{TemplateBinding EffectiveBorderThickness}">
                    <DockPanel Name="PART_MainLayout"
                               LastChildFill="True">
                        <LayoutTransformControl Name="PART_HeaderLayoutTransform">
                            <atom:PixelAlignedBorder Name="PART_HeaderDecorator"
                                                     Classes.semantic-header="True"
                                                     Padding="{TemplateBinding HeaderPadding}">
                                <Grid Name="PART_HeaderLayout"
                                      ColumnDefinitions="Auto, *, Auto, Auto">
                                    <atom:IconButton
                                        Name="PART_ExpandButton"
                                        Classes.semantic-icon="True"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                        Icon="{TemplateBinding ExpandIcon}"
                                        IsVisible="{TemplateBinding IsShowExpandIcon}"
                                        IsEnabled="{TemplateBinding IsEnabled}" />
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      Classes.semantic-title="True"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      HorizontalContentAlignment="Left"
                                                      VerticalContentAlignment="Center"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      Grid.Column="1" />
                                    <ContentPresenter
                                        Name="PART_AddOnContentPresenter"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Content="{TemplateBinding AddOnContent}"
                                        ContentTemplate="{TemplateBinding AddOnContentTemplate}"
                                        Grid.Column="2" />
                                </Grid>
                            </atom:PixelAlignedBorder>
                        </LayoutTransformControl>

                        <atom:ContentViewport
                            Name="PART_ContentViewport"
                            ClipToBounds="True"
                            atom:Motion.IsVisible="{TemplateBinding IsExpanded}"
                            atom:Motion.IsEnabled="{TemplateBinding IsMotionEnabled}"
                            atom:Motion.DurationOverride="{TemplateBinding MotionDuration}">
                            <atom:Motion.Enter>
                                <atom:ExpandMotion />
                            </atom:Motion.Enter>
                            <atom:Motion.Leave>
                                <atom:CollapseMotion />
                            </atom:Motion.Leave>
                            <atom:PixelAlignedBorder
                                BorderBrush="{atom:SharedTokenResource ColorBorder}"
                                BorderThickness="{TemplateBinding ContentBorderThickness}">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Classes.semantic-body="True"
                                                  Content="{TemplateBinding Content, Converter={StaticResource StringToTextBlockConverter}}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding ContentPadding}" />
                            </atom:PixelAlignedBorder>
                        </atom:ContentViewport>
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="MotionDuration" Value="{atom:SharedTokenResource MotionDurationSlow}" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        
        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="CornerRadius"
                    Value="{atom:ExpanderTokenResource ExpanderBorderRadius}" />
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />
        </Style>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
            <Setter Property="Background" Value="{atom:ExpanderTokenResource HeaderBg}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextHeading}" />
            <Setter Property="Margin" Value="0, 1, 0, 0" />
        </Style>

        <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
            <Setter Property="IconWidth" Value="{atom:SharedTokenResource IconSizeSM}" />
            <Setter Property="IconHeight" Value="{atom:SharedTokenResource IconSizeSM}" />
        </Style>

        <Style Selector="^[ExpandIconPosition=Start]">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Margin"
                        Value="{atom:ExpanderTokenResource LeftExpandButtonHMargin}" />
            </Style>
        </Style>

        <Style Selector="^[ExpandIconPosition=End]">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Grid.Column" Value="3" />
                <Setter Property="Margin"
                        Value="{atom:ExpanderTokenResource RightExpandButtonHMargin}" />
            </Style>
        </Style>

        <Style Selector="^:custom-header-padding">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Margin"
                        Value="{TemplateBinding EffectiveExpandButtonMargin}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="Margin" Value="0" />
            </Style>
        </Style>

        <Style Selector="^:up">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style Selector="^ /template/ atom|ContentViewport#PART_ContentViewport">
                <Setter Property="atom:Motion.LayoutDirection" Value="Top" />
            </Style>
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Bottom" />
            </Style>
        </Style>

        <Style Selector="^:down">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^:left">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style Selector="^ /template/ atom|ContentViewport#PART_ContentViewport">
                <Setter Property="atom:Motion.LayoutDirection" Value="Left" />
            </Style>
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Right" />
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
            </Style>
        </Style>

        <Style Selector="^:right">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style Selector="^ /template/ atom|ContentViewport#PART_ContentViewport">
                <Setter Property="atom:Motion.LayoutDirection" Value="Right" />
            </Style>
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
            </Style>
        </Style>

        <Style Selector="^:expanded">
            <Style Selector="^:up">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
                </Style>
            </Style>

            <Style Selector="^:down">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(90deg)" />
                </Style>
            </Style>

            <Style Selector="^:left">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(90deg)" />
                </Style>
            </Style>

            <Style Selector="^:right">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:not(:custom-header-padding)">
            <Style Selector="^[SizeType=Large]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource HeaderPaddingLG}" />
                </Style>

            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                    <Setter Property="Padding" Value="{atom:ExpanderTokenResource HeaderPadding}" />
                </Style>

            </Style>
            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource HeaderPaddingSM}" />
                </Style>

            </Style>
        </Style>

        <Style Selector="^:not(:custom-content-padding)">
            <Style Selector="^[SizeType=Large]">

                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource ContentPaddingLG}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource ContentPadding}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource ContentPaddingSM}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="TextElement.FontSize"
                        Value="{atom:SharedTokenResource FontSizeLG}" />
                <Setter Property="TextBlock.LineHeight"
                        Value="{atom:SharedTokenResource FontHeightLG}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="TextElement.FontSize"
                        Value="{atom:SharedTokenResource FontSize}" />
                <Setter Property="TextBlock.LineHeight"
                        Value="{atom:SharedTokenResource FontHeight}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="TextElement.FontSize"
                        Value="{atom:SharedTokenResource FontSize}" />
                <Setter Property="TextBlock.LineHeight"
                        Value="{atom:SharedTokenResource FontHeight}" />
            </Style>
            
        </Style>

        <Style Selector="^[TriggerType=Header]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Style>

        <Style Selector="^[TriggerType=Icon]">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Style>

        <Style Selector="^[IsBorderless=True]">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{atom:ExpanderTokenResource HeaderBg}" />
            </Style>
        </Style>

        <Style Selector="^[IsGhostStyle=True]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="Background" Value="{atom:ExpanderTokenResource ContentBg}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator ContentPresenter">
                <Setter Property="Foreground"
                        Value="{atom:SharedTokenResource ColorTextDisabled}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
