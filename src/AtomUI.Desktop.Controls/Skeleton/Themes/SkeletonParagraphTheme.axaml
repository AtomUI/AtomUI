<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SkeletonParagraph}" TargetType="atom:SkeletonParagraph">
        <ControlTheme.BasedOn>
            <themes:AbstractSkeletonTheme TargetType="atom:SkeletonParagraph" />
        </ControlTheme.BasedOn>
        
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Vertical" Name="PART_LineLayout"/>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ StackPanel#PART_LineLayout">
            <Setter Property="Spacing" Value="{atom:SharedTokenResource ControlHeightXS}"/>
        </Style>

    </ControlTheme>
</ResourceDictionary>
