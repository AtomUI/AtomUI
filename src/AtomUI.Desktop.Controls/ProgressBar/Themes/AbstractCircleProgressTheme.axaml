<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:atomc="https://atomui.net/common-controls"
              xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
              x:Class="AtomUI.Desktop.Controls.Themes.AbstractCircleProgressTheme"
              TargetType="atomc:AbstractCircleProgress"
              x:ClassModifier="internal">
    <ControlTheme.BasedOn>
        <themes:AbstractProgressBarTheme TargetType="atomc:AbstractCircleProgress" />
    </ControlTheme.BasedOn>

    <Style Selector="^:is(atomc|AbstractCircleProgress)">
        <Setter Property="FontSize"
                Value="{CompiledBinding $self.ExtraInfoFontSize, DataType={x:Type atomc:AbstractCircleProgress}}" />
        <!-- The historical text role remains ColorTextLabel until this family Own is explicit. -->
        <Style Selector="^:not(:disabled)">
            <Setter Property="Foreground">
                <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.ForegroundConverter}">
                    <atom:SharedTokenResource Kind="ColorTextLabel" />
                    <atom:ProgressBarTokenResource Kind="CircleTextColor" WhenExplicit="True" />
                    <atom:ProgressBarTokenResource Kind="CircleTextColor" />
                </MultiBinding>
            </Setter>
        </Style>

        <Setter Property="CircleMinimumTextFontSize"
                Value="{atom:ProgressBarTokenResource CircleMinimumTextFontSize}" />
        <Setter Property="CircleMinimumIconSize"
                Value="{atom:ProgressBarTokenResource CircleMinimumIconSize}" />

        <Style Selector="^ /template/ atom|IconPresenter">
            <Setter Property="Width" Value="{TemplateBinding ExtraInfoIconSize}" />
            <Setter Property="Height" Value="{TemplateBinding ExtraInfoIconSize}" />
        </Style>

        <Style Selector="^ /template/ Path#PART_ProgressRail">
            <Setter Property="Stroke"
                    Value="{Binding GrooveBrush, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="StrokeThickness"
                    Value="{Binding StrokeThickness, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="StrokeLineCap"
                    Value="{Binding ShapeStrokeLineCap, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>

        <Style Selector="^ /template/ Path#PART_ProgressTrack">
            <Setter Property="Stroke"
                    Value="{Binding StrokeBrush, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="StrokeThickness"
                    Value="{Binding StrokeThickness, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="StrokeLineCap"
                    Value="{Binding ShapeStrokeLineCap, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>

        <Style Selector="^ /template/ Path#PART_ProgressSuccess">
            <Setter Property="Stroke"
                    Value="{Binding SuccessStrokeBrush, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="StrokeThickness"
                    Value="{Binding StrokeThickness, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="StrokeLineCap"
                    Value="{Binding ShapeStrokeLineCap, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#PART_ExceptionCompletedIconPresenter">
            <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorError}" />
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
            <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorSuccess}" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconPresenter:disabled">
            <Setter Property="IconBrush"
                    Value="{atom:SharedTokenResource ControlItemBgActiveDisabled}" />
        </Style>

        <Style Selector="^[Status=Exception] /template/ LayoutTransformControl#PART_LayoutTransformControl">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^[Status=Success] /template/ LayoutTransformControl#PART_LayoutTransformControl">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^[Status=Success][IsCompleted=True] /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
            <Setter Property="IsVisible" Value="{TemplateBinding IsStatusIconVisible}" />
        </Style>

        <Style Selector="^[Status=Success] /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
            <Setter Property="IsVisible" Value="{TemplateBinding IsStatusIconVisible}" />
        </Style>

        <Style Selector="^[Status=Normal][IsCompleted=True] /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
            <Setter Property="IsVisible" Value="{TemplateBinding IsStatusIconVisible}" />
        </Style>

        <Style Selector="^[Status=Active][IsCompleted=True] /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
            <Setter Property="IsVisible" Value="{TemplateBinding IsStatusIconVisible}" />
        </Style>

        <Style Selector="^[Status=Exception] /template/ atom|IconPresenter#PART_ExceptionCompletedIconPresenter">
            <Setter Property="IsVisible" Value="{TemplateBinding IsStatusIconVisible}" />
        </Style>

        <Style Selector="^[Status=Exception]:not(:disabled)">
            <Setter Property="StrokeBrush" Value="{atom:SharedTokenResource ColorError}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="StrokeBrush" Value="{atom:SharedTokenResource ControlItemBgActiveDisabled}" />
        </Style>

    </Style>
</ControlTheme>
