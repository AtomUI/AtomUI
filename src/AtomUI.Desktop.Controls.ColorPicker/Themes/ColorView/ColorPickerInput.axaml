<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ColorPickerInput}" TargetType="atom:ColorPickerInput">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Name="PART_RootLayout" LastChildFill="True">
                    <atom:ComboBox Name="PART_ColorFormatComboBox" 
                                   StyleVariant="Borderless" 
                                   SizeType="Small" 
                                   SelectedIndex="0"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Stretch"
                                   IsVisible="{TemplateBinding IsFormatEnabled}">
                        <atom:ComboBoxItem Tag="{x:Static atom:ColorFormat.Hex}">HEX</atom:ComboBoxItem>
                        <atom:ComboBoxItem Tag="{x:Static atom:ColorFormat.Hsva}">HSV</atom:ComboBoxItem>
                        <atom:ComboBoxItem Tag="{x:Static atom:ColorFormat.Rgba}">RGB</atom:ComboBoxItem>
                    </atom:ComboBox>
                    <!-- layout: fixed raster inset, hit target or compact editor packing. -->
                    <atom:NumericUpDown Name="PART_AlphaInput"
                                        DockPanel.Dock="Right"
                                        Margin="5, 0, 0, 0"
                                        Minimum="0"
                                        Maximum="100"
                                        FormatString="0'%'"
                                        Increment="1"
                                        IsVisible="{TemplateBinding IsAlphaVisible}"/>
                    <Panel>
                        <!-- Stretch to the row height so the format selector, the value field and the alpha editor line up. -->
                        <atom:LineEdit Name="PART_HexValueInput"
                                       SizeType="Small"
                                       VerticalAlignment="Stretch"
                                       IsVisible="False"/>
                        <!-- layout: compact editor packing. -->
                        <StackPanel Name="PART_HsvValuePanel" Spacing="5" Orientation="Horizontal" IsVisible="False">
                            <atom:NumericUpDown Name="PART_HValueInput"
                                                Minimum="0"
                                                Maximum="360"
                                                Increment="1"/>
                            <atom:NumericUpDown Name="PART_SValueInput"
                                                Minimum="0"
                                                Maximum="100"
                                                FormatString="0'%'"
                                                Increment="1"/>
                            <atom:NumericUpDown Name="PART_VValueInput"
                                                Minimum="0"
                                                Maximum="100"
                                                FormatString="0'%'"
                                                Increment="1"/>
                        </StackPanel>
                        <!-- layout: compact editor packing. -->
                        <StackPanel Name="PART_RgbValuePanel" Spacing="5" Orientation="Horizontal" IsVisible="False">
                            <atom:NumericUpDown Name="PART_RValueInput"
                                                Minimum="0"
                                                Maximum="255"
                                                Increment="1"/>
                            <atom:NumericUpDown Name="PART_GValueInput"
                                                Minimum="0"
                                                Maximum="255"
                                                Increment="1"/>
                            <atom:NumericUpDown Name="PART_BValueInput"
                                                Minimum="0"
                                                Maximum="255"
                                                Increment="1"/>
                        </StackPanel>
                    </Panel>
                </DockPanel>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ atom|NumericUpDown">
            <Setter Property="SizeType" Value="Small"/>
            <!-- layout: compact editor packing. -->
            <Setter Property="Width" Value="48"/>
            <Setter Property="SpinnerHandleWidth" Value="{CompiledBinding $self.(atom:ColorPickerThemeInputs.ThemeColorPickerInputNumberHandleWidth)}"/>
            <Setter Property="IsCustomFontSize" Value="True"/>
            <Setter Property="FontSize" Value="{CompiledBinding $self.(atom:ColorPickerThemeInputs.ThemeEditorFontSize)}"/>
        </Style>
        
        <!-- layout: compact editor packing. -->
        <Setter Property="Width" Value="262"/>
        
        <Style Selector="^[Format=Hex]">
            <Style Selector="^ /template/ atom|LineEdit#PART_HexValueInput">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        
        <Style Selector="^[Format=Hsva]">
            <Style Selector="^ /template/ StackPanel#PART_HsvValuePanel">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        
        <Style Selector="^[Format=Rgba]">
            <Style Selector="^ /template/ StackPanel#PART_RgbValuePanel">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        
        <Style Selector="^ /template/ atom|NumericUpDown#PART_AlphaInput">
            <Setter Property="Width" Value="{CompiledBinding $self.(atom:ColorPickerThemeInputs.ThemeColorPickerAlphaInputWidth)}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
