    <unit id="PageDescription">
      <segment>
        <source>Message displays brief feedback at the top layer of the current window. It is useful for save results, validation feedback, async progress, and chained completion notices.</source>
        <target state="translated">Message 在当前窗口顶层显示简短反馈，适用于保存结果、校验反馈、异步进度和连续完成提示。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Global prompt messages for lightweight operation feedback.</source>
        <target state="translated">用于轻量级操作反馈的全局提示消息。</target>
      </segment>
    </unit>
