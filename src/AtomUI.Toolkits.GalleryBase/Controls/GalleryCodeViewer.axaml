<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avaloniaEdit="using:AvaloniaEdit"
    x:Class="AtomUI.Toolkits.GalleryBase.Controls.GalleryCodeViewer"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <Color x:Key="ThemeBackgroundColor">#FFFFFFFF</Color>
        <Color x:Key="ThemeForegroundColor">#DD000000</Color>
        <Color x:Key="ThemeBorderLowColor">#FFEDEDED</Color>
        <Color x:Key="HighlightColor">#663399FF</Color>
        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{DynamicResource ThemeBackgroundColor}" />
        <SolidColorBrush x:Key="ThemeBorderMidBrush" Color="#FFD9D9D9" />
        <Thickness x:Key="ThemeBorderThickness">1</Thickness>
        <x:Double x:Key="FontSizeNormal">13</x:Double>
        <FontFamily x:Key="ContentControlThemeFontFamily">Cascadia Code, Consolas, Menlo, monospace</FontFamily>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://AtomUI.Toolkits.GalleryBase/Controls/GalleryCodeViewerSearchPanelTheme.axaml" />
        <Style Selector="avaloniaEdit|TextEditor /template/ ScrollViewer#PART_ScrollViewer">
            <Setter Property="IsScrollChainingEnabled" Value="False" />
        </Style>
    </UserControl.Styles>
    <avaloniaEdit:TextEditor
        Name="PART_Editor"
        IsReadOnly="True"
        ShowLineNumbers="True"
        LineNumbersMargin="8,0,4,0"
        FontFamily="Cascadia Code, Consolas, Menlo, monospace"
        FontSize="13"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        WordWrap="False"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch" />
</UserControl>
