<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:GroupHeaderItem}" TargetType="atom:GroupHeaderItem">
        <ControlTheme.BasedOn>
            <atom:ListViewItemTheme TargetType="atom:GroupHeaderItem" />
        </ControlTheme.BasedOn>
        <!-- Group headers are not navigable: arrow keys and Tab skip them. -->
        <Setter Property="Focusable" Value="False" />

        <Style Selector="^[IsGroupItem=True]">
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorFillAlter}" />
            <Setter Property="FontWeight" Value="{atom:OwnerTokenResource FontWeightStrong}" />
            <Setter Property="Padding" Value="{CompiledBinding $self.GroupHeaderPadding}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
