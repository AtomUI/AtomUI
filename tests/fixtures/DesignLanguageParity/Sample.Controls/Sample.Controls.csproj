<Project Sdk="Microsoft.NET.Sdk">
    <!--
    Parity sample (spec 15): a third-party control package that uses only the public AtomUI API. It declares its
    controls, their token classes and their control themes; it carries no values and references no design language.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Sample.Controls</RootNamespace>
        <AtomUIGenerateControlThemeAssetResources>true</AtomUIGenerateControlThemeAssetResources>
        <AtomUIRegistrationPackageId>$(AssemblyName)</AtomUIRegistrationPackageId>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <ProjectReference Include="../../../../src/AtomUI.Core/AtomUI.Core.csproj" />
        <ProjectReference Include="../../../../src/AtomUI.Generator/AtomUI.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>
</Project>
