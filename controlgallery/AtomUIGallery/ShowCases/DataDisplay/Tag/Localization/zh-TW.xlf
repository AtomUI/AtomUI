      </segment>
    </unit>
    <unit id="SemanticGroupRootDescription">
      <segment>
        <source>Root element of the group owning options, selection mode and checked values</source>
        <target state="translated">組合根元素，承載選項、選擇模式與公開選中值。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
