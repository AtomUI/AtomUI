<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="https://atomui.net/toolkits/gallery-base">
    <ControlTheme x:Key="{x:Type gallery:GalleryShowCaseHost}"
                  TargetType="{x:Type gallery:GalleryShowCaseHost}">
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type gallery:GalleryShowCaseHost}">
                <!-- The two content slots, Examples and SemanticParts, stay mounted and switching tabs only flips
                IsVisible: a subtree with IsVisible=False leaves measure/arrange/render entirely
                (Layoutable.MeasureCore/ArrangeCore short-circuit), which avoids the full-tree relayout stall that
                swapping the content of a single presenter causes when two deep trees detach and attach back and
                forth. The Content and IsVisible of the two slots are driven directly by the host in
                OnApplyTemplate and UpdateTabContent: they sit in the content layer of GalleryStickyTabsHost, the
                presenter rebinds their TemplatedParent to GalleryStickyTabsHost, and a TemplateBinding inside the
                template cannot resolve host properties (verified at runtime).
                -->
                <gallery:GalleryStickyTabsHost
                    Name="PART_StickyHost"
                    Header="{TemplateBinding Header}"
                    StickyContent="{TemplateBinding NavigationContent}"
                    StickyContentPadding="{TemplateBinding StickyContentPadding}"
                    IsContentHeightBounded="{TemplateBinding IsSemanticPartsContentHeightBounded}"
                    ContentMinHeight="{TemplateBinding SemanticPartsContentMinHeight}">
                    <Panel>
                        <ContentPresenter Name="PART_ExamplesContentHost" />
                        <ContentPresenter Name="PART_SemanticPartsContentHost" />
                    </Panel>
                </gallery:GalleryStickyTabsHost>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
