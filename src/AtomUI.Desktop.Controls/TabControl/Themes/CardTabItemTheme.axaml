<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="CardTabItemTheme" TargetType="atom:TabItem">
        <ControlTheme.BasedOn>
            <themes:BaseTabItemTheme TargetType="atom:TabItem" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Ant Design card tabs draw the focus outline just inside the card (offset -lineWidthFocus). -->
                    <!-- item 的 Margin 交由布局系统应用一次即可；模板内再 TemplateBinding 会双重应用，
                         使卡片框缩进 item Bounds 内。 -->
                    <atom:PixelAlignedBorder Name="Frame"
                                             TemplatedControl.IsTemplateFocusTarget="True"
                                             atom:FocusOutlineAdorner.IsInset="True"
                                             BorderThickness="{TemplateBinding BorderThickness}"
                                             CornerRadius="{TemplateBinding CornerRadius}"
                                             Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}"
                                             Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <atom:IconPresenter Name="ItemIconPresenter"
                                                Classes.semantic-icon="True"
                                                Icon="{TemplateBinding Icon}" />
                            <ContentPresenter Name="ContentPresenter"
                                              Classes.semantic-label="True"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate, Converter={x:Static atom:BaseTabItemTheme.StringToTextBlockConverter}}" />
                            <atom:IconButton Name="PART_ItemCloseButton"
                                             Classes.semantic-close="True"
                                             Icon="{TemplateBinding CloseIcon}"
                                             Opacity="{TemplateBinding CloseButtonOpacity}"
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </atom:PixelAlignedBorder>
                    <Rectangle Name="LineMask"
                               Fill="{TemplateBinding Background}"
                               IsVisible="False"
                               Margin="{TemplateBinding LineMaskMargin}"/>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="Margin" Value="{atom:TabTokenResourceBinding HorizontalItemMargin}" />
        <Setter Property="Background" Value="{atom:TabTokenResourceBinding CardBg}" />
        <Setter Property="BorderBrush" Value="{atom:TabItemTokenResource ColorBorderSecondary}" />

        <Style Selector="^:selected">
            <Setter Property="Background" Value="{atom:TabItemTokenResource ColorBgContainer}" />
            <Style Selector="^ /template/ Rectangle#LineMask">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[IsTabReorderDragging=True]">
            <Setter Property="Background" Value="{atom:TabItemTokenResource ColorBgContainer}" />
            <Style Selector="^ /template/ Rectangle#LineMask">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Top], ^[TabStripPlacement=Bottom]">

            <Setter Property="Margin" Value="{atom:TabTokenResourceBinding HorizontalItemMargin}" />
            <Style Selector="^[SizeType=Large]">
                <Setter Property="Padding" Value="{atom:TabTokenResourceBinding CardPadding}" />
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Setter Property="Padding" Value="{atom:TabTokenResourceBinding CardPadding}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Padding" Value="{atom:TabTokenResourceBinding CardPadding}" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Left], ^[TabStripPlacement=Right]">
            <Style Selector="^[SizeType=Large]">
                <Setter Property="Padding"
                        Value="{atom:TabTokenResourceBinding VerticalItemPadding}" />
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Setter Property="Padding"
                        Value="{atom:TabTokenResourceBinding VerticalItemPadding}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Padding"
                        Value="{atom:TabTokenResourceBinding VerticalItemPadding}" />
            </Style>
        </Style>

        <!-- 分为上、右、下、左 -->
        <Style Selector="^[TabStripPlacement=Top]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style Selector="^ /template/ Rectangle#LineMask">
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Height"
                        Value="{atom:TabItemTokenResource LineWidth}" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Right]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style Selector="^ /template/ Rectangle#LineMask">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Width"
                        Value="{atom:TabItemTokenResource LineWidth}" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Bottom]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style Selector="^ /template/ Rectangle#LineMask">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Height"
                        Value="{atom:TabItemTokenResource LineWidth}" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Left]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style Selector="^ /template/ Rectangle#LineMask">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Width"
                        Value="{atom:TabItemTokenResource LineWidth}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background"
                    Value="{atom:TabItemTokenResource ColorBgContainerDisabled}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <DoubleTransition Property="CloseButtonOpacity" atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

    </ControlTheme>
</ResourceDictionary>
