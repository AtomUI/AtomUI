<!-- owner: this shared theme also serves SubmitButton and ResetButton; each terminal supplies its Own inputs. -->
<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.ButtonTheme"
              TargetType="atom:Button">
    <ControlTheme.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="ButtonAppearanceResources.axaml" />
                <ResourceInclude Source="AntButtonTemplateResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ControlTheme.Resources>
    <ControlTheme.BasedOn>
        <StaticResource ResourceKey="AtomUI.Button.Appearance" />
    </ControlTheme.BasedOn>
    <Setter Property="Template" Value="{StaticResource AtomUI.Button.Template}" />

    <Style Selector="^:is(atom|Button)">

        <Style Selector="^[ButtonType=Dashed]">
            <Setter Property="Template" Value="{StaticResource AtomUI.Button.DashedTemplate}" />
        </Style>

        <Style Selector="^[EffectiveVariant=Dashed]">
            <Setter Property="Template" Value="{StaticResource AtomUI.Button.DashedVariantTemplate}" />
        </Style>

    </Style>
</ControlTheme>
