<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:OtpLineEdit}" TargetType="atom:OtpLineEdit">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="PART_RootPanel">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="{atom:OtpLineEditTokenResource UniformlyPaddingXXS}">
                        <ItemsControl
                            Name="PART_CellsHost"
                            ClipToBounds="False"
                            Classes.semantic-cell-list="True"
                            ItemsSource="{TemplateBinding CellItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{Binding $parent[atom:OtpLineEdit].EffectiveCellGap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter" x:DataType="atom:OtpLineEditCellInfo">
                                    <Setter Property="ZIndex" Value="{Binding FocusZIndex}" />
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="atom:OtpLineEditCellInfo">
                                    <!-- The separator sits CellGap after its cell, the same gap as between cells (antd columnGap). -->
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="{atom:OtpLineEditTokenResource CellGap}"
                                                Classes.semantic-scope-cell="True">
                                        <atom:OtpLineEditCell
                                            Classes.semantic-cell="True"
                                            Classes.joins-previous="{Binding JoinsPreviousCell}"
                                            Classes.joins-next="{Binding JoinsNextCell}"
                                            Classes.custom-cell-width="{Binding $parent[atom:OtpLineEdit].CellWidth, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            DisplayText="{Binding DisplayText}"
                                            PlaceholderText="{Binding PlaceholderText}"
                                            IsActive="{Binding IsActive}"
                                            IsInputTarget="{Binding IsInputTarget}"
                                            IsMotionEnabled="{Binding IsMotionEnabled}"
                                            Status="{Binding EffectiveStatus}"
                                            SizeType="{Binding SizeType}"
                                            StyleVariant="{Binding StyleVariant}">
                                            <atom:OtpTextBox
                                                Name="PART_TextBox"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                TextAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Focusable="False"
                                                IsReadOnly="True"
                                                IsTabStop="False"
                                                Foreground="{Binding $parent[atom:OtpLineEditCell].Foreground}"
                                                FontSize="{Binding $parent[atom:OtpLineEditCell].FontSize}"
                                                SourcePlaceholderText="{Binding PlaceholderText}"
                                                PlaceholderForeground="{atom:OtpLineEditTokenResource ColorTextPlaceholder}"
                                                IsCellActive="{Binding IsActive}"
                                                Text="{Binding DisplayText}" />
                                        </atom:OtpLineEditCell>
                                        <!-- The separator glyph is centered by OtpSeparatorPresenter from the measured
                                        ink box of the glyph metrics of the current font, so no manual calibration
                                        is needed for any character, font or size. The container aligns with the
                                        cell center (pinned by tests).
                                        -->
                                        <Border
                                            VerticalAlignment="Center"
                                            Classes.semantic-separator="True"
                                            IsVisible="{Binding IsSeparatorVisible}">
                                            <atom:OtpSeparatorPresenter
                                                Name="PART_SeparatorPresenter"
                                                VerticalContentAlignment="Center"
                                                Content="{Binding Separator}"
                                                ContentTemplate="{Binding SeparatorTemplate}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <atom:InputClearIconButton
                            Name="PART_ClearButton"
                            Icon="{TemplateBinding ClearIcon}"
                            IsVisible="{TemplateBinding IsEffectiveShowClearButton}"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}" />
                        <ContentPresenter
                            Name="PART_FormFeedBack"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Right"
                            Content="{TemplateBinding FormFeedback}"
                            IsVisible="{TemplateBinding IsFormFeedbackVisible}" />
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="Transparent" />
        <!-- Focus is shown by the active cell's outline shadow, as in Ant Design Input.OTP. The shadow sits
             outside the cells, so neither the host nor the cells host may clip (TemplatedControl clips by default). -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="IsMotionEnabled" Value="{atom:OtpLineEditTokenResource EnableMotion}" />
        <Setter Property="JoinCells" Value="{atom:OtpLineEditTokenResource JoinCells}" />
        <Setter Property="CellGap" Value="{atom:OtpLineEditTokenResource CellGap}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    </ControlTheme>
</ResourceDictionary>
