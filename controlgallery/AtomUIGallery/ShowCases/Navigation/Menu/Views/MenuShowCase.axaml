<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Menu.MenuShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:viewModels="clr-namespace:AtomUIGallery.ShowCases.Menu"
             x:DataType="viewModels:MenuViewModel"
             x:CompileBindings="True">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Menu"
                    Category="{gallery:MenuShowCaseLangResource ComponentCategory}"
                    Status="{gallery:MenuShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:MenuShowCaseLangResource PageSubtitle}"
                    Description="{gallery:MenuShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="ItemsControl" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="viewModels:MenuViewModel">
                    <StackPanel Spacing="24">
                        <gallery:SemanticPartPreview Name="NavMenuSemanticPreview"
                                                     SemanticOwner="{Binding #NavMenuSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:NavMenu}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:NavMenu Name="NavMenuSemanticOwner"
                                              Mode="Inline"
                                              Width="260"
                                              IsMotionEnabled="False"
                                              DefaultOpenPaths="{Binding SemanticPreviewOpenPaths}"
                                              DefaultSelectedPath="{Binding SemanticPreviewSelectedPath}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                    <atom:NavMenuNode ItemKey="nav-one"
                                                      Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}"
                                                      Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
                                    <atom:NavMenuNode ItemKey="sub-menu"
                                                      Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}"
                                                      Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}">
                                        <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                                            <atom:NavMenuNode ItemKey="option-1"
                                                              Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}"
                                                              Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
                                            <atom:NavMenuNode ItemKey="option-2"
                                                              Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                                        </atom:NavMenuGroup>
                                    </atom:NavMenuNode>
                                    <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThree}">
                                        <atom:NavMenuNode ItemKey="option-3"
                                                          Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                                        <atom:NavMenuNode ItemKey="option-4"
                                                          Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                                    </atom:NavMenuGroup>
                                </atom:NavMenu>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription Path="root"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription Path="item"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemDescription}" />
                                <gallery:SemanticPartDescription Path="itemIcon"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemIconDescription}" />
                                <gallery:SemanticPartDescription Path="itemContent"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemContentDescription}" />
                                <gallery:SemanticPartDescription Path="itemTitle"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemTitleDescription}" />
                                <gallery:SemanticPartDescription Path="list"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticListDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.item"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.itemIcon"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemIconDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.itemContent"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemContentDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.itemTitle"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemTitleDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.list"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuListDescription}" />
                                <gallery:SemanticPartDescription Path="popup.root"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticPopupRootDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <!-- Vertical 预览：子菜单以弹层打开，popup.root 只有在弹层真实打开后才
                             挂上视觉树并成为可定位目标（Inline 模式模板里没有弹层节点，该键实例数
                             恒为 0）。弹层框体位于菜单项模板的 Popup.Child 子树，GetTemplateDescendants
                             在运行时生成的容器处中断，无法自动发现，因此在 code-behind 里把
                             Popup.Child 注册进 AdditionalRoots。 -->
                        <gallery:SemanticPartPreview Name="VerticalNavMenuSemanticPreview"
                                                     SemanticOwner="{Binding #VerticalNavMenuSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:NavMenu}"
                                                     Loaded="HandleVerticalSemanticPreviewLoaded"
                                                     Unloaded="HandleVerticalSemanticPreviewUnloaded">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:NavMenu Name="VerticalNavMenuSemanticOwner"
                                              Mode="Vertical"
                                              Width="260"
                                              IsMotionEnabled="False"
                                              IsPopupPinnedOpen="True"
                                              DefaultOpenPaths="{Binding SemanticPreviewOpenPaths}"
                                              DefaultSelectedPath="{Binding SemanticPreviewSelectedPath}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                    <atom:NavMenuNode ItemKey="nav-one"
                                                      Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}"
                                                      Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
                                    <atom:NavMenuNode ItemKey="sub-menu"
                                                      Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}"
                                                      Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}">
                                        <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                                            <atom:NavMenuNode ItemKey="option-1"
                                                              Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}"
                                                              Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
                                            <atom:NavMenuNode ItemKey="option-2"
                                                              Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                                        </atom:NavMenuGroup>
                                    </atom:NavMenuNode>
                                    <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThree}">
                                        <atom:NavMenuNode ItemKey="option-3"
                                                          Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                                        <atom:NavMenuNode ItemKey="option-4"
                                                          Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                                    </atom:NavMenuGroup>
                                </atom:NavMenu>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription Path="root"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription Path="item"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemDescription}" />
                                <gallery:SemanticPartDescription Path="itemIcon"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemIconDescription}" />
                                <gallery:SemanticPartDescription Path="itemContent"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemContentDescription}" />
                                <gallery:SemanticPartDescription Path="itemTitle"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemTitleDescription}" />
                                <gallery:SemanticPartDescription Path="list"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticListDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.item"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.itemIcon"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemIconDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.itemContent"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemContentDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.itemTitle"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemTitleDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.list"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuListDescription}" />
                                <gallery:SemanticPartDescription Path="popup.root"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticPopupRootDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <!-- 普通 Menu 预览：菜单栏顶层项用 TopLevelMenuItemTheme（无弹层时只暴露
                             一级 item/itemIcon/itemContent），子菜单项用 MenuItemTheme，弹层框体与
                             分组标题/列表在弹层打开并展开子菜单后才成为可定位目标。与两个 NavMenu
                             预览并列，覆盖普通 Menu 自己的 12 个键路径。 -->
                        <gallery:SemanticPartPreview Name="MenuSemanticPreview"
                                                     SemanticOwner="{Binding #MenuSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:Menu}"
                                                     Loaded="HandleMenuSemanticPreviewLoaded"
                                                     Unloaded="HandleMenuSemanticPreviewUnloaded">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:Menu Name="MenuSemanticOwner"
                                           IsMotionEnabled="False"
                                           IsPopupPinnedOpen="True"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderFile}"
                                                   Icon="{antdicons:AntDesignIconProvider Kind=FileOutlined}">
                                        <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewTextFile}"
                                                       Icon="{antdicons:AntDesignIconProvider Kind=FileAddOutlined}"
                                                       InputGesture="Ctrl+N" />
                                        <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewFile}" />
                                        <atom:MenuSeparator />
                                        <atom:MenuItemGroup Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                                            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSave}" />
                                            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSaveAs}" />
                                        </atom:MenuItemGroup>
                                    </atom:MenuItem>
                                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderEdit}"
                                                   Icon="{antdicons:AntDesignIconProvider Kind=EditOutlined}">
                                        <atom:MenuSeparator />
                                        <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderCut}"
                                                       InputGesture="Ctrl+X" />
                                    </atom:MenuItem>
                                </atom:Menu>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription Path="root"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription Path="item"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemDescription}" />
                                <gallery:SemanticPartDescription Path="itemIcon"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemIconDescription}" />
                                <gallery:SemanticPartDescription Path="itemContent"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemContentDescription}" />
                                <gallery:SemanticPartDescription Path="itemTitle"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticItemTitleDescription}" />
                                <gallery:SemanticPartDescription Path="list"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticListDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.item"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.itemIcon"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemIconDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.itemContent"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemContentDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.itemTitle"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuItemTitleDescription}" />
                                <gallery:SemanticPartDescription Path="subMenu.list"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticSubMenuListDescription}" />
                                <gallery:SemanticPartDescription Path="popup.root"
                                                                 Description="{gallery:MenuShowCaseLangResource SemanticPopupRootDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource BasicTitle}"
        Description="{gallery:MenuShowCaseLangResource BasicDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:Menu>
            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderFile}">
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewTextFile}" InputGesture="Ctrl+N" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewFile}" InputGesture="Ctrl+Alt+N" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewWindow}" InputGesture="Ctrl+Shift+N" />
            </atom:MenuItem>
            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderEdit}">
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderUndo}" InputGesture="Ctrl+Shift+Z" />
                <atom:MenuSeparator />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X" />
            </atom:MenuItem>
            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderDisabledItem}" IsEnabled="False" />
        </atom:Menu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource IconAndSubmenuTitle}"
        Description="{gallery:MenuShowCaseLangResource IconAndSubmenuDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:Menu>
            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderFile}">
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewTextFile}" InputGesture="Ctrl+N" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewFile}" InputGesture="Ctrl+Alt+N" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewWindow}" InputGesture="Ctrl+Shift+N" />
                <atom:MenuSeparator />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSave}" InputGesture="Ctrl+S" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSaveAs}" InputGesture="Ctrl+Shift+S" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSaveAll}" InputGesture="Ctrl+K" />
                <atom:MenuSeparator />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderExit}" />
            </atom:MenuItem>
            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderEdit}">
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderUndo}" InputGesture="Ctrl+Shift+Z" />
                <atom:MenuSeparator />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X" Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C" Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D" Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderPaste}">
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderPaste}" InputGesture="Ctrl+P"
                                   Icon="{antdicons:AntDesignIconProvider Kind=FileDoneOutlined}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderPasteFromHistory}" InputGesture="Ctrl+Shift+V" />
                </atom:MenuItem>
            </atom:MenuItem>
        </atom:Menu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource ToggleTypeTitle}"
        Description="{gallery:MenuShowCaseLangResource ToggleTypeDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:Menu>
            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuA}">
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewTextFile}" InputGesture="Ctrl+N" ToggleType="Radio" GroupName="Group1" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewFile}" InputGesture="Ctrl+Alt+N" ToggleType="Radio" GroupName="Group1" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewWindow}" InputGesture="Ctrl+Shift+N" ToggleType="Radio"
                               GroupName="Group1" />
                <atom:MenuSeparator />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSave}" InputGesture="Ctrl+S" ToggleType="CheckBox" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSaveAs}" InputGesture="Ctrl+Shift+S" ToggleType="CheckBox"
                               Icon="{antdicons:AntDesignIconProvider Kind=GithubOutlined}" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSaveAll}" InputGesture="Ctrl+K" ToggleType="CheckBox"
                               Icon="{antdicons:AntDesignIconProvider Kind=CheckOutlined}" />
                <atom:MenuSeparator />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderExit}" />
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderDisabled}" IsEnabled="False" Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
            </atom:MenuItem>
        </atom:Menu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource ScrollableTitle}"
        Description="{gallery:MenuShowCaseLangResource ScrollableDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <atom:ToggleSwitch IsChecked="{Binding IsPopupScrollEnabled}" />
                <atom:TextBlock VerticalAlignment="Center"
                                Text="{gallery:MenuShowCaseLangResource P2TextEnablePopupScroll}" />
            </StackPanel>
            <atom:Menu IsScrollEnabled="{Binding IsPopupScrollEnabled}">
                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenu}">
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderMenuItem}" />
                </atom:MenuItem>
            </atom:Menu>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource MenuItemItemsSourceTitle}"
        Description="{gallery:MenuShowCaseLangResource MenuItemItemsSourceDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:Menu Name="BasicItemsSourceMenu"
                   ItemsSource="{Binding MenuItems}">
            <atom:Menu.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}"
                                  x:DataType="atom:IMenuItemData">
                    <atom:TextBlock Text="{Binding Header}" />
                </TreeDataTemplate>
            </atom:Menu.ItemTemplate>
        </atom:Menu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource InlineNavMenuItemsSourceTitle}"
        Description="{gallery:MenuShowCaseLangResource InlineNavMenuItemsSourceDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:NavMenu Mode="Inline" Name="InlineModeMenu"
                      ItemsSource="{Binding InlineNavMenuNodes}">
            <atom:NavMenu.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}"
                                  x:DataType="atom:INavMenuNode">
                    <atom:TextBlock Text="{Binding Header}" />
                </TreeDataTemplate>
            </atom:NavMenu.ItemTemplate>
        </atom:NavMenu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource NavMenuItemItemsSourceTitle}"
        Description="{gallery:MenuShowCaseLangResource NavMenuItemItemsSourceDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:NavMenu Name="ItemsSourceDemoNavMenu"
                      Mode="Inline"
                      ItemsSource="{Binding ItemsSourceDemoNavMenuNodes}"
                      SelectedItem="{Binding DefaultSelectedNode}"
                      DefaultSelectedPath="{Binding DefaultSelectedPath}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource ContextMenuTitle}"
        Description="{gallery:MenuShowCaseLangResource ContextMenuDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.Styles>
            <Style Selector="Border#ContextMenuContainer">
                <Setter Property="BorderBrush" Value="Gray" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="10" />
            </Style>
        </gallery:ShowCaseItem.Styles>
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <Border Name="ContextMenuContainer">
            <Border.ContextMenu>
                <atom:ContextMenu>
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                   Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C" Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                   Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderPaste}">
                        <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderPaste}" InputGesture="Ctrl+P"
                                       Icon="{antdicons:AntDesignIconProvider Kind=FileDoneOutlined}" />
                        <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderPasteFromHistory}" InputGesture="Ctrl+Shift+V" />
                    </atom:MenuItem>
                </atom:ContextMenu>
            </Border.ContextMenu>
            <atom:TextBlock Text="{gallery:MenuShowCaseLangResource P2TextRightClickToShowContextMenu}" />
        </Border>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource ContextMenuItemsSourceTitle}"
        Description="{gallery:MenuShowCaseLangResource ContextMenuItemsSourceDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.Styles>
            <Style Selector="Border#ItemSourcesContextMenuContainer">
                <Setter Property="BorderBrush" Value="Gray" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="10" />
            </Style>
        </gallery:ShowCaseItem.Styles>
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <Border Name="ItemSourcesContextMenuContainer">
            <Border.ContextMenu>
                <atom:ContextMenu Name="BasicContextMenu"
                                  ItemsSource="{Binding ContextMenuItems}">
                    <atom:ContextMenu.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="atom:IMenuItemData">
                            <atom:TextBlock Text="{Binding Header}" />
                        </TreeDataTemplate>
                    </atom:ContextMenu.ItemTemplate>
                </atom:ContextMenu>
            </Border.ContextMenu>
            <atom:TextBlock Text="{gallery:MenuShowCaseLangResource P2TextRightClickToShowContextMenu}" />
        </Border>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource MenuFlyoutTitle}"
        Description="{gallery:MenuShowCaseLangResource MenuFlyoutDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.Styles>
            <Style Selector="Border.ContextFlyoutContainer">
                <Setter Property="BorderBrush" Value="Gray" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="10" />
            </Style>
        </gallery:ShowCaseItem.Styles>
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <StackPanel>
            <atom:Separator Title="{gallery:MenuShowCaseLangResource P2TitleNormal}" />
            <Border Classes="ContextFlyoutContainer">
                <Border.ContextFlyout>
                    <atom:MenuFlyout IsMotionEnabled="True">
                        <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderCut}" InputGesture="Ctrl+X"
                                       Icon="{antdicons:AntDesignIconProvider Kind=ScissorOutlined}" />
                        <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderCopy}" InputGesture="Ctrl+C" Icon="{antdicons:AntDesignIconProvider Kind=CopyOutlined}" />
                        <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderDelete}" InputGesture="Ctrl+D"
                                       Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}" />
                        <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderPaste}">
                            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderPaste}" InputGesture="Ctrl+P"
                                           Icon="{antdicons:AntDesignIconProvider Kind=FileDoneOutlined}" />
                            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderPasteFromHistory}" InputGesture="Ctrl+Shift+V" />
                        </atom:MenuItem>
                    </atom:MenuFlyout>
                </Border.ContextFlyout>
                <atom:TextBlock Text="{gallery:MenuShowCaseLangResource P2TextRightClickToShowContextFlyout}" />
            </Border>

            <atom:Separator Title="{gallery:MenuShowCaseLangResource P2TitleGeneratedByTemplate}" />
            <Border Classes="ContextFlyoutContainer">
                <Border.ContextFlyout>
                    <atom:MenuFlyout IsMotionEnabled="True"
                                     ItemsSource="{Binding MenuFlyoutItems}">
                        <atom:MenuFlyout.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="atom:IMenuItemData">
                                <atom:TextBlock Text="{Binding Header}" />
                            </TreeDataTemplate>
                        </atom:MenuFlyout.ItemTemplate>
                    </atom:MenuFlyout>
                </Border.ContextFlyout>
                <atom:TextBlock Text="{gallery:MenuShowCaseLangResource P2TextRightClickToShowContextFlyout}" />
            </Border>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource VerticalNavMenuTitle}"
        Description="{gallery:MenuShowCaseLangResource VerticalNavMenuDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:NavMenu Mode="Vertical" Width="300" Margin="0, 0, 0, 20">
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}" Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}" Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}"
                              IsEnabled="False" />
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThreeSubmenu}" Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                </atom:NavMenuNode>

                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN2}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                </atom:NavMenuNode>
            </atom:NavMenuNode>
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationFour}" />
        </atom:NavMenu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource InlineMenuTitle}"
        Description="{gallery:MenuShowCaseLangResource InlineMenuDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:NavMenu Mode="Inline" Width="300" Margin="0, 0, 0, 20">
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}" Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}" Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}"
                              IsEnabled="False" />
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThreeSubmenu}" Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                </atom:NavMenuNode>

                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN2}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                </atom:NavMenuNode>
            </atom:NavMenuNode>
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationFour}" />
        </atom:NavMenu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource AccordionMenuTitle}"
        Description="{gallery:MenuShowCaseLangResource AccordionMenuDescription}"
        SourceKey="nav-menu-accordion"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:NavMenu Mode="Inline" IsAccordionMode="True" Width="300" Margin="0, 0, 0, 20">
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}"
                              Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                </atom:NavMenuNode>
            </atom:NavMenuNode>
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}"
                              Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN2}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                </atom:NavMenuNode>
            </atom:NavMenuNode>
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThreeSubmenu}"
                              Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN5}" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN6}" />
                </atom:NavMenuNode>
            </atom:NavMenuNode>
        </atom:NavMenu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource NavMenuNodeCommandTitle}"
        Description="{gallery:MenuShowCaseLangResource NavMenuNodeCommandDescription}"
        BadgeText="v6.1.0"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <StackPanel Spacing="12">
            <atom:NavMenu Mode="Inline" Width="300">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}"
                                  ItemKey="command-navigation-one"
                                  Command="{Binding NavigateCommand}"
                                  CommandParameter="navigation-one" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}"
                                  IsEnabled="False" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThreeSubmenu}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}"
                                          ItemKey="command-option-1"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="option-1" />
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}"
                                          ItemKey="command-option-2"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="option-2" />
                    </atom:NavMenuNode>

                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN2}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}"
                                          ItemKey="command-option-3"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="option-3" />
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}"
                                          ItemKey="command-option-4"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="option-4" />
                    </atom:NavMenuNode>
                </atom:NavMenuNode>
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationFour}"
                                  ItemKey="command-navigation-four"
                                  Command="{Binding NavigateCommand}"
                                  CommandParameter="navigation-four" />
            </atom:NavMenu>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <atom:TextBlock Text="{gallery:MenuShowCaseLangResource P2TextLastCommandKey}" />
                <atom:TextBlock Text="{Binding LastCommandKey}" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource InlineCollapsedMenuTitle}"
        Description="{gallery:MenuShowCaseLangResource InlineCollapsedMenuDescription}"
        BadgeText="v6.0.6"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <StackPanel Spacing="16">
            <atom:Button ButtonType="Primary"
                         Icon="{antdicons:AntDesignIconProvider Kind=MenuFoldOutlined}"
                         Click="HandleToggleInlineCollapsedClick" />
            <atom:NavMenu Mode="Inline"
                          Width="300"
                          IsDarkStyle="True"
                          IsInlineCollapsed="{Binding IsInlineCollapsed}"
                          DefaultOpenPaths="{Binding InlineCollapsedOpenPaths}"
                          DefaultSelectedPath="{Binding InlineCollapsedSelectedPath}">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}"
                                  Tooltip="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=PieChartOutlined}"
                                  ItemKey="Option1" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=DesktopOutlined}"
                                  ItemKey="Option2">
                    <atom:NavMenuNode.Tooltip>
                        <atom:ToolTip atom:ToolTip.Placement="Bottom"
                                      atom:ToolTip.PresetColor="GeekBlue"
                                      Content="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                    </atom:NavMenuNode.Tooltip>
                </atom:NavMenuNode>
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=ContainerOutlined}"
                                  ItemKey="Option3" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}"
                                  ItemKey="NavigationOne">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN5}" ItemKey="Option5" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN6}" ItemKey="Option6" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN7}" ItemKey="Option7" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN8}" ItemKey="Option8" />
                </atom:NavMenuNode>
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}"
                                  ItemKey="NavigationTwo">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}" ItemKey="NavigationTwoOption1" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" ItemKey="NavigationTwoOption2" />
                </atom:NavMenuNode>
            </atom:NavMenu>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource TopNavigationTitle}"
        Description="{gallery:MenuShowCaseLangResource TopNavigationDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <StackPanel>
            <atom:NavMenu Mode="Horizontal">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}" Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}" Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}"
                                  IsEnabled="False" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThreeSubmenu}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}" />
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                    </atom:NavMenuNode>

                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN2}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                    </atom:NavMenuNode>
                </atom:NavMenuNode>
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationFour}" />
            </atom:NavMenu>
            <atom:Separator />
            <atom:NavMenu IsDarkStyle="True" Mode="Horizontal">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}" Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}" Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}"
                                  IsEnabled="False" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThreeSubmenu}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}" />
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                    </atom:NavMenuNode>

                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN2}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                    </atom:NavMenuNode>
                </atom:NavMenuNode>
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationFour}" />
            </atom:NavMenu>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource SwitchMenuTypeTitle}"
        Description="{gallery:MenuShowCaseLangResource SwitchMenuTypeDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:ToggleSwitch Name="ChangeModeSwitch" IsCheckedChanged="HandleChangeModeCheckChanged" />
                <atom:TextBlock Text="{gallery:MenuShowCaseLangResource P2TextChangeMode}" />
                <atom:ToggleSwitch Margin="10, 0, 0, 0" Name="ChangeStyleSwitch" IsCheckedChanged="HandleChangeStyleCheckChanged" />
                <atom:TextBlock Text="{gallery:MenuShowCaseLangResource P2TextChangeStyle}" />
            </StackPanel>
            <atom:NavMenu Mode="{Binding Mode}" Width="300"
                          Margin="0, 0, 0, 20"
                          IsDarkStyle="{Binding IsDark}">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}" Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}" Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}"
                                  IsEnabled="False" />
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThreeSubmenu}"
                                  Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}" />
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                    </atom:NavMenuNode>

                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN2}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                    </atom:NavMenuNode>
                </atom:NavMenuNode>
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationFour}" />
            </atom:NavMenu>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource DefaultOpenedPathsTitle}"
        Description="{gallery:MenuShowCaseLangResource DefaultOpenedPathsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
        <atom:NavMenu Mode="Inline" Margin="0, 0, 0, 20"
                      DefaultOpenPaths="{Binding DefaultOpenPaths}"
                      DefaultSelectedPath="{Binding DefaultSelectedPath}">
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}" Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" ItemKey="1" />
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}" Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}"
                              IsEnabled="False"
                              ItemKey="2" />
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThreeSubmenu}" Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}"
                              ItemKey="3">
                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}" ItemKey="SubGroup1">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}" ItemKey="Option1" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" ItemKey="Option2" />
                </atom:NavMenuNode>

                <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderItemN2}" ItemKey="SubGroup2">
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" ItemKey="Option3" />
                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" ItemKey="Option4" />
                </atom:NavMenuNode>
            </atom:NavMenuNode>
            <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationFour}" ItemKey="4" />
        </atom:NavMenu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource NavMenuCompositionTitle}"
        Description="{gallery:MenuShowCaseLangResource NavMenuCompositionDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
                <atom:NavMenu Mode="Inline"
                              Width="320"
                              ItemSpacing="4"
                              IsInlineCollapsed="{Binding IsStructuredNavMenuCollapsed}">
                    <atom:NavMenu.Header>
                        <Grid Margin="8"
                              ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        IsVisible="{Binding IsStructuredNavMenuCollapsed, Converter={x:Static BoolConverters.Not}}"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=ProductOutlined}" />
                                <atom:TextBlock VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{gallery:MenuShowCaseLangResource P2HeaderWorkspaceNavigation}" />
                            </StackPanel>
                            <atom:Button Grid.Column="1"
                                         ButtonType="Primary"
                                         Icon="{antdicons:AntDesignIconProvider Kind=MenuFoldOutlined}"
                                         Click="HandleToggleStructuredNavMenuCollapsedClick" />
                        </Grid>
                    </atom:NavMenu.Header>

                    <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderWorkspaceGroup}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderDashboard}"
                                          Icon="{antdicons:AntDesignIconProvider Kind=DashboardOutlined}" />
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderProjects}"
                                          Icon="{antdicons:AntDesignIconProvider Kind=ProjectOutlined}" />
                    </atom:NavMenuGroup>

                    <atom:NavMenuDivider />

                    <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderAccountGroup}">
                        <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderAccountSettings}"
                                          Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                            <atom:NavMenuNode.Entries>
                                <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderManagementGroup}">
                                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderTeamMembers}" />
                                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderPermissions}" />
                                </atom:NavMenuGroup>

                                <atom:NavMenuDivider />

                                <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderPersonalGroup}">
                                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderProfile}" />
                                    <atom:NavMenuNode Header="{gallery:MenuShowCaseLangResource P2HeaderSecurity}" />
                                </atom:NavMenuGroup>
                            </atom:NavMenuNode.Entries>
                        </atom:NavMenuNode>
                    </atom:NavMenuGroup>

                    <atom:NavMenu.Footer>
                        <atom:TextBlock Margin="12,12,12,8"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                        Text="{gallery:MenuShowCaseLangResource P2TextCurrentWorkspace}" />
                    </atom:NavMenu.Footer>
                </atom:NavMenu>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MenuShowCaseLangResource SemanticPartStyleTitle}"
        Description="{gallery:MenuShowCaseLangResource SemanticPartStyleDescription}"
        SourceKey="menu-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        Span="Full"
        MinHeight="300"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:MenuViewModel">
                <StackPanel Spacing="16">
                    <StackPanel.Styles>
                        <Style Selector="atom|NavMenu.semantic-style-demo">
                            <Setter Property="Background" Value="#FAFAFA" />
                            <Setter Property="BorderBrush" Value="#D9D9D9" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Padding" Value="8" />
                            <atom:NavMenuItemStyle x:SetterTargetType="HeaderedSelectingItemsControl">
                                <Setter Property="Foreground" Value="#1677FF" />
                                <Setter Property="MinHeight" Value="36" />
                            </atom:NavMenuItemStyle>
                            <atom:NavMenuItemIconStyle x:SetterTargetType="atom:IconPresenter">
                                <Setter Property="IconBrush" Value="#1677FF" />
                            </atom:NavMenuItemIconStyle>
                            <atom:NavMenuItemContentStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="FontWeight" Value="Bold" />
                            </atom:NavMenuItemContentStyle>
                            <atom:NavMenuItemTitleStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </atom:NavMenuItemTitleStyle>
                            <atom:NavMenuListStyle x:SetterTargetType="ItemsPresenter">
                                <Setter Property="Margin" Value="0,2,0,0" />
                            </atom:NavMenuListStyle>
                            <atom:NavMenuPopupRootStyle x:SetterTargetType="Border">
                                <Setter Property="BorderBrush" Value="#D9D9D9" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Padding" Value="8" />
                            </atom:NavMenuPopupRootStyle>
                        </Style>
                        <Style Selector="atom|NavMenu.semantic-inline-style-demo">
                            <Setter Property="Background" Value="#F0F5FF" />
                            <atom:NavMenuSubMenuItemStyle x:SetterTargetType="HeaderedSelectingItemsControl">
                                <Setter Property="Foreground" Value="#FA541C" />
                            </atom:NavMenuSubMenuItemStyle>
                            <atom:NavMenuSubMenuListStyle x:SetterTargetType="ItemsPresenter">
                                <Setter Property="Margin" Value="0,4,0,0" />
                            </atom:NavMenuSubMenuListStyle>
                            <atom:NavMenuSubMenuItemTitleStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </atom:NavMenuSubMenuItemTitleStyle>
                            <atom:NavMenuSubMenuItemContentStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="FontWeight" Value="Bold" />
                            </atom:NavMenuSubMenuItemContentStyle>
                        </Style>
                        <Style Selector="atom|Menu.semantic-style-demo">
                            <Setter Property="Background" Value="#FAFAFA" />
                            <Setter Property="BorderBrush" Value="#D9D9D9" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Padding" Value="4" />
                            <atom:MenuItemStyle x:SetterTargetType="MenuItem">
                                <Setter Property="Foreground" Value="#1677FF" />
                                <Setter Property="MinHeight" Value="36" />
                            </atom:MenuItemStyle>
                            <atom:MenuItemIconStyle x:SetterTargetType="atom:IconPresenter">
                                <Setter Property="IconBrush" Value="#1677FF" />
                            </atom:MenuItemIconStyle>
                            <atom:MenuItemContentStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="FontWeight" Value="Bold" />
                            </atom:MenuItemContentStyle>
                            <atom:MenuPopupRootStyle x:SetterTargetType="Border">
                                <Setter Property="BorderBrush" Value="#D9D9D9" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Padding" Value="8" />
                            </atom:MenuPopupRootStyle>
                        </Style>
                        <Style Selector="atom|Menu.semantic-sub-menu-style-demo">
                            <Setter Property="Background" Value="#F0F5FF" />
                            <Setter Property="Padding" Value="4" />
                            <atom:MenuSubMenuItemStyle x:SetterTargetType="MenuItem">
                                <Setter Property="Foreground" Value="#FA541C" />
                            </atom:MenuSubMenuItemStyle>
                            <atom:MenuSubMenuItemIconStyle x:SetterTargetType="atom:IconPresenter">
                                <Setter Property="IconBrush" Value="#FA541C" />
                            </atom:MenuSubMenuItemIconStyle>
                            <atom:MenuSubMenuItemContentStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="FontWeight" Value="Bold" />
                            </atom:MenuSubMenuItemContentStyle>
                            <atom:MenuSubMenuItemTitleStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </atom:MenuSubMenuItemTitleStyle>
                            <atom:MenuSubMenuListStyle x:SetterTargetType="ItemsPresenter">
                                <Setter Property="Margin" Value="0,4,0,0" />
                            </atom:MenuSubMenuListStyle>
                        </Style>
                    </StackPanel.Styles>

                    <!-- 第一行：两个 NavMenu 并排对照 -->
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <atom:NavMenu Classes="semantic-style-demo"
                                      Mode="Vertical"
                                      Width="240"
                                      VerticalAlignment="Top"
                                      DefaultOpenPaths="{Binding SemanticPreviewOpenPaths}">
                            <atom:NavMenuNode ItemKey="sub-menu"
                                              Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}"
                                              Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}">
                                <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                                    <atom:NavMenuNode ItemKey="option-1"
                                                      Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}"
                                                      Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
                                    <atom:NavMenuNode ItemKey="option-2"
                                                      Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                                </atom:NavMenuGroup>
                            </atom:NavMenuNode>
                            <atom:NavMenuNode ItemKey="nav-two"
                                              Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}" />
                            <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThree}">
                                <atom:NavMenuNode ItemKey="option-3"
                                                  Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                                <atom:NavMenuNode ItemKey="option-4"
                                                  Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                            </atom:NavMenuGroup>
                        </atom:NavMenu>

                        <atom:NavMenu Classes="semantic-inline-style-demo"
                                      Mode="Inline"
                                      Width="240"
                                      VerticalAlignment="Top"
                                      DefaultOpenPaths="{Binding SemanticPreviewOpenPaths}">
                            <atom:NavMenuNode ItemKey="sub-menu"
                                              Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationOne}"
                                              Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}">
                                <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                                    <atom:NavMenuNode ItemKey="option-1"
                                                      Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN1}"
                                                      Icon="{antdicons:AntDesignIconProvider Kind=MailOutlined}" />
                                    <atom:NavMenuNode ItemKey="option-2"
                                                      Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN2}" />
                                </atom:NavMenuGroup>
                            </atom:NavMenuNode>
                            <atom:NavMenuNode ItemKey="nav-two"
                                              Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationTwo}" />
                            <atom:NavMenuGroup Header="{gallery:MenuShowCaseLangResource P2HeaderNavigationThree}">
                                <atom:NavMenuNode ItemKey="option-3"
                                                  Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN3}" />
                                <atom:NavMenuNode ItemKey="option-4"
                                                  Header="{gallery:MenuShowCaseLangResource P2HeaderOptionN4}" />
                            </atom:NavMenuGroup>
                        </atom:NavMenu>
                    </StackPanel>

                    <!-- 第二行：两个普通 Menu 菜单栏并排；弹层完全收起，点击菜单项展开 -->
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <!-- 一级 item 部件：菜单栏顶层项，只命中一级 marker。 -->
                        <atom:Menu Classes="semantic-style-demo"
                                   IsMotionEnabled="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top">
                            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderFile}"
                                           Icon="{antdicons:AntDesignIconProvider Kind=FileOutlined}">
                                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewTextFile}" />
                                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewFile}" />
                            </atom:MenuItem>
                            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderEdit}"
                                           Icon="{antdicons:AntDesignIconProvider Kind=EditOutlined}">
                                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderCut}" />
                            </atom:MenuItem>
                        </atom:Menu>

                        <!-- subMenu.* 部件：弹层内部的菜单项、分组标题与分组列表。 -->
                        <atom:Menu Classes="semantic-sub-menu-style-demo"
                                   IsMotionEnabled="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top">
                            <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderFile}"
                                           Icon="{antdicons:AntDesignIconProvider Kind=FileOutlined}">
                                <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderNewTextFile}"
                                               Icon="{antdicons:AntDesignIconProvider Kind=FileAddOutlined}" />
                                <atom:MenuItemGroup Header="{gallery:MenuShowCaseLangResource P2HeaderItemN1}">
                                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSave}"
                                                   Icon="{antdicons:AntDesignIconProvider Kind=SaveOutlined}" />
                                    <atom:MenuItem Header="{gallery:MenuShowCaseLangResource P2HeaderSaveAs}"
                                                   Icon="{antdicons:AntDesignIconProvider Kind=SaveOutlined}" />
                                </atom:MenuItemGroup>
                            </atom:MenuItem>
                        </atom:Menu>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
