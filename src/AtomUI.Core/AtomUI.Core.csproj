<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(AtomUITargetFrameworks)</TargetFrameworks>
        <RootNamespace>AtomUI</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>GeneratedFiles</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../AtomUI.Localization/AtomUI.Localization.csproj" />
        <ProjectReference Include="../AtomUI.Generator/AtomUI.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/**/*.*"/>
        <EmbeddedResource Include="../../docs/reference/theming/schemas/atomui-theme-v1.xsd"
                          LogicalName="AtomUI.Theme.Definitions.Schemas.atomui-theme-v1.xsd" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.X11" />
        <PackageReference Include="Avalonia.Native" />
        <PackageReference Include="Avalonia.Win32" />
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="System.Reactive"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AtomUI.Controls"/>
        <InternalsVisibleTo Include="AtomUI.Controls.Shared"/>
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls"/>
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls.DataGrid"/>
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls.ColorPicker"/>
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls.Extras"/>
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls.Tests"/>
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls.DataGrid.Tests"/>
        <InternalsVisibleTo Include="AtomUI.Core.Tests"/>
        <InternalsVisibleTo Include="AtomUI.Registration.Fixtures"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="AvaloniaVersion" Value="$(AvaloniaVersion)" />
        <AssemblyMetadata Include="AtomUIVersion" Value="$(AtomUIVersion)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport"/>
    </ItemGroup>

    <!-- Always validate when compiling Core; write-if-changed keeps compiler inputs stable.
         This covers XML, XSD and reader/emitter changes without a stale input timestamp list. -->
    <Target Name="GenerateAtomUIBuiltInThemeDocument" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
        <PropertyGroup>
            <_AtomUIBuiltInThemeCode>$(IntermediateOutputPath)BuiltInThemeDocument.g.cs</_AtomUIBuiltInThemeCode>
        </PropertyGroup>
        <AtomUI.Build.Tasks.GenerateBuiltInThemeDocumentTask TaskAssembly="$(AtomUIBuildTasksAssembly)" DotNetPath="$(DOTNET_HOST_PATH)"
            SourcePath="$(MSBuildProjectDirectory)/Assets/Themes/DaybreakBlue.theme.xml"
            SourceIdentity="avares://atomui.core/Assets/Themes/DaybreakBlue.theme.xml"
            GeneratedCodePath="$(_AtomUIBuiltInThemeCode)" />
        <ItemGroup>
            <Compile Include="$(_AtomUIBuiltInThemeCode)" />
            <FileWrites Include="$(_AtomUIBuiltInThemeCode)" />
        </ItemGroup>
    </Target>
</Project>
