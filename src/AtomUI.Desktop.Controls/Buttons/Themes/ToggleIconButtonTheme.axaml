<ControlTheme TargetType="atom:ToggleIconButton"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.ToggleIconButtonTheme"
              x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:ToggleIconButton">
            <atom:PixelAlignedBorder
                Name="Frame"
                BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{TemplateBinding BorderBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="{TemplateBinding Background}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="{TemplateBinding Padding}">
                <Panel Name="PART_RootLayout">
                    <atom:IconPresenter
                        Name="PART_CheckedIconPresenter"
                        Icon="{TemplateBinding CheckedIcon}"
                        IsVisible="{TemplateBinding IsChecked}"
                        Width="{TemplateBinding IconWidth}"
                        Height="{TemplateBinding IconHeight}"
                        IconBrush="{TemplateBinding IconBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <atom:IconPresenter
                        Name="PART_UnCheckedIconPresenter"
                        Icon="{TemplateBinding UnCheckedIcon}"
                        Width="{TemplateBinding IconWidth}"
                        Height="{TemplateBinding IconHeight}"
                        IsVisible="{TemplateBinding IsChecked, Converter={x:Static BoolConverters.Not}}"
                        IconBrush="{TemplateBinding IconBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Panel>
            </atom:PixelAlignedBorder>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|ToggleIconButton)">
        <Setter Property="IconWidth" Value="{atom:ToggleIconButtonTokenResource IconSizeSM}" />
        <Setter Property="IconHeight" Value="{atom:ToggleIconButtonTokenResource IconSizeSM}" />
        <Setter Property="IsMotionEnabled" Value="{atom:ToggleIconButtonTokenResource EnableMotion}" />
        <Setter Property="CornerRadius" Value="{atom:ToggleIconButtonTokenResource BorderRadiusSM}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="IconBrush"
                Value="{atom:ToggleIconButtonTokenResource ColorIcon}" />

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="StateTransitionDuration" />
                        <atom:SolidColorBrushTransition Property="IconBrush" atom:TokenTransitions.Duration="StateTransitionDuration" />
                        <TransformOperationsTransition Property="RenderTransform" atom:TokenTransitions.Duration="StateTransitionDuration" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="IconBrush"
                    Value="{atom:ToggleIconButtonTokenResource ColorIconHover}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="IconBrush"
                    Value="{atom:ToggleIconButtonTokenResource ColorText}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="IconBrush"
                    Value="{atom:ToggleIconButtonTokenResource ColorTextDisabled}" />
        </Style>

    </Style>
</ControlTheme>
