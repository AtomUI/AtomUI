<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:Class="AtomUI.Desktop.Controls.Themes.WindowTitleBarButtonTheme"
    x:ClassModifier="internal"
    TargetType="atom:WindowTitleBarButton">
    <ControlTheme.BasedOn>
        <themes:IconButtonTheme TargetType="{x:Type atom:WindowTitleBarButton}" />
    </ControlTheme.BasedOn>

    <!-- Reuses the shared geometry shell of the managed caption: CaptionButtonFrame owns the background layer and the
    content layer, and only the presenter contract of the AddOn is declared here, so the geometry structure of the
    caption band is not duplicated.
    -->
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:WindowTitleBarButton">
            <atom:CaptionButtonFrame Background="{TemplateBinding Background}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Padding="{TemplateBinding Padding}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch">
                <atom:IconPresenter Name="IconPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding IconBrush}"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}" />
            </atom:CaptionButtonFrame>
        </ControlTemplate>
    </Setter>

    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="{atom:WindowTitleBarButtonTokenResource CaptionButtonPadding}" />
    <Setter Property="IconWidth" Value="{atom:WindowTitleBarButtonTokenResource CaptionButtonIconSize}" />
    <Setter Property="IconHeight" Value="{atom:WindowTitleBarButtonTokenResource CaptionButtonIconSize}" />
    <Setter Property="CornerRadius" Value="{atom:WindowTitleBarButtonTokenResource BorderRadiusSM}" />
    <Setter Property="Background" Value="{atom:WindowTitleBarButtonTokenResource ActiveBgColor}" />
    <Setter Property="IconBrush" Value="{atom:WindowTitleBarButtonTokenResource ActiveColor}" />

    <Style Selector="^[IsWindowActive=False]">
        <Setter Property="Background" Value="{atom:WindowTitleBarButtonTokenResource InactiveBgColor}" />
        <Setter Property="IconBrush" Value="{atom:WindowTitleBarButtonTokenResource InactiveColor}" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{atom:WindowTitleBarButtonTokenResource InactiveHoverBgColor}" />
        </Style>
    </Style>

    <Style Selector="^[IsWindowActive=True]:pointerover">
        <Setter Property="Background" Value="{atom:WindowTitleBarButtonTokenResource ActiveHoverBgColor}" />
    </Style>

    <Style Selector="^:pressed">
        <Setter Property="Background" Value="{atom:WindowTitleBarButtonTokenResource ActivePressedBgColor}" />
    </Style>

    <Style Selector="^:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IconBrush" Value="{atom:WindowTitleBarButtonTokenResource ColorTextDisabled}" />
    </Style>

    <Style Selector="^[IsWindowActive=False]:disabled">
        <Setter Property="IconBrush" Value="{atom:WindowTitleBarButtonTokenResource ColorTextDisabled}" />
    </Style>

    <Style Selector="^[HostMotionEnabled=False]">
        <Setter Property="IsMotionEnabled" Value="False" />
    </Style>

    <Style Selector="^[HostOsType=macOS]">
        <Setter Property="CornerRadius" Value="{atom:WindowTitleBarButtonTokenResource CaptionButtonCornerRadius}" />
    </Style>

    <Style Selector="^[HostOsType=Linux]">
        <Setter Property="CornerRadius" Value="{atom:WindowTitleBarButtonTokenResource CaptionButtonCornerRadius}" />
        <Style Selector="^ /template/ atom|CaptionButtonFrame">
            <Setter Property="BackgroundInset" Value="{atom:WindowTitleBarButtonTokenResource CaptionButtonBackgroundInset}" />
        </Style>
    </Style>

    <Style Selector="^[HostOsType=Windows]">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <!-- layout: fixed template or platform geometry; preserve existing dimensions and hit regions. -->
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{atom:WindowTitleBarButtonTokenResource ActiveHoverBgColor}" />
        </Style>

        <Style Selector="^[IsWindowActive=False]">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IconBrush" Value="{atom:WindowTitleBarButtonTokenResource InactiveColor}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{atom:WindowTitleBarButtonTokenResource InactiveHoverBgColor}" />
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{atom:WindowTitleBarButtonTokenResource ActivePressedBgColor}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IconBrush" Value="{atom:WindowTitleBarButtonTokenResource ColorTextDisabled}" />
        </Style>
    </Style>
</ControlTheme>
