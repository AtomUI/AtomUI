<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:DialogSurface}" TargetType="atom:DialogSurface">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
        <Setter Property="MotionDuration" Value="{atom:SharedTokenResource MotionDurationMid}" />
        <Setter Property="ContentViewportMinWidth" Value="{atom:DialogTokenResource MinWidth}" />
        <Setter Property="ContentViewportMinHeight" Value="{atom:DialogTokenResource MinHeight}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:DialogSurface">
                <Panel>
                    <atom:ShadowsAwareContainer Name="PART_ShadowHost"
                                                Classes.semantic-scope-frame-host="True"
                                                IsOverlayMode="True">
                        <Border Name="Frame"
                                Classes.semantic-container="True"
                                ClipToBounds="True">
                            <DockPanel Name="PART_SurfaceContentLayer"
                                       Classes.semantic-scope-content-layer="True"
                                       LastChildFill="True">
                                <atom:OverlayDialogHeader Name="PART_Header"
                                                          Classes.semantic-scope-header="True"
                                                          DockPanel.Dock="Top"
                                                          IsVisible="{TemplateBinding IsHeaderVisible}"
                                                          Title="{TemplateBinding Title}"
                                                          Logo="{TemplateBinding TitleIcon}"
                                                          IsCloseButtonEnabled="{TemplateBinding IsClosable}"
                                                          IsMaximizeButtonEnabled="{TemplateBinding IsMaximizable}"
                                                          IsDialogMaximized="{TemplateBinding IsDialogMaximized}"
                                                          IsMotionEnabled="{TemplateBinding IsMotionEnabled}" />
                                <Border Name="FooterFrame"
                                        Classes.semantic-footer="True"
                                        DockPanel.Dock="Bottom"
                                        IsVisible="{TemplateBinding IsEffectiveFooterVisible}">
                                    <atom:DialogButtonBox Name="PART_ButtonBox"
                                                          IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                          StandardButtons="{TemplateBinding StandardButtons}"
                                                          DefaultStandardButton="{TemplateBinding DefaultStandardButton}"
                                                          EscapeStandardButton="{TemplateBinding EscapeStandardButton}" />
                                </Border>
                                <Border Name="ContentFrame"
                                        Classes.semantic-body="True"
                                        ClipToBounds="True">
                                    <atom:Skeleton IsLoading="{TemplateBinding IsLoading}"
                                                   IsActive="True"
                                                   ParagraphRows="4"
                                                   IsShowTitle="False"
                                                   ClipToBounds="False"
                                                   Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Border>
                            </DockPanel>
                        </Border>
                    </atom:ShadowsAwareContainer>
                    <atom:OverlayDialogResizer Name="PART_Resizer"
                                               IsVisible="{TemplateBinding IsResizable}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- container 的背景/圆角必须走 ControlTheme 样式而不是模板局部值：局部值优先级压过
             任何 Style setter，DialogContainerStyle（owner 实例级语义样式）将永远无法覆盖。
             CornerRadius 经 TemplatedParent 绑定保持对 Surface 运行时变更（如最大化归零）的跟随。 -->
        <Style Selector="^ /template/ Border#Frame">
            <Setter Property="Background" Value="{atom:DialogTokenResource ContentBg}" />
            <Setter Property="CornerRadius"
                    Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>

        <Style Selector="^ /template/ atom|OverlayDialogHeader#PART_Header">
            <Setter Property="TitleFontSize" Value="{atom:DialogTokenResource HeaderFontSize}" />
            <Setter Property="TitleFontWeight" Value="{atom:SharedTokenResource FontWeightStrong}" />
            <Setter Property="Margin" Value="{atom:DialogTokenResource HeaderMarginBottom}" />
        </Style>

        <Style Selector="^.overlay-hosted /template/ atom|ShadowsAwareContainer#PART_ShadowHost">
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource BoxShadows}" />
        </Style>

        <Style Selector="^.window-hosted">
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="^ /template/ Border#ContentFrame">
            <Setter Property="Padding" Value="{atom:DialogTokenResource ContentPadding}" />
        </Style>

        <!-- Window host hides the Overlay header because the native window owns the title bar.
             Keep the body vertically separated from that title bar and preserve the same
             horizontal content inset used by the Overlay host. -->
        <Style Selector="^.window-hosted /template/ Border#ContentFrame">
            <Setter Property="Padding" Value="{atom:DialogTokenResource WindowContentPadding}" />
        </Style>

        <Style Selector="^ /template/ atom|Skeleton">
            <Setter Property="Margin" Value="{atom:DialogTokenResource LoadingIndicatorMargin}" />
        </Style>

        <Style Selector="^ /template/ Border#FooterFrame">
            <Setter Property="Background" Value="{atom:DialogTokenResource FooterBg}" />
            <Setter Property="Margin" Value="{atom:DialogTokenResource FooterMarginTop}" />
            <Setter Property="Padding" Value="{atom:DialogTokenResource FooterPadding}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
