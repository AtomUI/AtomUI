    <unit id="PageDescription">
      <segment>
        <source>ColorPicker supports solid and gradient values, trigger sizing, alpha control, text rendering, value synchronization, hover or click triggers, and preset palettes.</source>
        <target state="translated">ColorPicker 支援純色與漸變值、觸發器尺寸、透明度控制、文字渲染、值同步策略、點擊或懸浮觸發，以及預設調色板。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Pick solid colors or gradients from a compact trigger.</source>
        <target state="translated">從緊湊觸發器中選擇純色或漸變色。</target>
      </segment>
    </unit>
    <unit id="PresetColorsDescription">
      <segment>
        <source>Set the presets color of the color picker.</source>
        <target state="translated">設置顏色選擇器的預設顏色。</target>
      </segment>
    </unit>
    <unit id="PresetColorsTitle">
      <segment>
        <source>Preset Colors</source>
        <target state="translated">預設顏色</target>
      </segment>
    </unit>
    <unit id="RenderingTriggerTextDescription">
      <segment>
        <source>Renders the default text of the trigger, effective when showText is true. When customizing text, you can use showText as a function to return custom text.</source>
        <target state="translated">當 showText 為 true 時渲染觸發器默認文本。自定義文本時，可以將 showText 作為函數返回自定義文本。</target>
      </segment>
    </unit>
    <unit id="RenderingTriggerTextTitle">
      <segment>
        <source>Rendering Trigger Text</source>
        <target state="translated">渲染觸發器文本</target>
      </segment>
    </unit>
