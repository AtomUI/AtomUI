<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:viewer="clr-namespace:AtomUI.Desktop.Controls.Internal.DateViewer"
              x:Class="AtomUI.Desktop.Controls.Themes.DateViewerTheme"
              x:ClassModifier="internal" TargetType="atom:DateViewer">
    <ControlTheme.Resources>
        <atom:BorderThicknessFilterConverter x:Key="FooterLine" Left="False" Right="False" Bottom="False" />
    </ControlTheme.Resources>
    <Setter Property="FontFamily">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
            <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontFamily" />
        </MultiBinding>
    </Setter>
    <Setter Property="FontSize">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
            <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontSize" />
        </MultiBinding>
    </Setter>
    <Setter Property="Background" Value="{atom:DateViewerTokenResource PanelBg}" />
    <Setter Property="Padding" Value="{atom:DateViewerTokenResource PanelPadding}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:DateViewer">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <DockPanel LastChildFill="True">
                    <viewer:DateViewerHeader DockPanel.Dock="Top" Classes.semantic-header="True"
                                             Context="{TemplateBinding HeaderContext}"
                                             HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                             IsVisible="{TemplateBinding ShowHeader}" />
                    <atom:PixelAlignedBorder Name="PART_DefaultFooter" Classes.semantic-footer="True" DockPanel.Dock="Bottom"
                                             IsVisible="{TemplateBinding IsDefaultFooterVisible}">
                        <atom:Button Name="PART_StandaloneTodayButton" ButtonType="Link" SizeType="Small"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Content="{atom:DateViewerLangResource Today}"
                                     Command="{TemplateBinding TodayCommand}" />
                    </atom:PixelAlignedBorder>
                    <Panel Classes.semantic-body="True">
                    <viewer:DatePanel Classes.semantic-content="True" Name="PART_PrimaryPanel"
                                  Session="{TemplateBinding PanelSession}"
                                  Theme="{TemplateBinding PanelTheme}"
                                  CellTemplate="{TemplateBinding CellTemplate}"
                                  FullCellTemplate="{TemplateBinding FullCellTemplate}"
                                  DefaultFullCellTemplate="{TemplateBinding DefaultFullCellTemplate}"
                                  CellTheme="{TemplateBinding CellTheme}"
                                  Presentation="{TemplateBinding Presentation}" />
                    </Panel>
                </DockPanel>
            </Border>
        </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_DefaultFooter">
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorderSecondary}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource Kind=BorderThickness, Converter={StaticResource FooterLine}}" />
        <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightLG}" />
    </Style>
    <Style Selector="^[Presentation=Content]">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
</ControlTheme>
