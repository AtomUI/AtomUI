<ControlTheme TargetType="atom:AbstractTransfer"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:antdicons="https://atomui.net/icons/antdesign"
              xmlns:system="using:System"
              x:Class="AtomUI.Desktop.Controls.Themes.AbstractTransferTheme">
    <Setter Property="FontFamily">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
            <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontFamily" />
        </MultiBinding>
    </Setter>

    <Setter Property="FontSize">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
            <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontSize" />
        </MultiBinding>
    </Setter>


    <Style Selector="^:is(atom|AbstractTransfer)">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />

        <Style Selector="^ /template/ StackPanel#ActionsLayout">
            <Setter Property="Spacing" Value="{atom:OwnerTokenResource Kind=SpacingXXS, AnchorControlType={x:Type atom:AbstractTransfer}}" />
        </Style>

        <Style Selector="^ /template/ Grid#RootLayout">
            <Setter Property="ColumnSpacing" Value="{atom:OwnerTokenResource Kind=SpacingXS, AnchorControlType={x:Type atom:AbstractTransfer}}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource Kind=ColorTextDisabled, AnchorControlType={x:Type atom:AbstractTransfer}}" />
        </Style>

        <Setter Property="SelectionsIcon">
            <atom:IconTemplate>
                <antdicons:DownOutlined />
            </atom:IconTemplate>
        </Setter>

        <Style Selector="^[IsStretchView=True]">
            <Setter Property="ListWidth" Value="{x:Static system:Double.NaN}" />
            <Style Selector="^ /template/ atom|TransferItemDecorator">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </Style>

        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="atom:IListItemData">
                <atom:TextBlock Text="{Binding Content}" />
            </DataTemplate>
        </Setter>
    </Style>
</ControlTheme>
