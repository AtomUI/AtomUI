<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <!-- Underlined cells draw only the bottom edge of the BorderThickness Token. -->
    <atom:BorderThicknessFilterConverter x:Key="OtpCellUnderlineThicknessConverter" Left="False" Top="False" Right="False" />
    <atom:BorderThicknessFilterConverter x:Key="OtpJoinedBorderThickness" Left="False" />
    <atom:CornerRadiusFilterConverter x:Key="OtpStartCorners" TopRight="False" BottomRight="False" />
    <atom:CornerRadiusFilterConverter x:Key="OtpEndCorners" TopLeft="False" BottomLeft="False" />

    <ControlTheme x:Key="{x:Type atom:OtpLineEditCell}" TargetType="atom:OtpLineEditCell">
        <ControlTheme.BasedOn>
            <atom:InputControlFrameTheme TargetType="atom:OtpLineEditCell" />
        </ControlTheme.BasedOn>

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:PixelAlignedBorder
                        x:Name="PART_Frame"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{TemplateBinding BoxShadow}"
                        BackgroundSizing="InnerBorderEdge">
                        <Panel>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <!-- Input caret of the active cell. OtpLineEditCell drives its visibility from IsActive and
                            the content; blinking is the standard 1s step animation; color and height follow the
                            cell font.
                            -->
                            <!-- layout: the caret is 1 px wide, as the text box caret it replaces -->
                            <Rectangle
                                Name="PART_Caret"
                                Width="1"
                                Height="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="False" />
                        </Panel>
                    </atom:PixelAlignedBorder>
                    <!-- Right-align the paint against the start of this cell to cover the previous cell's trailing stroke. -->
                    <Canvas Width="0" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <atom:PixelAlignedBorder Name="PART_LeadingSeam"
                                                 Canvas.Right="0"
                                                 Width="{CompiledBinding BorderThickness.Right, ElementName=PART_Frame}"
                                                 Height="{CompiledBinding Bounds.Height, ElementName=PART_Frame}"
                                                 Background="{TemplateBinding BorderBrush}"
                                                 IsVisible="False" />
                    </Canvas>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:is(atom|OtpLineEditCell)">
            <Setter Property="Width" Value="{atom:OtpLineEditTokenResource CellWidth}" />
            <Setter Property="Height" Value="{atom:OtpLineEditTokenResource ControlHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
            <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="{atom:OtpLineEditTokenResource BorderThickness}" />
            <Setter Property="CornerRadius" Value="{atom:OtpLineEditTokenResource BorderRadius}" />
            <Setter Property="Foreground" Value="{atom:OtpLineEditTokenResource ColorText}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsMotionEnabled" Value="{atom:OtpLineEditTokenResource EnableMotion}" />

            <Style Selector="^[SizeType=Large]">
                <Setter Property="Width" Value="{atom:OtpLineEditTokenResource CellWidthLG}" />
                <Setter Property="Height" Value="{atom:OtpLineEditTokenResource ControlHeightLG}" />
                <Setter Property="FontSize" Value="{atom:OtpLineEditTokenResource FontSizeLG}" />
            </Style>

            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="FontSize" Value="{atom:OtpLineEditTokenResource FontSize}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Width" Value="{atom:OtpLineEditTokenResource CellWidthSM}" />
                <Setter Property="Height" Value="{atom:OtpLineEditTokenResource ControlHeightSM}" />
                <Setter Property="FontSize" Value="{atom:OtpLineEditTokenResource FontSizeSM}" />
            </Style>

            <Style Selector="^[StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorFillTertiary}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style Selector="^[StyleVariant=Borderless]">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style Selector="^[StyleVariant=Underlined]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorBorder}" />
                <Setter Property="CornerRadius" Value="0" />
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_Frame">
                    <Setter Property="BorderThickness"
                            Value="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource OtpCellUnderlineThicknessConverter}}" />
                </Style>
            </Style>

            <Style Selector="^:pointerover[StyleVariant=Outlined], ^:pointerover[StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorPrimaryHover}" />
            </Style>

            <Style Selector="^:pointerover[StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorFillSecondary}" />
            </Style>

            <Style Selector="^:pressed[StyleVariant=Outlined], ^:pressed[StyleVariant=Filled], ^:pressed[StyleVariant=Underlined], ^[IsActive=True][StyleVariant=Outlined], ^[IsActive=True][StyleVariant=Filled], ^[IsActive=True][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorPrimary}" />
            </Style>
            <!-- Ant Design: only the outlined variant draws the active outline shadow. -->
            <Style Selector="^:pressed[StyleVariant=Outlined], ^[IsActive=True][StyleVariant=Outlined]">
                <Setter Property="BoxShadow" Value="{atom:OtpLineEditTokenResource InputActiveShadow}" />
            </Style>

            <Style Selector="^[IsActive=True][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
            </Style>

            <Style Selector="^[Status=Error][StyleVariant=Outlined], ^[Status=Error][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorError}" />
            </Style>

            <Style Selector="^[Status=Error][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorErrorBg}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style Selector="^[Status=Error][StyleVariant=Filled], ^[Status=Error][StyleVariant=Borderless]">
                <Setter Property="Foreground" Value="{atom:OtpLineEditTokenResource ColorErrorText}" />
            </Style>

            <Style Selector="^:pointerover[Status=Error][StyleVariant=Outlined], ^:pointerover[Status=Error][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorErrorBorderHover}" />
            </Style>

            <Style Selector="^:pointerover[Status=Error][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorErrorBgHover}" />
            </Style>

            <Style Selector="^[Status=Error]:pressed, ^[Status=Error][IsActive=True]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorError}" />
            </Style>
            <!-- Ant Design: only the outlined variant draws the active outline shadow. -->
            <Style Selector="^[Status=Error]:pressed[StyleVariant=Outlined], ^[Status=Error][IsActive=True][StyleVariant=Outlined]">
                <Setter Property="BoxShadow" Value="{atom:OtpLineEditTokenResource InputErrorActiveShadow}" />
            </Style>

            <Style Selector="^[Status=Error][IsActive=True][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
            </Style>

            <Style Selector="^[Status=Warning][StyleVariant=Outlined], ^[Status=Warning][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorWarning}" />
            </Style>

            <Style Selector="^[Status=Warning][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorWarningBg}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style Selector="^[Status=Warning][StyleVariant=Filled], ^[Status=Warning][StyleVariant=Borderless]">
                <Setter Property="Foreground" Value="{atom:OtpLineEditTokenResource ColorWarningText}" />
            </Style>

            <Style Selector="^:pointerover[Status=Warning][StyleVariant=Outlined], ^:pointerover[Status=Warning][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorWarningBorderHover}" />
            </Style>

            <Style Selector="^:pointerover[Status=Warning][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorWarningBgHover}" />
            </Style>

            <Style Selector="^[Status=Warning]:pressed, ^[Status=Warning][IsActive=True]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorWarning}" />
            </Style>
            <!-- Ant Design: only the outlined variant draws the active outline shadow. -->
            <Style Selector="^[Status=Warning]:pressed[StyleVariant=Outlined], ^[Status=Warning][IsActive=True][StyleVariant=Outlined]">
                <Setter Property="BoxShadow" Value="{atom:OtpLineEditTokenResource InputWarningActiveShadow}" />
            </Style>

            <Style Selector="^[Status=Warning][IsActive=True][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
            </Style>

            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{atom:OtpLineEditTokenResource ColorTextDisabled}" />
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainerDisabled}" />
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorBorder}" />
            </Style>

            <Style Selector="^:disabled[StyleVariant=Borderless]">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <!-- A nullable owner width overrides the size preset at StyleTrigger priority; clearing it restores the Token.
                 The ancestor is outside this cell's template, so the binding reads the public OtpLineEdit directly. -->
            <Style Selector="^.custom-cell-width">
                <Setter Property="Width" Value="{Binding $parent[atom:OtpLineEdit].CellWidth}" />
            </Style>

            <!-- The OtpLineEdit root BorderBrush (or CellBorderBrush) is projected into HostBorderBrush by the cell and wins
                 over every state brush above, like the root brushes of the input family; unset hands the border back. -->
            <Style Selector="^:host-border-brush">
                <Setter Property="BorderBrush"
                        Value="{Binding (atom:InputControlFrame).HostBorderBrush, RelativeSource={RelativeSource Self}}" />
            </Style>

        </Style>

        <Style Selector="^.joins-previous[StyleVariant=Outlined] /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness, Converter={StaticResource OtpJoinedBorderThickness}}" />
        </Style>
        <Style Selector="^.joins-previous[StyleVariant=Filled] /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness, Converter={StaticResource OtpJoinedBorderThickness}}" />
        </Style>
        <Style Selector="^.joins-next:not(.joins-previous) /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource OtpStartCorners}}" />
        </Style>
        <Style Selector="^.joins-previous:not(.joins-next) /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius, Converter={StaticResource OtpEndCorners}}" />
        </Style>
        <Style Selector="^.joins-previous.joins-next /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="^.joins-previous:not(:disabled):not(:host-border-brush)">
            <Style Selector="^[StyleVariant=Outlined]:pointerover, ^[StyleVariant=Outlined]:pressed, ^[StyleVariant=Outlined][IsActive=True], ^[StyleVariant=Filled]:pressed, ^[StyleVariant=Filled][IsActive=True]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_LeadingSeam">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:cell-active /template/ Rectangle#PART_Caret">
            <Style.Animations>
                <Animation Duration="0:0:1"
                           IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

    </ControlTheme>
</ResourceDictionary>
