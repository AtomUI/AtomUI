<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:TextArea}" TargetType="atom:TextArea">
        <ControlTheme.Resources>
            <atom:PlaceholderHorizontalAlignmentConverter x:Key="PlaceholderHorizontalAlignmentConverter" />
        </ControlTheme.Resources>

        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:TextAreaTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:TextAreaTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText, SourceControlType={x:Type atom:TextArea}}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:TextArea">
                <DockPanel LastChildFill="True"
                           Height="{TemplateBinding Height}">
                    <atom:TextBlock Name="TextCountIndicator"
                                    Classes.semantic-count="True"
                                    DockPanel.Dock="Bottom"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Text="{TemplateBinding CountText}"
                                    IsVisible="{TemplateBinding IsShowCount}" />
                    <Panel>
                        <atom:TextAreaDecoratedBox
                            Name="{x:Static atom:AddOnDecoratedBox.AddOnDecoratedBoxPart}"
                            Classes.semantic-scope-input-frame="True"
                            TextAreaFramePadding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            StyleVariant="{TemplateBinding StyleVariant}"
                            SizeType="{TemplateBinding SizeType}"
                            Status="{TemplateBinding Status}"
                            FormStatus="{TemplateBinding FormStatus}"
                            IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                            DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                            Focusable="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsAllowAutoHide="{TemplateBinding ScrollViewer.AllowAutoHide}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            IsScrollChainingEnabled="{TemplateBinding ScrollViewer.IsScrollChainingEnabled}">
                            <atom:TextAreaDecoratedBox.ContentLeftAddOn>
                                <atom:AddOnContentPresenter
                                    Classes.semantic-prefix="True"
                                    Content="{Binding InnerLeftContent, RelativeSource={RelativeSource AncestorType=atom:TextArea}}"
                                    ContentTemplate="{Binding InnerLeftContentTemplate, RelativeSource={RelativeSource AncestorType=atom:TextArea}}"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Focusable="False" />
                            </atom:TextAreaDecoratedBox.ContentLeftAddOn>
                            <atom:TextAreaDecoratedBox.ContentRightAddOn>
                                <StackPanel Orientation="Vertical"
                                            Classes.semantic-suffix="True"
                                            Spacing="{atom:OwnerTokenResource UniformlyPaddingXXS, SourceControlType={x:Type atom:TextArea}}">
                                    <atom:InputClearIconButton
                                        Name="PART_ClearButton"
                                        Classes.semantic-clear="True"
                                        VerticalAlignment="Center"
                                        Icon="{Binding $parent[atom:TextArea].ClearIcon}"
                                        IsVisible="{Binding $parent[atom:TextArea].IsEffectiveShowClearButton}"
                                        IsMotionEnabled="{Binding $parent[atom:TextArea].IsMotionEnabled}" />
                                    <ContentPresenter
                                        Name="PART_FormFeedBack"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Content="{Binding $parent[atom:TextArea].FormFeedback}"
                                        IsVisible="{Binding $parent[atom:TextArea].IsFormFeedbackVisible}" />
                                    <atom:AddOnContentPresenter
                                        Name="PART_InnerRightContentPresenter"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Focusable="False"
                                        Content="{Binding $parent[atom:TextArea].InnerRightContent}"
                                        ContentTemplate="{Binding $parent[atom:TextArea].InnerRightContentTemplate}" />
                                </StackPanel>
                            </atom:TextAreaDecoratedBox.ContentRightAddOn>

                            <Panel Name="ContentLayout" Classes.semantic-content="True">
                                <atom:TextBlock
                                    Name="Placeholder"
                                    Classes.semantic-placeholder="True"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment, Converter={StaticResource PlaceholderHorizontalAlignmentConverter}}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Text="{TemplateBinding PlaceholderText}"
                                    Foreground="{TemplateBinding PlaceholderForeground}"
                                    LineHeight="{TemplateBinding LineHeight}"
                                    TextAlignment="{TemplateBinding TextAlignment}"
                                    TextWrapping="{TemplateBinding TextWrapping}"
                                    IsVisible="{TemplateBinding IsPlaceholderTextVisible}" />
                                <TextPresenter
                                    Name="PART_TextPresenter"
                                    Classes.semantic-textarea="True"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                    CaretBrush="{TemplateBinding CaretBrush}"
                                    CaretIndex="{TemplateBinding CaretIndex}"
                                    LineHeight="{TemplateBinding LineHeight}"
                                    PasswordChar="{TemplateBinding PasswordChar}"
                                    RevealPassword="{TemplateBinding RevealPassword}"
                                    SelectionBrush="{TemplateBinding SelectionBrush}"
                                    SelectionStart="{TemplateBinding SelectionStart}"
                                    SelectionEnd="{TemplateBinding SelectionEnd}"
                                    SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                    Text="{TemplateBinding Text, Mode=TwoWay}"
                                    TextAlignment="{TemplateBinding TextAlignment}"
                                    TextWrapping="{TemplateBinding TextWrapping}"
                                    Focusable="False" />
                            </Panel>
                        </atom:TextAreaDecoratedBox>
                        <atom:ResizeHandle Name="PART_ResizeHandle"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Cursor="SizeNorthSouth"
                                           IsVisible="{TemplateBinding IsResizable}" />
                    </Panel>
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ atom|ResizeHandle#PART_ResizeHandle">
            <Setter Property="Width" Value="{atom:TextAreaTokenResource ResizeHandleSize}" />
            <Setter Property="Height" Value="{atom:TextAreaTokenResource ResizeHandleSize}" />
            <Setter Property="Foreground" Value="{atom:TextAreaTokenResource ResizeIndicatorLineColor}" />
            <Setter Property="ResizeIndicatorLineThickness" Value="{atom:OwnerTokenResource LineWidth, SourceControlType={x:Type atom:TextArea}}" />
        </Style>

        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion, SourceControlType={x:Type atom:TextArea}}" />
        <Setter Property="SelectionBrush" Value="{atom:OwnerTokenResource SelectionBackground, SourceControlType={x:Type atom:TextArea}}" />
        <Setter Property="CaretBrush" Value="{atom:OwnerTokenResource ColorText, SourceControlType={x:Type atom:TextArea}}" />
        <Setter Property="SelectionForegroundBrush"
                Value="{atom:OwnerTokenResource SelectionForeground, SourceControlType={x:Type atom:TextArea}}" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="PlaceholderForeground"
                Value="{atom:OwnerTokenResource ColorTextPlaceholder, SourceControlType={x:Type atom:TextArea}}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="MinLines" Value="1" />

        <Style Selector="^ /template/ Panel#ContentLayout">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Ibeam" />
        </Style>

        <Style Selector="^[StyleVariant=Borderless]">
            <Style Selector="^[Status=Error]">
                <Style Selector="^ /template/ Panel#ContentLayout">
                    <Setter Property="TemplatedControl.Foreground"
                            Value="{atom:OwnerTokenResource ColorErrorText, SourceControlType={x:Type atom:TextArea}}" />
                </Style>
            </Style>
            <Style Selector="^:error">
                <Style Selector="^ /template/ Panel#ContentLayout">
                    <Setter Property="TemplatedControl.Foreground"
                            Value="{atom:OwnerTokenResource ColorErrorText, SourceControlType={x:Type atom:TextArea}}" />
                </Style>
            </Style>
            <Style Selector="^:warning">
                <Style Selector="^ /template/ Panel#ContentLayout">
                    <Setter Property="TemplatedControl.Foreground"
                            Value="{atom:OwnerTokenResource ColorWarningText, SourceControlType={x:Type atom:TextArea}}" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^[StyleVariant=Filled]">
            <Style Selector="^[Status=Error]">
                <Style Selector="^ /template/ Panel#ContentLayout">
                    <Setter Property="TemplatedControl.Foreground"
                            Value="{atom:OwnerTokenResource ColorErrorText, SourceControlType={x:Type atom:TextArea}}" />
                </Style>
            </Style>
            <Style Selector="^:error">
                <Style Selector="^ /template/ Panel#ContentLayout">
                    <Setter Property="TemplatedControl.Foreground"
                            Value="{atom:OwnerTokenResource ColorErrorText, SourceControlType={x:Type atom:TextArea}}" />
                </Style>
            </Style>
            <Style Selector="^:warning">
                <Style Selector="^ /template/ Panel#ContentLayout">
                    <Setter Property="TemplatedControl.Foreground"
                            Value="{atom:OwnerTokenResource ColorWarningText, SourceControlType={x:Type atom:TextArea}}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeightLG, SourceControlType={x:Type atom:TextArea}}" />
        </Style>
        <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeight, SourceControlType={x:Type atom:TextArea}}" />

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeight, SourceControlType={x:Type atom:TextArea}}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeightSM, SourceControlType={x:Type atom:TextArea}}" />
            <Style Selector="^ /template/ TextPresenter#PART_TextPresenter">
                <Setter Property="Margin" Value="0, 1, 0, 1" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeLG, SourceControlType={x:Type atom:TextArea}}" />
        </Style>
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize, SourceControlType={x:Type atom:TextArea}}" />

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize, SourceControlType={x:Type atom:TextArea}}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeSM, SourceControlType={x:Type atom:TextArea}}" />
        </Style>

        <Style Selector="^ /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="Margin"
                    Value="2 0 2 0" />
        </Style>

        <Style
            Selector="^ /template/ StackPanel#PART_LeftAddOnLayout, ^ /template/ StackPanel#PART_RightAddOnLayout">
            <Setter Property="Spacing"
                    Value="{atom:OwnerTokenResource UniformlyPaddingXXS, SourceControlType={x:Type atom:TextArea}}" />
        </Style>

        <Style Selector="^ /template/ atom|TextBlock#TextCountIndicator">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextPlaceholder, SourceControlType={x:Type atom:TextArea}}" />
        </Style>

        <Style Selector="^[StyleVariant=Outlined] /template/ atom|TextAreaDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default][IsInnerBoxHover=True],
                         ^[StyleVariant=Underlined] /template/ atom|TextAreaDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimaryHover, SourceControlType={x:Type atom:TextArea}}" />
        </Style>
        <Style Selector="^:focus-within[StyleVariant=Outlined] /template/ atom|TextAreaDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default],
                         ^:focus-within[StyleVariant=Underlined] /template/ atom|TextAreaDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary, SourceControlType={x:Type atom:TextArea}}" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputActiveShadow, SourceControlType={x:Type atom:TextArea}}" />
        </Style>
        <Style Selector="^:focus-within[StyleVariant=Filled] /template/ atom|TextAreaDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary, SourceControlType={x:Type atom:TextArea}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputActiveShadow, SourceControlType={x:Type atom:TextArea}}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:OwnerTokenResource ColorTextDisabled, SourceControlType={x:Type atom:TextArea}}" />
        </Style>
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness, SourceControlType={x:Type atom:TextArea}}" />
        <Style Selector="^[SizeType=Large]">
            <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPaddingLG, SourceControlType={x:Type atom:TextArea}}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG, SourceControlType={x:Type atom:TextArea}}" />
        </Style>
        <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPadding, SourceControlType={x:Type atom:TextArea}}" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius, SourceControlType={x:Type atom:TextArea}}" />

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPadding, SourceControlType={x:Type atom:TextArea}}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius, SourceControlType={x:Type atom:TextArea}}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPaddingSM, SourceControlType={x:Type atom:TextArea}}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM, SourceControlType={x:Type atom:TextArea}}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
