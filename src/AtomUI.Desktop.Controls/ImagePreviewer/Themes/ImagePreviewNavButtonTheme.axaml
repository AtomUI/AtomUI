<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImagePreviewNavButton}" TargetType="atom:ImagePreviewNavButton">
        <ControlTheme.BasedOn>
            <atom:IconButtonTheme TargetType="atom:ImagePreviewNavButton" />
        </ControlTheme.BasedOn>
        
        <Style Selector="^:is(atom|ImagePreviewNavButton)">
            <Setter Property="IconWidth" Value="{CompiledBinding $self.(atom:ImageViewer.PreviewOperationSize)}"/>
            <Setter Property="IconHeight" Value="{CompiledBinding $self.(atom:ImageViewer.PreviewOperationSize)}"/>
            <Setter Property="Background" Value="{CompiledBinding $self.(atom:ImageViewer.NavButtonBackground)}"/>
            <Setter Property="IconBrush" Value="{CompiledBinding $self.(atom:ImageViewer.PreviewOperationForeground)}"/>
            <Setter Property="Padding" Value="{CompiledBinding $self.(atom:ImageViewer.PaddingXS)}"/>
        
            <Style Selector="^:pointerover, ^:pressed">
                <Setter Property="Background" Value="{CompiledBinding $self.(atom:ImageViewer.NavButtonHoverBackground)}"/>
                <Setter Property="IconBrush" Value="{CompiledBinding $self.(atom:ImageViewer.HoverPreviewOperationForeground)}"/>
            </Style>
        
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{CompiledBinding $self.(atom:ImageViewer.NavButtonBackground)}"/>
                <Setter Property="IconBrush" Value="{CompiledBinding $self.(atom:ImageViewer.DisabledPreviewOperationForeground)}"/>
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
