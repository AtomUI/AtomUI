<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:TreeSelectTreeView}" TargetType="atom:TreeSelectTreeView">
        <ControlTheme.BasedOn>
            <atom:TreeViewTheme TargetType="atom:TreeSelectTreeView" />
        </ControlTheme.BasedOn>
        <Setter Property="atom:TreeViewItemHeader.HeaderHeight" Value="{atom:TreeSelectTokenResource HeaderHeight}" />
        <Setter Property="atom:TreeViewItemHeader.NodeHoverBackground" Value="{atom:TreeSelectTokenResource NodeHoverBg}" />
        <Setter Property="atom:TreeViewItemHeader.NodeSelectedBackground" Value="{atom:TreeSelectTokenResource NodeSelectedBg}" />
        <Setter Property="atom:TreeViewItemHeader.NodeSelectedForeground" Value="{atom:TreeSelectTokenResource NodeSelectedColor}" />
        <Setter Property="atom:TreeViewItemHeader.ItemMargin" Value="{atom:TreeSelectTokenResource TreeItemMargin}" />
        <Setter Property="atom:TreeViewItemHeader.ItemHeaderPadding" Value="{atom:TreeSelectTokenResource TreeItemHeaderPadding}" />
        <Setter Property="atom:TreeViewItemHeader.ItemHeaderMargin" Value="{atom:TreeSelectTokenResource TreeItemHeaderMargin}" />
        <Setter Property="atom:TreeViewItemHeader.NodeSwitcherMargin" Value="{atom:TreeSelectTokenResource TreeNodeSwitcherMargin}" />
        <Setter Property="atom:TreeViewItemHeader.NodeIconMargin" Value="{atom:TreeSelectTokenResource TreeNodeIconMargin}" />
        <Setter Property="atom:TreeViewItemHeader.FilterHighlightBrush" Value="{atom:TreeSelectTokenResource FilterHighlightColor}" />
    </ControlTheme>
</ResourceDictionary>
