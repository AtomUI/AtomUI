    <unit id="TwelveHoursDescription">
      <segment>
        <source>TimePicker of 12 hours format, with default format h:mm:ss a.</source>
        <target state="translated">12 小时格式的 TimePicker，默认格式为 h:mm:ss a。</target>
      </segment>
