<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ColorPicker}" TargetType="atom:ColorPicker">
        <ControlTheme.BasedOn>
            <themes:AbstractColorPickerTheme TargetType="atom:ColorPicker" />
        </ControlTheme.BasedOn>

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:PixelAlignedBorder Name="PART_Frame"
                                             BorderThickness="{TemplateBinding BorderThickness}"
                                             BorderBrush="{TemplateBinding BorderBrush}"
                                             CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                             Background="{TemplateBinding Background}"
                                             Padding="{TemplateBinding TriggerPadding}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <atom:ColorBlock Name="PART_ColorIndicator"
                                             Classes.semantic-body="True"
                                             SizeType="{TemplateBinding SizeType}"
                                             Size="{TemplateBinding ColorBlockSize}"
                                             Background="{TemplateBinding ColorBlockBackground}" />
                            <TextBlock Name="PART_ColorText"
                                       Classes.semantic-description="True"
                                       IsVisible="{TemplateBinding IsTextVisible}"
                                       Text="{TemplateBinding ColorText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </atom:PixelAlignedBorder>
                    <atom:Popup Name="PART_Popup"
                                IsPopupPinnedOpen="{TemplateBinding IsPopupPinnedOpen}"
                                WindowManagerAddShadowHint="False"
                                IsLightDismissEnabled="{TemplateBinding IsLightDismissEnabled}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                                RequestedPlacement="{TemplateBinding Placement}"
                                PlacementAnchor="{TemplateBinding PlacementAnchor}"
                                PlacementGravity="{TemplateBinding PlacementGravity}"
                                IsPointAtCenter="{TemplateBinding IsPointAtCenter}"
                                MarginToAnchor="{TemplateBinding MarginToAnchor}">
                        <atom:ColorPickerPopupRootFrame Classes.semantic-popup-root="True">
                            <atom:ArrowDecoratedBox IsArrowVisible="{TemplateBinding IsArrowVisibleEffective}"
                                                    ArrowPosition="{TemplateBinding ArrowPosition}"
                                                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}">
                                <ContentPresenter Content="{TemplateBinding PickerPresenter}" />
                            </atom:ArrowDecoratedBox>
                        </atom:ColorPickerPopupRootFrame>
                    </atom:Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
