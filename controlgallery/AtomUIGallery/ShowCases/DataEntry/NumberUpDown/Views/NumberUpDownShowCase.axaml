<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AtomUIGallery.ShowCases.NumberUpDown"
             x:Class="AtomUIGallery.ShowCases.NumberUpDown.NumberUpDownShowCase"
             x:DataType="vm:NumberUpDownViewModel"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="NumberUpDown"
                    Category="{gallery:NumberUpDownShowCaseLangResource ComponentCategory}"
                    Status="{gallery:NumberUpDownShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:NumberUpDownShowCaseLangResource PageSubtitle}"
                    Description="{gallery:NumberUpDownShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="Avalonia.Controls.NumericUpDown" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:NumberUpDownViewModel">
                    <StackPanel Spacing="24">
                        <gallery:SemanticPartPreview Name="NumberUpDownSemanticPreview"
                                                     Title="NumericUpDown"
                                                     SemanticOwner="{Binding #NumberUpDownSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:NumericUpDown}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:NumericUpDown Name="NumberUpDownSemanticOwner"
                                                    Width="320"
                                                    Value="10"
                                                    IsAllowClear="True"
                                                    InnerLeftContent="$"
                                                    InnerRightContent="kg" />
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="prefix"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticPrefixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="input"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticInputDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="suffix"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticSuffixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="clear"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticClearDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <gallery:SemanticPartPreview Name="SpinnerModeSemanticPreview"
                                                     Title="Spinner mode"
                                                     SemanticOwner="{Binding #SpinnerModeSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:NumericUpDown}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:NumericUpDown Name="SpinnerModeSemanticOwner"
                                                    Width="320"
                                                    Mode="Spinner"
                                                    Minimum="1"
                                                    Maximum="100"
                                                    Value="10"
                                                    IsAllowClear="True"
                                                    InnerLeftContent="$"
                                                    InnerRightContent="kg" />
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticSpinnerRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="prefix"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticSpinnerPrefixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="input"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticSpinnerInputDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="suffix"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticSpinnerSuffixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="clear"
                                    Description="{gallery:NumberUpDownShowCaseLangResource SemanticSpinnerClearDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCasePanel.Styles>
        <Style Selector="atom|NumericUpDown">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </gallery:ShowCasePanel.Styles>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource BasicUsageTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource BasicUsageDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <atom:NumericUpDown Value="3"
                            HorizontalAlignment="Stretch" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource SpinnerModeTitle}"
        BadgeText="v6.0.5"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource SpinnerModeDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical"
                    Spacing="{atom:SharedTokenResource UniformlyMargin}">
            <atom:NumericUpDown Mode="Spinner"
                                Minimum="1"
                                Maximum="10"
                                Value="3"
                                FormatString="0"
                                PlaceholderText="Outlined"
                                Width="150"
                                HorizontalAlignment="Left" />
            <atom:NumericUpDown Mode="Spinner"
                                Minimum="1"
                                Maximum="10"
                                Value="3"
                                FormatString="0"
                                PlaceholderText="Filled"
                                Width="150"
                                HorizontalAlignment="Left"
                                StyleVariant="Filled" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource HideHandleTitle}"
        BadgeText="v6.0.7"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource HideHandleDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical"
                    Spacing="{atom:SharedTokenResource UniformlyMargin}">
            <Grid ColumnDefinitions="*,*">
                <atom:NumericUpDown Grid.Column="0"
                                    Minimum="1"
                                    Maximum="10"
                                    Value="3"
                                    ShowButtonSpinner="False" />
            </Grid>
            <Grid ColumnDefinitions="*,*">
                <atom:NumericUpDown Grid.Column="0"
                                    Mode="Spinner"
                                    Minimum="1"
                                    Maximum="10"
                                    Value="3"
                                    ShowButtonSpinner="False" />
            </Grid>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource StringModeTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource StringModeDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:NumericUpDown IsStringMode="True"
                                StringValue="{Binding StringModeValue, Mode=TwoWay}"
                                Increment="0.0001"
                                Minimum="0"
                                Maximum="100"
                                PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextInputWeight}" />
            <TextBlock>
                <Run Text="{gallery:NumberUpDownShowCaseLangResource P2TextRawValuePrefix}" />
                <Run Text="{Binding StringModeValue}" />
            </TextBlock>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource KeyboardBehaviorTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource KeyboardBehaviorDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:CheckBox Content="{gallery:NumberUpDownShowCaseLangResource P2ContentKeyboardEnabled}"
                           IsChecked="{Binding KeyboardEnabled}" />
            <atom:NumericUpDown Value="1.2"
                                Increment="0.1"
                                IsKeyboardEnabled="{Binding KeyboardEnabled}"
                                PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextKeyboardDisabled}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource MouseWheelBehaviorTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource MouseWheelBehaviorDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <atom:NumericUpDown Value="2.5"
                            Increment="0.5"
                            PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextFocusAndScrollWheel}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource MinMaxTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource MinMaxDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <atom:NumericUpDown Minimum="0"
                            Maximum="10"
                            Value="3"
                            Increment="1" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource DecimalStepTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource DecimalStepDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <atom:NumericUpDown Value="1.2"
                            Increment="0.25"
                            Minimum="0"
                            Maximum="2" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource SizesTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource SizesDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:NumericUpDown SizeType="Large" Value="3" />
            <atom:NumericUpDown SizeType="Middle" Value="3" />
            <atom:NumericUpDown SizeType="Small" Value="3" />
            <atom:NumericUpDown Name="CustomSizeTypeNumberUpDown"
                                SizeType="Custom"
                                Height="38"
                                FontSize="15"
                                IsCustomFontSize="True"
                                Value="3" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource VariantsTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource VariantsDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:NumericUpDown Value="3" StyleVariant="Outlined" />
            <atom:NumericUpDown Value="3" StyleVariant="Filled" />
            <atom:NumericUpDown Value="3" StyleVariant="Borderless" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource DisabledTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource DisabledDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:NumericUpDown Value="3" StyleVariant="Outlined" IsEnabled="False" />
            <atom:NumericUpDown Value="3" StyleVariant="Filled" IsEnabled="False" />
            <atom:NumericUpDown Value="3" StyleVariant="Borderless" IsEnabled="False" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource PrePostTabTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource PrePostTabDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:NumericUpDown LeftAddOn="http://"
                                RightAddOn=".com"
                                HorizontalAlignment="Left"
                                Width="400"
                                Value="3" />
            <atom:NumericUpDown RightAddOn="{antdicons:AntDesignIconProvider Kind=SettingOutlined}"
                                HorizontalAlignment="Left"
                                Width="400"
                                Value="3" />
            <atom:NumericUpDown LeftAddOn="http://"
                                InnerRightContent=".com"
                                HorizontalAlignment="Left"
                                Width="400"
                                Value="3" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource WithClearIconTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource WithClearIconDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextInputWithClearIcon}"
                            Width="400"
                            HorizontalAlignment="Left"
                            IsAllowClear="True" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource PrefixAndSuffixTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource PrefixAndSuffixDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextEnterYourValue}"
                                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=UserOutlined, FillBrush=#D7D7D7}"
                                InnerRightContent="{antdicons:AntDesignIconProvider Kind=InfoCircleOutlined, FillBrush=#8C8C8C}" />
            <atom:NumericUpDown InnerLeftContent="￥" InnerRightContent="RMB" />
            <atom:NumericUpDown InnerLeftContent="￥" InnerRightContent="RMB" IsEnabled="False" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource StatusTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:NumberUpDownShowCaseLangResource StatusDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextError}" Status="Error" />
            <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextWarning}" Status="Warning" />
            <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextErrorWithPrefix}"
                                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                                Status="Error" />
            <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextWarningWithPrefix}"
                                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                                Status="Warning" />

            <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextError}"
                                Status="Error"
                                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                                StyleVariant="Filled" />
            <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextWarning}"
                                Status="Warning"
                                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                                StyleVariant="Filled" />

            <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextError}"
                                Status="Error"
                                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                                StyleVariant="Borderless" />
            <atom:NumericUpDown PlaceholderText="{gallery:NumberUpDownShowCaseLangResource P2PlaceholderTextWarning}"
                                Status="Warning"
                                InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                                StyleVariant="Borderless" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
    <gallery:ShowCaseItem
        Title="{gallery:NumberUpDownShowCaseLangResource SemanticPartStyleTitle}"
        Description="{gallery:NumberUpDownShowCaseLangResource SemanticPartStyleDescription}"
        SourceKey="numericupdown-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        Span="Full"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:NumberUpDownViewModel">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Left"
                            Spacing="12">
                    <StackPanel.Styles>
                        <Style Selector="atom|NumericUpDown.semantic-object">
                            <Setter Property="BorderBrush" Value="#1677FF" />
                        </Style>
                        <Style Selector="atom|NumericUpDown.semantic-function">
                            <Setter Property="BorderBrush" Value="#722ED1" />
                        </Style>
                    </StackPanel.Styles>

                    <atom:NumericUpDown Classes="semantic-object"
                                        Width="320"
                                        HorizontalAlignment="Left"
                                        PlaceholderText="Object" />
                    <atom:NumericUpDown Classes="semantic-function"
                                        Width="320"
                                        HorizontalAlignment="Left"
                                        PlaceholderText="Function" />
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
