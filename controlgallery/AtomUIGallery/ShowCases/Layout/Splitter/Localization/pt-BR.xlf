    <unit id="PageDescription">
      <segment>
        <source>Splitter divides a region into resizable panels. It supports horizontal and vertical layouts, nested splitters, fixed or constrained panels, collapsible handles, multiple panels, and lazy resize feedback.</source>
        <target state="translated">Splitter divides a region into resizable painéis. Isso oferece suporte horizontal e vertical layouts, nested splitters, fixed ou constrained painéis, collapsible handles, múltiplos painéis, e lazy resize feedback.</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Resize adjacent panes with draggable handles, constraints, collapse controls, and lazy updates.</source>
        <target state="translated">Resize adjacent panes com draggable handles, constraints, recolhimento controles, e lazy updates.</target>
      </segment>
    </unit>
    <unit id="ResizableDisabledDescription">
      <segment>
        <source>If either side disables resizable, dragging is blocked.</source>
        <target state="translated">Se either side disables resizable, dragging é blocked.</target>
