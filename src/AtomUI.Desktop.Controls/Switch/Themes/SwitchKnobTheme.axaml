<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SwitchKnob}" TargetType="atom:SwitchKnob">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="LoadingBgOpacity"
                Value="{atom:ToggleSwitchTokenResource SwitchDisabledOpacity}" />
        <Setter Property="LoadingAnimationDuration"
                Value="{atom:ToggleSwitchTokenResource LoadingAnimationDuration}" />

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <DoubleTransition Property="KnobRenderWidth" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <DoubleTransition Property="Opacity" atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>