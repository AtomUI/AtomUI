<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:Class="AtomUI.Desktop.Controls.Primitives.Themes.RangeInfoPickerInputTheme"
    TargetType="atom:RangeInfoPickerInput">
    <ControlTheme.BasedOn>
        <atom:InfoPickerInputTheme TargetType="atom:RangeInfoPickerInput" />
    </ControlTheme.BasedOn>
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:RangeInfoPickerInput">
            <Panel>
                <atom:AddOnDecoratedBox
                    Name="{x:Static atom:AddOnDecoratedBox.AddOnDecoratedBoxPart}"
                    Focusable="True"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    MinWidth="{TemplateBinding MinWidth}"
                    StyleVariant="{TemplateBinding StyleVariant}"
                    SizeType="{TemplateBinding SizeType}"
                    Status="{TemplateBinding Status}"
                    FormStatus="{TemplateBinding FormStatus}"
                    IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                    DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                    LeftAddOn="{TemplateBinding LeftAddOn}"
                    LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                    RightAddOn="{TemplateBinding RightAddOn}"
                    RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                    ContentLeftAddOn="{TemplateBinding ContentLeftAddOn}"
                    ContentLeftAddOnTemplate="{TemplateBinding ContentLeftAddOnTemplate}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                    <atom:AddOnDecoratedBox.ContentRightAddOn>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{atom:SharedTokenResource SpacingXS}">
                            <atom:PickerClearUpButton
                                Name="PART_ClearUpButton" />
                            <atom:AddOnContentPresenter Name="PART_ContentRightAddOnPresenter" />
                        </StackPanel>
                    </atom:AddOnDecoratedBox.ContentRightAddOn>
                    <Grid ColumnDefinitions="*, Auto, *">
                        <atom:InfoPickerTextBox Name="PART_InfoInputBox"
                                              Grid.Column="0"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch"
                                              TextWrapping="NoWrap"
                                              AcceptsReturn="False"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontStyle="{TemplateBinding FontStyle}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                                              IsReadOnly="{TemplateBinding IsReadOnly}"
                                              Text="{TemplateBinding Text}"
                                              PlaceholderText="{TemplateBinding PlaceholderText}" />
                        <antdicons:SwapRightOutlined
                            Name="PART_RangePickerArrow"
                            Grid.Column="1" />
                        <atom:InfoPickerTextBox
                            Name="PART_SecondaryInfoInputBox"
                            Grid.Column="2"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            TextWrapping="NoWrap"
                            AcceptsReturn="False"
                            FontSize="{TemplateBinding FontSize}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontStyle="{TemplateBinding FontStyle}"
                            FontWeight="{TemplateBinding FontWeight}"
                            DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                            IsReadOnly="{TemplateBinding IsReadOnly}"
                            Text="{TemplateBinding SecondaryText}"
                            PlaceholderText="{TemplateBinding SecondaryPlaceholderText}" />
                    </Grid>
                </atom:AddOnDecoratedBox>
                <Canvas>
                    <Rectangle Name="PART_RangePickerIndicator"
                               Opacity="{TemplateBinding RangePickerIndicatorOpacity}" />
                </Canvas>
                <atom:Popup Name="PART_Popup"
                            WindowManagerAddShadowHint="False"
                            IsLightDismissEnabled="True"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                            ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                            RequestedPlacement="{TemplateBinding PickerPlacement}"
                            IsPointAtCenter="{TemplateBinding IsPointAtCenter}"
                            OverlayDismissEventPassThrough="True"
                            IsHorizontalFlipped="{TemplateBinding IsPopupHorizontalFlipped, Mode=TwoWay}"
                            IsVerticalFlipped="{TemplateBinding IsPopupVerticalFlipped, Mode=TwoWay}"
                            MarginToAnchor="{TemplateBinding MarginToAnchor}">
                    <atom:ArrowDecoratedBox Content="{TemplateBinding PickerPresenter}"
                                            IsArrowVisible="{TemplateBinding IsArrowVisibleEffective}"
                                            ArrowPosition="{TemplateBinding ArrowPosition}"
                                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"/>
                </atom:Popup>
            </Panel>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|RangeInfoPickerInput)">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Style Selector="^:flyout-open">
            <Style Selector="^ /template/ atom|InfoPickerTextBox">
                <Setter Property="Foreground"
                        Value="{atom:SharedTokenResource ColorText}" />
            </Style>
            <Style Selector="^[RangeActivatedPart=Start]">
                <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_InfoInputBox">
                    <Setter Property="Foreground"
                            Value="{atom:SharedTokenResource ColorTextTertiary}" />
                </Style>
            </Style>
            <Style Selector="^[RangeActivatedPart=End]">
                <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_SecondaryInfoInputBox">
                    <Setter Property="Foreground"
                            Value="{atom:SharedTokenResource ColorTextTertiary}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^ /template/ atom|Icon#PART_RangePickerArrow">
            <Setter Property="Margin"
                    Value="{atom:InfoPickerInputTokenResource RangePickerArrowMargin}" />
            <Setter Property="Height" Value="{atom:SharedTokenResource IconSize}" />
            <Setter Property="Width" Value="{atom:SharedTokenResource IconSize}" />
            <Setter Property="FillBrush"
                    Value="{atom:SharedTokenResource ColorIcon}" />
            <Setter Property="StrokeBrush"
                    Value="{atom:SharedTokenResource ColorIcon}" />
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ atom|Icon#PART_RangePickerArrow">
                <Setter Property="FillBrush"
                        Value="{atom:SharedTokenResource ColorTextDisabled}" />
                <Setter Property="StrokeBrush"
                        Value="{atom:SharedTokenResource ColorTextDisabled}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ Rectangle#PART_RangePickerIndicator">
            <Setter Property="Height"
                    Value="{atom:InfoPickerInputTokenResource RangePickerIndicatorThickness}" />
        </Style>

        <Style Selector="^[EffectiveStatus=Default]">
            <Style Selector="^ /template/ Rectangle#PART_RangePickerIndicator">
                <Setter Property="Fill" Value="{atom:SharedTokenResource ColorPrimary}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveStatus=Error]">
            <Style Selector="^ /template/ Rectangle#PART_RangePickerIndicator">
                <Setter Property="Fill" Value="{atom:SharedTokenResource ColorError}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveStatus=Warning]">
            <Style Selector="^ /template/ Rectangle#PART_RangePickerIndicator">
                <Setter Property="Fill" Value="{atom:SharedTokenResource ColorWarning}" />
            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="PickerIndicatorOffsetX" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <DoubleTransition Property="RangePickerIndicatorOpacity" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>

    </Style>
</ControlTheme>
