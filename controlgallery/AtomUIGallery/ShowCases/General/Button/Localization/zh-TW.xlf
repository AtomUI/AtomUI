    <unit id="ExampleGroupSizeDescription">
      <segment>
        <source>Switch between large, middle and small sizes to match density requirements.</source>
        <target state="translated">在大號、默認和小號之間切換，以匹配不同信息密度。</target>
      </segment>
    </unit>
    <unit id="ExampleGroupSizeTitle">
