<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:LineEdit}" TargetType="atom:LineEdit" x:DataType="atom:LineEdit">
        <ControlTheme.Resources>
            <atom:PlaceholderHorizontalAlignmentConverter x:Key="PlaceholderHorizontalAlignmentConverter" />
        </ControlTheme.Resources>
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:LineEditTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:LineEditTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <CompiledBindingExtension Path="$self.SizeType" />
                <CompiledBindingExtension Path="$self.IsCustomFontSize" />
                <atom:LineEditTokenResource Kind="InputFontSize" WhenExplicit="True" />
                <atom:LineEditTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:LineEditTokenResource Kind="InputFontSize" />
                <atom:LineEditTokenResource Kind="InputFontSizeSM" WhenExplicit="True" />
                <atom:LineEditTokenResource Kind="FontSizeSM" WhenExplicit="True" />
                <atom:LineEditTokenResource Kind="InputFontSizeSM" />
                <atom:LineEditTokenResource Kind="InputFontSizeLG" WhenExplicit="True" />
                <atom:LineEditTokenResource Kind="FontSizeLG" WhenExplicit="True" />
                <atom:LineEditTokenResource Kind="InputFontSizeLG" />
            </MultiBinding>
        </Setter>

        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText, SourceControlType={x:Type atom:LineEdit}}" />
        <Setter Property="Template">
            <ControlTemplate>
                <atom:AddOnDecoratedBox
                    Name="{x:Static atom:AddOnDecoratedBox.AddOnDecoratedBoxPart}"
                    Classes.semantic-scope-input-frame="True"
                    LeftAddOn="{TemplateBinding LeftAddOn}"
                    LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                    RightAddOn="{TemplateBinding RightAddOn}"
                    RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ContentFramePadding="{TemplateBinding Padding}"
                    Foreground="{TemplateBinding Foreground}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    StyleVariant="{TemplateBinding StyleVariant}"
                    SizeType="{TemplateBinding SizeType}"
                    Status="{TemplateBinding Status}"
                    FormStatus="{TemplateBinding FormStatus}"
                    IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                    DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}"
                    Focusable="True"
                    ClipToBounds="{TemplateBinding ClipToBounds}">
                    <atom:AddOnDecoratedBox.ContentLeftAddOn>
                        <atom:AddOnContentPresenter
                            Classes.semantic-prefix="True"
                            Content="{Binding InnerLeftContent, RelativeSource={RelativeSource AncestorType=atom:LineEdit}}"
                            ContentTemplate="{Binding InnerLeftContentTemplate, RelativeSource={RelativeSource AncestorType=atom:LineEdit}}"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            Focusable="False" />
                    </atom:AddOnDecoratedBox.ContentLeftAddOn>

                    <atom:AddOnDecoratedBox.ContentRightAddOn>
                        <StackPanel Orientation="Horizontal"
                                    Classes.semantic-suffix="True"
                                    Spacing="{atom:OwnerTokenResource UniformlyPaddingXXS, SourceControlType={x:Type atom:LineEdit}}">
                            <atom:InputClearIconButton
                                Classes.semantic-clear="True"
                                Name="PART_ClearButton"
                                VerticalAlignment="Center"
                                Icon="{Binding $parent[atom:LineEdit].ClearIcon}"
                                IsVisible="{Binding $parent[atom:LineEdit].IsEffectiveShowClearButton}"
                                IsMotionEnabled="{Binding $parent[atom:LineEdit].IsMotionEnabled}" />
                            <atom:RevealButton
                                Name="PART_RevealButton"
                                VerticalAlignment="Center"
                                IsChecked="{Binding $parent[atom:LineEdit].RevealPassword, Mode=TwoWay}"
                                IsVisible="{Binding $parent[atom:LineEdit].IsEnableRevealButton}"
                                IsMotionEnabled="{Binding $parent[atom:LineEdit].IsMotionEnabled}" />
                            <ContentPresenter
                                Name="FormFeedBack"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Right"
                                Content="{Binding $parent[atom:LineEdit].FormFeedback}"
                                IsVisible="{Binding $parent[atom:LineEdit].IsFormFeedbackVisible}" />
                            <atom:AddOnContentPresenter
                                Name="InnerRightContentPresenter"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Right"
                                Focusable="False"
                                Content="{Binding $parent[atom:LineEdit].InnerRightContent}"
                                ContentTemplate="{Binding $parent[atom:LineEdit].InnerRightContentTemplate}" />
                            <atom:TextBlock Name="TextCountIndicator"
                                            Classes.semantic-count="True"
                                            VerticalAlignment="Center"
                                            Foreground="{atom:OwnerTokenResource ColorTextPlaceholder, SourceControlType={x:Type atom:LineEdit}}"
                                            Text="{Binding $parent[atom:LineEdit].CountText}"
                                            IsVisible="{Binding $parent[atom:LineEdit].IsShowCount}" />
                        </StackPanel>
                    </atom:AddOnDecoratedBox.ContentRightAddOn>

                    <atom:ScrollViewer
                        Name="PART_ScrollViewer"
                        Cursor="Ibeam"
                        AllowAutoHide="{TemplateBinding ScrollViewer.AllowAutoHide}"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                        IsScrollChainingEnabled="{TemplateBinding ScrollViewer.IsScrollChainingEnabled}">
                        <Panel Classes.semantic-content="True">
                            <atom:TextBlock
                                Name="Placeholder"
                                Classes.semantic-placeholder="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment, Converter={StaticResource PlaceholderHorizontalAlignmentConverter}}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Text="{TemplateBinding PlaceholderText}"
                                Foreground="{TemplateBinding PlaceholderForeground}"
                                LineHeight="{TemplateBinding LineHeight}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextWrapping="{TemplateBinding TextWrapping}"
                                IsVisible="{TemplateBinding IsPlaceholderTextVisible}" />
                            <TextPresenter
                                Name="PART_TextPresenter"
                                Classes.semantic-input="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                CaretBrush="{TemplateBinding CaretBrush}"
                                CaretIndex="{TemplateBinding CaretIndex}"
                                LineHeight="{TemplateBinding LineHeight}"
                                PasswordChar="{TemplateBinding PasswordChar}"
                                RevealPassword="{TemplateBinding RevealPassword}"
                                SelectionBrush="{TemplateBinding SelectionBrush}"
                                SelectionStart="{TemplateBinding SelectionStart}"
                                SelectionEnd="{TemplateBinding SelectionEnd}"
                                SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                Text="{TemplateBinding Text, Mode=TwoWay}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextWrapping="{TemplateBinding TextWrapping}" />
                        </Panel>
                    </atom:ScrollViewer>
                </atom:AddOnDecoratedBox>
            </ControlTemplate>
        </Setter>

        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="SelectionBrush" Value="{atom:OwnerTokenResource SelectionBackground, SourceControlType={x:Type atom:LineEdit}}" />
        <Setter Property="CaretBrush" Value="{atom:OwnerTokenResource ColorText, SourceControlType={x:Type atom:LineEdit}}" />
        <Setter Property="SelectionForegroundBrush"
                Value="{atom:OwnerTokenResource SelectionForeground, SourceControlType={x:Type atom:LineEdit}}" />
        <Setter Property="PlaceholderForeground" Value="{atom:OwnerTokenResource ColorTextPlaceholder, SourceControlType={x:Type atom:LineEdit}}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />

        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness, SourceControlType={x:Type atom:LineEdit}}" />
        <Style Selector="^[SizeType=Large]">
            <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPaddingLG, SourceControlType={x:Type atom:LineEdit}}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG, SourceControlType={x:Type atom:LineEdit}}" />
        </Style>
        <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPadding, SourceControlType={x:Type atom:LineEdit}}" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius, SourceControlType={x:Type atom:LineEdit}}" />

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPadding, SourceControlType={x:Type atom:LineEdit}}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius, SourceControlType={x:Type atom:LineEdit}}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPaddingSM, SourceControlType={x:Type atom:LineEdit}}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM, SourceControlType={x:Type atom:LineEdit}}" />
        </Style>

        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion, SourceControlType={x:Type atom:LineEdit}}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^[StyleVariant=Borderless]">
            <Style Selector="^[Status=Error]">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:OwnerTokenResource ColorErrorText, SourceControlType={x:Type atom:LineEdit}}" />
                </Style>
            </Style>
            <Style Selector="^:error">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:OwnerTokenResource ColorErrorText, SourceControlType={x:Type atom:LineEdit}}" />
                </Style>
            </Style>
            <Style Selector="^:warning">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:OwnerTokenResource ColorWarningText, SourceControlType={x:Type atom:LineEdit}}" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^[StyleVariant=Filled]">
            <Style Selector="^[Status=Error]">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:OwnerTokenResource ColorErrorText, SourceControlType={x:Type atom:LineEdit}}" />
                </Style>
            </Style>
            <Style Selector="^:error">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:OwnerTokenResource ColorErrorText, SourceControlType={x:Type atom:LineEdit}}" />
                </Style>
            </Style>
            <Style Selector="^:warning">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:OwnerTokenResource ColorWarningText, SourceControlType={x:Type atom:LineEdit}}" />
                </Style>
            </Style>
        </Style>

        <!-- The visual frame is shared by composite inputs, but control token
             scopes are keyed by the public input control rather than the
             internal AddOnDecoratedBox. Keep state colors on that owner. -->
        <Style Selector="^[StyleVariant=Outlined] /template/ atom|AddOnDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default][IsInnerBoxHover=True],
                         ^[StyleVariant=Underlined] /template/ atom|AddOnDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimaryHover, SourceControlType={x:Type atom:LineEdit}}" />
        </Style>
        <Style Selector="^:focus-within[StyleVariant=Outlined] /template/ atom|AddOnDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default],
                         ^:focus-within[StyleVariant=Underlined] /template/ atom|AddOnDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary, SourceControlType={x:Type atom:LineEdit}}" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputActiveShadow, SourceControlType={x:Type atom:LineEdit}}" />
        </Style>
        <Style Selector="^:focus-within[StyleVariant=Filled] /template/ atom|AddOnDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary, SourceControlType={x:Type atom:LineEdit}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputActiveShadow, SourceControlType={x:Type atom:LineEdit}}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
