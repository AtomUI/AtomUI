<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <!-- The track is a template part of the Slider only: every Token, global or Own, is read from the Slider, so
         Controls[Slider] reaches the rail, marks and labels. IsMotionEnabled is template-bound from the Slider. -->
    <ControlTheme x:Key="{x:Type atom:SliderTrack}" TargetType="atom:SliderTrack">
        <!-- The track reserves the hovered handle circle across the rail (SliderToken derives the padding from it). -->
        <Setter Property="SliderTrackSize" Value="{atom:SliderTokenResource ThumbCircleSizeHover}" />
        <Setter Property="SliderMarkSize" Value="{atom:SliderTokenResource MarkSize}" />
        <Setter Property="SliderRailSize" Value="{atom:SliderTokenResource RailSize}" />
        <Setter Property="MarkBackgroundBrush" Value="{atom:SliderTokenResource ColorBgElevated}" />
        <Setter Property="MarkBorderThickness"
                Value="{atom:SliderTokenResource ThumbCircleBorderThickness}" />
        <Setter Property="MarkLabelBrush" Value="{atom:SliderTokenResource ColorText}" />

        <Style Selector="^:disabled">
            <Setter Property="MarkLabelBrush"
                    Value="{atom:SliderTokenResource ColorTextDisabled}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="TrackGrooveBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="TrackBarBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="MarkBorderBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>