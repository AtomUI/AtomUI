    <unit id="PageDescription">
      <segment>
        <source>TabStrip and CardTabStrip provide lightweight tab navigation for custom content hosts, including item-template tabs, closable tabs, placement control, and add-tab actions.</source>
        <target state="translated">TabStrip 和 CardTabStrip 為自訂內容宿主提供輕量標籤導航，支援資料模板標籤、可關閉標籤、位置控制以及新增標籤操作。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Render tab headers independently from selected content.</source>
        <target state="translated">將標籤頭與選中內容分離呈現。</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">範例</target>
      </segment>
    </unit>
    <unit id="SemanticAddDescription">
      <segment>
        <source>Add element, set size, color and corner radius styles for the plus button</source>
        <target state="translated">新增元素，設定加號按鈕的尺寸、顏色與圓角樣式</target>
      </segment>
    </unit>
    <unit id="SemanticCloseDescription">
      <segment>
        <source>Close element, set size and color styles for the close button</source>
        <target state="translated">關閉元素，設定關閉按鈕的尺寸與顏色樣式</target>
      </segment>
    </unit>
    <unit id="SemanticIconDescription">
      <segment>
        <source>Icon element, set size and margin styles for the tab icon</source>
        <target state="translated">圖示元素，設定頁籤圖示的尺寸與間距樣式</target>
      </segment>
    </unit>
    <unit id="SemanticItemDescription">
      <segment>
        <source>Item element, set size, padding, hover state and selected state styles for each tab</source>
        <target state="translated">頁籤元素，設定頁籤的尺寸、內邊距、懸停態與選中態樣式</target>
      </segment>
    </unit>
    <unit id="SemanticLabelDescription">
      <segment>
        <source>Label element, set font and color styles for the tab title</source>
        <target state="translated">標題元素，設定頁籤標題的字型與顏色樣式</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Style tabs through generated Semantic Part styles: tab spacing and selected background, icon and title margins, and plus button corner radius.</source>
        <target state="translated">透過生成的 Semantic Part 樣式自訂頁籤：頁籤間距與選中背景、圖示與標題間距，以及加號按鈕圓角。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
        <target state="translated">自訂語義結構的樣式</target>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>Root element, set overall size, padding, border and background styles</source>
        <target state="translated">根元素，設定整體尺寸、內邊距、邊框與背景樣式</target>
      </segment>
    </unit>
    <unit id="TabStripAddCloseDescription">
      <segment>
        <source>Hide default plus icon, and bind event for customized trigger.</source>
        <target state="translated">隱藏默認加號圖標，並為自定義觸發器綁定事件。</target>
      </segment>
    </unit>
    <unit id="TabStripAddCloseTitle">
      <segment>
        <source>Add and close tab</source>
        <target state="translated">新增和關閉標籤</target>
      </segment>
    </unit>
    <unit id="TabStripBasicDescription">
      <segment>
        <source>Default activate first tab.</source>
        <target state="translated">默認激活第一個標籤項。</target>
      </segment>
    </unit>
    <unit id="TabStripBasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基礎用法</target>
      </segment>
    </unit>
    <unit id="TabStripCardShapePositionDescription">
      <segment>
        <source>Tab's position: left, right, top or bottom. Will auto switch to top in mobile.</source>
        <target state="translated">標籤位置可設為 left、right、top 或 bottom，在移動端會自動切換為 top。</target>
      </segment>
    </unit>
