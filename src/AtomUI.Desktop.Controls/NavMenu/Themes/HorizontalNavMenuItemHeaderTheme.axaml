<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StringToTextBlockConverter" VerticalAlignment="Center" />
    <ControlTheme x:Key="{x:Type atom:HorizontalNavMenuItemHeader}" TargetType="atom:HorizontalNavMenuItemHeader">
        <ControlTheme.BasedOn>
            <atom:BaseNavMenuItemHeaderTheme TargetType="atom:HorizontalNavMenuItemHeader" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Background="{TemplateBinding Background}">
                    <Panel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="IconPresenter" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="MenuIndicatorIcon" />
                            </Grid.ColumnDefinitions>
                            <atom:IconPresenter
                                Name="ItemIconPresenter"
                                Classes.semantic-item-icon="True"
                                Classes.semantic-sub-menu-item-icon="True"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsEnabled="{TemplateBinding IsEnabled}"
                                Icon="{TemplateBinding Icon}"
                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter
                                Name="ItemTextPresenter"
                                Classes.semantic-item-content="True"
                                Classes.semantic-sub-menu-item-content="True"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding Header, Converter={x:Static atom:BaseNavMenuItemHeaderTheme.StringToTextBlockConverter}}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}" />
                            <antdicons:RightOutlined
                                Name="MenuIndicatorIcon"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsEnabled="{TemplateBinding IsEnabled}"
                                IsVisible="{TemplateBinding IsTopLevel, Converter={x:Static BoolConverters.Not}}" />
                        </Grid>

                        <Rectangle
                            Name="PART_ActiveIndicator"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Fill="{TemplateBinding ActiveBarColor}"
                            Height="{TemplateBinding ActiveBarHeight}"
                            IsVisible="False" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:is(atom|HorizontalNavMenuItemHeader)">
            <Setter Property="FontSize" Value="{atom:NavMenuTokenResource FontSize}" />

            <Style Selector="^[IsTopLevel=False]">
                <Setter Property="Height" Value="{atom:NavMenuTokenResource ItemHeight}" />
                <Setter Property="Margin" Value="{atom:NavMenuTokenResource ItemContentMargin}" />
            </Style>
            <Style Selector="^[IsTopLevel=True]">

                <Setter Property="ActiveBarScaleX"
                        Value="{atom:NavMenuTokenResource ActiveBarScaleX}" />
                <Setter Property="ActiveBarHeight"
                        Value="{atom:NavMenuTokenResource ActiveBarHeight}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius"
                        Value="{atom:NavMenuTokenResource HorizontalItemBorderRadius}" />

                <!-- The vertical Padding of a horizontal top-level item must be 0 in every appearance: the text is
                centered the CSS line-height way by filling the whole item height through HorizontalLineHeight.
                With the vertical ItemContentPadding inherited from the vertical menu, the text viewport is shorter
                than the line box, the glyphs render at the bottom of the line box, and the text looks too low (the
                dark branch missed this reset before).
                -->
                <Setter Property="Padding" Value="0" />

                <!-- antd horizontal menu: hover / open use the hover background, the selected item its own background
                     and text colour; the active bar shows in all three states. -->
                <Style Selector="^[IsDarkStyle=False]">
                    <Style Selector="^ /template/ Rectangle#PART_ActiveIndicator">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                    <Style Selector="^:pointerover, ^[IsSubMenuOpen=True]">
                        <Setter Property="Background"
                                Value="{atom:NavMenuTokenResource HorizontalItemHoverBg}" />
                    </Style>
                    <Style Selector="^[IsSelected=True], ^[IsInSelectedPath=True]">
                        <Setter Property="Foreground"
                                Value="{atom:NavMenuTokenResource HorizontalItemSelectedColor}" />
                        <Setter Property="Background"
                                Value="{atom:NavMenuTokenResource HorizontalItemSelectedBg}" />
                    </Style>
                </Style>

                <Style Selector="^[IsDarkStyle=True]">
                    <Style Selector="^[IsSelected=True], ^[IsInSelectedPath=True]">
                        <Setter Property="Background"
                                Value="{atom:NavMenuTokenResource DarkItemSelectedBg}" />
                    </Style>
                </Style>

                <Style Selector="^ /template/ Border#Frame">
                    <Setter Property="Margin"
                            Value="{atom:NavMenuTokenResource HorizontalItemMargin}" />
                </Style>

                <Style Selector="^ /template/ ContentPresenter#ItemTextPresenter">
                    <Setter Property="LineHeight"
                            Value="{atom:NavMenuTokenResource HorizontalLineHeight}" />
                </Style>

                <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                    <Setter Property="Margin" Value="{atom:NavMenuTokenResource IconMargin}" />
                </Style>

                <Setter Property="ActiveBarColor" Value="Transparent" />

                <Style Selector="^:pointerover, ^[IsSubMenuOpen=True], ^[IsSelected=True], ^[IsInSelectedPath=True]">
                    <Setter Property="ActiveBarColor"
                            Value="{atom:NavMenuTokenResource HorizontalItemSelectedColor}" />
                </Style>

                <Style Selector="^ /template/ ContentPresenter#ItemTextPresenter">
                    <Setter Property="Margin" Value="0" />
                </Style>

            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="StateTransitionDurationSlow"/>
                        <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="StateTransitionDuration" />
                        <atom:SolidColorBrushTransition Property="ActiveBarColor" atom:TokenTransitions.Duration="StateTransitionDuration" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
