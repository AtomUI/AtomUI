<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Expander.ExpanderShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Expander"
             x:DataType="vm:ExpanderViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Expander"
                    Category="{gallery:ExpanderShowCaseLangResource ComponentCategory}"
                    Status="{gallery:ExpanderShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:ExpanderShowCaseLangResource PageSubtitle}"
                    Description="{gallery:ExpanderShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="Avalonia.Controls.Expander" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <gallery:SemanticPartPreview Name="ExpanderSemanticPreview"
                                                 SemanticOwner="{Binding #ExpanderSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:Expander}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:Expander Name="ExpanderSemanticOwner"
                                           IsExpanded="True"
                                           Header="This is panel header">
                                <atom:TextBlock TextWrapping="Wrap" Text="This is panel body" />
                            </atom:Expander>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:ExpanderShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="header"
                                Description="{gallery:ExpanderShowCaseLangResource SemanticHeaderDescription}" />
                            <gallery:SemanticPartDescription
                                Path="icon"
                                Description="{gallery:ExpanderShowCaseLangResource SemanticIconDescription}" />
                            <gallery:SemanticPartDescription
                                Path="title"
                                Description="{gallery:ExpanderShowCaseLangResource SemanticTitleDescription}" />
                            <gallery:SemanticPartDescription
                                Path="body"
                                Description="{gallery:ExpanderShowCaseLangResource SemanticBodyDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource ExpanderTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource ExpanderDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <atom:Expander Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                    </atom:Expander>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource SizeTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource SizeDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <StackPanel Orientation="Vertical" Spacing="20" Margin="0, 0, 10, 0">
                        <atom:Separator Title="{gallery:ExpanderShowCaseLangResource P2TitleDefaultSize}" TitlePosition="Left" FontWeight="Bold" />
                        <atom:Expander SizeType="Middle" Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsDefaultSizePanelHeader}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>
                        <atom:Separator Title="{gallery:ExpanderShowCaseLangResource P2TitleSmallSize}" TitlePosition="Left" FontWeight="Bold" />
                        <atom:Expander SizeType="Small" Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsSmallSizePanelHeader}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>
                        <atom:Separator Title="{gallery:ExpanderShowCaseLangResource P2TitleLargeSize}" TitlePosition="Left" FontWeight="Bold" />
                        <atom:Expander SizeType="Large" Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsLargeSizePanelHeader}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource BorderlessTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource BorderlessDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <atom:Expander IsBorderless="True" Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                    </atom:Expander>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource GhostCollapseTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource GhostCollapseDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <atom:Expander IsGhostStyle="True" Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                    </atom:Expander>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource CustomPaddingTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource CustomPaddingDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <StackPanel Orientation="Vertical" Spacing="20">
                        <atom:Expander Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}" HeaderPadding="5" ContentPadding="5">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>

                        <atom:Expander Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}" IsGhostStyle="True" HeaderPadding="5" ContentPadding="5">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource ExpandingDirectionTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource ExpandingDirectionDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <DockPanel Margin="0, 0, 0, 0" Height="300">
                        <StackPanel Orientation="Horizontal" Spacing="5" DockPanel.Dock="Top">
                            <atom:TextBlock VerticalAlignment="Center" Text="{gallery:ExpanderShowCaseLangResource P2TextExpandDirection}" />
                            <atom:OptionButtonGroup ButtonStyle="Outline"
                                                    OptionCheckedChanged="HandleExpandDirectionOptionCheckedChanged">
                                <atom:OptionButton IsChecked="True" Content="{gallery:ExpanderShowCaseLangResource P2ContentDown}" />
                                <atom:OptionButton Content="{gallery:ExpanderShowCaseLangResource P2ContentUp}" />
                                <atom:OptionButton Content="{gallery:ExpanderShowCaseLangResource P2ContentLeft}" />
                                <atom:OptionButton Content="{gallery:ExpanderShowCaseLangResource P2ContentRight}" />
                            </atom:OptionButtonGroup>
                        </StackPanel>

                        <Panel Margin="0, 20, 0, 0">
                            <atom:Expander Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeader}"
                                           ExpandDirection="{Binding ExpandDirection}"
                                           Name="DirectionDemoExpander">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:Expander>
                        </Panel>
                    </DockPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource NestedPanelTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource NestedPanelDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <atom:Expander Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                        <atom:Expander Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsNestedPanelHeader}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>
                    </atom:Expander>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource NoArrowTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource NoArrowDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <atom:Expander Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}" IsShowExpandIcon="False">
                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                    </atom:Expander>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource ExpandIconLocationTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource ExpandIconLocationDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <StackPanel Orientation="Vertical" Spacing="20">
                        <atom:Expander Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}"
                                       AddOnContent="{antdicons:AntDesignIconProvider Kind=SettingOutlined}"
                                       ExpandIconPosition="{Binding ToggleIconPosition}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>

                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <atom:TextBlock VerticalAlignment="Center" Text="{gallery:ExpanderShowCaseLangResource P2TextExpandIconPosition}" />
                            <atom:OptionButtonGroup ButtonStyle="Outline"
                                                    OptionCheckedChanged="HandleExpandButtonPosOptionCheckedChanged">
                                <atom:OptionButton IsChecked="True" Content="{gallery:ExpanderShowCaseLangResource P2ContentStart}" />
                                <atom:OptionButton Content="{gallery:ExpanderShowCaseLangResource P2ContentEnd}" />
                            </atom:OptionButtonGroup>
                        </StackPanel>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource CollapsibleTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource CollapsibleDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <atom:Expander Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisPanelCanOnlyBeCollapsedByClicking}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>
                        <atom:Expander TriggerType="Icon" Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisPanelCanOnlyBeCollapsedByClicking2}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>

                        <atom:Expander IsEnabled="False" Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisPanelCanTBeCollapsed}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>

                        <atom:Expander IsEnabled="False" Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisPanelCanTBeCollapsed}" IsExpanded="True">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:Expander>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:ExpanderShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:ExpanderShowCaseLangResource SemanticPartStyleDescription}"
                    SourceKey="expander-semantic-part"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    Span="Full"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ExpanderViewModel">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Spacing="12">
                                <StackPanel.Styles>
                                    <Style Selector="atom|Expander.semantic-object">
                                        <Setter Property="BorderThickness" Value="1" />
                                        <atom:ExpanderHeaderStyle x:SetterTargetType="atom:PixelAlignedBorder">
                                            <Setter Property="Background" Value="#f0f0f0" />
                                            <Setter Property="Padding" Value="16,12" />
                                        </atom:ExpanderHeaderStyle>
                                        <atom:ExpanderTitleStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#141414" />
                                        </atom:ExpanderTitleStyle>
                                        <atom:ExpanderBodyStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Padding" Value="16,12" />
                                        </atom:ExpanderBodyStyle>
                                    </Style>
                                    <Style Selector="atom|Expander.semantic-function">
                                        <Setter Property="BorderThickness" Value="1" />
                                        <atom:ExpanderHeaderStyle x:SetterTargetType="atom:PixelAlignedBorder">
                                            <Setter Property="Background" Value="#f5efff" />
                                            <Setter Property="Padding" Value="16,12" />
                                        </atom:ExpanderHeaderStyle>
                                        <atom:ExpanderTitleStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#141414" />
                                        </atom:ExpanderTitleStyle>
                                        <atom:ExpanderIconStyle x:SetterTargetType="atom:IconButton">
                                            <Setter Property="IconWidth" Value="20" />
                                            <Setter Property="IconHeight" Value="20" />
                                        </atom:ExpanderIconStyle>
                                    </Style>
                                </StackPanel.Styles>

                                <atom:Expander Classes="semantic-object"
                                               Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}"
                                               IsExpanded="True">
                                    <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                                </atom:Expander>

                                <atom:Expander Classes="semantic-function"
                                               SizeType="Large"
                                               Header="{gallery:ExpanderShowCaseLangResource P2HeaderThisIsPanelHeaderN1}"
                                               IsExpanded="True">
                                    <atom:TextBlock TextWrapping="Wrap" Text="{gallery:ExpanderShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                                </atom:Expander>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
