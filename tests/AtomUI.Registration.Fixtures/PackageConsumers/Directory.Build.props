<Project>
    <!-- Avalonia packages referenced by these consumers follow the repository's single version source. -->
    <Import Project="$(MSBuildThisFileDirectory)../../../build/Versions.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable><IsTrimmable>true</IsTrimmable>
        <AtomUIFixtureVersion Condition="'$(AtomUIFixtureVersion)' == ''">$(AtomUIVersion)</AtomUIFixtureVersion>
    </PropertyGroup>
</Project>
