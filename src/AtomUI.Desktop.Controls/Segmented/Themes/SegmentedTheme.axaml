<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Segmented}" TargetType="atom:Segmented">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <atomc:SegmentedThumb Name="PART_SelectedThumb"
                                              IsHitTestVisible="False"
                                              Background="{TemplateBinding EffectiveSelectedThumbBg}"
                                              BorderBrush="{TemplateBinding SelectedThumbBorderBrush}"
                                              BorderThickness="{TemplateBinding SelectedThumbBorderThickness}"
                                              CornerRadius="{TemplateBinding EffectiveSelectedThumbCornerRadius}"
                                              BoxShadows="{TemplateBinding EffectiveSelectedThumbBoxShadows}" />
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        Margin="{TemplateBinding Padding}">
                            <ItemsPresenter.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <atomc:SegmentedStackPanel
                                        Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=atom:Segmented}}"
                                        IsExpanding="{Binding IsExpanding, RelativeSource={RelativeSource AncestorType=atom:Segmented}}" />
                                </ItemsPanelTemplate>
                            </ItemsPresenter.ItemsPanel>
                        </ItemsPresenter>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="IsMotionEnabled" Value="{atom:SegmentedTokenResource EnableMotion}" />
        <Setter Property="Padding" Value="{atom:SegmentedTokenResource TrackPadding}" />
        <Setter Property="Background" Value="{atom:SegmentedTokenResource TrackBg}" />
        <Setter Property="BorderBrush" Value="{atom:SegmentedTokenResource TrackBorderColor}" />
        <Setter Property="BorderThickness" Value="{atom:SegmentedTokenResource TrackBorderThickness}" />
        <Setter Property="SelectedThumbBorderBrush" Value="{atom:SegmentedTokenResource ItemSelectedBorderColor}" />
        <Setter Property="SelectedThumbBorderThickness" Value="{atom:SegmentedTokenResource ItemSelectedBorderThickness}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="UseSelectedThumbTokenResources" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Style Selector="^[IsExpanding=True]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        
        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:SegmentedTokenResource BorderRadiusLG}" />
            <Setter Property="SelectedThumbCornerRadius" Value="{atom:SegmentedTokenResource BorderRadius}" />
        </Style>
                
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius" Value="{atom:SegmentedTokenResource BorderRadius}" />
            <Setter Property="SelectedThumbCornerRadius" Value="{atom:SegmentedTokenResource BorderRadiusSM}" />
        </Style>
                
        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:SegmentedTokenResource BorderRadiusSM}" />
            <Setter Property="SelectedThumbCornerRadius" Value="{atom:SegmentedTokenResource BorderRadiusXS}" />
        </Style>

        <Style Selector="^[Shape=Round]">
            <!-- layout: capsule shape, a radius larger than any half height (antd shape="round" uses the control height) -->
            <Setter Property="CornerRadius" Value="9999" />
            <!-- layout: capsule thumb, a radius larger than any half height -->
            <Setter Property="SelectedThumbCornerRadius" Value="9999" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True][IndicatorMotionMode=Slide], ^[IsMotionEnabled=True][IndicatorMotionMode=Stretch]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <!-- Matches the antd thumb motion: position and size interpolate together, motionDurationSlow
                        (300ms), motionEaseInOut cubic-bezier(0.645, 0.045, 0.355, 1).
                        -->
                        <PointTransition Property="SelectedThumbPos" atom:TokenTransitions.Duration="MotionDurationSlow" atom:TokenTransitions.Easing="MotionEaseInOut" />
                        <SizeTransition Property="SelectedThumbSize" atom:TokenTransitions.Duration="MotionDurationSlow" atom:TokenTransitions.Easing="MotionEaseInOut" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="x:String">
                <atom:TextBlock Text="{Binding}" />
            </DataTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
