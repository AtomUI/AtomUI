    <unit id="PageDescription">
      <segment>
        <source>TreeView organizes nested data into expandable nodes and supports templated data sources, checkbox selection, filtering, custom switcher icons, context menus, and lazy child loading.</source>
        <target state="translated">TreeView organizes nested dados into expandable nodes e oferece suporte templated dados sources, checkbox seleção, filtering, personalizado switcher ícones, context menus, e lazy child carregando.</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Display hierarchical data with selectable, checkable, searchable, draggable, and async-loaded nodes.</source>
        <target state="translated">Exibir hierarchical dados com selectable, checkable, searchable, draggable, e async-loaded nodes.</target>
      </segment>
    </unit>
