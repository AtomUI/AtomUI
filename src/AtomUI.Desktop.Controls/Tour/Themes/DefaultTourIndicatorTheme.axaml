<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:DefaultTourIndicator}" TargetType="atom:DefaultTourIndicator">

        <Setter Property="ItemSpacing" Value="{atom:DefaultTourIndicatorTokenResource SpacingXXS}" />
        <Setter Property="IndicatorSize" Value="{atom:TourTokenResource IndicatorSize}" />
        <Setter Property="IndicatorColor" Value="{atom:DefaultTourIndicatorTokenResource ColorFill}" />
        <Setter Property="IndicatorActiveColor"
                Value="{atom:DefaultTourIndicatorTokenResource ColorPrimary}" />

        <Setter Property="Template">
            <ControlTemplate>
                <!-- The dots are materialized in code by the control from StepCount (they have no TemplatedParent, so a
                /template/ selector chain cannot reach them). The dot style is therefore declared on DotsLayout
                itself and flows down the logical tree to the materialized dots; size and color bind to the
                indicator instance through the logical ancestor, and the dedicated semantic style reaches them
                through the popup.root anchor along the logical tree. The layout stays as in the previous
                self-drawn version: N*size + (N+1)*spacing.
                -->
                <StackPanel Name="DotsLayout"
                            Orientation="Horizontal"
                            Margin="{TemplateBinding ItemSpacing}"
                            Spacing="{TemplateBinding ItemSpacing}">
                    <StackPanel.Styles>
                        <Style Selector="Ellipse.semantic-popup-indicator">
                            <Setter Property="Width" Value="{Binding IndicatorSize, RelativeSource={RelativeSource AncestorType=atom:DefaultTourIndicator}}" />
                            <Setter Property="Height" Value="{Binding IndicatorSize, RelativeSource={RelativeSource AncestorType=atom:DefaultTourIndicator}}" />
                            <Setter Property="Fill" Value="{Binding IndicatorColor, RelativeSource={RelativeSource AncestorType=atom:DefaultTourIndicator}}" />
                        </Style>
                        <Style Selector="Ellipse.semantic-popup-indicator.active">
                            <Setter Property="Fill" Value="{Binding IndicatorActiveColor, RelativeSource={RelativeSource AncestorType=atom:DefaultTourIndicator}}" />
                        </Style>
                    </StackPanel.Styles>
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[StyleType=Primary]">
            <Setter Property="IndicatorColor"
                    Value="{atom:TourTokenResource PrimaryPrevBtnBg}" />
            <Setter Property="IndicatorActiveColor"
                    Value="{atom:DefaultTourIndicatorTokenResource ColorTextLightSolid}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
