<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atomc:RadioIndicator}" TargetType="atomc:RadioIndicator">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:WaveSpiritDecorator Name="{x:Static atom:WaveSpiritDecorator.WaveSpiritPart}"
                                              IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"/>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="BorderThickness" Value="{atom:RadioButtonTokenResource BorderThickness}"/>
        <Style Selector="^ /template/ atom|WaveSpiritDecorator#PART_WaveSpirit">
            <Setter Property="WaveType" Value="CircleWave"/>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <DoubleTransition Property="RadioDotEffectSize" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationFast" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
