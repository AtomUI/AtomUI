<ControlTheme TargetType="atom:CandidateListItem"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.CandidateListItemTheme">
    <ControlTheme.BasedOn>
        <atom:ListBoxItemTheme TargetType="atom:CandidateListItem" />
    </ControlTheme.BasedOn>
    <Setter Property="BorderThickness" Value="0" />

    <Style Selector="^:is(atom|CandidateListItem)">
        <Style Selector="^:pointerover:not(:disabled)">
            <Setter Property="Foreground" Value="{atom:ListBoxTokenResource ItemColor}" />
            <Setter Property="Background" Value="{atom:ListBoxTokenResource ItemBgColor}" />
        </Style>

        <Style Selector="^[IsSelected=False][IsCandidateSelected=True]:not(:disabled)">
            <Setter Property="Foreground" Value="{atom:ListBoxTokenResource ItemHoverColor}" />
            <Setter Property="Background" Value="{Binding ItemHoverBg, RelativeSource={RelativeSource Self}}" />
        </Style>
        
        <Style Selector="^[IsSelected=True]:not(:disabled)">
            <Setter Property="Foreground" Value="{atom:ListBoxTokenResource ItemSelectedColor}" />
            <Setter Property="Background" Value="{Binding ItemSelectedBg, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Style>
    
</ControlTheme>
