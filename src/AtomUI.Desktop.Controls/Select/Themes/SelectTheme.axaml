<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Select}" TargetType="atom:Select">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:SelectAddOnDecoratedBox
                        Name="{x:Static atom:AddOnDecoratedBox.AddOnDecoratedBoxPart}"
                        Classes.semantic-scope-input="True"
                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                        StyleVariant="{TemplateBinding StyleVariant}"
                        SizeType="{TemplateBinding SizeType}"
                        Status="{TemplateBinding Status}"
                        FormStatus="{TemplateBinding FormStatus}"
                        IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                        DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                        LeftAddOn="{TemplateBinding LeftAddOn}"
                        LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                        RightAddOn="{TemplateBinding RightAddOn}"
                        RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                        IsEnabled="{TemplateBinding IsEnabled}"
                        Mode="{TemplateBinding Mode}"
                        CustomControlHeight="{TemplateBinding Height}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsSelectionEmpty="{TemplateBinding IsSelectionEmpty}"
                        IsDropDownOpen="{TemplateBinding IsDropDownOpen}"
                        CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                        CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                        IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                        <atom:AddOnDecoratedBox.ContentLeftAddOn>
                            <atom:AddOnContentPresenter
                                Classes.semantic-prefix="True"
                                Content="{CompiledBinding $parent[atom:Select].ContentLeftAddOn}"
                                ContentTemplate="{CompiledBinding $parent[atom:Select].ContentLeftAddOnTemplate}"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"
                                Focusable="False" />
                        </atom:AddOnDecoratedBox.ContentLeftAddOn>
                        <atom:AddOnDecoratedBox.ContentRightAddOn>
                            <StackPanel Orientation="Horizontal"
                                        Classes.semantic-suffix="True"
                                        Spacing="{atom:SharedTokenResource SpacingXS}">
                                <atom:SelectMaxCountIndicator
                                    Name="PART_SelectMaxCountIndicator"
                                    MaxCount="{CompiledBinding $parent[atom:Select].MaxCount}"
                                    SelectedCount="{CompiledBinding $parent[atom:Select].SelectedCount}"
                                    IsVisible="{CompiledBinding $parent[atom:Select].IsShowMaxCountIndicator}" />
                                <atom:AddOnContentPresenter
                                    Name="PART_ContentRightAddOnPresenter"
                                    Content="{CompiledBinding $parent[atom:Select].ContentRightAddOn}"
                                    ContentTemplate="{CompiledBinding $parent[atom:Select].ContentRightAddOnTemplate}" />
                                <atom:SelectHandle
                                    Name="PART_SelectHandle"
                                    Classes.semantic-scope-handle="True"
                                    FormFeedback="{CompiledBinding $parent[atom:Select].FormFeedback}"
                                    LoadingIcon="{CompiledBinding $parent[atom:Select].SuffixLoadingIcon}"
                                    OpenIndicator="{CompiledBinding $parent[atom:Select].SuffixIcon}"
                                    IsFilterEnabled="{CompiledBinding $parent[atom:Select].IsEffectiveFilterEnabled}"
                                    IsEnabled="{CompiledBinding $parent[atom:Select].IsEnabled}"
                                    IsMotionEnabled="{CompiledBinding $parent[atom:Select].IsMotionEnabled}"
                                    IsLoading="{CompiledBinding $parent[atom:Select].IsLoading}"
                                    IsAllowClear="{CompiledBinding $parent[atom:Select].IsAllowClear}"
                                    IsSelectionEmpty="{CompiledBinding $parent[atom:Select].IsSelectionEmpty}"
                                    IsInputHover="{CompiledBinding $parent[atom:SelectAddOnDecoratedBox].IsInnerBoxHover}"
                                    IsInputPressed="{CompiledBinding $parent[atom:SelectAddOnDecoratedBox].IsInnerBoxPressed}"
                                    IsDropDownOpen="{CompiledBinding $parent[atom:Select].IsDropDownOpen}" />
                            </StackPanel>
                        </atom:AddOnDecoratedBox.ContentRightAddOn>
                        <Panel Classes.semantic-content="True">
                            <atom:TextBlock
                                Name="PlaceholderText"
                                Classes.semantic-placeholder="True"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Text="{TemplateBinding PlaceholderText}"
                                IsVisible="{TemplateBinding IsPlaceholderTextVisible}"
                                Foreground="{TemplateBinding PlaceholderForeground}" />
                            <atom:SelectFilterTextBox Name="PART_SingleFilterInput"
                                                      Classes.semantic-input="True"
                                                      IsVisible="False"
                                                      VerticalAlignment="Stretch"
                                                      FontSize="{TemplateBinding FontSize}"
                                                      FontFamily="{TemplateBinding FontFamily}"
                                                      FontStyle="{TemplateBinding FontStyle}"
                                                      FontWeight="{TemplateBinding FontWeight}"
                                                      PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                                                      atom:OverflowTip.IsEnabled="{TemplateBinding IsShowOverflowTip}"
                                                      atom:OverflowTip.Text="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                      atom:OverflowTip.ShowDelay="{TemplateBinding OverflowTipDelay}"
                                                      atom:OverflowTip.Placement="{TemplateBinding OverflowTipPlacement}"
                                                      atom:OverflowTip.PlacementTarget="{Binding $parent[atom:SelectAddOnDecoratedBox]}" />
                            <atom:SelectResultOptionsBox
                                Name="SelectedOptionsBox"
                                Classes.semantic-scope-tags="True"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Mode="{TemplateBinding Mode}"
                                SizeType="{TemplateBinding SizeType}"
                                SelectedOptions="{TemplateBinding SelectedOptions}"
                                IsFilterEnabled="{TemplateBinding IsEffectiveFilterEnabled}"
                                IsShowOverflowTip="{TemplateBinding IsShowOverflowTip}"
                                OverflowTipDelay="{TemplateBinding OverflowTipDelay}"
                                OverflowTipPlacement="{TemplateBinding OverflowTipPlacement}"
                                IsDropDownOpen="{TemplateBinding IsDropDownOpen}"
                                MaxTagCount="{TemplateBinding MaxTagCount}"
                                IsResponsiveTagMode="{TemplateBinding IsResponsiveTagMode}"
                                CustomControlHeight="{TemplateBinding Height}"
                                ContentFramePadding="{CompiledBinding $parent[atom:SelectAddOnDecoratedBox].ContentFramePadding}"
                                ContentMinHeight="{CompiledBinding $parent[atom:SelectAddOnDecoratedBox].ContentMinHeight}"
                                InputBorderThickness="{CompiledBinding $parent[atom:SelectAddOnDecoratedBox].InnerBoxBorderThickness}"
                                IsVisible="False"
                                Focusable="True" />
                        </Panel>
                    </atom:SelectAddOnDecoratedBox>
                    <atom:Popup Name="PART_Popup"
                                WindowManagerAddShadowHint="False"
                                IsLightDismissEnabled="True"
                                OverlayDismissEventPassThrough="True"
                                RequestedPlacement="BottomEdgeAlignedLeft"
                                ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}">
                        <Border Name="PopupFrame"
                                Classes.semantic-popup-root="True"
                                MaxHeight="{TemplateBinding MaxPopupHeight}"
                                MinWidth="{TemplateBinding EffectivePopupWidth}"
                                Padding="{TemplateBinding PopupContentPadding}" />
                    </atom:Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="PopupContentPadding"
                Value="{atom:SelectTokenResource PopupContentPadding}" />
        <Setter Property="OptionFontSize" Value="{atom:SharedTokenResource FontSize}" />
        <Setter Property="ItemHeight" Value="{atom:SharedTokenResource ControlHeight}" />
        <Setter Property="PlaceholderForeground"
                Value="{atom:SharedTokenResource ColorTextPlaceholder}" />

        <Style Selector="^[SizeType=Large]">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        </Style>

        <Style Selector="^ /template/ atom|Popup#PART_Popup">
            <Setter Property="MarginToAnchor"
                    Value="{atom:PopupTokenResource MarginToAnchor}" />
            <Setter Property="PopupRootShadow" Value="{atom:PopupTokenResource PopupRootShadow}" />
        </Style>
        <Style Selector="^ /template/ Border#PopupFrame">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgElevated}" />
            <Setter Property="CornerRadius"
                    Value="{atom:PopupTokenResource PopupCornerRadius}" />
        </Style>

        <Style Selector="^[Mode=Single]">
            <Style Selector="^ /template/ atom|SelectCandidateList#PART_CandidateList">
                <Setter Property="IsShowSelectedIndicator" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|SelectFilterTextBox#PART_SingleFilterInput">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^[IsFilterEnabled=False]">
                <Style Selector="^ /template/ atom|SelectAddOnDecoratedBox#PART_AddOnDecoratedBox">
                    <Setter Property="Cursor" Value="Hand" />
                </Style>

            </Style>
        </Style>

        <Style Selector="^[Mode=Multiple]">
            <Style Selector="^ /template/ atom|SelectResultOptionsBox#SelectedOptionsBox">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^[IsFilterEnabled=False]">
                <Style Selector="^ /template/ atom|SelectAddOnDecoratedBox#PART_AddOnDecoratedBox">
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
            </Style>
            <Style Selector="^ /template/ atom|SelectCandidateList#PART_CandidateList">
                <Setter Property="IsShowSelectedIndicator" Value="True" />
                <Setter Property="SelectionMode" Value="Multiple" />
            </Style>
        </Style>

        <Style Selector="^[Mode=Tags]">
            <Style Selector="^ /template/ atom|SelectResultOptionsBox#SelectedOptionsBox">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^[IsFilterEnabled=False]">
                <Style Selector="^ /template/ atom|SelectAddOnDecoratedBox#PART_AddOnDecoratedBox">
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
            </Style>
            <Style Selector="^ /template/ atom|SelectCandidateList#PART_CandidateList">
                <Setter Property="IsShowSelectedIndicator" Value="True" />
                <Setter Property="SelectionMode" Value="Multiple" />
            </Style>
        </Style>

        <Setter Property="OptionTemplate">
            <DataTemplate x:DataType="atom:ISelectOption">
                <atom:TextBlock Text="{Binding Header}" />
            </DataTemplate>
        </Setter>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
