<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Separator}" TargetType="atom:Separator">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atomc:SeparatorRail Name="PART_RailStart"
                                         Classes.semantic-rail="True"
                                         LineColor="{TemplateBinding LineColor}"
                                         LineWidth="{TemplateBinding LineWidth}"
                                         Variant="{TemplateBinding Variant}"
                                         Orientation="{TemplateBinding Orientation}" />
                    <atom:TextBlock Name="PART_Title"
                           Classes.semantic-content="True"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Padding="0"
                           Text="{TemplateBinding Title}"
                           FontSize="{TemplateBinding FontSize}"
                           Foreground="{TemplateBinding TitleColor}"
                           IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <atomc:SeparatorRail Name="PART_RailEnd"
                                         Classes.semantic-rail="True"
                                         LineColor="{TemplateBinding LineColor}"
                                         LineWidth="{TemplateBinding LineWidth}"
                                         Variant="{TemplateBinding Variant}"
                                         Orientation="{TemplateBinding Orientation}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="TitleColor" Value="{atom:OwnerTokenResource ColorTextHeading}" />
        <Setter Property="LineColor" Value="{atom:OwnerTokenResource ColorSplit}" />
        
        <Setter Property="TextPaddingInline" Value="{atom:SeparatorTokenResource TextPaddingInline}" />
        <Setter Property="OrientationMarginPercent" Value="{atom:SeparatorTokenResource OrientationMarginPercent}" />
        <Setter Property="LineWidth" Value="{atom:OwnerTokenResource LineWidth}" />
        
        <Style Selector="^[IsPlain=True]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="^[IsPlain=False]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeLG}" />
            <Setter Property="FontWeight" Value="500" />
        </Style>

        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{atom:SeparatorTokenResource HorizontalMarginBlock}" />
            <Style Selector="^ /template/ atom|TextBlock#PART_Title">
                <Setter Property="IsVisible" Value="True" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Margin" Value="{atom:SeparatorTokenResource HorizontalMarginBlockSM}"/>
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Setter Property="Margin" Value="{atom:SeparatorTokenResource HorizontalMarginBlock}"/>
            </Style>

            <Style Selector="^[SizeType=Large]">
                <Setter Property="Margin" Value="{atom:SeparatorTokenResource HorizontalMarginBlockLG}"/>
            </Style>
        </Style>
        
        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style Selector="^ /template/ atom|TextBlock#PART_Title">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            
            <Setter Property="VerticalMarginInline" Value="{atom:SeparatorTokenResource VerticalMarginInline}"/>
        </Style>
        
    </ControlTheme>
</ResourceDictionary>
