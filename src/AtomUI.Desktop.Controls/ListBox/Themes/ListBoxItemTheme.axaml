<!-- owner: global Tokens are read from the owner. ListBoxItem is Token-owner transparent, so its owner is the hosting
     ListBox; the theme is also the base of CandidateListItem and the identity-less Cascader filter list items. Own Tokens
     are the ListBox's. -->
<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:ClassModifier="internal"
              x:Class="AtomUI.Desktop.Controls.Themes.ListBoxItemTheme"
              TargetType="atom:ListBoxItem">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:ListBoxItem">
            <Panel>
                <!-- Keyboard focus outline: drawn just inside the item frame, so it is neither clipped by the list
                     viewport nor overlaps the neighbouring items. -->
                <atom:PixelAlignedBorder Name="Frame"
                                         TemplatedControl.IsTemplateFocusTarget="True"
                                         atom:FocusOutlineAdorner.IsInset="True"
                                         Background="{TemplateBinding Background}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         Padding="{TemplateBinding Padding}">
                    <DockPanel LastChildFill="True">
                        <atom:IconTemplatePresenter
                            Name="SelectedIndicator"
                            IconTemplate="{TemplateBinding SelectedIndicator}"
                            IsVisible="{TemplateBinding IsSelectedIndicatorVisible}"
                            DockPanel.Dock="Right"/>
                        <Panel>
                            <ContentPresenter Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsVisible="{TemplateBinding IsFiltering, Converter={x:Static BoolConverters.Not}}"/>
                            <atom:HighlightableTextBlock HighlightForeground="{TemplateBinding FilterHighlightForeground}"
                                                         HighlightStrategy="{TemplateBinding FilterHighlightStrategy}"
                                                         IsVisible="{TemplateBinding IsFiltering}"
                                                         HighlightWords="{TemplateBinding FilterHighlightWords}"
                                                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                         Text="{TemplateBinding ContentText}"/>
                        </Panel>
                    </DockPanel>
                </atom:PixelAlignedBorder>
                <atom:PixelAlignedBorder Name="SplitLineFrame"
                                         VerticalAlignment="Bottom"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                         IsVisible="{TemplateBinding IsSplitLineEffectiveVisible}" />
            </Panel>
        </ControlTemplate>
    </Setter>
    
    <Style Selector="^:is(atom|ListBoxItem)">
        <Setter Property="Margin" Value="{atom:ListBoxTokenResource ItemMargin}" />
        <Setter Property="Foreground" Value="{atom:ListBoxTokenResource ItemColor}" />
        <Setter Property="Background" Value="{atom:ListBoxTokenResource ItemBgColor}" />
        <!-- The split line under the item is LineWidth thick; an application BorderThickness replaces it. -->
        <Setter Property="SplitLineWidth" Value="{atom:OwnerTokenResource LineWidth}" />
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorSplit}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Style Selector="^:pointerover:not(:disabled)">
            <Setter Property="Foreground" Value="{atom:ListBoxTokenResource ItemHoverColor}" />
            <Setter Property="Background" Value="{Binding ItemHoverBg, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style Selector="^:selected:not(:disabled)">
            <Setter Property="Foreground" Value="{atom:ListBoxTokenResource ItemSelectedColor}" />
            <Setter Property="Background" Value="{Binding ItemSelectedBg, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style Selector="^ /template/ atom|IconTemplatePresenter#SelectedIndicator">
            <Setter Property="IconBrush" Value="{Binding ItemSelectedIndicatorColor, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="Width" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="Height" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="Margin" Value="{atom:ListBoxTokenResource SelectedIndicatorMargin}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightLG}" />
            <Setter Property="Padding" Value="{atom:ListBoxTokenResource ItemPaddingLG}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeight}" />
            <Setter Property="Padding" Value="{atom:ListBoxTokenResource ItemPadding}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightSM}" />
            <Setter Property="Padding" Value="{atom:ListBoxTokenResource ItemPaddingSM}" />
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground"
                        Value="{atom:ListBoxTokenResource ItemDisabledColor}" />
            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="StateTransitionDuration" />
                        <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="StateTransitionDuration" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </Style>
</ControlTheme>
