<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:converters="using:AtomUI.Desktop.Controls.Converters"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    x:CompileBindings="True"
    x:ClassModifier="internal">
    <converters:TourCloseIconBrushConverter x:Key="TourCloseIconBrushConverter" />
    <ControlTheme x:Key="{x:Type atom:TourStep}" TargetType="atom:TourStep">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame" Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}">
                    <DockPanel LastChildFill="True" Name="RootLayout">
                        <Border Classes.semantic-popup-header="True"
                                DockPanel.Dock="Top">
                            <DockPanel LastChildFill="True">
                                <atom:DialogCaptionButton
                                    Name="CloseButton"
                                    Classes.semantic-popup-close="True"
                                    DockPanel.Dock="Right"
                                    NormalIcon="{TemplateBinding CloseIcon}"
                                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}" />
                                <ContentPresenter Name="Title"
                                                  Classes.semantic-popup-title="True"
                                                  Content="{TemplateBinding Title}"
                                                  ContentTemplate="{TemplateBinding TitleTemplate}" />
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Vertical" Name="ContentLayout">
                            <ContentPresenter Name="CoverPresenter"
                                              Classes.semantic-popup-cover="True"
                                              Content="{TemplateBinding Cover}"
                                              ContentTemplate="{TemplateBinding CoverTemplate}" />
                            <ContentPresenter Name="DescriptionPresenter"
                                              Classes.semantic-popup-description="True"
                                              Content="{TemplateBinding Description}"
                                              ContentTemplate="{TemplateBinding DescriptionTemplate}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ atom|DialogCaptionButton">
            <Setter Property="Width" Value="{atom:TourTokenResource CloseBtnSize}" />
            <Setter Property="Height" Value="{atom:TourTokenResource CloseBtnSize}" />
            <Setter Property="IconWidth" Value="{atom:TourStepTokenResource IconSize}" />
            <Setter Property="IconHeight" Value="{atom:TourStepTokenResource IconSize}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#Title">
            <Setter Property="Foreground" Value="{atom:TourTokenResource HeaderColor}" />
            <Setter Property="FontWeight" Value="{atom:TourStepTokenResource FontWeightStrong}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
           
        <Style Selector="^[StyleType=Primary]">
            <Setter Property="Foreground" Value="{atom:TourStepTokenResource ColorTextLightSolid}" />
            
            <Style Selector="^ /template/ ContentPresenter#Title">
                <Setter Property="Foreground" Value="{atom:TourStepTokenResource ColorTextLightSolid}" />
            </Style>
            
            <Style Selector="^ /template/ atom|DialogCaptionButton#CloseButton">
                <Setter Property="IconBrush" Value="{atom:TourStepTokenResource ColorTextLightSolid}" />
            </Style>
            
            <Style Selector="^ /template/ atom|DialogCaptionButton#CloseButton:pointerover, ^ /template/ atom|DialogCaptionButton#CloseButton:pressed">
                <Setter Property="Foreground" Value="{atom:TourStepTokenResource ColorIconHover}" />
                <Setter Property="IconBrush">
                    <MultiBinding Converter="{StaticResource TourCloseIconBrushConverter}">
                        <Binding Path="$self.TemplatedParent.(primitives:TemplatedControl.Foreground)" />
                        <Binding Path="$self.Background" />
                        <Binding Path="$parent[atom:ArrowDecoratedBox].Background" />
                        <Binding Path="$self.Foreground" />
                    </MultiBinding>
                </Setter>
            </Style>
            
        </Style>

        <Style Selector="^ /template/ DockPanel#RootLayout">
            <Setter Property="VerticalSpacing" Value="{atom:TourStepTokenResource SpacingXS}" />
        </Style>
        
        <Style Selector="^ /template/ StackPanel#ContentLayout">
            <Setter Property="Spacing" Value="{atom:TourStepTokenResource SpacingXS}" />
        </Style>

        <Setter Property="IsVisible" Value="False" />
        <Style Selector="^[IsSelected=True]">
            <Setter Property="IsVisible" Value="True" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
