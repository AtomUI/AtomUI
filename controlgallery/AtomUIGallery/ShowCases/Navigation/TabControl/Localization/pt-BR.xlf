    <unit id="TabControlReorderDescription">
      <segment>
        <source>Enable drag sorting with IsTabReorderEnabled. The selected item follows the same logical tab after sorting.</source>
        <target state="translated">Ativar arrastar sorting com IsTabReorderEnabled. O selecionado item follows o mesmo logical guia depois sorting.</target>
      </segment>
    </unit>
    <unit id="TabControlReorderPlacementDescription">
