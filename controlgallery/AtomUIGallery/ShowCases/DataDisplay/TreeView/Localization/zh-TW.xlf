    <unit id="SemanticItemIndicatorDescription">
      <segment>
        <source>Checkbox or radio toggle indicator of each node, driven by ToggleType and check state.</source>
        <target state="translated">每個節點的勾選指示（checkbox 或 radio），由 ToggleType 與勾選狀態驅動。</target>
      </segment>
    </unit>
    <unit id="SemanticItemSwitcherDescription">
