<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:WindowNotificationManager}"
                  TargetType="atom:WindowNotificationManager"
                  x:DataType="atom:WindowNotificationManager">
        <!-- The Padding of the manager is projected as the list margin, keeping the hit extent of the presenter close
        to the visible cards. The gap between cards is managed by FeedbackStackPanel, and the cards keep a zero
        margin of their own.
        -->
        <Setter Property="ThemePadding" Value="{atom:NotificationCardTokenResource NotificationTopMargin}" />
        <Setter Property="Padding" Value="{CompiledBinding ThemePadding, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- layer: surface host. The focus strokes and badges of controls inside the cards land in its adorner
                layer, right next to this manager's cards. It has no background and takes no part in hit testing,
                so the hit area of the list is unchanged.
                -->
                <VisualLayerManager Name="PART_SurfaceHost"
                                    atom:LayerLadder.IsSurfaceHost="True">
                    <atom:FeedbackStackPresenter Name="PART_Items"
                                                Margin="{TemplateBinding Padding}"
                                                Classes.semantic-list-content="True" />
                </VisualLayerManager>
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled" Value="{atom:WindowNotificationManagerTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />

        <Style Selector="^[Position=BottomLeft], ^[Position=BottomCenter], ^[Position=BottomRight]">
            <Setter Property="ThemePadding" Value="{atom:NotificationCardTokenResource NotificationBottomMargin}" />
        </Style>

        <Style Selector="^[Position=TopLeft] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=TopCenter] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=TopRight] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=BottomLeft] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[Position=BottomCenter] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[Position=BottomRight] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
