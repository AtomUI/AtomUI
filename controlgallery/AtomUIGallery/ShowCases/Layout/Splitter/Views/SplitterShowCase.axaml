<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Splitter.SplitterShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Splitter"
             x:DataType="vm:SplitterViewModel">
    <UserControl.Styles>
        <Style Selector="Border.splitter-surface">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BoxShadow" Value="0 0 10 0 #1A000000" />
        </Style>
        <Style Selector="Border.splitter-panel">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Border.splitter-panel.alt">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorFillAlter}" />
        </Style>
        <Style Selector="TextBlock.splitter-label">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDescription}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Splitter"
                    Category="{gallery:SplitterShowCaseLangResource ComponentCategory}"
                    Status="{gallery:SplitterShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:SplitterShowCaseLangResource PageSubtitle}"
                    Description="{gallery:SplitterShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="TemplatedControl" />
            </gallery:GalleryShowCaseHost.Header>



            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:SplitterViewModel">
                    <StackPanel Spacing="24">
                        <gallery:SemanticPartPreview Name="SplitterSemanticPreview"
                                                     SemanticOwner="{Binding #SplitterSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:Splitter}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:Splitter Name="SplitterSemanticOwner"
                                               Orientation="Vertical"
                                               Height="220">
                                    <Border Classes="splitter-panel"
                                            atom:Splitter.Size="45%">
                                        <TextBlock Classes="splitter-label"
                                                   Text="{gallery:SplitterShowCaseLangResource P2TextFirst}" />
                                    </Border>
                                    <Border Classes="splitter-panel alt">
                                        <TextBlock Classes="splitter-label"
                                                   Text="{gallery:SplitterShowCaseLangResource P2TextSecond}" />
                                    </Border>
                                </atom:Splitter>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:SplitterShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="panel"
                                    Description="{gallery:SplitterShowCaseLangResource SemanticPanelDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="dragger"
                                    Description="{gallery:SplitterShowCaseLangResource SemanticDraggerDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource BasicTitle}" Description="{gallery:SplitterShowCaseLangResource BasicDescription}" IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <Border Classes="splitter-surface">
                        <atom:Splitter Orientation="Vertical" Height="220">
                            <Border Classes="splitter-panel" atom:Splitter.Size="30%">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextFirst}" />
                            </Border>
                            <Border Classes="splitter-panel" atom:Splitter.DefaultSize="100" atom:Splitter.MinSize="60">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextSecond}" />
                            </Border>
                        </atom:Splitter>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource HorizontalTitle}" Description="{gallery:SplitterShowCaseLangResource HorizontalDescription}" IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <Border Classes="splitter-surface">
                        <atom:Splitter Orientation="Horizontal" Height="220">
                            <Border Classes="splitter-panel" atom:Splitter.Size="40%">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextTop}" />
                            </Border>
                            <Border Classes="splitter-panel alt">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextBottom}" />
                            </Border>
                        </atom:Splitter>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource CompositeTitle}" Description="{gallery:SplitterShowCaseLangResource CompositeDescription}" IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <Border Classes="splitter-surface">
                        <atom:Splitter Orientation="Vertical" Height="260">
                            <Border Classes="splitter-panel" atom:Splitter.Size="40%">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextLeft}" />
                            </Border>
                            <atom:Splitter Orientation="Horizontal">
                                <Border Classes="splitter-panel">
                                    <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextTop}" />
                                </Border>
                                <Border Classes="splitter-panel alt">
                                    <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextBottom}" />
                                </Border>
                            </atom:Splitter>
                        </atom:Splitter>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource ResizableDisabledTitle}" Description="{gallery:SplitterShowCaseLangResource ResizableDisabledDescription}" IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <Border Classes="splitter-surface">
                        <atom:Splitter Orientation="Vertical" Height="220">
                            <Border Classes="splitter-panel" atom:Splitter.Size="35%">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextResizable}" />
                            </Border>
                            <Border Classes="splitter-panel alt" atom:Splitter.DefaultSize="120" atom:Splitter.IsResizable="False">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextNotResizable}" />
                            </Border>
                            <Border Classes="splitter-panel" atom:Splitter.DefaultSize="120">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextResizable}" />
                            </Border>
                        </atom:Splitter>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource ShowCollapsibleIconTitle}"
                                      Description="{gallery:SplitterShowCaseLangResource ShowCollapsibleIconDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <Border Classes="splitter-surface" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Text="{gallery:SplitterShowCaseLangResource P2TextShowcollapsibleicon}" />
                                <atom:RadioButton GroupName="ShowCollapsibleIconMode"
                                                  Tag="Hover"
                                                  IsCheckedChanged="HandleShowCollapsibleIconChanged" Content="{gallery:SplitterShowCaseLangResource P2ContentHover}" />
                                <atom:RadioButton GroupName="ShowCollapsibleIconMode"
                                                  Tag="True"
                                                  IsChecked="True"
                                                  IsCheckedChanged="HandleShowCollapsibleIconChanged" Content="{gallery:SplitterShowCaseLangResource P2ContentTrue}" />
                                <atom:RadioButton GroupName="ShowCollapsibleIconMode"
                                                  Tag="False"
                                                  IsCheckedChanged="HandleShowCollapsibleIconChanged" Content="{gallery:SplitterShowCaseLangResource P2ContentFalse}" />
                            </StackPanel>
                            <atom:Splitter Orientation="Vertical" Height="220">
                                <Border Classes="splitter-panel"
                                        x:Name="ShowCollapsiblePanelFirst"
                                        atom:Splitter.Collapsible="Always"
                                        atom:Splitter.DefaultSize="33%">
                                    <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextFirst}" />
                                </Border>
                                <Border Classes="splitter-panel alt" x:Name="ShowCollapsiblePanelSecond"
                                        atom:Splitter.Collapsible="Always"
                                        atom:Splitter.DefaultSize="34%">
                                    <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextSecond}" />
                                </Border>
                                <Border Classes="splitter-panel"
                                        atom:Splitter.Collapsible="Always"
                                        x:Name="ShowCollapsiblePanelThird">
                                    <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextThird}" />
                                </Border>
                            </atom:Splitter>
                        </StackPanel>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource MultiPanelsTitle}" Description="{gallery:SplitterShowCaseLangResource MultiPanelsDescription}" IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <Border Classes="splitter-surface">
                        <atom:Splitter Orientation="Vertical" Height="240">
                            <Border Classes="splitter-panel" atom:Splitter.Size="20%">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextA}" />
                            </Border>
                            <Border Classes="splitter-panel alt" atom:Splitter.Size="20%">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextB}" />
                            </Border>
                            <Border Classes="splitter-panel">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextC}" />
                            </Border>
                            <Border Classes="splitter-panel alt">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextD}" />
                            </Border>
                        </atom:Splitter>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource DoubleClickResetTitle}"
                                      Description="{gallery:SplitterShowCaseLangResource DoubleClickResetDescription}"
                                      SourceKey="splitter-double-click-reset"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <Border Classes="splitter-surface">
                        <atom:Splitter Orientation="Vertical"
                                       Height="220"
                                       DraggerDoubleClicked="HandleDraggerDoubleClicked">
                            <Border Classes="splitter-panel" atom:Splitter.DefaultSize="30%">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextPanel1}" />
                            </Border>
                            <Border Classes="splitter-panel alt" atom:Splitter.DefaultSize="40%">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextPanel2}" />
                            </Border>
                            <Border Classes="splitter-panel" atom:Splitter.DefaultSize="30%">
                                <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextPanel3}" />
                            </Border>
                        </atom:Splitter>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource LazyTitle}"
                                      Description="{gallery:SplitterShowCaseLangResource LazyDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <Border Classes="splitter-surface" Padding="16">
                        <StackPanel Spacing="12">
                            <atom:Splitter Orientation="Vertical" Height="140" IsLazy="True">
                                <Border Classes="splitter-panel" atom:Splitter.Size="50%">
                                    <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextFirst}" />
                                </Border>
                                <Border Classes="splitter-panel alt">
                                    <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextSecond}" />
                                </Border>
                            </atom:Splitter>
                            <atom:Splitter Orientation="Horizontal" Height="140" IsLazy="True">
                                <Border Classes="splitter-panel" atom:Splitter.Size="50%">
                                    <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextFirst}" />
                                </Border>
                                <Border Classes="splitter-panel alt">
                                    <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextSecond}" />
                                </Border>
                            </atom:Splitter>
                        </StackPanel>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource LineStyleTitle}"
                                      Description="{gallery:SplitterShowCaseLangResource LineStyleDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <atom:Splitter Orientation="Vertical"
                                   Height="220"
                                   Background="{atom:SharedTokenResource ColorBgContainer}"
                                   BorderBrush="{atom:SharedTokenResource ColorBorder}"
                                   BorderThickness="1"
                                   CornerRadius="8"
                                   LineThickness="4"
                                   LineCornerRadius="4">
                        <Border Classes="splitter-panel"
                                CornerRadius="8,0,0,8"
                                atom:Splitter.Size="45%">
                            <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextFirst}" />
                        </Border>
                        <Border Classes="splitter-panel alt"
                                CornerRadius="0,8,8,0">
                            <TextBlock Classes="splitter-label" Text="{gallery:SplitterShowCaseLangResource P2TextSecond}" />
                        </Border>
                    </atom:Splitter>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplitterShowCaseLangResource SemanticPartStyleTitle}"
                                      Description="{gallery:SplitterShowCaseLangResource SemanticPartStyleDescription}"
                                      SourceKey="splitter-semantic-part"
                                      BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                                      Span="Full"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplitterViewModel">
                    <StackPanel Orientation="Vertical"
                                Spacing="24">
                        <StackPanel.Styles>
                            <Style Selector="atom|Splitter.semantic-style-demo-default">
                                <Setter Property="Height" Value="200" />
                                <Setter Property="Background" Value="#FFFBE6" />
                                <atom:SplitterDraggerStyle x:SetterTargetType="atom:Thumb">
                                    <Setter Property="Background" Value="#66C2DFFC" />
                                </atom:SplitterDraggerStyle>
                            </Style>
                            <Style Selector="atom|Splitter.semantic-style-demo-dashed">
                                <Setter Property="Height" Value="200" />
                                <Setter Property="BorderBrush" Value="#E0000000" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderDashArray" Value="4,2" />
                            </Style>
                            <Style Selector="TextBlock.splitter-demo-label">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Style>
                        </StackPanel.Styles>

                        <Border Classes="splitter-surface">
                            <atom:Splitter Classes="semantic-style-demo-default"
                                           Orientation="Vertical">
                                <Border>
                                    <TextBlock Classes="splitter-demo-label"
                                               Text="{gallery:SplitterShowCaseLangResource P2TextFirst}" />
                                </Border>
                                <Border>
                                    <TextBlock Classes="splitter-demo-label"
                                               Text="{gallery:SplitterShowCaseLangResource P2TextSecond}" />
                                </Border>
                            </atom:Splitter>
                        </Border>

                        <Border Classes="splitter-surface">
                            <atom:Splitter Classes="semantic-style-demo-dashed"
                                           Orientation="Vertical">
                                <Border>
                                    <TextBlock Classes="splitter-label"
                                               Text="{gallery:SplitterShowCaseLangResource P2TextFirst}" />
                                </Border>
                                <Border>
                                    <TextBlock Classes="splitter-label"
                                               Text="{gallery:SplitterShowCaseLangResource P2TextSecond}" />
                                </Border>
                            </atom:Splitter>
                        </Border>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
