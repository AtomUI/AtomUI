<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:TransferTreeView}" TargetType="atom:TransferTreeView">
        <Setter Property="atom:TreeViewItemHeader.ThemeHeaderHeight" Value="{atom:TransferTreeViewTokenResource HeaderHeight}" />
        <Setter Property="atom:TreeViewItemHeader.ThemeNodeHoverBg" Value="{atom:TransferTreeViewTokenResource NodeHoverBg}" />
        <Setter Property="atom:TreeViewItemHeader.ThemeNodeSelectedBg" Value="{atom:TransferTreeViewTokenResource NodeSelectedBg}" />
        <Setter Property="atom:TreeViewItemHeader.ThemeNodeSelectedColor" Value="{atom:TransferTreeViewTokenResource NodeSelectedColor}" />


        <Setter Property="atom:TreeViewItemHeader.ThemeTreeItemMargin" Value="{atom:TransferTreeViewTokenResource TreeItemMargin}" />
        <Setter Property="atom:TreeViewItemHeader.ThemeTreeItemHeaderPadding" Value="{atom:TransferTreeViewTokenResource TreeItemHeaderPadding}" />
        <Setter Property="atom:TreeViewItemHeader.ThemeTreeItemHeaderMargin" Value="{atom:TransferTreeViewTokenResource TreeItemHeaderMargin}" />
        <Setter Property="atom:TreeViewItemHeader.ThemeTreeNodeSwitcherMargin" Value="{atom:TransferTreeViewTokenResource TreeNodeSwitcherMargin}" />
        <Setter Property="atom:TreeViewItemHeader.ThemeTreeNodeIconMargin" Value="{atom:TransferTreeViewTokenResource TreeNodeIconMargin}" />
        <Setter Property="atom:TreeViewItemHeader.ThemeDragIndicatorLineWidth" Value="{atom:TransferTreeViewTokenResource DragIndicatorLineWidth}" />
        <Setter Property="atom:TreeViewItemHeader.ThemeFilterHighlightColor" Value="{atom:TransferTreeViewTokenResource FilterHighlightColor}" />

        <ControlTheme.BasedOn>
            <atom:TreeViewTheme TargetType="atom:TransferTreeView"/>
        </ControlTheme.BasedOn>
        
        <Setter Property="ToggleType" Value="CheckBox"/>
        <Setter Property="IsCheckStrictly" Value="True"/>
    </ControlTheme>
</ResourceDictionary>