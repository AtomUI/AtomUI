<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Tour.TourShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Tour"
             xmlns:views="using:AtomUIGallery.ShowCases.Tour"
             x:DataType="vm:TourViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Tour"
                    Category="{gallery:TourShowCaseLangResource ComponentCategory}"
                    Status="{gallery:TourShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:TourShowCaseLangResource PageSubtitle}"
                    Description="{gallery:TourShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="Tour"
                    MetadataValueWidth="220" />
            </gallery:GalleryShowCaseHost.Header>

            <!-- 语义预览对齐 antd Tour _semantic 演示：Tour 默认打开、舞台居中
                 锚点按钮、第一步带封面与遮罩，切换部件时高亮相应节点。 -->
            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:TourViewModel">
                    <gallery:SemanticPartPreview Name="TourSemanticPreview"
                                                 Title="Tour"
                                                 SemanticOwner="{Binding #TourSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:Tour}"
                                                 PreviewStageMinHeight="600">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <!-- 对齐上游 SemanticPreview 舞台（position:relative + overflow:hidden +
                                 getPopupContainer=false）：遮罩的共享 TourLayer 宿主在舞台内嵌的
                                 VisualLayerManager，只覆盖舞台区域，不覆盖整个窗口。 -->
                            <Border Name="TourSemanticStage"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Height="600"
                                    ClipToBounds="True">
                                <VisualLayerManager>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="10"
                                                Name="TourSemanticStagePanel"
                                                AttachedToVisualTree="HandleSemanticStageAttached">
                                    <StackPanel.Styles>
                                        <!-- 对齐 antd mask 语义的"指针事件"定制维度：
                                             预览舞台上让遮罩不参与命中测试，部件卡可 hover。 -->
                                        <Style Selector="atom|Tour.semantic-preview-stage">
                                            <atom:TourPopupMaskStyle x:SetterTargetType="Control">
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </atom:TourPopupMaskStyle>
                                        </Style>
                                    </StackPanel.Styles>
                                    <atom:Button Name="TourSemanticAnchorButton"
                                                 Content="Show" />
                                    <atom:Tour Name="TourSemanticOwner"
                                               Classes="semantic-preview-stage"
                                               IsMotionEnabled="False"
                                               IsPopupPinnedOpen="True"
                                               IsShowMask="True">
                                        <atom:TourStep Name="TourSemanticHelloStep"
                                                       Title="{gallery:TourShowCaseLangResource P2SemanticStepTitle}"
                                                       Description="{gallery:TourShowCaseLangResource P2SemanticStepDescription}">
                                            <atom:TourStep.Cover>
                                                <Image Source="/Assets/TourShowCase/Cover.png"
                                                       Width="360" />
                                            </atom:TourStep.Cover>
                                        </atom:TourStep>
                                        <atom:TourStep Name="TourSemanticSaveStep"
                                                       Title="{gallery:TourShowCaseLangResource P2SemanticStepSaveTitle}"
                                                       Description="{gallery:TourShowCaseLangResource P2SemanticStepSaveDescription}" />
                                    </atom:Tour>
                                </StackPanel>
                                </VisualLayerManager>
                            </Border>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:TourShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.root"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.mask"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupMaskDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.section"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupSectionDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.cover"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupCoverDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.close"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupCloseDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.header"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupHeaderDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.title"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupTitleDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.description"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupDescriptionDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.footer"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupFooterDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.actions"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupActionsDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.indicators"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupIndicatorsDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.indicator"
                                Description="{gallery:TourShowCaseLangResource SemanticPopupIndicatorDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:TourShowCaseLangResource BasicTitle}"
                    Description="{gallery:TourShowCaseLangResource BasicDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:TourViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10" Loaded="HandleTourExampleLoaded">
                                <atom:Button ButtonType="Primary" Click="HandleBasicBeginTour" Content="{gallery:TourShowCaseLangResource P2ContentBeginTour}" />
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button Name="BasicCaseUpload" Content="{gallery:TourShowCaseLangResource P2ContentUpload}" />
                                    <atom:Button ButtonType="Primary" Name="BasicCaseSave" Content="{gallery:TourShowCaseLangResource P2ContentSave}" />
                                    <atom:Button Name="BasicCaseEllipsis"
                                                 Icon="{antdicons:AntDesignIconProvider EllipsisOutlined}" />
                                </StackPanel>
                                <atom:Tour IsOpen="{Binding BasicCaseTourOpened, Mode=TwoWay}">
                                    <atom:TourStep Name="BasicCaseUploadStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleUploadFile}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionPutYourFilesHere}">
                                        <atom:TourStep.Cover>
                                            <Image Source="/Assets/TourShowCase/Cover.png"
                                                   Width="400" />
                                        </atom:TourStep.Cover>
                                    </atom:TourStep>
                                    <atom:TourStep Name="BasicCaseSaveStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleSave}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionSaveYourChanges}" />
                                    <atom:TourStep Name="BasicCaseEllipsisStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleOtherActions}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionClickToSeeOtherActions}" />
                                </atom:Tour>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>

                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:TourShowCaseLangResource NonModalTitle}"
                    Description="{gallery:TourShowCaseLangResource NonModalDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:TourViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10" Loaded="HandleTourExampleLoaded">
                                <atom:Button ButtonType="Primary" Click="HandleNonMaskBeginTour" Content="{gallery:TourShowCaseLangResource P2ContentBeginNonModalTour}" />
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button Name="NonMaskCaseUpload" Content="{gallery:TourShowCaseLangResource P2ContentUpload}" />
                                    <atom:Button ButtonType="Primary" Name="NonMaskSave" Content="{gallery:TourShowCaseLangResource P2ContentSave}" />
                                    <atom:Button Name="NonMaskEllipsis"
                                                 Icon="{antdicons:AntDesignIconProvider EllipsisOutlined}" />
                                </StackPanel>
                                <atom:Tour IsOpen="{Binding NonMaskTourOpened, Mode=TwoWay}" IsShowMask="False" StyleType="Primary">
                                    <atom:TourStep Name="NonMaskCaseUploadStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleUploadFile}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionPutYourFilesHere}">
                                        <atom:TourStep.Cover>
                                            <Image Source="/Assets/TourShowCase/Cover.png"
                                                   Width="400" />
                                        </atom:TourStep.Cover>
                                    </atom:TourStep>
                                    <atom:TourStep Name="NonMaskSaveStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleSave}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionSaveYourChanges}" />
                                    <atom:TourStep Name="NonMaskEllipsisStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleOtherActions}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionClickToSeeOtherActions}" />
                                </atom:Tour>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>

                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:TourShowCaseLangResource PlacementTitle}"
                    Description="{gallery:TourShowCaseLangResource PlacementDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:TourViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10" Loaded="HandleTourExampleLoaded">
                                <atom:Button ButtonType="Primary" Click="HandlePlacementBeginTour" Name="PlacementBeginTour" Content="{gallery:TourShowCaseLangResource P2ContentBeginTour}" />
                                <atom:Tour IsOpen="{Binding PlacementTourOpened, Mode=TwoWay}" IsShowMask="True">
                                    <atom:TourStep Title="{gallery:TourShowCaseLangResource P2TitleCenter}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionDisplayedInTheCenterOfScreen}" />
                                    <atom:TourStep Name="PlacementRightStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleRight}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionOnTheRightOfTarget}"
                                                   Placement="Right" />
                                    <atom:TourStep Name="PlacementTopStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleTop}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionOnTheTopOfTarget}"
                                                   Placement="Top" />
                                    <atom:TourStep Name="PlacementLeftStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleLeft}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionOnTheLeftOfTarget}"
                                                   Placement="Left" />
                                </atom:Tour>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>

                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:TourShowCaseLangResource CustomIndicatorTitle}"
                    Description="{gallery:TourShowCaseLangResource CustomIndicatorDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:TourViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10" Loaded="HandleTourExampleLoaded">
                                <atom:Button ButtonType="Primary" Click="HandleCustomIndicatorBeginTour" Content="{gallery:TourShowCaseLangResource P2ContentBeginTour}" />
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button Name="CustomIndicatorUpload" Content="{gallery:TourShowCaseLangResource P2ContentUpload}" />
                                    <atom:Button ButtonType="Primary" Name="CustomIndicatorSave" Content="{gallery:TourShowCaseLangResource P2ContentSave}" />
                                    <atom:Button Name="CustomIndicatorEllipsis"
                                                 Icon="{antdicons:AntDesignIconProvider EllipsisOutlined}" />
                                </StackPanel>
                                <atom:Tour IsOpen="{Binding CustomIndicatorTourOpened, Mode=TwoWay}">
                                    <atom:Tour.Indicator>
                                        <atom:TextTourIndicator />
                                    </atom:Tour.Indicator>
                                    <atom:TourStep Name="CustomIndicatorUploadStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleUploadFile}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionPutYourFilesHere}">
                                        <atom:TourStep.Cover>
                                            <Image Source="/Assets/TourShowCase/Cover.png"
                                                   Width="400" />
                                        </atom:TourStep.Cover>
                                    </atom:TourStep>
                                    <atom:TourStep Name="CustomIndicatorSaveStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleSave}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionSaveYourChanges}" />
                                    <atom:TourStep Name="CustomIndicatorEllipsisStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleOtherActions}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionClickToSeeOtherActions}" />
                                </atom:Tour>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>

                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:TourShowCaseLangResource CustomMaskTitle}"
                    Description="{gallery:TourShowCaseLangResource CustomMaskDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:TourViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10" Loaded="HandleTourExampleLoaded">
                                <atom:Button ButtonType="Primary" Click="HandleCustomMaskBeginTour" Content="{gallery:TourShowCaseLangResource P2ContentBeginTour}" />
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button Name="CustomMaskUpload" Content="{gallery:TourShowCaseLangResource P2ContentUpload}" />
                                    <atom:Button ButtonType="Primary" Name="CustomMaskSave" Content="{gallery:TourShowCaseLangResource P2ContentSave}" />
                                    <atom:Button Name="CustomMaskEllipsis"
                                                 Icon="{antdicons:AntDesignIconProvider EllipsisOutlined}" />
                                </StackPanel>
                                <atom:Tour IsOpen="{Binding CustomMaskTourOpened, Mode=TwoWay}"
                                           MaskColor="#6650FFFF">
                                    <atom:TourStep Name="CustomMaskUploadStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleUploadFile}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionPutYourFilesHere}">
                                        <atom:TourStep.Cover>
                                            <Image Source="/Assets/TourShowCase/Cover.png"
                                                   Width="400" />
                                        </atom:TourStep.Cover>
                                    </atom:TourStep>
                                    <atom:TourStep Name="CustomMaskSaveStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleSave}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionSaveYourChanges}"
                                                   MaskColor="#662800FF"/>
                                    <atom:TourStep Name="CustomMaskEllipsisStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleOtherActions}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionClickToSeeOtherActions}"
                                                   IsShowMask="False"/>
                                </atom:Tour>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>

                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:TourShowCaseLangResource CustomActionTitle}"
                    Description="{gallery:TourShowCaseLangResource CustomActionDescription}" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:TourViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10" Loaded="HandleTourExampleLoaded">
                                <atom:Button ButtonType="Primary" Click="HandleCustomActionBeginTour" Content="{gallery:TourShowCaseLangResource P2ContentBeginTour}" />
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button Name="CustomActionUpload" Content="{gallery:TourShowCaseLangResource P2ContentUpload}" />
                                    <atom:Button ButtonType="Primary" Name="CustomActionSave" Content="{gallery:TourShowCaseLangResource P2ContentSave}" />
                                    <atom:Button Name="CustomActionEllipsis"
                                                 Icon="{antdicons:AntDesignIconProvider EllipsisOutlined}" />
                                </StackPanel>
                                <atom:Tour IsOpen="{Binding CustomActionTourOpened, Mode=TwoWay}">
                                    <atom:Tour.CustomActions>
                                        <views:SkipTourActionButton Content="{gallery:TourShowCaseLangResource P2ContentSkip}" />
                                    </atom:Tour.CustomActions>
                                    <atom:TourStep Name="CustomActionUploadStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleUploadFile}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionPutYourFilesHere}">
                                        <atom:TourStep.Cover>
                                            <Image Source="/Assets/TourShowCase/Cover.png"
                                                   Width="400" />
                                        </atom:TourStep.Cover>
                                    </atom:TourStep>
                                    <atom:TourStep Name="CustomActionSaveStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleSave}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionSaveYourChanges}" />
                                    <atom:TourStep Name="CustomActionEllipsisStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleOtherActions}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionClickToSeeOtherActions}" />
                                </atom:Tour>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>

                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:TourShowCaseLangResource CustomHighlightedAreaStyleTitle}"
                    Description="{gallery:TourShowCaseLangResource CustomHighlightedAreaStyleDescription}"
                    IsOccupyEntireRow="True" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:TourViewModel">
                            <StackPanel Orientation="Vertical" Margin="50, 0, 50, 0" Loaded="HandleTourExampleLoaded">
                                <StackPanel Orientation="Vertical" Spacing="10" Name="CustomGapControl">
                                    <atom:Button ButtonType="Primary" Click="HandleCustomGapBeginTour" Content="{gallery:TourShowCaseLangResource P2ContentBeginTour}" />
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Width="200" DockPanel.Dock="Left" Text="{gallery:TourShowCaseLangResource P2TextRadius}" />
                                        <atom:Slider Minimum="0" Maximum="100" Value="{Binding CustomGapRadius, Mode=TwoWay}"/>
                                    </DockPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Width="200" DockPanel.Dock="Left" Text="{gallery:TourShowCaseLangResource P2TextHorizontalOffset}" />
                                        <atom:Slider Minimum="1" Maximum="50" Value="{Binding CustomGapOffsetX, Mode=TwoWay}"/>
                                    </DockPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Width="200" DockPanel.Dock="Left" Text="{gallery:TourShowCaseLangResource P2TextVerticalOffset}" />
                                        <atom:Slider Minimum="1" Maximum="50" Value="{Binding CustomGapOffsetY, Mode=TwoWay}"/>
                                    </DockPanel>
                                </StackPanel>

                                <atom:Tour IsOpen="{Binding CustomGapTourOpened, Mode=TwoWay}" Placement="Top"
                                           GapRadius="{Binding CustomGapRadius}"
                                           GapOffsetX="{Binding CustomGapOffsetX}"
                                           GapOffsetY="{Binding CustomGapOffsetY}">
                                    <atom:TourStep Name="CustomGapStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleUploadFile}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionPutYourFilesHere}">
                                        <atom:TourStep.Cover>
                                            <Image Source="/Assets/TourShowCase/Cover.png"
                                                   Width="400" />
                                        </atom:TourStep.Cover>
                                    </atom:TourStep>
                                </atom:Tour>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>

                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:TourShowCaseLangResource SemanticStylesTitle}"
                    Description="{gallery:TourShowCaseLangResource SemanticStylesDescription}"
                    IsOccupyEntireRow="True" IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:TourViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10" Loaded="HandleTourExampleLoaded">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button ButtonType="Primary" Click="HandleSemanticStylesObjectBeginTour"
                                                 Content="{gallery:TourShowCaseLangResource SemanticStylesObjectButton}" />
                                    <atom:Button ButtonType="Primary" Click="HandleSemanticStylesFunctionBeginTour"
                                                 Content="{gallery:TourShowCaseLangResource SemanticStylesFunctionButton}" />
                                </StackPanel>
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button Name="SemanticStylesUpload" Content="{gallery:TourShowCaseLangResource P2ContentUpload}" />
                                    <atom:Button ButtonType="Primary" Name="SemanticStylesSave" Content="{gallery:TourShowCaseLangResource P2ContentSave}" />
                                    <atom:Button Name="SemanticStylesEllipsis"
                                                 Icon="{antdicons:AntDesignIconProvider EllipsisOutlined}" />
                                </StackPanel>

                                <!-- 对象样式：语义部件专用 Style 定制 root/section/cover/mask -->
                                <atom:Tour Name="SemanticStylesObjectTour"
                                           Classes="semantic-object-style-demo"
                                           IsOpen="{Binding SemanticStylesObjectTourOpened, Mode=TwoWay}"
                                           MaskColor="#73000000"
                                           IsArrowVisible="False">
                                    <atom:Tour.Styles>
                                        <Style Selector="atom|Tour.semantic-object-style-demo">
                                            <atom:TourPopupRootStyle x:SetterTargetType="atom:ArrowDecoratedBox">
                                                <Setter Property="CornerRadius" Value="4" />
                                            </atom:TourPopupRootStyle>
                                            <atom:TourPopupSectionStyle x:SetterTargetType="Border">
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Setter Property="BorderBrush" Value="#4096ff" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="BoxShadow" Value="0 4 12 0 #26000000" />
                                            </atom:TourPopupSectionStyle>
                                            <atom:TourPopupCoverStyle x:SetterTargetType="ContentPresenter">
                                                <Setter Property="CornerRadius" Value="12,12,0,0" />
                                            </atom:TourPopupCoverStyle>
                                        </Style>
                                    </atom:Tour.Styles>
                                    <atom:TourStep Name="SemanticStylesObjectUploadStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleUploadFile}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionPutYourFilesHere}">
                                        <atom:TourStep.Cover>
                                            <Image Source="/Assets/TourShowCase/Cover.png"
                                                   Width="400" />
                                        </atom:TourStep.Cover>
                                    </atom:TourStep>
                                    <atom:TourStep Name="SemanticStylesObjectSaveStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleSave}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionSaveYourChanges}" />
                                    <atom:TourStep Name="SemanticStylesObjectEllipsisStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleOtherActions}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionClickToSeeOtherActions}" />
                                </atom:Tour>

                                <!-- 函数样式：primary 变体的 section/mask 定制 -->
                                <atom:Tour Name="SemanticStylesFunctionTour"
                                           Classes="semantic-function-style-demo"
                                           StyleType="Primary"
                                           IsOpen="{Binding SemanticStylesFunctionTourOpened, Mode=TwoWay}"
                                           MaskColor="#73000000"
                                           IsArrowVisible="False">
                                    <atom:Tour.Styles>
                                        <Style Selector="atom|Tour.semantic-function-style-demo">
                                            <atom:TourPopupSectionStyle x:SetterTargetType="Border">
                                                <Setter Property="Background" Value="#CCCDC1FF" />
                                                <Setter Property="CornerRadius" Value="8" />
                                            </atom:TourPopupSectionStyle>
                                            <atom:TourPopupIndicatorStyle x:SetterTargetType="Ellipse">
                                                <Setter Property="Fill" Value="#CDC1FF" />
                                            </atom:TourPopupIndicatorStyle>
                                            <!-- 对齐上游 style-class demo 的 btnProps（prev 紫底白字，next 白底紫描边紫字）
                                                 叠加 tour primary 的 hover 规则：prev 仅边框变化（白@15% → 透明），
                                                 next 仅背景变化（ColorBgTextHover 叠白 = PrimaryNextBtnHoverBg）。
                                                 owner 作用域的无激活 Setter 优先级高于 ControlTheme 的 :pointerover
                                                 激活式 Setter，伪类态必须在 owner 作用域显式声明才能生效。 -->
                                            <atom:TourPopupActionsStyle x:SetterTargetType="StackPanel">
                                                <Style Selector="^ atom|Button.previous-btn">
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="Background" Value="#CDC1FF" />
                                                    <Setter Property="BorderBrush" Value="#26FFFFFF" />
                                                </Style>
                                                <Style Selector="^ atom|Button.previous-btn:pointerover">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                </Style>
                                                <Style Selector="^ atom|Button.next-btn">
                                                    <Setter Property="Foreground" Value="#CDC1FF" />
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#CDC1FF" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </Style>
                                                <Style Selector="^ atom|Button.next-btn:pointerover">
                                                    <Setter Property="Background" Value="{atom:TourTokenResource PrimaryNextBtnHoverBg}" />
                                                </Style>
                                            </atom:TourPopupActionsStyle>
                                        </Style>
                                    </atom:Tour.Styles>
                                    <atom:TourStep Name="SemanticStylesFunctionUploadStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleUploadFile}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionPutYourFilesHere}">
                                        <atom:TourStep.Cover>
                                            <Image Source="/Assets/TourShowCase/Cover.png"
                                                   Width="400" />
                                        </atom:TourStep.Cover>
                                    </atom:TourStep>
                                    <atom:TourStep Name="SemanticStylesFunctionSaveStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleSave}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionSaveYourChanges}" />
                                    <atom:TourStep Name="SemanticStylesFunctionEllipsisStep"
                                                   Title="{gallery:TourShowCaseLangResource P2TitleOtherActions}"
                                                   Description="{gallery:TourShowCaseLangResource P2DescriptionClickToSeeOtherActions}" />
                                </atom:Tour>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>

                </gallery:ShowCaseItem>


            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
