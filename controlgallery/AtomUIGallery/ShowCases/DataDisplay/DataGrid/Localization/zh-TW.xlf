    <unit id="PageDescription">
      <segment>
        <source>DataGrid presents large tabular datasets with selection, sorting, filtering, frozen columns, row details, editing, drag sorting, and pagination.</source>
        <target state="translated">DataGrid 用於呈現大型表格數據，支援選擇、排序、篩選、固定列、行詳情、編輯、拖拽排序和分頁。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
