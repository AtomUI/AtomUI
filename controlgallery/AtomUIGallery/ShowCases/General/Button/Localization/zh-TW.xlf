    <unit id="IconPlacementDescription">
      <segment>
        <source>Set IconPlacement to Start or End to place the button icon before or after the content.</source>
        <target state="translated">通過設置 IconPlacement 為 Start 或 End 分別設置按鈕圖標的位置。</target>
