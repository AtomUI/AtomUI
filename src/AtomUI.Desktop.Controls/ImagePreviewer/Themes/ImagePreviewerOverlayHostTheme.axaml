<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImagePreviewerOverlayHost}"
                  TargetType="atom:ImagePreviewerOverlayHost">
        <Setter Property="ImageScaleX" Value="1.0" />
        <Setter Property="ImageScaleY" Value="1.0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Classes.semantic-popup-root="True">
                    <Panel Classes.semantic-popup-mask="True"
                           Background="{atom:OwnerTokenResource Kind=ColorBgMask, AnchorControlType={x:Type atom:ImagePreviewerOverlayHost}}" />
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                    <atom:IconButton Name="PART_CloseButton"
                                     Icon="{antdicons:AntDesignIconProvider CloseOutlined}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="{atom:OwnerTokenResource Kind=MarginSM, AnchorControlType={x:Type atom:ImagePreviewerOverlayHost}}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ atom|IconButton#PART_CloseButton">
            <Setter Property="IconWidth" Value="{atom:ImagePreviewerTokenResource PreviewOperationSize}" />
            <Setter Property="IconHeight" Value="{atom:ImagePreviewerTokenResource PreviewOperationSize}" />
            <Setter Property="IconBrush" Value="{atom:OwnerTokenResource Kind=ColorTextLightSolid, AnchorControlType={x:Type atom:ImagePreviewerOverlayHost}}" />
            <Setter Property="Background" Value="{atom:ImagePreviewerTokenResource NavButtonBgColor}" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Padding" Value="{atom:OwnerTokenResource Kind=PaddingSM, AnchorControlType={x:Type atom:ImagePreviewerOverlayHost}}" />
        </Style>
        <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pointerover">
            <Setter Property="Background" Value="{atom:ImagePreviewerTokenResource NavButtonBgHoverColor}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
