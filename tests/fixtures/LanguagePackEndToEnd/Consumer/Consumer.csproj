<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Acme.LocalizationConsumer</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <FixturePackageVersion Condition="'$(FixturePackageVersion)' == ''">1.0.0</FixturePackageVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(ConsumerPublishAot)' == 'true'">
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <PublishTrimmed>true</PublishTrimmed>
        <PublishAot>true</PublishAot>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <Import Project="../../../../build/MacOSHomebrewNativeAot.targets"
            Condition="'$(PublishAot)' == 'true'" />

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Acme.LocalizationComponent" VersionOverride="$(FixturePackageVersion)" />
        <PackageReference Include="Acme.LocalizationAggregate.I18n.JaJP" VersionOverride="$(FixturePackageVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../../src/AtomUI.Core/AtomUI.Core.csproj"
                          GlobalPropertiesToRemove="OutputPath" />
        <ProjectReference Include="../../../../src/AtomUI.Generator/AtomUI.Generator.csproj"
                          GlobalPropertiesToRemove="OutputPath"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>
</Project>
