<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:PaletteColorItem}" TargetType="atom:PaletteColorItem">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         Padding="{atom:OwnerTokenResource LineWidth}">
                    <Border Name="ColorPreview"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BoxShadow="{CompiledBinding $self.(atom:ColorPickerAttachedProperties.ColorBlockInnerShadows)}">
                        <antdicons:CheckBoldOutlined Name="PART_CheckedMark"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{TemplateBinding CheckedMarkForeground}"
                                                     FillBrush="{TemplateBinding CheckedMarkForeground}"
                                                     StrokeBrush="{TemplateBinding CheckedMarkForeground}"
                                                     IsVisible="False" 
                                                     RenderTransform="{TemplateBinding CheckedMarkRenderTransform}"
                                                     RenderTransformOrigin="{x:Static RelativePoint.Center}"/>
                    </Border>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#Frame">
            <Setter Property="Width"
                    Value="{CompiledBinding $self.(atom:ColorPickerAttachedProperties.PresetColorSize)}" />
            <Setter Property="Height"
                    Value="{CompiledBinding $self.(atom:ColorPickerAttachedProperties.PresetColorSize)}" />
        </Style>

        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />

        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorFill}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <TransformOperationsTransition Property="CheckedMarkRenderTransform" atom:TokenTransitions.Duration="MotionDurationMid" Easing="BackEaseOut" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Style Selector="^ /template/ atom|Icon#PART_CheckedMark">
            <Setter Property="Width" Value="{CompiledBinding $self.(atom:ColorPickerAttachedProperties.CheckedMarkSize)}" />
            <Setter Property="Height" Value="{CompiledBinding $self.(atom:ColorPickerAttachedProperties.CheckedMarkSize)}" />
        </Style>
        
        <Setter Property="CheckedMarkRenderTransform" Value="scale(0.1)"/>
        
        <Style Selector="^[IsChecked=True]">
            <Style Selector="^ /template/ atom|Icon#PART_CheckedMark">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Setter Property="CheckedMarkRenderTransform" Value="scale(1.0)"/>
        </Style>
        
        <Style Selector="^[IsLightColor=True]">
            <Setter Property="CheckedMarkForeground" Value="{atom:OwnerTokenResource ColorTextSecondary}" />
        </Style>
        
        <Style Selector="^[IsLightColor=False]">
            <Setter Property="CheckedMarkForeground" Value="{atom:OwnerTokenResource ColorWhite}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
