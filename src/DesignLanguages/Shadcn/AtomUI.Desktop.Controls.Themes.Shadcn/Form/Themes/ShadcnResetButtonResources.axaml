<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net">
    <ControlTheme x:Key="AtomUI.Theme.Shadcn.AtomUI.Desktop.Controls.ResetButton"
                  TargetType="atom:ResetButton">
        <ControlTheme.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceInclude Source="avares://AtomUI.Desktop.Controls/Form/Themes/ResetButtonAppearanceResources.axaml" />
                    <ResourceInclude Source="../../Buttons/Themes/ShadcnButtonTemplateResources.axaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </ControlTheme.Resources>
        <ControlTheme.BasedOn>
            <StaticResource ResourceKey="AtomUI.ResetButton.Appearance" />
        </ControlTheme.BasedOn>
        <Setter Property="Template" Value="{StaticResource AtomUI.Shadcn.Button.Template}" />
    </ControlTheme>
</ResourceDictionary>
