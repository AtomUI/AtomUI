    <unit id="PageDescription">
      <segment>
        <source>TreeSelect combines an input selector with tree navigation, making it suitable for hierarchical categories, organization nodes, permissions, and other nested option sets.</source>
        <target state="translated">TreeSelect combines an entrada selector com árvore navegação, making isso suitable para hierarchical categories, organization nodes, permissions, e outro nested opção define.</target>
      </segment>
