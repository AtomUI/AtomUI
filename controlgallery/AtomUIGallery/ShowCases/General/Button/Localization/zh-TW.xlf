    <unit id="ExampleGroupBasicDescription">
      <segment>
        <source>Use button type to express action priority in the current region.</source>
        <target state="translated">通過按鈕類型表達當前區域內操作的優先級。</target>
      </segment>
    </unit>
    <unit id="ExampleGroupBasicTitle">
