    <unit id="TabControlReorderDescription">
      <segment>
        <source>Enable drag sorting with IsTabReorderEnabled. The selected item follows the same logical tab after sorting.</source>
        <target state="translated">通过 IsTabReorderEnabled 开启拖拽排序。排序后选中状态会跟随同一个逻辑标签项。</target>
      </segment>
    </unit>
    <unit id="TabControlReorderPlacementDescription">
      <segment>
        <source>Switch TabStripPlacement to verify drag sorting on horizontal and vertical tab tracks.</source>
        <target state="translated">切换 TabStripPlacement，验证水平和垂直标签轨道下的拖拽排序效果。</target>
