<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Select.SelectShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Select"
             xmlns:views="using:AtomUIGallery.ShowCases.Select"
             x:DataType="vm:SelectViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Select"
                    Category="{gallery:SelectShowCaseLangResource ComponentCategory}"
                    Status="{gallery:SelectShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:SelectShowCaseLangResource PageSubtitle}"
                    Description="{gallery:SelectShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="Select"
                    MetadataValueWidth="220" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:SelectViewModel">
                    <gallery:SemanticPartPreview Name="SelectSemanticPreview"
                                                 Title="Select"
                                                 SemanticOwner="{Binding #SelectSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:Select}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:Select Name="SelectSemanticOwner"
                                         Width="420"
                                         IsAllowClear="True"
                                         IsMotionEnabled="False"
                                         IsDropDownOpen="True"
                                         IsPopupPinnedOpen="True"
                                         Mode="Multiple"
                                         IsFilterEnabled="True"
                                         ContentLeftAddOn="prefix"
                                         SelectedOptions="{Binding SemanticPreviewSelectedOptions}"
                                         OptionsSource="{Binding SemanticPreviewOptions}"
                                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:SelectShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="prefix"
                                Description="{gallery:SelectShowCaseLangResource SemanticPrefixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:SelectShowCaseLangResource SemanticContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="placeholder"
                                Description="{gallery:SelectShowCaseLangResource SemanticPlaceholderDescription}" />
                            <gallery:SemanticPartDescription
                                Path="input"
                                Description="{gallery:SelectShowCaseLangResource SemanticInputDescription}" />
                            <gallery:SemanticPartDescription
                                Path="suffix"
                                Description="{gallery:SelectShowCaseLangResource SemanticSuffixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="item"
                                Description="{gallery:SelectShowCaseLangResource SemanticItemDescription}" />
                            <gallery:SemanticPartDescription
                                Path="itemContent"
                                Description="{gallery:SelectShowCaseLangResource SemanticItemContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="itemRemove"
                                Description="{gallery:SelectShowCaseLangResource SemanticItemRemoveDescription}" />
                            <gallery:SemanticPartDescription
                                Path="clear"
                                Description="{gallery:SelectShowCaseLangResource SemanticClearDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.root"
                                Description="{gallery:SelectShowCaseLangResource SemanticPopupRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.list"
                                Description="{gallery:SelectShowCaseLangResource SemanticPopupListDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.listItem"
                                Description="{gallery:SelectShowCaseLangResource SemanticPopupListItemDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource BasicTitle}"
        Description="{gallery:SelectShowCaseLangResource BasicDescription}" IsOccupyEntireRow="False"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <WrapPanel ItemSpacing="10" LineSpacing="10">
            <atom:Select Mode="Single" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="120"
                         DefaultValues="lucy"
                         OptionsSource="{Binding BasicSelectedOptions}" />

            <atom:Select Mode="Single" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" IsEnabled="False" Width="120"
                         DefaultValues="lucy"
                         OptionsSource="{Binding SingleLucyOptions}" />

            <atom:Select Name="AsyncLoadSelect"
                         Mode="Single"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                         Width="120"
                         DefaultValues="lucy"
                         OptionsSource="{Binding SingleLucyOptions}"
                         OptionsLoader="{Binding SelectOptionsAsyncLoader}" />

            <atom:Select Mode="Single" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" IsAllowClear="True" Width="120"
                         OptionsSource="{Binding SingleLucyOptions}" />

            <atom:Select Name="DefaultSelectedSelect"
                         Mode="Single"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                         IsAllowClear="True"
                         Width="120"
                         OptionsSource="{Binding BasicSelectedOptions}"
                         SelectedOption="{Binding DefaultSelectedOption}" />

        </WrapPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource BindingTitle}"
        Description="{gallery:SelectShowCaseLangResource BindingDescription}"
        BadgeText="v6.0.8"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <WrapPanel ItemSpacing="24" LineSpacing="16">
            <StackPanel Spacing="8" MinWidth="260">
                <TextBlock Text="{gallery:SelectShowCaseLangResource BindingSingleLabel}"
                           FontWeight="SemiBold" />
                <atom:Select Mode="Single"
                             PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             IsAllowClear="True"
                             Width="220"
                             OptionsSource="{Binding BasicSelectedOptions}"
                             SelectedOption="{Binding BoundSelectedOption}" />
                <WrapPanel ItemSpacing="8">
                    <atom:Button SizeType="Small"
                                 Command="{Binding SetBoundSelectedOptionCommand}"
                                 Content="{gallery:SelectShowCaseLangResource BindingSetSingleButton}" />
                    <atom:Button SizeType="Small"
                                 Command="{Binding ClearBoundSelectedOptionCommand}"
                                 Content="{gallery:SelectShowCaseLangResource BindingClearButton}" />
                </WrapPanel>
                <TextBlock Text="{gallery:SelectShowCaseLangResource BindingViewModelValueLabel}" />
                <TextBlock Text="{Binding BoundSelectedOptionText}" />
            </StackPanel>

            <StackPanel Spacing="8" MinWidth="320">
                <TextBlock Text="{gallery:SelectShowCaseLangResource BindingMultipleLabel}"
                           FontWeight="SemiBold" />
                <atom:Select Mode="Multiple"
                             PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextSelectAPerson}"
                             IsAllowClear="True"
                             IsFilterEnabled="True"
                             Width="300"
                             OptionsSource="{Binding BasicSelectedOptions}"
                             SelectedOptions="{Binding BoundSelectedOptions}" />
                <WrapPanel ItemSpacing="8">
                    <atom:Button SizeType="Small"
                                 Command="{Binding SetBoundSelectedOptionsCommand}"
                                 Content="{gallery:SelectShowCaseLangResource BindingSetMultipleButton}" />
                    <atom:Button SizeType="Small"
                                 Command="{Binding ClearBoundSelectedOptionsCommand}"
                                 Content="{gallery:SelectShowCaseLangResource BindingClearButton}" />
                </WrapPanel>
                <TextBlock Text="{gallery:SelectShowCaseLangResource BindingViewModelValueLabel}" />
                <TextBlock Text="{Binding BoundSelectedOptionsText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </WrapPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource SearchFieldTitle}"
        Description="{gallery:SelectShowCaseLangResource SearchFieldDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <atom:Select Mode="Single"
                     PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                     IsFilterEnabled="True"
                     OptionsSource="{Binding SearchOptions}" />

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource CustomSearchTitle}"
        Description="{gallery:SelectShowCaseLangResource CustomSearchDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <atom:Select Name="CustomSearchSelect"
                     AttachedToVisualTree="HandleCustomSearchSelectAttached"
                     Mode="Single"
                     PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextSelectAPerson}"
                     IsFilterEnabled="True"
                     Filter="{atom:ValueFilterProvider Contains}"
                     OptionsSource="{Binding SearchOptions}" />

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource MultipleSelectionTitle}"
        Description="{gallery:SelectShowCaseLangResource MultipleSelectionDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Select Name="MultiSelect1"
                         Mode="Multiple"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextSelectAPerson}"
                         IsAllowClear="True"
                         HorizontalAlignment="Stretch"
                         IsFilterEnabled="True"
                         DefaultValues="a10, c12"
                         OptionsSource="{Binding RandomOptions}" />
            <atom:Select Name="MultiSelect2"
                         Mode="Multiple"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextSelectAPerson}"
                         IsAllowClear="True"
                         HorizontalAlignment="Stretch"
                         DefaultValues="a10, c12"
                         IsEnabled="False"
                         OptionsSource="{Binding RandomOptions}" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource TagsTitle}"
        Description="{gallery:SelectShowCaseLangResource TagsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Select Name="TagsModeSelect"
                         Mode="Tags"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextTagsMode}"
                         HorizontalAlignment="Stretch"
                         IsFilterEnabled="True"
                         Filter="{atom:ValueFilterProvider Contains}"
                         OptionsSource="{Binding RandomOptions}" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource CustomDropdownOptionsTitle}"
        Description="{gallery:SelectShowCaseLangResource CustomDropdownOptionsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <atom:Select Mode="Multiple" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                     IsFilterEnabled="True"
                     HorizontalAlignment="Stretch"
                     IsAllowClear="True"
                     OptionsSource="{Binding CustomCountryOptions}">
            <atom:Select.OptionTemplate>
                <DataTemplate x:DataType="views:CustomOption">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Emoji}" />
                        <TextBlock Text="{Binding Description}" />
                    </StackPanel>
                </DataTemplate>
            </atom:Select.OptionTemplate>
        </atom:Select>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource OptionGroupTitle}"
        Description="{gallery:SelectShowCaseLangResource OptionGroupDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <atom:Select Mode="Single" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                     DefaultValues="lucy"
                     Width="200"
                     IsGroupEnabled="True"
                     IsFilterEnabled="True"
                     OptionsSource="{Binding GroupedPersonOptions}" />

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource HideAlreadySelectedTitle}"
        Description="{gallery:SelectShowCaseLangResource HideAlreadySelectedDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <atom:Select Mode="Multiple"
                     PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextInsertedAreRemoved}"
                     IsHideSelectedOptions="True"
                     IsFilterEnabled="True"
                     HorizontalAlignment="Stretch"
                     OptionsSource="{Binding HideSelectedOptions}" />

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource MaxCountTitle}"
        Description="{gallery:SelectShowCaseLangResource MaxCountDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Select Mode="Multiple"
                         HorizontalAlignment="Stretch"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                         MaxCount="3"
                         IsShowMaxCountIndicator="True"
                         OptionsSource="{Binding MaxCountLimitedOptions}" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource ResponsiveMaxTagCountTitle}"
        Description="{gallery:SelectShowCaseLangResource ResponsiveMaxTagCountDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Select Name="MaxTagSelect1"
                         Mode="Multiple"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextSelectItem}"
                         HorizontalAlignment="Stretch"
                         IsFilterEnabled="True"
                         IsResponsiveTagMode="True"
                         OptionsSource="{Binding MaxTagCountOptions}" />

            <atom:Select Name="MaxTagSelect2"
                         Mode="Multiple"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextSelectItem}"
                         IsEnabled="False"
                         HorizontalAlignment="Stretch"
                         IsFilterEnabled="True"
                         IsResponsiveTagMode="True"
                         OptionsSource="{Binding MaxTagCountOptions}" />

            <atom:Select Name="MaxTagSelect3"
                         Mode="Multiple"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextSelectItem}"
                         HorizontalAlignment="Stretch"
                         IsFilterEnabled="True"
                         MaxTagCount="5"
                         OptionsSource="{Binding MaxTagCountOptions}" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource SizesTitle}"
        Description="{gallery:SelectShowCaseLangResource SizesDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">

        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel.Styles>
                <Style Selector="atom|Select.size-demo-select[SizeType=Custom]">
                    <Setter Property="Height" Value="38" />
                    <Setter Property="FontSize" Value="15" />
                </Style>
            </StackPanel.Styles>
            <atom:OptionButtonGroup ButtonStyle="Outline" OptionCheckedChanged="HandleSizeTypeChanged">
                <atom:OptionButton Tag="{x:Static atom:CustomizableSizeType.Large}" Content="{gallery:SelectShowCaseLangResource P2ContentLarge}" />
                <atom:OptionButton IsChecked="True" Tag="{x:Static atom:CustomizableSizeType.Middle}" Content="{gallery:SelectShowCaseLangResource P2ContentDefault}" />
                <atom:OptionButton Tag="{x:Static atom:CustomizableSizeType.Small}" Content="{gallery:SelectShowCaseLangResource P2ContentSmall}" />
                <atom:OptionButton Tag="{x:Static atom:CustomizableSizeType.Custom}" Content="{gallery:SelectShowCaseLangResource P2ContentCustom}" />
            </atom:OptionButtonGroup>

            <atom:Select Classes="size-demo-select"
                         Name="SizeSelect1"
                         Mode="Single"
                         SizeType="{Binding SelectSizeType}"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextSelectAPerson}"
                         IsFilterEnabled="False"
                         DefaultValues="a10"
                         Width="200"
                         OptionsSource="{Binding RandomOptions}" />

            <atom:Select Classes="size-demo-select"
                         Mode="Multiple"
                         Name="SizeSelect2"
                         SizeType="{Binding SelectSizeType}"
                         PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextSelectAPerson}"
                         IsAllowClear="True"
                         HorizontalAlignment="Stretch"
                         IsFilterEnabled="False"
                         DefaultValues="a10, c12"
                         OptionsSource="{Binding RandomOptions}" />
        </StackPanel>


            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource VariantsTitle}"
        Description="{gallery:SelectShowCaseLangResource VariantsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <UniformGrid Columns="2" ColumnSpacing="10">
                <atom:Select Mode="Single"
                             PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextOutline}"
                             HorizontalAlignment="Stretch"
                             OptionsSource="{Binding VariantOptions}" />
                <atom:Select Mode="Multiple" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             HorizontalAlignment="Stretch"
                             DefaultValues="lucy"
                             IsFilterEnabled="True"
                             OptionsSource="{Binding VariantOptions}" />
            </UniformGrid>

            <UniformGrid Columns="2" ColumnSpacing="10">
                <atom:Select Mode="Single"
                             PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextFilled}"
                             HorizontalAlignment="Stretch"
                             StyleVariant="Filled"
                             OptionsSource="{Binding VariantOptions}" />
                <atom:Select Mode="Multiple" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             HorizontalAlignment="Stretch"
                             StyleVariant="Filled"
                             IsFilterEnabled="True"
                             DefaultValues="lucy"
                             OptionsSource="{Binding VariantOptions}" />
            </UniformGrid>

            <UniformGrid Columns="2" ColumnSpacing="10">
                <atom:Select Mode="Single"
                             PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextBorderless}"
                             HorizontalAlignment="Stretch"
                             StyleVariant="Borderless"
                             OptionsSource="{Binding VariantOptions}" />
                <atom:Select Mode="Multiple" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             HorizontalAlignment="Stretch"
                             StyleVariant="Borderless"
                             IsFilterEnabled="True"
                             DefaultValues="lucy"
                             OptionsSource="{Binding VariantOptions}" />
            </UniformGrid>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource StatusTitle}"
        Description="{gallery:SelectShowCaseLangResource StatusDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Select Mode="Single" HorizontalAlignment="Stretch" Status="Error" />
            <atom:Select Mode="Single" HorizontalAlignment="Stretch" Status="Warning" />
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource PrefixAndSuffixTitle}"
        Description="{gallery:SelectShowCaseLangResource PrefixAndSuffixDescription}" IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Select Mode="Single"
                             PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextOutline}"
                             DefaultValues="lucy"
                             HorizontalAlignment="Stretch"
                             Width="200"
                             ContentLeftAddOn="{gallery:SelectShowCaseLangResource P2ContentUser}"
                             OptionsSource="{Binding PrefixSuffixOptions}" />
                <atom:Select Mode="Single" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             HorizontalAlignment="Stretch"
                             DefaultValues="lucy"
                             IsFilterEnabled="True"
                             Width="200"
                             ContentRightAddOn="{antdicons:AntDesignIconProvider Kind=SmileOutlined}"
                             OptionsSource="{Binding PrefixSuffixOptions}" />

                <atom:Select Mode="Single" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             HorizontalAlignment="Stretch"
                             DefaultValues="lucy"
                             IsFilterEnabled="True"
                             Width="200"
                             IsEnabled="False"
                             ContentRightAddOn="{antdicons:AntDesignIconProvider Kind=SmileOutlined}"
                             OptionsSource="{Binding PrefixSuffixOptions}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Select Mode="Multiple"
                             PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextOutline}"
                             DefaultValues="lucy"
                             HorizontalAlignment="Stretch"
                             Width="200"
                             ContentLeftAddOn="{gallery:SelectShowCaseLangResource P2ContentUser}"
                             OptionsSource="{Binding PrefixSuffixOptions}" />
                <atom:Select Mode="Multiple" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             HorizontalAlignment="Stretch"
                             DefaultValues="lucy"
                             IsFilterEnabled="True"
                             Width="200"
                             ContentRightAddOn="{antdicons:AntDesignIconProvider Kind=SmileOutlined}"
                             OptionsSource="{Binding PrefixSuffixOptions}" />

                <atom:Select Mode="Multiple" PlaceholderText="{gallery:SelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             HorizontalAlignment="Stretch"
                             DefaultValues="lucy"
                             IsFilterEnabled="True"
                             Width="200"
                             IsEnabled="False"
                             ContentRightAddOn="{antdicons:AntDesignIconProvider Kind=SmileOutlined}"
                             OptionsSource="{Binding PrefixSuffixOptions}" />
            </StackPanel>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:SelectShowCaseLangResource StyleClassTitle}"
        Description="{gallery:SelectShowCaseLangResource StyleClassDescription}"
        SourceKey="select-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:SelectViewModel">
        <StackPanel HorizontalAlignment="Left" Spacing="20">
            <StackPanel.Styles>
                <Style Selector="atom|Select.semantic-styles-demo">
                    <atom:SelectPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#1890FF" />
                        </Style>
                    </atom:SelectPrefixStyle>
                    <atom:SelectSuffixStyle x:SetterTargetType="StackPanel">
                        <Setter Property="TextElement.Foreground" Value="#1890FF" />
                    </atom:SelectSuffixStyle>
                </Style>
                <Style Selector="atom|Select.semantic-styles-filled-demo">
                    <atom:SelectPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#722ED1" />
                        </Style>
                    </atom:SelectPrefixStyle>
                    <atom:SelectSuffixStyle x:SetterTargetType="StackPanel">
                        <Setter Property="TextElement.Foreground" Value="#722ED1" />
                    </atom:SelectSuffixStyle>
                    <atom:SelectPopupRootStyle x:SetterTargetType="Border">
                        <Setter Property="BorderBrush" Value="#722ED1" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:SelectPopupRootStyle>
                </Style>
            </StackPanel.Styles>
            <atom:Select Classes="semantic-styles-demo"
                         Name="ObjectStylesSelect"
                         Mode="Single"
                         Width="300"
                         IsAllowClear="True"
                         ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                         OptionsSource="{Binding StyleClassOptions}"
                         PlaceholderText="Object" />
            <atom:Select Classes="semantic-styles-demo semantic-styles-filled-demo"
                         Name="FunctionStylesSelect"
                         Mode="Single"
                         Width="300"
                         IsAllowClear="True"
                         StyleVariant="Filled"
                         ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                         OptionsSource="{Binding StyleClassOptions}"
                         PlaceholderText="Function" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
