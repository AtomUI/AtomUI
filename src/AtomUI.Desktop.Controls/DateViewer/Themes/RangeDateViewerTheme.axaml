<ControlTheme xmlns:tokeninputs="using:AtomUI.Desktop.Controls.Internal.DateViewer" xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:viewer="clr-namespace:AtomUI.Desktop.Controls.Internal.DateViewer"
              x:Class="AtomUI.Desktop.Controls.Themes.RangeDateViewerTheme"
              x:ClassModifier="internal" TargetType="atom:RangeDateViewer">
        <Setter Property="tokeninputs:DateViewerCell.ThemePanelBg" Value="{atom:RangeDateViewerTokenResource PanelBg}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeCellHoverBg" Value="{atom:RangeDateViewerTokenResource CellHoverBg}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeCellRangeBg" Value="{atom:RangeDateViewerTokenResource CellRangeBg}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemePanelWidth" Value="{atom:RangeDateViewerTokenResource PanelWidth}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeCellHeight" Value="{atom:RangeDateViewerTokenResource CellHeight}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeCellWidth" Value="{atom:RangeDateViewerTokenResource CellWidth}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeCellRowHeight" Value="{atom:RangeDateViewerTokenResource CellRowHeight}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemePeriodCellWidth" Value="{atom:RangeDateViewerTokenResource PeriodCellWidth}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemePeriodCellPadding" Value="{atom:RangeDateViewerTokenResource PeriodCellPadding}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeContentCellMinHeight" Value="{atom:RangeDateViewerTokenResource ContentCellMinHeight}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeContentCellSurfaceMargin" Value="{atom:RangeDateViewerTokenResource ContentCellSurfaceMargin}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeContentCellTopBorderThickness" Value="{atom:RangeDateViewerTokenResource ContentCellTopBorderThickness}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeContentCellValueMargin" Value="{atom:RangeDateViewerTokenResource ContentCellValueMargin}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeContentCellContentMargin" Value="{atom:RangeDateViewerTokenResource ContentCellContentMargin}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemePanelPadding" Value="{atom:RangeDateViewerTokenResource PanelPadding}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeHeaderHorizontalPadding" Value="{atom:RangeDateViewerTokenResource HeaderHorizontalPadding}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeDateBodyPadding" Value="{atom:RangeDateViewerTokenResource DateBodyPadding}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeHeaderBorderThickness" Value="{atom:RangeDateViewerTokenResource HeaderBorderThickness}" />
        <Setter Property="tokeninputs:DateViewerCell.ThemeWeekNumberOpacity" Value="{atom:RangeDateViewerTokenResource WeekNumberOpacity}" />

    <Setter Property="Background" Value="{Binding $self.(tokeninputs:DateViewerCell.ThemePanelBg)}" />
    <Setter Property="Padding" Value="{Binding $self.(tokeninputs:DateViewerCell.ThemePanelPadding)}" />
    <Setter Property="PanelSpacing" Value="{atom:RangeDateViewerTokenResource PanelSpacing}" />
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:RangeDateViewer">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{TemplateBinding PanelSpacing}"
                                IsVisible="{TemplateBinding ShowHeader}">
                        <viewer:DateViewerHeader Classes.semantic-header="True"
                                                 Width="{Binding $self.(tokeninputs:DateViewerCell.ThemePanelWidth)}"
                                                 Context="{TemplateBinding HeaderContext}"
                                                 HeaderTemplate="{TemplateBinding HeaderTemplate}" />
                        <viewer:DateViewerHeader Classes.semantic-header="True"
                                                 Width="{Binding $self.(tokeninputs:DateViewerCell.ThemePanelWidth)}"
                                                 Context="{TemplateBinding SecondaryHeaderContext}"
                                                 HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                                 IsVisible="{TemplateBinding HasSecondaryPanel}" />
                    </StackPanel>
                    <StackPanel Classes.semantic-body="True" Orientation="Horizontal" Spacing="{TemplateBinding PanelSpacing}">
                    <viewer:DatePanel Classes.semantic-content="True" Name="PART_PrimaryPanel"
                                  Session="{TemplateBinding PanelSession}"
                                  Theme="{TemplateBinding PanelTheme}"
                                      CellTemplate="{TemplateBinding CellTemplate}"
                                  FullCellTemplate="{TemplateBinding FullCellTemplate}"
                                  DefaultFullCellTemplate="{TemplateBinding DefaultFullCellTemplate}"
                                  CellTheme="{TemplateBinding CellTheme}"
                                      Presentation="{TemplateBinding Presentation}" />
                    <viewer:DatePanel Classes.semantic-content="True" Name="PART_SecondaryPanel" PanelIndex="1"
                                      IsVisible="{TemplateBinding HasSecondaryPanel}"
                                      Session="{TemplateBinding PanelSession}"
                                      Theme="{TemplateBinding PanelTheme}"
                                      CellTemplate="{TemplateBinding CellTemplate}"
                                      FullCellTemplate="{TemplateBinding FullCellTemplate}"
                                      DefaultFullCellTemplate="{TemplateBinding DefaultFullCellTemplate}"
                                      CellTheme="{TemplateBinding CellTheme}"
                                      Presentation="{TemplateBinding Presentation}" />
                </StackPanel>
                </DockPanel>
            </Border>
        </ControlTemplate>
    </Setter>
    <Style Selector="^:single-panel">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:RangeDateViewer">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <DockPanel LastChildFill="True">
                        <viewer:DateViewerHeader DockPanel.Dock="Top" Classes.semantic-header="True"
                                                 Width="{Binding $self.(tokeninputs:DateViewerCell.ThemePanelWidth)}"
                                                 Context="{TemplateBinding HeaderContext}"
                                                 HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                                 IsVisible="{TemplateBinding ShowHeader}" />
                        <Panel Classes.semantic-body="True">
                            <viewer:DatePanel Classes.semantic-content="True" Name="PART_PrimaryPanel"
                                              Session="{TemplateBinding PanelSession}"
                                              Theme="{TemplateBinding PanelTheme}"
                                              CellTemplate="{TemplateBinding CellTemplate}"
                                              FullCellTemplate="{TemplateBinding FullCellTemplate}"
                                              DefaultFullCellTemplate="{TemplateBinding DefaultFullCellTemplate}"
                                              CellTheme="{TemplateBinding CellTheme}"
                                              Presentation="{TemplateBinding Presentation}" />
                        </Panel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</ControlTheme>
