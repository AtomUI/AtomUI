<!-- Shared base theme of the line-shaped progress controls (ProgressBar, StepsProgressBar). Global Tokens are read through
     OwnerTokenResource; the concrete themes bind the line-specific Own Tokens. -->
<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:atomc="https://atomui.net/common-controls"
              x:Class="AtomUI.Desktop.Controls.Themes.AbstractLineProgressTheme"
              TargetType="atomc:AbstractLineProgress"
              x:ClassModifier="internal">
    <ControlTheme.BasedOn>
        <atom:AbstractProgressBarTheme TargetType="atomc:AbstractLineProgress"/>
    </ControlTheme.BasedOn>
    <Setter Property="LineSizeTokenResourceMode" Value="FontPresets" />
    <Setter Property="Template">
        <ControlTemplate TargetType="atomc:AbstractLineProgress">
            <Canvas IsVisible="{TemplateBinding IsProgressInfoPresented}">
                <LayoutTransformControl Name="PART_LayoutTransformControl">
                    <Label Name="PART_PercentageLabel"
                           Padding="0"
                           Margin="0"
                           VerticalContentAlignment="Center"
                           Foreground="{TemplateBinding PercentageLabelColor}"
                           IsEnabled="{TemplateBinding IsEnabled}" />
                </LayoutTransformControl>

                <atom:IconPresenter
                    Name="PART_ExceptionCompletedIconPresenter"
                    Icon="{TemplateBinding ExceptionCompletedIcon}"
                    HorizontalAlignment="Left"/>

                <atom:IconPresenter
                    Name="PART_SuccessCompletedIconPresenter"
                    Icon="{TemplateBinding SuccessCompletedIcon}"
                    HorizontalAlignment="Left"/>
                
                <atomc:ProgressInfoPresenter Name="PART_ProgressInfoContentPresenter"
                                  IsVisible="False" />
            </Canvas>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atomc|AbstractLineProgress)">
        <!-- Text-geometry fallback: a theme Setter so local values and application Styles keep precedence. -->
        <Setter Property="MinWidth" Value="{Binding FallbackMinWidth, RelativeSource={RelativeSource Self}}" />
        <Setter Property="MinHeight" Value="{Binding FallbackMinHeight, RelativeSource={RelativeSource Self}}" />

        <Style Selector="^[EffectiveSizeType=Large]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}" />
        </Style>

        <Style Selector="^[EffectiveSizeType=Middle], ^[EffectiveSizeType=Small]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeSM}" />
        </Style>

        <Style Selector="^[EffectiveSizeType=Large], ^[EffectiveSizeType=Middle], ^[EffectiveSizeType=Small]">
            <Style Selector="^ /template/ atom|IconPresenter">
                <Setter Property="Width" Value="{Binding LineInfoIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="Height" Value="{Binding LineInfoIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
            </Style>
        </Style>
    </Style>
</ControlTheme>
