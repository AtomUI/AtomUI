<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:GradientColorPickerView}" TargetType="atom:GradientColorPickerView">
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerWidth" Value="{atom:GradientColorPickerViewTokenResource ColorPickerWidth}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorSpectrumHeight" Value="{atom:GradientColorPickerViewTokenResource ColorSpectrumHeight}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerInsetShadow" Value="{atom:GradientColorPickerViewTokenResource ColorPickerInsetShadow}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerHandlerSizeLG" Value="{atom:GradientColorPickerViewTokenResource ColorPickerHandlerSizeLG}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerHandlerSize" Value="{atom:GradientColorPickerViewTokenResource ColorPickerHandlerSize}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerHandlerSizeSM" Value="{atom:GradientColorPickerViewTokenResource ColorPickerHandlerSizeSM}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerHandlerLightColor" Value="{atom:GradientColorPickerViewTokenResource ColorPickerHandlerLightColor}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerHandlerDarkColor" Value="{atom:GradientColorPickerViewTokenResource ColorPickerHandlerDarkColor}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerSliderSize" Value="{atom:GradientColorPickerViewTokenResource ColorPickerSliderSize}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerSliderTrackSize" Value="{atom:GradientColorPickerViewTokenResource ColorPickerSliderTrackSize}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerSliderThumbSize" Value="{atom:GradientColorPickerViewTokenResource ColorPickerSliderThumbSize}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerPreviewSize" Value="{atom:GradientColorPickerViewTokenResource ColorPickerPreviewSize}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerAlphaInputWidth" Value="{atom:GradientColorPickerViewTokenResource ColorPickerAlphaInputWidth}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerInputNumberHandleWidth" Value="{atom:GradientColorPickerViewTokenResource ColorPickerInputNumberHandleWidth}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerPresetColorSize" Value="{atom:GradientColorPickerViewTokenResource ColorPickerPresetColorSize}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerPresetPanelWidth" Value="{atom:GradientColorPickerViewTokenResource ColorPickerPresetPanelWidth}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeCheckedMarkSize" Value="{atom:GradientColorPickerViewTokenResource CheckedMarkSize}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorPickerPresetColorGroupPadding" Value="{atom:GradientColorPickerViewTokenResource ColorPickerPresetColorGroupPadding}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeSliderContainerMargin" Value="{atom:GradientColorPickerViewTokenResource SliderContainerMargin}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorBlockInnerShadows" Value="{atom:GradientColorPickerViewTokenResource ColorBlockInnerShadows}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeTransparentBgSize" Value="{atom:GradientColorPickerViewTokenResource TransparentBgSize}" />

        <Setter Property="atom:ColorPickerThemeInputs.ThemeEditorFontSize" Value="{atom:GradientColorPickerViewTokenResource EditorFontSize}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeSeparatorThickness" Value="{atom:GradientColorPickerViewTokenResource BorderThickness}" />
        <ControlTheme.BasedOn>
            <themes:AbstractColorPickerViewTheme TargetType="atom:GradientColorPickerView" />
        </ControlTheme.BasedOn>

        <Setter Property="Template">
            <ControlTemplate TargetType="atom:GradientColorPickerView">
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        Margin="{TemplateBinding Margin}"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        ClipToBounds="False">
                    <StackPanel Name="PART_LayoutRoot"
                                Orientation="Horizontal" ClipToBounds="False">
                        <atom:ColorPickerPaletteGroup
                            Name="PART_PaletteGroup"
                            PaletteGroup="{TemplateBinding PaletteGroup}"
                            IsVisible="{TemplateBinding IsPaletteGroupEnabled}"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}" />
                        <atom:PixelAlignedBorder Name="Separator"
                                                 VerticalAlignment="Stretch"
                                                 Width="{atom:GradientColorPickerViewTokenResource LineWidth}"
                                                 IsVisible="{TemplateBinding IsPaletteGroupEnabled}" />
                        <StackPanel Orientation="Vertical"
                                    ClipToBounds="False"
                                    Spacing="{atom:GradientColorPickerViewTokenResource SpacingXS}">
                            <atom:ColorBlock Name="PART_ClearColor"
                                             HorizontalAlignment="Right"
                                             IsEmptyColorMode="True"
                                             IsVisible="{TemplateBinding IsClearEnabled}" />
                            <atom:GradientColorSlider
                                Name="PART_GradientColorSlider"
                                ActivatedHsvValue="{TemplateBinding HsvValue, Mode=TwoWay}"
                                GradientValue="{TemplateBinding Value, Mode=TwoWay}"
                                ActivatedStopIndex="{TemplateBinding ActivatedStopIndex, Mode=TwoWay}"/>
                            <StackPanel Orientation="Vertical" Name="ColorPickerContainer" ClipToBounds="False">
                                <atom:ColorSpectrum
                                    Name="ColorSpectrum"
                                    Components="SaturationValue"
                                    HsvColor="{TemplateBinding HsvValue, Mode=TwoWay}"
                                    MaxHue="{TemplateBinding MaxHue}"
                                    MaxSaturation="{TemplateBinding MaxSaturation}"
                                    MaxValue="{TemplateBinding MaxValue}"
                                    MinHue="{TemplateBinding MinHue}"
                                    MinSaturation="{TemplateBinding MinSaturation}"
                                    MinValue="{TemplateBinding MinValue}" />
                                <DockPanel LastChildFill="True" ClipToBounds="False">
                                    <!-- layout: fixed raster inset, hit target or compact editor packing. -->
                                    <atom:ColorBlock Name="ColorPreview"
                                                     IsEmptyColorMode="{TemplateBinding IsEmptyDraft}"
                                                     Background="{TemplateBinding HsvColorBrush}"
                                                     DockPanel.Dock="Right"
                                                     Margin="0, 2, 0, 2" />
                                    <Panel Name="SliderContainer" ClipToBounds="False">
                                        <atom:ColorSlider Name="ColorSpectrumThirdComponentSlider" DockPanel.Dock="Top"
                                                          ColorModel="Hsva"
                                                          VerticalAlignment="Top"
                                                          HsvColor="{TemplateBinding HsvValue, Mode=TwoWay}"
                                                          IsVisible="{TemplateBinding IsColorSpectrumSliderVisible}"
                                                          ThumbColorValueBrush="{TemplateBinding HsvColorWithoutAlphaBrush}" />
                                        <atom:ColorSlider Name="ColorSpectrumAlphaSlider" DockPanel.Dock="Bottom"
                                                          ColorComponent="Alpha"
                                                          ColorModel="Hsva"
                                                          VerticalAlignment="Bottom"
                                                          HsvColor="{TemplateBinding HsvValue, Mode=TwoWay}"
                                                          IsVisible="{TemplateBinding IsAlphaEffectiveVisible}"
                                                          IsRoundingEnabled="True"
                                                          ThumbColorValueBrush="{TemplateBinding HsvColorBrush}" />
                                    </Panel>
                                </DockPanel>
                                <atom:ColorPickerInput Name="PART_ColorInput"
                                                       IsNeedConfirm="{TemplateBinding IsNeedConfirm}"
                                                       IsInputValid="{TemplateBinding CanConfirm, Mode=TwoWay}"
                                                       ColorValue="{TemplateBinding HsvValue, Mode=TwoWay}"
                                                       Format="{TemplateBinding Format, Mode=TwoWay}"
                                                       IsFormatEnabled="{TemplateBinding IsFormatEnabled, Mode=TwoWay}"
                                                       IsAlphaVisible="{TemplateBinding IsAlphaEffectiveVisible}"
                                                       IsClearEnabled="{TemplateBinding IsClearEnabled}" />
                            </StackPanel>
                            <StackPanel Name="PART_ConfirmationFooter"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="{atom:GradientColorPickerViewTokenResource SpacingXS}"
                                        IsVisible="{TemplateBinding IsNeedConfirm}">
                                <atom:Button Name="PART_CancelButton"
                                             SizeType="Small"
                                             Content="{atom:ColorPickerLangResource Cancel}" />
                                <atom:Button Name="PART_ConfirmButton"
                                             SizeType="Small"
                                             ButtonType="Primary"
                                             IsEnabled="{TemplateBinding CanConfirm}"
                                             Content="{atom:ColorPickerLangResource Confirm}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ atom|GradientColorSlider#PART_GradientColorSlider">
            <Setter Property="IsVisible" Value="True" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
