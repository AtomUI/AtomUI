<?xml version="1.0" encoding="utf-8"?>
<Theme xmlns="https://atomui.net/schemas/theme/v1" Id="ShadcnStone.DarkCompact" Name="Shadcn Stone DarkCompact" Appearance="Dark" DesignLanguage="Shadcn.Stone" BrandColor="Fixed" Density="Compact" IsDefault="false">
  <Algorithms>
    <Algorithm Id="Dark" />
    <Algorithm Id="Compact" />
  </Algorithms>
  <Tokens>
    <Token Name="ColorPrimary" Value="#FAFAFA" />
    <Token Name="ColorPrimaryHover" Value="#F5F5F4" />
    <Token Name="ColorPrimaryActive" Value="#E7E5E4" />
    <Token Name="ColorTextLightSolid" Value="#1C1917" />
    <Token Name="ColorPrimaryBg" Value="#292524" />
    <Token Name="ColorPrimaryBgHover" Value="#44403C" />
    <Token Name="ColorPrimaryBorder" Value="#44403C" />
    <Token Name="ColorPrimaryBorderHover" Value="#57534E" />
    <Token Name="ColorPrimaryText" Value="#FAFAFA" />
    <Token Name="ColorPrimaryTextHover" Value="#F5F5F4" />
    <Token Name="ColorPrimaryTextActive" Value="#E7E5E4" />
    <Token Name="ColorText" Value="#FAFAFA" />
    <Token Name="ColorTextSecondary" Value="#A8A29E" />
    <Token Name="ColorTextTertiary" Value="#78716C" />
    <Token Name="ColorTextQuaternary" Value="#57534E" />
    <Token Name="ColorTextDescription" Value="#A8A29E" />
    <Token Name="ColorTextPlaceholder" Value="#78716C" />
    <Token Name="ColorTextDisabled" Value="#57534E" />
    <Token Name="ColorBgBase" Value="#1C1917" />
    <Token Name="ColorTextBase" Value="#FAFAFA" />
    <Token Name="ColorBgLayout" Value="#1C1917" />
    <Token Name="ColorBgContainer" Value="#1C1917" />
    <Token Name="ColorBgElevated" Value="#292524" />
    <Token Name="ColorBgContainerDisabled" Value="#292524" />
    <Token Name="ColorBorder" Value="#292524" />
    <Token Name="ColorBorderSecondary" Value="#44403C" />
    <Token Name="ColorFill" Value="#44403C" />
    <Token Name="ColorFillSecondary" Value="#292524" />
    <Token Name="ColorFillTertiary" Value="#292524" />
    <Token Name="ColorFillQuaternary" Value="#1C1917" />
    <Token Name="BorderRadius" Value="6" />
    <Token Name="ControlHeight" Value="36" />
    <Token Name="ControlHeightSM" Value="28" />
    <Token Name="ControlHeightLG" Value="36" />
    <Token Name="PaddingContentHorizontal" Value="8" />
    <Token Name="LineWidth" Value="1" />
    <Token Name="EnableWaveSpirit" Value="false" />
    <Token Name="BoxShadows" Value="0 10 15 -3 #1A000000, 0 4 6 -4 #1A000000" />
    <Token Name="BoxShadowsSecondary" Value="0 4 6 -1 #1A000000, 0 2 4 -2 #1A000000" />
  </Tokens>
  <Controls>
    <Control Catalog="AtomUI" Id="CheckBox">
      <Tokens>
        <Token Name="ColorWhite" Value="#1C1917" />
      </Tokens>
    </Control>
    <Control Catalog="AtomUI" Id="RadioButton">
      <Tokens>
        <Token Name="RadioColor" Value="#1C1917" />
      </Tokens>
    </Control>
    <!-- shadcn/ui switch thumb is the background colour (bg-background); a white thumb vanishes on the near-white
         primary track. -->
    <Control Catalog="AtomUI" Id="ToggleSwitch">
      <Tokens>
        <Token Name="HandleCheckedBg" Value="#1C1917" />
      </Tokens>
    </Control>
    <!-- shadcn popups pair shadow-md with a 1px border (ColorBorder); the ring keeps the top edge visible. -->
    <Control Catalog="AtomUI" Id="Popup">
      <Tokens>
        <Token Name="PopupRootShadow" Value="0 0 0 1 #292524, 0 4 6 -1 #1A000000, 0 2 4 -2 #1A000000" />
        <Token Name="OverlayHostShadow" Value="0 0 0 1 #292524, 0 4 6 -1 #1A000000, 0 2 4 -2 #1A000000" />
      </Tokens>
    </Control>
  </Controls>
</Theme>
