<!-- owner: global Tokens are read from the owner because this theme is also the base of LunarCalendar (its own
     identity). On a Calendar the owner is the Calendar. -->
<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:controls="clr-namespace:AtomUI.Desktop.Controls"
    xmlns:calendar="clr-namespace:AtomUI.Desktop.Controls.Internal.Calendar"
    xmlns:viewer="clr-namespace:AtomUI.Desktop.Controls.Internal.DateViewer"
    xmlns:themes="clr-namespace:AtomUI.Desktop.Controls.Themes"
    x:Class="AtomUI.Desktop.Controls.Themes.CalendarControlTheme"
    TargetType="controls:Calendar"
    x:ClassModifier="internal">

    <ControlTheme.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="/Calendar/Themes/CalendarDateCellTheme.axaml" />
            <ResourceInclude Source="/Calendar/Themes/CalendarDatePanelTheme.axaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ControlTheme.Resources>
    <Setter Property="DateCellTheme" Value="{StaticResource CalendarDateCellTheme}" />
    <Setter Property="DatePanelTheme" Value="{StaticResource CalendarDatePanelTheme}" />
    <!-- Terminal Own Tokens for the template parts; LunarCalendarTheme replaces these root setters with its own. -->
    <Setter Property="FullPanelBg" Value="{atom:CalendarTokenResource FullPanelBg}" />
    <Setter Property="YearControlWidth" Value="{atom:CalendarTokenResource YearControlWidth}" />
    <Setter Property="MonthControlWidth" Value="{atom:CalendarTokenResource MonthControlWidth}" />
    <Setter Property="RangeBarHeight" Value="{atom:CalendarTokenResource RangeBarHeight}" />
    <Setter Property="RangeBarGap" Value="{atom:CalendarTokenResource RangeBarGap}" />
    <Setter Property="RangeBarLabelPadding" Value="{atom:CalendarTokenResource RangeBarLabelPadding}" />
    <Setter Property="Template">
        <ControlTemplate TargetType="controls:Calendar">
            <Border Name="PART_Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <DockPanel LastChildFill="True">
                    <ContentControl Name="PART_HeaderPresenter" DockPanel.Dock="Top" Classes.semantic-header="True"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Panel>
                        <calendar:CalendarHeader Name="PART_DefaultHeader"
                                                 IsVisible="{Binding HeaderTemplate, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNull}}"
                                                 Value="{TemplateBinding Value}"
                                                 Mode="{TemplateBinding Mode}"
                                                 ValidRange="{TemplateBinding ValidRange}"
                                                 Fullscreen="{TemplateBinding Fullscreen}"
                                                 YearControlWidth="{TemplateBinding YearControlWidth}"
                                                 MonthControlWidth="{TemplateBinding MonthControlWidth}" />
                        <ContentControl Name="PART_CustomHeader"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        IsVisible="{Binding HeaderTemplate, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Panel>
                    </ContentControl>
                    <DockPanel Name="PART_BodyPresenter"
                               Classes.semantic-body="True"
                               LastChildFill="True"
                               ClipToBounds="True">
                        <Border DockPanel.Dock="Top"
                                Height="{atom:OwnerTokenResource LineWidth}"
                                Background="{atom:OwnerTokenResource ColorSplit}"
                                IsVisible="{TemplateBinding Fullscreen, Converter={x:Static BoolConverters.Not}}" />
                        <Border DockPanel.Dock="Top"
                                Height="{atom:OwnerTokenResource UniformlyPaddingXS}" />
                        <Border DockPanel.Dock="Bottom"
                                Height="{atom:OwnerTokenResource UniformlyPaddingXS}" />
                        <Grid>
                            <controls:DateViewer Name="PART_DateViewer"
                                                   Classes.semantic-content="True"
                                                   ShowHeader="False" Padding="0"
                                                   CellTheme="{TemplateBinding DateCellTheme}"
                                                   PanelTheme="{TemplateBinding DatePanelTheme}"
                                                   DefaultFullCellTemplate="{TemplateBinding DefaultDateCellTemplate}"
                                                   Presentation="{TemplateBinding DatePresentation}"
                                                   CellTemplate="{TemplateBinding CellTemplate}"
                                                   FullCellTemplate="{TemplateBinding FullCellTemplate}"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   ZIndex="0" />
                            <!-- layout: the range bars are painted above the date cells -->
                            <calendar:CalendarRangeBarPanel Name="PART_RangeBarPanel"
                                                            LayoutSource="{TemplateBinding EffectiveDateViewer}"
                                                            Mode="{TemplateBinding Mode}"
                                                            Fullscreen="{TemplateBinding Fullscreen}"
                                                            RangeBars="{TemplateBinding RangeBars}"
                                                            RangeBarHeight="{TemplateBinding RangeBarHeight}"
                                                            RangeBarTopOffset="{TemplateBinding EffectiveRangeBarTopOffset}"
                                                            UseRangeBarTokenResources="True"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            RangeBarGap="{TemplateBinding RangeBarGap}"
                                                            RangeBarLabelPadding="{TemplateBinding RangeBarLabelPadding}"
                                                            IsVisible="False"
                                                            IsHitTestVisible="False"
                                                            ZIndex="1" />
                        </Grid>
                    </DockPanel>
                </DockPanel>
            </Border>
        </ControlTemplate>
    </Setter>

    <Setter Property="Background" Value="{atom:CalendarTokenResource FullBg}" />
    <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorderSecondary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Style Selector="^ /template/ controls|DateViewer">
        <Setter Property="Background" Value="{TemplateBinding FullPanelBg}" />
    </Style>
    <Style Selector="^:mini /template/ controls|DateViewer">
        <Setter Property="Height" Value="{TemplateBinding EffectiveMiniContentHeight}" />
        <Setter Property="MaxHeight" Value="{TemplateBinding EffectiveMiniContentHeight}" />
    </Style>

    <Style Selector="^:fullscreen">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="^:mini">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}" />
    </Style>
</ControlTheme>
