<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <Thickness x:Key="NumericUpDownSpinnerContentPadding">0</Thickness>

    <ControlTheme x:Key="{x:Type atom:NumericUpDownSpinner}"
                  TargetType="atom:NumericUpDownSpinner"
                  BasedOn="{StaticResource {x:Type atom:ButtonSpinner}}">
        <Style Selector="^[IsButtonSpinnerFloatable=False]">
            <Setter Property="Template">
                <ControlTemplate TargetType="atom:NumericUpDownSpinner">
                    <atom:ButtonSpinnerDecoratedBox
                        Name="PART_DecoratedBox"
                        Classes.semantic-scope-frame="True"
                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                        LeftAddOn="{TemplateBinding LeftAddOn}"
                        LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                        RightAddOn="{TemplateBinding RightAddOn}"
                        RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                        ContentRightAddOn="{TemplateBinding InnerRightContent}"
                        ContentRightAddOnTemplate="{TemplateBinding InnerRightContentTemplate}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        StyleVariant="{TemplateBinding StyleVariant}"
                        SizeType="{TemplateBinding SizeType}"
                        Status="{TemplateBinding Status}"
                        FormStatus="{TemplateBinding FormStatus}"
                        IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                        DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                        IsShowHandle="False"
                        IsHandleFloatable="False"
                        ContentPadding="{Binding Source={StaticResource NumericUpDownSpinnerContentPadding}, Priority=LocalValue}"
                        Focusable="True"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                        CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                        IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                        <DockPanel LastChildFill="True">
                            <atom:PixelAlignedBorder
                                DockPanel.Dock="Left"
                                BorderBrush="{atom:ButtonSpinnerTokenResource HandleBorderColor}"
                                BorderThickness="0,0,1,0"
                                IsVisible="{TemplateBinding IsButtonSpinnerVisible}">
                                <atom:IconButton
                                    Name="PART_DecreaseButton"
                                    Icon="{antdicons:AntDesignIconProvider MinusOutlined}"
                                    CornerRadius="0"
                                    BorderThickness="0"
                                    Padding="0"
                                    Width="{CompiledBinding $self.Bounds.Height}"
                                    BackgroundSizing="InnerBorderEdge"
                                    IconWidth="{atom:SharedTokenResource IconSize}"
                                    IconHeight="{atom:SharedTokenResource IconSize}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
                            </atom:PixelAlignedBorder>
                            <atom:PixelAlignedBorder
                                DockPanel.Dock="Right"
                                BorderBrush="{atom:ButtonSpinnerTokenResource HandleBorderColor}"
                                BorderThickness="1,0,0,0"
                                IsVisible="{TemplateBinding IsButtonSpinnerVisible}">
                                <atom:IconButton
                                    Name="PART_IncreaseButton"
                                    Icon="{antdicons:AntDesignIconProvider PlusOutlined}"
                                    CornerRadius="0"
                                    BorderThickness="0"
                                    Padding="0"
                                    Width="{CompiledBinding $self.Bounds.Height}"
                                    BackgroundSizing="InnerBorderEdge"
                                    IconWidth="{atom:SharedTokenResource IconSize}"
                                    IconHeight="{atom:SharedTokenResource IconSize}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
                            </atom:PixelAlignedBorder>
                            <DockPanel LastChildFill="True">
                                <!-- 宿主自身必须零占位（无边距、无可见性开销）：
                                     InnerLeftContent 由 NumericUpDown 模板无条件注入
                                     PART_InnerLeftContentPresenter，空内容时该 presenter
                                     自折叠，InputPadding 外边距由它自己承担（见
                                     NumericUpDownTheme 的 Spinner 模板），否则空边距会把
                                     居中数字推向右侧。 -->
                                <ContentPresenter
                                    Focusable="False"
                                    Content="{TemplateBinding InnerLeftContent}"
                                    ContentTemplate="{TemplateBinding InnerLeftContentTemplate}" />
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </DockPanel>
                    </atom:ButtonSpinnerDecoratedBox>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[IsButtonSpinnerFloatable=False] /template/ atom|IconButton#PART_DecreaseButton,
                         ^[IsButtonSpinnerFloatable=False] /template/ atom|IconButton#PART_IncreaseButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^[IsButtonSpinnerFloatable=False] /template/ atom|IconButton#PART_DecreaseButton:pointerover:not(:disabled),
                         ^[IsButtonSpinnerFloatable=False] /template/ atom|IconButton#PART_IncreaseButton:pointerover:not(:disabled)">
            <Setter Property="IconBrush" Value="{atom:ButtonSpinnerTokenResource HandleHoverColor}" />
        </Style>
        <Style Selector="^[IsButtonSpinnerFloatable=False] /template/ atom|IconButton#PART_DecreaseButton:pressed:not(:disabled),
                         ^[IsButtonSpinnerFloatable=False] /template/ atom|IconButton#PART_IncreaseButton:pressed:not(:disabled)">
            <Setter Property="Background" Value="{atom:ButtonSpinnerTokenResource HandleActiveBg}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
