<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource GroupingTableHeadTitle}"
                          Description="{gallery:DataGridShowCaseLangResource GroupingTableHeadDescription}"
                          IsOccupyEntireRow="true"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <StackPanel>
            <atom:DataGrid Name="GroupHeaderDataGrid" LeftFrozenColumnCount="2"
                           RightFrozenColumnCount="2"
                           CanUserResizeColumns="True"
                           x:DataType="vm:GroupHeaderDataType"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.ColumnGroups>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridColumnGroupItem Header="{gallery:DataGridShowCaseLangResource P2HeaderOther}">
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                        <atom:DataGridColumnGroupItem Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}">
                            <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderStreet}" FieldId="{x:Static vm:DataGridShowCaseFields.Street}" Binding="{Binding Street}" />
                            <atom:DataGridColumnGroupItem Header="{gallery:DataGridShowCaseLangResource P2HeaderBlock}">
                                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderBuilding}" FieldId="{x:Static vm:DataGridShowCaseFields.Building}" Binding="{Binding Building}" />
                                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderDoorNo}" FieldId="{x:Static vm:DataGridShowCaseFields.Number}" Binding="{Binding Number}" />
                            </atom:DataGridColumnGroupItem>
                        </atom:DataGridColumnGroupItem>
                    </atom:DataGridColumnGroupItem>
                    <atom:DataGridColumnGroupItem Header="{gallery:DataGridShowCaseLangResource P2HeaderCompany}">
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderCompanyAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.CompanyAddress}" Binding="{Binding CompanyAddress}" />
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderCompanyName}" FieldId="{x:Static vm:DataGridShowCaseFields.CompanyName}" Binding="{Binding CompanyName}"
                                                 CanUserResize="False" />
                    </atom:DataGridColumnGroupItem>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderGender}" FieldId="{x:Static vm:DataGridShowCaseFields.Gender}" Binding="{Binding Gender}" />
                </atom:DataGrid.ColumnGroups>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

