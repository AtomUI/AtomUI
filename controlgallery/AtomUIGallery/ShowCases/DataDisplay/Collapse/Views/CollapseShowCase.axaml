<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Collapse.CollapseShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Collapse"
             x:DataType="vm:CollapseViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Collapse"
                    Category="{gallery:CollapseShowCaseLangResource ComponentCategory}"
                    Status="{gallery:CollapseShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:CollapseShowCaseLangResource PageSubtitle}"
                    Description="{gallery:CollapseShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="SelectingItemsControl" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:CollapseViewModel">
                    <gallery:SemanticPartPreview Name="CollapseSemanticPreview"
                                                 SemanticOwner="{Binding #CollapseSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:Collapse}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:Collapse Name="CollapseSemanticOwner">
                                <atom:CollapseItem Header="This is panel header" IsSelected="True">
                                    <atom:TextBlock TextWrapping="Wrap" Text="This is panel body" />
                                </atom:CollapseItem>
                            </atom:Collapse>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:CollapseShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="header"
                                Description="{gallery:CollapseShowCaseLangResource SemanticHeaderDescription}" />
                            <gallery:SemanticPartDescription
                                Path="icon"
                                Description="{gallery:CollapseShowCaseLangResource SemanticIconDescription}" />
                            <gallery:SemanticPartDescription
                                Path="title"
                                Description="{gallery:CollapseShowCaseLangResource SemanticTitleDescription}" />
                            <gallery:SemanticPartDescription
                                Path="body"
                                Description="{gallery:CollapseShowCaseLangResource SemanticBodyDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource CollapseTitle}"
                    Description="{gallery:CollapseShowCaseLangResource CollapseDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <atom:Collapse>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                    </atom:Collapse>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource SizeTitle}"
                    Description="{gallery:CollapseShowCaseLangResource SizeDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <StackPanel Orientation="Vertical" Spacing="20">
                        <atom:Separator Title="{gallery:CollapseShowCaseLangResource P2TitleDefaultSize}" TitlePosition="Left" FontWeight="Bold" />
                        <atom:Collapse SizeType="Middle">
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsDefaultSizePanelHeader}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>
                        <atom:Separator Title="{gallery:CollapseShowCaseLangResource P2TitleSmallSize}" TitlePosition="Left" FontWeight="Bold" />
                        <atom:Collapse SizeType="Small">
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsSmallSizePanelHeader}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>
                        <atom:Separator Title="{gallery:CollapseShowCaseLangResource P2TitleLargeSize}" TitlePosition="Left" FontWeight="Bold" />
                        <atom:Collapse SizeType="Large">
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsLargeSizePanelHeader}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource AccordionTitle}"
                    Description="{gallery:CollapseShowCaseLangResource AccordionDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <atom:Collapse IsAccordion="True">
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                    </atom:Collapse>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource BorderlessTitle}"
                    Description="{gallery:CollapseShowCaseLangResource BorderlessDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <atom:Collapse IsBorderless="True">
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                    </atom:Collapse>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource GhostCollapseTitle}"
                    Description="{gallery:CollapseShowCaseLangResource GhostCollapseDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <atom:Collapse IsGhostStyle="True">
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                    </atom:Collapse>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource CustomPaddingTitle}"
                    Description="{gallery:CollapseShowCaseLangResource CustomPaddingDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <StackPanel Orientation="Vertical" Spacing="20">
                        <atom:Collapse ItemHeaderPadding="5" ItemContentPadding="5">
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>

                        <atom:Collapse ItemHeaderPadding="0" ItemContentPadding="0" IsGhostStyle="True">
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource NestedPanelTitle}"
                    Description="{gallery:CollapseShowCaseLangResource NestedPanelDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <atom:Collapse>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                            <atom:Collapse>
                                <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                                    <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                                </atom:CollapseItem>
                            </atom:Collapse>
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                    </atom:Collapse>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource NoArrowTitle}"
                    Description="{gallery:CollapseShowCaseLangResource NoArrowDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <atom:Collapse>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                        <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}" IsShowExpandIcon="False">
                            <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                        </atom:CollapseItem>
                    </atom:Collapse>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource ExpandIconLocationTitle}"
                    Description="{gallery:CollapseShowCaseLangResource ExpandIconLocationDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <StackPanel Orientation="Vertical" Spacing="20">
                        <atom:Collapse ExpandIconPosition="{Binding CollapseExpandIconPosition}">
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}"
                                               AddOnContent="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}"
                                               AddOnContent="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}"
                                               AddOnContent="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>

                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <atom:TextBlock VerticalAlignment="Center" Text="{gallery:CollapseShowCaseLangResource P2TextExpandIconPosition}" />
                            <atom:OptionButtonGroup ButtonStyle="Outline"
                                                    OptionCheckedChanged="HandleExpandButtonPosOptionCheckedChanged">
                                <atom:OptionButton IsChecked="True" Content="{gallery:CollapseShowCaseLangResource P2ContentStart}" />
                                <atom:OptionButton Content="{gallery:CollapseShowCaseLangResource P2ContentEnd}" />
                            </atom:OptionButtonGroup>
                        </StackPanel>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource CollapsibleTitle}"
                    Description="{gallery:CollapseShowCaseLangResource CollapsibleDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <atom:Collapse>
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisPanelCanOnlyBeCollapsedByClicking}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>
                        <atom:Collapse TriggerType="Icon">
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisPanelCanOnlyBeCollapsedByClicking2}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>

                        <atom:Collapse IsEnabled="False">
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisPanelCanTBeCollapsed}">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>

                        <atom:Collapse IsEnabled="False">
                            <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisPanelCanTBeCollapsed}" IsSelected="True">
                                <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                            </atom:CollapseItem>
                        </atom:Collapse>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
                <gallery:ShowCaseItem
                    Title="{gallery:CollapseShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:CollapseShowCaseLangResource SemanticPartStyleDescription}"
                    SourceKey="collapse-semantic-part"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    Span="Full"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CollapseViewModel">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Spacing="12">
                                <StackPanel.Styles>
                                    <Style Selector="atom|Collapse.semantic-object">
                                        <Setter Property="Background" Value="#fafafa" />
                                        <Setter Property="BorderBrush" Value="#e0e0e0" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <atom:CollapseHeaderStyle x:SetterTargetType="atom:PixelAlignedBorder">
                                            <Setter Property="Background" Value="#f0f0f0" />
                                            <Setter Property="Padding" Value="16,12" />
                                        </atom:CollapseHeaderStyle>
                                        <atom:CollapseTitleStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#141414" />
                                        </atom:CollapseTitleStyle>
                                    </Style>
                                    <Style Selector="atom|Collapse.semantic-function">
                                        <Setter Property="Background" Value="#ffffff" />
                                        <Setter Property="BorderBrush" Value="#696fc7" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <atom:CollapseHeaderStyle x:SetterTargetType="atom:PixelAlignedBorder">
                                            <Setter Property="Background" Value="#f5efff" />
                                            <Setter Property="Padding" Value="16,12" />
                                        </atom:CollapseHeaderStyle>
                                        <atom:CollapseTitleStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#141414" />
                                        </atom:CollapseTitleStyle>
                                    </Style>
                                </StackPanel.Styles>

                                <atom:Collapse Classes="semantic-object">
                                    <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}" IsSelected="True">
                                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                                    </atom:CollapseItem>
                                    <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}">
                                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                                    </atom:CollapseItem>
                                    <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}">
                                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                                    </atom:CollapseItem>
                                </atom:Collapse>

                                <atom:Collapse Classes="semantic-function" SizeType="Large">
                                    <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN1}">
                                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                                    </atom:CollapseItem>
                                    <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN2}" IsSelected="True">
                                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                                    </atom:CollapseItem>
                                    <atom:CollapseItem Header="{gallery:CollapseShowCaseLangResource P2HeaderThisIsPanelHeaderN3}">
                                        <atom:TextBlock TextWrapping="Wrap" Text="{gallery:CollapseShowCaseLangResource P2TextADogIsATypeOfDomesticatedAnimal}" />
                                    </atom:CollapseItem>
                                </atom:Collapse>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
