<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:DrawerContainer}" TargetType="atom:DrawerContainer">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_RootClip"
                        ClipToBounds="True"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Panel Name="RootLayout">
                        <Border Name="PART_Mask"
                                Classes.semantic-mask="True"
                                IsVisible="{TemplateBinding IsShowMask}"
                                Background="{TemplateBinding Background}"
                                atom:Motion.IsEnabled="{TemplateBinding IsMotionEnabled}" />
                        <Border Name="PART_Surface"
                                atom:Motion.IsEnabled="{TemplateBinding IsMotionEnabled}">
                            <atom:DrawerInfoContainer
                                Name="PART_InfoContainer"
                                Placement="{TemplateBinding Placement}"
                                Title="{TemplateBinding Title}"
                                Footer="{TemplateBinding Footer}"
                                FooterTemplate="{TemplateBinding FooterTemplate}"
                                ContentPadding="{TemplateBinding ContentPadding}"
                                Extra="{TemplateBinding Extra}"
                                ExtraTemplate="{TemplateBinding ExtraTemplate}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                IsShowCloseButton="{TemplateBinding IsShowCloseButton}"
                                DialogSize="{TemplateBinding DialogSize}"/>
                        </Border>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="MotionDuration"
                Value="{atom:SharedTokenResource MotionDurationSlow}" />
        <Setter Property="Background"
                Value="{atom:SharedTokenResource ColorBgMask}" />

        <Style Selector="^[Placement=Left] /template/ Border#PART_Surface">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Width" Value="{TemplateBinding DialogSize}" />
        </Style>
        <Style Selector="^[Placement=Right] /template/ Border#PART_Surface">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Width" Value="{TemplateBinding DialogSize}" />
        </Style>
        <Style Selector="^[Placement=Top] /template/ Border#PART_Surface">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Height" Value="{TemplateBinding DialogSize}" />
        </Style>
        <Style Selector="^[Placement=Bottom] /template/ Border#PART_Surface">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Height" Value="{TemplateBinding DialogSize}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
