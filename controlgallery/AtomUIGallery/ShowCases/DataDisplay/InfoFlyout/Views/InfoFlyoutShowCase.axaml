<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AtomUIGallery.ShowCases.InfoFlyout"
             x:Class="AtomUIGallery.ShowCases.InfoFlyout.InfoFlyoutShowCase"
             x:DataType="vm:InfoFlyoutViewModel"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="InfoFlyout"
                    Category="{gallery:InfoFlyoutShowCaseLangResource ComponentCategory}"
                    Status="{gallery:InfoFlyoutShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:InfoFlyoutShowCaseLangResource PageSubtitle}"
                    Description="{gallery:InfoFlyoutShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="ContentControl" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
                    <gallery:SemanticPartPreview Name="InfoFlyoutSemanticPreview"
                                                 Title="InfoFlyout"
                                                 SemanticOwnerType="{x:Type atom:FlyoutHost}"
                                                 Loaded="HandleSemanticPreviewLoaded"
                                                 Unloaded="HandleSemanticPreviewUnloaded">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:FlyoutHost Name="InfoFlyoutSemanticOwner"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IsPopupPinnedOpen="True"
                                             IsMotionEnabled="False"
                                             IsArrowVisible="True"
                                             Placement="Bottom">
                                <atom:FlyoutHost.Flyout>
                                    <atom:Flyout ShouldUseOverlayPopup="True">
                                        <Border Width="240" Padding="16">
                                            <TextBlock Text="{gallery:InfoFlyoutShowCaseLangResource SemanticPreviewContentText}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </atom:Flyout>
                                </atom:FlyoutHost.Flyout>
                                <atom:Button ButtonType="Primary"
                                             Content="{gallery:InfoFlyoutShowCaseLangResource SemanticPreviewTriggerContent}" />
                            </atom:FlyoutHost>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription Path="root"
                                Description="{gallery:InfoFlyoutShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription Path="popup.root"
                                Description="{gallery:InfoFlyoutShowCaseLangResource SemanticPopupRootDescription}" />
                            <gallery:SemanticPartDescription Path="popup.container"
                                Description="{gallery:InfoFlyoutShowCaseLangResource SemanticPopupContainerDescription}" />
                            <gallery:SemanticPartDescription Path="popup.content"
                                Description="{gallery:InfoFlyoutShowCaseLangResource SemanticPopupContentDescription}" />
                            <gallery:SemanticPartDescription Path="popup.arrow"
                                Description="{gallery:InfoFlyoutShowCaseLangResource SemanticPopupArrowDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:InfoFlyoutShowCaseLangResource BasicTitle}"
        Description="{gallery:InfoFlyoutShowCaseLangResource BasicDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:FlyoutHost Trigger="Hover" ShouldUseOverlayPopup="False">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button ButtonType="Primary" Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentHoverMe}" />
            </atom:FlyoutHost>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:InfoFlyoutShowCaseLangResource TriggerWaysTitle}"
        Description="{gallery:InfoFlyoutShowCaseLangResource TriggerWaysDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <atom:FlyoutHost Trigger="Hover" ShouldUseOverlayPopup="False">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentHoverMe}" />
            </atom:FlyoutHost>
            <atom:FlyoutHost Trigger="Focus" ShouldUseOverlayPopup="False">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="220" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentFocusMe}" />
            </atom:FlyoutHost>
            <atom:FlyoutHost Trigger="Click" ShouldUseOverlayPopup="False">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentClickMe}" />
            </atom:FlyoutHost>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:InfoFlyoutShowCaseLangResource PlacementTitle}"
        Description="{gallery:InfoFlyoutShowCaseLangResource PlacementDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
        <Grid>
            <Grid.Styles>
                <Style Selector="atom|Button">
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="Width" Value="80" />
                </Style>
            </Grid.Styles>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <atom:FlyoutHost Grid.Row="1" Grid.Column="0" Trigger="Hover" Placement="LeftEdgeAlignedTop">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLT}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="2" Grid.Column="0" Trigger="Hover" Placement="Left">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLeft}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="3" Grid.Column="0" Trigger="Hover" Placement="LeftEdgeAlignedBottom">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLB}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="0" Grid.Column="1" Trigger="Hover" Placement="TopEdgeAlignedLeft">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTL}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="0" Grid.Column="2" Trigger="Hover" Placement="Top">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTop}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="0" Grid.Column="3" Trigger="Hover" Placement="TopEdgeAlignedRight">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTR}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="1" Grid.Column="4" Trigger="Hover" Placement="RightEdgeAlignedTop">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRT}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="2" Grid.Column="4" Trigger="Hover" Placement="Right">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRight}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="3" Grid.Column="4" Trigger="Hover" Placement="RightEdgeAlignedBottom">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRB}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="4" Grid.Column="1" Trigger="Hover" Placement="BottomEdgeAlignedLeft">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBL}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="4" Grid.Column="2" Trigger="Hover" Placement="Bottom">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBottom}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Grid.Row="4" Grid.Column="3" Trigger="Hover" Placement="BottomEdgeAlignedRight">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBR}" />
            </atom:FlyoutHost>

        </Grid>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:InfoFlyoutShowCaseLangResource ArrowTitle}"
        Description="{gallery:InfoFlyoutShowCaseLangResource ArrowDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Segmented x:Name="ArrowSegmented"
                            SelectionChanged="HandleArrowSegmentedSelectionChanged">
                <atom:SegmentedItem Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentShow}" />
                <atom:SegmentedItem Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentHide}" />
                <atom:SegmentedItem Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentCenter}" />
            </atom:Segmented>
            <Grid>
                <Grid.Styles>
                    <Style Selector="atom|Button">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Width" Value="80" />
                    </Style>
                </Grid.Styles>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <atom:FlyoutHost Grid.Row="1" Grid.Column="0"
                                 Trigger="Hover"
                                 Placement="LeftEdgeAlignedTop"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLT}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="2" Grid.Column="0"
                                 Trigger="Hover"
                                 Placement="Left"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLeft}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="3" Grid.Column="0"
                                 Trigger="Hover"
                                 Placement="LeftEdgeAlignedBottom"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLB}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="0" Grid.Column="1"
                                 Trigger="Hover"
                                 Placement="TopEdgeAlignedLeft"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTL}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="0" Grid.Column="2"
                                 Trigger="Hover"
                                 Placement="Top"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTop}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="0" Grid.Column="3"
                                 Trigger="Hover"
                                 Placement="TopEdgeAlignedRight"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTR}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="1" Grid.Column="4"
                                 Trigger="Hover"
                                 Placement="RightEdgeAlignedTop"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRT}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="2" Grid.Column="4"
                                 Trigger="Hover"
                                 Placement="Right"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRight}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="3" Grid.Column="4"
                                 Trigger="Hover"
                                 Placement="RightEdgeAlignedBottom"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRB}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="4" Grid.Column="1"
                                 Trigger="Hover"
                                 Placement="BottomEdgeAlignedLeft"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBL}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="4" Grid.Column="2"
                                 Trigger="Hover"
                                 Placement="Bottom"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBottom}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="4" Grid.Column="3"
                                 Trigger="Hover"
                                 Placement="BottomEdgeAlignedRight"
                                 IsArrowVisible="{Binding  ShowArrow}"
                                 IsPointAtCenter="{Binding  IsPointAtCenter}">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBR}" />
                </atom:FlyoutHost>

            </Grid>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:InfoFlyoutShowCaseLangResource StyleClassTitle}"
        Description="{gallery:InfoFlyoutShowCaseLangResource StyleClassDescription}"
        SourceKey="infoflyout-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <StackPanel.Styles>
                <Style Selector="atom|FlyoutHost.semantic-styles-object-demo">
                    <atom:FlyoutHostPopupRootStyle x:SetterTargetType="atom:FlyoutPresenter">
                        <Setter Property="Background" Value="#EEEEEE" />
                        <Setter Property="Foreground" Value="#262626" />
                        <Setter Property="Padding" Value="10" />
                    </atom:FlyoutHostPopupRootStyle>
                </Style>
                <Style Selector="atom|FlyoutHost.semantic-styles-function-demo">
                    <atom:FlyoutHostPopupRootStyle x:SetterTargetType="atom:FlyoutPresenter">
                        <Setter Property="Background" Value="#CC35477D" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="12" />
                        <Setter Property="CornerRadius" Value="4" />
                    </atom:FlyoutHostPopupRootStyle>
                </Style>
            </StackPanel.Styles>
            <atom:FlyoutHost Classes="semantic-styles-object-demo"
                             Trigger="Hover"
                             ShouldUseOverlayPopup="False"
                             IsArrowVisible="False"
                             Placement="Top">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Text="{gallery:InfoFlyoutShowCaseLangResource SemanticStyleObjectContent}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource SemanticStyleObjectTrigger}" />
            </atom:FlyoutHost>

            <atom:FlyoutHost Classes="semantic-styles-function-demo"
                             Trigger="Hover"
                             ShouldUseOverlayPopup="False"
                             IsArrowVisible="False"
                             Placement="Top">
                <atom:FlyoutHost.Flyout>
                    <atom:Flyout>
                        <TextBlock Text="{gallery:InfoFlyoutShowCaseLangResource SemanticStyleFunctionContent}" />
                    </atom:Flyout>
                </atom:FlyoutHost.Flyout>
                <atom:Button ButtonType="Primary"
                             Content="{gallery:InfoFlyoutShowCaseLangResource SemanticStyleFunctionTrigger}" />
            </atom:FlyoutHost>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
