<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Calendar.CalendarShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Calendar"
             x:DataType="vm:CalendarViewModel">
    <UserControl.Resources>
        <vm:NoticeCalendarDateEventVisibilityConverter x:Key="NoticeCalendarDateEventVisibilityConverter" />
        <vm:NoticeCalendarDateCellVisibilityConverter x:Key="NoticeCalendarDateCellVisibilityConverter" />
        <vm:NoticeCalendarMonthBacklogVisibilityConverter x:Key="NoticeCalendarMonthBacklogVisibilityConverter" />
        <vm:CustomCalendarHeaderYearOptionsConverter x:Key="CustomCalendarHeaderYearOptionsConverter" />
        <vm:CustomCalendarHeaderMonthOptionsConverter x:Key="CustomCalendarHeaderMonthOptionsConverter" />
        <vm:CustomCalendarHeaderSelectionIndexConverter x:Key="CustomCalendarHeaderSelectionIndexConverter" />
    </UserControl.Resources>

    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Calendar"
                    Category="{gallery:CalendarShowCaseLangResource ComponentCategory}"
                    Status="{gallery:CalendarShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:CalendarShowCaseLangResource PageSubtitle}"
                    Description="{gallery:CalendarShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="TemplatedControl" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:CalendarViewModel">
                    <gallery:SemanticPartPreview Name="CalendarSemanticPreview"
                                                 SemanticOwner="{Binding #CalendarSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:Calendar}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:Calendar Name="CalendarSemanticOwner" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:CalendarShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="header"
                                Description="{gallery:CalendarShowCaseLangResource SemanticHeaderDescription}" />
                            <gallery:SemanticPartDescription
                                Path="body"
                                Description="{gallery:CalendarShowCaseLangResource SemanticBodyDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:CalendarShowCaseLangResource SemanticContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="item"
                                Description="{gallery:CalendarShowCaseLangResource SemanticItemDescription}" />
                            <gallery:SemanticPartDescription
                                Path="itemContent"
                                Description="{gallery:CalendarShowCaseLangResource SemanticItemContentDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="1"
                                   DeferredLoadBatchSize="2"
                                   DeferredLoadViewportBuffer="0"
                                   MaxColumns="1"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource BasicTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource BasicDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource NoticeCalendarTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource NoticeCalendarDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch">
                                <atom:Calendar.CellTemplate>
                                    <DataTemplate x:DataType="atom:CalendarCellContext">
                                        <Grid>
                                            <atom:ScrollViewer IsLiteMode="True"
                                                               AllowAutoHide="True"
                                                               MaxHeight="74"
                                                               VerticalScrollBarVisibility="Auto"
                                                               HorizontalScrollBarVisibility="Disabled"
                                                               IsScrollChainingEnabled="False"
                                                               ClipToBounds="True"
                                                               IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateCellVisibilityConverter}}">
                                                <StackPanel Margin="0,4,0,0" Spacing="4">
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=8|10|15}">
                                                        <atom:DotBadge Status="Warning" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarWarningEventText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=8|10}">
                                                        <atom:DotBadge Status="Success" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarUsualEventText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=10}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEventText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Success" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarLongUsualEventText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEvent1Text}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEvent2Text}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEvent3Text}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEvent4Text}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </StackPanel>
                                            </atom:ScrollViewer>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="2"
                                                        IsVisible="{Binding ., Converter={StaticResource NoticeCalendarMonthBacklogVisibilityConverter}}">
                                                <atom:TextBlock Text="1394"
                                                                FontSize="{atom:SharedTokenResource FontSizeXL}"
                                                                FontWeight="SemiBold"
                                                                HorizontalAlignment="Center" />
                                                <atom:TextBlock Text="{gallery:CalendarShowCaseLangResource NoticeCalendarBacklogText}"
                                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                                HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </atom:Calendar.CellTemplate>
                            </atom:Calendar>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource CrossDateEventsTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource CrossDateEventsDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding CrossDateEventsSampleDate}"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch">
                                <atom:Calendar.RangeBars>
                                    <atom:CalendarRangeBar StartDate="2026-01-08"
                                                           EndDate="2026-01-10"
                                                           Label="{gallery:CalendarShowCaseLangResource CrossDateEventsReleaseText}"
                                                           Background="{atom:SharedTokenResource ColorPrimary}" />
                                    <atom:CalendarRangeBar StartDate="2026-01-14"
                                                           EndDate="2026-01-14"
                                                           Label="{gallery:CalendarShowCaseLangResource CrossDateEventsDesignReviewText}"
                                                           Background="{atom:SharedTokenResource ColorSuccess}" />
                                    <atom:CalendarRangeBar StartDate="2026-01-21"
                                                           EndDate="2026-01-24"
                                                           Label="{gallery:CalendarShowCaseLangResource CrossDateEventsMaintenanceText}"
                                                           Background="{atom:SharedTokenResource ColorWarning}" />
                                    <atom:CalendarRangeBar StartDate="2026-01-30"
                                                           EndDate="2026-01-31"
                                                           Label="{gallery:CalendarShowCaseLangResource CrossDateEventsBugFixText}"
                                                           Background="{atom:SharedTokenResource ColorError}" />
                                </atom:Calendar.RangeBars>
                            </atom:Calendar>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource CardTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource CardDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <Border Width="300"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                    BorderThickness="{atom:SharedTokenResource BorderThickness}"
                                    CornerRadius="{atom:SharedTokenResource BorderRadiusLG}">
                                <atom:Calendar Value="{Binding SampleDate}" Fullscreen="False" />
                            </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource LunarCalendarTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource LunarCalendarDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:LunarCalendar Value="{Binding LunarCalendarSampleDate}"
                                                 ShowSolarTerms="True"
                                                 ShowTraditionalFestivals="True"
                                                 ShowHolidays="True"
                                                 HighlightWeekends="False"
                                                 HolidayProvider="{Binding LunarCalendarHolidayProvider}"
                                                 MinWidth="640"
                                                 HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource LunarCalendarCardTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource LunarCalendarCardDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <Border MinWidth="300"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                    BorderThickness="{atom:SharedTokenResource BorderThickness}"
                                    CornerRadius="{atom:SharedTokenResource BorderRadiusLG}">
                                <atom:LunarCalendar Value="{Binding LunarCalendarSampleDate}"
                                                     Fullscreen="False"
                                                     ShowSolarTerms="True"
                                                     ShowTraditionalFestivals="True"
                                                     ShowHolidays="True"
                                                     HighlightWeekends="False" />
                            </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource SelectableCalendarTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource SelectableCalendarDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <StackPanel>
                                <atom:Alert Type="Info"
                                            Message="{Binding SelectableCalendarSelectedText}" />
                                <atom:Calendar Value="{Binding SelectableCalendarValue}"
                                               Selected="OnSelectableCalendarSelected"
                                               MinWidth="640"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource ShowWeekTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource ShowWeekDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <StackPanel Spacing="16">
                                <atom:Calendar Value="{Binding SampleDate}"
                                               Fullscreen="True"
                                               ShowWeek="True"
                                               MinWidth="640"
                                               HorizontalAlignment="Stretch" />
                                <Border Width="300"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                        BorderThickness="{atom:SharedTokenResource BorderThickness}"
                                        CornerRadius="{atom:SharedTokenResource BorderRadiusLG}">
                                    <atom:Calendar Value="{Binding SampleDate}"
                                                   Fullscreen="False"
                                                   ShowWeek="True" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource CustomHeaderTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource CustomHeaderDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <Border Width="300"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                    BorderThickness="{atom:SharedTokenResource BorderThickness}"
                                    CornerRadius="{atom:SharedTokenResource BorderRadiusLG}">
                                <atom:Calendar Value="{Binding SampleDate}"
                                               Fullscreen="False">
                                    <atom:Calendar.HeaderTemplate>
                                        <DataTemplate x:DataType="atom:CalendarHeaderContext">
                                            <StackPanel Margin="8"
                                                        Spacing="{atom:SharedTokenResource UniformlyMarginXS}">
                                                <atom:TextBlock Text="{gallery:CalendarShowCaseLangResource CustomHeaderContentTitle}"
                                                                FontSize="{atom:SharedTokenResource FontSizeXL}"
                                                                FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{atom:SharedTokenResource UniformlyMarginXS}">
                                                    <atom:OptionButtonGroup SizeType="Small"
                                                                            ButtonStyle="Outline"
                                                                            SelectedIndex="{Binding Mode, Converter={StaticResource CustomCalendarHeaderSelectionIndexConverter}, Mode=OneWay}"
                                                                            SelectionChanged="OnCustomHeaderModeSelectionChanged">
                                                        <atom:OptionButton Content="{gallery:CalendarShowCaseLangResource CustomHeaderMonthText}" />
                                                        <atom:OptionButton Content="{gallery:CalendarShowCaseLangResource CustomHeaderYearText}" />
                                                    </atom:OptionButtonGroup>
                                                    <atom:ComboBox Name="CustomHeaderYearSelect"
                                                                   SizeType="Small"
                                                                   MinWidth="{atom:CalendarTokenResource YearControlWidth}"
                                                                   DropDownDisplayPageSize="8"
                                                                   ItemsSource="{Binding Value, Converter={StaticResource CustomCalendarHeaderYearOptionsConverter}}"
                                                                   SelectedItem="{Binding Value.Year, Mode=OneWay}"
                                                                   SelectionChanged="OnCustomHeaderYearSelectionChanged" />
                                                    <atom:ComboBox Name="CustomHeaderMonthSelect"
                                                                   SizeType="Small"
                                                                   MinWidth="{atom:CalendarTokenResource MonthControlWidth}"
                                                                   DropDownDisplayPageSize="8"
                                                                   ItemsSource="{Binding Value, Converter={StaticResource CustomCalendarHeaderMonthOptionsConverter}}"
                                                                   SelectedIndex="{Binding Value, Converter={StaticResource CustomCalendarHeaderSelectionIndexConverter}, Mode=OneWay}"
                                                                   SelectionChanged="OnCustomHeaderMonthSelectionChanged" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </atom:Calendar.HeaderTemplate>
                                </atom:Calendar>
                            </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CalendarShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:CalendarShowCaseLangResource SemanticPartStyleDescription}"
                    SourceKey="calendar-semantic-part"
                    BadgeText="v6.1.3"
                    Span="Full"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Spacing="12">
                                <StackPanel.Styles>
                                    <Style Selector="atom|Calendar.semantic-object">
                                        <Setter Property="Fullscreen" Value="False" />
                                        <Setter Property="Width" Value="600" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Padding" Value="10" />
                                        <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimaryBg}" />
                                    </Style>
                                    <Style Selector="atom|Calendar.semantic-function">
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="BorderBrush" Value="#BDE3C3" />
                                        <Setter Property="CornerRadius" Value="10" />
                                        <Setter Property="Padding" Value="10" />
                                        <Setter Property="Background" Value="#4DBDE3C3" />
                                    </Style>
                                </StackPanel.Styles>

                                <atom:Calendar Classes="semantic-object"
                                               Value="{Binding SampleDate}" />
                                <atom:Calendar Classes="semantic-function"
                                               Value="{Binding SampleDate}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
