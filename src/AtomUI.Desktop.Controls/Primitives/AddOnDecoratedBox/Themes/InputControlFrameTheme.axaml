<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.InputControlFrameTheme"
              TargetType="atom:InputControlFrame"
              x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:InputControlFrame">
            <atom:PixelAlignedBorder
                Name="InnerBoxDecorator"
                Padding="{TemplateBinding Padding}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BoxShadow="{TemplateBinding BoxShadow}"
                BackgroundSizing="InnerBorderEdge">
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </atom:PixelAlignedBorder>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|InputControlFrame)">
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        
        <Style Selector="^[SizeType=Large]">
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
                <Setter Property="Padding"
                        Value="{atom:SharedTokenResource InputPaddingLG}" />
            </Style>
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
                <Setter Property="Padding"
                        Value="{atom:SharedTokenResource InputPaddingLG}" />
            </Style>
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
                <Setter Property="Padding" Value="{atom:SharedTokenResource InputPadding}" />
            </Style>
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
                <Setter Property="Padding" Value="{atom:SharedTokenResource InputPadding}" />
            </Style>
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
                <Setter Property="Padding"
                        Value="{atom:SharedTokenResource InputPaddingSM}" />
            </Style>
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
                <Setter Property="Padding"
                        Value="{atom:SharedTokenResource InputPaddingSM}" />
            </Style>
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
        </Style>

        <!-- status 不同的时候左右附加区域的主体色设置 -->
        <Style Selector="^[EffectiveStatus=Error]">
        </Style>

        <Style Selector="^[EffectiveStatus=Warning]">
        </Style>

        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />

        <!-- Outline -->
        <Style Selector="^:outline">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
        </Style>
        <Style Selector="^:outline[IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorPrimaryHover}" />
        </Style>
        <Style Selector="^:outline:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputActiveShadow}" />
        </Style>
        <Style Selector="^:outline:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputActiveShadow}" />
        </Style>

        <!-- Outline + Error -->
        <Style Selector="^:outline[EffectiveStatus=Error]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorError}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:outline[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorError}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Error][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorErrorBorderHover}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Error]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorError}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputErrorActiveShadow}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Error]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorError}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputErrorActiveShadow}" />
        </Style>

        <!-- Outline + Warning -->
        <Style Selector="^:outline[EffectiveStatus=Warning]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarning}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:outline[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarning}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Warning][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarningBorderHover}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Warning]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarning}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputWarningActiveShadow}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Warning]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarning}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputWarningActiveShadow}" />
        </Style>

        <!-- Filled -->
        <Style Selector="^:filled">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorFillTertiary}" />
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorFillTertiary}" />
        </Style>
        <Style Selector="^:filled /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:filled /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorFillTertiary}" />
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorFillTertiary}" />
        </Style>
        <Style Selector="^:filled[IsInnerBoxHover=True]">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorFillSecondary}" />
        </Style>
        <Style Selector="^:filled:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputActiveShadow}" />
        </Style>
        <Style Selector="^:filled:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputActiveShadow}" />
        </Style>

        <!-- Filled + Error -->
        <Style Selector="^:filled[EffectiveStatus=Error]">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorErrorBg}" />
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorErrorBg}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:filled[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorErrorBg}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Error][IsInnerBoxHover=True]">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorErrorBgHover}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Error]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorError}" />
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorTransparent}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputErrorActiveShadow}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Error]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorError}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputErrorActiveShadow}" />
        </Style>

        <!-- Filled + Warning -->
        <Style Selector="^:filled[EffectiveStatus=Warning]">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorWarningBg}" />
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorWarningBg}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:filled[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorWarningBg}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Warning][IsInnerBoxHover=True]">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorWarningBgHover}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Warning]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarning}" />
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorTransparent}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputWarningActiveShadow}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Warning]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarning}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputWarningActiveShadow}" />
        </Style>

        <!-- Borderless -->
        <Style Selector="^:borderless /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:borderless /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Underlined -->
        <Style Selector="^:underlined">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />
        </Style>
        <Style Selector="^:underlined /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:underlined /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:underlined[IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorPrimaryHover}" />
        </Style>
        <Style Selector="^:underlined:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputActiveShadow}" />
        </Style>
        <Style Selector="^:underlined:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputActiveShadow}" />
        </Style>

        <!-- Underlined + Error -->
        <Style Selector="^:underlined[EffectiveStatus=Error]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorError}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Error][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorErrorBorderHover}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Error]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorError}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputErrorActiveShadow}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Error]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorError}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputErrorActiveShadow}" />
        </Style>

        <!-- Underlined + Warning -->
        <Style Selector="^:underlined[EffectiveStatus=Warning]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarning}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Warning][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarningBorderHover}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Warning]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarning}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputWarningActiveShadow}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Warning]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorWarning}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SharedTokenResource InputWarningActiveShadow}" />
        </Style>

        <!-- Disabled -->
        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:SharedTokenResource ColorTextDisabled}" />
        </Style>
        <Style Selector="^:disabled:outline, ^:disabled:filled">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorBgContainerDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorBorder}" />
        </Style>
        <Style Selector="^:disabled:outline /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:disabled:outline /template/ atom|PixelAlignedBorder#PART_RightAddOn,
                         ^:disabled:filled /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:disabled:filled /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorBgContainerDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorBorder}" />
        </Style>
        <Style Selector="^:disabled:underlined">
            <Setter Property="BorderBrush"
                    Value="{atom:SharedTokenResource ColorBorder}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="BorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:BoxShadowsTransition Property="BoxShadow" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#InnerBoxDecorator">
                <Setter Property="Transitions">
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="BorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                        <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                        <atom:BoxShadowsTransition Property="BoxShadow" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </Style>

</ControlTheme>
