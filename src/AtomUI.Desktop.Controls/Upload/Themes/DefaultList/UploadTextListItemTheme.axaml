<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:UploadTextListItem}" TargetType="atom:UploadTextListItem">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Vertical" Name="RootLayout">
                    <atom:UploadTextListItemHeader FileName="{TemplateBinding FileName}"
                                                   Status="{TemplateBinding Status}"
                                                   ErrorMessage="{TemplateBinding ErrorMessage}"
                                                   IsMotionEnabled="{TemplateBinding IsMotionEnabled}" />
                    <Border Name="ProgressBarFrame"
                            Padding="{atom:UploadTokenResource TextListProgressPadding}"
                            IsHitTestVisible="False"
                            IsVisible="False">
                        <atom:ProgressBar Name="ProgressBar"
                                          SizeType="Small"
                                          IndicatorThickness="{atom:UploadTokenResource TextListProgressLineHeight}"
                                          Value="{TemplateBinding Progress}"
                                          IsProgressInfoVisible="False" />
                    </Border>
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[Status=Uploading]">
            <Style Selector="^ /template/ Border#ProgressBarFrame">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        
        <Style Selector="^ /template/ StackPanel#RootLayout">
            <Setter Property="Spacing" Value="{atom:SharedTokenResource SpacingXXS}" />
        </Style>

        <Style Selector="^ /template/ atom|ProgressBar#ProgressBar">
            <Setter Property="GrooveBrush" Value="{atom:SharedTokenResource ColorFillSecondary}" />
            <Setter Property="StrokeBrush" Value="{atom:SharedTokenResource ColorPrimary}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
