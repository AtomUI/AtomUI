<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:OtpLineEditCell}" TargetType="atom:OtpLineEditCell">
        <ControlTheme.BasedOn>
            <atom:InputControlFrameTheme TargetType="atom:OtpLineEditCell" />
        </ControlTheme.BasedOn>

        <ControlTheme.Resources>
            <Animation x:Key="OtpLineEditCaretBlink" Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
            <ControlTheme x:Key="OtpLineEditCaretTheme" TargetType="atom:OtpLineEditCaret">
                <Setter Property="BlinkDuration" Value="{atom:OtpLineEditTokenResource CaretBlinkDuration}" />
                <Setter Property="BlinkEasing" Value="{atom:OtpLineEditTokenResource CaretBlinkEasing}" />
                <Setter Property="BlinkBlueprint" Value="{StaticResource OtpLineEditCaretBlink}" />
            </ControlTheme>
        </ControlTheme.Resources>

        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder
                    Name="PART_Frame"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BoxShadow="{TemplateBinding BoxShadow}"
                    BackgroundSizing="InnerBorderEdge">
                    <Panel>
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <!--
                            活动 cell 的输入光标。
                            显隐由主题依据活动及启用状态驱动，
                            闪烁默认保持既有 1s 线性往返，周期/曲线使用 OTP Own；颜色/高度跟随 cell 字体。
                        -->
                        <atom:OtpLineEditCaret
                            Name="PART_Caret"
                            Theme="{StaticResource OtpLineEditCaretTheme}"
                            IsActive="{TemplateBinding IsActive}"
                            Width="{atom:OtpLineEditTokenResource LineWidth}"
                            Height="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <atom:OtpLineEditCaret.RenderTransform>
                                <TranslateTransform>
                                    <TranslateTransform.X>
                                        <MultiBinding Converter="{x:Static atom:OtpLineEditCaretOffsetConverter.Instance}">
                                            <Binding Path="DisplayText" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="FontSize" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </TranslateTransform.X>
                                </TranslateTransform>
                            </atom:OtpLineEditCaret.RenderTransform>
                        </atom:OtpLineEditCaret>
                    </Panel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:is(atom|OtpLineEditCell)">
            <Setter Property="Width" Value="{atom:OtpLineEditTokenResource CellWidth}" />
            <Setter Property="Height" Value="{atom:OtpLineEditTokenResource ControlHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
            <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorBorder}" />
            <Setter Property="BorderThickness" Value="{atom:OtpLineEditTokenResource BorderThickness}" />
            <Setter Property="CornerRadius" Value="{atom:OtpLineEditTokenResource BorderRadius}" />
            <Setter Property="Foreground" Value="{atom:OtpLineEditTokenResource ColorText}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsMotionEnabled" Value="{atom:OtpLineEditTokenResource EnableMotion}" />

            <Style Selector="^[SizeType=Large]">
                <Setter Property="Width" Value="{atom:OtpLineEditTokenResource CellWidthLG}" />
                <Setter Property="Height" Value="{atom:OtpLineEditTokenResource ControlHeightLG}" />
                <Setter Property="FontSize" Value="{atom:OtpLineEditTokenResource FontSizeLG}" />
            </Style>

            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="FontSize" Value="{atom:OtpLineEditTokenResource FontSize}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Width" Value="{atom:OtpLineEditTokenResource CellWidthSM}" />
                <Setter Property="Height" Value="{atom:OtpLineEditTokenResource ControlHeightSM}" />
                <Setter Property="FontSize" Value="{atom:OtpLineEditTokenResource FontSizeSM}" />
            </Style>

            <Style Selector="^[StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorFillTertiary}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style Selector="^[StyleVariant=Borderless]">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style Selector="^[StyleVariant=Underlined]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorBorder}" />
                <Setter Property="BorderThickness">
                    <MultiBinding Converter="{x:Static atom:OtpLineEditThicknessConverter.Bottom}">
                        <atom:OtpLineEditTokenResource Kind="BorderThickness" />
                    </MultiBinding>
                </Setter>
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <Style Selector="^:pointerover[StyleVariant=Outlined], ^:pointerover[StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorPrimaryHover}" />
            </Style>

            <Style Selector="^:pointerover[StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorFillSecondary}" />
            </Style>

            <Style Selector="^:pressed[StyleVariant=Outlined], ^:pressed[StyleVariant=Filled], ^:pressed[StyleVariant=Underlined], ^[IsActive=True][StyleVariant=Outlined], ^[IsActive=True][StyleVariant=Filled], ^[IsActive=True][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorPrimary}" />
                <Setter Property="BoxShadow" Value="{atom:OtpLineEditTokenResource InputActiveShadow}" />
            </Style>

            <Style Selector="^[IsActive=True][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
            </Style>

            <Style Selector="^[Status=Error][StyleVariant=Outlined], ^[Status=Error][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorError}" />
            </Style>

            <Style Selector="^[Status=Error][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorErrorBg}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style Selector="^[Status=Error][StyleVariant=Filled], ^[Status=Error][StyleVariant=Borderless]">
                <Setter Property="Foreground" Value="{atom:OtpLineEditTokenResource ColorErrorText}" />
            </Style>

            <Style Selector="^:pointerover[Status=Error][StyleVariant=Outlined], ^:pointerover[Status=Error][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorErrorBorderHover}" />
            </Style>

            <Style Selector="^:pointerover[Status=Error][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorErrorBgHover}" />
            </Style>

            <Style Selector="^[Status=Error]:pressed, ^[Status=Error][IsActive=True]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorError}" />
                <Setter Property="BoxShadow" Value="{atom:OtpLineEditTokenResource InputErrorActiveShadow}" />
            </Style>

            <Style Selector="^[Status=Error][IsActive=True][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
            </Style>

            <Style Selector="^[Status=Warning][StyleVariant=Outlined], ^[Status=Warning][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorWarning}" />
            </Style>

            <Style Selector="^[Status=Warning][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorWarningBg}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style Selector="^[Status=Warning][StyleVariant=Filled], ^[Status=Warning][StyleVariant=Borderless]">
                <Setter Property="Foreground" Value="{atom:OtpLineEditTokenResource ColorWarningText}" />
            </Style>

            <Style Selector="^:pointerover[Status=Warning][StyleVariant=Outlined], ^:pointerover[Status=Warning][StyleVariant=Underlined]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorWarningBorderHover}" />
            </Style>

            <Style Selector="^:pointerover[Status=Warning][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorWarningBgHover}" />
            </Style>

            <Style Selector="^[Status=Warning]:pressed, ^[Status=Warning][IsActive=True]">
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorWarning}" />
                <Setter Property="BoxShadow" Value="{atom:OtpLineEditTokenResource InputWarningActiveShadow}" />
            </Style>

            <Style Selector="^[Status=Warning][IsActive=True][StyleVariant=Filled]">
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainer}" />
            </Style>

            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{atom:OtpLineEditTokenResource ColorTextDisabled}" />
                <Setter Property="Background" Value="{atom:OtpLineEditTokenResource ColorBgContainerDisabled}" />
                <Setter Property="BorderBrush" Value="{atom:OtpLineEditTokenResource ColorBorder}" />
            </Style>

            <Style Selector="^:disabled[StyleVariant=Borderless]">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

        </Style>

        <Style Selector="^ /template/ atom|OtpLineEditCaret#PART_Caret">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:cell-active:not(:disabled) /template/ atom|OtpLineEditCaret#PART_Caret">
            <Setter Property="IsVisible" Value="True" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
