<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.LineEdit.LineEditShowCase"
             xmlns:vm="using:AtomUIGallery.ShowCases.LineEdit"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             x:DataType="vm:LineEditViewModel">
    <UserControl.Resources>
        <vm:OtpLineEditSeparatorBrushConverter x:Key="OtpLineEditSeparatorBrushConverter" />
    </UserControl.Resources>

    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="LineEdit"
                    Category="{gallery:LineEditShowCaseLangResource ComponentCategory}"
                    Status="{gallery:LineEditShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:LineEditShowCaseLangResource PageSubtitle}"
                    Description="{gallery:LineEditShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="TextBox" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:LineEditViewModel">
                    <StackPanel Spacing="24">
                        <gallery:SemanticPartPreview Name="LineEditSemanticPreview"
                                                     Title="LineEdit"
                                                     SemanticOwner="{Binding #LineEditSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:LineEdit}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:LineEdit Name="LineEditSemanticOwner"
                                               Width="420"
                                               SizeType="Middle"
                                               StyleVariant="Outlined"
                                               Text="atomui"
                                               InnerLeftContent="https://"
                                               InnerRightContent=".com"
                                               IsAllowClear="True"
                                               IsShowCount="True"
                                               MaxLength="20" />
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="prefix"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticPrefixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="input"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticInputDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="suffix"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticSuffixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="clear"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticClearDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="count"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticCountDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <gallery:SemanticPartPreview Name="PasswordSemanticPreview"
                                                     Title="Password"
                                                     SemanticOwner="{Binding #PasswordSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:LineEdit}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:LineEdit Name="PasswordSemanticOwner"
                                               Width="420"
                                               SizeType="Middle"
                                               StyleVariant="Outlined"
                                               Text="AtomUI!Password42"
                                               PasswordChar="•"
                                               RevealPassword="False"
                                               IsEnableRevealButton="True"
                                               InnerLeftContent="{antdicons:AntDesignIconProvider Kind=UserOutlined}"
                                               IsAllowClear="True"
                                               IsShowCount="True"
                                               MaxLength="20" />
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticPasswordRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="prefix"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticPasswordPrefixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="input"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticPasswordInputDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="suffix"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticPasswordSuffixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="clear"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticPasswordClearDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="count"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticPasswordCountDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <gallery:SemanticPartPreview Name="TextAreaSemanticPreview"
                                                     Title="TextArea"
                                                     SemanticOwner="{Binding #TextAreaSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:TextArea}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:TextArea Name="TextAreaSemanticOwner"
                                               Text="Hello, AtomUI"
                                               Lines="3"
                                               IsAllowClear="True"
                                               IsShowCount="True"
                                               MaxLength="100" />
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticTextAreaRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="textarea"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticTextAreaDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="clear"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticTextAreaClearDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="count"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticTextAreaCountDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <gallery:SemanticPartPreview Name="SearchEditSemanticPreview"
                                                     Title="SearchEdit"
                                                     SemanticOwner="{Binding #SearchEditSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:SearchEdit}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:SearchEdit Name="SearchEditSemanticOwner"
                                                 Text="Hello, AtomUI"
                                                 InnerLeftContent="{antdicons:AntDesignIconProvider Kind=UserOutlined}"
                                                 IsAllowClear="True"
                                                 SearchButtonStyle="Primary"
                                                 SearchButtonText="Searching..."
                                                 IsOperating="True" />
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticSearchRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="prefix"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticSearchPrefixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="input"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticSearchInputDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="suffix"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticSearchSuffixDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="clear"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticSearchClearDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="button"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticSearchButtonDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <gallery:SemanticPartPreview Name="OtpSemanticPreview"
                                                     Title="OtpLineEdit"
                                                     SemanticOwner="{Binding #OtpSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:OtpLineEdit}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:OtpLineEdit Name="OtpSemanticOwner"
                                                  Length="6"
                                                  Separator="-" />
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticOtpRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="cellList"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticOtpCellListDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="cell"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticOtpCellDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="separator"
                                    Description="{gallery:LineEditShowCaseLangResource SemanticOtpSeparatorDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource BasicUsageTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource BasicUsageDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextBasicUsage}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource TextBoxTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource TextBoxDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
                <StackPanel Orientation="Vertical" Spacing="10">
                    <atom:TextBox PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextTextBox}"
                                  Width="360"
                                  HorizontalAlignment="Left" />
                    <atom:TextBox PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputWithClearIcon}"
                                  Width="360"
                                  Text="{gallery:LineEditShowCaseLangResource P2TextMysite}"
                                  IsAllowClear="True"
                                  HorizontalAlignment="Left" />
                    <atom:TextBox PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputPassword}"
                                  Width="360"
                                  RevealPassword="False"
                                  PasswordChar="•"
                                  IsEnableRevealButton="True"
                                  IsAllowClear="True"
                                  HorizontalAlignment="Left" />
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource InputSizesTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource InputSizesDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextLarge}" SizeType="Large"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=UserOutlined}" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextMiddle}" SizeType="Middle"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=UserOutlined}" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextSmall}" SizeType="Small"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=UserOutlined}" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextCustom}" SizeType="Custom"
                           Height="38" FontSize="15"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=UserOutlined}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource VariantsTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource VariantsDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleNormal}" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextOutlined}" StyleVariant="Outlined" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextFilled}" StyleVariant="Filled" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextBorderless}" StyleVariant="Borderless" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextUnderlined}" StyleVariant="Underlined" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextFilled}" StyleVariant="Filled" />
            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleLeftaddonAndRightaddon}" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Filled" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Borderless" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Underlined" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource PrePostTabTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource PrePostTabDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Width="400" HorizontalAlignment="Left"
                           Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" />
            <atom:LineEdit RightAddOn="{antdicons:AntDesignIconProvider Kind=SettingOutlined}" Width="400"
                           HorizontalAlignment="Left"
                           Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" />
            <atom:LineEdit LeftAddOn="http://" InnerRightContent=".com" Width="400" HorizontalAlignment="Left"
                           Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource WithClearIconTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource WithClearIconDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputWithClearIcon}" IsAllowClear="True" />
            <atom:TextArea PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextTextareaWithClearIcon}" IsAllowClear="True" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource PasswordBoxTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource PasswordBoxDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputPassword}"
                           Width="400"
                           RevealPassword="False"
                           PasswordChar="•"
                           HorizontalAlignment="Left"
                           IsEnableRevealButton="True" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputPassword}"
                           Width="400"
                           RevealPassword="False"
                           HorizontalAlignment="Left"
                           PasswordChar="•"
                           IsEnableRevealButton="True"
                           IsAllowClear="True" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource OtpLineEditTwoWayBindingTitle}"
        Description="{gallery:LineEditShowCaseLangResource OtpLineEditTwoWayBindingDescription}"
        SourceKey="line-edit-otp-two-way"
        BadgeText="v6.0.8"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel HorizontalAlignment="Left" Spacing="12">
            <atom:OtpLineEdit Text="{Binding OtpLineEditBoundValue, Mode=TwoWay}"
                              InputMode="Numeric" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <atom:Button SizeType="Small"
                             Content="{gallery:LineEditShowCaseLangResource OtpLineEditSetValueButtonText}"
                             Command="{Binding SetOtpLineEditBoundValueCommand}" />
                <atom:Button SizeType="Small"
                             Content="{gallery:LineEditShowCaseLangResource OtpLineEditClearButtonText}"
                             Command="{Binding ClearOtpLineEditBoundValueCommand}" />
            </StackPanel>
            <atom:TextBlock Text="{Binding OtpLineEditBoundValueSummary}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource OtpLineEditFormTitle}"
        Description="{gallery:LineEditShowCaseLangResource OtpLineEditFormDescription}"
        SourceKey="line-edit-otp-form"
        BadgeText="v6.0.8"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="480"
                   HorizontalAlignment="Left">
            <atom:FormItem LabelText="{gallery:LineEditShowCaseLangResource OtpLineEditFormLabelCode}"
                           FieldName="otp">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:LineEditShowCaseLangResource OtpLineEditFormValidationMessage}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:OtpLineEdit Length="6"
                                  InputMode="Numeric"
                                  PlaceholderText="000000" />
            </atom:FormItem>
            <atom:FormActionsItem>
                <atom:SubmitButton />
            </atom:FormActionsItem>
        </atom:Form>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource OtpLineEditAntDesignTitle}"
        Description="{gallery:LineEditShowCaseLangResource OtpLineEditAntDesignDescription}"
        SourceKey="line-edit-otp-ant-design"
        BadgeText="v6.0.8"
        DeferredPlaceholderHeight="760"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Left"
                    Spacing="28">
            <StackPanel Orientation="Vertical" Spacing="14">
                <atom:TextBlock Text="With formatter (Upcase)"
                                FontSize="16"
                                FontWeight="SemiBold" />
                <atom:OtpLineEdit Formatter="{Binding OtpLineEditUppercaseFormatter}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Spacing="14">
                <atom:TextBlock Text="With Disabled"
                                FontSize="16"
                                FontWeight="SemiBold" />
                <atom:OtpLineEdit IsEnabled="False" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Spacing="14">
                <atom:TextBlock Text="With Length (8)"
                                FontSize="16"
                                FontWeight="SemiBold" />
                <atom:OtpLineEdit Length="8" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Spacing="14">
                <atom:TextBlock Text="With variant"
                                FontSize="16"
                                FontWeight="SemiBold" />
                <atom:OtpLineEdit StyleVariant="Filled" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Spacing="14">
                <atom:TextBlock Text="With custom display character"
                                FontSize="16"
                                FontWeight="SemiBold" />
                <atom:OtpLineEdit IsMasked="True"
                                  MaskChar="●" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Spacing="14">
                <atom:TextBlock Text="With custom separator"
                                FontSize="16"
                                FontWeight="SemiBold" />
                <atom:OtpLineEdit Separator="/" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Spacing="14">
                <atom:TextBlock Text="With custom function separator"
                                FontSize="16"
                                FontWeight="SemiBold" />
                <atom:OtpLineEdit Separator="—">
                    <atom:OtpLineEdit.SeparatorTemplate>
                        <DataTemplate x:DataType="atom:OtpLineEditSeparatorContext">
                            <TextBlock Text="{Binding Content}"
                                       Foreground="{Binding CellIndex, Converter={StaticResource OtpLineEditSeparatorBrushConverter}}" />
                        </DataTemplate>
                    </atom:OtpLineEdit.SeparatorTemplate>
                </atom:OtpLineEdit>
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource PrefixAndSuffixTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource PrefixAndSuffixDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextEnterYourUsername}"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=UserOutlined, StrokeBrush=#D7D7D7}">
                <atom:LineEdit.InnerRightContentTemplate>
                    <DataTemplate>
                        <antdicons:InfoCircleOutlined
                            StrokeBrush="#8C8C8C"
                            VerticalAlignment="Center"
                            atom:ToolTip.Tip="{gallery:LineEditShowCaseLangResource PrefixAndSuffixToolTip}" />
                    </DataTemplate>
                </atom:LineEdit.InnerRightContentTemplate>
            </atom:LineEdit>
            <atom:LineEdit InnerLeftContent="￥" InnerRightContent="RMB" />
            <atom:LineEdit InnerLeftContent="￥" InnerRightContent="RMB" IsEnabled="False" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource DisabledTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource DisabledDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleNormal}" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextOutlined}" StyleVariant="Outlined" IsEnabled="False" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextFilled}" StyleVariant="Filled" IsEnabled="False" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextBorderless}" StyleVariant="Borderless" IsEnabled="False" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextUnderlined}" StyleVariant="Underlined" IsEnabled="False" />

            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextOutlined}" StyleVariant="Outlined" Status="Error" IsEnabled="False" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextFilled}" StyleVariant="Filled" Status="Error" IsEnabled="False" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextBorderless}" StyleVariant="Borderless" Status="Error" IsEnabled="False" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextUnderlined}" StyleVariant="Underlined" Status="Error" IsEnabled="False" />

            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleLeftaddonAndRightaddon}" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" Status="Error" IsEnabled="False" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Filled" Status="Error"
                           IsEnabled="False" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Borderless"
                           Status="Error" IsEnabled="False" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Underlined"
                           Status="Error" IsEnabled="False" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource InputStatusTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource InputStatusDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleNormal}" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextError}" Status="Error" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextWarning}" Status="Warning" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextErrorWithPrefix}"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}" Status="Error" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextWarningWithPrefix}"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}" Status="Warning" />

            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextError}" Status="Error"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}" StyleVariant="Filled" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextWarning}" Status="Warning"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}" StyleVariant="Filled" />

            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextError}" Status="Error"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                           StyleVariant="Borderless" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextWarning}" Status="Warning"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                           StyleVariant="Borderless" />

            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextError}" Status="Error"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                           StyleVariant="Underlined" />
            <atom:LineEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextWarning}" Status="Warning"
                           InnerLeftContent="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                           StyleVariant="Underlined" />

            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleLeftaddonAndRightaddon}" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" Status="Error" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Filled" Status="Error" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Borderless"
                           Status="Error" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Underlined"
                           Status="Error" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" Status="Warning" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Filled"
                           Status="Warning" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Borderless"
                           Status="Warning" />
            <atom:LineEdit LeftAddOn="http://" RightAddOn=".com" Text="{gallery:LineEditShowCaseLangResource P2TextMysite}" StyleVariant="Underlined"
                           Status="Warning" />

            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleSearch}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}"
                             Width="400"
                             HorizontalAlignment="Left"
                             LeftAddOn="https://"
                             StyleVariant="Outlined"
                             Status="Error" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             LeftAddOn="https://" StyleVariant="Outlined" Status="Warning" />

            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             LeftAddOn="https://" StyleVariant="Outlined" Status="Error"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             LeftAddOn="https://" StyleVariant="Outlined" Status="Warning"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />

            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             LeftAddOn="https://" StyleVariant="Filled" Status="Error" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             LeftAddOn="https://" StyleVariant="Filled" Status="Warning" />

            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             LeftAddOn="https://" StyleVariant="Filled" Status="Error"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             LeftAddOn="https://" StyleVariant="Filled" Status="Warning"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource SearchBoxTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource SearchBoxDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleSearch}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch" SizeType="Large" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />

            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch"
                             SearchButtonStyle="Primary" SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch"
                             SearchButtonStyle="Primary" SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />

            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}"
                             HorizontalAlignment="Stretch"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}"
                             IsAllowClear="True" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}"
                             HorizontalAlignment="Stretch"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextText}"
                             InnerRightContent="{antdicons:AntDesignIconProvider Kind=AudioOutlined, StrokeBrush=#1677ff, Width=16, Height=16}"
                             IsAllowClear="True"
                             SizeType="Large" />
            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleFilled}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}"
                             LeftAddOn="https://"
                             StyleVariant="Filled" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch"
                             LeftAddOn="https://"
                             StyleVariant="Filled" />
            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleBorderless}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}"
                             LeftAddOn="https://"
                             StyleVariant="Borderless" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch"
                             LeftAddOn="https://"
                             StyleVariant="Borderless" />
            <atom:Separator Title="{gallery:LineEditShowCaseLangResource P2TitleUnderlined}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}"
                             LeftAddOn="https://"
                             StyleVariant="Underlined" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" HorizontalAlignment="Stretch"
                             LeftAddOn="https://"
                             StyleVariant="Underlined" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource SearchEditSizeTypeTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource SearchEditSizeTypeDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextLarge}"
                             Width="360"
                             HorizontalAlignment="Left"
                             SizeType="Large"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextMiddle}"
                             Width="360"
                             HorizontalAlignment="Left"
                             SizeType="Middle"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextSmall}"
                             Width="360"
                             HorizontalAlignment="Left"
                             SizeType="Small"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />
            <atom:SearchEdit Name="CustomSizeTypeSearchEdit"
                             PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextCustom}"
                             Width="360"
                             HorizontalAlignment="Left"
                             SizeType="Custom"
                             Height="38"
                             FontSize="15"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource DisabledSearchBoxTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource DisabledSearchBoxDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left" SizeType="Large"
                             IsEnabled="False" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" IsEnabled="False" />

            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             SearchButtonStyle="Primary" SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" IsEnabled="False" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}" Width="400" HorizontalAlignment="Left"
                             SearchButtonStyle="Primary" SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}" IsEnabled="False" />

            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}"
                             Width="400"
                             HorizontalAlignment="Left"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}"
                             IsAllowClear="True" IsEnabled="False" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}"
                             Width="400"
                             HorizontalAlignment="Left"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextText}"
                             IsAllowClear="True"
                             SizeType="Large" IsEnabled="False">
                <atom:SearchEdit.InnerRightContent>
                    <antdicons:AudioOutlined Width="16" Height="16" Name="AudioOutlined">
                        <antdicons:AudioOutlined.Styles>
                            <Style Selector="atom|Icon#AudioOutlined">
                                <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorPrimary}"/>
                            </Style>
                        </antdicons:AudioOutlined.Styles>
                    </antdicons:AudioOutlined>
                </atom:SearchEdit.InnerRightContent>
            </atom:SearchEdit>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource SearchBoxWithLoadingTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource SearchBoxWithLoadingDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchLoadingDefault}"
                             Width="400"
                             IsOperating="True"
                             HorizontalAlignment="Left" />
            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchLoadingWithEnterbutton}" Width="400"
                             HorizontalAlignment="Left"
                             IsOperating="True"
                             SearchButtonStyle="Primary" />

            <atom:SearchEdit PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextInputSearchText}"
                             Width="400"
                             IsOperating="True"
                             HorizontalAlignment="Left"
                             SearchButtonStyle="Primary"
                             SearchButtonText="{gallery:LineEditShowCaseLangResource P2SearchButtonTextSearch}"
                             SizeType="Large" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource TextAreaTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource TextAreaDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:TextArea Lines="4" />
            <atom:TextArea Lines="4" PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextMaxlengthIsN6}" MaxLength="6" />
            <atom:TextArea Lines="4" PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextMaxlengthIsN6}" MaxLength="6" StyleVariant="Filled" />
            <atom:TextArea Lines="4" PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextDisabled}" MaxLength="6" IsEnabled="False" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource AutoSizeTextAreaTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource AutoSizeTextAreaDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:TextArea PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextAutosizeHeightBasedOnContentLines}" IsAutoSize="True" />
            <atom:TextArea PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextAutosizeHeightWithMinimumAndMaximumNumberOf}" MinLines="3"
                           MaxLines="6" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource CharacterCountingTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource CharacterCountingDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:LineEdit IsShowCount="True" MaxLength="20" />
            <atom:TextArea IsShowCount="True" MaxLength="100" PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextCanResize}" IsResizable="True" />
            <atom:TextArea IsShowCount="True" MaxLength="100" PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextDisableResize}" Height="120"
                           IsResizable="False" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource TextAreaStatusTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:LineEditShowCaseLangResource TextAreaStatusDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:TextArea IsShowCount="True" MaxLength="100" PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextError}" IsResizable="True" Status="Error" />
            <atom:TextArea IsShowCount="True" MaxLength="100" PlaceholderText="{gallery:LineEditShowCaseLangResource P2PlaceholderTextWarning}" IsResizable="True" Status="Warning"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:LineEditShowCaseLangResource SemanticPartStyleTitle}"
        Description="{gallery:LineEditShowCaseLangResource SemanticPartStyleDescription}"
        SourceKey="line-edit-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:LineEditViewModel">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="24">
                    <StackPanel.Styles>
                        <Style Selector="atom|LineEdit.style-class-base">
                            <Setter Property="Width" Value="320" />
                        </Style>
                        <Style Selector="atom|LineEdit.style-class-object">
                            <Setter Property="Width" Value="320" />
                            <Setter Property="BorderBrush" Value="#D9D9D9" />
                        </Style>
                        <Style Selector="atom|LineEdit.style-class-object:focus-within">
                            <Setter Property="BorderBrush" Value="#A9A9A9" />
                        </Style>
                        <Style Selector="atom|LineEdit.style-class-fn">
                            <Setter Property="BorderBrush" Value="#696FC7" />
                        </Style>
                        <Style Selector="atom|TextArea.style-class-textarea">
                            <Setter Property="Width" Value="320" />
                            <Setter Property="BorderBrush" Value="#BDE3C3" />
                            <atom:TextAreaCountStyle x:SetterTargetType="TextBlock">
                                <Setter Property="Foreground" Value="#BDE3C3" />
                            </atom:TextAreaCountStyle>
                        </Style>
                        <Style Selector="atom|LineEdit.style-class-password">
                            <Setter Property="BorderBrush" Value="#F5D3C4" />
                        </Style>
                        <Style Selector="atom|OtpLineEdit.style-class-otp">
                            <Setter Property="CellWidth" Value="32" />
                            <Setter Property="CellBorderBrush" Value="#6E8CFB" />
                        </Style>
                        <Style Selector="atom|SearchEdit.style-class-search">
                            <Setter Property="Width" Value="320" />
                            <Setter Property="Foreground" Value="#4DA8DA" />
                            <Setter Property="BorderBrush" Value="#4DA8DA" />
                            <Setter Property="CaretBrush" Value="#4DA8DA" />
                            <atom:SearchEditInputStyle x:SetterTargetType="TextPresenter">
                                <Setter Property="TextElement.Foreground" Value="#4DA8DA" />
                            </atom:SearchEditInputStyle>
                            <atom:SearchEditButtonStyle x:SetterTargetType="atom:Button">
                                <Setter Property="Foreground" Value="#4DA8DA" />
                                <Setter Property="BorderBrush" Value="#4DA8DA" />
                            </atom:SearchEditButtonStyle>
                        </Style>
                    </StackPanel.Styles>

                    <atom:LineEdit
                        Classes="style-class-base style-class-object"
                        PlaceholderText="Object" />

                    <atom:LineEdit
                        Classes="style-class-base style-class-fn"
                        PlaceholderText="Function"
                        SizeType="Middle" />

                    <atom:TextArea
                        Classes="style-class-textarea"
                        Text="TextArea"
                        IsShowCount="True"
                        MaxLength="100"
                        IsResizable="False" />

                    <atom:LineEdit
                        Classes="style-class-base style-class-password"
                        Text="Password"
                        RevealPassword="False"
                        PasswordChar="•"
                        IsEnableRevealButton="True"
                        SizeType="Middle" />

                    <atom:OtpLineEdit
                        Classes="style-class-otp"
                        Length="6"
                        Separator="*" />

                    <atom:SearchEdit
                        Classes="style-class-search"
                        PlaceholderText="Search"
                        SizeType="Large" />
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
