<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomcommons="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:DotBadge}" TargetType="atom:DotBadge">
        <Setter Property="TextElement.FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="TextElement.FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type atom:DotBadgeAdorner}" TargetType="atom:DotBadgeAdorner">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel
                    Name="RootLayout"
                    LastChildFill="True"
                    ClipToBounds="False">
                    <Border
                        Name="PART_IndicatorSurface"
                        ClipToBounds="False"
                        DockPanel.Dock="Left">
                        <atomcommons:DotBadgeIndicator
                            Name="Indicator"
                            Classes.semantic-indicator="True"
                            BadgeDotColor="{TemplateBinding BadgeDotColor}" />
                    </Border>
                    <Label Name="Label"
                           Content="{TemplateBinding Text}"
                           IsVisible="{TemplateBinding IsAdornerMode, Converter={x:Static BoolConverters.Not}}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="BadgeDotColor" Value="{atom:DotBadgeTokenResource DotColor}" />
        <Setter Property="MotionDuration" Value="{atom:DotBadgeTokenResource MotionDurationMid}" />

        <Style Selector="^[IsAdornerMode=True]">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel
                        Name="RootLayout"
                        LastChildFill="True"
                        ClipToBounds="False">
                        <Border
                            Name="PART_IndicatorSurface"
                            ClipToBounds="False"
                            DockPanel.Dock="Left">
                            <atomcommons:DotBadgeIndicator
                                Name="Indicator"
                                Classes.semantic-indicator="True"
                                BadgeDotColor="{TemplateBinding BadgeDotColor}" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^ /template/ DockPanel#RootLayout">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^ /template/ Label#Label">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="{atom:DotBadgeTokenResource LabelMargin}" />
        </Style>
        
        <Style Selector="^ /template/ atomcommons|DotBadgeIndicator#Indicator">
            <Setter Property="Width" Value="{atom:DotBadgeTokenResource DotSize}" />
            <Setter Property="Height" Value="{atom:DotBadgeTokenResource DotSize}" />
        </Style>
        
        <Style Selector="^[Status=Error]">
            <Setter Property="BadgeDotColor" Value="{atom:OwnerTokenResource ColorError}" />
        </Style>
             
        <Style Selector="^[Status=Success]">
            <Setter Property="BadgeDotColor" Value="{atom:OwnerTokenResource ColorSuccess}" />
        </Style>
             
        <Style Selector="^[Status=Warning]">
            <Setter Property="BadgeDotColor" Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>
             
        <Style Selector="^[Status=Processing]">
            <Setter Property="BadgeDotColor" Value="{atom:OwnerTokenResource ColorInfo}" />
        </Style>
        
        <Style Selector="^[Status=Default]">
            <Setter Property="BadgeDotColor" Value="{atom:OwnerTokenResource ColorTextPlaceholder}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
