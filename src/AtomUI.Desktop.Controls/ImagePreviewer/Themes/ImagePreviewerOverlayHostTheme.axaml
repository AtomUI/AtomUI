<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImagePreviewerOverlayHost}"
                  TargetType="atom:ImagePreviewerOverlayHost">
        <Setter Property="ImageScaleX" Value="1.0" />
        <Setter Property="ImageScaleY" Value="1.0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Classes.semantic-popup-root="True">
                    <Panel Classes.semantic-popup-mask="True"
                           Background="{CompiledBinding $self.(atom:ImageViewer.ThemeColorBgMask)}" />
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                    <atom:IconButton Name="PART_CloseButton"
                                     Icon="{antdicons:AntDesignIconProvider CloseOutlined}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="{CompiledBinding $self.(atom:ImageViewer.ThemeMarginSM)}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ atom|IconButton#PART_CloseButton">
            <Setter Property="IconWidth" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePreviewOperationSize)}" />
            <Setter Property="IconHeight" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePreviewOperationSize)}" />
            <Setter Property="IconBrush" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePreviewOperationColor)}" />
            <Setter Property="Background" Value="{CompiledBinding $self.(atom:ImageViewer.ThemeNavButtonBgColor)}" />
            <!-- layout: a radius beyond half the size makes the close button round -->
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Padding" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePaddingSM)}" />
        </Style>
        <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pointerover, ^ /template/ atom|IconButton#PART_CloseButton:pressed">
            <Setter Property="Background" Value="{CompiledBinding $self.(atom:ImageViewer.ThemeNavButtonBgHoverColor)}" />
            <Setter Property="IconBrush" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePreviewOperationHoverColor)}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
