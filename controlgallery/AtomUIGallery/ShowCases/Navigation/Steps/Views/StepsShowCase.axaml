<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Steps.StepsShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Steps"
             x:DataType="vm:StepsViewModel"
             x:CompileBindings="True"
             x:Name="StepsInteractiveShowCaseName">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Steps"
                    Category="{gallery:StepsShowCaseLangResource ComponentCategory}"
                    Status="{gallery:StepsShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:StepsShowCaseLangResource PageSubtitle}"
                    Description="{gallery:StepsShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="ItemsControl" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:StepsViewModel">
                    <StackPanel Spacing="24">
                        <gallery:SemanticPartPreview Name="StepsSemanticPreview"
                                                     SemanticOwner="{Binding #StepsSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:Steps}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <StackPanel Spacing="24">
                                    <atom:Steps Name="StepsSemanticOwner"
                                                Current="1"
                                                TitlePlacement="Vertical"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderTimeN1}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                        <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderTimeN2}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                        <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderTimeN3}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                    </atom:Steps>
                                    <atom:Steps Current="1" Type="Panel">
                                        <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderTimeN1}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                        <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderTimeN2}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                        <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderTimeN3}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                    </atom:Steps>
                                </StackPanel>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:StepsShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="item"
                                    Description="{gallery:StepsShowCaseLangResource SemanticItemDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemWrapper"
                                    Description="{gallery:StepsShowCaseLangResource SemanticItemWrapperDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemIcon"
                                    Description="{gallery:StepsShowCaseLangResource SemanticItemIconDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemTitle"
                                    Description="{gallery:StepsShowCaseLangResource SemanticItemTitleDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemSubtitle"
                                    Description="{gallery:StepsShowCaseLangResource SemanticItemSubtitleDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemSection"
                                    Description="{gallery:StepsShowCaseLangResource SemanticItemSectionDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemContent"
                                    Description="{gallery:StepsShowCaseLangResource SemanticItemContentDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="itemRail"
                                    Description="{gallery:StepsShowCaseLangResource SemanticItemRailDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    SourceKey="steps-basic"
                    Title="{gallery:StepsShowCaseLangResource BasicTitle}"
                    Description="{gallery:StepsShowCaseLangResource BasicDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <atom:Steps Current="0">
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                            </atom:Steps>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-small"
                    Title="{gallery:StepsShowCaseLangResource MiniVersionTitle}"
                    Description="{gallery:StepsShowCaseLangResource MiniVersionDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <atom:Steps Current="0" SizeType="Small">
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                            </atom:Steps>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-icon"
                    Title="{gallery:StepsShowCaseLangResource WithIconTitle}"
                    Description="{gallery:StepsShowCaseLangResource WithIconDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <atom:Steps Current="0">
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderLogin}" Status="Finish" Icon="{antdicons:AntDesignIconProvider Kind=UserOutlined}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderVerification}" Status="Finish" Icon="{antdicons:AntDesignIconProvider Kind=SolutionOutlined}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderPay}" Status="Process"
                                                Icon="{antdicons:AntDesignIconProvider Kind=LoadingOutlined, Animation=Spin}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderDone}" Status="Wait" Icon="{antdicons:AntDesignIconProvider Kind=SmileOutlined}" />
                            </atom:Steps>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-controlled"
                    Title="{gallery:StepsShowCaseLangResource SwitchStepTitle}"
                    Description="{gallery:StepsShowCaseLangResource SwitchStepDescription}"
                    BadgeText="v6.0.8"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Steps Current="{Binding Current}"
                                            IsItemClickable="True"
                                            CurrentChangeRequested="HandleCurrentChangeRequested">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFirst}" Content="{gallery:StepsShowCaseLangResource P2ContentFirstContent}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderSecond}" Content="{gallery:StepsShowCaseLangResource P2ContentSecondContent}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderThird}" Content="{gallery:StepsShowCaseLangResource P2ContentLastContent}" />
                                </atom:Steps>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <atom:TextBlock VerticalAlignment="Center"
                                                    Text="{gallery:StepsShowCaseLangResource P2TextCurrent}" />
                                    <atom:TextBlock VerticalAlignment="Center"
                                                    Text="{Binding CurrentText}" />
                                </StackPanel>
                                <atom:DashedBorder BorderThickness="1"
                                                   BorderBrush="{atom:SharedTokenResource ColorBorder}"
                                                   StrokeDashArray="{Binding DashedArray, RelativeSource={RelativeSource AncestorType=vm:StepsShowCase}}"
                                                   CornerRadius="{atom:SharedTokenResource BorderRadiusLG}"
                                                   Background="{atom:SharedTokenResource ColorFillAlter}"
                                                   TextElement.Foreground="{atom:SharedTokenResource ColorTextTertiary}"
                                                   Height="260">
                                    <atom:TextBlock Text="{Binding InteractivePageContent}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                </atom:DashedBorder>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button ButtonType="Primary" Content="{Binding NextButtonText}" Name="NextStepButton" Click="HandleNextButtonClick" />
                                    <atom:Button ButtonType="Default" Content="{gallery:StepsShowCaseLangResource P2ContentPrevious}" Name="PreviousButton" Click="HandlePreviousButtonClick"
                                                 IsVisible="{Binding PreviousButtonVisible}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-vertical"
                    Title="{gallery:StepsShowCaseLangResource VerticalTitle}"
                    Description="{gallery:StepsShowCaseLangResource VerticalDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <atom:Steps Current="1" Orientation="Vertical">
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                            </atom:Steps>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-vertical-small"
                    Title="{gallery:StepsShowCaseLangResource VerticalMiniVersionTitle}"
                    Description="{gallery:StepsShowCaseLangResource VerticalMiniVersionDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <atom:Steps Current="1" Orientation="Vertical" SizeType="Small">
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                            </atom:Steps>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-error"
                    Title="{gallery:StepsShowCaseLangResource ErrorStatusTitle}"
                    Description="{gallery:StepsShowCaseLangResource ErrorStatusDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <atom:Steps Current="1" Status="Error">
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                            </atom:Steps>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-dot"
                    Title="{gallery:StepsShowCaseLangResource DotStyleTitle}"
                    Description="{gallery:StepsShowCaseLangResource DotStyleDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Steps Current="1" Type="Dot">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="1" Type="OutlineDot">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-dot-vertical"
                    Title="{gallery:StepsShowCaseLangResource DotStyleVerticalTitle}"
                    Description="{gallery:StepsShowCaseLangResource DotStyleVerticalDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Steps Current="1" Type="Dot" Orientation="Vertical">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="1" Type="Dot" Orientation="Vertical" SizeType="Small">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="1" Type="OutlineDot" Orientation="Vertical">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-clickable"
                    Title="{gallery:StepsShowCaseLangResource ClickableTitle}"
                    Description="{gallery:StepsShowCaseLangResource ClickableDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Steps Current="0" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="0" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested" Orientation="Vertical">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="0" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested" Type="Dot">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN4}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="0" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested" Type="Dot" Orientation="Vertical">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN4}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-navigation"
                    Title="{gallery:StepsShowCaseLangResource NavigationStepsTitle}"
                    Description="{gallery:StepsShowCaseLangResource NavigationStepsDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Steps Current="0" Type="Navigation" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested" SizeType="Small">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="00:00:05" Status="Finish"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="00:01:02" Status="Process"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderWaitingForLongTime}" Status="Wait"/>
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="0" Type="Navigation" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Status="Finish"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Status="Process"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Status="Wait"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN4}" Status="Wait"/>
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="0" Type="Navigation" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested" SizeType="Small">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinishN1}" Status="Finish"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinishN2}" Status="Finish"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderCurrentProcess}" Status="Process"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWait}" Status="Wait" IsEnabled="False"/>
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="0" Type="Navigation" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested" Orientation="Vertical">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="00:00:05" Status="Finish"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="10:00:05" Status="Process"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="00:30:05" Status="Wait"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN4}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderWaitingForLongTime}" Status="Wait"/>
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="0" Type="Navigation" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested" Orientation="Vertical" SizeType="Small">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="00:00:05" Status="Finish"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="10:00:05" Status="Process"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="00:30:05" Status="Wait"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN4}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderWaitingForLongTime}" Status="Wait"/>
                                </atom:Steps>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-panel"
                    Title="{gallery:StepsShowCaseLangResource PanelStepsTitle}"
                    Description="{gallery:StepsShowCaseLangResource PanelStepsDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Steps Current="0" Type="Panel" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested">
                                    <atom:StepsItem Header="Step 1" SubHeader="00:00" Content="This is a content." />
                                    <atom:StepsItem Header="Step 2" Content="This is a content." Status="Error" />
                                    <atom:StepsItem Header="Step 3" Content="This is a content." />
                                </atom:Steps>
                                <atom:Steps Current="0" Type="Panel" PanelVariant="Outlined" SizeType="Small" IsItemClickable="True" CurrentChangeRequested="HandleLocalCurrentChangeRequested">
                                    <atom:StepsItem Header="Step 1" SubHeader="00:00" Content="This is a content." />
                                    <atom:StepsItem Header="Step 2" Content="This is a content." Status="Error" />
                                    <atom:StepsItem Header="Step 3" Content="This is a content." />
                                </atom:Steps>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-progress"
                    Title="{gallery:StepsShowCaseLangResource StepsWithProgressTitle}"
                    Description="{gallery:StepsShowCaseLangResource StepsWithProgressDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Steps Current="1" Percent="60">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                                <atom:Separator/>
                                <atom:Steps Current="1" Percent="30" SizeType="Small">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-title-placement"
                    Title="{gallery:StepsShowCaseLangResource TitlePlacementTitle}"
                    Description="{gallery:StepsShowCaseLangResource TitlePlacementDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Steps Current="1" TitlePlacement="Vertical">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                                <atom:Separator />
                                <atom:Steps Current="1" TitlePlacement="Vertical" Percent="45">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                                <atom:Separator />
                                <atom:Steps Current="1" TitlePlacement="Vertical" Percent="45" SizeType="Small">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderLeftTime}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2DescriptionThisIsADescription}" />
                                </atom:Steps>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-inline"
                    Title="{gallery:StepsShowCaseLangResource InlineStepsTitle}"
                    Description="{gallery:StepsShowCaseLangResource InlineStepsDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel>
                                <Grid RowDefinitions="Auto,Auto">
                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                        <atom:Steps Current="0" DockPanel.Dock="Right" Type="Inline">
                                            <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN1}"/>
                                            <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN2}"/>
                                            <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN3}"/>
                                        </atom:Steps>
                                        <StackPanel Orientation="Vertical" Spacing="10">
                                            <TextBlock FontWeight="Bold" Text="{gallery:StepsShowCaseLangResource P2TextAntDesignTitleN1}" />
                                            <TextBlock Foreground="{atom:SharedTokenResource ColorTextTertiary}" Text="{gallery:StepsShowCaseLangResource P2TextAntDesignADesignLanguageForBackgroundApplications}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <atom:Separator Grid.Row="1" Margin="0,10,0,0"/>
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto">
                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                        <atom:Steps Current="1" DockPanel.Dock="Right" Type="Inline" Status="Error">
                                            <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN1}"/>
                                            <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN2}"/>
                                            <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN3}"/>
                                        </atom:Steps>
                                        <StackPanel Orientation="Vertical" Spacing="10">
                                            <TextBlock FontWeight="Bold" Text="{gallery:StepsShowCaseLangResource P2TextAntDesignTitleN2}" />
                                            <TextBlock Foreground="{atom:SharedTokenResource ColorTextTertiary}" Text="{gallery:StepsShowCaseLangResource P2TextAntDesignADesignLanguageForBackgroundApplications}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <atom:Separator Grid.Row="1" Margin="0,10,0,0"/>
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto">
                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                        <atom:Steps Current="2" DockPanel.Dock="Right" Type="Inline">
                                            <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN1}"/>
                                            <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN2}"/>
                                            <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN3}"/>
                                        </atom:Steps>
                                        <StackPanel Orientation="Vertical" Spacing="10">
                                            <TextBlock FontWeight="Bold" Text="{gallery:StepsShowCaseLangResource P2TextAntDesignTitleN3}" />
                                            <TextBlock Foreground="{atom:SharedTokenResource ColorTextTertiary}" Text="{gallery:StepsShowCaseLangResource P2TextAntDesignADesignLanguageForBackgroundApplications}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <atom:Separator Grid.Row="1" Margin="0,10,0,0"/>
                                </Grid>
                                <DockPanel LastChildFill="True">
                                    <atom:Steps Current="1" DockPanel.Dock="Right" Type="Inline">
                                        <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN1}"/>
                                        <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN2}"/>
                                        <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN3}"/>
                                    </atom:Steps>
                                    <StackPanel Orientation="Vertical" Spacing="10">
                                        <TextBlock FontWeight="Bold" Text="{gallery:StepsShowCaseLangResource P2TextAntDesignTitleN4}" />
                                        <TextBlock Foreground="{atom:SharedTokenResource ColorTextTertiary}" Text="{gallery:StepsShowCaseLangResource P2TextAntDesignADesignLanguageForBackgroundApplications}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="steps-inline-style-combination"
                    Title="{gallery:StepsShowCaseLangResource InlineStyleCombinationTitle}"
                    Description="{gallery:StepsShowCaseLangResource InlineStyleCombinationDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="18">
                                <atom:Steps Current="1" Type="Inline">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN1}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN2}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN3}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN4}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN4}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN5}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN5}"/>
                                </atom:Steps>
                                <atom:Steps
                                    Current="4"
                                    Type="Inline"
                                    Status="Finish"
                                    ItemHeaderForeground="{atom:SharedTokenResource ColorPrimaryText}"
                                    ItemSubHeaderForeground="{atom:SharedTokenResource ColorPrimaryTextActive}"
                                    ItemRailBackground="{atom:SharedTokenResource ColorTextDisabled}">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN1}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN1}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN2}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN2}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN3}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN4}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN4}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN5}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN5}"/>
                                </atom:Steps>
                                <atom:Steps Current="1" Type="Inline" Offset="2">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN3}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN3}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN4}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN4}"/>
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderStepN5}" SubHeader="{gallery:StepsShowCaseLangResource P2SubHeaderSubTitle}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsStepN5}"/>
                                </atom:Steps>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
                <gallery:ShowCaseItem
                    SourceKey="steps-semantic-part"
                    Title="{gallery:StepsShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:StepsShowCaseLangResource SemanticPartStyleDescription}"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    IsOccupyEntireRow="True"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:StepsViewModel">
                            <StackPanel Orientation="Vertical" Spacing="16">
                                <StackPanel.Styles>
                                    <Style Selector="atom|Steps.semantic-style-demo-root">
                                        <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="BorderDashArray" Value="4,2" />
                                        <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
                                        <Setter Property="Padding" Value="{atom:SharedTokenResource Padding}" />
                                    </Style>
                                    <Style Selector="atom|Steps.semantic-style-demo-object">
                                        <atom:StepsItemIconStyle x:SetterTargetType="TemplatedControl">
                                            <Setter Property="CornerRadius" Value="10" />
                                        </atom:StepsItemIconStyle>
                                        <atom:StepsItemContentStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </atom:StepsItemContentStyle>
                                    </Style>
                                    <Style Selector="atom|Steps[Type=Navigation].semantic-style-demo-root">
                                        <Setter Property="BorderBrush" Value="#1890FF" />
                                    </Style>
                                </StackPanel.Styles>
                                <atom:Steps Current="1" Classes="semantic-style-demo-root semantic-style-demo-object">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                </atom:Steps>
                                <atom:Steps Current="1" Type="Navigation" Classes="semantic-style-demo-root">
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderFinished}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderInProgress}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                    <atom:StepsItem Header="{gallery:StepsShowCaseLangResource P2HeaderWaiting}" Content="{gallery:StepsShowCaseLangResource P2ContentThisIsAContent}" />
                                </atom:Steps>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
