<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AtomUIGallery.ShowCases.Badge"
             x:Class="AtomUIGallery.ShowCases.Badge.BadgeShowCase"
             x:DataType="vm:BadgeViewModel"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Badge"
                    Category="{gallery:BadgeShowCaseLangResource ComponentCategory}"
                    Status="{gallery:BadgeShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:BadgeShowCaseLangResource PageSubtitle}"
                    Description="{gallery:BadgeShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="CountBadge" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:BadgeViewModel">
                    <StackPanel>
                        <atom:TextBlock Margin="24,24,24,0"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="CountBadge" />
                        <gallery:SemanticPartPreview
                            Name="CountBadgeSemanticPreview"
                            SemanticOwnerType="{x:Type atom:CountBadge}"
                            Loaded="HandleCrossRootSemanticPreviewLoaded"
                            Unloaded="HandleCrossRootSemanticPreviewUnloaded">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:CountBadge Name="CountBadgeSemanticOwner"
                                                 Count="5"
                                                 IsMotionEnabled="False">
                                    <Border Width="96"
                                            Height="64"
                                            Background="{atom:SharedTokenResource ColorFillSecondary}"
                                            CornerRadius="6" />
                                </atom:CountBadge>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:BadgeShowCaseLangResource SemanticCountRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="indicator"
                                    Description="{gallery:BadgeShowCaseLangResource SemanticCountIndicatorDescription}"
                                    CodeSnippet="{x:Static vm:BadgeShowCase.CountIndicatorCodeSnippet}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <atom:TextBlock Margin="24,0,24,0"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="DotBadge" />
                        <gallery:SemanticPartPreview
                            Name="DotBadgeSemanticPreview"
                            SemanticOwnerType="{x:Type atom:DotBadge}"
                            Loaded="HandleCrossRootSemanticPreviewLoaded"
                            Unloaded="HandleCrossRootSemanticPreviewUnloaded">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:DotBadge Name="DotBadgeSemanticOwner"
                                               Status="Success"
                                               IsMotionEnabled="False">
                                    <Border Width="96"
                                            Height="64"
                                            Background="{atom:SharedTokenResource ColorFillSecondary}"
                                            CornerRadius="6" />
                                </atom:DotBadge>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:BadgeShowCaseLangResource SemanticDotRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="indicator"
                                    Description="{gallery:BadgeShowCaseLangResource SemanticDotIndicatorDescription}"
                                    CodeSnippet="{x:Static vm:BadgeShowCase.DotIndicatorCodeSnippet}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <atom:TextBlock Margin="24,0,24,0"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="RibbonBadge" />
                        <gallery:SemanticPartPreview
                            Name="RibbonBadgeSemanticPreview"
                            SemanticOwnerType="{x:Type atom:RibbonBadge}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:RibbonBadge Name="RibbonBadgeSemanticOwner"
                                                  Text="Semantic Part">
                                    <Border Width="180"
                                            Height="96"
                                            Background="{atom:SharedTokenResource ColorFillSecondary}"
                                            CornerRadius="6" />
                                </atom:RibbonBadge>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:BadgeShowCaseLangResource SemanticRibbonRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="indicator"
                                    Description="{gallery:BadgeShowCaseLangResource SemanticRibbonIndicatorDescription}"
                                    CodeSnippet="{x:Static vm:BadgeShowCase.RibbonIndicatorCodeSnippet}" />
                                <gallery:SemanticPartDescription
                                    Path="content"
                                    Description="{gallery:BadgeShowCaseLangResource SemanticRibbonContentDescription}"
                                    CodeSnippet="{x:Static vm:BadgeShowCase.RibbonContentCodeSnippet}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,28,28,28">
    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource BasicTitle}"
                          Description="{gallery:BadgeShowCaseLangResource BasicDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Orientation="Horizontal" Spacing="20">
            <atom:CountBadge Count="5">
                <Border Width="40"
                        Height="40"
                        Background="rgb(191,191,191)"
                        CornerRadius="8" />
            </atom:CountBadge>
            <atom:CountBadge Count="0" IsZeroVisible="True" BadgeColor="#52c41a">
                <Border Width="40"
                        Height="40"
                        Background="rgb(191,191,191)"
                        CornerRadius="8" />
            </atom:CountBadge>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource OverflowCountTitle}"
                          Description="{gallery:BadgeShowCaseLangResource OverflowCountDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Orientation="Horizontal" Spacing="20">
            <atom:CountBadge Count="99">
                <Border Width="40"
                        Height="40"
                        Background="rgb(191,191,191)"
                        CornerRadius="8" />
            </atom:CountBadge>
            <atom:CountBadge Count="100">
                <Border Width="40"
                        Height="40"
                        Background="rgb(191,191,191)"
                        CornerRadius="8" />
            </atom:CountBadge>
            <atom:CountBadge Count="99" OverflowCount="10">
                <Border Width="40"
                        Height="40"
                        Background="rgb(191,191,191)"
                        CornerRadius="8" />
            </atom:CountBadge>
            <atom:CountBadge Count="1000" OverflowCount="999">
                <Border Width="40"
                        Height="40"
                        Background="rgb(191,191,191)"
                        CornerRadius="8" />
            </atom:CountBadge>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource OffsetTitle}"
                          Description="{gallery:BadgeShowCaseLangResource OffsetDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Orientation="Horizontal" Spacing="20">
            <atom:CountBadge Count="5" Offset="10, 10">
                <Border Width="40"
                        Height="40"
                        Background="rgb(191,191,191)"
                        CornerRadius="8" />
            </atom:CountBadge>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource SizeTitle}" Description="{gallery:BadgeShowCaseLangResource SizeDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Orientation="Horizontal" Spacing="20">
            <atom:CountBadge Count="5">
                <Border Width="40"
                        Height="40"
                        Background="rgb(191,191,191)"
                        CornerRadius="8" />
            </atom:CountBadge>
            <atom:CountBadge Count="5" Size="Small">
                <Border Width="40"
                        Height="40"
                        Background="rgb(191,191,191)"
                        CornerRadius="8" />
            </atom:CountBadge>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource StandaloneTitle}" Description="{gallery:BadgeShowCaseLangResource StandaloneDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <atom:ToggleSwitch IsChecked="{Binding StandaloneSwitchChecked}" />
            <atom:CountBadge BadgeColor="#faad14"
                             Count="{Binding StandaloneBadgeCount1}"
                             IsZeroVisible="True" />
            <atom:CountBadge Count="{Binding StandaloneBadgeCount2}" />
            <atom:CountBadge BadgeColor="#52c41a" Count="{Binding StandaloneBadgeCount3}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource DynamicTitle}" Description="{gallery:BadgeShowCaseLangResource DynamicDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <atom:CountBadge Count="{Binding DynamicBadgeCount}" OverflowCount="99">
                    <Border Width="40"
                            Height="40"
                            Background="rgb(191,191,191)"
                            CornerRadius="8" />
                </atom:CountBadge>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                    <atom:Button Command="{Binding AddDynamicBadgeCount}" SizeType="Small" Content="{gallery:BadgeShowCaseLangResource P2ContentAdd}" />
                    <atom:Button Command="{Binding SubDynamicBadgeCount}" SizeType="Small" Content="{gallery:BadgeShowCaseLangResource P2ContentSub}" />
                    <atom:Button Command="{Binding RandomDynamicBadgeCount}" SizeType="Small" Content="{gallery:BadgeShowCaseLangResource P2ContentRandom}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="20">
                <atom:CountBadge BadgeIsVisible="{Binding DynamicDotBadgeVisible}" Count="9">
                    <Border Width="40"
                            Height="40"
                            Background="rgb(191,191,191)"
                            CornerRadius="8" />
                </atom:CountBadge>
                <atom:DotBadge BadgeIsVisible="{Binding DynamicDotBadgeVisible}">
                    <Border Width="40"
                            Height="40"
                            Background="rgb(191,191,191)"
                            CornerRadius="8" />
                </atom:DotBadge>
                <atom:ToggleSwitch VerticalAlignment="Center"
                                   IsChecked="{Binding DynamicDotBadgeVisible, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource RedBadgeTitle}"
                          Description="{gallery:BadgeShowCaseLangResource RedBadgeDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <StackPanel Orientation="Horizontal">
                <atom:DotBadge Offset="-7,8">
                    <atom:Button ButtonType="Link" Icon="{antdicons:AntDesignIconProvider Kind=NotificationOutlined}" />
                </atom:DotBadge>
                <atom:DotBadge Offset="-14,12">
                    <atom:Button ButtonType="Link" Content="{gallery:BadgeShowCaseLangResource P2ContentLinkSomething}" />
                </atom:DotBadge>
                <atom:Button ButtonType="Link" Content="{gallery:BadgeShowCaseLangResource P2ContentLinkSomething}" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource StatusTitle}" Description="{gallery:BadgeShowCaseLangResource StatusDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:DotBadge Status="Success" />
                <atom:DotBadge Status="Error" />
                <atom:DotBadge Status="Default" />
                <atom:DotBadge Status="Processing" />
                <atom:DotBadge Status="Warning" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:DotBadge Status="Success" Text="{gallery:BadgeShowCaseLangResource P2TextSuccess}" />
                <atom:DotBadge Status="Error" Text="{gallery:BadgeShowCaseLangResource P2TextError}" />
                <atom:DotBadge Status="Default" Text="{gallery:BadgeShowCaseLangResource P2TextDefault}" />
                <atom:DotBadge Status="Processing" Text="{gallery:BadgeShowCaseLangResource P2TextProcessing}" />
                <atom:DotBadge Status="Warning" Text="{gallery:BadgeShowCaseLangResource P2TextWarning}" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource RibbonTitle}" Description="{gallery:BadgeShowCaseLangResource RibbonDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Margin="20,0,20,0"
                    Orientation="Vertical"
                    Spacing="20">
            <atom:RibbonBadge Text="{gallery:BadgeShowCaseLangResource P2TextPolishExperience}">
                <atom:PixelAlignedBorder
                    Padding="10,0,10,0"
                    BorderBrush="#d9d9d9"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Vertical">
                        <atom:TextBlock Height="38"
                                        FontWeight="Bold"
                                        LineHeight="38" Text="{gallery:BadgeShowCaseLangResource P2TextPushesOpenTheWindow}" />
                        <atom:Separator LineColor="#d9d9d9" Orientation="Horizontal" />
                        <atom:TextBlock Margin="0,10,0,0" Text="{gallery:BadgeShowCaseLangResource P2TextAndRaisesTheSpyglass}" />
                    </StackPanel>
                </atom:PixelAlignedBorder>
            </atom:RibbonBadge>

            <atom:RibbonBadge RibbonColor="Pink" Text="{gallery:BadgeShowCaseLangResource P2TextJiachenPlan}">
                <atom:PixelAlignedBorder
                    Padding="10,0,10,0"
                    BorderBrush="#d9d9d9"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Height="38"
                                   FontWeight="Bold"
                                   LineHeight="38" Text="{gallery:BadgeShowCaseLangResource P2TextPushesOpenTheWindow}" />
                        <atom:Separator LineColor="#d9d9d9" Orientation="Horizontal" />
                        <TextBlock Margin="0,10,0,0" Text="{gallery:BadgeShowCaseLangResource P2TextAndRaisesTheSpyglass}" />
                    </StackPanel>
                </atom:PixelAlignedBorder>
            </atom:RibbonBadge>

            <atom:RibbonBadge RibbonColor="Cyan" Text="{gallery:BadgeShowCaseLangResource P2TextAvaloniaExcellent}">
                <atom:PixelAlignedBorder
                    Padding="10,0,10,0"
                    BorderBrush="#d9d9d9"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Height="38"
                                   FontWeight="Bold"
                                   LineHeight="38" Text="{gallery:BadgeShowCaseLangResource P2TextPushesOpenTheWindow}" />
                        <atom:Separator LineColor="#d9d9d9" Orientation="Horizontal" />
                        <TextBlock Margin="0,10,0,0" Text="{gallery:BadgeShowCaseLangResource P2TextAndRaisesTheSpyglass}" />
                    </StackPanel>
                </atom:PixelAlignedBorder>
            </atom:RibbonBadge>

            <atom:RibbonBadge RibbonColor="Green" Text="{gallery:BadgeShowCaseLangResource P2TextHippies}">
                <atom:PixelAlignedBorder
                    Padding="10,0,10,0"
                    BorderBrush="#d9d9d9"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Height="38"
                                   FontWeight="Bold"
                                   LineHeight="38" Text="{gallery:BadgeShowCaseLangResource P2TextPushesOpenTheWindow}" />
                        <atom:Separator LineColor="#d9d9d9" Orientation="Horizontal" />
                        <TextBlock Margin="0,10,0,0" Text="{gallery:BadgeShowCaseLangResource P2TextAndRaisesTheSpyglass}" />
                    </StackPanel>
                </atom:PixelAlignedBorder>
            </atom:RibbonBadge>

            <atom:RibbonBadge RibbonColor="purple"
                              Text="{gallery:BadgeShowCaseLangResource P2TextHippies}">
                <atom:PixelAlignedBorder
                    Padding="10,0,10,0"
                    BorderBrush="#d9d9d9"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Height="38"
                                   FontWeight="Bold"
                                   LineHeight="38" Text="{gallery:BadgeShowCaseLangResource P2TextPushesOpenTheWindow}" />
                        <atom:Separator LineColor="#d9d9d9" Orientation="Horizontal" />
                        <TextBlock Margin="0,10,0,0" Text="{gallery:BadgeShowCaseLangResource P2TextAndRaisesTheSpyglass}" />
                    </StackPanel>
                </atom:PixelAlignedBorder>
            </atom:RibbonBadge>

            <atom:RibbonBadge RibbonColor="volcano"
                              Text="{gallery:BadgeShowCaseLangResource P2TextHippies}">
                <atom:PixelAlignedBorder
                    Padding="10,0,10,0"
                    BorderBrush="#d9d9d9"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Height="38"
                                   FontWeight="Bold"
                                   LineHeight="38" Text="{gallery:BadgeShowCaseLangResource P2TextPushesOpenTheWindow}" />
                        <atom:Separator LineColor="#d9d9d9" Orientation="Horizontal" />
                        <TextBlock Margin="0,10,0,0" Text="{gallery:BadgeShowCaseLangResource P2TextAndRaisesTheSpyglass}" />
                    </StackPanel>
                </atom:PixelAlignedBorder>
            </atom:RibbonBadge>

            <atom:RibbonBadge RibbonColor="magenta"
                              Text="{gallery:BadgeShowCaseLangResource P2TextHippies}">
                <atom:PixelAlignedBorder
                    Padding="10,0,10,0"
                    BorderBrush="#d9d9d9"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Height="38"
                                   FontWeight="Bold"
                                   LineHeight="38" Text="{gallery:BadgeShowCaseLangResource P2TextPushesOpenTheWindow}" />
                        <atom:Separator LineColor="#d9d9d9" Orientation="Horizontal" />
                        <TextBlock Margin="0,10,0,0" Text="{gallery:BadgeShowCaseLangResource P2TextAndRaisesTheSpyglass}" />
                    </StackPanel>
                </atom:PixelAlignedBorder>
            </atom:RibbonBadge>

        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource ColorfulBadgeTitle}"
                          Description="{gallery:BadgeShowCaseLangResource ColorfulBadgeDescription}"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <atom:Separator Title="{gallery:BadgeShowCaseLangResource P2TitlePresets}"
                            FontWeight="SemiBold"
                            TitlePosition="Left" />
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:DotBadge DotColor="Pink" Text="{gallery:BadgeShowCaseLangResource P2TextPink}" />
                <atom:DotBadge DotColor="Red" Text="{gallery:BadgeShowCaseLangResource P2TextRed}" />
                <atom:DotBadge DotColor="Yellow" Text="{gallery:BadgeShowCaseLangResource P2TextYellow}" />
                <atom:DotBadge DotColor="Orange" Text="{gallery:BadgeShowCaseLangResource P2TextOrange}" />
                <atom:DotBadge DotColor="Cyan" Text="{gallery:BadgeShowCaseLangResource P2TextCyan}" />
                <atom:DotBadge DotColor="Green" Text="{gallery:BadgeShowCaseLangResource P2TextGreen}" />
                <atom:DotBadge DotColor="Blue" Text="{gallery:BadgeShowCaseLangResource P2TextBlue}" />
                <atom:DotBadge DotColor="Purple" Text="{gallery:BadgeShowCaseLangResource P2TextPurple}" />
                <atom:DotBadge DotColor="GeekBlue" Text="{gallery:BadgeShowCaseLangResource P2TextGeekblue}" />
                <atom:DotBadge DotColor="Magenta" Text="{gallery:BadgeShowCaseLangResource P2TextMagenta}" />
                <atom:DotBadge DotColor="Volcano" Text="{gallery:BadgeShowCaseLangResource P2TextVolcano}" />
                <atom:DotBadge DotColor="Gold" Text="{gallery:BadgeShowCaseLangResource P2TextGold}" />
                <atom:DotBadge DotColor="Lime" Text="{gallery:BadgeShowCaseLangResource P2TextLime}" />
            </StackPanel>
            <atom:Separator Title="{gallery:BadgeShowCaseLangResource P2TitleCustom}"
                            FontWeight="SemiBold"
                            TitlePosition="Left" />
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:DotBadge DotColor="#f50" Text="#f50" />
                <atom:DotBadge DotColor="rgb(45, 183, 245)" Text="{gallery:BadgeShowCaseLangResource P2TextRgbN45N183N245}" />
                <atom:DotBadge DotColor="hsl(102, 53%, 61%)" Text="{gallery:BadgeShowCaseLangResource P2TextHslN102N53N61}" />
                <atom:DotBadge DotColor="rgb(15, 141, 230)" Text="{gallery:BadgeShowCaseLangResource P2TextRgbN15N141N230}" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:BadgeShowCaseLangResource SemanticPartStyleTitle}"
                          Description="{gallery:BadgeShowCaseLangResource SemanticPartStyleDescription}"
                          SourceKey="badge-semantic-part"
                          BadgeText="v6.1.3"
                          Span="Full"
                          IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:BadgeViewModel">
                <StackPanel Spacing="24"
                            HorizontalAlignment="Left">
                    <StackPanel.Styles>
                        <Style Selector="atom|CountBadge.semantic-demo">
                            <atom:CountBadgeIndicatorStyle x:SetterTargetType="Control">
                                <Setter Property="TextElement.FontSize" Value="10" />
                            </atom:CountBadgeIndicatorStyle>
                        </Style>
                        <Style Selector="atom|CountBadge.semantic-custom[Size=Default]">
                            <Setter Property="BadgeColor" Value="#696FC7" />
                            <atom:CountBadgeIndicatorStyle x:SetterTargetType="Control">
                                <Setter Property="TextElement.FontSize" Value="14" />
                            </atom:CountBadgeIndicatorStyle>
                        </Style>
                        <Style Selector="atom|RibbonBadge.semantic-demo">
                            <Setter Property="Width" Value="400" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <atom:RibbonBadgeIndicatorStyle x:SetterTargetType="Control">
                                <Setter Property="Effect">
                                    <DropShadowEffect OffsetX="0"
                                                      OffsetY="2"
                                                      BlurRadius="4"
                                                      Color="#1A000000" />
                                </Setter>
                            </atom:RibbonBadgeIndicatorStyle>
                        </Style>
                        <Style Selector="atom|RibbonBadge.semantic-custom">
                            <Setter Property="RibbonColor" Value="#696FC7" />
                            <atom:RibbonBadgeContentStyle x:SetterTargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                            </atom:RibbonBadgeContentStyle>
                        </Style>
                    </StackPanel.Styles>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <atom:CountBadge Classes="semantic-demo"
                                         Count="5"
                                         Size="Small"
                                         IsMotionEnabled="False">
                            <Border Width="40"
                                    Height="40"
                                    Background="rgb(191,191,191)"
                                    CornerRadius="8" />
                        </atom:CountBadge>
                        <atom:CountBadge Name="SemanticStyleCountBadge"
                                         Classes="semantic-demo semantic-custom"
                                         Count="5"
                                         IsMotionEnabled="False">
                            <Border Width="40"
                                    Height="40"
                                    Background="rgb(191,191,191)"
                                    CornerRadius="8" />
                        </atom:CountBadge>
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <atom:RibbonBadge Classes="semantic-demo"
                                          Text="{gallery:BadgeShowCaseLangResource SemanticPartRibbonText}">
                            <atom:Card SizeType="Middle"
                                       BorderBrush="#d9d9d9"
                                       CornerRadius="10"
                                       Header="{gallery:BadgeShowCaseLangResource SemanticPartCardHeader}">
                                <atom:TextBlock TextWrapping="Wrap"
                                                Text="{gallery:BadgeShowCaseLangResource SemanticPartCardContent}" />
                            </atom:Card>
                        </atom:RibbonBadge>
                        <atom:RibbonBadge Name="SemanticStyleRibbonBadge"
                                          Classes="semantic-demo semantic-custom"
                                          Text="{gallery:BadgeShowCaseLangResource SemanticPartRibbonText}">
                            <atom:Card SizeType="Middle"
                                       BorderBrush="#d9d9d9"
                                       CornerRadius="10"
                                       Header="{gallery:BadgeShowCaseLangResource SemanticPartCardHeader}">
                                <atom:TextBlock TextWrapping="Wrap"
                                                Text="{gallery:BadgeShowCaseLangResource SemanticPartCardContent}" />
                            </atom:Card>
                        </atom:RibbonBadge>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
