<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:local="using:AtomUIGallery.Workspace.Views"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             x:Class="AtomUIGallery.Workspace.Views.ThemeWorkbenchPreview"
             Foreground="{atom:SharedTokenResource ColorText}">
    <Border Background="{atom:SharedTokenResource ColorBgLayout}">
        <StackPanel Spacing="16" Margin="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <atom:Button Name="PrimaryButton" ButtonType="Primary" Content="{gallery:ThemeWorkbenchLangResource Primary}" />
                <atom:Button Name="SmallButton" SizeType="Small" Content="{gallery:ThemeWorkbenchLangResource Small}" />
                <atom:Button IsEnabled="False" Content="{gallery:ThemeWorkbenchLangResource Disabled}" />
            </StackPanel>
            <atom:LineEdit Name="StatefulInput" Text="Keep this edit" />
            <atom:ComboBox Name="StatefulSelection" SelectedIndex="1">
                <x:String>Alpha</x:String>
                <x:String>Beta</x:String>
                <x:String>Gamma</x:String>
            </atom:ComboBox>
            <atom:Alert Type="Info" IsShowIcon="True" Message="{gallery:ThemeWorkbenchLangResource Feedback}" />
            <atom:DatePicker Name="StatefulDate" SelectedDateTime="2026-11-04" />
            <atom:ColorPicker Name="StatefulColor" DefaultValue="#1677ff" IsTextVisible="True" />
            <atom:DataGrid Name="PreviewGrid" Height="180" AutoGenerateColumns="False">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn x:CompileBindings="True" x:DataType="local:ThemeWorkbenchRow" Header="Name" FieldId="{x:Static local:ThemeWorkbenchFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn x:CompileBindings="True" x:DataType="local:ThemeWorkbenchRow" Header="Value" FieldId="{x:Static local:ThemeWorkbenchFields.Value}" Binding="{Binding Value}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
    </Border>
</UserControl>
