<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.BaseTabItemTheme"
              TargetType="atom:TabItem"
              x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:TabItem">
            <!-- The Margin of the item is applied once by the layout system; a TemplateBinding inside the template
            applies it a second time, which insets the background frame into the item Bounds while the ink bar is
            painted on the Bounds, leaving the background short by the width of the Margin on the right.
            -->
            <Border Name="Frame"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
                <!-- Ant Design line tabs outline the tab button (icon and label), not the padded tab. -->
                <StackPanel Orientation="Horizontal"
                            TemplatedControl.IsTemplateFocusTarget="True">
                    <atom:IconPresenter Name="ItemIconPresenter"
                                        Classes.semantic-icon="True"
                                        VerticalAlignment="Center"
                                        Icon="{TemplateBinding Icon}" />
                    <ContentPresenter Name="ContentPresenter"
                                      Classes.semantic-label="True"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate, Converter={x:Static atom:BaseTabItemTheme.StringToTextBlockConverter}}" />
                    <atom:IconButton Name="PART_ItemCloseButton"
                                     Classes.semantic-close="True"
                                     Icon="{TemplateBinding CloseIcon}"
                                     Opacity="{TemplateBinding CloseButtonOpacity}"
                                     VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|TabItem)">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{atom:TabTokenResourceBinding ItemColor}" />
        <Setter Property="FontWeight" Value="{atom:TabTokenResourceBinding TitleFontWeight}" />
        <Setter Property="Background" Value="Transparent" />

        <Style Selector="^ /template/ atom|IconButton#PART_ItemCloseButton">
            <Setter Property="Margin" Value="{atom:TabTokenResourceBinding CloseIconMargin}" />
            <Setter Property="IconWidth" Value="{atom:TabItemTokenResource IconSizeSM}" />
            <Setter Property="IconHeight" Value="{atom:TabItemTokenResource IconSizeSM}" />
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Margin" Value="{atom:TabTokenResourceBinding ItemIconMargin}" />
            <Setter Property="IconBrush" Value="{TemplateBinding Foreground}" />
        </Style>

        <Style Selector="^[HasIcon=True]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[IsIconSlotReserved=True]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{atom:TabTokenResourceBinding ItemHoverColor}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{atom:TabItemTokenResource ColorPrimaryActive}" />
        </Style>

        <Style Selector="^[IsTabReorderDragging=True]">
            <Setter Property="Background" Value="{atom:TabItemTokenResource ColorBgContainer}" />
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{atom:TabTokenResourceBinding ItemSelectedColor}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="FontSize" Value="{atom:TabTokenResourceBinding TitleFontSize}" />
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="Width"
                        Value="{atom:TabItemTokenResource IconSize}" />
                <Setter Property="Height"
                        Value="{atom:TabItemTokenResource IconSize}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="FontSize" Value="{atom:TabTokenResourceBinding TitleFontSize}" />
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="Width"
                        Value="{atom:TabItemTokenResource IconSize}" />
                <Setter Property="Height"
                        Value="{atom:TabItemTokenResource IconSize}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize" Value="{atom:TabTokenResourceBinding TitleFontSize}" />
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="Width"
                        Value="{atom:TabItemTokenResource IconSizeSM}" />
                <Setter Property="Height"
                        Value="{atom:TabItemTokenResource IconSizeSM}" />
            </Style>
        </Style>

        <!-- Top, right, bottom, left -->
        <Style Selector="^[TabStripPlacement=Top]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Right]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Bottom]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Left]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:TabItemTokenResource ColorTextDisabled}" />
        </Style>

        <Style Selector="^ /template/ atom|IconButton#PART_ItemCloseButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^[IsClosable=True]">
            <Style Selector="^ /template/ atom|IconButton#PART_ItemCloseButton">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Setter Property="CloseButtonOpacity" Value="0.0" />
            <Style Selector="^[IsAutoHideCloseButton=False]">
                <Setter Property="CloseButtonOpacity" Value="1.0" />
            </Style>
            <Style Selector="^[IsAutoHideCloseButton=True]">
                <Style Selector="^:pointerover">
                    <Setter Property="CloseButtonOpacity" Value="1.0" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="StateTransitionDuration" />
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="StateTransitionDuration" />
                        <DoubleTransition Property="CloseButtonOpacity" atom:TokenTransitions.Duration="StateTransitionDuration" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

    </Style>
</ControlTheme>
