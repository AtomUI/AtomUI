[{Tag,Badge}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Feedback family: Alert, Popup (Token-owner transparent; OverlayPopupHost / PopupRoot themes), ToolTip, Dialog (DialogButtonBox
# and the identity-less surface parts), MessageBox, MessageCard / WindowMessageManager, NotificationCard /
# WindowNotificationManager and PopupConfirm (PopupConfirmContainer).
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{Alert,Popup,Tooltip,Dialog,MessageBox,Message,Notifications,PopupConfirm}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Navigation family: NavMenu (identity-less items, groups, dividers, popup frame and vertical header; the horizontal and
# inline headers are registered and Token-owner transparent), Menu (MenuItem, MenuItemGroup, MenuSeparator, ContextMenu,
# MenuPopupScrollHost), the MenuFlyoutPresenter of drop-down flyouts (its theme lives in Flyouts/Themes) and the tab
# controls (TabControl, CardTabControl, TabStrip, CardTabStrip, TabItem, TabStripItem and the identity-less bases, scroll
# viewer and overflow menu), Breadcrumb (BreadcrumbItem), Pagination and SimplePagination (identity-less page items, nav and
# quick jumper) and Tour (TourStep, DefaultTourIndicator, TextTourIndicator, the identity-less steps view and mask layer).
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{NavMenu,Menu,TabControl,Breadcrumb,Pagination,Tour}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

[Flyouts/{MenuFlyoutPresenter.cs,Themes/MenuFlyoutPresenterTheme.cs}]
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

# Layout / container family: Card (CardActionButton, CardMetaContent, CardGridContent and the Token-owner transparent
# CardGridItem / CardTabsContent; the identity-less CardActionPanel), Collapse (Token-owner transparent CollapseItem),
# Expander, GroupBox, Splitter (identity-less handle, drag bar and panel), SplitView, Separator (its AbstractSeparator /
# SeparatorRail base lives in src/AtomUI.Controls/Separator, gated by its .editorconfig), Space (CompactSpace,
# CompactSpaceAddOn) and Masonry.
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{Card,Collapse,Expander,GroupBox,Splitter,SplitView,Separator,Space,Masonry}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error

