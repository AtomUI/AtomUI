<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Message.MessageShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Message"
             x:DataType="vm:MessageViewModel">
    <UserControl.Resources>
        <!-- Strictly mirrors the upstream components/message/demo/style-class.tsx: object styles give a light green
        card + 2px green border + corner radius 16 + hard shadow, with green icon / title text; function styles
        branch on type and turn the whole card red for error.
        -->
        <Styles x:Key="MessageSemanticStyleStyles">
            <Styles.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="MessageSuccessBackground" Color="#172819" />
                            <SolidColorBrush x:Key="MessageSuccessBorder" Color="#52744A" />
                            <SolidColorBrush x:Key="MessageSuccessForeground" Color="#A4E493" />
                            <SolidColorBrush x:Key="MessageErrorBackground" Color="#311C1E" />
                            <SolidColorBrush x:Key="MessageErrorBorder" Color="#995356" />
                            <SolidColorBrush x:Key="MessageErrorForeground" Color="#FF9497" />
                            <BoxShadows x:Key="MessageSuccessShadow">4 4 0 #203B26</BoxShadows>
                            <BoxShadows x:Key="MessageErrorShadow">4 4 0 #4D2325</BoxShadows>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="MessageSuccessBackground" Color="#F6FFED" />
                            <SolidColorBrush x:Key="MessageSuccessBorder" Color="#95DE64" />
                            <SolidColorBrush x:Key="MessageSuccessForeground" Color="#237804" />
                            <SolidColorBrush x:Key="MessageErrorBackground" Color="#FFF2F0" />
                            <SolidColorBrush x:Key="MessageErrorBorder" Color="#FFCCC7" />
                            <SolidColorBrush x:Key="MessageErrorForeground" Color="#CF1322" />
                            <BoxShadows x:Key="MessageSuccessShadow">4 4 0 #D9F7BE</BoxShadows>
                            <BoxShadows x:Key="MessageErrorShadow">4 4 0 #FFCCC7</BoxShadows>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Styles.Resources>
            <Style Selector="atom|MessageCard.semantic-object-style-demo">
                <Setter Property="Background" Value="{DynamicResource MessageSuccessBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MessageSuccessBorder}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BoxShadow" Value="{DynamicResource MessageSuccessShadow}" />
                <atom:MessageCardIconStyle x:SetterTargetType="atom:IconPresenter">
                    <Setter Property="IconBrush" Value="{DynamicResource MessageSuccessForeground}" />
                </atom:MessageCardIconStyle>
                <atom:MessageCardTitleStyle x:SetterTargetType="SelectableTextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource MessageSuccessForeground}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </atom:MessageCardTitleStyle>
            </Style>
            <!-- Default branch of the function styles: for a type other than error it returns the same green as the
            object styles.
            -->
            <Style Selector="atom|MessageCard.semantic-function-style-demo">
                <Setter Property="Background" Value="{DynamicResource MessageSuccessBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MessageSuccessBorder}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BoxShadow" Value="{DynamicResource MessageSuccessShadow}" />
                <atom:MessageCardIconStyle x:SetterTargetType="atom:IconPresenter">
                    <Setter Property="IconBrush" Value="{DynamicResource MessageSuccessForeground}" />
                </atom:MessageCardIconStyle>
                <atom:MessageCardTitleStyle x:SetterTargetType="SelectableTextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource MessageSuccessForeground}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </atom:MessageCardTitleStyle>
            </Style>
            <!-- Error branch of the function styles: when the type is error the whole card turns red and keeps a 2px
            red hard shadow.
            -->
            <Style Selector="atom|MessageCard.semantic-function-style-demo:error">
                <Setter Property="Background" Value="{DynamicResource MessageErrorBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MessageErrorBorder}" />
                <Setter Property="BoxShadow" Value="{DynamicResource MessageErrorShadow}" />
                <atom:MessageCardIconStyle x:SetterTargetType="atom:IconPresenter">
                    <Setter Property="IconBrush" Value="{DynamicResource MessageErrorForeground}" />
                </atom:MessageCardIconStyle>
                <atom:MessageCardTitleStyle x:SetterTargetType="SelectableTextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource MessageErrorForeground}" />
                </atom:MessageCardTitleStyle>
            </Style>
        </Styles>
    </UserControl.Resources>
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Message"
                    Category="{gallery:MessageShowCaseLangResource ComponentCategory}"
                    Status="{gallery:MessageShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:MessageShowCaseLangResource PageSubtitle}"
                    Description="{gallery:MessageShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="WindowMessageManager" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:MessageViewModel">
                    <!-- Mirrors the upstream message#semantic-dom: one preview stage hosts the parts of two public
                    owners, the "message list host" and the "message card", and the panel on the right lists all 6
                    parts in owner order. root / wrapper / icon / title belong to MessageCard; list / listContent
                    map to the manager's root / listContent, and the inline owner labels disambiguate them. The
                    manager renders hostless in the shared stage, and the sample data is seeded by Show() on
                    Loaded.
                    -->
                    <gallery:SemanticPartPreview Name="MessageSemanticPreview"
                                                 Title="Message"
                                                 SemanticOwner="{Binding #MessageSemanticAnchor}">
                        <gallery:SemanticPartPreview.SemanticOwners>
                            <gallery:SemanticPartPreviewOwner Owner="{Binding #MessageManagerSemanticOwner}"
                                                             OwnerType="{x:Type atom:WindowMessageManager}" />
                            <gallery:SemanticPartPreviewOwner Owner="{Binding #MessageCardSemanticOwner}"
                                                             OwnerType="{x:Type atom:MessageCard}" />
                        </gallery:SemanticPartPreview.SemanticOwners>
                        <gallery:SemanticPartPreview.PreviewContent>
                            <Panel MinHeight="320"
                                   Background="{atom:SharedTokenResource ColorFillAlter}">
                                <!-- The manager stretches over the stage without a host instance; the root highlight is
                                the list host itself.
                                -->
                                <atom:WindowMessageManager x:Name="MessageManagerSemanticOwner"
                                                           MaxItems="3"
                                                           IsMotionEnabled="False"
                                                           Loaded="HandleSemanticPreviewOwnerLoaded" />
                                <!-- Card anchors: two persistent cards in the same stage, laid out centered off-screen.
                                -->
                                <StackPanel x:Name="MessageSemanticAnchor"
                                            Orientation="Vertical"
                                            Spacing="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <atom:MessageCard x:Name="MessageCardSemanticOwner"
                                                      MessageType="Success"
                                                      Message="Hello, Ant Design!"
                                                      IsMotionEnabled="False" />
                                    <atom:MessageCard MessageType="Information"
                                                      Message="Welcome back!"
                                                      IsMotionEnabled="False" />
                                </StackPanel>
                            </Panel>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription Path="root"
                                                             OwnerType="{x:Type atom:MessageCard}"
                                                             Description="{gallery:MessageShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription Path="wrapper"
                                                             OwnerType="{x:Type atom:MessageCard}"
                                                             Description="{gallery:MessageShowCaseLangResource SemanticWrapperDescription}" />
                            <gallery:SemanticPartDescription Path="icon"
                                                             OwnerType="{x:Type atom:MessageCard}"
                                                             Description="{gallery:MessageShowCaseLangResource SemanticIconDescription}" />
                            <gallery:SemanticPartDescription Path="title"
                                                             OwnerType="{x:Type atom:MessageCard}"
                                                             Description="{gallery:MessageShowCaseLangResource SemanticTitleDescription}" />
                            <gallery:SemanticPartDescription Path="root"
                                                             OwnerType="{x:Type atom:WindowMessageManager}"
                                                             Description="{gallery:MessageShowCaseLangResource SemanticListRootDescription}" />
                            <gallery:SemanticPartDescription Path="listContent"
                                                             OwnerType="{x:Type atom:WindowMessageManager}"
                                                             Description="{gallery:MessageShowCaseLangResource SemanticListContentDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:MessageShowCaseLangResource BasicTitle}"
                    Description="{gallery:MessageShowCaseLangResource BasicDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MessageViewModel">
                            <atom:Button ButtonType="Primary" Click="ShowSimpleMessage" Content="{gallery:MessageShowCaseLangResource P2ContentDisplayNormalMessage}" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:MessageShowCaseLangResource OtherTypesTitle}"
                    Description="{gallery:MessageShowCaseLangResource OtherTypesDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MessageViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <atom:Button ButtonType="Default" Click="ShowSuccessMessage" Content="{gallery:MessageShowCaseLangResource P2ContentSuccess}" />
                                <atom:Button ButtonType="Default" Click="ShowInfoMessage" Content="{gallery:MessageShowCaseLangResource P2ContentInfo}" />
                                <atom:Button ButtonType="Default" Click="ShowWarningMessage" Content="{gallery:MessageShowCaseLangResource P2ContentWarning}" />
                                <atom:Button ButtonType="Default" Click="ShowErrorMessage" Content="{gallery:MessageShowCaseLangResource P2ContentError}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:MessageShowCaseLangResource LoadingIndicatorTitle}"
                                      Description="{gallery:MessageShowCaseLangResource LoadingIndicatorDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MessageViewModel">
                            <atom:Button ButtonType="Default" Click="ShowLoadingMessage" Content="{gallery:MessageShowCaseLangResource P2ContentDisplayALoadingIndicator}" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:MessageShowCaseLangResource CallbackTitle}"
                    Description="{gallery:MessageShowCaseLangResource CallbackDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MessageViewModel">
                            <atom:Button ButtonType="Default" Click="ShowSequentialMessage" Content="{gallery:MessageShowCaseLangResource P2ContentDisplayALoadingIndicator}" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:MessageShowCaseLangResource StackTitle}"
                    Description="{gallery:MessageShowCaseLangResource StackDescription}"
                    BadgeText="v6.1.9"
                    SourceKey="message-stack"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MessageViewModel">
                            <StackPanel Spacing="24">
                                <StackPanel Orientation="Horizontal" Spacing="32">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="12">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{gallery:MessageShowCaseLangResource StackEnabledLabel}" />
                                        <atom:ToggleSwitch x:Name="StackEnabledSwitch"
                                                           IsChecked="True"
                                                           IsCheckedChanged="HandleStackEnabledChanged" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{gallery:MessageShowCaseLangResource StackThresholdLabel}" />
                                        <atom:NumericUpDown Name="StackThresholdInput"
                                                            Width="100"
                                                            Minimum="1"
                                                            Maximum="10"
                                                            Increment="1"
                                                            FormatString="0"
                                                            Value="3"
                                                            IsEnabled="{Binding #StackEnabledSwitch.IsChecked}"
                                                            ValueChanged="HandleStackThresholdChanged" />
                                    </StackPanel>
                                </StackPanel>
                                <atom:Separator />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button Name="OpenStackMessageButton"
                                                 ButtonType="Primary"
                                                 Click="ShowStackMessage"
                                                 Content="{gallery:MessageShowCaseLangResource P2ContentOpenMessageBox}" />
                                    <atom:Button Name="DestroyStackMessagesButton"
                                                 ButtonType="Default"
                                                 Click="DestroyStackMessages"
                                                 Content="{gallery:MessageShowCaseLangResource P2ContentDestroyAll}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:MessageShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:MessageShowCaseLangResource SemanticPartStyleDescription}"
                    SourceKey="message-semantic-part"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    Span="Full"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MessageViewModel">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Stretch"
                                        Spacing="16">
                                <!-- Messages shown through the host go to the window feedback layer
                                (WindowFeedbackLayer): the manager pops up at the top of the viewport, as the
                                upstream default getContainer does. The feedback layer is outside the page visual
                                tree, so styles declared in the page cannot reach the cards it shows. The styles
                                are therefore declared as a Styles resource (still the generated dedicated style
                                classes) and attached to the manager itself by the code-behind.
                                -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <atom:Button ButtonType="Default"
                                                 Click="HandleShowObjectStyleMessage"
                                                 Content="{gallery:MessageShowCaseLangResource P2ContentObjectStyle}" />
                                    <atom:Button ButtonType="Primary"
                                                 Click="HandleShowFunctionStyleMessage"
                                                 Content="{gallery:MessageShowCaseLangResource P2ContentFunctionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
