<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <WasmEnableThreads>false</WasmEnableThreads>
        <!-- .NET 10 browser-wasm Webcil output currently fails during mono_wasm_load_runtime in Chromium. -->
        <WasmEnableWebcil>false</WasmEnableWebcil>
        <RuntimeFrameworkVersion>$(AtomUIGalleryRuntimeVersion)</RuntimeFrameworkVersion>
        <!--
            The .NET 10.0.10 wasm runtime pack treats an explicit false value as a
            relinking request. Keep it for the nested publish path, where native linking
            is expected, and use the SDK's equivalent default during ordinary builds.
        -->
        <RunAOTCompilation Condition="'$(WasmBuildingForNestedPublish)' == 'true'">false</RunAOTCompilation>
        <DebuggerSupport Condition="'$(Configuration)' == 'Debug'">true</DebuggerSupport>
    </PropertyGroup>

    <Target Name="ValidateGalleryRuntimeVersion" BeforeTargets="ProcessFrameworkReferences">
        <Error Condition="$([MSBuild]::VersionLessThan('$(RuntimeFrameworkVersion)', '$(AtomUIGalleryRuntimeVersion)'))"
               Text="Gallery Browser publishing requires runtime $(AtomUIGalleryRuntimeVersion) or later." />
    </Target>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <MetricsSupport>true</MetricsSupport>
        <HasAvaloniaDiagnosticsSupport>true</HasAvaloniaDiagnosticsSupport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport"
                          GeneratePathProperty="true"
                          ExcludeAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"
                          GeneratePathProperty="true"
                          ExcludeAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"
                          GeneratePathProperty="true"
                          ExcludeAssets="all"/>
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream"
                          GeneratePathProperty="true"
                          ExcludeAssets="all"/>
        <Reference Condition="'$(Configuration)' == 'Debug'"
                   Include="AvaloniaUI.DiagnosticsSupport.Avalonia">
            <HintPath>$(PkgAvaloniaUI_DiagnosticsSupport)/lib/net10.0/AvaloniaUI.DiagnosticsSupport.Avalonia.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Condition="'$(Configuration)' == 'Debug'"
                   Include="Microsoft.Extensions.DependencyInjection.Abstractions">
            <HintPath>$(PkgMicrosoft_Extensions_DependencyInjection_Abstractions)/lib/net8.0/Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Condition="'$(Configuration)' == 'Debug'"
                   Include="Microsoft.Extensions.Logging.Abstractions">
            <HintPath>$(PkgMicrosoft_Extensions_Logging_Abstractions)/lib/net8.0/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Condition="'$(Configuration)' == 'Debug'"
                   Include="Microsoft.IO.RecyclableMemoryStream">
            <HintPath>$(PkgMicrosoft_IO_RecyclableMemoryStream)/lib/net6.0/Microsoft.IO.RecyclableMemoryStream.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <RuntimeHostConfigurationOption Condition="'$(Configuration)' == 'Debug'"
                                        Include="Avalonia.Diagnostics.Diagnostic.IsEnabled"
                                        Value="True"/>
    </ItemGroup>

    <ItemGroup Condition="'$(RunAOTCompilation)' == 'true' and '$(BrowserAotForceInterpretAssemblies)' != ''">
        <_AOT_InternalForceInterpretAssemblies Include="$(BrowserAotForceInterpretAssemblies)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../AtomUIGallery/AtomUIGallery.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Desktop.Controls.Extras/AtomUI.Desktop.Controls.Extras.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Fonts.AlibabaPuHuiTi/AtomUI.Fonts.AlibabaPuHuiTi.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Generator/AtomUI.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <AtomUILanguagePackProjectReference Include="../../src/LanguagePacks/pt-BR/AtomUI.Controls.I18n.PtBR/AtomUI.Controls.I18n.PtBR.csproj" />
        <AtomUILanguagePackProjectReference Include="../../src/LanguagePacks/pt-BR/AtomUI.Desktop.Controls.I18n.PtBR/AtomUI.Desktop.Controls.I18n.PtBR.csproj" />
        <AtomUILanguagePackProjectReference Include="../../src/LanguagePacks/pt-BR/AtomUI.Desktop.Controls.DataGrid.I18n.PtBR/AtomUI.Desktop.Controls.DataGrid.I18n.PtBR.csproj" />
        <AtomUILanguagePackProjectReference Include="../../src/LanguagePacks/pt-BR/AtomUI.Desktop.Controls.ColorPicker.I18n.PtBR/AtomUI.Desktop.Controls.ColorPicker.I18n.PtBR.csproj" />
    </ItemGroup>

    <Target Name="DeduplicateBrowserWasmStaticWebAssets"
            AfterTargets="ResolveWasmOutputs"
            BeforeTargets="_GenerateBuildWasmBootJson;_AddWasmStaticWebAssets">
        <RemoveDuplicates Inputs="@(WasmStaticWebAsset)">
            <Output TaskParameter="Filtered" ItemName="_DeduplicatedWasmStaticWebAsset"/>
        </RemoveDuplicates>
        <ItemGroup>
            <WasmStaticWebAsset Remove="@(WasmStaticWebAsset)"/>
            <WasmStaticWebAsset Include="@(_DeduplicatedWasmStaticWebAsset)"/>
        </ItemGroup>
    </Target>

    <Target Name="ExcludeDesktopPlatformAssembliesFromBrowserWasm"
            AfterTargets="_GetDefaultWasmAssembliesToBundle"
            BeforeTargets="PrepareInputsForWasmBuild">
        <ItemGroup>
            <WasmAssembliesToBundle Remove="@(WasmAssembliesToBundle)"
                                    Condition="'%(FileName)' == 'Avalonia.Wayland' or
                                               '%(FileName)' == 'NWayland' or
                                               '%(FileName)' == 'Avalonia.Win32' or
                                               '%(FileName)' == 'Avalonia.Win32.Automation'" />
        </ItemGroup>
    </Target>

</Project>
