<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SelectTag}" TargetType="atom:SelectTag">
        <ControlTheme.BasedOn>
            <themes:TagTheme TargetType="atom:SelectTag" />
        </ControlTheme.BasedOn>

        <Style Selector="^:is(atom|SelectTag)">
            <Setter Property="Background" Value="{Binding $self.(atom:SelectTag.ThemeMultipleItemBg)}" />
            <Setter Property="IsClosable" Value="True" />
            <Setter Property="FontSize" Value="{Binding $self.(atom:SelectTag.ThemeOptionFontSize)}" />

            <Style Selector="^:disabled">
                <Setter Property="Background"
                        Value="{Binding $self.(atom:SelectTag.ThemeMultipleSelectorBgDisabled)}" />
                <Setter Property="Foreground"
                        Value="{Binding $self.(atom:SelectTag.ThemeMultipleItemColorDisabled)}" />
                <Setter Property="IsClosable" Value="False" />
            </Style>

            <Style Selector="^[SizeType=Large]">
                <Setter Property="Height" Value="{Binding $self.(atom:SelectTag.ThemeMultipleItemHeight)}" />
            </Style>

            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="Height" Value="{Binding $self.(atom:SelectTag.ThemeMultipleItemHeight)}" />
            </Style>

            <Style Selector="^[SizeType=Custom][HasCustomTagHeight=True]">
                <Setter Property="Height"
                        Value="{Binding CustomTagHeight, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Height" Value="{Binding $self.(atom:SelectTag.ThemeMultipleItemHeight)}" />
            </Style>

        </Style>

    </ControlTheme>
</ResourceDictionary>
