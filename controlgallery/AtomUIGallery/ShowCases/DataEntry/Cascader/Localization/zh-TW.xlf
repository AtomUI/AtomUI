    <unit id="PageDescription">
      <segment>
        <source>Cascader combines an input selector with linked option columns, while CascaderView exposes the column browser directly for embedded selection workflows.</source>
        <target state="translated">Cascader 將輸入選擇器與聯動選項列組合起來，CascaderView 則直接暴露列式瀏覽器，用於嵌入式選擇場景。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Hierarchical selection and cascaded option browsing.</source>
        <target state="translated">分層選擇與級聯選項瀏覽。</target>
      </segment>
    </unit>
    <unit id="PlacementDescription">
      <segment>
