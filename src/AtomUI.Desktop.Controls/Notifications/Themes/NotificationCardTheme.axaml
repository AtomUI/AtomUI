<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <atom:StringToSelectableTextBlockConverter x:Key="StringToSelectableTextBlockConverter" />
    <ControlTheme x:Key="{x:Type atom:NotificationCard}" TargetType="atom:NotificationCard">
        <Setter Property="EnterMotion" Value="{atom:MotionResource NotificationEnter}" />
        <Setter Property="LeaveMotion" Value="{atom:MotionResource NotificationLeave}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Card template: a flow content area on top with icon + title/description, and an optional actions
                area below. close and progress are overlays outside the flow, pinned to the top right corner and to
                the bottom edge of the card through the alignment properties. Two structural constraints. 1) Frame
                is the template root, the shadow painter and the motion target. No clipping layout layer is
                inserted above Frame; the outer card keeps handling stack positioning and scaling, and the
                PART_Frame of Message uses the same separation of duties. 2) Padding must be carried by ContentBox
                inside Frame; Frame itself must have no inner padding. PART_Layout is the positioning parent of
                close and progress. Only when Frame has no padding does it coincide with the inner edge of the card
                border, so that close and progress sit on the top right corner and on the bottom edge of the
                border; otherwise the padding pushes them inward.
                -->
                    <Border Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{TemplateBinding BoxShadow}">
                        <atom:FeedbackStackTransitionSnapshotHost Name="PART_StackTransitionSnapshotHost">
                            <Grid Name="PART_Layout"
                                  ColumnDefinitions="Auto, *"
                                  RowDefinitions="Auto, *, Auto">
                                <Border Name="ContentBox"
                                        Padding="{TemplateBinding Padding}"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">
                                    <StackPanel>
                                        <DockPanel Name="Wrapper"
                                                   Classes.semantic-wrapper="True"
                                                   LastChildFill="True">
                                            <atom:IconPresenter
                                                Name="IconPresenter"
                                                Classes.semantic-icon="True"
                                                DockPanel.Dock="Left"
                                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Icon="{TemplateBinding Icon}" />
                                            <StackPanel Name="Section"
                                                        Classes.semantic-section="True">
                                                <atom:SelectableTextBlock
                                                    Name="HeaderTitle"
                                                    Classes.semantic-title="True"
                                                    Text="{TemplateBinding Title}" />
                                                <ContentPresenter
                                                    Name="Content"
                                                    Classes.semantic-description="True"
                                                    TextWrapping="Wrap"
                                                    Content="{TemplateBinding Content, Converter={StaticResource StringToSelectableTextBlockConverter}}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ContentPresenter
                                            Name="ActionsContainer"
                                            Classes.semantic-actions="True"
                                            HorizontalAlignment="Right"
                                            IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Content="{TemplateBinding Actions}"
                                            ContentTemplate="{TemplateBinding ActionsTemplate}" />
                                    </StackPanel>
                                </Border>

                                <!-- close is an overlay: it takes no part in the flow and is pinned to the top right
                                corner of the card.
                                -->
                                <atom:IconButton
                                    Name="PART_CloseButton"
                                    Classes.semantic-close="True"
                                    Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </atom:FeedbackStackTransitionSnapshotHost>
                    </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled"
                Value="{atom:NotificationCardTokenResource EnableMotion}" />
        <Setter Property="OpenCloseMotionDuration"
                Value="{atom:NotificationCardTokenResource MotionDurationMid}" />
        <Setter Property="ClipToBounds" Value="False" />
<Setter Property="Transitions">
            <atom:TokenTransitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   atom:TokenTransitions.Duration="StateTransitionDuration"
                                                   atom:TokenTransitions.Easing="MotionEaseInOut" />
                    <DoubleTransition Property="Opacity"
                                      atom:TokenTransitions.Duration="StateTransitionDuration"
                                      atom:TokenTransitions.Easing="MotionEaseInOut" />
                    <DoubleTransition Property="{x:Static atom:FeedbackStackPanel.StackClipProgressProperty}"
                                      atom:TokenTransitions.Duration="StateTransitionDuration"
                                      atom:TokenTransitions.Easing="MotionEaseInOut" />
                </Transitions>
            </atom:TokenTransitions>
        </Setter>

        <Style Selector="^[IsMotionEnabled=False]">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>

        <Setter Property="Width" Value="{atom:NotificationCardTokenResource NotificationWidth}" />

        <!-- The root surface defaults live at owner level: Frame reads them through TemplateBinding, so the
        ControlTheme only supplies the default look and an override through an owner-scoped Semantic Style really
        reaches the card frame.
        -->
        <Setter Property="Background" Value="{atom:NotificationCardTokenResource NotificationBg}" />
        <Setter Property="BorderThickness" Value="{atom:NotificationCardTokenResource NotificationBorderThickness}" />
        <Setter Property="BorderBrush" Value="{atom:NotificationCardTokenResource NotificationBorderColor}" />
        <Setter Property="Padding" Value="{atom:NotificationCardTokenResource NotificationPadding}" />
        <Setter Property="CornerRadius" Value="{atom:NotificationCardTokenResource BorderRadiusLG}" />
        <Setter Property="BoxShadow" Value="{atom:NotificationCardTokenResource RestingShadows}" />

        <Style Selector="^ /template/ Border#Frame">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="^[IsClosed=True]">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- =============================== icon ================================ -->
        <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
            <!-- The icon aligns with the top of the first title line. DockPanel stretches its children by default and
            centers them vertically once they have an explicit Height, which makes the icon sit visibly lower than
            the title, so the top alignment is explicit here.
            -->
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Width"
                    Value="{atom:NotificationCardTokenResource NotificationIconSize}" />
            <Setter Property="Height"
                    Value="{atom:NotificationCardTokenResource NotificationIconSize}" />
            <Setter Property="Margin"
                    Value="{atom:NotificationCardTokenResource NotificationIconMargin}" />
        </Style>

        <Style Selector="^[NotificationType=Information]">
            <Setter Property="BoxShadow" Value="{atom:NotificationCardTokenResource InformationShadows}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:NotificationCardTokenResource InformationIconColor}" />
            </Style>
        </Style>

        <Style Selector="^[NotificationType=Error]">
            <Setter Property="BoxShadow" Value="{atom:NotificationCardTokenResource ErrorShadows}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:NotificationCardTokenResource ErrorIconColor}" />
            </Style>
        </Style>

        <Style Selector="^[NotificationType=Success]">
            <Setter Property="BoxShadow" Value="{atom:NotificationCardTokenResource SuccessShadows}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:NotificationCardTokenResource SuccessIconColor}" />
            </Style>
        </Style>

        <Style Selector="^[NotificationType=Warning]">
            <Setter Property="BoxShadow" Value="{atom:NotificationCardTokenResource WarningShadows}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:NotificationCardTokenResource WarningIconColor}" />
            </Style>
        </Style>

        <!-- ============================== section ============================== -->
        <Style Selector="^ /template/ StackPanel#Section">
            <Setter Property="Spacing"
                    Value="{atom:NotificationCardTokenResource NotificationSectionSpacing}" />
        </Style>

        <Style Selector="^ /template/ atom|SelectableTextBlock#HeaderTitle">
            <Setter Property="LineHeight"
                    Value="{atom:NotificationCardTokenResource FontHeightLG}" />
            <Setter Property="FontSize"
                    Value="{atom:NotificationCardTokenResource FontSizeLG}" />
            <Setter Property="Foreground"
                    Value="{atom:NotificationCardTokenResource ColorTextHeading}" />
            <!-- Only the title row shares a row with the close button, so only the title reserves room on the right for
            it.
            -->
            <Setter Property="Padding"
                    Value="{atom:NotificationCardTokenResource NotificationTitlePadding}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#Content">
            <Setter Property="Foreground"
                    Value="{atom:NotificationCardTokenResource ColorText}" />
            <Setter Property="FontSize"
                    Value="{atom:NotificationCardTokenResource FontSize}" />
            <Setter Property="LineHeight"
                    Value="{atom:NotificationCardTokenResource FontHeight}" />
            <!-- The description sits below the title and shares no row with the close button, so it reserves no room on
            the right.
            -->
        </Style>

        <!-- ============================== actions ============================== -->
        <Style Selector="^ /template/ ContentPresenter#ActionsContainer">
            <Setter Property="Margin"
                    Value="{atom:NotificationCardTokenResource NotificationActionsMargin}" />
        </Style>

        <!-- =============================== close =============================== -->
        <Style Selector="^ /template/ atom|IconButton#PART_CloseButton">
            <Setter Property="Margin"
                    Value="{atom:NotificationCardTokenResource NotificationCloseButtonMargin}" />
            <Setter Property="Width"
                    Value="{atom:NotificationCardTokenResource NotificationCloseButtonSize}" />
            <Setter Property="Height"
                    Value="{atom:NotificationCardTokenResource NotificationCloseButtonSize}" />
            <Setter Property="CornerRadius"
                    Value="{atom:NotificationCardTokenResource BorderRadiusSM}" />
            <Setter Property="IconHeight"
                    Value="{atom:NotificationCardTokenResource IconSizeSM}" />
            <Setter Property="IconWidth"
                    Value="{atom:NotificationCardTokenResource IconSizeSM}" />
            <Setter Property="IconBrush"
                    Value="{atom:NotificationCardTokenResource ColorIcon}" />
        </Style>

        <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pointerover">
            <Setter Property="Background"
                    Value="{atom:NotificationCardTokenResource ColorBgTextHover}" />
            <Setter Property="IconBrush"
                    Value="{atom:NotificationCardTokenResource ColorIconHover}" />
        </Style>

        <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pressed">
            <Setter Property="Background"
                    Value="{atom:NotificationCardTokenResource ColorBgTextActive}" />
            <Setter Property="IconBrush"
                    Value="{atom:NotificationCardTokenResource ColorIconHover}" />
        </Style>

        <!-- ============================= progress ============================== -->
        <Style Selector="^ /template/ atom|NotificationProgressBar#ProgressBar">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin"
                    Value="{atom:NotificationCardTokenResource NotificationProgressMargin}" />
        </Style>


        <!-- ========================= severity surfaces ========================= -->
        <!-- After the generic title, description and close rules so a severity keeps its colours, hover included. -->
        <Style Selector="^[NotificationType=Information]">
            <Setter Property="Background" Value="{atom:NotificationCardTokenResource InformationBg}" />
            <Setter Property="BorderBrush" Value="{atom:NotificationCardTokenResource InformationBorderColor}" />
            <Style Selector="^ /template/ atom|SelectableTextBlock#HeaderTitle">
                <Setter Property="Foreground" Value="{atom:NotificationCardTokenResource InformationTitleColor}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{atom:NotificationCardTokenResource InformationDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource InformationCloseIconColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pointerover">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource InformationCloseIconHoverColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pressed">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource InformationCloseIconHoverColor}" />
            </Style>
        </Style>
        <Style Selector="^[NotificationType=Success]">
            <Setter Property="Background" Value="{atom:NotificationCardTokenResource SuccessBg}" />
            <Setter Property="BorderBrush" Value="{atom:NotificationCardTokenResource SuccessBorderColor}" />
            <Style Selector="^ /template/ atom|SelectableTextBlock#HeaderTitle">
                <Setter Property="Foreground" Value="{atom:NotificationCardTokenResource SuccessTitleColor}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{atom:NotificationCardTokenResource SuccessDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource SuccessCloseIconColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pointerover">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource SuccessCloseIconHoverColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pressed">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource SuccessCloseIconHoverColor}" />
            </Style>
        </Style>
        <Style Selector="^[NotificationType=Warning]">
            <Setter Property="Background" Value="{atom:NotificationCardTokenResource WarningBg}" />
            <Setter Property="BorderBrush" Value="{atom:NotificationCardTokenResource WarningBorderColor}" />
            <Style Selector="^ /template/ atom|SelectableTextBlock#HeaderTitle">
                <Setter Property="Foreground" Value="{atom:NotificationCardTokenResource WarningTitleColor}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{atom:NotificationCardTokenResource WarningDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource WarningCloseIconColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pointerover">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource WarningCloseIconHoverColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pressed">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource WarningCloseIconHoverColor}" />
            </Style>
        </Style>
        <Style Selector="^[NotificationType=Error]">
            <Setter Property="Background" Value="{atom:NotificationCardTokenResource ErrorBg}" />
            <Setter Property="BorderBrush" Value="{atom:NotificationCardTokenResource ErrorBorderColor}" />
            <Style Selector="^ /template/ atom|SelectableTextBlock#HeaderTitle">
                <Setter Property="Foreground" Value="{atom:NotificationCardTokenResource ErrorTitleColor}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{atom:NotificationCardTokenResource ErrorDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource ErrorCloseIconColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pointerover">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource ErrorCloseIconHoverColor}" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_CloseButton:pressed">
                <Setter Property="IconBrush" Value="{atom:NotificationCardTokenResource ErrorCloseIconHoverColor}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
