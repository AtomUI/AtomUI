<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ButtonSpinner}" TargetType="atom:ButtonSpinner">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:ButtonSpinnerDecoratedBox
                    Name="PART_DecoratedBox"
                    Classes.semantic-scope-frame="True"
                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                    LeftAddOn="{TemplateBinding LeftAddOn}"
                    LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                    RightAddOn="{TemplateBinding RightAddOn}"
                    RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                    ContentLeftAddOn="{TemplateBinding InnerLeftContent}"
                    ContentLeftAddOnTemplate="{TemplateBinding InnerLeftContentTemplate}"
                    ContentRightAddOn="{TemplateBinding InnerRightContent}"
                    ContentRightAddOnTemplate="{TemplateBinding InnerRightContentTemplate}"
                    StyleVariant="{TemplateBinding StyleVariant}"
                    SizeType="{TemplateBinding SizeType}"
                    Status="{TemplateBinding Status}"
                    FormStatus="{TemplateBinding FormStatus}"
                    IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                    DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                    IsShowHandle="{TemplateBinding IsButtonSpinnerVisible}"
                    IsHandleFloatable="{TemplateBinding IsButtonSpinnerFloatable}"
                    ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}"
                    Focusable="True"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                    <atom:ButtonSpinnerDecoratedBox.SpinnerContent>
                        <atom:ButtonSpinnerHandle
                            Classes.semantic-actions="True"
                            ButtonSpinnerLocation="{Binding (atom:ButtonSpinner.ButtonSpinnerLocation), RelativeSource={RelativeSource AncestorType=atom:ButtonSpinner}}"
                            StyleVariant="{Binding (atom:ButtonSpinner.StyleVariant), RelativeSource={RelativeSource AncestorType=atom:ButtonSpinner}}"
                            IsMotionEnabled="{Binding (atom:ButtonSpinner.IsMotionEnabled), RelativeSource={RelativeSource AncestorType=atom:ButtonSpinner}}"
                            CornerRadius="{Binding (atom:ButtonSpinner.CornerRadius), RelativeSource={RelativeSource AncestorType=atom:ButtonSpinner}}"
                            Width="{Binding (atom:ButtonSpinner.SpinnerHandleWidth), RelativeSource={RelativeSource AncestorType=atom:ButtonSpinner}}"/>
                    </atom:ButtonSpinnerDecoratedBox.SpinnerContent>
                </atom:ButtonSpinnerDecoratedBox>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SpinnerHandleWidth"
                Value="{atom:ButtonSpinnerTokenResource HandleWidth}" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
