<?xml version="1.0" encoding="utf-8"?>
<xliff version="2.1" srcLang="en-US" trgLang="zh-CN" xmlns="urn:oasis:names:tc:xliff:document:2.0">
  <file id="AtomUIGallery.Localization.UploadShowCaseLangResourceKind">
    <unit id="AvatarDescription">
      <segment>
        <source>Click to upload user's avatar, and validate size and format of picture with beforeUpload.</source>
        <target state="translated">点击上传用户头像，并通过 beforeUpload 校验图片大小和格式。</target>
      </segment>
    </unit>
    <unit id="AvatarTitle">
      <segment>
        <source>Avatar</source>
        <target state="translated">头像</target>
      </segment>
    </unit>
    <unit id="ComponentCategory">
      <segment>
        <source>Data Entry</source>
        <target state="translated">数据录入</target>
      </segment>
    </unit>
    <unit id="ComponentStatusStable">
      <segment>
        <source>Stable</source>
        <target state="translated">稳定</target>
      </segment>
    </unit>
    <unit id="DefaultFilesDescription">
      <segment>
        <source>Bind Files to provide an initial observable upload file list.</source>
        <target state="translated">通过绑定 Files 提供初始的可观察上传文件列表。</target>
      </segment>
    </unit>
    <unit id="DefaultFilesTitle">
      <segment>
        <source>Default Files</source>
        <target state="translated">默认文件</target>
      </segment>
    </unit>
    <unit id="DragAndDropDescription">
      <segment>
        <source>You can drag files to a specific area, to upload. Alternatively, you can also upload by selecting.</source>
        <target state="translated">可以将文件拖拽到指定区域上传，也可以通过选择文件上传。</target>
      </segment>
    </unit>
    <unit id="DragAndDropTitle">
      <segment>
        <source>Drag and Drop</source>
        <target state="translated">拖拽上传</target>
      </segment>
    </unit>
    <unit id="FileAndDirectoryDescription">
      <segment>
        <source>Compose two UploadTrigger instances to select files and directories independently.</source>
        <target state="translated">组合两个 UploadTrigger，分别触发文件选择和目录选择。</target>
      </segment>
    </unit>
    <unit id="FileAndDirectoryTitle">
      <segment>
        <source>Files and directories</source>
        <target state="translated">文件与目录</target>
      </segment>
    </unit>
    <unit id="MaxCountDescription">
      <segment>
        <source>Limit files with maxCount. Will replace current one when maxCount is 1.</source>
        <target state="translated">使用 maxCount 限制文件数量。当 maxCount 为 1 时会替换当前文件。</target>
      </segment>
    </unit>
    <unit id="MaxCountTitle">
      <segment>
        <source>Max Count</source>
        <target state="translated">最大数量</target>
      </segment>
    </unit>
    <unit id="P2CancelImageSize">
      <segment>
        <source>Image must be smaller than 2MB!</source>
        <target state="translated">图片必须小于 2MB！</target>
      </segment>
    </unit>
    <unit id="P2CancelJpgPngOnly">
      <segment>
        <source>You can only upload JPG/PNG file!</source>
        <target state="translated">只能上传 JPG/PNG 文件！</target>
      </segment>
    </unit>
    <unit id="P2CancelPngOnly">
      <segment>
        <source>You can only upload PNG file!</source>
        <target state="translated">只能上传 PNG 文件！</target>
      </segment>
    </unit>
    <unit id="P2ContentClickToUpload">
      <segment>
        <source>Click to Upload</source>
        <target state="translated">点击上传</target>
      </segment>
    </unit>
    <unit id="P2ContentUploadDirectory">
      <segment>
        <source>Upload Directory</source>
        <target state="translated">上传目录</target>
      </segment>
    </unit>
    <unit id="P2ContentUploadMaxN1">
      <segment>
        <source>Upload (Max: 1)</source>
        <target state="translated">上传（最多：1）</target>
      </segment>
    </unit>
    <unit id="P2ContentUploadMaxN3">
      <segment>
        <source>Upload (Max: 3)</source>
        <target state="translated">上传（最多：3）</target>
      </segment>
    </unit>
    <unit id="P2ContentUploadPngOnly">
      <segment>
        <source>Upload PNG only</source>
        <target state="translated">仅上传 PNG</target>
      </segment>
    </unit>
    <unit id="P2ErrorServer500">
      <segment>
        <source>Server Error 500</source>
        <target state="translated">服务器错误 500</target>
      </segment>
    </unit>
    <unit id="P2ErrorUpload">
      <segment>
        <source>Upload error!</source>
        <target state="translated">上传失败！</target>
      </segment>
    </unit>
    <unit id="P2TextUpload">
      <segment>
        <source>Upload</source>
        <target state="translated">上传</target>
      </segment>
    </unit>
    <unit id="P2UploadSuccessFormat">
      <segment>
        <source>{0} uploaded successfully!</source>
        <target state="translated">{0} 上传成功！</target>
      </segment>
    </unit>
    <unit id="PageDescription">
      <segment>
        <source>Upload supports composable file and directory triggers, drag-and-drop areas, observable Files state, picture lists, max-count constraints, success cleanup, and file type filtering.</source>
        <target state="translated">Upload 支持组合式文件和目录触发器、拖拽区域、可观察 Files 状态、图片列表、最大数量限制、成功清理和文件类型过滤。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Select, validate, preview, and upload files with list and picture presentations.</source>
        <target state="translated">选择、校验、预览并上传文件，支持列表和图片展示方式。</target>
      </segment>
    </unit>
    <unit id="PictureCircleTypeDescription">
      <segment>
        <source>Alternative display for picture-card.</source>
        <target state="translated">picture-card 的另一种展示形式。</target>
      </segment>
    </unit>
    <unit id="PictureCircleTypeTitle">
      <segment>
        <source>Pictures with picture-circle type</source>
        <target state="translated">圆形图片卡片</target>
      </segment>
    </unit>
    <unit id="PicturesWallDescription">
      <segment>
        <source>After users upload a picture, the thumbnail is rendered in the picture-card list and the trigger remains a separate append entry.</source>
        <target state="translated">用户上传图片后，缩略图会显示在 picture-card 列表中，触发器始终作为独立 append 入口呈现。</target>
      </segment>
    </unit>
    <unit id="PicturesWallTitle">
      <segment>
        <source>Pictures Wall</source>
        <target state="translated">图片墙</target>
      </segment>
    </unit>
    <unit id="PicturesWithListStyleDescription">
      <segment>
        <source>If uploaded file is a picture, the thumbnail can be shown.</source>
        <target state="translated">如果上传文件是图片，可以显示缩略图。</target>
      </segment>
    </unit>
    <unit id="PicturesWithListStyleTitle">
      <segment>
        <source>Pictures with list style</source>
        <target state="translated">列表样式图片</target>
      </segment>
    </unit>
    <unit id="ScenarioBasic">
      <segment>
        <source>Basic</source>
        <target state="translated">基础</target>
      </segment>
    </unit>
    <unit id="ScenarioConstraints">
      <segment>
        <source>Constraints</source>
        <target state="translated">限制</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="ScenarioPictures">
      <segment>
        <source>Pictures</source>
        <target state="translated">图片</target>
      </segment>
    </unit>
    <unit id="ScrollableListDescription">
      <segment>
        <source>UploadList owns the scroll region, so long file lists do not require an outer ScrollViewer.</source>
        <target state="translated">UploadList 自己管理滚动区域，长文件列表不需要外层 ScrollViewer。</target>
      </segment>
    </unit>
    <unit id="ScrollableListTitle">
      <segment>
        <source>Scrollable list</source>
        <target state="translated">可滚动列表</target>
      </segment>
    </unit>
    <unit id="SemanticItemDescription">
      <segment>
        <source>Each realized file container. The PictureCard and PictureCircle append trigger is not a file item.</source>
        <target state="translated">每个已实例化的文件容器。PictureCard 和 PictureCircle 的追加触发入口不属于文件项。</target>
      </segment>
    </unit>
    <unit id="SemanticListDescription">
      <segment>
        <source>The active file list for every ListType, including the PictureCard and PictureCircle wrap layout.</source>
        <target state="translated">每种 ListType 的活动文件列表，包括 PictureCard 和 PictureCircle 的换行布局。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Customize the Upload root, list region, and every realized file item with generated semantic styles.</source>
        <target state="translated">使用生成的语义样式自定义 Upload 根控件、列表区域和每个已实例化的文件项。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
        <target state="translated">自定义语义结构的样式</target>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>The Upload owner that coordinates the trigger and list layout through the Upload control contract.</source>
        <target state="translated">通过 Upload 控件契约协调触发入口和列表布局的 Upload 根控件。</target>
      </segment>
    </unit>
    <unit id="SuccessAutoRemoveDescription">
      <segment>
        <source>Use SuccessAutoRemoveDelay to remove successful files after a short delay.</source>
        <target state="translated">通过 SuccessAutoRemoveDelay 在上传成功后延迟移除文件。</target>
      </segment>
    </unit>
    <unit id="SuccessAutoRemoveTitle">
      <segment>
        <source>Auto remove successful files</source>
        <target state="translated">成功后自动移除</target>
      </segment>
    </unit>
    <unit id="UploadByClickingDescription">
      <segment>
        <source>Classic mode. File selection dialog pops up when upload button is clicked.</source>
        <target state="translated">经典模式。点击上传按钮时弹出文件选择对话框。</target>
      </segment>
    </unit>
    <unit id="UploadByClickingTitle">
      <segment>
        <source>Upload by clicking</source>
        <target state="translated">点击上传</target>
      </segment>
    </unit>
    <unit id="UploadPngOnlyDescription">
      <segment>
        <source>beforeUpload only prevent upload behavior when return false or reject promise, the prevented file would still show in file list. Here is the example you can keep prevented files out of list by return UPLOAD.LIST_IGNORE.</source>
        <target state="translated">beforeUpload 返回 false 或拒绝 promise 时只会阻止上传行为，被阻止的文件仍会显示在文件列表中。本示例通过返回 UPLOAD.LIST_IGNORE 将被阻止的文件排除在列表外。</target>
      </segment>
    </unit>
    <unit id="UploadPngOnlyTitle">
      <segment>
        <source>Upload png file only</source>
        <target state="translated">仅上传 PNG 文件</target>
      </segment>
    </unit>
  </file>
</xliff>
