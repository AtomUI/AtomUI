<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net"
                    x:ClassModifier="internal">

    <ControlTheme x:Key="{x:Type atom:WindowChromeLayer}" TargetType="atom:WindowChromeLayer">
        <!-- The title bar host used to fill the manager's Child, which the manager insets by its Padding
             (OffScreenMargin); layers are arranged over the whole manager. Mirroring that Padding keeps the surface at
             the same window position. -->
        <Setter Property="Margin" Value="{Binding $parent[VisualLayerManager].Padding}" />
    </ControlTheme>

</ResourceDictionary>
