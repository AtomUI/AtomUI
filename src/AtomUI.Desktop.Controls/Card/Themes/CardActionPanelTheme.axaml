<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <!-- CardActionPanel paints its background (ActionsBg, bottom corners only), the top border and the separators
         between actions itself in Render, so the separators stay visible above the background; the grid leaves a
         LineWidth gap between actions for them. -->
    <ControlTheme x:Key="{x:Type atom:CardActionPanel}" TargetType="atom:CardActionPanel">
        <Setter Property="Template">
            <ControlTemplate>
                <UniformGrid Name="PART_GridPanel"
                             ColumnSpacing="{atom:CardTokenResource LineWidth}" />
            </ControlTemplate>
        </Setter>
        <Setter Property="MinHeight" Value="{atom:CardTokenResource ControlHeightLG}"/>
        <Setter Property="FontSize" Value="{atom:CardTokenResource FontSize}"/>
        <Setter Property="Background" Value="{atom:CardTokenResource ActionsBg}"/>
        <Setter Property="Foreground" Value="{atom:CardTokenResource ColorTextDescription}"/>
        <Setter Property="BorderBrush" Value="{atom:CardTokenResource ColorBorderSecondary}"/>
        <Setter Property="BorderThickness" Value="{atom:CardTokenResource BorderThickness}"/>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{atom:CardTokenResource ColorPrimary}"/>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="StateTransitionDuration" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

    </ControlTheme>
</ResourceDictionary>
