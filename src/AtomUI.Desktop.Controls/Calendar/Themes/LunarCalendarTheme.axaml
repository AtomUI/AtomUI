<ControlTheme xmlns:tokeninputs="using:AtomUI.Desktop.Controls.Internal.Calendar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AtomUI.Desktop.Controls"
    xmlns:themes="clr-namespace:AtomUI.Desktop.Controls.Themes"
    xmlns:calendar="clr-namespace:AtomUI.Desktop.Controls.Internal.Calendar"
    xmlns:viewer="clr-namespace:AtomUI.Desktop.Controls.Internal.DateViewer"
    xmlns:atom="https://atomui.net"
    x:Class="AtomUI.Desktop.Controls.Themes.LunarCalendarControlTheme"
    TargetType="controls:LunarCalendar"
    x:ClassModifier="internal">
        <Setter Property="tokeninputs:CalendarHeader.ThemeFullBg" Value="{atom:LunarCalendarTokenResource FullBg}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeFullPanelBg" Value="{atom:LunarCalendarTokenResource FullPanelBg}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeItemActiveBg" Value="{atom:LunarCalendarTokenResource ItemActiveBg}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeItemActiveColor" Value="{atom:LunarCalendarTokenResource ItemActiveColor}" />

        <Setter Property="tokeninputs:CalendarHeader.ThemeYearControlWidth" Value="{atom:LunarCalendarTokenResource YearControlWidth}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeMonthControlWidth" Value="{atom:LunarCalendarTokenResource MonthControlWidth}" />

        <Setter Property="tokeninputs:CalendarHeader.ThemeWeekHeaderHeight" Value="{atom:LunarCalendarTokenResource WeekHeaderHeight}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeWeekHeaderPadding" Value="{atom:LunarCalendarTokenResource WeekHeaderPadding}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeFullCellMargin" Value="{atom:LunarCalendarTokenResource FullCellMargin}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeFullCellPadding" Value="{atom:LunarCalendarTokenResource FullCellPadding}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeFullCellBorderThickness" Value="{atom:LunarCalendarTokenResource FullCellBorderThickness}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeRangeBarHeight" Value="{atom:LunarCalendarTokenResource RangeBarHeight}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeRangeBarGap" Value="{atom:LunarCalendarTokenResource RangeBarGap}" />
        <Setter Property="tokeninputs:CalendarHeader.ThemeRangeBarLabelPadding" Value="{atom:LunarCalendarTokenResource RangeBarLabelPadding}" />

    <ControlTheme.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="/Calendar/Themes/CalendarDateCellTheme.axaml" />
        </ResourceDictionary.MergedDictionaries>
        <!-- The cells take the LunarCalendar's Token owner (the Calendar forwards it to its DateViewer); this lunar-only cell
             theme reads LunarCalendar's Tokens explicitly; its base consumes terminal-supplied presentation inputs. -->
        <ControlTheme x:Key="LunarDateCellTheme" TargetType="viewer:DateViewerCell" BasedOn="{StaticResource CalendarDateCellTheme}">
            <Style Selector="^[Presentation=Content]:date:selected:not(:disabled) /template/ Border#PART_CellInner">
                <Setter Property="Background" Value="{atom:LunarCalendarTokenResource ColorPrimary}" />
                <Setter Property="CornerRadius" Value="{atom:LunarCalendarTokenResource BorderRadiusLG}" />
            </Style>
            <Style Selector="^[Presentation=Compact]:date /template/ Border#PART_Item">
                <Setter Property="Height" Value="{atom:LunarCalendarTokenResource MiniDateCellSize}" />
            </Style>
            <Style Selector="^[Presentation=Compact]:date /template/ Border#PART_CellInner">
                <Setter Property="Width" Value="{atom:LunarCalendarTokenResource MiniDateCellSize}" />
                <Setter Property="Height" Value="{atom:LunarCalendarTokenResource MiniDateCellSize}" />
            </Style>
            <Style Selector="^[Presentation=Compact]:month /template/ Border#PART_Item">
                <Setter Property="Height" Value="{atom:LunarCalendarTokenResource MiniDateCellSize}" />
            </Style>
            <Style Selector="^[Presentation=Compact]:month /template/ Border#PART_CellInner">
                <Setter Property="Width" Value="{atom:LunarCalendarTokenResource MiniMonthCellWidth}" />
                <Setter Property="Height" Value="{atom:LunarCalendarTokenResource MiniDateCellSize}" />
            </Style>
        </ControlTheme>
        <DataTemplate x:Key="LunarDefaultCellContent" x:DataType="controls:LunarCalendarCellContext">
            <calendar:LunarCalendarCellContent Classes.semantic-scope-lunar="True" Context="{Binding}"
                Presentation="{Binding $parent[viewer:DateViewerCell].Presentation}"
                HighlightWeekends="{Binding $parent[controls:LunarCalendar].HighlightWeekends}" />
        </DataTemplate>
        </ResourceDictionary>
    </ControlTheme.Resources>
    <ControlTheme.BasedOn>
        <themes:CalendarControlTheme TargetType="controls:LunarCalendar" />
    </ControlTheme.BasedOn>
    <Setter Property="DefaultDateCellTemplate" Value="{StaticResource LunarDefaultCellContent}" />
    <Setter Property="DateCellTheme" Value="{StaticResource LunarDateCellTheme}" />
</ControlTheme>
