<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Timeline}" TargetType="atom:Timeline">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:TimelineTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:TimelineTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:TimelineTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:TimelineTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.ForegroundConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedForeground" />
                <atom:TimelineTokenResource Kind="ColorText" WhenExplicit="True" />
                <atom:TimelineTokenResource Kind="ColorText" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                    <atom:ScrollViewer Name="ScrollViewer"
                                       IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                       AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}"
                                       HorizontalScrollBarVisibility="Disabled"
                                       VerticalScrollBarVisibility="Auto"
                                       IsScrollChainingEnabled="{TemplateBinding atom:ScrollViewer.IsScrollChainingEnabled}">
                        <ItemsPresenter Name="ItemsPresenter">
                            <ItemsPresenter.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <atomc:TimelineStackPanel
                                        Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=atom:Timeline}}"
                                        IsReverse="{Binding IsReverse, RelativeSource={RelativeSource AncestorType=atom:Timeline}}" />
                                </ItemsPanelTemplate>
                            </ItemsPresenter.ItemsPanel>
                        </ItemsPresenter>
                    </atom:ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="atom:ScrollViewer.IsScrollChainingEnabled" Value="False" />
        <Setter Property="TemplatedControl.BorderBrush"
                Value="{atom:TimelineTokenResource ColorBorder}" />
        <Setter Property="TemplatedControl.Background"
                Value="{atom:TimelineTokenResource ColorBgContainer}" />

    </ControlTheme>
</ResourceDictionary>
