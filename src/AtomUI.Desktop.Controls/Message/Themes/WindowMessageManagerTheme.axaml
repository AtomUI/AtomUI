<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:WindowMessageManager}" TargetType="atom:WindowMessageManager">
        <Setter Property="Padding" Value="{atom:MessageCardTokenResource MessageTopMargin}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Stacking structure: StackHost is anchored by placement and hugs the visible queue (the hover hit
                area equals the queue extent), the presenter fills StackHost, and the gap between cards is managed
                by FeedbackStackPanel through ExpandedGap; semantic-list-content marks the listContent part. layer:
                the outer element is the surface host; the focus strokes and badges of controls inside the cards
                land in its adorner layer, right next to this manager's cards. It has no background and takes no
                part in hit testing, so the hit area of StackHost is unchanged.
                -->
                <VisualLayerManager Name="PART_SurfaceHost"
                                    atom:LayerLadder.IsSurfaceHost="True">
                    <Grid Name="PART_StackHost"
                          Margin="{TemplateBinding Padding}"
                          ClipToBounds="False">
                        <!-- Backplates stay arranged while transparent and never contribute to the host extent. -->
                        <Panel Classes="message-backplates"
                              Width="0" Height="0"
                              HorizontalAlignment="Center"
                              ClipToBounds="False"
                              IsHitTestVisible="False">
                            <Border Name="PART_SecondBackplate"
                                    Classes="message-backplate"
                                    Classes.stack-hidden="{Binding !IsSecondBackplateVisible, ElementName=PART_Items}"
                                    Width="{Binding SecondBackplateWidth, ElementName=PART_Items}"
                                    Margin="{Binding SecondBackplateMargin, ElementName=PART_Items}" />
                            <Border Name="PART_FirstBackplate"
                                    Classes="message-backplate"
                                    Classes.stack-hidden="{Binding !IsFirstBackplateVisible, ElementName=PART_Items}"
                                    Width="{Binding FirstBackplateWidth, ElementName=PART_Items}"
                                    Margin="{Binding FirstBackplateMargin, ElementName=PART_Items}" />
                        </Panel>
                        <atom:FeedbackStackPresenter x:Name="PART_Items"
                                              Classes.semantic-list-content="True" />
                    </Grid>
                </VisualLayerManager>
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled" Value="{atom:WindowMessageManagerTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />

        <Style Selector="^ /template/ Panel.message-backplates">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <!-- Backplates echo the stacked message cards: they read the MessageCard Tokens like the cards they stand for. -->
        <Style Selector="^ /template/ Border.message-backplate">
            <!-- layout -->
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Background" Value="{atom:MessageCardTokenResource ContentBg}" />
            <Setter Property="BoxShadow" Value="{atom:MessageCardTokenResource BoxShadowsTertiary}" />
            <Setter Property="CornerRadius" Value="{atom:MessageCardTokenResource BorderRadiusLG}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <DoubleTransition Property="Width"
                                          atom:TokenTransitions.Duration="MotionDurationSlow"
                                          Easing="0.645,0.045,0.355,1" />
                        <DoubleTransition Property="Opacity"
                                          atom:TokenTransitions.Duration="MotionDurationFast"
                                          Easing="0.645,0.045,0.355,1" />
                        <TransformOperationsTransition Property="RenderTransform"
                                                       atom:TokenTransitions.Duration="MotionDurationFast"
                                                       Easing="0.645,0.045,0.355,1" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
            <Style Selector="^.stack-hidden">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="RenderTransform" Value="translate(0px, 16px)" />
            </Style>
        </Style>

        <Style Selector="^[Position=BottomLeft] /template/ Panel.message-backplates,
                         ^[Position=BottomCenter] /template/ Panel.message-backplates,
                         ^[Position=BottomRight] /template/ Panel.message-backplates">
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[Position=BottomLeft] /template/ Border.message-backplate,
                         ^[Position=BottomCenter] /template/ Border.message-backplate,
                         ^[Position=BottomRight] /template/ Border.message-backplate">
            <Style Selector="^.stack-hidden">
                <Setter Property="RenderTransform" Value="translate(0px, -16px)" />
            </Style>
        </Style>

        <Style Selector="^[Position=TopLeft] /template/ Grid#PART_StackHost">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=TopCenter] /template/ Grid#PART_StackHost">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=TopRight] /template/ Grid#PART_StackHost">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=BottomLeft] /template/ Grid#PART_StackHost">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[Position=BottomCenter] /template/ Grid#PART_StackHost">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[Position=BottomRight] /template/ Grid#PART_StackHost">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[IsMotionEnabled=False] /template/ Border#PART_FirstBackplate">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="^[IsMotionEnabled=False] /template/ Border#PART_SecondBackplate">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
