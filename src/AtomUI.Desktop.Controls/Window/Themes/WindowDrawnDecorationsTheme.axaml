<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net"
                    xmlns:antdicons="https://atomui.net/icons/antdesign"
                    xmlns:converters="using:Avalonia.Controls.Converters"
                    x:Class="AtomUI.Desktop.Controls.Themes.WindowDrawnDecorationsTheme"
                    x:ClassModifier="internal">
    <converters:CornerRadiusFilterConverter x:Key="TitleBarCornerRadiusFilter" Filter="TopLeft, TopRight" />

    <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
        <Setter Property="Template">
            <WindowDrawnDecorationsTemplate>
                <WindowDrawnDecorationsContent>
                    <WindowDrawnDecorationsContent.Underlay>
                        <Panel Name="PART_UnderlayWrapper">
                            <Border Name="PART_WindowFrame" IsHitTestVisible="False"
                                    CornerRadius="{Binding $parent[atom:Window].CornerRadius}">
                                <ContentPresenter Name="WindowFrameLayer"
                                                  Content="{Binding $parent[atom:Window].WindowFrameLayer}"
                                                  Opacity="{Binding $parent[atom:Window].WindowFrameLayerOpacity}"
                                                  ContentTemplate="{Binding $parent[atom:Window].WindowFrameLayerTemplate}" />
                            </Border>

                            <ContentPresenter Name="PART_TitleBar"
                                              VerticalAlignment="Top"
                                              WindowDecorationProperties.ElementRole="TitleBar"
                                              Background="{Binding #PART_WindowFrame.Background}"
                                              Content="{Binding $parent[atom:Window].TitleBarFrameLayer}"
                                              ContentTemplate="{Binding $parent[atom:Window].TitleBarFrameLayerTemplate}"
                                              Opacity="{Binding $parent[atom:Window].TitleBarFrameLayerOpacity}"
                                              ClipToBounds="True"
                                              CornerRadius="{Binding #PART_WindowFrame.CornerRadius, Converter={StaticResource TitleBarCornerRadiusFilter}}"
                                              Height="{TemplateBinding TitleBarHeight}">
                                <ContentPresenter.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="HasTitleBar" />
                                        <Binding Path="$parent[atom:Window].IsTitleBarVisible" />
                                    </MultiBinding>
                                </ContentPresenter.IsVisible>
                            </ContentPresenter>
                        </Panel>
                    </WindowDrawnDecorationsContent.Underlay>

                    <WindowDrawnDecorationsContent.Overlay>
                        <Panel IsVisible="{Binding $parent[atom:Window].IsDrawnChromeOverlayVisible}">
                            <atom:WindowTitleBarShadowBackground
                                IsHitTestVisible="False"
                                Fill="{Binding $parent[atom:Window].TitleBarFrameBackground}"
                                ShadowThickness="{TemplateBinding ShadowThickness}"
                                TitleBarHeight="{TemplateBinding TitleBarHeight}"
                                CornerRadius="{Binding $parent[atom:Window].CornerRadius, Converter={StaticResource TitleBarCornerRadiusFilter}}"
                                OsType="{Binding $parent[atom:Window].OsType}">
                                <atom:WindowTitleBarShadowBackground.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="HasTitleBar" />
                                        <Binding Path="$parent[atom:Window].IsTitleBarVisible" />
                                    </MultiBinding>
                                </atom:WindowTitleBarShadowBackground.IsVisible>
                            </atom:WindowTitleBarShadowBackground>
                            <Panel Name="PART_OverlayWrapper">
                                <Border ClipToBounds="True"
                                        CornerRadius="{Binding $parent[atom:Window].CornerRadius, Converter={StaticResource TitleBarCornerRadiusFilter}}">
                                    <ContentPresenter Name="PART_TitleBarPresenter"
                                                      VerticalAlignment="Top"
                                                      Height="{TemplateBinding TitleBarHeight}"
                                                      Content="{Binding $parent[atom:Window].TitleBar}"
                                                      WindowDecorationProperties.ElementRole="User">
                                        <ContentPresenter.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="HasTitleBar" />
                                                <Binding Path="$parent[atom:Window].IsTitleBarVisible" />
                                            </MultiBinding>
                                        </ContentPresenter.IsVisible>
                                    </ContentPresenter>
                                </Border>
                            </Panel>
                            <!-- Win10 扩展客户区下 DWM 顶边边框被客户区覆盖，这里补画同色 1px 顶边；
                                 Win11 与其他平台由 DWM/窗口管理器绘制，不启用该层。 -->
                            <Border Name="PART_LegacyFrameTopBorderActive"
                                    Height="{Binding $parent[atom:Window].LegacyWindowsFrameBorderThickness}"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False"
                                    Background="{atom:WindowTokenResource FrameBorderActive}">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="$parent[atom:Window].IsLegacyWindowsFrameBorderVisible" />
                                        <Binding Path="$parent[atom:Window].IsActive" />
                                    </MultiBinding>
                                </Border.IsVisible>
                            </Border>
                            <Border Name="PART_LegacyFrameTopBorderInactive"
                                    Height="{Binding $parent[atom:Window].LegacyWindowsFrameBorderThickness}"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False"
                                    Background="{atom:WindowTokenResource FrameBorderInactive}">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="$parent[atom:Window].IsLegacyWindowsFrameBorderVisible" />
                                        <Binding Path="$parent[atom:Window].IsActive" Converter="{x:Static BoolConverters.Not}" />
                                    </MultiBinding>
                                </Border.IsVisible>
                            </Border>
                        </Panel>
                    </WindowDrawnDecorationsContent.Overlay>

                    <WindowDrawnDecorationsContent.FullscreenPopover>
                        <Border Name="FullscreenHeaderFrame"
                                VerticalAlignment="Top"
                                Height="{TemplateBinding DefaultTitleBarHeight}"
                                WindowDecorationProperties.ElementRole="User">
                            <atom:WindowTitleBarLayoutPanel
                                Padding="{atom:WindowTokenResource FullscreenHeaderFramePadding}"
                                TitleAlignment="{Binding $parent[atom:Window].TitleAlignment}"
                                OsType="{Binding $parent[atom:Window].OsType}"
                                NativeChromeInsets="0"
                                IsCsdEnabled="{Binding $parent[atom:Window].IsCsdEnabled}"
                                WindowState="FullScreen"
                                HorizontalSpacing="{atom:WindowTitleBarTokenResource HeaderHorizontalSpacing}"
                                ClipToBounds="True">
                                <Panel atom:WindowTitleBarLayoutPanel.Role="Leading" />
                                <DockPanel atom:WindowTitleBarLayoutPanel.Role="Title"
                                           LastChildFill="True"
                                           HorizontalSpacing="{atom:WindowTitleBarTokenResource LogoAndTitleSpacing}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           ClipToBounds="True">
                                    <ContentPresenter Name="FullscreenLogoPresenter"
                                                      DockPanel.Dock="Left"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      HorizontalContentAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Content="{Binding $parent[atom:Window].EffectiveFullscreenLogo}"
                                                      ContentTemplate="{Binding $parent[atom:Window].EffectiveFullscreenLogoTemplate}"
                                                      IsVisible="{Binding $parent[atom:Window].IsEffectiveFullscreenLogoVisible}"/>
                                    <TextBlock Name="FullscreenTitleText"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding $parent[atom:Window].Title}"
                                               IsVisible="{Binding $parent[atom:Window].IsEffectiveFullscreenTitleVisible}" />
                                </DockPanel>
                                
                                <StackPanel Name="CaptionButtonGroup"
                                            atom:WindowTitleBarLayoutPanel.Role="Trailing"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <atom:CaptionButton
                                        Name="PART_FullScreenButton"
                                        IsChecked="True"
                                        IsVisible="{Binding $parent[atom:Window].IsFullScreenCaptionButtonVisible}"
                                        WindowDecorationProperties.ElementRole="FullScreenButton">
                                        <atom:CaptionButton.NormalIcon>
                                            <antdicons:FullscreenOutlined />
                                        </atom:CaptionButton.NormalIcon>
                                        <atom:CaptionButton.CheckedIcon>
                                            <antdicons:FullscreenExitOutlined />
                                        </atom:CaptionButton.CheckedIcon>
                                    </atom:CaptionButton>
                                    
                                    <atom:CaptionButton
                                        Name="PART_CloseButton"
                                        IsVisible="{Binding $parent[atom:Window].IsCloseCaptionButtonVisible}"
                                        WindowDecorationProperties.ElementRole="CloseButton">
                                        <atom:CaptionButton.NormalIcon>
                                            <antdicons:WindowCloseOutlined />
                                        </atom:CaptionButton.NormalIcon>
                                    </atom:CaptionButton>
                                </StackPanel>
                            </atom:WindowTitleBarLayoutPanel>
                        </Border>
                    </WindowDrawnDecorationsContent.FullscreenPopover>

                </WindowDrawnDecorationsContent>
            </WindowDrawnDecorationsTemplate>
        </Setter>

        <Setter Property="DefaultTitleBarHeight" Value="{atom:WindowTokenResource TitleBarHeight}" />
        <Setter Property="DefaultShadowThickness" Value="{Binding $parent[atom:Window].FrameShadowThickness}" />
        <Setter Property="DefaultFrameThickness" Value="1" />

        <Style Selector="^/template/ Border#PART_WindowFrame">
            <Setter Property="Background" Value="{atom:WindowTokenResource DefaultBackground}" />
        </Style>

        <Style Selector="^:has-shadow /template/ Border#PART_WindowFrame">
            <Setter Property="BoxShadow" Value="{atom:WindowTokenResource FrameShadows}" />
        </Style>

        <Style Selector="^:has-shadow /template/ Panel#PART_UnderlayWrapper">
            <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
        </Style>
        <Style Selector="^:has-shadow /template/ Panel#PART_OverlayWrapper">
            <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
        </Style>

        <Style Selector="^:has-border /template/ ContentPresenter#PART_TitleBarPresenter">
            <Setter Property="Margin" Value="1,1,1,0" />
        </Style>

        <Style Selector="^:has-border /template/ ContentPresenter#PART_TitleBar">
            <Setter Property="Margin" Value="1,1,1,0" />
        </Style>

        <Style Selector="^:maximized /template/ Border#PART_WindowFrame">
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="^:fullscreen /template/ ContentPresenter#PART_TitleBarPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:fullscreen /template/ ContentPresenter#PART_TitleBar">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:fullscreen /template/ Border#FullscreenHeaderFrame">
            <Setter Property="Background" Value="{atom:WindowTokenResource DefaultBackground}" />
            <Setter Property="BoxShadow" Value="{atom:WindowTokenResource FullscreenPopoverShadows}" />
        </Style>
        
        <Style Selector="^:fullscreen /template/ TextBlock#FullscreenTitleText">
            <Setter Property="Foreground" Value="{atom:WindowTitleBarTokenResource ActiveColor}" />
            <Setter Property="FontSize" Value="{atom:WindowTitleBarTokenResource TitleFontSize}" />
            <Setter Property="FontWeight" Value="{atom:WindowTitleBarTokenResource TitleFontWeight}" />
        </Style>
        
        <Style Selector="^:fullscreen /template/ ContentPresenter#FullscreenLogoPresenter">
            <Setter Property="Width" Value="{atom:WindowTitleBarTokenResource LogoSize}" />
            <Setter Property="Height" Value="{atom:WindowTitleBarTokenResource LogoSize}" />
        </Style>
        
        <Style Selector="^:fullscreen /template/ atom|CaptionButton">
            <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
            <Setter Property="IsWindowActive" Value="True" />
            <Setter Property="IconWidth" Value="{atom:WindowTitleBarTokenResource CaptionButtonIconSize}" />
            <Setter Property="IconHeight" Value="{atom:WindowTitleBarTokenResource CaptionButtonIconSize}" />
            <Setter Property="Width" Value="{atom:WindowTitleBarTokenResource FullscreenCaptionButtonSize}" />
            <Setter Property="Height" Value="{atom:WindowTitleBarTokenResource FullscreenCaptionButtonSize}" />
        </Style>
        <Style Selector="^:fullscreen /template/ StackPanel#CaptionButtonGroup">
            <Setter Property="Spacing" Value="{atom:WindowTitleBarTokenResource CaptionGroupSpacing}" />
        </Style>
    
    </ControlTheme>

</ResourceDictionary>
