<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Tour}" TargetType="atom:Tour">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:Tour">
                <atom:Popup Name="PART_Popup"
                            WindowManagerAddShadowHint="False"
                            IsLightDismissEnabled="False"
                            IsMotionEnabled="False"
                            IsPopupPinnedOpen="{TemplateBinding IsPopupPinnedOpen}"
                            ShouldUseOverlayLayer="True">
                    <atom:ArrowDecoratedBox Name="{x:Static atom:AbstractArrowDecoratedBox.ArrowDecoratorPart}"
                                            Classes.semantic-popup-root="True"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontSize="{TemplateBinding FontSize}"
                                            IsArrowVisible="{TemplateBinding CurrentArrowVisible}"
                                            ArrowPosition="{TemplateBinding ArrowPosition}">
                        <atom:TourStepsView Name="StepsView"
                                            ItemsSource="{Binding Steps, RelativeSource={RelativeSource TemplatedParent}}"
                                            SelectedIndex="{TemplateBinding CurrentIndex, Mode=TwoWay}"
                                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                            StyleType="{TemplateBinding StyleType}"
                                            IsArrowVisible="{TemplateBinding IsArrowVisible}"
                                            IsPointAtCenter="{TemplateBinding IsPointAtCenter}"
                                            Placement="{TemplateBinding Placement}"
                                            IsShowMask="{TemplateBinding IsShowMask}"
                                            MaskColor="{TemplateBinding MaskColor}"
                                            CloseIcon="{TemplateBinding CloseIcon}"
                                            IsScrollIntoView="{TemplateBinding IsScrollIntoView}"
                                            CurrentStyleType="{TemplateBinding CurrentStyleType}"
                                            Indicator="{TemplateBinding Indicator}"/>
                    </atom:ArrowDecoratedBox>
                </atom:Popup>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="MaskColor" Value="{atom:OwnerTokenResource Kind=ColorBgMask, AnchorControlType={x:Type atom:Tour}}" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        
        <Style Selector="^ /template/ atom|ArrowDecoratedBox#PART_ArrowDecorator">
            <Setter Property="CornerRadius" Value="{atom:TourTokenResource TourBorderRadius}" />
            <Setter Property="Background" Value="{atom:OwnerTokenResource Kind=ColorBgElevated, AnchorControlType={x:Type atom:Tour}}" />
        </Style>
        
        <Style Selector="^ /template/ atom|ArrowDecoratedBox#PART_ArrowDecorator">
            <Setter Property="Background" Value="{atom:OwnerTokenResource Kind=ColorBgElevated, AnchorControlType={x:Type atom:Tour}}" />
        </Style>
        
        <Style Selector="^[StyleType=Primary]">
            <Style Selector="^ /template/ atom|ArrowDecoratedBox#PART_ArrowDecorator">
                <Setter Property="Background" Value="{atom:OwnerTokenResource Kind=ColorPrimary, AnchorControlType={x:Type atom:Tour}}" />
            </Style>
        </Style>
                
        <Setter Property="CloseIcon">
            <atom:IconTemplate><antdicons:CloseOutlined/></atom:IconTemplate>
        </Setter>
        
    </ControlTheme>

    <ControlTheme x:Key="{x:Type atom:TourLayer}" TargetType="atom:TourLayer">
        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <atom:RectTransition Property="TargetRegion"
                                         Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}"
                                         Easing="CubicEaseOut" />
                    <DoubleTransition Property="TargetRegionCornerRadius"
                                      Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}"
                                      Easing="CubicEaseOut" />
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
