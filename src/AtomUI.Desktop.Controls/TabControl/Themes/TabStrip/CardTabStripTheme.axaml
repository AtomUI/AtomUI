<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CardTabStrip}" TargetType="atom:CardTabStrip">
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSize" Value="{atom:CardTabStripTokenResource TitleFontSize}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSizeLG" Value="{atom:CardTabStripTokenResource TitleFontSizeLG}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSizeSM" Value="{atom:CardTabStripTokenResource TitleFontSizeSM}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemMargin" Value="{atom:CardTabStripTokenResource HorizontalItemMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemColor" Value="{atom:CardTabStripTokenResource ItemColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemHoverColor" Value="{atom:CardTabStripTokenResource ItemHoverColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemSelectedColor" Value="{atom:CardTabStripTokenResource ItemSelectedColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemIconMargin" Value="{atom:CardTabStripTokenResource ItemIconMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeMenuIndicatorPaddingHorizontal" Value="{atom:CardTabStripTokenResource MenuIndicatorPaddingHorizontal}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeMenuIndicatorPaddingVertical" Value="{atom:CardTabStripTokenResource MenuIndicatorPaddingVertical}" />

        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowLeft" Value="{atom:CardTabStripTokenResource BoxShadowTabsOverflowLeft}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowRight" Value="{atom:CardTabStripTokenResource BoxShadowTabsOverflowRight}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowTop" Value="{atom:CardTabStripTokenResource BoxShadowTabsOverflowTop}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowBottom" Value="{atom:CardTabStripTokenResource BoxShadowTabsOverflowBottom}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCloseIconMargin" Value="{atom:CardTabStripTokenResource CloseIconMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardBg" Value="{atom:CardTabStripTokenResource CardBg}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardSize" Value="{atom:CardTabStripTokenResource CardSize}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardPadding" Value="{atom:CardTabStripTokenResource CardPadding}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardPaddingSM" Value="{atom:CardTabStripTokenResource CardPaddingSM}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardPaddingLG" Value="{atom:CardTabStripTokenResource CardPaddingLG}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeVerticalItemPadding" Value="{atom:CardTabStripTokenResource VerticalItemPadding}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCardGutter" Value="{atom:CardTabStripTokenResource CardGutter}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginHorizontal" Value="{atom:CardTabStripTokenResource AddTabButtonMarginHorizontal}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginVertical" Value="{atom:CardTabStripTokenResource AddTabButtonMarginVertical}" />

        <ControlTheme.BasedOn>
            <themes:BaseTabStripTheme TargetType="atom:CardTabStrip" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame">
                    <Panel Name="AlignWrapper">
                        <Border Padding="{TemplateBinding EffectiveHeaderPadding}">
                            <DockPanel LastChildFill="True" Name="HeaderLayout">
                                <ContentPresenter Name="HeaderStartExtraContent"
                                                  Content="{TemplateBinding HeaderStartExtraContent}"
                                                  ContentTemplate="{TemplateBinding HeaderStartExtraContentTemplate}" />
                                <ContentPresenter Name="HeaderEndExtraContent"
                                                  Content="{TemplateBinding HeaderEndExtraContent}"
                                                  ContentTemplate="{TemplateBinding HeaderEndExtraContentTemplate}" />
                                <atom:TabsContainerPanel Name="PART_TabsContainer"
                                                         TabStripPlacement="{TemplateBinding TabStripPlacement}">
                                <atom:TabsContainerPanel.TabScrollViewer>
                                    <atom:TabScrollViewer
                                        Name="PART_CardTabStripScrollViewer"
                                        IsScrollChainingEnabled="False"
                                        TabStripPlacement="{TemplateBinding TabStripPlacement}"
                                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                        IsPopupPinnedOpen="{TemplateBinding IsPopupPinnedOpen}"
                                        OverflowPopupTemplate="{TemplateBinding OverflowPopupTemplate}">
                                        <ItemsPresenter
                                            Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </atom:TabScrollViewer>
                                </atom:TabsContainerPanel.TabScrollViewer>
                                <atom:TabsContainerPanel.AddTabButton>
                                    <atom:IconButton Name="PART_AddTabButton"
                                                     Classes.semantic-add="True"
                                                     Icon="{antdicons:AntDesignIconProvider PlusOutlined}"
                                                     BorderThickness="{TemplateBinding CardBorderThickness}"
                                                     CornerRadius="{TemplateBinding EffectiveCardBorderRadius}"
                                                     IsVisible="{TemplateBinding IsShowAddTabButton}" />
                                </atom:TabsContainerPanel.AddTabButton>
                            </atom:TabsContainerPanel>
                                </DockPanel>
                        </Border>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="CardSize"
                Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardSize)}" />
        <Setter Property="CardBorderThickness"
                Value="{atom:CardTabStripTokenResource BorderThickness}" />
        
        <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
            <Setter Property="IconBrush"
                    Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeItemColor)}" />
            <Setter Property="IconWidth"
                    Value="{atom:CardTabStripTokenResource IconSize}" />
            <Setter Property="IconHeight"
                    Value="{atom:CardTabStripTokenResource IconSize}" />
            <Setter Property="BorderBrush"
                    Value="{atom:CardTabStripTokenResource ColorBorderSecondary}" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton:pointerover">
            <Setter Property="IconBrush"
                    Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeItemHoverColor)}" />
        </Style>

        <Style Selector="^[TabStripPlacement=Top]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="HorizontalSpacing" Value="{atom:CardTabStripTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ atom|TabsContainerPanel#PART_TabsContainer">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardGutter)}" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>

            <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
                <Setter Property="Margin"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginHorizontal)}" />
            </Style>

        </Style>

        <Style Selector="^[TabStripPlacement=Right]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="VerticalSpacing" Value="{atom:CardTabStripTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Bottom"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ atom|TabsContainerPanel#PART_TabsContainer">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardGutter)}" />
                <Setter Property="Orientation" Value="Vertical" />
            </Style>

            <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
                <Setter Property="Margin"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginVertical)}" />
            </Style>

        </Style>

        <Style Selector="^[TabStripPlacement=Bottom]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="HorizontalSpacing" Value="{atom:CardTabStripTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ atom|TabsContainerPanel#PART_TabsContainer">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardGutter)}" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>

            <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
                <Setter Property="Margin"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginHorizontal)}" />
            </Style>

        </Style>

        <Style Selector="^[TabStripPlacement=Left]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="VerticalSpacing" Value="{atom:CardTabStripTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ atom|TabsContainerPanel#PART_TabsContainer">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeCardGutter)}" />
                <Setter Property="Orientation" Value="Vertical" />
            </Style>

            <Style Selector="^ /template/ atom|IconButton#PART_AddTabButton">
                <Setter Property="Margin"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeAddTabButtonMarginVertical)}" />
            </Style>

        </Style>
        
        <Style Selector="^[SizeType=Large]">
            <Setter Property="CardBorderRadius"
                    Value="{atom:CardTabStripTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Setter Property="CardBorderRadius"
                    Value="{atom:CardTabStripTokenResource BorderRadius}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="CardBorderRadius"
                    Value="{atom:CardTabStripTokenResource BorderRadiusSM}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
