<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Masonry.MasonryShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Masonry"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             x:DataType="vm:MasonryViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Masonry"
                    Category="{gallery:MasonryShowCaseLangResource ComponentCategory}"
                    Status="{gallery:MasonryShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:MasonryShowCaseLangResource PageSubtitle}"
                    Description="{gallery:MasonryShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="ItemsControl"
                    MetadataValueWidth="220" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:MasonryViewModel">
                    <gallery:SemanticPartPreview
                        Name="MasonrySemanticPreview"
                        SemanticOwner="{Binding #MasonrySemanticOwner}"
                        SemanticOwnerType="{x:Type atom:Masonry}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:Masonry Name="MasonrySemanticOwner"
                                          ItemsSource="{Binding SemanticItems}"
                                          ColumnCount="3"
                                          ColumnGap="16"
                                          RowGap="16"
                                          HorizontalAlignment="Stretch">
                                <atom:Masonry.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MasonryBasicItem">
                                        <atom:Card SizeType="Small"
                                                   Height="{Binding Height}"
                                                   HorizontalAlignment="Stretch">
                                            <atom:TextBlock Text="{Binding Index}" />
                                        </atom:Card>
                                    </DataTemplate>
                                </atom:Masonry.ItemTemplate>
                            </atom:Masonry>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:MasonryShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="item"
                                Description="{gallery:MasonryShowCaseLangResource SemanticItemDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">

                <!-- Basic: 4-column masonry with varying-height cards, mirroring the Ant Design basic demo. -->
                <gallery:ShowCaseItem
                    Title="{gallery:MasonryShowCaseLangResource BasicTitle}"
                    Description="{gallery:MasonryShowCaseLangResource BasicDescription}"
                    IsDeferredContentEnabled="True"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MasonryViewModel">
                            <atom:Masonry ItemsSource="{Binding BasicItems}"
                                          ColumnCount="4"
                                          ColumnGap="16"
                                          RowGap="16"
                                          HorizontalAlignment="Stretch">
                                <atom:Masonry.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MasonryBasicItem">
                                        <Panel>
                                            <atom:Card SizeType="Small"
                                                       Height="{Binding Height}"
                                                       HorizontalAlignment="Stretch"
                                                       IsVisible="{Binding !IsSpecial}">
                                                <atom:TextBlock Text="{Binding Index}" />
                                            </atom:Card>
                                            <atom:Card SizeType="Small"
                                                       ClipToBounds="True"
                                                       HorizontalAlignment="Stretch"
                                                       IsVisible="{Binding IsSpecial}">
                                                <atom:Card.Cover>
                                                    <atom:AsyncImage Name="SpecialCoverImage"
                                                                     Source="{Binding CoverSource}"
                                                                     MinHeight="210"
                                                                     ClipToBounds="True"
                                                                     Stretch="UniformToFill">
                                                        <atom:AsyncImage.LoadingContent>
                                                            <Border Name="SpecialCoverSkeleton"
                                                                    Padding="16,16">
                                                                <atom:Skeleton IsLoading="True"
                                                                               IsActive="True"
                                                                               IsShowAvatar="False"
                                                                               IsShowTitle="True"
                                                                               ParagraphRows="3"
                                                                               IsRound="True" />
                                                            </Border>
                                                        </atom:AsyncImage.LoadingContent>
                                                    </atom:AsyncImage>
                                                </atom:Card.Cover>
                                                <atom:CardMetaContent Header="{Binding Title}"
                                                                      Content="{Binding Description}" />
                                            </atom:Card>
                                        </Panel>
                                    </DataTemplate>
                                </atom:Masonry.ItemTemplate>
                            </atom:Masonry>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <!-- Responsive: mirrors the Ant Design responsive demo with breakpoint columns and gutter. -->
                <gallery:ShowCaseItem
                    Title="{gallery:MasonryShowCaseLangResource ResponsiveTitle}"
                    Description="{gallery:MasonryShowCaseLangResource ResponsiveDescription}"
                    IsDeferredContentEnabled="True"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MasonryViewModel">
                            <atom:Masonry ItemsSource="{Binding ResponsiveItems}"
                                          ColumnInfo="xs: 1, sm: 2, md: 3, lg: 4"
                                          Gutter="xs: 8, sm: 12, md: 16; xs: 8, sm: 12, md: 16"
                                          HorizontalAlignment="Stretch">
                                <atom:Masonry.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MasonryBasicItem">
                                        <atom:Card SizeType="Small"
                                                   Height="{Binding Height}"
                                                   HorizontalAlignment="Stretch">
                                            <atom:TextBlock Text="{Binding Index}" />
                                        </atom:Card>
                                    </DataTemplate>
                                </atom:Masonry.ItemTemplate>
                            </atom:Masonry>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <!-- Image: mirrors the Ant Design image demo with natural image heights. -->
                <gallery:ShowCaseItem
                    Title="{gallery:MasonryShowCaseLangResource ImageTitle}"
                    Description="{gallery:MasonryShowCaseLangResource ImageDescription}"
                    IsDeferredContentEnabled="True"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MasonryViewModel">
                            <atom:Masonry ItemsSource="{Binding ImageItems}"
                                          ColumnCount="4"
                                          ColumnGap="16"
                                          RowGap="16"
                                          HorizontalAlignment="Stretch">
                                <atom:Masonry.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MasonryImageItem">
                                        <atom:AsyncImage Name="MasonryImage"
                                                         Source="{Binding ImageSource}"
                                                         ClipToBounds="True"
                                                         Stretch="Uniform"
                                                         HorizontalAlignment="Stretch">
                                            <atom:AsyncImage.LoadingContent>
                                                <Border Name="MasonryImageSkeleton"
                                                        MinHeight="210"
                                                        Padding="16,16">
                                                    <atom:Skeleton IsLoading="True"
                                                                   IsActive="True"
                                                                   IsShowAvatar="False"
                                                                   IsShowTitle="True"
                                                                   ParagraphRows="3"
                                                                   IsRound="True" />
                                                </Border>
                                            </atom:AsyncImage.LoadingContent>
                                        </atom:AsyncImage>
                                    </DataTemplate>
                                </atom:Masonry.ItemTemplate>
                            </atom:Masonry>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <!-- Dynamic: mirrors the Ant Design dynamic demo and persists effective item columns. -->
                <gallery:ShowCaseItem
                    Title="{gallery:MasonryShowCaseLangResource DynamicTitle}"
                    Description="{gallery:MasonryShowCaseLangResource DynamicDescription}"
                    IsDeferredContentEnabled="True"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MasonryViewModel">
                            <StackPanel Spacing="16">
                                <atom:Masonry ItemsSource="{Binding DynamicItems}"
                                              ColumnCount="4"
                                              ColumnGap="16"
                                              RowGap="16"
                                              HorizontalAlignment="Stretch"
                                              LayoutChanged="HandleDynamicMasonryLayoutChanged">
                                    <atom:Masonry.ItemContainerTheme>
                                        <ControlTheme TargetType="ContentPresenter"
                                                      x:DataType="vm:MasonryDynamicItem">
                                            <Setter Property="atom:Masonry.Column"
                                                    Value="{CompiledBinding Column}" />
                                        </ControlTheme>
                                    </atom:Masonry.ItemContainerTheme>
                                    <atom:Masonry.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MasonryDynamicItem">
                                            <atom:Card SizeType="Small"
                                                       Height="{Binding Height}"
                                                       HorizontalAlignment="Stretch">
                                                <Grid>
                                                    <atom:TextBlock Text="{Binding DisplayText}" />
                                                    <atom:Button SizeType="Small"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                                                                 Click="HandleRemoveDynamicMasonryItemClick" />
                                                </Grid>
                                            </atom:Card>
                                        </DataTemplate>
                                    </atom:Masonry.ItemTemplate>
                                </atom:Masonry>
                                <atom:Button HorizontalAlignment="Stretch"
                                             Command="{Binding AddDynamicMasonryItemCommand}"
                                             Content="{gallery:MasonryShowCaseLangResource DynamicAddItemLabel}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:MasonryShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:MasonryShowCaseLangResource SemanticPartStyleDescription}"
                    SourceKey="masonry-semantic-part"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    Span="Full"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:MasonryViewModel">
                            <StackPanel Spacing="24"
                                        HorizontalAlignment="Stretch">
                                <StackPanel.Styles>
                                    <Style Selector="atom|Masonry.semantic-style-demo.semantic-object-styles">
                                        <Setter Property="Background" Value="#FAFAFA" />
                                        <Setter Property="BorderBrush" Value="#D9D9D9" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="12" />
                                        <Setter Property="Padding" Value="16" />
                                        <Setter Property="Height" Value="260" />
                                        <atom:MasonryItemStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#CCCCCC" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="12" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="16,12" />
                                        </atom:MasonryItemStyle>
                                    </Style>
                                    <Style Selector="atom|Masonry.semantic-style-demo.semantic-function-styles[ColumnCount=3]">
                                        <Setter Property="Background" Value="#F0F8FF" />
                                        <Setter Property="BorderBrush" Value="#1890FF" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="CornerRadius" Value="12" />
                                        <Setter Property="Padding" Value="16" />
                                        <Setter Property="Height" Value="280" />
                                        <atom:MasonryItemStyle x:SetterTargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#1890FF" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="12" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="16,12" />
                                        </atom:MasonryItemStyle>
                                    </Style>
                                </StackPanel.Styles>

                                <StackPanel Spacing="12">
                                    <atom:TextBlock Text="{gallery:MasonryShowCaseLangResource SemanticObjectStylesTitle}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold" />
                                    <atom:Masonry Name="MasonrySemanticObject"
                                                  Classes="semantic-style-demo semantic-object-styles"
                                                  ColumnCount="4"
                                                  ColumnGap="16"
                                                  RowGap="16"
                                                  HorizontalAlignment="Stretch">
                                        <Border Height="120">
                                            <atom:TextBlock Text="1" />
                                        </Border>
                                        <Border Height="80">
                                            <atom:TextBlock Text="2" />
                                        </Border>
                                        <Border Height="100">
                                            <atom:TextBlock Text="3" />
                                        </Border>
                                        <Border Height="60">
                                            <atom:TextBlock Text="4" />
                                        </Border>
                                        <Border Height="140">
                                            <atom:TextBlock Text="5" />
                                        </Border>
                                        <Border Height="90">
                                            <atom:TextBlock Text="6" />
                                        </Border>
                                        <Border Height="110">
                                            <atom:TextBlock Text="7" />
                                        </Border>
                                        <Border Height="70">
                                            <atom:TextBlock Text="8" />
                                        </Border>
                                    </atom:Masonry>
                                </StackPanel>

                                <StackPanel Spacing="12">
                                    <atom:TextBlock Text="{gallery:MasonryShowCaseLangResource SemanticFunctionStylesTitle}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold" />
                                    <atom:Masonry Name="MasonrySemanticFunction"
                                                  Classes="semantic-style-demo semantic-function-styles"
                                                  ColumnCount="3"
                                                  ColumnGap="16"
                                                  RowGap="16"
                                                  HorizontalAlignment="Stretch">
                                        <Border Height="120">
                                            <atom:TextBlock Text="1" />
                                        </Border>
                                        <Border Height="80">
                                            <atom:TextBlock Text="2" />
                                        </Border>
                                        <Border Height="100">
                                            <atom:TextBlock Text="3" />
                                        </Border>
                                        <Border Height="60">
                                            <atom:TextBlock Text="4" />
                                        </Border>
                                        <Border Height="140">
                                            <atom:TextBlock Text="5" />
                                        </Border>
                                        <Border Height="90">
                                            <atom:TextBlock Text="6" />
                                        </Border>
                                    </atom:Masonry>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
