    <unit id="PageDescription">
      <segment>
        <source>TreeSelect combines an input selector with tree navigation, making it suitable for hierarchical categories, organization nodes, permissions, and other nested option sets.</source>
        <target state="translated">TreeSelect 将输入选择器与树形导航结合，适用于层级分类、组织节点、权限和其他嵌套选项集合。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Select values from hierarchical data in a compact input.</source>
        <target state="translated">在紧凑输入框中从层级数据里选择值。</target>
      </segment>
    </unit>
    <unit id="PlacementDescription">
      <segment>
        <source>You can manually specify the position of the popup via placement.</source>
