<?xml version="1.0" encoding="utf-8"?>
<xliff version="2.1" srcLang="en-US" trgLang="zh-CN" xmlns="urn:oasis:names:tc:xliff:document:2.0">
  <file id="AtomUIGallery.Localization.SplashShowCaseLangResourceKind">
    <unit id="BasicDescription">
      <segment>
        <source>Use the visual Splash control to show startup copy with an indeterminate loading indicator.</source>
        <target state="translated">使用 Splash 视觉控件展示启动文案和不确定加载指示。</target>
      </segment>
    </unit>
    <unit id="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基础</target>
      </segment>
    </unit>
    <unit id="ComponentCategory">
      <segment>
        <source>Other</source>
        <target state="translated">其他</target>
      </segment>
    </unit>
    <unit id="ComponentIntroducedVersion">
      <segment>
        <source>v6.0.7</source>
        <target state="translated">v6.0.7</target>
      </segment>
    </unit>
    <unit id="ComponentStatusPreview">
      <segment>
        <source>Preview</source>
        <target state="translated">预览</target>
      </segment>
    </unit>
    <unit id="DeterminateDescription">
      <segment>
        <source>Set Progress and disable IsIndeterminate when startup has measurable phases.</source>
        <target state="translated">当启动流程有可度量阶段时，设置 Progress 并关闭 IsIndeterminate。</target>
      </segment>
    </unit>
    <unit id="DeterminateTitle">
      <segment>
        <source>Determinate progress</source>
        <target state="translated">确定进度</target>
      </segment>
    </unit>
    <unit id="ErrorDescription">
      <segment>
        <source>Set Status to Error to switch the splash to its failure presentation; the user can then dismiss it.</source>
        <target state="translated">将 Status 设为 Error 可切换到失败呈现，之后用户可关闭该启动页。</target>
      </segment>
    </unit>
    <unit id="ErrorMessage">
      <segment>
        <source>Startup failed</source>
        <target state="translated">启动失败</target>
      </segment>
    </unit>
    <unit id="ErrorTitle">
      <segment>
        <source>Error state</source>
        <target state="translated">错误状态</target>
      </segment>
    </unit>
    <unit id="P2MessagePreparingShell">
      <segment>
        <source>Preparing workspace</source>
        <target state="translated">正在准备工作区</target>
      </segment>
    </unit>
    <unit id="PageDescription">
      <segment>
        <source>Splash draws the startup surface shown before the main window appears: brand logo, loading indicator or determinate progress, and status copy. Enable it with UseSplash on the AtomUIBuilder.</source>
        <target state="translated">Splash 绘制主窗体出现之前的启动呈现：品牌徽标、加载指示或确定进度、状态文案。通过 AtomUIBuilder 上的 UseSplash 启用。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Present desktop startup progress before the main workspace is ready.</source>
        <target state="translated">在主工作区准备完成前呈现桌面启动进度。</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
  </file>
