<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ColorPickerView}" TargetType="atom:ColorPickerView">
        <ControlTheme.BasedOn>
            <themes:AbstractColorPickerViewTheme TargetType="atom:ColorPickerView" />
        </ControlTheme.BasedOn>

        <Setter Property="Template">
            <ControlTemplate TargetType="atom:AbstractColorPickerView">
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        Margin="{TemplateBinding Margin}"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        ClipToBounds="False">
                    <StackPanel Name="PART_LayoutRoot"
                                Orientation="Horizontal" ClipToBounds="False">
                        <atom:ColorPickerPaletteGroup
                            Name="PART_PaletteGroup"
                            PaletteGroup="{TemplateBinding PaletteGroup}"
                            IsVisible="{TemplateBinding IsPaletteGroupEnabled}"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}" />
                        <atom:PixelAlignedBorder Name="Separator"
                                                 VerticalAlignment="Stretch"
                                                 Width="1"
                                                 IsVisible="{TemplateBinding IsPaletteGroupEnabled}" />
                        <StackPanel Orientation="Vertical"
                                    ClipToBounds="False"
                                    Spacing="{atom:SharedTokenResource SpacingXS}">
                            <atom:ColorBlock Name="PART_ClearColor"
                                             HorizontalAlignment="Right"
                                             IsEmptyColorMode="True"
                                             IsVisible="{TemplateBinding IsClearEnabled}" />
                            <atom:GradientColorSlider
                                Name="PART_GradientColorSlider"
                                ActivatedHsvValue="{TemplateBinding HsvValue, Mode=TwoWay}" />
                            <StackPanel Orientation="Vertical" Name="ColorPickerContainer" ClipToBounds="False">
                                <atom:ColorSpectrum
                                    Name="ColorSpectrum"
                                    Components="SaturationValue"
                                    HsvColor="{TemplateBinding HsvValue, Mode=TwoWay}"
                                    MaxHue="{TemplateBinding MaxHue}"
                                    MaxSaturation="{TemplateBinding MaxSaturation}"
                                    MaxValue="{TemplateBinding MaxValue}"
                                    MinHue="{TemplateBinding MinHue}"
                                    MinSaturation="{TemplateBinding MinSaturation}"
                                    MinValue="{TemplateBinding MinValue}" />
                                <DockPanel LastChildFill="True" ClipToBounds="False">
                                    <atom:ColorBlock Name="ColorPreview"
                                                     IsEmptyColorMode="{TemplateBinding IsEmptyDraft}"
                                                     Background="{TemplateBinding HsvColorBrush}"
                                                     DockPanel.Dock="Right"
                                                     Margin="0, 2, 0, 2" />
                                    <Panel Name="SliderContainer" ClipToBounds="False">
                                        <atom:ColorSlider Name="ColorSpectrumThirdComponentSlider" DockPanel.Dock="Top"
                                                          ColorModel="Hsva"
                                                          VerticalAlignment="Top"
                                                          HsvColor="{TemplateBinding HsvValue, Mode=TwoWay}"
                                                          IsVisible="{TemplateBinding IsColorSpectrumSliderVisible}"
                                                          ThumbColorValueBrush="{TemplateBinding HsvColorWithoutAlphaBrush}" />
                                        <atom:ColorSlider Name="ColorSpectrumAlphaSlider" DockPanel.Dock="Bottom"
                                                          ColorComponent="Alpha"
                                                          ColorModel="Hsva"
                                                          VerticalAlignment="Bottom"
                                                          HsvColor="{TemplateBinding HsvValue, Mode=TwoWay}"
                                                          IsVisible="{TemplateBinding IsAlphaEffectiveVisible}"
                                                          IsRoundingEnabled="True"
                                                          ThumbColorValueBrush="{TemplateBinding HsvColorBrush}" />
                                    </Panel>
                                </DockPanel>
                                <atom:ColorPickerInput Name="PART_ColorInput"
                                                       IsNeedConfirm="{TemplateBinding IsNeedConfirm}"
                                                       IsInputValid="{TemplateBinding CanConfirm, Mode=TwoWay}"
                                                       ColorValue="{TemplateBinding HsvValue, Mode=TwoWay}"
                                                       Format="{TemplateBinding Format, Mode=TwoWay}"
                                                       IsFormatEnabled="{TemplateBinding IsFormatEnabled, Mode=TwoWay}"
                                                       IsAlphaVisible="{TemplateBinding IsAlphaEffectiveVisible}"
                                                       IsClearEnabled="{TemplateBinding IsClearEnabled}" />
                            </StackPanel>
                            <StackPanel Name="PART_ConfirmationFooter"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="{atom:SharedTokenResource SpacingXS}"
                                        IsVisible="{TemplateBinding IsNeedConfirm}">
                                <atom:Button Name="PART_CancelButton"
                                             SizeType="Small"
                                             Content="{atom:ColorPickerLangResource Cancel}" />
                                <atom:Button Name="PART_ConfirmButton"
                                             SizeType="Small"
                                             ButtonType="Primary"
                                             IsEnabled="{TemplateBinding CanConfirm}"
                                             Content="{atom:ColorPickerLangResource Confirm}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
