<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.TreeSelect.TreeSelectShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.TreeSelect"
             x:DataType="vm:TreeSelectViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="TreeSelect"
                    Category="{gallery:TreeSelectShowCaseLangResource ComponentCategory}"
                    Status="{gallery:TreeSelectShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:TreeSelectShowCaseLangResource PageSubtitle}"
                    Description="{gallery:TreeSelectShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="TreeSelect"
                    MetadataValueWidth="220" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
                    <gallery:SemanticPartPreview Name="TreeSelectSemanticPreview"
                                                 Title="TreeSelect"
                                                 SemanticOwner="{Binding #TreeSelectSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:TreeSelect}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:TreeSelect Name="TreeSelectSemanticOwner"
                                             Width="420"
                                             IsAllowClear="True"
                                             IsMotionEnabled="False"
                                             IsDropDownOpen="True"
                                             IsPopupPinnedOpen="True"
                                             IsMultiple="True"
                                             IsFilterEnabled="True"
                                             IsDefaultExpandAll="True"
                                             ContentLeftAddOn="prefix"
                                             ItemsSource="{Binding SemanticPreviewTreeNodes}"
                                             SelectedItems="{Binding SemanticPreviewSelectedItems}"
                                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="prefix"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticPrefixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="placeholder"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticPlaceholderDescription}" />
                            <gallery:SemanticPartDescription
                                Path="input"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticInputDescription}" />
                            <gallery:SemanticPartDescription
                                Path="suffix"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticSuffixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="item"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticItemDescription}" />
                            <gallery:SemanticPartDescription
                                Path="itemContent"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticItemContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="itemRemove"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticItemRemoveDescription}" />
                            <gallery:SemanticPartDescription
                                Path="clear"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticClearDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.root"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticPopupRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.list"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticPopupListDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.listItem"
                                Description="{gallery:TreeSelectShowCaseLangResource SemanticPopupListItemDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource BasicTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource BasicDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <atom:TreeSelect Name="BasicTreeSelect"
                         HorizontalAlignment="Stretch"
                         IsDefaultExpandAll="True"
                         IsAllowClear="True"
                         IsFilterEnabled="True"
                         ItemsSource="{Binding BasicTreeNodes}"
                         PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource BindingTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource BindingDescription}"
        BadgeText="v6.0.8"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="16">
            <StackPanel Spacing="8">
                <TextBlock Text="{gallery:TreeSelectShowCaseLangResource BindingSingleLabel}"
                           FontWeight="SemiBold" />
                <atom:TreeSelect Name="BindingSingleTreeSelect"
                                 HorizontalAlignment="Stretch"
                                 IsDefaultExpandAll="True"
                                 IsAllowClear="True"
                                 IsFilterEnabled="True"
                                 ItemsSource="{Binding BindingSingleTreeNodes}"
                                 SelectedItem="{Binding BoundSelectedItem}"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                <WrapPanel ItemSpacing="8">
                    <atom:Button SizeType="Small"
                                 Command="{Binding SetBoundSelectedItemCommand}"
                                 Content="{gallery:TreeSelectShowCaseLangResource BindingSetSingleButton}" />
                    <atom:Button SizeType="Small"
                                 Command="{Binding ClearBoundSelectedItemCommand}"
                                 Content="{gallery:TreeSelectShowCaseLangResource BindingClearButton}" />
                </WrapPanel>
                <TextBlock Text="{gallery:TreeSelectShowCaseLangResource BindingViewModelValueLabel}" />
                <TextBlock Text="{Binding BoundSelectedItemText}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{gallery:TreeSelectShowCaseLangResource BindingMultipleLabel}"
                           FontWeight="SemiBold" />
                <atom:TreeSelect Name="BindingMultipleTreeSelect"
                                 HorizontalAlignment="Stretch"
                                 IsDefaultExpandAll="True"
                                 IsAllowClear="True"
                                 IsFilterEnabled="True"
                                 IsMultiple="True"
                                 ItemsSource="{Binding BindingMultipleTreeNodes}"
                                 SelectedItems="{Binding BoundSelectedItems}"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                <WrapPanel ItemSpacing="8">
                    <atom:Button SizeType="Small"
                                 Command="{Binding SetBoundSelectedItemsCommand}"
                                 Content="{gallery:TreeSelectShowCaseLangResource BindingSetMultipleButton}" />
                    <atom:Button SizeType="Small"
                                 Command="{Binding ClearBoundSelectedItemsCommand}"
                                 Content="{gallery:TreeSelectShowCaseLangResource BindingClearButton}" />
                </WrapPanel>
                <TextBlock Text="{gallery:TreeSelectShowCaseLangResource BindingViewModelValueLabel}" />
                <TextBlock Text="{Binding BoundSelectedItemsText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource MultipleSelectionTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource MultipleSelectionDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <atom:TreeSelect Name="MultiSelectionTreeSelect"
                         HorizontalAlignment="Stretch"
                         IsDefaultExpandAll="True"
                         IsAllowClear="True"
                         IsFilterEnabled="True"
                         IsMultiple="True"
                         ItemsSource="{Binding MultiSelectionTreeNodes}"
                         PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource GenerateFromTreeDataTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource GenerateFromTreeDataDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <atom:TreeSelect Name="ItemsSourceTreeSelect"
                         HorizontalAlignment="Stretch"
                         IsDefaultExpandAll="True"
                         IsAllowClear="True"
                         IsFilterEnabled="True"
                         ItemsSource="{Binding ItemsSourceTreeNodes}"
                         PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource CheckableTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource CheckableDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <atom:TreeSelect Name="CheckableTreeSelect"
                         HorizontalAlignment="Stretch"
                         IsDefaultExpandAll="True"
                         IsAllowClear="True"
                         IsFilterEnabled="True"
                         IsTreeCheckable="True"
                         ItemsSource="{Binding CheckableTreeNodes}"
                         PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                         ShowCheckedStrategy="ShowParent" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource AsynchronousLoadingTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource AsynchronousLoadingDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <atom:TreeSelect Name="AsyncLoadTreeSelect"
                         HorizontalAlignment="Stretch"
                         IsAllowClear="True"
                         ItemsSource="{Binding AsyncLoadTreeNodes}"
                         DataLoader="{Binding AsyncLoadTreeNodeLoader}"
                         PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource PlacementTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource PlacementDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:TextBlock VerticalAlignment="Center" Text="{gallery:TreeSelectShowCaseLangResource P2TextPlacement}" />
            <atom:OptionButtonGroup ButtonStyle="Outline"
                                    Name="PlacementOptionGroup"
                                    OptionCheckedChanged="HandlePlacementOptionCheckedChanged">
                <atom:OptionButton IsChecked="True" Content="{gallery:TreeSelectShowCaseLangResource P2ContentTopleft}" />
                <atom:OptionButton Content="{gallery:TreeSelectShowCaseLangResource P2ContentTopright}" />
                <atom:OptionButton Content="{gallery:TreeSelectShowCaseLangResource P2ContentBottomleft}" />
                <atom:OptionButton Content="{gallery:TreeSelectShowCaseLangResource P2ContentBottomright}" />
            </atom:OptionButtonGroup>
            <atom:TreeSelect Name="PlacementTreeSelect"
                             IsAllowClear="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             IsDefaultExpandAll="True"
                             IsFilterEnabled="True"
                             IsPopupMatchSelectWidth="False"
                             ItemsSource="{Binding PlacementTreeNodes}"
                             Placement="{Binding Placement}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource ShowTreeLineTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource ShowTreeLineDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ToggleSwitch OnContent="{gallery:TreeSelectShowCaseLangResource P2OnContentShowIcon}" OffContent="{gallery:TreeSelectShowCaseLangResource P2OffContentShowIcon}" Name="ShowIconSwitch"
                               IsChecked="{Binding IsShowTreeSelectIcon, Mode=TwoWay}" />
            <atom:ToggleSwitch OnContent="{gallery:TreeSelectShowCaseLangResource P2OnContentTreeLine}" OffContent="{gallery:TreeSelectShowCaseLangResource P2OffContentTreeLine}"
                               Name="ShowTreeLineSwitch"
                               IsChecked="{Binding IsShowTreeSelectLine, Mode=TwoWay}" />
            <atom:ToggleSwitch OnContent="{gallery:TreeSelectShowCaseLangResource P2OnContentShowLeafIcon}" OffContent="{gallery:TreeSelectShowCaseLangResource P2OffContentShowLeafIcon}" Name="ShowLeafIconSwitch"
                               IsChecked="{Binding IsShowTreeSelectLeafIcon, Mode=TwoWay}" />
            <atom:TreeSelect Name="ShowTreeLineTreeSelect"
                             HorizontalAlignment="Stretch"
                             IsAllowClear="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             ItemsSource="{Binding ShowTreeLineTreeNodes}"
                             IsShowIcon="{Binding IsShowTreeSelectIcon}"
                             IsShowLeafIcon="{Binding IsShowTreeSelectLeafIcon}"
                             IsShowLine="{Binding IsShowTreeSelectLine}"
                             IsSwitcherRotation="{Binding IsShowTreeSelectLine, Converter={x:Static BoolConverters.Not}}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource MaxCountTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource MaxCountDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:TreeSelect Name="MaxSelectedTreeSelect"
                             HorizontalAlignment="Stretch"
                             IsDefaultExpandAll="True"
                             IsMultiple="True"
                             IsAllowClear="True"
                             IsFilterEnabled="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             IsShowMaxCountIndicator="True"
                             ItemsSource="{Binding MaxSelectedTreeNodes}"
                             MaxCount="3" />
            <atom:TreeSelect Name="MaxCheckedTreeSelect"
                             HorizontalAlignment="Stretch"
                             IsDefaultExpandAll="True"
                             IsMultiple="True"
                             IsTreeCheckable="True"
                             IsAllowClear="True"
                             IsFilterEnabled="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             IsShowMaxCountIndicator="True"
                             ItemsSource="{Binding MaxCheckedTreeNodes}"
                             MaxCount="3" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource SizeTypeTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource SizeTypeDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel.Styles>
                <Style Selector="atom|TreeSelect.size-demo-tree-select[SizeType=Custom]">
                    <Setter Property="Height" Value="38" />
                    <Setter Property="FontSize" Value="15" />
                </Style>
            </StackPanel.Styles>
            <atom:OptionButtonGroup ButtonStyle="Outline" OptionCheckedChanged="HandleSizeTypeChanged">
                <atom:OptionButton Tag="{x:Static atom:CustomizableSizeType.Large}" Content="{gallery:TreeSelectShowCaseLangResource P2ContentLarge}" />
                <atom:OptionButton IsChecked="True" Tag="{x:Static atom:CustomizableSizeType.Middle}" Content="{gallery:TreeSelectShowCaseLangResource P2ContentDefault}" />
                <atom:OptionButton Tag="{x:Static atom:CustomizableSizeType.Small}" Content="{gallery:TreeSelectShowCaseLangResource P2ContentSmall}" />
                <atom:OptionButton Tag="{x:Static atom:CustomizableSizeType.Custom}" Content="{gallery:TreeSelectShowCaseLangResource P2ContentCustom}" />
            </atom:OptionButtonGroup>
            <atom:TreeSelect Classes="size-demo-tree-select"
                             Name="SizeTypeTreeSelectSingle"
                             Width="220"
                             SizeType="{Binding TreeSelectSizeType}"
                             IsAllowClear="True"
                             IsDefaultExpandAll="True"
                             IsFilterEnabled="False"
                             ItemsSource="{Binding SizeTypeTreeNodes}"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
            <atom:TreeSelect Classes="size-demo-tree-select"
                             Name="SizeTypeTreeSelectMultiple"
                             HorizontalAlignment="Stretch"
                             SizeType="{Binding TreeSelectSizeType}"
                             IsAllowClear="True"
                             IsDefaultExpandAll="True"
                             IsFilterEnabled="False"
                             IsMultiple="True"
                             ItemsSource="{Binding SizeTypeTreeNodes}"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource VariantsTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource VariantsDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:TreeSelect HorizontalAlignment="Stretch"
                             IsAllowClear="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             StyleVariant="Borderless" />
            <atom:TreeSelect HorizontalAlignment="Stretch"
                             IsAllowClear="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             StyleVariant="Filled" />
            <atom:TreeSelect HorizontalAlignment="Stretch"
                             IsAllowClear="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             StyleVariant="Outlined" />
            <atom:TreeSelect HorizontalAlignment="Stretch"
                             IsAllowClear="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             StyleVariant="Underlined" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource StatusTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource StatusDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:TreeSelect HorizontalAlignment="Stretch"
                             IsAllowClear="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             Status="Error" />
            <atom:TreeSelect HorizontalAlignment="Stretch"
                             IsAllowClear="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             Status="Warning" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource PrefixAndSuffixTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource PrefixAndSuffixDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:TreeSelect Name="SuffixIconTreeSelect"
                              HorizontalAlignment="Stretch"
                              IsAllowClear="True"
                              PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                              IsDefaultExpandAll="True"
                              SuffixIcon="{antdicons:AntDesignIconProvider SmileOutlined}"
                              IsFilterEnabled="True"
                              ItemsSource="{Binding ContentLeftAddTreeNodes}" />
            <atom:TreeSelect Name="ContentLeftAddTreeSelect"
                              HorizontalAlignment="Stretch"
                              IsAllowClear="True"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             IsDefaultExpandAll="True"
                             ContentLeftAddOn="{gallery:TreeSelectShowCaseLangResource P2AddOnPrefix}"
                             IsFilterEnabled="True"
                             ItemsSource="{Binding ContentLeftAddTreeNodes}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
                <gallery:ShowCaseItem
        Title="{gallery:TreeSelectShowCaseLangResource StyleClassTitle}"
        Description="{gallery:TreeSelectShowCaseLangResource StyleClassDescription}"
        SourceKey="treeselect-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TreeSelectViewModel">
        <StackPanel HorizontalAlignment="Left" Spacing="20">
            <StackPanel.Styles>
                <Style Selector="atom|TreeSelect.semantic-styles-demo">
                    <atom:TreeSelectPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#1890FF" />
                        </Style>
                    </atom:TreeSelectPrefixStyle>
                    <atom:TreeSelectSuffixStyle x:SetterTargetType="StackPanel">
                        <Setter Property="TextElement.Foreground" Value="#1890FF" />
                    </atom:TreeSelectSuffixStyle>
                    <atom:TreeSelectPopupRootStyle x:SetterTargetType="Border">
                        <Setter Property="BorderBrush" Value="#1890FF" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:TreeSelectPopupRootStyle>
                </Style>
                <Style Selector="atom|TreeSelect.semantic-styles-filled-demo">
                    <atom:TreeSelectPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#722ED1" />
                        </Style>
                    </atom:TreeSelectPrefixStyle>
                    <atom:TreeSelectSuffixStyle x:SetterTargetType="StackPanel">
                        <Setter Property="TextElement.Foreground" Value="#722ED1" />
                    </atom:TreeSelectSuffixStyle>
                    <atom:TreeSelectPopupRootStyle x:SetterTargetType="Border">
                        <Setter Property="BorderBrush" Value="#722ED1" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:TreeSelectPopupRootStyle>
                </Style>
            </StackPanel.Styles>
            <atom:TreeSelect Classes="semantic-styles-demo"
                             Name="ObjectStylesTreeSelect"
                             Width="300"
                             IsAllowClear="True"
                             IsDefaultExpandAll="True"
                             ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                             ItemsSource="{Binding StyleClassTreeNodes}"
                             PlaceholderText="Object" />
            <atom:TreeSelect Classes="semantic-styles-demo semantic-styles-filled-demo"
                             Name="FunctionStylesTreeSelect"
                             Width="300"
                             IsAllowClear="True"
                             IsDefaultExpandAll="True"
                             StyleVariant="Filled"
                             ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                             ItemsSource="{Binding StyleClassTreeNodes}"
                             PlaceholderText="Function" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
