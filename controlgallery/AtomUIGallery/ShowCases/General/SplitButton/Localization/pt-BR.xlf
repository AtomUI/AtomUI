    <unit id="PageDescription">
      <segment>
        <source>SplitButton combines a main command and a secondary flyout trigger, supporting size, danger style, primary style, custom indicators, and hover or click menus.</source>
        <target state="translated">SplitButton combines a main command e a secundário flyout gatilho, supporting tamanho, perigo estilo, primário estilo, personalizado indicators, e sobreposição ou clique menus.</target>
      </segment>
    </unit>
