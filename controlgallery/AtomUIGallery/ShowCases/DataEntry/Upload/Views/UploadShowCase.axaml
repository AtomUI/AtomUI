<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Upload.UploadShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Upload"
             x:DataType="vm:UploadViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Upload"
                    Category="{gallery:UploadShowCaseLangResource ComponentCategory}"
                    Status="{gallery:UploadShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:UploadShowCaseLangResource PageSubtitle}"
                    Description="{gallery:UploadShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="ContentControl" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
                    <gallery:SemanticPartPreview Name="UploadSemanticPreview"
                                                 SemanticOwner="{Binding #UploadSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:Upload}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:Upload Name="UploadSemanticOwner"
                                         AutoUpload="False"
                                         Files="{Binding DefaultFiles}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadTrigger SourceKind="Files">
                                        <Border HorizontalAlignment="Left"
                                                Background="#E6E6FA"
                                                CornerRadius="8"
                                                Padding="8">
                                            <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                         Content="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                                        </Border>
                                    </atom:UploadTrigger>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:UploadShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="list"
                                Description="{gallery:UploadShowCaseLangResource SemanticListDescription}" />
                            <gallery:SemanticPartDescription
                                Path="item"
                                Description="{gallery:UploadShowCaseLangResource SemanticItemDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource UploadByClickingTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource UploadByClickingDescription}">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="BasicUpload"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadTrigger SourceKind="Files">
                                        <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                     Content="{gallery:UploadShowCaseLangResource P2ContentClickToUpload}" />
                                    </atom:UploadTrigger>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource AvatarTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource AvatarDescription}">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <atom:Upload Name="AvatarDemoPictureCardUpload"
                                             ListType="PictureCard"
                                             UploadTransport="{Binding UploadTransport}"
                                             UploadTaskFailed="HandleUploadFailed"
                                             UploadTaskCompleted="HandleUploadCompleted"
                                             UploadTaskAboutToScheduling="HandleImageUploadAboutToScheduling">
                                    <atom:Upload.TriggerContent>
                                        <atom:UploadTrigger SourceKind="Files">
                                            <StackPanel Orientation="Vertical">
                                                <Panel>
                                                    <antdicons:PlusOutlined IsVisible="{Binding IsTaskRunning, RelativeSource={RelativeSource AncestorType=atom:Upload}, Converter={x:Static BoolConverters.Not}}" />
                                                    <antdicons:LoadingOutlined IsVisible="{Binding IsTaskRunning, RelativeSource={RelativeSource AncestorType=atom:Upload}}"
                                                                               LoadingAnimation="Spin" />
                                                </Panel>
                                                <TextBlock Margin="0, 8, 0, 0"
                                                           Text="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                                            </StackPanel>
                                        </atom:UploadTrigger>
                                    </atom:Upload.TriggerContent>
                                </atom:Upload>
                                <atom:Upload Name="AvatarDemoPictureCircleUpload"
                                             ListType="PictureCircle"
                                             UploadTransport="{Binding UploadTransport}"
                                             UploadTaskFailed="HandleUploadFailed"
                                             UploadTaskCompleted="HandleUploadCompleted"
                                             UploadTaskAboutToScheduling="HandleImageUploadAboutToScheduling">
                                    <atom:Upload.TriggerContent>
                                        <atom:UploadTrigger SourceKind="Files">
                                            <StackPanel Orientation="Vertical">
                                                <antdicons:PlusOutlined />
                                                <TextBlock Margin="0, 8, 0, 0"
                                                           Text="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                                            </StackPanel>
                                        </atom:UploadTrigger>
                                    </atom:Upload.TriggerContent>
                                </atom:Upload>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource DefaultFilesTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource DefaultFilesDescription}"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="DefaultFileList"
                                         Files="{Binding DefaultFiles}"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadTrigger SourceKind="Files">
                                        <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                     Content="{gallery:UploadShowCaseLangResource P2ContentClickToUpload}" />
                                    </atom:UploadTrigger>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource PicturesWallTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource PicturesWallDescription}"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="PicturesWallUpload"
                                         Files="{Binding PicturesWallFiles}"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted"
                                         ListType="PictureCard">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadTrigger SourceKind="Files">
                                        <StackPanel Orientation="Vertical">
                                            <antdicons:PlusOutlined />
                                            <TextBlock Margin="0, 8, 0, 0"
                                                       Text="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                                        </StackPanel>
                                    </atom:UploadTrigger>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource PictureCircleTypeTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource PictureCircleTypeDescription}"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="PicturesCircleWallUpload"
                                         Files="{Binding PictureCircleFiles}"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted"
                                         ListType="PictureCircle">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadTrigger SourceKind="Files">
                                        <StackPanel Orientation="Vertical">
                                            <antdicons:PlusOutlined />
                                            <TextBlock Margin="0, 8, 0, 0"
                                                       Text="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                                        </StackPanel>
                                    </atom:UploadTrigger>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource DragAndDropTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource DragAndDropDescription}"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="DragAndDropUpload"
                                         IsMultipleEnabled="True"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadDropZone>
                                        <atom:UploadDefaultDropArea />
                                    </atom:UploadDropZone>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource PicturesWithListStyleTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource PicturesWithListStyleDescription}">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="PictureListUpload"
                                         Files="{Binding PictureListStyleFiles}"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted"
                                         ListType="Picture">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadTrigger SourceKind="Files">
                                        <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                     ButtonType="Primary"
                                                     Content="{gallery:UploadShowCaseLangResource P2ContentClickToUpload}" />
                                    </atom:UploadTrigger>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource MaxCountTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource MaxCountDescription}">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Upload Name="MaxCount1Upload"
                                             MaxCount="1"
                                             UploadTransport="{Binding UploadTransport}"
                                             UploadTaskFailed="HandleUploadFailed"
                                             UploadTaskCompleted="HandleUploadCompleted">
                                    <atom:Upload.TriggerContent>
                                        <atom:UploadTrigger SourceKind="Files">
                                            <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                         Content="{gallery:UploadShowCaseLangResource P2ContentUploadMaxN1}" />
                                        </atom:UploadTrigger>
                                    </atom:Upload.TriggerContent>
                                </atom:Upload>

                                <atom:Upload Name="MaxCount3Upload"
                                             MaxCount="3"
                                             IsMultipleEnabled="True"
                                             UploadTransport="{Binding UploadTransport}"
                                             UploadTaskFailed="HandleUploadFailed"
                                             UploadTaskCompleted="HandleUploadCompleted">
                                    <atom:Upload.TriggerContent>
                                        <atom:UploadTrigger SourceKind="Files">
                                            <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                         Content="{gallery:UploadShowCaseLangResource P2ContentUploadMaxN3}" />
                                        </atom:UploadTrigger>
                                    </atom:Upload.TriggerContent>
                                </atom:Upload>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource FileAndDirectoryTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource FileAndDirectoryDescription}">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="FileAndDirectoryUpload"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted">
                                <atom:Upload.TriggerContent>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <atom:UploadTrigger SourceKind="Files">
                                            <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                         Content="{gallery:UploadShowCaseLangResource P2ContentClickToUpload}" />
                                        </atom:UploadTrigger>
                                        <atom:UploadTrigger SourceKind="Directories">
                                            <atom:Button Content="{gallery:UploadShowCaseLangResource P2ContentUploadDirectory}" />
                                        </atom:UploadTrigger>
                                    </StackPanel>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource UploadPngOnlyTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource UploadPngOnlyDescription}">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="PngOnlyUpload"
                                         AllowedFileTypes="{Binding PngFileTypes}"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted"
                                         UploadTaskAboutToScheduling="HandlePngUploadAboutToScheduling">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadTrigger SourceKind="Files">
                                        <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                     Content="{gallery:UploadShowCaseLangResource P2ContentUploadPngOnly}" />
                                    </atom:UploadTrigger>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource ScrollableListTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource ScrollableListDescription}"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="ScrollableUpload"
                                         Files="{Binding ScrollableUploadFiles}"
                                         ListMaxHeight="160"
                                         ListScrollBarVisibility="Auto"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadTrigger SourceKind="Files">
                                        <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                     Content="{gallery:UploadShowCaseLangResource P2ContentClickToUpload}" />
                                    </atom:UploadTrigger>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:UploadShowCaseLangResource SuccessAutoRemoveTitle}"
                    IsDeferredContentEnabled="True"
                    Description="{gallery:UploadShowCaseLangResource SuccessAutoRemoveDescription}">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <atom:Upload Name="SuccessAutoRemoveUpload"
                                         SuccessAutoRemoveDelay="0:0:3"
                                         UploadTransport="{Binding UploadTransport}"
                                         UploadTaskFailed="HandleUploadFailed"
                                         UploadTaskCompleted="HandleUploadCompleted">
                                <atom:Upload.TriggerContent>
                                    <atom:UploadTrigger SourceKind="Files">
                                        <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                     Content="{gallery:UploadShowCaseLangResource P2ContentClickToUpload}" />
                                    </atom:UploadTrigger>
                                </atom:Upload.TriggerContent>
                            </atom:Upload>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="upload-semantic-part"
                    Title="{gallery:UploadShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:UploadShowCaseLangResource SemanticPartStyleDescription}"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    IsOccupyEntireRow="True"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:UploadViewModel">
                            <StackPanel Spacing="24">
                                <StackPanel.Styles>
                                    <Style Selector="atom|Upload.semantic-style-demo-object">
                                        <atom:UploadListStyle x:SetterTargetType="ItemsControl">
                                            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
                                        </atom:UploadListStyle>
                                        <atom:UploadItemStyle x:SetterTargetType="TemplatedControl">
                                            <Setter Property="Background" Value="{atom:SharedTokenResource ColorFillSecondary}" />
                                        </atom:UploadItemStyle>
                                    </Style>
                                </StackPanel.Styles>
                                <atom:Upload AutoUpload="False"
                                             Classes="semantic-style-demo-object"
                                             Files="{Binding DefaultFiles}"
                                             HorizontalAlignment="Stretch">
                                    <atom:Upload.TriggerContent>
                                        <atom:UploadTrigger SourceKind="Files">
                                            <Border HorizontalAlignment="Left"
                                                    Background="#E6E6FA"
                                                    CornerRadius="8"
                                                    Padding="8">
                                                <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                             Content="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                                            </Border>
                                        </atom:UploadTrigger>
                                    </atom:Upload.TriggerContent>
                                </atom:Upload>
                                <Border Classes="semantic-style-demo-frame"
                                        CornerRadius="8"
                                        Background="{atom:SharedTokenResource ColorBgContainer}"
                                        BorderBrush="#5459AC"
                                        BorderThickness="1"
                                        Padding="12">
                                    <atom:Upload AutoUpload="False"
                                                 Classes="semantic-style-demo-object"
                                                 Files="{Binding DefaultFiles}"
                                                 HorizontalAlignment="Stretch">
                                        <atom:Upload.TriggerContent>
                                            <atom:UploadTrigger SourceKind="Files">
                                                <Border HorizontalAlignment="Left"
                                                        Background="#E6E6FA"
                                                        CornerRadius="8"
                                                        Padding="8">
                                                    <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}"
                                                                 Content="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                                                </Border>
                                            </atom:UploadTrigger>
                                        </atom:Upload.TriggerContent>
                                    </atom:Upload>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
