<!-- owner: global Tokens are read from the owner. ListViewItem is Token-owner transparent, so its owner is the hosting
     ListView; the theme is also the base of TransferListItem and the identity-less group header and Select option items.
     Own Tokens are the ListView's. -->
<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:ClassModifier="internal"
              x:Class="AtomUI.Desktop.Controls.Themes.ListViewItemTheme"
              TargetType="atom:ListViewItem">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:ListViewItem">
            <Panel>
                <!-- Keyboard focus outline: drawn just inside the item frame, so it is neither clipped by the list
                     viewport nor overlaps the neighbouring items. -->
                <atom:PixelAlignedBorder Name="Frame"
                                         TemplatedControl.IsTemplateFocusTarget="True"
                                         atom:FocusOutlineAdorner.IsInset="True"
                                         Background="{TemplateBinding Background}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         Padding="{TemplateBinding Padding}">
                    <DockPanel LastChildFill="True">
                        <atom:IconTemplatePresenter
                            Name="SelectedIndicator"
                            IconTemplate="{TemplateBinding SelectedIndicator}"
                            IsVisible="{TemplateBinding IsSelectedIndicatorVisible}"
                            DockPanel.Dock="Right" />
                        <ContentPresenter Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </DockPanel>
                </atom:PixelAlignedBorder>
                <atom:PixelAlignedBorder Name="SplitLineFrame"
                                         VerticalAlignment="Bottom"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                         IsVisible="{TemplateBinding IsSplitLineEffectiveVisible}" />
            </Panel>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|ListViewItem)">
        <Setter Property="Margin" Value="{CompiledBinding $self.ItemMargin}" />
        <Setter Property="Foreground" Value="{CompiledBinding $self.ItemColor}" />
        <Setter Property="Background" Value="{CompiledBinding $self.ItemBgColor}" />
        <!-- The split line under the item is LineWidth thick; an application BorderThickness replaces it. -->
        <Setter Property="SplitLineWidth" Value="{atom:OwnerTokenResource LineWidth}" />
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorSplit}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        
        <Style Selector="^[IsGroupItem=False]">
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{CompiledBinding $self.ItemHoverColor}" />
                <Setter Property="Background" Value="{Binding ItemHoverBg, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^:selected:not(:disabled)">
                <Setter Property="Foreground" Value="{CompiledBinding $self.ItemSelectedColor}" />
                <Setter Property="Background" Value="{Binding ItemSelectedBg, RelativeSource={RelativeSource Self}}" />
            </Style>
        </Style>
        
        <Style Selector="^ /template/ atom|IconTemplatePresenter#SelectedIndicator">
            <Setter Property="IconBrush" Value="{atom:OwnerTokenResource ColorPrimary}" />
            <Setter Property="Width" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="Height" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="Margin"
                    Value="{TemplateBinding SelectedIndicatorMargin}" />
        </Style>

        <Style Selector="^[SizeType=Large], ^[SizeType=Middle], ^[SizeType=Small], ^[SizeType=Custom]">
            <Setter Property="Padding" Value="{CompiledBinding $self.ItemPadding}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightLG}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeight}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightSM}" />
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground"
                        Value="{TemplateBinding ItemDisabledColor}" />
            </Style>
        </Style>

        <Style Selector="^[IsGroupItem=True]">
            <Setter Property="Foreground" Value="{CompiledBinding $self.GroupHeaderColor}" />
            <Setter Property="Background" Value="{CompiledBinding $self.ItemBgColor}" />

            <Style Selector="^[SizeType=Large]">
                <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}" />
            </Style>

            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeSM}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeSM}" />
            </Style>

        </Style>
    </Style>

    <Style Selector="^[IsMotionEnabled=True]">
        <Setter Property="Transitions">
            <atom:TokenTransitions>
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationMid" />
                    <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="MotionDurationMid" />
                </Transitions>
            </atom:TokenTransitions>
        </Setter>
    </Style>
</ControlTheme>
