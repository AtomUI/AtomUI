<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="AtomUI.Desktop.Controls.Tests.Theme.OwnerTokenResourceView">
    <UserControl.Resources>
        <ControlTheme x:Key="OwnerFrameTheme" TargetType="Border">
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorder}" />
        </ControlTheme>
        <ControlTheme x:Key="TemplatedFrameTheme" TargetType="ContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Frame" BorderBrush="{atom:OwnerTokenResource ColorBorder}" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^.override /template/ Border#PART_Frame">
                <Setter Property="BorderBrush" Value="#00FF00" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <StackPanel>
        <atom:Button Name="OwnerButton">
            <StackPanel>
                <Border Name="OwnedFrame" Theme="{StaticResource OwnerFrameTheme}" />
                <Border Name="DirectFrame" BorderBrush="{atom:OwnerTokenResource Kind=ColorBorder}" />
                <ContentControl Name="TemplatedHost" Theme="{StaticResource TemplatedFrameTheme}" />
                <ContentControl Name="OverriddenTemplatedHost" Classes="override"
                                Theme="{StaticResource TemplatedFrameTheme}" />
            </StackPanel>
        </atom:Button>
        <Border Name="UnownedFrame" Theme="{StaticResource OwnerFrameTheme}" />
    </StackPanel>
</UserControl>
