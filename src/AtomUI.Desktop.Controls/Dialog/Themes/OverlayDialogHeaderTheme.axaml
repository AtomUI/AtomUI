<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:OverlayDialogHeader}" TargetType="atom:OverlayDialogHeader">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="HeaderFrame"
                        Classes.semantic-header="True"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}">
                    <DockPanel LastChildFill="True"
                               HorizontalSpacing="{atom:OwnerTokenResource SpacingSM}">
                        <atom:IconPresenter Name="IconPresenter" DockPanel.Dock="Left"
                                            Icon="{TemplateBinding Logo}"
                                            IsVisible="{TemplateBinding Logo, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Orientation="Horizontal" Name="ButtonGroup" DockPanel.Dock="Right">
                            <atom:DialogCaptionButton
                                Name="PART_MaximizeButton"
                                NormalIcon="{antdicons:AntDesignIconProvider Kind=WindowMaximizedOutlined}"
                                CheckedIcon="{antdicons:AntDesignIconProvider Kind=WindowRestoreOutlined}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                IsChecked="{TemplateBinding IsDialogMaximized}"
                                IsVisible="{TemplateBinding IsMaximizeButtonEnabled}">
                            </atom:DialogCaptionButton>
                            <atom:DialogCaptionButton
                                Name="PART_CloseButton"
                                Classes.semantic-close="True"
                                NormalIcon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                IsVisible="{TemplateBinding IsCloseButtonEnabled}" />
                        </StackPanel>
                        <TextBlock Name="Title"
                                   Classes.semantic-title="True"
                                   Text="{TemplateBinding Title}"
                                   FontSize="{TemplateBinding TitleFontSize}"
                                   FontWeight="{TemplateBinding TitleFontWeight}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Padding" Value="{CompiledBinding $self.(atom:DialogSurface.HeaderPadding)}" />
        <Setter Property="Background" Value="{CompiledBinding $self.(atom:DialogSurface.HeaderBackground)}" />
        <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
            <Setter Property="Width" Value="{CompiledBinding $self.(atom:DialogSurface.LogoSize)}" />
            <Setter Property="Height" Value="{CompiledBinding $self.(atom:DialogSurface.LogoSize)}" />
        </Style>

        <Style Selector="^ /template/ atom|DialogCaptionButton">
            <Setter Property="Width" Value="{CompiledBinding $self.(atom:DialogSurface.CloseButtonSize)}" />
            <Setter Property="Height" Value="{CompiledBinding $self.(atom:DialogSurface.CloseButtonSize)}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource IconSize}" />
        </Style>

        <Style Selector="^ /template/ TextBlock#Title">
            <Setter Property="Foreground" Value="{CompiledBinding $self.(atom:DialogSurface.HeaderForeground)}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Foreground"
                                                        atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>