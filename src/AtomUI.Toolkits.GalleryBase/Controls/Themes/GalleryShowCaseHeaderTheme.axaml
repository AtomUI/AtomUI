<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:gallery="https://atomui.net/toolkits/gallery-base">

    <ControlTheme x:Key="{x:Type gallery:GalleryShowCaseHeader}"
                  TargetType="{x:Type gallery:GalleryShowCaseHeader}">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource Kind=ColorTextHeading, WhenExplicit=True}" />
        <Setter Property="MetadataLabelWidth"
                Value="{gallery:GalleryShowCaseHeaderTokenResource MetadataLabelWidth}" />
        <Setter Property="MetadataValueWidth"
                Value="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueWidth}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type gallery:GalleryShowCaseHeader}">
                <StackPanel Margin="{gallery:GalleryShowCaseHeaderTokenResource HeaderMargin}"
                            Spacing="{gallery:GalleryShowCaseHeaderTokenResource HeaderSpacing}">
                    <StackPanel Spacing="{gallery:GalleryShowCaseHeaderTokenResource SummarySpacing}">
                        <Grid ColumnDefinitions="Auto,*"
                              VerticalAlignment="Center">
                            <atom:TextBlock Name="PART_TitleText"
                                            Grid.Column="0"
                                            Text="{TemplateBinding Title}"
                                            FontSize="{gallery:GalleryShowCaseHeaderTokenResource TitleFontSize}"
                                            FontWeight="{gallery:GalleryShowCaseHeaderTokenResource TitleFontWeight}"
                                            VerticalAlignment="Center" />
                            <WrapPanel Name="PART_TagsPanel"
                                       Grid.Column="1"
                                       Margin="{gallery:GalleryShowCaseHeaderTokenResource TagsMargin}"
                                       ItemSpacing="{gallery:GalleryShowCaseHeaderTokenResource TagItemSpacing}"
                                       LineSpacing="{gallery:GalleryShowCaseHeaderTokenResource TagLineSpacing}"
                                       IsVisible="{TemplateBinding IsTagsVisible}"
                                       VerticalAlignment="Center">
                                <atom:Tag Name="PART_CategoryTag"
                                          Text="{TemplateBinding Category}"
                                          TagColor="{TemplateBinding CategoryTagColor}"
                                          IsVisible="{TemplateBinding IsCategoryVisible}"
                                          VerticalAlignment="Center" />
                                <atom:Tag Name="PART_StatusTag"
                                          Text="{TemplateBinding Status}"
                                          TagColor="{TemplateBinding StatusTagColor}"
                                          IsVisible="{TemplateBinding IsStatusVisible}"
                                          VerticalAlignment="Center" />
                                <atom:Tag Name="PART_IntroducedVersionTag"
                                          Text="{TemplateBinding IntroducedVersion}"
                                          TagColor="{TemplateBinding IntroducedVersionTagColor}"
                                          IsVisible="{TemplateBinding IsIntroducedVersionVisible}"
                                          VerticalAlignment="Center" />
                            </WrapPanel>
                        </Grid>
                        <atom:TextBlock Name="PART_SubtitleText"
                                        Text="{TemplateBinding Subtitle}"
                                        FontSize="{gallery:GalleryShowCaseHeaderTokenResource SubtitleFontSize}"
                                        Foreground="{atom:OwnerTokenResource Kind=ColorTextSecondary, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                        IsVisible="{TemplateBinding IsSubtitleVisible}" />
                        <atom:TextBlock Name="PART_DescriptionText"
                                        Text="{TemplateBinding Description}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:OwnerTokenResource Kind=ColorTextTertiary, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                        IsVisible="{TemplateBinding IsDescriptionVisible}" />
                    </StackPanel>

                    <atom:PixelAlignedBorder Name="PART_MetadataCard"
                                             Background="{atom:OwnerTokenResource Kind=ColorBgContainer, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                             BorderBrush="{atom:OwnerTokenResource Kind=ColorBorderSecondary, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                             BorderThickness="{atom:OwnerTokenResource Kind=BorderThickness, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                             CornerRadius="{gallery:GalleryShowCaseHeaderTokenResource MetadataCornerRadius}"
                                             MinHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataMinHeight}"
                                             Padding="{gallery:GalleryShowCaseHeaderTokenResource MetadataPadding}"
                                             IsVisible="{TemplateBinding IsMetadataVisible}">
                        <StackPanel Name="PART_MetadataItems"
                                    Spacing="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineSpacing}"
                                    VerticalAlignment="Center">
                            <gallery:GalleryShowCaseMetadataRowPanel Name="PART_NamespaceMetadataItem"
                                                                     LabelWidth="{TemplateBinding MetadataLabelWidth}"
                                                                     ValueWidth="{TemplateBinding MetadataValueWidth}"
                                                                     PairSpacing="{gallery:GalleryShowCaseHeaderTokenResource MetadataPairSpacing}"
                                                                     HorizontalAlignment="Stretch"
                                                                     VerticalAlignment="Center"
                                                                     IsVisible="{TemplateBinding IsNamespaceVisible}">
                                <atom:TextBlock Text="{gallery:GalleryShowCaseHeaderLangResource NamespaceLabel}"
                                                FontFamily="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueFontFamily}"
                                                FontWeight="Bold"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{atom:OwnerTokenResource Kind=ColorTextSecondary, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Text="{TemplateBinding Namespace}"
                                                FontFamily="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueFontFamily}"
                                                HorizontalAlignment="Stretch"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{atom:OwnerTokenResource Kind=ColorTextSecondary, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                                VerticalAlignment="Center" />
                            </gallery:GalleryShowCaseMetadataRowPanel>

                            <gallery:GalleryShowCaseMetadataRowPanel Name="PART_PackageMetadataItem"
                                                                     LabelWidth="{TemplateBinding MetadataLabelWidth}"
                                                                     ValueWidth="{TemplateBinding MetadataValueWidth}"
                                                                     PairSpacing="{gallery:GalleryShowCaseHeaderTokenResource MetadataPairSpacing}"
                                                                     HorizontalAlignment="Stretch"
                                                                     VerticalAlignment="Center"
                                                                     IsVisible="{TemplateBinding IsPackageVisible}">
                                <atom:TextBlock Text="{gallery:GalleryShowCaseHeaderLangResource PackageLabel}"
                                                FontFamily="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueFontFamily}"
                                                FontWeight="Bold"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{atom:OwnerTokenResource Kind=ColorTextSecondary, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Text="{TemplateBinding Package}"
                                                FontFamily="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueFontFamily}"
                                                HorizontalAlignment="Stretch"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{atom:OwnerTokenResource Kind=ColorTextSecondary, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                                VerticalAlignment="Center" />
                            </gallery:GalleryShowCaseMetadataRowPanel>

                            <gallery:GalleryShowCaseMetadataRowPanel Name="PART_BaseClassMetadataItem"
                                                                     LabelWidth="{TemplateBinding MetadataLabelWidth}"
                                                                     ValueWidth="{TemplateBinding MetadataValueWidth}"
                                                                     PairSpacing="{gallery:GalleryShowCaseHeaderTokenResource MetadataPairSpacing}"
                                                                     HorizontalAlignment="Stretch"
                                                                     VerticalAlignment="Center"
                                                                     IsVisible="{TemplateBinding IsBaseClassVisible}">
                                <atom:TextBlock Text="{gallery:GalleryShowCaseHeaderLangResource BaseClassLabel}"
                                                FontFamily="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueFontFamily}"
                                                FontWeight="Bold"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{atom:OwnerTokenResource Kind=ColorTextSecondary, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Text="{TemplateBinding BaseClass}"
                                                FontFamily="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueFontFamily}"
                                                HorizontalAlignment="Stretch"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{atom:OwnerTokenResource Kind=ColorTextSecondary, AnchorControlType={x:Type gallery:GalleryShowCaseHeader}}"
                                                VerticalAlignment="Center" />
                            </gallery:GalleryShowCaseMetadataRowPanel>
                        </StackPanel>
                    </atom:PixelAlignedBorder>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
