<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:TabStrip}" TargetType="atom:TabStrip">
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSize" Value="{atom:TabStripTokenResource TitleFontSize}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSizeLG" Value="{atom:TabStripTokenResource TitleFontSizeLG}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSizeSM" Value="{atom:TabStripTokenResource TitleFontSizeSM}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemMargin" Value="{atom:TabStripTokenResource HorizontalItemMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemColor" Value="{atom:TabStripTokenResource ItemColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemHoverColor" Value="{atom:TabStripTokenResource ItemHoverColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemSelectedColor" Value="{atom:TabStripTokenResource ItemSelectedColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemIconMargin" Value="{atom:TabStripTokenResource ItemIconMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeMenuIndicatorPaddingHorizontal" Value="{atom:TabStripTokenResource MenuIndicatorPaddingHorizontal}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeMenuIndicatorPaddingVertical" Value="{atom:TabStripTokenResource MenuIndicatorPaddingVertical}" />

        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowLeft" Value="{atom:TabStripTokenResource BoxShadowTabsOverflowLeft}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowRight" Value="{atom:TabStripTokenResource BoxShadowTabsOverflowRight}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowTop" Value="{atom:TabStripTokenResource BoxShadowTabsOverflowTop}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowBottom" Value="{atom:TabStripTokenResource BoxShadowTabsOverflowBottom}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCloseIconMargin" Value="{atom:TabStripTokenResource CloseIconMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeInkBarColor" Value="{atom:TabStripTokenResource InkBarColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeInkBarThickness" Value="{atom:TabStripTokenResource InkBarThickness}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemGutter" Value="{atom:TabStripTokenResource HorizontalItemGutter}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemPadding" Value="{atom:TabStripTokenResource HorizontalItemPadding}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemPaddingLG" Value="{atom:TabStripTokenResource HorizontalItemPaddingLG}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemPaddingSM" Value="{atom:TabStripTokenResource HorizontalItemPaddingSM}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeVerticalItemGutter" Value="{atom:TabStripTokenResource VerticalItemGutter}" />

        <ControlTheme.BasedOn>
            <themes:BaseTabStripTheme TargetType="atom:TabStrip" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame">
                    <Panel Name="AlignWrapper">
                        <Border Padding="{TemplateBinding EffectiveHeaderPadding}">
                            <DockPanel LastChildFill="True" Name="HeaderLayout">
                                <ContentPresenter Name="HeaderStartExtraContent"
                                                  Content="{TemplateBinding HeaderStartExtraContent}"
                                                  ContentTemplate="{TemplateBinding HeaderStartExtraContentTemplate}" />
                                <ContentPresenter Name="HeaderEndExtraContent"
                                                  Content="{TemplateBinding HeaderEndExtraContent}"
                                                  ContentTemplate="{TemplateBinding HeaderEndExtraContentTemplate}" />
                                <atom:TabScrollViewer
                                    Name="PART_TabsContainer"
                                    IsScrollChainingEnabled="False"
                                    TabStripPlacement="{TemplateBinding TabStripPlacement}"
                                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                    IsPopupPinnedOpen="{TemplateBinding IsPopupPinnedOpen}"
                                    OverflowPopupTemplate="{TemplateBinding OverflowPopupTemplate}">
                                    <Panel>
                                        <ItemsPresenter
                                            Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        <Border Name="PART_SelectedItemIndicator"
                                                RenderTransform="{TemplateBinding SelectedIndicatorRenderTransform}"/>
                                    </Panel>
                                </atom:TabScrollViewer>
                            </DockPanel>
                        </Border>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="SelectedIndicatorThickness"
                Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeInkBarThickness)}" />

        <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
            <Setter Property="Background" Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeInkBarColor)}" />
        </Style>

        <Style Selector="^[TabStripPlacement=Top]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="HorizontalSpacing" Value="{atom:TabStripTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ Panel#AlignWrapper > Border">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeHorizontalItemGutter)}" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Right]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="VerticalSpacing" Value="{atom:TabStripTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Bottom"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ Panel#AlignWrapper > Border">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeVerticalItemGutter)}" />
                <Setter Property="Orientation" Value="Vertical" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Bottom]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="HorizontalSpacing" Value="{atom:TabStripTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ Panel#AlignWrapper > Border">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeHorizontalItemGutter)}" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Left]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="VerticalSpacing" Value="{atom:TabStripTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ Panel#AlignWrapper > Border">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeVerticalItemGutter)}" />
                <Setter Property="Orientation" Value="Vertical" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <TransformOperationsTransition Property="SelectedIndicatorRenderTransform" atom:TokenTransitions.Duration="MotionDurationSlow" Easing="CubicEaseOut" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
