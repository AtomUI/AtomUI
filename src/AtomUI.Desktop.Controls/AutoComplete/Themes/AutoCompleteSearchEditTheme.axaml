<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:AutoCompleteSearchEdit}" TargetType="atom:AutoCompleteSearchEdit">
        <ControlTheme.BasedOn>
            <atom:AbstractAutoCompleteTheme TargetType="atom:AutoCompleteSearchEdit" />
        </ControlTheme.BasedOn>
        <Setter Property="PopupLayoutTokenResourceKeys" Value="{x:Static atom:AutoCompletePopupLayoutResources.SearchEdit}" />
        <Style Selector="^[IsPopupMatchSelectWidth=False] /template/ Border#PopupFrame">
            <Setter Property="MaxWidth" Value="{atom:AutoCompleteSearchEditTokenResource MaxPopupWidth}" />
        </Style>
        
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:AutoCompleteSearchEditBox Name="{x:Static atom:AutoCompleteThemeConstants.TextBoxPart}"
                                                    Classes.semantic-scope-input="True"
                                                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                    IsAllowClear="{TemplateBinding IsAllowClear}"
                                                    StyleVariant="{TemplateBinding StyleVariant}"
                                                    Status="{TemplateBinding Status}"
                                                    FormStatus="{TemplateBinding FormStatus}"
                                                    DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                                                    CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                                                    InnerLeftContent="{TemplateBinding ContentLeftAddOn}"
                                                    InnerLeftContentTemplate="{TemplateBinding ContentLeftAddOnTemplate}"
                                                    InnerRightContent="{TemplateBinding ContentRightAddOn}"
                                                    InnerRightContentTemplate="{TemplateBinding ContentRightAddOnTemplate}"
                                                    SizeType="{TemplateBinding SizeType}"
                                                    PlaceholderText="{TemplateBinding PlaceholderText}"
                                                    PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                                                    IsReadOnly="{TemplateBinding IsReadOnly}"
                                                    Focusable="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}"
                                                    SearchButtonStyle="{TemplateBinding SearchButtonStyle}"
                                                    SearchButtonText="{TemplateBinding SearchButtonText}"
                                                    IsOperating="{TemplateBinding IsOperating}"
                                                    IsSearchOnEnterEnabled="{TemplateBinding IsSearchOnEnterEnabled}"
                                                    ClearIcon="{TemplateBinding ClearIcon}"
                                                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                                                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                                                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}" />

                    <atom:Popup Name="{x:Static atom:AutoCompleteThemeConstants.PopupPart}"
                                OpenMotion="{TemplateBinding OpenMotion}"
                                CloseMotion="{TemplateBinding CloseMotion}"
                                WindowManagerAddShadowHint="False"
                                IsLightDismissEnabled="True"
                                OverlayDismissEventPassThrough="True"
                                ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                Placement="{TemplateBinding PopupPlacement}"
                                RequestedPlacement="{TemplateBinding PopupPlacement}">
                        <Border Name="PopupFrame"
                                Classes.semantic-popup-root="True"
                                MaxHeight="{TemplateBinding MaxPopupHeight}"
                                MinWidth="{atom:AutoCompleteSearchEditTokenResource MinPopupWidth}"
                                Padding="{TemplateBinding PopupContentPadding}">
                            <atom:CandidateList Name="{x:Static atom:AutoCompleteThemeConstants.CandidateListPart}"
                                                Classes.semantic-popup-list="True"
                                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                SelectionMode="Single"
                                                ItemTemplate="{TemplateBinding OptionTemplate}" />
                        </Border>
                    </atom:Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ atom|CandidateList">
            <Setter Property="ItemColor" Value="{atom:AutoCompleteSearchEditTokenResource OptionColor}" />
            <Setter Property="ItemSelectedColor" Value="{atom:AutoCompleteSearchEditTokenResource OptionSelectedColor}" />
            <Setter Property="ItemMargin" Value="{atom:AutoCompleteSearchEditTokenResource OptionMargin}" />
            <Setter Property="ItemCornerRadius" Value="{atom:AutoCompleteSearchEditTokenResource OptionBorderRadius}" />
            <Setter Property="ItemMinHeight" Value="{atom:AutoCompleteSearchEditTokenResource OptionHeight}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
