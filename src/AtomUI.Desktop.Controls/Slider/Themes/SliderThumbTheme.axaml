<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <!-- The thumb is a template part of the Slider only: every Token, global or Own, is read from the Slider, so
         Controls[Slider] reaches the thumb. -->
    <ControlTheme x:Key="{x:Type atom:SliderThumb}" TargetType="atom:SliderThumb">

        <Setter Property="Focusable" Value="True" />
        <!-- :focus enlarges the handle and draws its outline ring (Ant Design handle focus style). -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="{atom:SliderTokenResource ThumbBg}" />
        <Setter Property="BorderThickness"
                Value="{atom:SliderTokenResource ThumbCircleBorderThickness}" />
        <Setter Property="BorderBrush" Value="{atom:SliderTokenResource ThumbCircleBorderColor}" />
        <Setter Property="OutlineBrush" Value="{atom:SliderTokenResource ThumbOutlineColor}" />
        <Setter Property="OutlineThickness" Value="0" />
        <Setter Property="ThumbCircleSize" Value="{atom:SliderTokenResource ThumbCircleSize}" />
        <Setter Property="ThumbCornerRadius" Value="{atom:SliderTokenResource ThumbCornerRadius}" />
        <Setter Property="Width" Value="{atom:SliderTokenResource ThumbSize}" />
        <Setter Property="Height" Value="{atom:SliderTokenResource ThumbSize}" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <!-- layout -->
        <Setter Property="ZIndex" Value="100" />

        <Style Selector="^:pointerover">
            <Setter Property="BorderThickness"
                    Value="{atom:SliderTokenResource ThumbCircleBorderThicknessHover}" />
            <Setter Property="BorderBrush"
                    Value="{atom:SliderTokenResource ThumbCircleBorderActiveColor}" />
            <Setter Property="ThumbCircleSize"
                    Value="{atom:SliderTokenResource ThumbCircleSizeHover}" />
            <Setter Property="OutlineThickness"
                    Value="{atom:SliderTokenResource ThumbHoverOutlineThickness}" />
        </Style>

        <Style Selector="^:focus">
            <Setter Property="BorderThickness"
                    Value="{atom:SliderTokenResource ThumbCircleBorderThicknessHover}" />
            <Setter Property="BorderBrush"
                    Value="{atom:SliderTokenResource ThumbCircleBorderActiveColor}" />
            <Setter Property="ThumbCircleSize"
                    Value="{atom:SliderTokenResource ThumbCircleSizeHover}" />
            <Setter Property="OutlineThickness"
                    Value="{atom:SliderTokenResource ThumbOutlineThickness}" />
            <!-- layout -->
            <Setter Property="ZIndex" Value="1000" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="BorderBrush" Value="{atom:SliderTokenResource ThumbCircleBorderColorDisabled}" />
            <Setter Property="OutlineThickness" Value="0" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="OutlineBrush" atom:TokenTransitions.Duration="StateTransitionDuration" />
                        <ThicknessTransition Property="OutlineThickness" atom:TokenTransitions.Duration="StateTransitionDurationFast" />
                        <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="StateTransitionDuration" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
