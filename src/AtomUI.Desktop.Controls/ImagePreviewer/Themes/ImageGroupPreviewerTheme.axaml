<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:preview="clr-namespace:AtomUI.Desktop.Controls;assembly=AtomUI.Controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImageGroupPreviewer}" TargetType="atom:ImageGroupPreviewer">
        <Setter Property="atom:ImageViewer.LayoutBackground" Value="{atom:ImageGroupPreviewerTokenResource ColorBgLayout}" />
        <Setter Property="atom:ImageViewer.OverlayMaskBackground" Value="{atom:ImageGroupPreviewerTokenResource ColorBgMask}" />
        <Setter Property="atom:ImageViewer.ActiveTextBackground" Value="{atom:ImageGroupPreviewerTokenResource ColorBgTextActive}" />
        <Setter Property="atom:ImageViewer.HoverTextBackground" Value="{atom:ImageGroupPreviewerTokenResource ColorBgTextHover}" />
        <Setter Property="atom:ImageViewer.TertiaryFill" Value="{atom:ImageGroupPreviewerTokenResource ColorFillTertiary}" />
        <Setter Property="atom:ImageViewer.InverseTextForeground" Value="{atom:ImageGroupPreviewerTokenResource ColorTextLightSolid}" />
        <Setter Property="atom:ImageViewer.TertiaryTextForeground" Value="{atom:ImageGroupPreviewerTokenResource ColorTextTertiary}" />
        <Setter Property="atom:ImageViewer.SmallToolbarButtonSize" Value="{atom:ImageGroupPreviewerTokenResource ControlHeightSM}" />
        <Setter Property="atom:ImageViewer.CoverImageSize" Value="{atom:ImageGroupPreviewerTokenResource CoverImageWidth}" />
        <Setter Property="atom:ImageViewer.DialogMinHeight" Value="{atom:ImageGroupPreviewerTokenResource DialogMinHeight}" />
        <Setter Property="atom:ImageViewer.DialogMinWidth" Value="{atom:ImageGroupPreviewerTokenResource DialogMinWidth}" />
        <Setter Property="atom:ImageViewer.DefaultMotionEnabled" Value="{atom:ImageGroupPreviewerTokenResource EnableMotion}" />
        <Setter Property="atom:ImageViewer.ErrorIconSize" Value="{atom:ImageGroupPreviewerTokenResource ErrorIconSize}" />
        <Setter Property="atom:ImageViewer.FloatToolbarIndicatorPadding" Value="{atom:ImageGroupPreviewerTokenResource FloatToolbarIndicatorPadding}" />
        <Setter Property="atom:ImageViewer.FloatToolbarPadding" Value="{atom:ImageGroupPreviewerTokenResource FloatToolbarPadding}" />
        <Setter Property="atom:ImageViewer.IconSize" Value="{atom:ImageGroupPreviewerTokenResource IconSize}" />
        <Setter Property="atom:ImageViewer.LargeIconSize" Value="{atom:ImageGroupPreviewerTokenResource IconSizeLG}" />
        <Setter Property="atom:ImageViewer.MarginSM" Value="{atom:ImageGroupPreviewerTokenResource MarginSM}" />
        <Setter Property="atom:ImageViewer.MarginXL" Value="{atom:ImageGroupPreviewerTokenResource MarginXL}" />
        <Setter Property="atom:ImageViewer.MaskBackground" Value="{atom:ImageGroupPreviewerTokenResource MaskBgColor}" />
        <Setter Property="atom:ImageViewer.NavButtonBackground" Value="{atom:ImageGroupPreviewerTokenResource NavButtonBgColor}" />
        <Setter Property="atom:ImageViewer.NavButtonHoverBackground" Value="{atom:ImageGroupPreviewerTokenResource NavButtonBgHoverColor}" />
        <Setter Property="atom:ImageViewer.PaddingSM" Value="{atom:ImageGroupPreviewerTokenResource PaddingSM}" />
        <Setter Property="atom:ImageViewer.PaddingXS" Value="{atom:ImageGroupPreviewerTokenResource PaddingXS}" />
        <Setter Property="atom:ImageViewer.PreviewOperationForeground" Value="{atom:ImageGroupPreviewerTokenResource PreviewOperationColor}" />
        <Setter Property="atom:ImageViewer.DisabledPreviewOperationForeground" Value="{atom:ImageGroupPreviewerTokenResource PreviewOperationColorDisabled}" />
        <Setter Property="atom:ImageViewer.HoverPreviewOperationForeground" Value="{atom:ImageGroupPreviewerTokenResource PreviewOperationHoverColor}" />
        <Setter Property="atom:ImageViewer.PreviewOperationSize" Value="{atom:ImageGroupPreviewerTokenResource PreviewOperationSize}" />
        <Setter Property="atom:ImageViewer.Spacing" Value="{atom:ImageGroupPreviewerTokenResource Spacing}" />
        <Setter Property="atom:ImageViewer.SpacingXXS" Value="{atom:ImageGroupPreviewerTokenResource SpacingXXS}" />
        <Setter Property="atom:ImageViewer.TitleBarBackground" Value="{atom:ImageGroupPreviewerTokenResource TitleBarBackgroundColor}" />

        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Background="{TemplateBinding Background}"
                                         Padding="{TemplateBinding Padding}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding CornerRadius}">
                    <ItemsControl Name="PART_CoverItemsControl"
                                  Classes.semantic-scope-items="True"
                                  ItemsSource="{TemplateBinding EffectiveItems}"
                                  ItemsPanel="{TemplateBinding ItemsPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="preview:ImagePreviewEntry">
                                <atom:ImagePreviewerCover ImageSource="{Binding ThumbnailImage}"
                                                          OwnerPadding="{Binding Padding, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          OwnerBorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          OwnerCornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          IsLoading="{Binding IsThumbnailLoading}"
                                                          IsFailed="{Binding IsThumbnailFailed}"
                                                          LoadingContent="{Binding LoadingContent, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          LoadingContentTemplate="{Binding LoadingContentTemplate, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          ErrorContent="{Binding ErrorContent, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          ErrorContentTemplate="{Binding ErrorContentTemplate, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          Width="{Binding CoverWidth, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="CoverWidth" Value="{CompiledBinding $self.(atom:ImageViewer.CoverImageSize)}" />
        <Setter Property="IsMotionEnabled" Value="{atom:ImageGroupPreviewerTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        
    </ControlTheme>
</ResourceDictionary>
