    <unit id="PageDescription">
      <segment>
        <source>ComboBox combines input-style layout with dropdown selection, supporting item templates, add-ons, prefixes, suffixes, validation status, and size variants.</source>
        <target state="translated">ComboBox 将输入式布局与下拉选择结合，支持项模板、前后置标签、内部前后缀、校验状态和尺寸形态。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>A selection input for choosing from a compact popup list.</source>
        <target state="translated">用于从紧凑弹出列表中选择内容的选择输入控件。</target>
      </segment>
    </unit>
    <unit id="PrePostTabDescription">
