<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    >
    <ControlTheme x:Key="{x:Type atom:PickerClearUpButton}" TargetType="atom:PickerClearUpButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- After the picker inputs (TabIndex 0 / 1) in the frame's local tab group. -->
                    <atom:InputClearIconButton
                        Name="PART_ClearButton"
                        KeyboardNavigation.TabIndex="2"
                        Classes.semantic-clear="True"
                        IsVisible="{TemplateBinding IsInClearMode}" />
                    <StackPanel Name="IconLayout"
                                Orientation="Horizontal"
                                IsVisible="{TemplateBinding IsInClearMode, Converter={x:Static BoolConverters.Not}}">
                        <atom:IconPresenter
                            Name="PART_InfoIconPresenter"
                            Icon="{TemplateBinding Icon}"
                            Width="{TemplateBinding InfoIconSize}"
                            Height="{TemplateBinding InfoIconSize}"
                            IconBrush="{TemplateBinding InfoIconBrush}" />
                        <ContentPresenter
                            Name="FormFeedBack"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Right"
                            IsVisible="{TemplateBinding IsFormFeedbackVisible}"
                            Content="{TemplateBinding FormFeedback}" />
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The info icon is a registered IconPresenter: an owner read on it would resolve to the presenter, so the
             picker's values are read on this identity-less button and template-bound down. -->
        <Setter Property="InfoIconSize" Value="{atom:OwnerTokenResource IconSize}" />
        <Setter Property="InfoIconBrush" Value="{atom:OwnerTokenResource ColorTextQuaternary}" />

        <Style Selector="^ /template/ StackPanel#IconLayout">
            <Setter Property="Spacing" Value="{atom:OwnerTokenResource SpacingXS}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>