<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net"
                    x:ClassModifier="internal">
<ControlTheme x:Key="{x:Type atom:SplitButton}" TargetType="atom:SplitButton">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Name="PART_MainLayout"
                           LastChildFill="True">
                    <atom:Button Name="PART_SecondaryButton"
                                 Classes.semantic-secondary="True"
                                 DockPanel.Dock="Right"
                                 Height="{TemplateBinding Height}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Padding="{TemplateBinding Padding}"
                                 SizeType="{TemplateBinding SizeType}"
                                 Icon="{TemplateBinding OpenIndicator}"
                                 IsEnabled="{TemplateBinding IsEnabled}"
                                 IsDanger="{TemplateBinding IsDanger}"
                                 ButtonType="{TemplateBinding EffectiveButtonType}"
                                 IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                 IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"/>
                    <atom:Button Name="PART_PrimaryButton"
                                 Classes.semantic-primary="True"
                                 Content="{TemplateBinding Content}"
                                 ContentTemplate="{TemplateBinding ContentTemplate}"
                                 HorizontalAlignment="Stretch"
                                 Height="{TemplateBinding Height}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Padding="{TemplateBinding Padding}"
                                 SizeType="{TemplateBinding SizeType}"
                                 Icon="{TemplateBinding Icon}"
                                 IsEnabled="{TemplateBinding IsEnabled}"
                                 IsDanger="{TemplateBinding IsDanger}"
                                 ButtonType="{TemplateBinding EffectiveButtonType}"
                                 IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                 IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"/>
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ShouldUseOverlayPopup" Value="True" />
        <Setter Property="GutterToFlyout" Value="{atom:SplitButtonTokenResource GutterToFlyout}"/>
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="IsWaveSpiritEnabled" Value="{atom:SharedTokenResource EnableWaveSpirit}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}"/>
        <Setter Property="SplitSeparatorBrush" Value="{atom:SharedTokenResource ColorBorder}"/>

        <!-- 对齐上游 solid 组合规则：primary 形态接缝分隔线取次按钮 hover 背景
             （colorPrimaryHover / colorErrorHover），default（outline）形态无接缝线保持 ColorBorder。 -->
        <Style Selector="^[IsPrimaryButtonType=True][IsDanger=False]">
            <Setter Property="SplitSeparatorBrush" Value="{atom:SharedTokenResource ColorPrimaryHover}"/>
        </Style>
        <Style Selector="^[IsPrimaryButtonType=True][IsDanger=True]">
            <Setter Property="SplitSeparatorBrush" Value="{atom:SharedTokenResource ColorErrorHover}"/>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}"/>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}"/>
        </Style>

        <Style Selector="^[SizeType=Custom]">
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}"/>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}"/>
        </Style>

        <Style Selector="^ /template/ #PART_MainLayout > atom|Button">
            <Setter Property="ZIndex" Value="1000"/>
        </Style>
        <Style Selector="^ /template/ #PART_MainLayout > atom|Button#PART_SecondaryButton">
            <Setter Property="ZIndex" Value="1001"/>
        </Style>
        <Style Selector="^ /template/ #PART_MainLayout > atom|Button:pointerover">
            <Setter Property="ZIndex" Value="2000"/>
        </Style>
</ControlTheme>
</ResourceDictionary>
