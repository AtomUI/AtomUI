<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Descriptions}" TargetType="atom:Descriptions">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="RootFrame"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Vertical">
                        <DockPanel Name="HeaderLayout" LastChildFill="True"
                                   Classes.semantic-header="True"
                                   IsVisible="{TemplateBinding IsHeaderLayoutVisible}">
                            <ContentPresenter Name="ExtraPresenter" DockPanel.Dock="Right"
                                              Classes.semantic-extra="True"
                                              Content="{TemplateBinding Extra}"
                                              ContentTemplate="{TemplateBinding ExtraTemplate}" />
                            <ContentPresenter Name="HeaderPresenter"
                                              Classes.semantic-title="True"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}" />
                        </DockPanel>
                        <atom:PixelAlignedBorder Name="ContentFrame">
                            <Grid Name="PART_GridLayout"
                                  Classes.semantic-scope-items="True" />
                        </atom:PixelAlignedBorder>
                    </StackPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[IsBordered=True]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#ContentFrame">
                <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorSplit}" />
                <Setter Property="BorderThickness"
                        Value="{atom:OwnerTokenResource BorderThickness}" />
                <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}" />
                <Setter Property="ClipToBounds" Value="True" />
            </Style>
        </Style>

        <Style Selector="^ /template/ DockPanel#HeaderLayout">
            <Setter Property="Margin" Value="{atom:DescriptionsTokenResource HeaderMargin}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#ExtraPresenter">
            <Setter Property="Foreground" Value="{atom:DescriptionsTokenResource ExtraColor}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#HeaderPresenter">
            <Setter Property="Foreground" Value="{atom:DescriptionsTokenResource TitleColor}" />
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeLG}" />
            <Setter Property="FontWeight" Value="{atom:OwnerTokenResource FontWeightStrong}" />
            <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeightLG}" />
        </Style>

        <Style Selector="^[IsBordered=False]">
            <Style Selector="^[SizeType=Large]">
                <Style Selector="^ /template/ Grid#PART_GridLayout">
                    <Setter Property="RowSpacing" Value="{atom:OwnerTokenResource Spacing}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Middle]">
                <Style Selector="^ /template/ Grid#PART_GridLayout">
                    <Setter Property="RowSpacing" Value="{atom:OwnerTokenResource SpacingSM}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ Grid#PART_GridLayout">
                    <Setter Property="RowSpacing" Value="{atom:OwnerTokenResource SpacingXS}" />
                </Style>
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
