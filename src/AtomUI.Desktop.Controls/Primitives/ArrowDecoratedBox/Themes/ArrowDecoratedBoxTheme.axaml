<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.ArrowDecoratedBoxTheme"
              xmlns:atom="https://atomui.net"
              TargetType="atom:ArrowDecoratedBox">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:ArrowDecoratedBox">
            <DockPanel Name="ContentLayout" LastChildFill="True">
                <Panel Name="ArrowPositionLayout">
                    <LayoutTransformControl
                        Name="PART_ArrowIndicatorLayout"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsVisible="{TemplateBinding IsArrowVisible}"
                        Opacity="{TemplateBinding ArrowOpacity}"
                        ClipToBounds="False">
                        <atom:ArrowIndicator
                            Name="PART_ArrowIndicator"
                            Classes.semantic-arrow="True"
                            FilledColor="{TemplateBinding Background}"
                            ArrowSize="{TemplateBinding ArrowSize}"
                            StrokeBrush="{atom:ArrowDecoratedBoxTokenResource ArrowStrokeColor}"
                            StrokeThickness="{atom:ArrowDecoratedBoxTokenResource ArrowStrokeThickness}"/>
                    </LayoutTransformControl>
                </Panel>
                <!-- layout: fixed template or platform geometry; preserve existing dimensions and hit regions. -->
                <Border
                    Name="PART_ContentDecorator"
                    Classes.semantic-container="True"
                    Margin="0"
                    BackgroundSizing="{TemplateBinding BackgroundSizing}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <ContentPresenter
                        Name="ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </DockPanel>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|ArrowDecoratedBox)">
        <Setter Property="IsMotionEnabled" Value="{atom:ArrowDecoratedBoxTokenResource EnableMotion}" />
        <Setter Property="Foreground" Value="{atom:ArrowDecoratedBoxTokenResource ColorText}" />
        <Setter Property="Background" Value="{atom:ArrowDecoratedBoxTokenResource ColorBgElevated}" />
        <Setter Property="BorderBrush" Value="{atom:ArrowDecoratedBoxTokenResource ContentBorderColor}" />
        <!-- The border width is a token (0 in Ant Design); a bordered box draws one outline around box and arrow. -->
        <Setter Property="BorderThickness" Value="{atom:ArrowDecoratedBoxTokenResource ContentBorderThickness}" />
        <Setter Property="MinHeight" Value="{atom:ArrowDecoratedBoxTokenResource ContentMinHeight}" />
        <Setter Property="Padding" Value="{atom:ArrowDecoratedBoxTokenResource ContentPadding}" />
        <Setter Property="ArrowSize" Value="{atom:ArrowDecoratedBoxTokenResource ArrowSize}" />
        <Setter Property="CornerRadius" Value="{atom:ArrowDecoratedBoxTokenResource BorderRadius}" />

        <!-- With a border the box itself draws background and border as one outline around box and arrow
             (AbstractArrowDecoratedBox.Render). The container keeps its border width for layout but paints neither
             the border nor the area under it, and the arrow indicator keeps its layout but paints nothing, so no
             line crosses the arrow's base. -->
        <Style Selector="^:bordered">
            <Style Selector="^ /template/ Border#PART_ContentDecorator">
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="Background" Value="{x:Null}" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            </Style>
            <Style Selector="^ /template/ atom|ArrowIndicator#PART_ArrowIndicator">
                <Setter Property="Opacity" Value="0" />
            </Style>
        </Style>

        <Style Selector="^[ArrowDirection=Top]">
            <Style Selector="^ /template/ Panel#ArrowPositionLayout">
                <Setter Property="DockPanel.Dock" Value="Top" />
            </Style>
        </Style>
        <Style Selector="^[ArrowDirection=Right]">
            <Style Selector="^ /template/ LayoutTransformControl#PART_ArrowIndicatorLayout">
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
            </Style>
            <Style Selector="^ /template/ Panel#ArrowPositionLayout">
                <Setter Property="DockPanel.Dock" Value="Right" />
            </Style>
        </Style>
        <Style Selector="^[ArrowDirection=Bottom]">
            <Style Selector="^ /template/ LayoutTransformControl#PART_ArrowIndicatorLayout">
                <Setter Property="LayoutTransform" Value="rotate(180deg)" />
            </Style>
            <Style Selector="^ /template/ Panel#ArrowPositionLayout">
                <Setter Property="DockPanel.Dock" Value="Bottom" />
            </Style>
        </Style>
        <Style Selector="^[ArrowDirection=Left]">
            <Style Selector="^ /template/ LayoutTransformControl#PART_ArrowIndicatorLayout">
                <Setter Property="LayoutTransform" Value="rotate(-90deg)" />
            </Style>
            <Style Selector="^ /template/ Panel#ArrowPositionLayout">
                <Setter Property="DockPanel.Dock" Value="Left" />
            </Style>
        </Style>
    </Style>

</ControlTheme>
