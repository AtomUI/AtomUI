<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Carousel}" TargetType="atom:Carousel">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:ScrollViewer Name="PART_ScrollViewer"
                                       Background="{TemplateBinding Background}"
                                       HorizontalScrollBarVisibility="Hidden"
                                       VerticalScrollBarVisibility="Hidden">
                        <ItemsPresenter
                            Name="PART_ItemsPresenter"
                            Margin="{TemplateBinding Padding}"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </atom:ScrollViewer>
                    <atom:CarouselNavButton Name="PART_PreviousButton"
                                            Icon="{antdicons:AntDesignIconProvider LeftOutlined}"
                                            Margin="{TemplateBinding EffectivePreviousButtonMargin}"
                                            IsVisible="{TemplateBinding PreviousNavButtonVisible}" />
                    <atom:CarouselNavButton Name="PART_NextButton"
                                            Icon="{antdicons:AntDesignIconProvider RightOutlined}"
                                            Margin="{TemplateBinding EffectiveNextButtonMargin}"
                                            IsVisible="{TemplateBinding NextNavButtonVisible}" />
                    <LayoutTransformControl Name="PaginationLayoutTransform"
                                            Margin="{TemplateBinding EffectivePaginationMargin}"
                                            IsVisible="{TemplateBinding IsShowPagination}">
                        <atom:CarouselPagination Name="PART_Pagination"
                                                 IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                 IsShowTransitionProgress="{TemplateBinding IsEffectiveShowTransitionProgress}"
                                                 AutoPlaySpeed="{TemplateBinding AutoPlaySpeed}" 
                                                 SelectedIndex="{TemplateBinding SelectedIndex, Mode=TwoWay}"
                                                 ItemsSource="{TemplateBinding IndicatorItems}"/>
                    </LayoutTransformControl>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="ArrowOffset" Value="{atom:CarouselTokenResource ArrowOffset, WhenExplicit=True}" />
        <Setter Property="PaginationOffset" Value="{atom:CarouselTokenResource PaginationOffset}" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="PageTransitionDuration"
                Value="{atom:OwnerTokenResource MotionDurationSlow}" />
        <Setter Property="PageInEasing" Value="CubicEaseOut" />
        <Setter Property="PageOutEasing" Value="CubicEaseOut" />

        <Style Selector="^[PaginationPosition=Top]">
            <Style Selector="^ /template/ LayoutTransformControl#PaginationLayoutTransform">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style Selector="^ /template/ atom|CarouselNavButton#PART_PreviousButton">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style Selector="^ /template/ atom|CarouselNavButton#PART_NextButton">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^[PaginationPosition=Bottom]">
            <Style Selector="^ /template/ LayoutTransformControl#PaginationLayoutTransform">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style Selector="^ /template/ atom|CarouselNavButton#PART_PreviousButton">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style Selector="^ /template/ atom|CarouselNavButton#PART_NextButton">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^[PaginationPosition=Left]">
            <Style Selector="^ /template/ LayoutTransformControl#PaginationLayoutTransform">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
            </Style>

            <Style Selector="^ /template/ atom|CarouselNavButton#PART_PreviousButton">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="RenderTransform" Value="rotate(90deg)" />
            </Style>

            <Style Selector="^ /template/ atom|CarouselNavButton#PART_NextButton">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="RenderTransform" Value="rotate(90deg)" />
            </Style>
        </Style>

        <Style Selector="^[PaginationPosition=Right]">
            <Style Selector="^ /template/ LayoutTransformControl#PaginationLayoutTransform">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
            </Style>

            <Style Selector="^ /template/ atom|CarouselNavButton#PART_PreviousButton">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="RenderTransform" Value="rotate(90deg)" />
            </Style>

            <Style Selector="^ /template/ atom|CarouselNavButton#PART_NextButton">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="RenderTransform" Value="rotate(90deg)" />
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
