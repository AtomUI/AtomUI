                            FontWeight="Bold" />
            <atom:DataGrid x:Name="DragColumnDataGrid1"
                           CanUserReorderColumns="True"
                           x:DataType="vm:DragColumnDataType"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderGender}" FieldId="{x:Static vm:DataGridShowCaseFields.Gender}" Binding="{Binding Gender}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderEmail}" FieldId="{x:Static vm:DataGridShowCaseFields.Email}" Binding="{Binding Email}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn CanUserReorder="True" Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>

