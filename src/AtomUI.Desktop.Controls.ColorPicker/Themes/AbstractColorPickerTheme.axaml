<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:Class="AtomUI.Desktop.Controls.Themes.AbstractColorPickerTheme"
    TargetType="atom:AbstractColorPicker"
    x:ClassModifier="internal">
    <Setter Property="OpenMotion" Value="{x:Static atom:PopupMotionDefaults.PopoverOpen}" />
    <Setter Property="CloseMotion" Value="{x:Static atom:PopupMotionDefaults.PopoverClose}" />

    <Style Selector="^:is(atom|AbstractColorPicker)">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorder}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
        <Setter Property="Background" Value="{atom:OwnerTokenResource ColorBgElevated}" />
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
        <Setter Property="Padding" Value="{atom:ColorPickerTokenResource TriggerPadding}" />
        <Setter Property="TriggerPadding" Value="{atom:ColorPickerTokenResource TriggerPadding}" />
        <Setter Property="EmptyColorText" Value="{atom:ColorPickerLangResource EmptyColorText}" />
        <Setter Property="IsArrowVisible" Value="True" />
        <Setter Property="ShouldUseOverlayPopup" Value="True" />
        <Setter Property="MarginToAnchor" Value="{atom:OwnerTokenResource UniformlyMarginXXS}" />


        <Style Selector="^:pointerover, ^:flyout-open">
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorPrimaryHover}" />
        </Style>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <atom:SolidColorBrushTransition Property="BorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Style Selector="^[Status=Error]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
        </Style>

        <Style Selector="^[Status=Warning]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>

        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}" />

        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}" />
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeLG}" />
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeSM}" />
            <Style Selector="^ /template/ TextBlock#PART_ColorText">
                <Setter Property="Height" Value="{atom:OwnerTokenResource ControlHeightXS}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ TextBlock#PART_ColorText">
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
            <Setter Property="Margin" Value="{atom:ColorPickerTokenResource TriggerTextMargin}"/>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ TextBlock#PART_ColorText">
                <Setter Property="Foreground"
                        Value="{atom:OwnerTokenResource ColorTextDisabled}" />
            </Style>
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
            <Style Selector="^ /template/ atom|ColorBlock#PART_ColorIndicator">
                <Setter Property="Opacity"
                        Value="{atom:ColorPickerTokenResource ColorBlockDisabledOpacity}" />
            </Style>
        </Style>
    </Style>

</ControlTheme>
