    <unit id="SemanticBodyDescription">
      <segment>
        <source>Color block container with background color, border styles</source>
        <target state="translated">色塊容器，包含底色、邊框等樣式</target>
      </segment>
    </unit>
    <unit id="SemanticContentDescription">
      <segment>
        <source>Color block element with actual selected color styles</source>
        <target state="translated">色塊顏色元素，包含實際選擇的顏色樣式</target>
      </segment>
    </unit>
    <unit id="SemanticDescriptionDescription">
