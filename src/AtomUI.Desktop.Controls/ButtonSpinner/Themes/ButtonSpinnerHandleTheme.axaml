<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ButtonSpinnerHandle}" TargetType="atom:ButtonSpinnerHandle">
        <Setter Property="Template">
            <ControlTemplate>
                <UniformGrid
                    Columns="1" 
                    Rows="2"
                    RowSpacing="1">
                    <atom:IconButton
                        Name="PART_IncreaseButton"
                        IsTabStop="False"
                        Classes.semantic-increase-button="True"
                        Icon="{antdicons:AntDesignIconProvider UpOutlined}"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        BackgroundSizing="InnerBorderEdge"/>
                    <atom:IconButton
                        Name="PART_DecreaseButton"
                        IsTabStop="False"
                        Classes.semantic-decrease-button="True"
                        Icon="{antdicons:AntDesignIconProvider DownOutlined}"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        BackgroundSizing="InnerBorderEdge"/>
                </UniformGrid>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BorderBrush" Value="{Binding $parent[atom:ButtonSpinner].HandleBorderColor}"/>
        <Setter Property="SpinnerBorderThickness" Value="{atom:OwnerTokenResource BorderThickness}"/>
        <Setter Property="Background" Value="{Binding $parent[atom:ButtonSpinner].HandleBg}"/>
        <Style Selector="^[StyleVariant=Filled]">
            <Setter Property="Background" Value="{Binding $parent[atom:ButtonSpinner].FilledHandleBg}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>
        <Style
            Selector="^ /template/ atom|IconButton#PART_IncreaseButton, ^ /template/ atom|IconButton#PART_DecreaseButton">
            <Setter Property="IconWidth" Value="{Binding $parent[atom:ButtonSpinner].HandleIconSize}" />
            <Setter Property="IconHeight"
                    Value="{Binding $parent[atom:ButtonSpinner].HandleIconSize}" />
        </Style>
        
        <Style
            Selector="^ /template/ atom|IconButton#PART_IncreaseButton:pointerover, ^ /template/ atom|IconButton#PART_DecreaseButton:pointerover">
            <Setter Property="IconBrush"
                    Value="{Binding $parent[atom:ButtonSpinner].HandleHoverColor}" />
        </Style>
        
        <Style
            Selector="^ /template/ atom|IconButton#PART_IncreaseButton:pressed, ^ /template/ atom|IconButton#PART_DecreaseButton:pressed">
            <!-- The increase/decrease buttons are registered IconButtons, so an owner read on them would resolve to
                 IconButton; the handle reads its host's value explicitly like its other handle Tokens. -->
            <Setter Property="IconBrush"
                    Value="{Binding $parent[atom:ButtonSpinner].HandlePressedColor}" />
        </Style>
        
        <Style
            Selector="^ /template/ atom|IconButton#PART_IncreaseButton:pressed, ^ /template/ atom|IconButton#PART_DecreaseButton:pressed">
            <Setter Property="Background"
                    Value="{Binding $parent[atom:ButtonSpinner].HandleActiveBg}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
