<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net">
    <ControlTheme x:Key="{x:Type atom:SubmitButton}" TargetType="atom:SubmitButton">
        <ControlTheme.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceInclude Source="SubmitButtonAppearanceResources.axaml" />
                    <ResourceInclude Source="../../Buttons/Themes/AntButtonTemplateResources.axaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </ControlTheme.Resources>
        <ControlTheme.BasedOn>
            <StaticResource ResourceKey="AtomUI.SubmitButton.Appearance" />
        </ControlTheme.BasedOn>
        <Setter Property="Template" Value="{StaticResource AtomUI.Button.Template}" />
        <Style Selector="^[ButtonType=Dashed]">
            <Setter Property="Template" Value="{StaticResource AtomUI.Button.DashedTemplate}" />
        </Style>
        <Style Selector="^[EffectiveVariant=Dashed]">
            <Setter Property="Template" Value="{StaticResource AtomUI.Button.DashedVariantTemplate}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
