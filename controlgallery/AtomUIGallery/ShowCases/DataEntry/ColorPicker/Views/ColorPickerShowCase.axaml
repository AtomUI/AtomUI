<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.ColorPicker.ColorPickerShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.ColorPicker"
             x:DataType="vm:ColorPickerViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="ColorPicker"
                    Category="{gallery:ColorPickerShowCaseLangResource ComponentCategory}"
                    Status="{gallery:ColorPickerShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:ColorPickerShowCaseLangResource PageSubtitle}"
                    Description="{gallery:ColorPickerShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls.ColorPicker"
                    BaseClass="AbstractColorPicker" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
                    <gallery:SemanticPartPreview Name="ColorPickerSemanticPreview"
                                                 Title="ColorPicker"
                                                 SemanticOwner="{Binding #ColorPickerSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:ColorPicker}"
                                                 PreviewStageMinHeight="600"
                                                 PreviewContentAlignment="Top">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <!-- 弹层高约 470+边距：舞台保留 trigger 下方空间并从顶部排布，
                                 避免较矮视口把 trigger 居中到可视区之外。 -->
                            <atom:ColorPicker Name="ColorPickerSemanticOwner"
                                              DefaultValue="#1677ff"
                                              IsTextVisible="True"
                                              IsPopupPinnedOpen="True" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:ColorPickerShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="body"
                                Description="{gallery:ColorPickerShowCaseLangResource SemanticBodyDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:ColorPickerShowCaseLangResource SemanticContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="description"
                                Description="{gallery:ColorPickerShowCaseLangResource SemanticDescriptionDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.root"
                                Description="{gallery:ColorPickerShowCaseLangResource SemanticPopupRootDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource BasicTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource BasicDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <atom:ColorPicker DefaultValue="#1677ff"/>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource ValueBindingTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource ValueBindingDescription}"
        BadgeText="v6.0.8"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:ColorPicker Value="{Binding BoundColorValue}"
                                  IsTextVisible="True"
                                  IsClearEnabled="True" />
                <atom:GradientColorPicker Value="{Binding BoundGradientValue}"
                                          IsTextVisible="True"
                                          IsClearEnabled="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <atom:TextBlock VerticalAlignment="Center"
                                Text="{gallery:ColorPickerShowCaseLangResource P2TextColorValue}" />
                <atom:TextBlock VerticalAlignment="Center"
                                Text="{Binding BoundColorValueText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <atom:TextBlock VerticalAlignment="Center"
                                Text="{gallery:ColorPickerShowCaseLangResource P2TextGradientValue}" />
                <atom:TextBlock VerticalAlignment="Center"
                                Text="{Binding BoundGradientValueText}" />
            </StackPanel>
            <WrapPanel ItemSpacing="10" LineSpacing="8">
                <atom:Button SizeType="Small"
                             Command="{Binding SetBoundColorValueCommand}"
                             Content="{gallery:ColorPickerShowCaseLangResource P2ContentSetColor}" />
                <atom:Button SizeType="Small"
                             Command="{Binding SetBoundGradientValueCommand}"
                             Content="{gallery:ColorPickerShowCaseLangResource P2ContentSetGradient}" />
                <atom:Button SizeType="Small"
                             Command="{Binding ClearBoundColorValueCommand}"
                             Content="{gallery:ColorPickerShowCaseLangResource P2ContentClearColor}" />
                <atom:Button SizeType="Small"
                             Command="{Binding ClearBoundGradientValueCommand}"
                             Content="{gallery:ColorPickerShowCaseLangResource P2ContentClearGradient}" />
            </WrapPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource TriggerSizeTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource TriggerSizeDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <atom:TextBlock Width="64"
                                VerticalAlignment="Center"
                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                Text="{gallery:ColorPickerShowCaseLangResource P2LabelSizeTypeSmall}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:ColorPicker DefaultValue="#1677ff" SizeType="Small"/>
                    <atom:ColorPicker DefaultValue="#1677ff" SizeType="Small" IsTextVisible="True"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <atom:TextBlock Width="64"
                                VerticalAlignment="Center"
                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                Text="{gallery:ColorPickerShowCaseLangResource P2LabelSizeTypeMiddle}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:ColorPicker DefaultValue="#1677ff" SizeType="Middle"/>
                    <atom:ColorPicker DefaultValue="#1677ff" SizeType="Middle" IsTextVisible="True"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <atom:TextBlock Width="64"
                                VerticalAlignment="Center"
                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                Text="{gallery:ColorPickerShowCaseLangResource P2LabelSizeTypeLarge}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:ColorPicker DefaultValue="#1677ff" SizeType="Large"/>
                    <atom:ColorPicker DefaultValue="#1677ff" SizeType="Large" IsTextVisible="True"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <atom:TextBlock Width="64"
                                VerticalAlignment="Center"
                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                Text="{gallery:ColorPickerShowCaseLangResource P2LabelSizeTypeCustom}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:ColorPicker DefaultValue="#1677ff"
                                      SizeType="Custom"
                                      Width="48"
                                      Height="48" />
                    <atom:ColorPicker DefaultValue="#1677ff"
                                      SizeType="Custom"
                                      IsTextVisible="True"
                                      Height="48"
                                      FontSize="18" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource LineGradientTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource LineGradientDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:GradientColorPicker IsTextVisible="True">
                <atom:GradientColorPicker.DefaultValue>
                    <LinearGradientBrush>
                        <GradientStop Color="#108ee9" Offset="0"/>
                        <GradientStop Color="#87d068" Offset="1"/>
                    </LinearGradientBrush>
                </atom:GradientColorPicker.DefaultValue>
            </atom:GradientColorPicker>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource RenderingTriggerTextTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource RenderingTriggerTextDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ColorPicker DefaultValue="#1677ff" IsTextVisible="True" IsClearEnabled="True"/>
            <atom:ColorPicker Name="CustomRenderText"
                              DefaultValue="#1677ff"
                              IsTextVisible="True"
                              AttachedToVisualTree="HandleCustomRenderTextAttached" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource DisabledTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource DisabledDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ColorPicker DefaultValue="#1677ff" IsTextVisible="True" IsEnabled="False"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource DisabledAlphaTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource DisabledAlphaDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ColorPicker DefaultValue="#1677ff" IsAlphaEnabled="False"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource ClearColorTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource ClearColorDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ColorPicker DefaultValue="#1677ff" IsTextVisible="True" IsClearEnabled="True"/>
            <atom:GradientColorPicker IsTextVisible="True" IsClearEnabled="True">
                <atom:GradientColorPicker.DefaultValue>
                    <LinearGradientBrush>
                        <GradientStop Color="#108ee9" Offset="0"/>
                        <GradientStop Color="#87d068" Offset="1"/>
                    </LinearGradientBrush>
                </atom:GradientColorPicker.DefaultValue>
            </atom:GradientColorPicker>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource ControlledModeTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource ControlledModeDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <atom:ColorPicker DefaultValue="#1677ff"/>
            <atom:ColorPicker DefaultValue="#1677ff" ValueSyncStrategy="OnCompleted"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource NeedConfirmTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource NeedConfirmDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <atom:ColorPicker IsNeedConfirm="True"
                                          IsClearEnabled="True"
                                          IsTextVisible="True"
                                          Value="{Binding BoundColorValue, Mode=TwoWay}" />
                        <TextBlock Text="{Binding BoundColorValueText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <atom:GradientColorPicker IsNeedConfirm="True"
                                                  IsClearEnabled="True"
                                                  Value="{Binding BoundGradientValue, Mode=TwoWay}" />
                        <TextBlock Text="{Binding BoundGradientValueText}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource CustomTriggerEventTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource CustomTriggerEventDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <atom:ColorPicker DefaultValue="#1677ff" TriggerType="Click"/>
            <atom:ColorPicker DefaultValue="#1677ff" TriggerType="Hover"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource ColorFormatTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource ColorFormatDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ColorPicker DefaultValue="#1677ff" Format="Hex" IsTextVisible="True"/>
            <atom:ColorPicker DefaultValue="#1677ff" Format="Hsva" IsTextVisible="True"/>
            <atom:ColorPicker DefaultValue="#1677ff" Format="Rgba" IsTextVisible="True"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ColorPickerShowCaseLangResource PresetColorsTitle}"
        Description="{gallery:ColorPickerShowCaseLangResource PresetColorsDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ColorPickerViewModel">
        <StackPanel Spacing="10" Orientation="Horizontal">
            <atom:ColorPicker DefaultValue="#1677ff" IsPaletteGroupEnabled="True"/>
            <atom:GradientColorPicker IsPaletteGroupEnabled="True" >
                <atom:GradientColorPicker.DefaultValue>
                    <LinearGradientBrush>
                        <GradientStop Color="#108ee9" Offset="0"/>
                        <GradientStop Color="#87d068" Offset="1"/>
                    </LinearGradientBrush>
                </atom:GradientColorPicker.DefaultValue>
            </atom:GradientColorPicker>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
                <!-- 自定义语义结构的样式（精确复刻 antd style-class.tsx 示例） -->
                <gallery:ShowCaseItem Title="{gallery:ColorPickerShowCaseLangResource StyleClassTitle}"
                                      Description="{gallery:ColorPickerShowCaseLangResource StyleClassDescription}"
                                      SourceKey="colorpicker-semantic-part"
                                      BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:ColorPickerViewModel">
                            <StackPanel HorizontalAlignment="Left" Spacing="20">
                                <StackPanel.Styles>
                                    <Style Selector="atom|ColorPicker.semantic-styles-demo">
                                        <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
                                    </Style>
                                    <Style Selector="atom|ColorPicker.semantic-styles-white-popup">
                                        <atom:ColorPickerPopupRootStyle x:SetterTargetType="Border">
                                            <Setter Property="BorderBrush" Value="#FFFFFF" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </atom:ColorPickerPopupRootStyle>
                                    </Style>
                                    <Style Selector="atom|ColorPicker.semantic-styles-purple-popup">
                                        <atom:ColorPickerPopupRootStyle x:SetterTargetType="Border">
                                            <Setter Property="BorderBrush" Value="#722ED1" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </atom:ColorPickerPopupRootStyle>
                                    </Style>
                                </StackPanel.Styles>
                                <atom:ColorPicker Classes="semantic-styles-demo semantic-styles-white-popup"
                                                  Name="ObjectStylesColorPicker"
                                                  DefaultValue="#1677ff"
                                                  IsArrowVisible="False" />
                                <atom:ColorPicker Classes="semantic-styles-demo semantic-styles-purple-popup"
                                                  Name="FunctionStylesColorPicker"
                                                  DefaultValue="#722ed1"
                                                  SizeType="Large"
                                                  IsArrowVisible="False" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
