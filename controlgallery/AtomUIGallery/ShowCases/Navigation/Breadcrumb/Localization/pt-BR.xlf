    <unit id="PageDescription">
      <segment>
        <source>Breadcrumb helps users understand where they are and move back through parent levels. It supports icons, custom separators, route context, URI navigation, and item templates.</source>
        <target state="translated">Trilha helps usuários understand where they são e move voltar through pai levels. Isso oferece suporte ícones, personalizado separators, route context, URI navegação, e item templates.</target>
      </segment>
    </unit>
