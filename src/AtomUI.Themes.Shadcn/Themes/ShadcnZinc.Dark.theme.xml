<?xml version="1.0" encoding="utf-8"?>
<Theme xmlns="https://atomui.net/schemas/theme/v1" Id="ShadcnZinc.Dark" Name="Shadcn Zinc Dark" Appearance="Dark" DesignLanguage="Shadcn.Zinc" BrandColor="Fixed" IsDefault="false">
  <Algorithms>
    <Algorithm Id="Dark" />
  </Algorithms>
  <Tokens>
    <Token Name="ColorPrimary" Value="#FAFAFA" />
    <Token Name="ColorPrimaryHover" Value="#F4F4F5" />
    <Token Name="ColorPrimaryActive" Value="#E4E4E7" />
    <Token Name="ColorTextLightSolid" Value="#18181B" />
    <Token Name="ColorPrimaryBg" Value="#27272A" />
    <Token Name="ColorPrimaryBgHover" Value="#3F3F46" />
    <Token Name="ColorPrimaryBorder" Value="#3F3F46" />
    <Token Name="ColorPrimaryBorderHover" Value="#52525B" />
    <Token Name="ColorPrimaryText" Value="#FAFAFA" />
    <Token Name="ColorPrimaryTextHover" Value="#F4F4F5" />
    <Token Name="ColorPrimaryTextActive" Value="#E4E4E7" />
    <Token Name="ColorText" Value="#FAFAFA" />
    <Token Name="ColorTextSecondary" Value="#A1A1AA" />
    <Token Name="ColorTextTertiary" Value="#71717A" />
    <Token Name="ColorTextQuaternary" Value="#52525B" />
    <Token Name="ColorTextDescription" Value="#A1A1AA" />
    <Token Name="ColorTextPlaceholder" Value="#71717A" />
    <Token Name="ColorTextDisabled" Value="#52525B" />
    <Token Name="ColorBgBase" Value="#18181B" />
    <Token Name="ColorTextBase" Value="#FAFAFA" />
    <Token Name="ColorBgLayout" Value="#18181B" />
    <Token Name="ColorBgContainer" Value="#18181B" />
    <Token Name="ColorBgElevated" Value="#27272A" />
    <Token Name="ColorBgContainerDisabled" Value="#27272A" />
    <Token Name="ColorBorder" Value="#27272A" />
    <Token Name="ColorBorderSecondary" Value="#3F3F46" />
    <Token Name="ColorFill" Value="#3F3F46" />
    <Token Name="ColorFillSecondary" Value="#27272A" />
    <Token Name="ColorFillTertiary" Value="#27272A" />
    <Token Name="ColorFillQuaternary" Value="#18181B" />
    <Token Name="BorderRadius" Value="6" />
    <Token Name="ControlHeight" Value="36" />
    <Token Name="ControlHeightSM" Value="32" />
    <Token Name="ControlHeightLG" Value="40" />
    <Token Name="PaddingContentHorizontal" Value="12" />
    <Token Name="LineWidth" Value="1" />
    <Token Name="EnableWaveSpirit" Value="false" />
    <Token Name="BoxShadows" Value="0 10 15 -3 #1A000000, 0 4 6 -4 #1A000000" />
    <Token Name="BoxShadowsSecondary" Value="0 4 6 -1 #1A000000, 0 2 4 -2 #1A000000" />
  </Tokens>
  <Controls>
    <Control Catalog="AtomUI" Id="CheckBox">
      <Tokens>
        <Token Name="ColorWhite" Value="#18181B" />
      </Tokens>
    </Control>
    <Control Catalog="AtomUI" Id="RadioButton">
      <Tokens>
        <Token Name="RadioColor" Value="#18181B" />
      </Tokens>
    </Control>
    <!-- shadcn/ui switch thumb is the background colour (bg-background); a white thumb vanishes on the near-white
         primary track. -->
    <Control Catalog="AtomUI" Id="ToggleSwitch">
      <Tokens>
        <Token Name="HandleCheckedBg" Value="#18181B" />
      </Tokens>
    </Control>
    <!-- shadcn popups pair shadow-md with a 1px border (ColorBorder); the ring keeps the top edge visible. -->
    <Control Catalog="AtomUI" Id="Popup">
      <Tokens>
        <Token Name="PopupRootShadow" Value="0 0 0 1 #27272A, 0 4 6 -1 #1A000000, 0 2 4 -2 #1A000000" />
        <Token Name="OverlayHostShadow" Value="0 0 0 1 #27272A, 0 4 6 -1 #1A000000, 0 2 4 -2 #1A000000" />
      </Tokens>
    </Control>
  </Controls>
</Theme>
