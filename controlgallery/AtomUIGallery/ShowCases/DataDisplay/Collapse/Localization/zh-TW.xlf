    <unit id="AccordionDescription">
      <segment>
        <source>In accordion mode, only one panel can be expanded at a time.</source>
        <target state="translated">在手風琴模式下，同一時間只能展開一個面板。</target>
      </segment>
    </unit>
    <unit id="AccordionTitle">
