    <unit id="PageDescription">
      <segment>
        <source>TimePicker supports 12-hour and 24-hour clocks, size variants, disabled states, stepped minute and second options, visual variants, validation status, and range selection.</source>
        <target state="translated">TimePicker 支援 12 小時和 24 小時制、尺寸變體、禁用狀態、分鐘和秒的步進選項、視覺變體、校驗狀態以及範圍選擇。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Select a time or a time range from a popup time panel.</source>
        <target state="translated">從彈出時間面板中選擇單個時間或時間範圍。</target>
      </segment>
    </unit>
    <unit id="PickerDisplayTimeDescription">
      <segment>
        <source>Open the popup panel at a specific display time without committing a selected value.</source>
        <target state="translated">打開彈出面板時定位到指定時間，但不提交選中值。</target>
      </segment>
    </unit>
    <unit id="PickerDisplayTimeTitle">
      <segment>
        <source>Popup display time</source>
        <target state="translated">彈出面板顯示時間</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="SemanticClearDescription">
      <segment>
        <source>Clear button rendered in clear mode.</source>
        <target state="translated">清除模式下渲染的清除按鈕。</target>
      </segment>
    </unit>
    <unit id="SemanticInputDescription">
      <segment>
        <source>Start time text input box.</source>
        <target state="translated">起始端時間文字輸入框。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Owner-scoped styles targeting public Semantic Parts of the TimePicker family via their real selectors.</source>
        <target state="translated">使用 owner 作用域選擇器和 TimePicker 屬性選擇器自訂已發佈的 Semantic Part。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
        <target state="translated">自訂語義結構的樣式</target>
      </segment>
    </unit>
    <unit id="SemanticPopupColumnDescription">
      <segment>
        <source>Host of a single scrolling time column.</source>
        <target state="translated">單一捲動時間欄的宿主。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupContainerDescription">
      <segment>
        <source>Content container organizing the time panel and footer.</source>
        <target state="translated">組織時間面板與底部按鈕區的內容容器。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupContentDescription">
      <segment>
        <source>Layout container of all time columns.</source>
        <target state="translated">全部時間欄的佈局容器。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupFooterDescription">
      <segment>
        <source>Bottom action area with Now and Confirm buttons.</source>
        <target state="translated">承載此刻與確認按鈕的底部操作區。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupItemDescription">
      <segment>
        <source>Selectable time cell inside a column.</source>
        <target state="translated">時間欄內可選取的時間格子項。</target>
      </segment>
    </unit>
    <unit id="SemanticPopupRootDescription">
      <segment>
        <source>Root surface of the time popup layer.</source>
        <target state="translated">時間彈層的根視覺盒子。</target>
      </segment>
    </unit>
    <unit id="SemanticPrefixDescription">
      <segment>
        <source>Prefix add-on area inside the input zone.</source>
        <target state="translated">輸入區內容前綴區域。</target>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>The TimePicker owner itself.</source>
        <target state="translated">TimePicker 控制項本體。</target>
      </segment>
    </unit>
    <unit id="SemanticSecondaryInputDescription">
      <segment>
        <source>End time text input box of the range selection.</source>
        <target state="translated">範圍選擇結束端時間文字輸入框。</target>
      </segment>
    </unit>
    <unit id="SemanticSuffixDescription">
      <segment>
        <source>Suffix add-on area of the input zone.</source>
        <target state="translated">輸入區後綴區域。</target>
      </segment>
    </unit>
    <unit id="StatusDescription">
      <segment>
        <source>Add status to TimePicker with status, which could be error or warning.</source>
        <target state="translated">通過 status 為 TimePicker 添加狀態，可設置為錯誤或警告。</target>
      </segment>
    </unit>
    <unit id="StatusTitle">
      <segment>
        <source>Status</source>
        <target state="translated">狀態</target>
      </segment>
    </unit>
    <unit id="ThreeSizesDescription">
      <segment>
        <source>The input box comes in three sizes: large, middle and small. Large is used in the form, while the medium size is the default.</source>
        <target state="translated">輸入框提供大號、中號和小號三種尺寸。大號用於表單，中號為默認尺寸。</target>
      </segment>
    </unit>
    <unit id="ThreeSizesTitle">
      <segment>
        <source>Three Sizes</source>
        <target state="translated">三種尺寸</target>
      </segment>
    </unit>
    <unit id="TimeRangePickerDescription">
      <segment>
        <source>Use time range picker with RangeTimePicker.</source>
        <target state="translated">使用 RangeTimePicker 進行時間範圍選擇。</target>
      </segment>
    </unit>
    <unit id="TimeRangePickerTitle">
      <segment>
        <source>Time Range Picker</source>
        <target state="translated">時間範圍選擇器</target>
      </segment>
    </unit>
    <unit id="TwelveHoursDescription">
      <segment>
        <source>TimePicker of 12 hours format, with default format h:mm:ss a.</source>
        <target state="translated">12 小時格式的 TimePicker，默認格式為 h:mm:ss a。</target>
      </segment>
    </unit>
    <unit id="TwelveHoursTitle">
      <segment>
        <source>12 hours</source>
        <target state="translated">12 小時制</target>
      </segment>
    </unit>
    <unit id="VariantsDescription">
      <segment>
        <source>Bordered-less style component.</source>
        <target state="translated">無邊框風格組件。</target>
      </segment>
    </unit>
    <unit id="VariantsTitle">
      <segment>
        <source>Variants</source>
        <target state="translated">變體</target>
      </segment>
    </unit>
    <unit id="NeedConfirmTitle">
      <segment>
        <source>Confirm selection</source>
        <target state="translated">確認選擇</target>
      </segment>
    </unit>
    <unit id="NeedConfirmDescription">
      <segment>
        <source>IsNeedConfirm is enabled by default. Selecting a time updates the input immediately; OK submits the value. With IsNeedConfirm=False, closing the panel submits the candidate. Hover and ordinary scrolling do not submit.</source>
        <target state="translated">IsNeedConfirm 預設啟用。選時立即更新輸入框，點擊 OK 提交繫結值；設為 False 時，關閉面板提交候選時間。懸停和一般捲動不提交值。</target>
      </segment>
    </unit>
