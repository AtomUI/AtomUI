<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:gallery="https://atomui.net/toolkits/gallery-base">
    <ControlTheme x:Key="{x:Type gallery:SemanticPartPreview}"
                  TargetType="{x:Type gallery:SemanticPartPreview}">
        <Setter Property="MaxHeight"
                Value="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=MaxHeight}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type gallery:SemanticPartPreview}">
                <Grid>
                    <Border Name="PART_InspectionPanel"
                            MinHeight="{gallery:SemanticPartPreviewTokenResource InspectionMinHeight}"
                            Margin="{gallery:SemanticPartPreviewTokenResource InspectionMargin}"
                            VerticalAlignment="Top"
                            Background="{atom:OwnerTokenResource Kind=ColorBgContainer, AnchorControlType={x:Type gallery:SemanticPartPreview}}"
                            BorderBrush="{atom:OwnerTokenResource Kind=ColorBorderSecondary, AnchorControlType={x:Type gallery:SemanticPartPreview}}"
                            BorderThickness="{atom:OwnerTokenResource Kind=BorderThickness, AnchorControlType={x:Type gallery:SemanticPartPreview}}">
                        <!--  内容行用星号:Auto 行会以无穷高度测量布局面板,
                              宿主 MaxHeight 钳制无法传导,固定高度内容会溢出视口  -->
                        <Grid RowDefinitions="*,Auto">
                            <gallery:SemanticPartPreviewLayoutPanel Name="PART_Layout"
                                                                    Grid.Row="0"
                                                                    Spacing="0"
                                                                    PreviewStageMinHeight="{TemplateBinding PreviewStageMinHeight}"
                                                                    PaneMaxHeight="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MaxHeight, Converter={x:Static gallery:SemanticPartPreview.PaneMaxHeightConverter}}">
                                <gallery:SemanticPartPreviewLayoutPanel.CompactBreakpoint>
                                    <MultiBinding Converter="{x:Static gallery:SemanticPartPreviewBreakpointConverter.Instance}"
                                                  ConverterParameter="{x:Static gallery:SemanticPartPreviewBreakpointConverter.OuterBreakpoint}">
                                        <CompiledBindingExtension Path="#PART_InspectionPanel.Margin" />
                                        <CompiledBindingExtension Path="#PART_InspectionPanel.BorderThickness" />
                                    </MultiBinding>
                                </gallery:SemanticPartPreviewLayoutPanel.CompactBreakpoint>
                                <Border Name="PART_PreviewStage"
                                        Background="{atom:OwnerTokenResource Kind=ColorBgLayout, AnchorControlType={x:Type gallery:SemanticPartPreview}}"
                                        Padding="{gallery:SemanticPartPreviewTokenResource StagePadding}">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Name="PART_Title"
                                                   Margin="{gallery:SemanticPartPreviewTokenResource TitleMargin}"
                                                   Text="{TemplateBinding Title}"
                                                   FontSize="{gallery:SemanticPartPreviewTokenResource TitleFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{atom:OwnerTokenResource Kind=ColorText, AnchorControlType={x:Type gallery:SemanticPartPreview}}"
                                                   IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <ContentPresenter Name="PART_PreviewContentHost"
                                                          Grid.Row="1"
                                                          Content="{TemplateBinding PreviewContent}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch"
                                                          VerticalContentAlignment="{TemplateBinding PreviewContentAlignment}" />
                                    </Grid>
                                </Border>

                                <Border Name="PART_PartsPane"
                                        ClipToBounds="True"
                                        BorderBrush="{atom:OwnerTokenResource Kind=ColorBorderSecondary, AnchorControlType={x:Type gallery:SemanticPartPreview}}"
                                        BorderThickness="{gallery:SemanticPartPreviewTokenResource VerticalDividerThickness}">
                                    <atom:ScrollViewer VerticalScrollBarVisibility="Auto"
                                                       AllowAutoHide="False"
                                                       BringIntoViewOnFocusChange="False">
                                        <ItemsControl ItemsSource="{TemplateBinding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="0" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gallery:SemanticPartPreviewItem">
                                                    <gallery:SemanticPartPreviewItemControl Item="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </atom:ScrollViewer>
                                </Border>
                            </gallery:SemanticPartPreviewLayoutPanel>

                            <Border Name="PART_DetailsPane"
                                    Grid.Row="1"
                                    Background="{atom:OwnerTokenResource Kind=ColorFillAlter, AnchorControlType={x:Type gallery:SemanticPartPreview}}"
                                    BorderBrush="{atom:OwnerTokenResource Kind=ColorBorderSecondary, AnchorControlType={x:Type gallery:SemanticPartPreview}}"
                                    BorderThickness="{gallery:SemanticPartPreviewTokenResource HorizontalDividerThickness}"
                                    IsVisible="{TemplateBinding CodeContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <DockPanel LastChildFill="True">
                                    <Border Name="PART_InfoPane"
                                            BorderBrush="{atom:OwnerTokenResource Kind=ColorBorderSecondary, AnchorControlType={x:Type gallery:SemanticPartPreview}}">
                                        <ContentPresenter Name="PART_InfoContent"
                                                          Content="{TemplateBinding InfoContent}" />
                                    </Border>
                                    <ContentPresenter Name="PART_CodeContent"
                                                      Content="{TemplateBinding CodeContent}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:compact /template/ Border#PART_InspectionPanel">
            <Setter Property="Margin" Value="{gallery:SemanticPartPreviewTokenResource CompactInspectionMargin}" />
        </Style>
        <Style Selector="^:compact /template/ TextBlock#PART_Title">
            <Setter Property="Margin" Value="{gallery:SemanticPartPreviewTokenResource CompactTitleMargin}" />
        </Style>
        <Style Selector="^:compact /template/ Border#PART_PreviewStage">
            <Setter Property="Padding" Value="{gallery:SemanticPartPreviewTokenResource CompactStagePadding}" />
        </Style>
        <Style Selector="^:compact /template/ Border#PART_PartsPane">
            <Setter Property="BorderThickness" Value="{gallery:SemanticPartPreviewTokenResource HorizontalDividerThickness}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_InfoPane">
            <Setter Property="Width" Value="340" />
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="BorderThickness" Value="{gallery:SemanticPartPreviewTokenResource InfoDividerThickness}" />
        </Style>
        <Style Selector="^:compact /template/ Border#PART_InfoPane">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="BorderThickness" Value="{gallery:SemanticPartPreviewTokenResource CompactInfoDividerThickness}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
