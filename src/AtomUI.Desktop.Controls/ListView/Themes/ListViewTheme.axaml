<!-- owner: global Tokens are read from the owner because this theme is also the base of TransferListView (its own
     identity) and of the identity-less Select candidate list, which follows the Select. On a ListView the owner is the ListView. -->
<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:antdicons="https://atomui.net/icons/antdesign"
              x:ClassModifier="internal"
              x:Class="AtomUI.Desktop.Controls.Themes.ListViewTheme"
              TargetType="atom:ListView">
        <Setter Property="atom:GroupHeaderItem.ThemeContentPadding" Value="{atom:ListViewTokenResource ContentPadding}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemColor" Value="{atom:ListViewTokenResource ItemColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemHoverColor" Value="{atom:ListViewTokenResource ItemHoverColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemSelectedColor" Value="{atom:ListViewTokenResource ItemSelectedColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemDisabledColor" Value="{atom:ListViewTokenResource ItemDisabledColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemBgColor" Value="{atom:ListViewTokenResource ItemBgColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemHoverBgColor" Value="{atom:ListViewTokenResource ItemHoverBgColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemSelectedBgColor" Value="{atom:ListViewTokenResource ItemSelectedBgColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemPadding" Value="{atom:ListViewTokenResource ItemPadding}" />
        <Style Selector="^[SizeType=Small]">
            <Setter Property="atom:GroupHeaderItem.ThemeItemPadding" Value="{atom:ListViewTokenResource ItemPaddingSM}" />
        </Style>
        <Style Selector="^[SizeType=Large]">
            <Setter Property="atom:GroupHeaderItem.ThemeItemPadding" Value="{atom:ListViewTokenResource ItemPaddingLG}" />
        </Style>
        <Setter Property="atom:GroupHeaderItem.ThemeItemMargin" Value="{atom:ListViewTokenResource ItemMargin}" />
        <Setter Property="atom:GroupHeaderItem.ThemeGroupHeaderColor" Value="{atom:ListViewTokenResource GroupHeaderColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeGroupHeaderPadding" Value="{atom:ListViewTokenResource GroupHeaderPadding}" />
        <Setter Property="atom:GroupHeaderItem.ThemeSelectedIndicatorMargin" Value="{atom:ListViewTokenResource SelectedIndicatorMargin}" />

    <Setter Property="Template">
        <ControlTemplate TargetType="atom:ListView">
            <atom:PixelAlignedBorder Name="Frame"
                                     Background="{TemplateBinding Background}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Padding="{TemplateBinding Padding}"
                                     Margin="{TemplateBinding Margin}"
                                     ClipContentToCornerRadius="True">
                <DockPanel LastChildFill="True">
                    <ContentPresenter Name="TopPaginationPresenter" DockPanel.Dock="Top" 
                                      IsVisible="{TemplateBinding TopPagination, Converter={x:Static ObjectConverters.IsNotNull}}" 
                                      Content="{TemplateBinding TopPagination}"/>
                    <ContentPresenter Name="BottomPaginationPresenter" DockPanel.Dock="Bottom" 
                                      IsVisible="{TemplateBinding BottomPagination, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      Content="{TemplateBinding BottomPagination}"/>
                    <atom:Spin IsSpinning="{TemplateBinding IsOperating}"
                               IsTipVisible="True"
                               Tip="{TemplateBinding OperatingMsg}"
                               CustomIndicator="{TemplateBinding CustomOperatingIndicator}"
                               CustomIndicatorTemplate="{TemplateBinding CustomOperatingIndicatorTemplate}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch">
                        <Panel>
                            <atom:ScrollViewer Name="{x:Static atom:ListViewThemeConstants.ScrollViewerPart}"
                                               IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                               IsVisible="{TemplateBinding IsEffectiveEmptyVisible, Converter={x:Static BoolConverters.Not}}"
                                               AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}"
                                               HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                               VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                               IsScrollChainingEnabled="{TemplateBinding ScrollViewer.IsScrollChainingEnabled}"
                                               IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                               IsScrollInertiaEnabled="{TemplateBinding ScrollViewer.IsScrollInertiaEnabled}">
                                <ItemsPresenter Name="ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </atom:ScrollViewer>
                            <ContentPresenter
                                Name="EmptyIndicator"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Padding="{TemplateBinding EmptyIndicatorPadding}"
                                IsVisible="{TemplateBinding IsEffectiveEmptyVisible}"
                                Content="{TemplateBinding EmptyIndicator}"
                                ContentTemplate="{TemplateBinding EmptyIndicatorTemplate}" />
                            <atom:Empty
                                Name="DefaultEmptyIndicator"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding EmptyIndicatorPadding}"
                                IsVisible="{TemplateBinding IsDefaultEmptyIndicatorVisible}"
                                SizeType="Small"
                                PresetImage="Simple" />
                        </Panel>
                    </atom:Spin>
                </DockPanel>
            </atom:PixelAlignedBorder>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|ListView)">
        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="False" />
        <Setter Property="ItemHoverBg" Value="{Binding $self.(atom:GroupHeaderItem.ThemeItemHoverBgColor)}" />
        <Setter Property="ItemSelectedBg" Value="{Binding $self.(atom:GroupHeaderItem.ThemeItemSelectedBgColor)}" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorSplit}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
        <Setter Property="Padding" Value="{Binding $self.(atom:GroupHeaderItem.ThemeContentPadding)}" />

        <Setter Property="SelectedIndicator">
            <atom:IconTemplate>
                <antdicons:CheckOutlined />
            </atom:IconTemplate>
        </Setter>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}" />
            <Setter Property="EmptyIndicatorPadding" Value="{atom:OwnerTokenResource PaddingXL}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
            <Setter Property="EmptyIndicatorPadding" Value="{atom:OwnerTokenResource Padding}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
            <Setter Property="EmptyIndicatorPadding" Value="{atom:OwnerTokenResource Padding}" />
        </Style>

        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="atom:IListItemData">
                <atom:TextBlock Text="{Binding Content}" />
            </DataTemplate>
        </Setter>
        
        <Setter Property="GroupItemTemplate">
            <DataTemplate x:DataType="atom:IListItemData">
                <atom:TextBlock Text="{Binding Content}" />
            </DataTemplate>
        </Setter>
        
        <Style Selector="^ /template/ ContentPresenter#TopPaginationPresenter">
            <Setter Property="Margin" Value="{atom:ListViewTokenResource PaginationMargin}"/>
        </Style>
        
        <Style Selector="^ /template/ ContentPresenter#BottomPaginationPresenter">
            <Setter Property="Margin" Value="{atom:ListViewTokenResource PaginationMargin}"/>
        </Style>
    </Style>

</ControlTheme>
