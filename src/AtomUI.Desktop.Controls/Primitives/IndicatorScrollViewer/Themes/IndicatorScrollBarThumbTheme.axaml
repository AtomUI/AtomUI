<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:AtomUI.Desktop.Controls.Primitives"
    xmlns:atom="https://atomui.net"
    >
    <ControlTheme x:Key="{x:Type primitives:IndicatorScrollBarThumb}"
                  TargetType="primitives:IndicatorScrollBarThumb">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#Frame">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background" Easing="LinearEasing" atom:TokenTransitions.Easing="StateTransitionEasingOverride"
                                                        atom:TokenTransitions.Duration="StateTransitionDuration" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
        <Setter Property="Background" Value="{atom:ScrollViewerTokenResource ThumbBg}"/>
        <Setter Property="CornerRadius" Value="{atom:ScrollViewerTokenResource IndicatorThumbCornerRadius}"/>
        <Setter Property="MinHeight"
                Value="{atom:ScrollViewerTokenResource LiteModeThumbThickness}" />
        <Setter Property="Width" Value="{atom:ScrollViewerTokenResource NormalModeThumbThickness}" />
    </ControlTheme>
</ResourceDictionary>
