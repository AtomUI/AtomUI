<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SpinIndicator}" TargetType="atom:SpinIndicator">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atomc:SpinIndicatorDotPanel
                        Name="BuiltInIndicatorLayout"
                        Classes.semantic-content="True"
                        Width="{TemplateBinding IndicatorSize}"
                        Height="{TemplateBinding IndicatorSize}">
                        <Ellipse Classes="SpinIndicatorDot"
                                 Width="{TemplateBinding DotSize}"
                                 Height="{TemplateBinding DotSize}"
                                 Fill="{TemplateBinding DotBgBrush}"
                                 Opacity="0.3" />
                        <Ellipse Classes="SpinIndicatorDot"
                                 Width="{TemplateBinding DotSize}"
                                 Height="{TemplateBinding DotSize}"
                                 Fill="{TemplateBinding DotBgBrush}"
                                 Opacity="0.3" />
                        <Ellipse Classes="SpinIndicatorDot"
                                 Width="{TemplateBinding DotSize}"
                                 Height="{TemplateBinding DotSize}"
                                 Fill="{TemplateBinding DotBgBrush}"
                                 Opacity="0.3" />
                        <Ellipse Classes="SpinIndicatorDot"
                                 Width="{TemplateBinding DotSize}"
                                 Height="{TemplateBinding DotSize}"
                                 Fill="{TemplateBinding DotBgBrush}"
                                 Opacity="0.3" />
                    </atomc:SpinIndicatorDotPanel>
                    <ContentPresenter
                        Name="PART_CustomIndicatorPresenter"
                        Classes.semantic-content="True"
                        Content="{TemplateBinding CustomIndicator}"
                        ContentTemplate="{TemplateBinding CustomIndicatorTemplate}"
                        Width="{TemplateBinding IndicatorSize}"
                        Height="{TemplateBinding IndicatorSize}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MotionEasingCurve" Value="LinearEasing" />
        <Setter Property="MotionDuration"
                Value="{atom:SpinTokenResource IndicatorDuration}" />
        <Setter Property="DotBgBrush" Value="{atom:SharedTokenResource ColorPrimary}" />

        <Style Selector="^[IsCustomIndicator=True] /template/ atomc|SpinIndicatorDotPanel#BuiltInIndicatorLayout">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^[IsCustomIndicator=True] /template/ ContentPresenter#PART_CustomIndicatorPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="IndicatorSize" Value="{atom:SpinTokenResource IndicatorSizeLG}" />
            <Setter Property="DotSize" Value="{atom:SpinTokenResource DotSizeLG}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="IndicatorSize" Value="{atom:SpinTokenResource IndicatorSize}" />
            <Setter Property="DotSize" Value="{atom:SpinTokenResource DotSize}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="IndicatorSize" Value="{atom:SpinTokenResource IndicatorSizeSM}" />
            <Setter Property="DotSize" Value="{atom:SpinTokenResource DotSizeSM}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
