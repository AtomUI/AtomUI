<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Pagination.PaginationShowCase"
             xmlns:vm="using:AtomUIGallery.ShowCases.Pagination"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             x:DataType="vm:PaginationViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Pagination"
                    Category="{gallery:PaginationShowCaseLangResource ComponentCategory}"
                    Status="{gallery:PaginationShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:PaginationShowCaseLangResource PageSubtitle}"
                    Description="{gallery:PaginationShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="AbstractPagination" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:PaginationViewModel">
                    <StackPanel Spacing="24">
                        <gallery:SemanticPartPreview Name="PaginationSemanticPreview"
                                                     SemanticOwner="{Binding #PaginationSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:Pagination}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:Pagination Name="PaginationSemanticOwner"
                                                 Total="50"
                                                 CurrentPage="1"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:PaginationShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="item"
                                    Description="{gallery:PaginationShowCaseLangResource SemanticItemDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                        <gallery:SemanticPartPreview Name="SimplePaginationSemanticPreview"
                                                     SemanticOwner="{Binding #SimplePaginationSemanticOwner}"
                                                     SemanticOwnerType="{x:Type atom:SimplePagination}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:SimplePagination Name="SimplePaginationSemanticOwner"
                                                       Total="50"
                                                       CurrentPage="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:PaginationShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="item"
                                    Description="{gallery:PaginationShowCaseLangResource SemanticItemDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="info"
                                    Description="{gallery:PaginationShowCaseLangResource SemanticInfoDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:PaginationShowCaseLangResource BasicTitle}"
                    Description="{gallery:PaginationShowCaseLangResource BasicDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="200"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <atom:Pagination Total="50" CurrentPage="1" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:PaginationShowCaseLangResource BindingTitle}"
                    Description="{gallery:PaginationShowCaseLangResource BindingDescription}"
                    BadgeText="v6.0.8"
                    IsOccupyEntireRow="True"
                    MinHeight="260"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <StackPanel Orientation="Vertical" Spacing="12">
                                <atom:Pagination Total="120"
                                                 CurrentPage="{Binding BoundCurrentPage}"
                                                 PageSize="{Binding BoundPageSize}"
                                                 IsShowSizeChanger="True"
                                                 IsShowQuickJumper="True"
                                                 IsShowTotalInfo="True" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <atom:TextBlock VerticalAlignment="Center"
                                                        Text="{gallery:PaginationShowCaseLangResource P2TextCurrentPage}" />
                                        <atom:TextBlock VerticalAlignment="Center"
                                                        Text="{Binding BoundCurrentPageText}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <atom:TextBlock VerticalAlignment="Center"
                                                        Text="{gallery:PaginationShowCaseLangResource P2TextPageSize}" />
                                        <atom:TextBlock VerticalAlignment="Center"
                                                        Text="{Binding BoundPageSizeText}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button SizeType="Small"
                                                 Command="{Binding SetBoundPaginationCommand}"
                                                 Content="{gallery:PaginationShowCaseLangResource P2ContentSetPage}" />
                                    <atom:Button SizeType="Small"
                                                 Command="{Binding ResetBoundPaginationCommand}"
                                                 Content="{gallery:PaginationShowCaseLangResource P2ContentReset}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:PaginationShowCaseLangResource AlignTitle}"
                    Description="{gallery:PaginationShowCaseLangResource AlignDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <atom:Pagination Total="50" CurrentPage="1" Align="Start" />
                                <atom:Pagination Total="50" CurrentPage="1" Align="Center" />
                                <atom:Pagination Total="50" CurrentPage="1" Align="End" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:PaginationShowCaseLangResource MoreTitle}"
                    Description="{gallery:PaginationShowCaseLangResource MoreDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <atom:Pagination Total="500" CurrentPage="6" IsShowSizeChanger="True" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="pagination-custom-size-changer"
                    Title="{gallery:PaginationShowCaseLangResource CustomComponentTitle}"
                    Description="{gallery:PaginationShowCaseLangResource CustomComponentDescription}"
                    BadgeText="v6.2.1"
                    IsOccupyEntireRow="True"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <atom:Pagination Total="500"
                                             CurrentPage="3"
                                             IsShowSizeChanger="True">
                                <atom:Pagination.SizeChangerTemplate>
                                    <DataTemplate x:DataType="atom:PaginationSizeChangerContext">
                                        <atom:NumericUpDown Width="100"
                                                            Minimum="1"
                                                            Increment="1"
                                                            FormatString="0"
                                                            AutomationProperties.Name="{gallery:PaginationShowCaseLangResource CustomComponentAutomationName}"
                                                            SizeType="{Binding SizeType}"
                                                            Value="{Binding PageSize, Mode=TwoWay}" />
                                    </DataTemplate>
                                </atom:Pagination.SizeChangerTemplate>
                            </atom:Pagination>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:PaginationShowCaseLangResource MoreTitle}"
                    Description="{gallery:PaginationShowCaseLangResource MoreDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <atom:Pagination Total="500" CurrentPage="3" IsShowSizeChanger="True"
                                                 IsShowQuickJumper="True" />
                                <atom:Pagination Total="500" CurrentPage="3" IsShowSizeChanger="True" IsEnabled="False"
                                                 IsShowQuickJumper="True" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:PaginationShowCaseLangResource MiniSizeTitle}"
                    Description="{gallery:PaginationShowCaseLangResource MiniSizeDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <atom:Pagination Total="50" CurrentPage="1" SizeType="Small" />
                                <atom:Pagination Total="50" CurrentPage="1" SizeType="Small" IsShowSizeChanger="True"
                                                 IsShowQuickJumper="True" />

                                <atom:Pagination Total="50" IsShowTotalInfo="True" CurrentPage="1" SizeType="Small" />
                                <atom:Pagination Total="50" IsShowTotalInfo="True" CurrentPage="1" SizeType="Small"
                                                 IsShowSizeChanger="True" IsShowQuickJumper="True" IsEnabled="False" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:PaginationShowCaseLangResource TotalNumberTitle}"
                    Description="{gallery:PaginationShowCaseLangResource TotalNumberDescription}"
                    IsOccupyEntireRow="True"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <atom:Pagination Total="85" CurrentPage="1" PageSize="20" IsShowSizeChanger="True"
                                                 IsShowTotalInfo="True" />
                                <atom:Pagination Total="85"
                                                 CurrentPage="1"
                                                 PageSize="20"
                                                 IsShowSizeChanger="True"
                                                 IsShowTotalInfo="True"
                                                 TotalInfoTemplate="${RangeStart}-${RangeEnd} of ${Total} items" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:PaginationShowCaseLangResource SimpleModeTitle}"
                    Description="{gallery:PaginationShowCaseLangResource SimpleModeDescription}"
                    IsOccupyEntireRow="False"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <atom:SimplePagination Total="50" CurrentPage="1" />
                                <atom:SimplePagination Total="50" CurrentPage="1" IsReadOnly="False" />
                                <atom:SimplePagination Total="50" CurrentPage="1" IsReadOnly="False" IsEnabled="False" />

                                <atom:SimplePagination Total="50" CurrentPage="1" SizeType="Small" />
                                <atom:SimplePagination Total="50" CurrentPage="1" SizeType="Small" />
                                <atom:SimplePagination Total="50" CurrentPage="1" IsReadOnly="False" SizeType="Small" />
                                <atom:SimplePagination Total="50" CurrentPage="1" IsReadOnly="False" IsEnabled="False"
                                                       SizeType="Small" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
                <gallery:ShowCaseItem
                    Title="{gallery:PaginationShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:PaginationShowCaseLangResource SemanticPartStyleDescription}"
                    SourceKey="pagination-semantic-part"
                    BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                    Span="Full"
                    MinHeight="300"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:PaginationViewModel">
                            <StackPanel Spacing="16">
                                <StackPanel.Styles>
                                    <Style Selector="atom|Pagination.semantic-style-demo-root">
                                        <Setter Property="BorderBrush" Value="#CCCCCC" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="BorderDashArray" Value="4,2" />
                                        <Setter Property="Padding" Value="8" />
                                    </Style>
                                    <Style Selector="atom|Pagination.semantic-style-demo-object">
                                        <atom:PaginationItemStyle x:SetterTargetType="ContentControl">
                                            <Setter Property="CornerRadius" Value="999" />
                                        </atom:PaginationItemStyle>
                                    </Style>
                                    <Style Selector="atom|Pagination[SizeType=Small]">
                                        <atom:PaginationItemStyle x:SetterTargetType="ContentControl">
                                            <Setter Property="Background" Value="#4DC8C8C8" />
                                            <Setter Property="Margin" Value="0,0,4,0" />
                                            <Style Selector="^:selected">
                                                <Setter Property="Background"
                                                        Value="{atom:PaginationTokenResource ItemActiveBg}" />
                                            </Style>
                                        </atom:PaginationItemStyle>
                                    </Style>
                                </StackPanel.Styles>
                                <atom:Pagination Classes="semantic-style-demo-root semantic-style-demo-object"
                                                 Total="500"
                                                 CurrentPage="1"
                                                 IsShowSizeChanger="True"
                                                 HorizontalAlignment="Stretch" />
                                <atom:Pagination Classes="semantic-style-demo-root"
                                                 Total="500"
                                                 CurrentPage="1"
                                                 IsShowSizeChanger="True"
                                                 SizeType="Small"
                                                 HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
