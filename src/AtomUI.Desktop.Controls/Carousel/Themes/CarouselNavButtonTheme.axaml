<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CarouselNavButton}" TargetType="atom:CarouselNavButton">
        <ControlTheme.BasedOn>
            <themes:IconButtonTheme TargetType="{x:Type atom:CarouselNavButton}" />
        </ControlTheme.BasedOn>

        <Style Selector="^:is(atom|CarouselNavButton)">
            <Setter Property="IconWidth" Value="{atom:CarouselTokenResource ArrowSize}" />
            <Setter Property="IconHeight" Value="{atom:CarouselTokenResource ArrowSize}" />
            <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorBgContainer}" />
            <Setter Property="Opacity" Value="0.2" />

            <Style Selector="^:pointerover">
                <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorBgContainer}" />
                <Setter Property="Opacity" Value="1.0" />
            </Style>

            <Style Selector="^:pressed">
                <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorBgContainer}" />
            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <DoubleTransition Property="Opacity" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
