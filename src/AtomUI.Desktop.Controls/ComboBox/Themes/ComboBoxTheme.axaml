<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ComboBox}" TargetType="atom:ComboBox">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:AddOnDecoratedBox
                        Name="{x:Static atom:AddOnDecoratedBox.AddOnDecoratedBoxPart}"
                        Classes.semantic-scope-input="True"
                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                        Focusable="True"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        StyleVariant="{TemplateBinding StyleVariant}"
                        SizeType="{TemplateBinding SizeType}"
                        Status="{TemplateBinding Status}"
                        FormStatus="{TemplateBinding FormStatus}"
                        IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                        DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                        LeftAddOn="{TemplateBinding LeftAddOn}"
                        LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                        RightAddOn="{TemplateBinding RightAddOn}"
                        RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                        IsEnabled="{TemplateBinding IsEnabled}">
                        <atom:AddOnDecoratedBox.ContentLeftAddOn>
                            <atom:AddOnContentPresenter
                                Classes.semantic-prefix="True"
                                Content="{CompiledBinding $parent[atom:ComboBox].ContentLeftAddOn}"
                                ContentTemplate="{CompiledBinding $parent[atom:ComboBox].ContentLeftAddOnTemplate}"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"
                                Focusable="False" />
                        </atom:AddOnDecoratedBox.ContentLeftAddOn>
                        <atom:AddOnDecoratedBox.ContentRightAddOn>
                             <StackPanel Orientation="Horizontal"
                                        Classes.semantic-suffix="True"
                                        Spacing="{atom:SharedTokenResource SpacingXS}">
                                 <atom:AddOnContentPresenter
                                     Name="PART_ContentRightAddOnPresenter"
                                     Content="{CompiledBinding $parent[atom:ComboBox].ContentRightAddOn}"
                                     ContentTemplate="{CompiledBinding $parent[atom:ComboBox].ContentRightAddOnTemplate}" />
                                 <ContentPresenter
                                     Name="PART_FormFeedBack"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     HorizontalAlignment="Right"
                                     IsVisible="{CompiledBinding $parent[atom:ComboBox].IsFormFeedbackVisible}"
                                     Content="{CompiledBinding $parent[atom:ComboBox].FormFeedback}" />
                                 <atom:ComboBoxHandle
                                     Name="PART_ComboBoxHandle"
                                     Classes.semantic-scope-handle="True"
                                     IsEnabled="{CompiledBinding $parent[atom:ComboBox].IsEnabled}"
                                     IsMotionEnabled="{CompiledBinding $parent[atom:ComboBox].IsMotionEnabled}" />
                             </StackPanel>
                        </atom:AddOnDecoratedBox.ContentRightAddOn>
                        <Panel Classes.semantic-content="True">
                            <atom:TextBlock
                                Name="PlaceholderText"
                                Classes.semantic-placeholder="True"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Opacity="0.3"
                                IsVisible="{TemplateBinding SelectingItemsControl.SelectedItem, Converter={x:Static ObjectConverters.IsNull}}"
                                Text="{TemplateBinding PlaceholderText}" />
                            <ContentPresenter
                                Name="SelectedContentPresenter"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                atom:OverflowTip.IsEnabled="{TemplateBinding IsShowOverflowTip}"
                                atom:OverflowTip.Text="{TemplateBinding SelectionBoxItem}"
                                atom:OverflowTip.ShowDelay="{TemplateBinding OverflowTipDelay}"
                                atom:OverflowTip.Placement="{TemplateBinding OverflowTipPlacement}"
                                atom:OverflowTip.PlacementTarget="{Binding $parent[atom:AddOnDecoratedBox]}" />
                            <atom:ComboBoxTextBox
                                Name="PART_EditableTextBox"
                                Classes.semantic-input="True"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                CaretBrush="{atom:SharedTokenResource ColorText}"
                                SelectionBrush="{atom:SharedTokenResource SelectionBackground}"
                                SelectionForegroundBrush="{atom:SharedTokenResource SelectionForeground}"
                                Text="{TemplateBinding Text, Mode=TwoWay}"
                                PlaceholderText="{TemplateBinding PlaceholderText}"
                                PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                                IsVisible="{TemplateBinding IsEditable}" />
                        </Panel>
                    </atom:AddOnDecoratedBox>

                    <!--
                        弹层不声明 IsOpen 模板绑定：Avalonia 只在弹层打开瞬间读取 IsLightDismissEnabled
                        创建 light-dismiss 遮罩，而模板充气阶段的绑定求值会在控件抑制遮罩之前就打开弹层，
                        使钉住（IsPopupPinnedOpen）场景留下一个只拦截输入、无法消除的遮罩层挡住整页交互。
                        开合改由 ComboBox 以代码接管（OnApplyTemplate / IsDropDownOpen 变更），
                        与共享 AbstractSelect 的既有约定一致。
                    -->
                    <atom:Popup Name="PART_Popup"
                                WindowManagerAddShadowHint="False"
                                IsLightDismissEnabled="True"
                                OverlayDismissEventPassThrough="True"
                                ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                                RequestedPlacement="BottomEdgeAlignedLeft">
                        <Border
                            Name="PopupFrame"
                            Classes.semantic-popup-root="True"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            MinWidth="{TemplateBinding EffectivePopupWidth}"
                            Padding="{TemplateBinding PopupContentPadding}">
                            <Panel>
                                <atom:ScrollViewer IsScrollChainingEnabled="False"
                                                   Classes.semantic-popup-list="True"
                                                   IsVisible="{TemplateBinding IsEffectiveEmptyVisible, Converter={x:Static BoolConverters.Not}}"
                                                   IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                   IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                                   AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}">
                                    <ItemsPresenter
                                        Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        Grid.IsSharedSizeScope="True" />
                                </atom:ScrollViewer>
                                <Border
                                    Name="PART_EmptyIndicator"
                                    Classes.semantic-popup-empty="True"
                                    Padding="{atom:SharedTokenResource Padding}"
                                    IsVisible="{TemplateBinding IsEffectiveEmptyVisible}">
                                    <atom:Empty
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        SizeType="Small"
                                        PresetImage="Simple" />
                                </Border>
                            </Panel>
                        </Border>
                    </atom:Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="PopupContentPadding" Value="{atom:ComboBoxTokenResource PopupContentPadding}" />
        <Setter Property="OptionFontSize" Value="{atom:SharedTokenResource FontSize}" />
        <Setter Property="ItemHeight" Value="{atom:SharedTokenResource ControlHeight}" />
        
        <Style Selector="^[SizeType=Large]">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
            <Style Selector="^ /template/ ContentPresenter#SelectedContentPresenter">
                <Setter Property="Margin" Value="0, 1, 0, 1" />
            </Style>
        </Style>

        <Style Selector="^[IsEditable=True]">
            <Style Selector="^ /template/ atom|TextBlock#PlaceholderText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#SelectedContentPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <Style Selector="^ /template/ atom|Popup#PART_Popup">
            <Setter Property="MarginToAnchor"
                    Value="{atom:PopupTokenResource MarginToAnchor}" />
            <Setter Property="PopupRootShadow" Value="{atom:PopupTokenResource PopupRootShadow}" />
        </Style>
        <Style Selector="^ /template/ Border#PopupFrame">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgElevated}" />
            <Setter Property="CornerRadius"
                    Value="{atom:PopupTokenResource PopupCornerRadius}" />
        </Style>

        <Style Selector="^[StyleVariant=Borderless]">
            <Style Selector="^:error">
                <Style Selector="^ /template/ ContentPresenter#SelectedContentPresenter">
                    <Setter Property="Foreground"
                            Value="{atom:SharedTokenResource ColorErrorText}" />
                </Style>
            </Style>
            <Style Selector="^:warning">
                <Style Selector="^ /template/ ContentPresenter#SelectedContentPresenter">
                    <Setter Property="Foreground"
                            Value="{atom:SharedTokenResource ColorWarningText}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[StyleVariant=Filled]">
            <Style Selector="^:error">
                <Style Selector="^ /template/ ContentPresenter#SelectedContentPresenter">
                    <Setter Property="Foreground"
                            Value="{atom:SharedTokenResource ColorErrorText}" />
                </Style>
            </Style>
            <Style Selector="^:warning">
                <Style Selector="^ /template/ ContentPresenter#SelectedContentPresenter">
                    <Setter Property="Foreground"
                            Value="{atom:SharedTokenResource ColorWarningText}" />
                </Style>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
