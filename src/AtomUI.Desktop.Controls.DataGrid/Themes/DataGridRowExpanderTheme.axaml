<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    >
    <ControlTheme x:Key="{x:Type atom:DataGridRowExpander}" TargetType="atom:DataGridRowExpander">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         Background="{TemplateBinding Background}"
                                         CornerRadius="{TemplateBinding CornerRadius}">
                    <Canvas VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Rectangle Name="{x:Static atom:DataGridRowExpanderThemeConstants.HorizontalIndicatorPart}"
                                   Height="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Fill="{TemplateBinding IndicatorFill}"
                                   RenderTransform="{TemplateBinding HorizontalIndicatorRenderTransform}"/>
                        <Rectangle Name="{x:Static atom:DataGridRowExpanderThemeConstants.VerticalIndicatorPart}"
                                   Width="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Fill="{TemplateBinding IndicatorFill}"
                                   RenderTransform="{TemplateBinding VerticalIndicatorRenderTransform}"/>
                    </Canvas>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        
        <Setter Property="Width">
            <MultiBinding Converter="{x:Static themes:DataGridThemeBindings.OptionalValue}">
                <atom:OwnerTokenResource Kind="SizeMS" SourceControlType="{x:Type atom:DataGrid}" />
                <atom:DataGridTokenResource Kind="ExpandIconSize" WhenExplicit="True" />
            </MultiBinding>
        </Setter>
        <Setter Property="Height">
            <MultiBinding Converter="{x:Static themes:DataGridThemeBindings.OptionalValue}">
                <atom:OwnerTokenResource Kind="SizeMS" SourceControlType="{x:Type atom:DataGrid}" />
                <atom:DataGridTokenResource Kind="ExpandIconSize" WhenExplicit="True" />
            </MultiBinding>
        </Setter>
        <Setter Property="Background">
            <MultiBinding Converter="{x:Static themes:DataGridThemeBindings.OptionalValue}">
                <Binding Source="{x:Static Brushes.Transparent}" />
                <atom:DataGridTokenResource Kind="ExpandIconBg" WhenExplicit="True" />
            </MultiBinding>
        </Setter>
        <Setter Property="Margin" Value="{atom:DataGridTokenResource Kind=ExpandIconMargin, WhenExplicit=True}" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadiusSM, SourceControlType={x:Type atom:DataGrid}}"/>
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource Kind=ColorBorder, SourceControlType={x:Type atom:DataGrid}}"/>
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource Kind=BorderThickness, SourceControlType={x:Type atom:DataGrid}}"/>
        
        <Setter Property="IndicatorFill" Value="{atom:OwnerTokenResource Kind=ColorTextSecondary, SourceControlType={x:Type atom:DataGrid}}"/>
        
        <Style Selector="^:focus">
            <Setter Property="IndicatorFill" Value="{atom:OwnerTokenResource Kind=ColorPrimaryHover, SourceControlType={x:Type atom:DataGrid}}"/>
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource Kind=ColorPrimaryHover, SourceControlType={x:Type atom:DataGrid}}"/>
        </Style>
        
        <Style Selector="^:pointerover">
            <Setter Property="IndicatorFill" Value="{atom:OwnerTokenResource Kind=ColorPrimaryHover, SourceControlType={x:Type atom:DataGrid}}"/>
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource Kind=ColorPrimaryHover, SourceControlType={x:Type atom:DataGrid}}"/>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <atom:SolidColorBrushTransition Property="BorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="IndicatorFill" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </atom:TokenTransitions>
            </Setter>
        </Style>
        
        <Style Selector="^:pressed">
            <Setter Property="IndicatorFill" Value="{atom:OwnerTokenResource Kind=ColorPrimaryActive, SourceControlType={x:Type atom:DataGrid}}"/>
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource Kind=ColorPrimaryActive, SourceControlType={x:Type atom:DataGrid}}"/>
        </Style>
        
        <Style Selector="^ /template/ Rectangle#PART_VerticalIndicator">
            <Setter Property="Height" Value="9"/>
        </Style>
        
        <Style Selector="^ /template/ Rectangle#PART_HorizontalIndicator">
            <Setter Property="Width" Value="9"/>
        </Style>
        
        <Style Selector="^[IsChecked=True]">
            <Style Selector="^ /template/ Rectangle#PART_VerticalIndicator">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Setter Property="VerticalIndicatorRenderTransform" Value="rotate(90deg)"/>
            <Setter Property="HorizontalIndicatorRenderTransform" Value="rotate(180deg)"/>
        </Style>
        
    </ControlTheme>
</ResourceDictionary>
