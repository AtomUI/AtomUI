    <unit id="HourFormatsDescription">
      <segment>
        <source>TimePicker supports two time types, 12-hour and 24-hour.</source>
        <target state="translated">TimePicker 支持 12 小時和 24 小時兩種時間格式。</target>
      </segment>
    </unit>
    <unit id="HourFormatsTitle">
      <segment>
