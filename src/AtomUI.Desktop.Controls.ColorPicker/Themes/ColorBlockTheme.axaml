<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ColorBlock}" TargetType="atom:ColorBlock">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_ColorPreviewFrame"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding TransparentBgBrush}"
                            IsVisible="{TemplateBinding IsEmptyColorMode, Converter={x:Static BoolConverters.Not}}">
                        <Border Name="PART_ColorPreview"
                                Classes.semantic-content="True"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BoxShadow="{atom:ColorPickerTokenResource ColorBlockInnerShadows}"/>
                    </Border>
                    <atom:PixelAlignedBorder Name="PART_EmptyColorFrame"
                                             CornerRadius="{TemplateBinding CornerRadius}"
                                             BorderThickness="{TemplateBinding BorderThickness}"
                                             IsVisible="{TemplateBinding IsEmptyColorMode}"
                                             Background="Transparent"/>
                </Panel>
                
            </ControlTemplate>
        </Setter>
        
        <Setter Property="TransparentBgIntervalColor" Value="{atom:OwnerTokenResource ColorFillSecondary}" />
        <Setter Property="TransparentBgSize" Value="{atom:ColorPickerTokenResource TransparentBgSize}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
        <!-- Keep the historical red unless configuration explicitly supplies the error role. -->
        <Setter Property="EmptyColorStroke" Value="{atom:OwnerTokenResource Kind=ColorError, WhenExplicit=True}" />
        <Setter Property="EmptyColorStrokeThickness" Value="{atom:OwnerTokenResource LineWidthBold}" />
        
        <Style Selector="^[IsEmptyColorMode=True]">
            <Setter Property="Cursor" Value="Hand" />
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_EmptyColorFrame">
                <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorFillSecondary}" />
            </Style>
            
            <Style Selector="^:pointerover">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_EmptyColorFrame">
                    <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorder}" />
                </Style>
            </Style>
        </Style>
        
        <Style Selector="^[IsCustomSize=False]">
            <Style Selector="^[SizeType=Large]">
                <Setter Property="Width" Value="{atom:OwnerTokenResource ControlHeight}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource ControlHeight}" />
                <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
            </Style>

            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="Width" Value="{atom:OwnerTokenResource ControlHeightSM}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource ControlHeightSM}" />
                <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Width" Value="{atom:OwnerTokenResource ControlHeightXS}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource ControlHeightXS}" />
                <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusXS}" />
            </Style>
        </Style>
        
        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusXS}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
