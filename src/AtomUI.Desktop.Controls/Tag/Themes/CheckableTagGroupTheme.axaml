<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CheckableTagGroup}"
                  TargetType="atom:CheckableTagGroup">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:CheckableTagGroup">
                <atom:CheckableTagItemsControl Name="PART_CheckableTagItems"
                                               Classes.semantic-scope-items="True"
                                               IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                               IsMultiple="{TemplateBinding IsMultiple}"
                                               ItemSpacing="{TemplateBinding ItemSpacing}"
                                               ItemTemplate="{TemplateBinding ItemTemplate}"
                                               LineSpacing="{TemplateBinding LineSpacing}"
                                               Orientation="{TemplateBinding Orientation}" />
            </ControlTemplate>
        </Setter>

        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="ItemSpacing" Value="{atom:OwnerTokenResource SpacingXS}" />
        <Setter Property="LineSpacing" Value="{atom:OwnerTokenResource SpacingXS}" />
    </ControlTheme>
</ResourceDictionary>
