<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CardMetaContent}" TargetType="atom:CardMetaContent">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.ForegroundConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedForeground" />
                <atom:OwnerTokenResource Kind="ColorText" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="ColorText" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True" 
                           HorizontalSpacing="{atom:OwnerTokenResource Spacing, SourceControlType={x:Type atom:CardMetaContent}, Priority=Template}">
                    <ContentPresenter Name="AvatarContentPresenter"
                                      Classes.semantic-avatar="True"
                                      DockPanel.Dock="Left"
                                      Content="{TemplateBinding Avatar}"
                                      VerticalAlignment="Top"/>
                    <DockPanel Classes.semantic-section="True"
                               LastChildFill="True"
                               VerticalSpacing="{atom:OwnerTokenResource SpacingXS, SourceControlType={x:Type atom:CardMetaContent}, Priority=Template}">
                        <ContentPresenter Name="TitleContentPresenter"
                                          Classes.semantic-title="True"
                                          DockPanel.Dock="Top"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                        <ContentPresenter Name="DescriptionContentPresenter"
                                          Classes.semantic-description="True"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </DockPanel>
                </DockPanel>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ ContentPresenter#TitleContentPresenter">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextHeading, SourceControlType={x:Type atom:CardMetaContent}}" />
            <Setter Property="FontWeight" Value="{atom:OwnerTokenResource FontWeightStrong, SourceControlType={x:Type atom:CardMetaContent}}" />
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeLG, SourceControlType={x:Type atom:CardMetaContent}}" />
        </Style>
        
        <Style Selector="^ /template/ ContentPresenter#DescriptionContentPresenter">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextDescription, SourceControlType={x:Type atom:CardMetaContent}}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
