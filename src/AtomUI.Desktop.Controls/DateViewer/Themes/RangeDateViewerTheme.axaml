<ControlTheme xmlns:tokeninputs="using:AtomUI.Desktop.Controls.Internal.DateViewer"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:viewer="clr-namespace:AtomUI.Desktop.Controls.Internal.DateViewer"
              x:Class="AtomUI.Desktop.Controls.Themes.RangeDateViewerTheme"
              x:ClassModifier="internal" TargetType="atom:RangeDateViewer">
    <Setter Property="tokeninputs:DateViewerCell.PanelBackground" Value="{atom:RangeDateViewerTokenResource PanelBg}" />
    <Setter Property="tokeninputs:DateViewerCell.CellHoverBackground"
            Value="{atom:RangeDateViewerTokenResource CellHoverBg}" />
    <Setter Property="tokeninputs:DateViewerCell.RangeCellBackground"
            Value="{atom:RangeDateViewerTokenResource CellRangeBg}" />
    <Setter Property="tokeninputs:DateViewerCell.ActiveCellForeground"
            Value="{atom:RangeDateViewerTokenResource CellActiveColor}" />
    <Setter Property="tokeninputs:DateViewerCell.PanelWidth"
            Value="{atom:RangeDateViewerTokenResource PanelWidth}" />
    <Setter Property="tokeninputs:DateViewerCell.CellHeight"
            Value="{atom:RangeDateViewerTokenResource CellHeight}" />
    <Setter Property="tokeninputs:DateViewerCell.CellWidth" Value="{atom:RangeDateViewerTokenResource CellWidth}" />
    <Setter Property="tokeninputs:DateViewerCell.CellRowHeight"
            Value="{atom:RangeDateViewerTokenResource CellRowHeight}" />
    <Setter Property="tokeninputs:DateViewerCell.PeriodCellWidth"
            Value="{atom:RangeDateViewerTokenResource PeriodCellWidth}" />
    <Setter Property="tokeninputs:DateViewerCell.PeriodCellPadding"
            Value="{atom:RangeDateViewerTokenResource PeriodCellPadding}" />
    <Setter Property="tokeninputs:DateViewerCell.ContentCellMinHeight"
            Value="{atom:RangeDateViewerTokenResource ContentCellMinHeight}" />
    <Setter Property="tokeninputs:DateViewerCell.ContentCellSurfaceMargin"
            Value="{atom:RangeDateViewerTokenResource ContentCellSurfaceMargin}" />
    <Setter Property="tokeninputs:DateViewerCell.ContentCellTopBorderThickness"
            Value="{atom:RangeDateViewerTokenResource ContentCellTopBorderThickness}" />
    <Setter Property="tokeninputs:DateViewerCell.ContentCellValueMargin"
            Value="{atom:RangeDateViewerTokenResource ContentCellValueMargin}" />
    <Setter Property="tokeninputs:DateViewerCell.ContentCellContentMargin"
            Value="{atom:RangeDateViewerTokenResource ContentCellContentMargin}" />
    <Setter Property="tokeninputs:DateViewerCell.PanelPadding"
            Value="{atom:RangeDateViewerTokenResource PanelPadding}" />
    <Setter Property="tokeninputs:DateViewerCell.HeaderHorizontalPadding"
            Value="{atom:RangeDateViewerTokenResource HeaderHorizontalPadding}" />
    <Setter Property="tokeninputs:DateViewerCell.DateBodyPadding"
            Value="{atom:RangeDateViewerTokenResource DateBodyPadding}" />
    <Setter Property="tokeninputs:DateViewerCell.HeaderBorderThickness"
            Value="{atom:RangeDateViewerTokenResource HeaderBorderThickness}" />
    <Setter Property="tokeninputs:DateViewerCell.WeekNumberOpacity"
            Value="{atom:RangeDateViewerTokenResource WeekNumberOpacity}" />

    <Setter Property="Background" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.PanelBackground)}" />
    <Setter Property="Padding" Value="{CompiledBinding $self.(tokeninputs:DateViewerCell.PanelPadding)}" />
    <Setter Property="PanelSpacing" Value="{atom:RangeDateViewerTokenResource PanelSpacing}" />
    <!-- The panels and headers take these from this viewer's Token as plain properties (no inherited inputs). -->
    <Style Selector="^ /template/ viewer|DatePanel">
        <Setter Property="CellCornerRadius" Value="{atom:RangeDateViewerTokenResource CellCornerRadius}" />
        <Setter Property="CellTodayBg" Value="{atom:RangeDateViewerTokenResource CellTodayBg}" />
        <Setter Property="CellTodayColor" Value="{atom:RangeDateViewerTokenResource CellTodayColor}" />
        <Setter Property="CellTodayBorderColor" Value="{atom:RangeDateViewerTokenResource CellTodayBorderColor}" />
        <Setter Property="WeekHeaderHeight" Value="{atom:RangeDateViewerTokenResource WeekHeaderHeight}" />
        <Setter Property="WeekHeaderFontWeight" Value="{atom:RangeDateViewerTokenResource WeekHeaderFontWeight}" />
    </Style>
    <Style Selector="^ /template/ viewer|DateViewerHeader">
        <Setter Property="TitleFontWeight" Value="{atom:RangeDateViewerTokenResource HeaderTitleFontWeight}" />
    </Style>
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:RangeDateViewer">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{TemplateBinding PanelSpacing}"
                                IsVisible="{TemplateBinding ShowHeader}">
                        <viewer:DateViewerHeader Classes.semantic-header="True"
                                                 Width="{CompiledBinding $self.(tokeninputs:DateViewerCell.PanelWidth)}"
                                                 Context="{TemplateBinding HeaderContext}"
                                                 HeaderTemplate="{TemplateBinding HeaderTemplate}" />
                        <viewer:DateViewerHeader Classes.semantic-header="True"
                                                 Width="{CompiledBinding $self.(tokeninputs:DateViewerCell.PanelWidth)}"
                                                 Context="{TemplateBinding SecondaryHeaderContext}"
                                                 HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                                 IsVisible="{TemplateBinding HasSecondaryPanel}" />
                    </StackPanel>
                    <StackPanel Classes.semantic-body="True" Orientation="Horizontal"
                                Spacing="{TemplateBinding PanelSpacing}">
                        <viewer:DatePanel Classes.semantic-content="True" Name="PART_PrimaryPanel"
                                          Session="{TemplateBinding PanelSession}"
                                          Theme="{TemplateBinding PanelTheme}"
                                          CellTemplate="{TemplateBinding CellTemplate}"
                                          FullCellTemplate="{TemplateBinding FullCellTemplate}"
                                          DefaultFullCellTemplate="{TemplateBinding DefaultFullCellTemplate}"
                                          CellTheme="{TemplateBinding CellTheme}"
                                          Presentation="{TemplateBinding Presentation}" />
                        <viewer:DatePanel Classes.semantic-content="True" Name="PART_SecondaryPanel" PanelIndex="1"
                                          IsVisible="{TemplateBinding HasSecondaryPanel}"
                                          Session="{TemplateBinding PanelSession}"
                                          Theme="{TemplateBinding PanelTheme}"
                                          CellTemplate="{TemplateBinding CellTemplate}"
                                          FullCellTemplate="{TemplateBinding FullCellTemplate}"
                                          DefaultFullCellTemplate="{TemplateBinding DefaultFullCellTemplate}"
                                          CellTheme="{TemplateBinding CellTheme}"
                                          Presentation="{TemplateBinding Presentation}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </ControlTemplate>
    </Setter>
    <Style Selector="^:single-panel">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:RangeDateViewer">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <DockPanel LastChildFill="True">
                        <viewer:DateViewerHeader DockPanel.Dock="Top" Classes.semantic-header="True"
                                                 Width="{CompiledBinding $self.(tokeninputs:DateViewerCell.PanelWidth)}"
                                                 Context="{TemplateBinding HeaderContext}"
                                                 HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                                 IsVisible="{TemplateBinding ShowHeader}" />
                        <Panel Classes.semantic-body="True">
                            <viewer:DatePanel Classes.semantic-content="True" Name="PART_PrimaryPanel"
                                              Session="{TemplateBinding PanelSession}"
                                              Theme="{TemplateBinding PanelTheme}"
                                              CellTemplate="{TemplateBinding CellTemplate}"
                                              FullCellTemplate="{TemplateBinding FullCellTemplate}"
                                              DefaultFullCellTemplate="{TemplateBinding DefaultFullCellTemplate}"
                                              CellTheme="{TemplateBinding CellTheme}"
                                              Presentation="{TemplateBinding Presentation}" />
                        </Panel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</ControlTheme>
