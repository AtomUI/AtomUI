<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes">
    <ControlTheme x:Key="{x:Type atom:DataGridFilterIndicator}" TargetType="atom:DataGridFilterIndicator">
        <ControlTheme.BasedOn>
            <themes:IconButtonTheme TargetType="atom:DataGridFilterIndicator" />
        </ControlTheme.BasedOn>

        <Style Selector="^:is(atom|DataGridFilterIndicator)">
            <Setter Property="SelectedAllText" Value="{atom:DataGridLangResource SelectAllFilterItems}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource Kind=IconSizeSM, SourceControlType={x:Type atom:DataGrid}}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource Kind=IconSizeSM, SourceControlType={x:Type atom:DataGrid}}" />
            <Setter Property="Padding"
                    Value="{atom:DataGridTokenResource FilterIndicatorPadding}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadius, SourceControlType={x:Type atom:DataGrid}}" />
            
            <Style Selector="^:pointerover">
                <Setter Property="Background">
                    <MultiBinding Converter="{x:Static themes:DataGridThemeBindings.OptionalValue}">
                        <atom:OwnerTokenResource Kind="ColorBgTextHover" SourceControlType="{x:Type atom:DataGrid}" />
                        <atom:DataGridTokenResource Kind="HeaderFilterHoverBg" WhenExplicit="True" />
                    </MultiBinding>
                </Setter>
            </Style>

            <Style Selector="^:pressed">
                <Setter Property="Background"
                        Value="{atom:OwnerTokenResource Kind=ColorBgTextActive, SourceControlType={x:Type atom:DataGrid}}" />
            </Style>

            <Style Selector="^[IsFilterActivated=True]">
                <Setter Property="IconBrush"
                        Value="{atom:OwnerTokenResource Kind=ColorPrimary, SourceControlType={x:Type atom:DataGrid}}" />

                <Style Selector="^:pointerover">
                    <Setter Property="IconBrush"
                            Value="{atom:OwnerTokenResource Kind=ColorPrimary, SourceControlType={x:Type atom:DataGrid}}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="IconBrush"
                            Value="{atom:OwnerTokenResource Kind=ColorPrimary, SourceControlType={x:Type atom:DataGrid}}" />
                </Style>

            </Style>

            <Style Selector="^[IsFilterActivated=False]">
                <Setter Property="IconBrush"
                        Value="{atom:DataGridTokenResource HeaderIconColor}" />

                <Style Selector="^:pointerover">
                    <Setter Property="IconBrush"
                            Value="{atom:DataGridTokenResource HeaderIconHoverColor}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="IconBrush"
                            Value="{atom:DataGridTokenResource HeaderIconHoverColor}" />
                </Style>
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>