<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="AtomUI.Desktop.Controls.Tests.Mention.IdentityConsistencySemanticView">
    <UserControl.Styles>
        <Style Selector="atom|Mentions">
            <atom:MentionsInputStyle x:SetterTargetType="TextPresenter">
                <Setter Property="Opacity" Value="0.71" />
            </atom:MentionsInputStyle>
        </Style>
        <Style Selector="atom|AutoCompleteTextArea">
            <atom:AutoCompleteTextAreaInputStyle x:SetterTargetType="TextPresenter">
                <Setter Property="Opacity" Value="0.61" />
            </atom:AutoCompleteTextAreaInputStyle>
        </Style>
        <Style Selector="atom|TreeSelect">
            <atom:TreeSelectPopupListStyle x:SetterTargetType="Control">
                <Setter Property="Opacity" Value="0.63" />
            </atom:TreeSelectPopupListStyle>
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="12">
        <atom:Mentions Name="Mentions" Width="240" Value="Mention text" />
        <atom:AutoCompleteTextArea Name="AutoComplete" Width="240" Value="Complete text" />
        <atom:TreeSelect Name="TreeSelect" Width="240" />
    </StackPanel>
</UserControl>
