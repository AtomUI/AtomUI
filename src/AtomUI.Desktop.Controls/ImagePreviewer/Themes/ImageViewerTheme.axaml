<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImageViewer}" TargetType="atom:ImageViewer">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Canvas Name="PART_ImageViewerScene"
                            ClipToBounds="True"
                            Classes.semantic-popup-body="True"
                            IsVisible="{TemplateBinding CurrentImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <atom:ImagePreviewRenderer
                            Name="PART_ImageRenderer"
                            Source="{TemplateBinding CurrentImage}" Stretch="Uniform"
                            RenderTransform="{TemplateBinding ImageRenderTransform}"
                            RenderTransformOrigin="{x:Static RelativePoint.Center}" />
                    </Canvas>
                    <Border Name="PART_LoadingPresenter"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsVisible="False">
                        <Panel HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <atom:Spin IsSpinning="True"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{TemplateBinding LoadingContent, Converter={x:Static ObjectConverters.IsNull}}" />
                            <ContentPresenter Content="{TemplateBinding LoadingContent}"
                                              ContentTemplate="{TemplateBinding LoadingContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsVisible="{TemplateBinding LoadingContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Panel>
                    </Border>
                    <Border Name="PART_ErrorPresenter"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsVisible="{TemplateBinding IsCurrentImageFailed}">
                        <Panel HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <StackPanel Name="DefaultErrorLayout"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="{atom:SharedTokenResource SpacingXXS}"
                                        IsVisible="{TemplateBinding ErrorContent, Converter={x:Static ObjectConverters.IsNull}}">
                                <antdicons:PictureOutlined Name="DefaultErrorIcon"
                                                          HorizontalAlignment="Center" />
                                <TextBlock Name="DefaultErrorText"
                                           Text="{atom:ImagePreviewerLangResource ImageLoadFailed}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </StackPanel>
                            <ContentPresenter Content="{TemplateBinding ErrorContent}"
                                              ContentTemplate="{TemplateBinding ErrorContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsVisible="{TemplateBinding ErrorContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Panel>
                    </Border>
                    <atom:ImagePreviewNavButton Name="PART_PreviousButton"
                                                Icon="{antdicons:AntDesignIconProvider LeftOutlined}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                IsVisible="{TemplateBinding IsMultiImages}"
                                                IsEnabled="{TemplateBinding IsFirstImage, Converter={x:Static BoolConverters.Not}}" />
                    <atom:ImagePreviewNavButton Name="PART_NextButton"
                                                Icon="{antdicons:AntDesignIconProvider RightOutlined}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                IsVisible="{TemplateBinding IsMultiImages}"
                                                IsEnabled="{TemplateBinding IsLastImage, Converter={x:Static BoolConverters.Not}}" />
                    <atom:ImagePreviewFloatToolbar
                        Classes.semantic-popup-footer="True"
                        CurrentIndex="{TemplateBinding CurrentIndex}"
                        Count="{TemplateBinding Count}"
                        IsScaleDownEnabled="{TemplateBinding IsScaleDownEnabled}"
                        IsScaleUpEnabled="{TemplateBinding IsScaleUpEnabled}"
                        IsImageFitToWindow="{TemplateBinding IsImageFitToWindow}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" />
                    <atom:MediaBreakPointIndicator
                        Name="{x:Static atom:MediaBreakPointIndicator.MediaQueryIndicatorName}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ atom|ImagePreviewNavButton">
            <Setter Property="Margin" Value="{atom:SharedTokenResource MarginSM}" />
        </Style>
        <Style Selector="^ /template/ atom|ImagePreviewRenderer#PART_ImageRenderer">
            <Setter Property="Cursor" Value="DragMove" />
        </Style>
        <Style Selector="^ /template/ TextBlock#DefaultErrorText">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextTertiary}" />
        </Style>
        <Style Selector="^:loading:not(:has-image) /template/ Border#PART_LoadingPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ atom|Icon#DefaultErrorIcon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="StrokeBrush" Value="{atom:SharedTokenResource ColorTextTertiary}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True][SuppressTransformAnimation=False]">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="ImageRenderTransform" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <DoubleTransition Property="ImageTranslateX" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationFast}" />
                    <DoubleTransition Property="ImageTranslateY" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationFast}" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
