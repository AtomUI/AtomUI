<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:Class="AtomUI.Desktop.Controls.Themes.OverlayPopupHostTheme"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type OverlayPopupHost}" TargetType="OverlayPopupHost">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Opacity handling belongs above the animated surface so overlapping
                     content backgrounds and shadows fade as one composited group. -->
                <Panel RenderOptions.RequiresFullOpacityHandling="True" ClipToBounds="False">
                    <atom:PopupSurface Name="PART_PopupSurface" ClipToBounds="False">
                        <VisualLayerManager ClipToBounds="False">
                            <atom:ShadowsAwareContainer IsOverlayMode="True">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </atom:ShadowsAwareContainer>
                        </VisualLayerManager>
                    </atom:PopupSurface>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
        <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        <Setter Property="FontFamily" Value="{atom:SharedTokenResource FontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^ /template/ atom|PopupSurface#PART_PopupSurface">
            <Setter Property="IsHitTestVisible"
                    Value="{CompiledBinding $parent[atom:Popup].IsPlayingCloseMotion, Converter={x:Static BoolConverters.Not}}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
