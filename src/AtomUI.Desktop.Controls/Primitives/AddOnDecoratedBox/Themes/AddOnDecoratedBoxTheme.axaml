<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.AddOnDecoratedBoxTheme"
              TargetType="atom:AddOnDecoratedBox"
              x:ClassModifier="internal">
    <ControlTheme.BasedOn>
        <atom:InputControlFrameTheme TargetType="atom:AddOnDecoratedBox" />
    </ControlTheme.BasedOn>

    <Setter Property="Template">
        <ControlTemplate TargetType="atom:AddOnDecoratedBox">
            <DockPanel Name="RootLayout" LastChildFill="True">
                <atom:PixelAlignedBorder
                    Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.LeftAddOnPart}"
                    VerticalAlignment="Stretch"
                    Focusable="False"
                    DockPanel.Dock="Left"
                    BackgroundSizing="InnerBorderEdge"
                    BorderThickness="{TemplateBinding LeftAddOnBorderThickness}"
                    CornerRadius="{TemplateBinding LeftAddOnCornerRadius}"
                    IsVisible="{Binding Child, ElementName=PART_LeftAddOnPresenter, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <atom:AddOnContentPresenter
                        Name="PART_LeftAddOnPresenter"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Focusable="False"
                        Content="{TemplateBinding LeftAddOn}"
                        ContentTemplate="{TemplateBinding LeftAddOnTemplate}" />
                </atom:PixelAlignedBorder>
                <atom:PixelAlignedBorder
                    Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.RightAddOnPart}"
                    VerticalAlignment="Stretch"
                    DockPanel.Dock="Right"
                    Focusable="False"
                    BackgroundSizing="InnerBorderEdge"
                    BorderThickness="{TemplateBinding RightAddOnBorderThickness}"
                    CornerRadius="{TemplateBinding RightAddOnCornerRadius}"
                    IsVisible="{Binding Child, ElementName=PART_RightAddOnPresenter, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <atom:AddOnContentPresenter
                        Name="PART_RightAddOnPresenter"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Focusable="False"
                        Content="{TemplateBinding RightAddOn}"
                        ContentTemplate="{TemplateBinding RightAddOnTemplate}" />
                </atom:PixelAlignedBorder>

                <atom:AddOnDecoratedBoxContentFrame
                        Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentFramePart}"
                        Classes.semantic-frame="True"
                        TextElement.Foreground="{TemplateBinding Foreground}"
                    BorderThickness="{TemplateBinding InnerBoxBorderThickness}"
                        CornerRadius="{TemplateBinding InnerBoxCornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}"
                        BoxShadow="{TemplateBinding BoxShadow}"
                        BackgroundSizing="InnerBorderEdge">
                    <atom:AdaptiveSpacingDockPanel Name="ContentLayout" LastChildFill="True">
                        <atom:AddOnContentPresenter
                            Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentLeftAddOnPart}"
                            Classes.semantic-scope-prefix="True"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            Focusable="False"
                            Content="{TemplateBinding ContentLeftAddOn}"
                            ContentTemplate="{TemplateBinding ContentLeftAddOnTemplate}" />

                        <atom:AddOnContentPresenter
                            DockPanel.Dock="Right"
                            Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentRightAddOnPart}"
                            Classes.semantic-scope-suffix="True"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Right"
                            Focusable="False"
                            Content="{TemplateBinding ContentRightAddOn}"
                            ContentTemplate="{TemplateBinding ContentRightAddOnTemplate}" />

                        <ContentPresenter
                            Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentPresenterPart}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </atom:AdaptiveSpacingDockPanel>
                </atom:AddOnDecoratedBoxContentFrame>
            </DockPanel>
        </ControlTemplate>
    </Setter>
    <Style Selector="^:is(atom|AddOnDecoratedBox)">
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
        <Setter Property="ContentFramePadding" Value="{CompiledBinding $self.PresetContentPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
            <Setter Property="Padding" Value="{TemplateBinding EffectiveContentFramePadding}" />
        </Style>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorFillAlter}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorFillAlter}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>

        <Style Selector="^ /template/ atom|AdaptiveSpacingDockPanel#ContentLayout">
            <Setter Property="HorizontalSpacing" Value="{atom:OwnerTokenResource SpacingXXS}" />
        </Style>

        <!-- 右侧后缀区默认前景色：作为下拉箭头（SelectHandle 继承链）与后缀内容的默认颜色，
             用户 suffix Part Style 在 suffix 容器上以更高优先级覆写 -->
        <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentRightAddOn">
            <Setter Property="TextElement.Foreground"
                    Value="{atom:OwnerTokenResource ColorTextQuaternary}" />
        </Style>

        <!--
            Filled 变体保留 1px 透明边框与 Outlined 等高占位，背景必须铺满 border-box，
            否则可见填充比 Outlined 矮上下各 1px。
        -->
        <Style Selector="^[StyleVariant=Filled] /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
            <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
                <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPaddingLG}" />
            </Style>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
                <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPaddingLG}" />
            </Style>
            <Setter Property="PresetContentPadding" Value="{atom:OwnerTokenResource InputPaddingLG}" />
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeightLG}" />
                <Setter Property="MinHeight" Value="{atom:OwnerTokenResource FontHeightLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
                <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPadding}" />
            </Style>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
                <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPadding}" />
            </Style>
            <Setter Property="PresetContentPadding" Value="{atom:OwnerTokenResource InputPadding}" />
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeight}" />
                <Setter Property="MinHeight" Value="{atom:OwnerTokenResource FontHeight}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
                <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPaddingSM}" />
            </Style>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
                <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPaddingSM}" />
            </Style>
            <Setter Property="PresetContentPadding" Value="{atom:OwnerTokenResource InputPaddingSM}" />
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{atom:OwnerTokenResource FontHeightSM}" />
                <Setter Property="MinHeight" Value="{atom:OwnerTokenResource FontHeightSM}" />
                <Setter Property="Margin" Value="{atom:OwnerTokenResource InputContentMargin}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveStatus=Error]">
            <Setter Property="AddOnStatusForeground" Value="{atom:OwnerTokenResource ColorErrorText}" />
            <Setter Property="AddOnStatusIconBrush" Value="{atom:OwnerTokenResource ColorError}" />
        </Style>
        <Style Selector="^[EffectiveStatus=Warning]">
            <Setter Property="AddOnStatusForeground" Value="{atom:OwnerTokenResource ColorWarningText}" />
            <Setter Property="AddOnStatusIconBrush" Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="AddOnStatusForeground" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
            <Setter Property="AddOnStatusIconBrush" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
        </Style>
    </Style>
</ControlTheme>
