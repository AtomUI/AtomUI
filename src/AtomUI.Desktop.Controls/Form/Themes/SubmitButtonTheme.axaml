<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net">
    <ControlTheme x:Key="{x:Type atom:SubmitButton}" TargetType="atom:SubmitButton">
        <Setter Property="ThemeBorderColorDisabled" Value="{atom:SubmitButtonTokenResource BorderColorDisabled}" />
        <Setter Property="ThemeCirclePadding" Value="{atom:SubmitButtonTokenResource CirclePadding}" />
        <Setter Property="ThemeContentFontSize" Value="{atom:SubmitButtonTokenResource ContentFontSize}" />
        <Setter Property="ThemeContentPadding" Value="{atom:SubmitButtonTokenResource ContentPadding}" />
        <Setter Property="ThemeDefaultBorderColorDisabled" Value="{atom:SubmitButtonTokenResource DefaultBorderColorDisabled}" />
        <Setter Property="ThemeFontWeight" Value="{atom:SubmitButtonTokenResource FontWeight}" />
        <Setter Property="ThemeIconEndMargin" Value="{atom:SubmitButtonTokenResource IconEndMargin}" />
        <Setter Property="ThemeIconMargin" Value="{atom:SubmitButtonTokenResource IconMargin}" />
        <Setter Property="ThemeIconOnyPadding" Value="{atom:SubmitButtonTokenResource IconOnyPadding}" />
        <Setter Property="ThemeOnlyIconSize" Value="{atom:SubmitButtonTokenResource OnlyIconSize}" />

        <Style Selector="^[SizeType=Small]">
            <Setter Property="ThemeContentFontSize" Value="{atom:SubmitButtonTokenResource ContentFontSizeSM}" />
            <Setter Property="ThemeContentPadding" Value="{atom:SubmitButtonTokenResource ContentPaddingSM}" />
            <Setter Property="ThemeIconOnyPadding" Value="{atom:SubmitButtonTokenResource IconOnyPaddingSM}" />
            <Setter Property="ThemeOnlyIconSize" Value="{atom:SubmitButtonTokenResource OnlyIconSizeSM}" />
        </Style>
        <Style Selector="^[SizeType=Large]">
            <Setter Property="ThemeContentFontSize" Value="{atom:SubmitButtonTokenResource ContentFontSizeLG}" />
            <Setter Property="ThemeContentPadding" Value="{atom:SubmitButtonTokenResource ContentPaddingLG}" />
            <Setter Property="ThemeIconOnyPadding" Value="{atom:SubmitButtonTokenResource IconOnyPaddingLG}" />
            <Setter Property="ThemeOnlyIconSize" Value="{atom:SubmitButtonTokenResource OnlyIconSizeLG}" />
        </Style>

        <ControlTheme.BasedOn>
            <atom:ButtonTheme TargetType="{x:Type atom:SubmitButton}" />
        </ControlTheme.BasedOn>
        
        <Setter Property="ButtonType" Value="Primary"/>
        <Setter Property="Content" Value="{atom:CommonLangResource Submit}"/>
        
    </ControlTheme>
</ResourceDictionary>