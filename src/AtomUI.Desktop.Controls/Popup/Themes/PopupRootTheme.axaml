<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:avap="using:Avalonia.Controls.Primitives"
    x:Class="AtomUI.Desktop.Controls.Themes.PopupRootTheme"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type PopupRoot}" TargetType="PopupRoot">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PopupMotionActor Name="{x:Static atom:BaseMotionActor.MotionActorPart}"
                                       ClipToBounds="False">
                    <Panel ClipToBounds="False">
                        <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                        <VisualLayerManager ClipToBounds="False">
                            <atom:ShadowsAwareContainer>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </atom:ShadowsAwareContainer>
                        </VisualLayerManager>
                    </Panel>
                </atom:PopupMotionActor>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
        <!-- The logical Popup ancestor crosses the visual root; native compiled bindings own owner changes and cleanup. -->
        <Setter Property="FontSize" Value="{CompiledBinding $parent[avap:Popup].PlacementTarget.(TextElement.FontSize)}" />
        <Setter Property="FontFamily" Value="{CompiledBinding $parent[avap:Popup].PlacementTarget.(TextElement.FontFamily)}" />
        <Setter Property="FontWeight" Value="{CompiledBinding $parent[avap:Popup].PlacementTarget.(TextElement.FontWeight)}" />
        <Setter Property="FontStyle" Value="{CompiledBinding $parent[avap:Popup].PlacementTarget.(TextElement.FontStyle)}" />

    </ControlTheme>
</ResourceDictionary>
