<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Button.ButtonShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:viewModels="clr-namespace:AtomUIGallery.ShowCases.Button"
             x:DataType="viewModels:ButtonViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Button"
                    Category="{gallery:ButtonShowCaseLangResource ComponentCategory}"
                    Status="{gallery:ButtonShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:ButtonShowCaseLangResource PageSubtitle}"
                    Description="{gallery:ButtonShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="AtomUIButton" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <gallery:SemanticPartPreview SemanticOwnerType="{x:Type atom:Button}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:Button Name="SemanticPartDemoButton"
                                         ButtonType="Primary"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}"
                                         Content="{gallery:ButtonShowCaseLangResource SemanticPartDemoContent}" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:ButtonShowCaseLangResource SemanticPartRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="icon"
                                Description="{gallery:ButtonShowCaseLangResource SemanticPartIconDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:ButtonShowCaseLangResource SemanticPartContentDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCasePanel.Styles>
                    <Style Selector="atom|Button">
                        <Setter Property="Margin" Value="5" />
                    </Style>
                </gallery:ShowCasePanel.Styles>

                <gallery:ShowCaseItem
                    SourceKey="button-type"
                    Title="{gallery:ButtonShowCaseLangResource TypeTitle}"
                    Description="{gallery:ButtonShowCaseLangResource TypeDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <atom:Button ButtonType="Primary" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimaryButton}" />
                        <atom:Button Content="{gallery:ButtonShowCaseLangResource P2ContentDefaultButton}" />
                        <atom:Button ButtonType="Dashed" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                        <atom:Button ButtonType="Text" Content="{gallery:ButtonShowCaseLangResource P2ContentTextButton}" />
                        <atom:Button ButtonType="Link" Content="{gallery:ButtonShowCaseLangResource P2ContentLinkButton}" />
                    </WrapPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-shape"
                    Title="{gallery:ButtonShowCaseLangResource ButtonShapeTitle}"
                    Description="{gallery:ButtonShowCaseLangResource ButtonShapeDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="0, 0, 0, 20">
                            <atom:Button ButtonType="Primary" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimary}" />
                            <atom:Button Content="{gallery:ButtonShowCaseLangResource P2ContentDefault}" />

                            <atom:Button ButtonType="Text" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                            <atom:Button ButtonType="Link" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />
                        </WrapPanel>
                        <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="0, 0, 0, 20">
                            <atom:Button ButtonType="Primary" Shape="Round" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimary}" />
                            <atom:Button Shape="Round" Content="{gallery:ButtonShowCaseLangResource P2ContentDefault}" />
                            <atom:Button ButtonType="Text" Shape="Round" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                            <atom:Button ButtonType="Link" Shape="Round" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />
                        </WrapPanel>
                        <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Horizontal" Margin="0, 0, 0, 20">
                            <atom:Button ButtonType="Primary" Shape="Circle" Content="{gallery:ButtonShowCaseLangResource P2ContentAa}" />
                            <atom:Button Shape="Circle" Content="{gallery:ButtonShowCaseLangResource P2ContentAa}" />
                            <atom:Button ButtonType="Text" Shape="Circle" Content="{gallery:ButtonShowCaseLangResource P2ContentAa}" />
                            <atom:Button ButtonType="Link" Shape="Circle" Content="{gallery:ButtonShowCaseLangResource P2ContentAa}" />
                        </StackPanel>
                    </StackPanel>

                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-size"
                    Title="{gallery:ButtonShowCaseLangResource SizeTitle}"
                    Description="{gallery:ButtonShowCaseLangResource SizeDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.Styles>
                        <Style Selector="atom|Button.size-demo-button[SizeType=Custom]">
                            <Setter Property="Height" Value="44" />
                            <Setter Property="Padding" Value="18,0" />
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="IconWidth" Value="18" />
                            <Setter Property="IconHeight" Value="18" />
                        </Style>
                        <Style Selector="atom|Button.size-demo-button[SizeType=Custom]:icononly">
                            <Setter Property="Padding" Value="12" />
                        </Style>
                        <Style Selector="atom|Button.size-demo-button[SizeType=Custom]:icononly:loading">
                            <Setter Property="IconWidth" Value="20" />
                            <Setter Property="IconHeight" Value="20" />
                        </Style>
                    </gallery:ShowCaseItem.Styles>
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <DockPanel Margin="0, 0, 0, 0">
                        <StackPanel Orientation="Horizontal" Spacing="5" DockPanel.Dock="Top">
                            <atom:TextBlock VerticalAlignment="Center" Text="{gallery:ButtonShowCaseLangResource P2TextExpandDirection}" />
                            <atom:OptionButtonGroup ButtonStyle="Outline"
                                                    OptionCheckedChanged="HandleButtonSizeTypeOptionCheckedChanged">
                                <atom:OptionButton IsChecked="True" Content="{gallery:ButtonShowCaseLangResource P2ContentLarge}" />
                                <atom:OptionButton Content="{gallery:ButtonShowCaseLangResource P2ContentDefault}" />
                                <atom:OptionButton Content="{gallery:ButtonShowCaseLangResource P2ContentSmall}" />
                                <atom:OptionButton Content="{gallery:ButtonShowCaseLangResource P2ContentCustom}" />
                            </atom:OptionButtonGroup>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Margin="0, 20, 0, 0" Spacing="10">
                            <WrapPanel>
                                <atom:Button Classes="size-demo-button" ButtonType="Primary" SizeType="{Binding ButtonSizeType}" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimary}" />
                                <atom:Button Classes="size-demo-button" ButtonType="Dashed" SizeType="{Binding ButtonSizeType}" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                                <atom:Button Classes="size-demo-button" ButtonType="Default" SizeType="{Binding ButtonSizeType}" Content="{gallery:ButtonShowCaseLangResource P2ContentDefault}" />
                                <atom:Button Classes="size-demo-button" ButtonType="Link" SizeType="{Binding ButtonSizeType}" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />
                            </WrapPanel>
                            <WrapPanel>
                                <atom:Button Classes="size-demo-button" ButtonType="Primary" Shape="Default"
                                             Icon="{antdicons:AntDesignIconProvider Kind=DownloadOutlined}"
                                             SizeType="{Binding ButtonSizeType}" />
                                <atom:Button Classes="size-demo-button" ButtonType="Dashed" Shape="Default"
                                             Icon="{antdicons:AntDesignIconProvider Kind=DownloadOutlined}"
                                             SizeType="{Binding ButtonSizeType}" />
                                <atom:Button Classes="size-demo-button" ButtonType="Primary" Shape="Circle"
                                             Icon="{antdicons:AntDesignIconProvider Kind=DownloadOutlined}"
                                             SizeType="{Binding ButtonSizeType}" />
                                <atom:Button Classes="size-demo-button" ButtonType="Primary" Shape="Round"
                                             Icon="{antdicons:AntDesignIconProvider Kind=DownloadOutlined}"
                                             SizeType="{Binding ButtonSizeType}" />
                                <atom:Button Classes="size-demo-button" ButtonType="Primary" Shape="Round"
                                             Icon="{antdicons:AntDesignIconProvider Kind=DownloadOutlined}"
                                             SizeType="{Binding ButtonSizeType}" Content="{gallery:ButtonShowCaseLangResource P2ContentDownload}" />
                                <atom:Button Classes="size-demo-button" ButtonType="Primary" Shape="Default"
                                             Icon="{antdicons:AntDesignIconProvider Kind=DownloadOutlined}"
                                             SizeType="{Binding ButtonSizeType}" Content="{gallery:ButtonShowCaseLangResource P2ContentDownload}" />
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-icon"
                    Title="{gallery:ButtonShowCaseLangResource IconTitle}"
                    Description="{gallery:ButtonShowCaseLangResource IconDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <atom:Button ButtonType="Primary" Shape="Circle"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" />
                            <atom:Button ButtonType="Primary" Shape="Round"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />

                            <atom:Button ButtonType="Default" Shape="Circle"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" />
                            <atom:Button ButtonType="Default" Shape="Round"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />

                            <atom:Button ButtonType="Text" Shape="Default"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />

                            <atom:Button ButtonType="Link" Shape="Default"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />

                            <atom:Button ButtonType="Dashed" Shape="Circle"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" />
                            <atom:Button ButtonType="Link" Shape="Default"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />

                        </WrapPanel>
                        <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <atom:Button ButtonType="Primary" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />

                            <atom:Button ButtonType="Default" Shape="Round" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />

                            <atom:Button ButtonType="Text" Shape="Default" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />

                            <atom:Button ButtonType="Link" Shape="Default" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />

                            <atom:Button ButtonType="Dashed" Shape="Circle" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" />
                            <atom:Button ButtonType="Dashed" Shape="Default" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />
                        </WrapPanel>
                    </StackPanel>

                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-icon-placement"
                    Title="{gallery:ButtonShowCaseLangResource IconPlacementTitle}"
                    Description="{gallery:ButtonShowCaseLangResource IconPlacementDescription}"
                    BadgeText="v6.0.6"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                            <StackPanel Orientation="Vertical"
                                        Spacing="16">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="5">
                                    <atom:TextBlock VerticalAlignment="Center"
                                                    Text="{gallery:ButtonShowCaseLangResource P2TextIconPlacement}" />
                                    <atom:OptionButtonGroup ButtonStyle="Outline"
                                                            OptionCheckedChanged="HandleButtonIconPlacementOptionCheckedChanged">
                                        <atom:OptionButton IsChecked="True"
                                                           Content="{gallery:ButtonShowCaseLangResource P2ContentStart}" />
                                        <atom:OptionButton Content="{gallery:ButtonShowCaseLangResource P2ContentEnd}" />
                                    </atom:OptionButtonGroup>
                                </StackPanel>

                                <WrapPanel HorizontalAlignment="Left"
                                           Orientation="Horizontal">
                                    <atom:Button ButtonType="Primary"
                                                 Shape="Circle"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}"
                                                 IconPlacement="{Binding ButtonIconPlacement}" />
                                    <atom:Button ButtonType="Primary"
                                                 Shape="Round"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}"
                                                 IconPlacement="{Binding ButtonIconPlacement}"
                                                 Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />
                                    <atom:Button ButtonType="Default"
                                                 Shape="Circle"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}"
                                                 IconPlacement="{Binding ButtonIconPlacement}" />
                                    <atom:Button ButtonType="Default"
                                                 Shape="Round"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}"
                                                 IconPlacement="{Binding ButtonIconPlacement}"
                                                 Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />
                                    <atom:Button ButtonType="Text"
                                                 Shape="Default"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}"
                                                 IconPlacement="{Binding ButtonIconPlacement}"
                                                 Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />
                                    <atom:Button ButtonType="Link"
                                                 Shape="Default"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}"
                                                 IconPlacement="{Binding ButtonIconPlacement}"
                                                 Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />
                                    <atom:Button ButtonType="Dashed"
                                                 Shape="Circle"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}"
                                                 IconPlacement="{Binding ButtonIconPlacement}" />
                                    <atom:Button ButtonType="Dashed"
                                                 Shape="Default"
                                                 Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}"
                                                 IconPlacement="{Binding ButtonIconPlacement}"
                                                 Content="{gallery:ButtonShowCaseLangResource P2ContentSearch}" />
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-loading"
                    Title="{gallery:ButtonShowCaseLangResource LoadingTitle}"
                    Description="{gallery:ButtonShowCaseLangResource LoadingDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical" Margin="10">
                        <atom:Button ButtonType="Primary"
                                     Click="HandleLoadingBtnClick"
                                     Icon="{antdicons:AntDesignIconProvider Kind=PoweroffOutlined}" />
                        <WrapPanel>
                            <atom:Button ButtonType="Primary" IsLoading="True" Content="{gallery:ButtonShowCaseLangResource P2ContentLoading}" />
                            <atom:Button ButtonType="Primary" SizeType="Small" IsLoading="True" Content="{gallery:ButtonShowCaseLangResource P2ContentLoading}" />
                            <atom:Button ButtonType="Primary" IsLoading="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=PoweroffOutlined}" />
                        </WrapPanel>
                        <WrapPanel>
                            <atom:Button ButtonType="Primary" Click="HandleLoadingBtnClick" Content="{gallery:ButtonShowCaseLangResource P2ContentClickMe}" />
                            <atom:Button ButtonType="Primary"
                                         Click="HandleLoadingBtnClick"
                                         Icon="{antdicons:AntDesignIconProvider Kind=PoweroffOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentClickMe}" />
                            <atom:Button ButtonType="Primary"
                                         Click="HandleLoadingBtnClick"
                                         Icon="{antdicons:AntDesignIconProvider Kind=PoweroffOutlined}" />
                        </WrapPanel>

                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-block"
                    Title="{gallery:ButtonShowCaseLangResource BlockButtonTitle}"
                    Description="{gallery:ButtonShowCaseLangResource BlockButtonDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical" Margin="10">
                        <atom:Button ButtonType="Primary" HorizontalAlignment="Stretch" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimary}" />
                        <atom:Button ButtonType="Default" HorizontalAlignment="Stretch" Content="{gallery:ButtonShowCaseLangResource P2ContentDefault}" />
                        <atom:Button ButtonType="Dashed" HorizontalAlignment="Stretch" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                        <atom:Button ButtonType="Text" HorizontalAlignment="Stretch" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                        <atom:Button ButtonType="Link" HorizontalAlignment="Stretch" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-danger"
                    Title="{gallery:ButtonShowCaseLangResource DangerButtonsTitle}"
                    Description="{gallery:ButtonShowCaseLangResource DangerButtonsDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <WrapPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                        <atom:Button ButtonType="Primary" IsDanger="True" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimary}" />
                        <atom:Button ButtonType="Default" IsDanger="True" Content="{gallery:ButtonShowCaseLangResource P2ContentDefault}" />
                        <atom:Button ButtonType="Dashed" IsDanger="True" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                        <atom:Button ButtonType="Text" IsDanger="True" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                        <atom:Button ButtonType="Link" IsDanger="True" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />
                    </WrapPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-ghost"
                    Title="{gallery:ButtonShowCaseLangResource GhostButtonTitle}"
                    Description="{gallery:ButtonShowCaseLangResource GhostButtonDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <Border Background="rgb(190, 200, 200)"
                            Margin="10"
                            Padding="10">
                        <StackPanel Orientation="Vertical">
                            <WrapPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                                <atom:Button ButtonType="Primary" IsGhost="True" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimary}" />
                                <atom:Button ButtonType="Default" IsGhost="True" Content="{gallery:ButtonShowCaseLangResource P2ContentDefault}" />
                                <atom:Button ButtonType="Dashed" IsGhost="True" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                                <atom:Button ButtonType="Text" IsGhost="True" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                                <atom:Button ButtonType="Link" IsGhost="True" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />
                                <atom:Button ButtonType="Primary" IsDanger="True" IsGhost="True" Content="{gallery:ButtonShowCaseLangResource P2ContentDanger}" />
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                                <atom:Button ButtonType="Primary" IsGhost="True"
                                             Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimary}" />
                                <atom:Button ButtonType="Default" IsGhost="True"
                                             Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDefault}" />
                                <atom:Button ButtonType="Text" IsGhost="True"
                                             Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                                <atom:Button ButtonType="Link" IsGhost="True"
                                             Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />
                                <atom:Button ButtonType="Primary" IsDanger="True" IsGhost="True"
                                             Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDanger}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-disabled"
                    Title="{gallery:ButtonShowCaseLangResource DisabledTitle}"
                    Description="{gallery:ButtonShowCaseLangResource DisabledDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                    <WrapPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <atom:Button ButtonType="Primary" Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimary}" />
                            <atom:Button ButtonType="Primary" IsEnabled="False"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentPrimaryDisabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <atom:Button ButtonType="Default" Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDefault}" />
                            <atom:Button ButtonType="Default" IsEnabled="False" Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDefaultDisabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <atom:Button ButtonType="Dashed" Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                            <atom:Button ButtonType="Dashed" IsEnabled="False"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDashedDisabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <atom:Button ButtonType="Text" Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                            <atom:Button ButtonType="Text" IsEnabled="False"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentTextDisabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <atom:Button ButtonType="Link" Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />
                            <atom:Button ButtonType="Link" IsEnabled="False"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentLinkDisabled}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <atom:Button ButtonType="Primary" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDangerPrimary}" />
                            <atom:Button ButtonType="Primary" IsDanger="True" IsEnabled="False"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDangerPrimaryDisabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <atom:Button ButtonType="Default" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDangerDefault}" />
                            <atom:Button ButtonType="Default" IsDanger="True" IsEnabled="False"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDangerDefaultDisabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <atom:Button ButtonType="Text" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDangerText}" />
                            <atom:Button ButtonType="Text" IsDanger="True" IsEnabled="False"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDangerTextDisabled}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <atom:Button ButtonType="Link" IsDanger="True"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDangerLink}" />
                            <atom:Button ButtonType="Link" IsDanger="True" IsEnabled="False"
                                         Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentDangerLinkDisabled}" />
                        </StackPanel>

                        <Border Background="rgb(190, 200, 200)">
                            <StackPanel Orientation="Horizontal">
                                <atom:Button IsGhost="True" Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentGhost}" />
                                <atom:Button IsGhost="True" IsEnabled="False"
                                             Icon="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" Content="{gallery:ButtonShowCaseLangResource P2ContentGhostDisabled}" />
                            </StackPanel>
                        </Border>

                    </WrapPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-gradient"
                    Title="{gallery:ButtonShowCaseLangResource GradientButtonTitle}"
                    Description="{gallery:ButtonShowCaseLangResource GradientButtonDescription}"
                    BadgeText="v6.0.5"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                            <WrapPanel Orientation="Horizontal"
                                       ItemSpacing="12"
                                       LineSpacing="12">
                                <atom:Button ButtonType="Primary"
                                             Content="{gallery:ButtonShowCaseLangResource P2ContentGradient}">
                                    <atom:Button.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#6253E1" Offset="0" />
                                            <GradientStop Color="#04BEFE" Offset="1" />
                                        </LinearGradientBrush>
                                    </atom:Button.Background>
                                </atom:Button>
                                <atom:Button ButtonType="Primary"
                                             Content="{gallery:ButtonShowCaseLangResource P2ContentWarmGradient}">
                                    <atom:Button.Background>
                                        <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                                            <GradientStop Color="#FF7A45" Offset="0" />
                                            <GradientStop Color="#FFD666" Offset="1" />
                                        </LinearGradientBrush>
                                    </atom:Button.Background>
                                </atom:Button>
                            </WrapPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-color-variant"
                    Title="{gallery:ButtonShowCaseLangResource ColorVariantTitle}"
                    Description="{gallery:ButtonShowCaseLangResource ColorVariantDescription}"
                    Span="Full"
                    BadgeText="v6.0.5"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                            <Grid ColumnDefinitions="72,Auto,Auto,Auto,Auto,Auto,Auto"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <atom:TextBlock Grid.Row="0" Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{gallery:ButtonShowCaseLangResource P2ColorDefault}" />
                                <atom:Button Grid.Row="0" Grid.Column="1" Color="Default" Variant="Solid" Content="{gallery:ButtonShowCaseLangResource P2ContentSolid}" />
                                <atom:Button Grid.Row="0" Grid.Column="2" Color="Default" Variant="Outlined" Content="{gallery:ButtonShowCaseLangResource P2ContentOutlined}" />
                                <atom:Button Grid.Row="0" Grid.Column="3" Color="Default" Variant="Dashed" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                                <atom:Button Grid.Row="0" Grid.Column="4" Color="Default" Variant="Filled" Content="{gallery:ButtonShowCaseLangResource P2ContentFilled}" />
                                <atom:Button Grid.Row="0" Grid.Column="5" Color="Default" Variant="Text" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                                <atom:Button Grid.Row="0" Grid.Column="6" Color="Default" Variant="Link" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />

                                <atom:TextBlock Grid.Row="1" Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{gallery:ButtonShowCaseLangResource P2ColorPrimary}" />
                                <atom:Button Grid.Row="1" Grid.Column="1" Color="Primary" Variant="Solid" Content="{gallery:ButtonShowCaseLangResource P2ContentSolid}" />
                                <atom:Button Grid.Row="1" Grid.Column="2" Color="Primary" Variant="Outlined" Content="{gallery:ButtonShowCaseLangResource P2ContentOutlined}" />
                                <atom:Button Grid.Row="1" Grid.Column="3" Color="Primary" Variant="Dashed" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                                <atom:Button Grid.Row="1" Grid.Column="4" Color="Primary" Variant="Filled" Content="{gallery:ButtonShowCaseLangResource P2ContentFilled}" />
                                <atom:Button Grid.Row="1" Grid.Column="5" Color="Primary" Variant="Text" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                                <atom:Button Grid.Row="1" Grid.Column="6" Color="Primary" Variant="Link" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />

                                <atom:TextBlock Grid.Row="2" Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{gallery:ButtonShowCaseLangResource P2ColorDanger}" />
                                <atom:Button Grid.Row="2" Grid.Column="1" Color="Danger" Variant="Solid" Content="{gallery:ButtonShowCaseLangResource P2ContentSolid}" />
                                <atom:Button Grid.Row="2" Grid.Column="2" Color="Danger" Variant="Outlined" Content="{gallery:ButtonShowCaseLangResource P2ContentOutlined}" />
                                <atom:Button Grid.Row="2" Grid.Column="3" Color="Danger" Variant="Dashed" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                                <atom:Button Grid.Row="2" Grid.Column="4" Color="Danger" Variant="Filled" Content="{gallery:ButtonShowCaseLangResource P2ContentFilled}" />
                                <atom:Button Grid.Row="2" Grid.Column="5" Color="Danger" Variant="Text" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                                <atom:Button Grid.Row="2" Grid.Column="6" Color="Danger" Variant="Link" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />

                                <atom:TextBlock Grid.Row="3" Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{gallery:ButtonShowCaseLangResource P2ColorPink}" />
                                <atom:Button Grid.Row="3" Grid.Column="1" Color="Pink" Variant="Solid" Content="{gallery:ButtonShowCaseLangResource P2ContentSolid}" />
                                <atom:Button Grid.Row="3" Grid.Column="2" Color="Pink" Variant="Outlined" Content="{gallery:ButtonShowCaseLangResource P2ContentOutlined}" />
                                <atom:Button Grid.Row="3" Grid.Column="3" Color="Pink" Variant="Dashed" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                                <atom:Button Grid.Row="3" Grid.Column="4" Color="Pink" Variant="Filled" Content="{gallery:ButtonShowCaseLangResource P2ContentFilled}" />
                                <atom:Button Grid.Row="3" Grid.Column="5" Color="Pink" Variant="Text" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                                <atom:Button Grid.Row="3" Grid.Column="6" Color="Pink" Variant="Link" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />

                                <atom:TextBlock Grid.Row="4" Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{gallery:ButtonShowCaseLangResource P2ColorPurple}" />
                                <atom:Button Grid.Row="4" Grid.Column="1" Color="Purple" Variant="Solid" Content="{gallery:ButtonShowCaseLangResource P2ContentSolid}" />
                                <atom:Button Grid.Row="4" Grid.Column="2" Color="Purple" Variant="Outlined" Content="{gallery:ButtonShowCaseLangResource P2ContentOutlined}" />
                                <atom:Button Grid.Row="4" Grid.Column="3" Color="Purple" Variant="Dashed" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                                <atom:Button Grid.Row="4" Grid.Column="4" Color="Purple" Variant="Filled" Content="{gallery:ButtonShowCaseLangResource P2ContentFilled}" />
                                <atom:Button Grid.Row="4" Grid.Column="5" Color="Purple" Variant="Text" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                                <atom:Button Grid.Row="4" Grid.Column="6" Color="Purple" Variant="Link" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />

                                <atom:TextBlock Grid.Row="5" Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{gallery:ButtonShowCaseLangResource P2ColorCyan}" />
                                <atom:Button Grid.Row="5" Grid.Column="1" Color="Cyan" Variant="Solid" Content="{gallery:ButtonShowCaseLangResource P2ContentSolid}" />
                                <atom:Button Grid.Row="5" Grid.Column="2" Color="Cyan" Variant="Outlined" Content="{gallery:ButtonShowCaseLangResource P2ContentOutlined}" />
                                <atom:Button Grid.Row="5" Grid.Column="3" Color="Cyan" Variant="Dashed" Content="{gallery:ButtonShowCaseLangResource P2ContentDashed}" />
                                <atom:Button Grid.Row="5" Grid.Column="4" Color="Cyan" Variant="Filled" Content="{gallery:ButtonShowCaseLangResource P2ContentFilled}" />
                                <atom:Button Grid.Row="5" Grid.Column="5" Color="Cyan" Variant="Text" Content="{gallery:ButtonShowCaseLangResource P2ContentText}" />
                                <atom:Button Grid.Row="5" Grid.Column="6" Color="Cyan" Variant="Link" Content="{gallery:ButtonShowCaseLangResource P2ContentLink}" />
                            </Grid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="button-semantic-part"
                    Title="{gallery:ButtonShowCaseLangResource SemanticPartStyleTitle}"
                    Description="{gallery:ButtonShowCaseLangResource SemanticPartStyleDescription}"
                    Span="Full"
                    BadgeText="v6.1.3"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="viewModels:ButtonViewModel">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Spacing="8">
                                <StackPanel.Styles>
                                    <Style Selector="atom|Button.semantic-part-demo">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="16,8" />
                                        <Setter Property="BorderBrush"
                                                Value="{atom:SharedTokenResource ColorBorder}" />
                                        <Setter Property="CornerRadius"
                                                Value="{atom:SharedTokenResource BorderRadius}" />
                                        <atom:ButtonContentStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground"
                                                    Value="{atom:SharedTokenResource ColorText}" />
                                        </atom:ButtonContentStyle>
                                    </Style>
                                    <Style Selector="atom|Button.semantic-part-demo.semantic-object">
                                        <Setter Property="Effect">
                                            <DropShadowEffect OffsetX="0"
                                                              OffsetY="1"
                                                              BlurRadius="2"
                                                              Color="#0D000000" />
                                        </Setter>
                                    </Style>
                                    <Style Selector="atom|Button.semantic-part-demo[ButtonType=Primary]">
                                        <Setter Property="Background" Value="#171717" />
                                        <atom:ButtonContentStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </atom:ButtonContentStyle>
                                    </Style>
                                </StackPanel.Styles>

                                <atom:Button Classes="semantic-part-demo semantic-object"
                                             Content="{gallery:ButtonShowCaseLangResource P2ContentSemanticObject}" />
                                <atom:Button Classes="semantic-part-demo"
                                             ButtonType="Primary"
                                             Content="{gallery:ButtonShowCaseLangResource P2ContentSemanticFunction}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
