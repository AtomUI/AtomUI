<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes">
    <ControlTheme x:Key="{x:Type atom:DataGridFilterMenuItem}" TargetType="atom:DataGridFilterMenuItem">
        <ControlTheme.BasedOn>
            <themes:MenuItemTheme TargetType="atom:DataGridFilterMenuItem"/>
        </ControlTheme.BasedOn>
        <Setter Property="Background">
            <MultiBinding Converter="{x:Static themes:DataGridThemeBindings.OptionalValue}">
                <atom:MenuTokenResource Kind="ItemBg" />
                <atom:DataGridTokenResource Kind="FilterDropdownMenuBg" WhenExplicit="True" />
            </MultiBinding>
        </Setter>
    </ControlTheme>
</ResourceDictionary>