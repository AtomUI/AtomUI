    <unit id="PageDescription">
      <segment>
        <source>DataGrid presents large tabular datasets with selection, sorting, filtering, frozen columns, row details, editing, drag sorting, and pagination.</source>
        <target state="translated">DataGrid 用于呈现大型表格数据，支持选择、排序、筛选、固定列、行详情、编辑、拖拽排序和分页。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Display, inspect, and edit structured data.</source>
        <target state="translated">展示、查看和编辑结构化数据。</target>
      </segment>
    </unit>
    <unit id="RemoteRangeDescription">
