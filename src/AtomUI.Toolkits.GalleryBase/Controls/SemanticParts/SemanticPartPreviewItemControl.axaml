<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="using:AtomUI.Icons.AntDesign"
    xmlns:gallery="https://atomui.net/toolkits/gallery-base"
    x:Class="AtomUI.Toolkits.GalleryBase.Controls.SemanticPartPreviewItemControl"
    x:DataType="gallery:SemanticPartPreviewItem">
    <UserControl.Styles>
        <!-- The row needs an opaque background: with a transparent background the Avalonia 12 compositor hit testing
        produces no hit, the blank area on the right of the row falls through to the layer below, and parts of the
        list row stop responding to the mouse
        -->
        <Style Selector="Border.part-row">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
        </Style>
        <Style Selector="Border.part-row:pointerover">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorFillTertiary}" />
        </Style>
        <Style Selector="Border.part-row.pinned">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimaryBg}" />
        </Style>
    </UserControl.Styles>

    <Border Name="PART_Row"
            Classes="part-row"
            Classes.pinned="{Binding IsPinned}"
            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
            BorderThickness="0,0,0,1"
            Padding="12">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <StackPanel Grid.Column="0"
                        Spacing="8">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <atom:TextBlock Text="{Binding Name}"
                                    FontSize="14"
                                    FontWeight="SemiBold" />
                    <!-- With several owners in one preview the row labels which owner a part belongs to (for example
                    the root of Message exists on two owners). A light TextBlock is used instead of a Tag so that
                    the row adds no extra badge control and the panel stays flat.
                    -->
                    <atom:TextBlock IsVisible="{Binding IsOwnerLabelVisible}"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{atom:SharedTokenResource ColorTextTertiary}"
                                    Text="{Binding OwnerTypeName}" />
                </StackPanel>

                <atom:TextBlock Text="{Binding Description}"
                                TextWrapping="Wrap"
                                Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Top">
                <atom:IconButton Name="PART_PinButton"
                                 Width="24"
                                 Height="24"
                                 IconWidth="14"
                                 IconHeight="14"
                                 atom:ToolTip.Tip="{gallery:SemanticPartPreviewLangResource PinAction}">
                    <atom:IconButton.Icon>
                        <antdicons:PushpinOutlined />
                    </atom:IconButton.Icon>
                </atom:IconButton>
                <atom:IconButton Name="PART_InfoButton"
                                 Width="24"
                                 Height="24"
                                 IconWidth="14"
                                 IconHeight="14"
                                 atom:ToolTip.Tip="{gallery:SemanticPartPreviewLangResource InfoAction}">
                    <atom:IconButton.Icon>
                        <antdicons:InfoCircleOutlined />
                    </atom:IconButton.Icon>
                </atom:IconButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
