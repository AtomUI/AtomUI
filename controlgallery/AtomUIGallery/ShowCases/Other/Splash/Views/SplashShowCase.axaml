<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Splash.SplashShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Splash"
             x:DataType="vm:SplashViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Splash"
                    Category="{gallery:SplashShowCaseLangResource ComponentCategory}"
                    Status="{gallery:SplashShowCaseLangResource ComponentStatusPreview}"
                    StatusTagColor="processing"
                    IntroducedVersion="{gallery:SplashShowCaseLangResource ComponentIntroducedVersion}"
                    Subtitle="{gallery:SplashShowCaseLangResource PageSubtitle}"
                    Description="{gallery:SplashShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Controls"
                    Package="AtomUI.Controls"
                    BaseClass="TemplatedControl"
                    MetadataValueWidth="240" />
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCasePanel.Resources>
                    <ResourceDictionary>
                        <!-- Splash 默认主题不是包主题资产（提交前由 SplashWindow 直接加载），页内预览需自行合并。 -->
                        <ResourceDictionary.MergedDictionaries>
                            <atom:SplashDefaultTheme/>
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </gallery:ShowCasePanel.Resources>

                <gallery:ShowCaseItem Title="{gallery:SplashShowCaseLangResource BasicTitle}"
                                      Description="{gallery:SplashShowCaseLangResource BasicDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplashViewModel">
                            <atom:Splash Title="AtomUI"
                                         Message="{gallery:SplashShowCaseLangResource P2MessagePreparingShell}"
                                         IsIndeterminate="True"
                                         HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplashShowCaseLangResource DeterminateTitle}"
                                      Description="{gallery:SplashShowCaseLangResource DeterminateDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplashViewModel">
                            <atom:Splash Title="AtomUI"
                                         Message="{gallery:SplashShowCaseLangResource P2MessagePreparingShell}"
                                         IsIndeterminate="False"
                                         Progress="0.6"
                                         HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:SplashShowCaseLangResource ErrorTitle}"
                                      Description="{gallery:SplashShowCaseLangResource ErrorDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SplashViewModel">
                            <atom:Splash Title="AtomUI"
                                         Message="{gallery:SplashShowCaseLangResource ErrorMessage}"
                                         Status="Error"
                                         HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
