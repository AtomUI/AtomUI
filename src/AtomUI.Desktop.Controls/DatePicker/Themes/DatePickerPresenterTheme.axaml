<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:viewer="clr-namespace:AtomUI.Desktop.Controls.Internal.DateViewer"
              xmlns:themes="clr-namespace:AtomUI.Desktop.Controls.Themes"
              x:Class="AtomUI.Desktop.Controls.Themes.DatePickerPresenterTheme"
              TargetType="atom:DatePickerPresenter"
              x:ClassModifier="internal">
    <ControlTheme.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="/DatePicker/Themes/DatePickerPresenterResources.axaml" />
        </ResourceDictionary.MergedDictionaries>
        <ControlTheme x:Key="DatePickerDatePanelTheme" TargetType="viewer:DatePanel">
            <ControlTheme.BasedOn><themes:DatePanelTheme TargetType="viewer:DatePanel" /></ControlTheme.BasedOn>
        </ControlTheme>
        </ResourceDictionary>
    </ControlTheme.Resources>
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:DatePickerPresenter">
            <DockPanel Name="RootLayout"
                       Classes.semantic-popup-container="True"
                       LastChildFill="True">
                <atom:PixelAlignedBorder Name="ButtonsFrame"
                                         Classes.semantic-popup-footer="True"
                                         BorderThickness="{TemplateBinding BorderThickness, Converter={x:Static atom:DatePickerPresenterTheme.BorderThicknessFilterConverter}}"
                                         IsVisible="{TemplateBinding IsButtonsPanelVisible}"
                                         DockPanel.Dock="Bottom">
                    <Panel Name="ButtonsLayout">
                        <atom:Button
                            Name="PART_NowButton"
                            ButtonType="Link"
                            HorizontalAlignment="Left"
                            SizeType="Small"
                            Content="{DynamicResource {x:Static atom:DatePickerLangResourceKind.Now}}" />
                        <atom:Button
                            Name="PART_TodayButton"
                            ButtonType="Link"
                            HorizontalAlignment="Left"
                            SizeType="Small"
                            Content="{atom:DatePickerLangResource Today}" />
                        <atom:Button
                            Name="PART_ConfirmButton"
                            ButtonType="Primary"
                            HorizontalAlignment="Right"
                            SizeType="Small"
                            Content="{atom:CommonLangResource Ok}" />
                    </Panel>
                </atom:PixelAlignedBorder>
                <StackPanel Orientation="Horizontal">
                    <atom:DateViewer Name="PART_DateViewer"
                                     Padding="0"
                                     Height="{TemplateBinding PanelHeight}"
                                     PanelTheme="{StaticResource DatePickerDatePanelTheme}"
                                     HeaderTemplate="{StaticResource DatePickerViewerHeader}"
                                     Presentation="Compact" />
                    <atom:TimeView Name="PART_TimeView"
                                   VerticalAlignment="Top"
                                   IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                   ClockIdentifier="{TemplateBinding ClockIdentifier}"
                                   IsVisible="{TemplateBinding IsTimeSelectionVisible}" />
                </StackPanel>
            </DockPanel>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|DatePickerPresenter)">
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        <Style Selector="^ /template/ atom|PixelAlignedBorder#ButtonsFrame">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
        </Style>

        <Style Selector="^ /template/ Panel#ButtonsLayout">
            <Setter Property="Margin" Value="{atom:DatePickerTokenResource ButtonsPanelMargin}" />
        </Style>

        <Style Selector="^ /template/ atom|TimeView#PART_TimeView">
            <Setter Property="Padding" Value="{atom:DatePickerTokenResource PanelContentPadding}" />
        </Style>
    </Style>

</ControlTheme>
