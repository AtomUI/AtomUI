<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gallery="https://atomui.net/toolkits/gallery-base"
                    xmlns:atom="https://atomui.net"
                    x:CompileBindings="True">

    <ControlTheme x:Key="{x:Type gallery:ColorItemControl}" TargetType="gallery:ColorItemControl">
        <!-- layout: Fixed palette swatch row height keeps adjacent reference colours aligned. -->
        <Setter Property="gallery:ColorItemControl.Height" Value="35" />
        <Setter Property="gallery:ColorItemControl.Template">
            <ControlTemplate TargetType="gallery:ColorItemControl">
                <Border Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}">
                    <Panel>
                        <atom:TextBlock Padding="{gallery:ColorItemControlTokenResource PaddingXS}"
                                       FontSize="{gallery:ColorItemControlTokenResource FontSizeSM}"
                                       FontWeight="{gallery:ColorItemControlTokenResource FontWeightStrong}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding ColorName}" />
                        <atom:TextBlock Name="PART_HexTextBlock"
                                       Padding="{gallery:ColorItemControlTokenResource PaddingXS}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="{gallery:ColorItemControlTokenResource HexFontSize}"
                                       FontWeight="{gallery:ColorItemControlTokenResource FontWeightStrong}"
                                       Foreground="{TemplateBinding Foreground}"
                                       IsVisible="False"
                                       Opacity="{gallery:ColorItemControlTokenResource HexOpacity}"
                                       Text="{TemplateBinding Hex}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ atom|TextBlock#PART_HexTextBlock">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
