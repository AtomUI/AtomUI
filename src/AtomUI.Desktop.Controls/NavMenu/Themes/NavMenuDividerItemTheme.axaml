<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:NavMenuDividerItem}"
                  TargetType="atom:NavMenuDividerItem">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Background="{atom:OwnerTokenResource Kind=ColorSplit, AnchorControlType={x:Type atom:NavMenuDividerItem}, Priority=Template}" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="Height" Value="{atom:OwnerTokenResource Kind=LineWidth, AnchorControlType={x:Type atom:NavMenuDividerItem}}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="Width" Value="{atom:OwnerTokenResource Kind=LineWidth, AnchorControlType={x:Type atom:NavMenuDividerItem}}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
