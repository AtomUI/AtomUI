<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:Class="AtomUI.Desktop.Controls.Themes.WindowTitleBarToggleButtonTheme"
    x:ClassModifier="internal"
    TargetType="atom:WindowTitleBarToggleButton">
    <ControlTheme.BasedOn>
        <themes:ToggleIconButtonTheme TargetType="{x:Type atom:WindowTitleBarToggleButton}" />
    </ControlTheme.BasedOn>

    <!-- Reuses the shared geometry shell of the managed caption: CaptionButtonFrame owns the background layer and the
    content layer, and only the presenter contract of the AddOn is declared here, so the geometry structure of the
    caption band is not duplicated.
    -->
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:WindowTitleBarToggleButton">
            <atom:CaptionButtonFrame Background="{TemplateBinding Background}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Padding="{TemplateBinding Padding}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch">
                <Panel Name="PART_RootLayout">
                    <atom:IconPresenter Name="PART_CheckedIconPresenter"
                                        Icon="{TemplateBinding CheckedIcon}"
                                        IsVisible="{TemplateBinding IsChecked}"
                                        Width="{TemplateBinding IconWidth}"
                                        Height="{TemplateBinding IconHeight}"
                                        IconBrush="{TemplateBinding IconBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                    <atom:IconPresenter Name="PART_UnCheckedIconPresenter"
                                        Icon="{TemplateBinding UnCheckedIcon}"
                                        Width="{TemplateBinding IconWidth}"
                                        Height="{TemplateBinding IconHeight}"
                                        IsVisible="{TemplateBinding IsChecked, Converter={x:Static BoolConverters.Not}}"
                                        IconBrush="{TemplateBinding IconBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                </Panel>
            </atom:CaptionButtonFrame>
        </ControlTemplate>
    </Setter>

    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="{atom:WindowTitleBarToggleButtonTokenResource CaptionButtonPadding}" />
    <Setter Property="IconWidth" Value="{atom:WindowTitleBarToggleButtonTokenResource CaptionButtonIconSize}" />
    <Setter Property="IconHeight" Value="{atom:WindowTitleBarToggleButtonTokenResource CaptionButtonIconSize}" />
    <Setter Property="CornerRadius" Value="{atom:WindowTitleBarToggleButtonTokenResource BorderRadiusSM}" />
    <Setter Property="Background" Value="{atom:WindowTitleBarToggleButtonTokenResource ActiveBgColor}" />
    <Setter Property="IconBrush" Value="{atom:WindowTitleBarToggleButtonTokenResource ActiveColor}" />

    <Style Selector="^[IsWindowActive=False]">
        <Setter Property="Background" Value="{atom:WindowTitleBarToggleButtonTokenResource InactiveBgColor}" />
        <Setter Property="IconBrush" Value="{atom:WindowTitleBarToggleButtonTokenResource InactiveColor}" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{atom:WindowTitleBarToggleButtonTokenResource InactiveHoverBgColor}" />
        </Style>
    </Style>

    <Style Selector="^[IsWindowActive=True]:pointerover">
        <Setter Property="Background" Value="{atom:WindowTitleBarToggleButtonTokenResource ActiveHoverBgColor}" />
    </Style>

    <Style Selector="^:pressed">
        <Setter Property="Background" Value="{atom:WindowTitleBarToggleButtonTokenResource ActivePressedBgColor}" />
    </Style>

    <Style Selector="^:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IconBrush" Value="{atom:WindowTitleBarToggleButtonTokenResource ColorTextDisabled}" />
    </Style>

    <Style Selector="^[HostMotionEnabled=False]">
        <Setter Property="IsMotionEnabled" Value="False" />
    </Style>

    <Style Selector="^[HostOsType=macOS]">
        <Setter Property="CornerRadius" Value="{atom:WindowTitleBarToggleButtonTokenResource CaptionButtonCornerRadius}" />
    </Style>

    <Style Selector="^[HostOsType=Linux]">
        <Setter Property="CornerRadius" Value="{atom:WindowTitleBarToggleButtonTokenResource CaptionButtonCornerRadius}" />
        <Style Selector="^ /template/ atom|CaptionButtonFrame">
            <Setter Property="BackgroundInset" Value="{atom:WindowTitleBarToggleButtonTokenResource CaptionButtonBackgroundInset}" />
        </Style>
    </Style>

    <Style Selector="^[HostOsType=Windows]">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <!-- layout: fixed template or platform geometry; preserve existing dimensions and hit regions. -->
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{atom:WindowTitleBarToggleButtonTokenResource ActiveHoverBgColor}" />
        </Style>

        <Style Selector="^[IsWindowActive=False]">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IconBrush" Value="{atom:WindowTitleBarToggleButtonTokenResource InactiveColor}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{atom:WindowTitleBarToggleButtonTokenResource InactiveHoverBgColor}" />
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{atom:WindowTitleBarToggleButtonTokenResource ActivePressedBgColor}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IconBrush" Value="{atom:WindowTitleBarToggleButtonTokenResource ColorTextDisabled}" />
        </Style>
    </Style>
</ControlTheme>
