<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImagePreviewer}" TargetType="atom:ImagePreviewer">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Background="{TemplateBinding Background}"
                                         Padding="{TemplateBinding Padding}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding CornerRadius}">
                    <atom:ImagePreviewerCover Classes.semantic-scope-cover="True"
                                              OwnerPadding="{TemplateBinding Padding}"
                                              OwnerBorderThickness="{TemplateBinding BorderThickness}"
                                              OwnerCornerRadius="{TemplateBinding CornerRadius}"
                                              ImageSource="{TemplateBinding EffectiveCoverImage}"
                                              IsLoading="{TemplateBinding IsCoverLoading}"
                                              IsFailed="{TemplateBinding IsCoverFailed}"
                                              Width="{TemplateBinding CoverWidth}"
                                              Height="{TemplateBinding CoverHeight}"
                                              LoadingContent="{TemplateBinding LoadingContent}"
                                              LoadingContentTemplate="{TemplateBinding LoadingContentTemplate}"
                                              ErrorContent="{TemplateBinding ErrorContent}"
                                              ErrorContentTemplate="{TemplateBinding ErrorContentTemplate}"
                                              Content="{TemplateBinding CoverIndicatorContent}"
                                              ContentTemplate="{TemplateBinding CoverIndicatorContentTemplate}"
                                              IsShowCoverMask="{TemplateBinding IsShowCoverMask}"/>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        
        <Setter Property="CoverIndicatorContentTemplate">
            <DataTemplate>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{atom:OwnerTokenResource Kind=SpacingXXS, SourceControlType={x:Type atom:ImagePreviewer}}">
                    <antdicons:EyeOutlined StrokeBrush="{atom:OwnerTokenResource Kind=ColorTextLightSolid, SourceControlType={x:Type atom:ImagePreviewer}}"/>
                    <TextBlock
                        Text="{atom:ImagePreviewerLangResource Preview}" />
                </StackPanel>
            </DataTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
