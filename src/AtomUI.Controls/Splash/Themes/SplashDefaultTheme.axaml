<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net"
                    x:Class="AtomUI.Controls.SplashDefaultTheme">
    <!-- Uses only global Tokens and base elements: this theme loads before the kernel is committed. Do not reference
    AtomUI controls or control Tokens here; SplashProgressBar is the one exception, a control without a template
    that needs no theme. The template describes structure only; appearance values such as sizes, colors and font
    sizes always go into the styles: a local value in the template outranks styles, so a value written in the
    template cannot be overridden by a custom theme that merges this dictionary and uses BasedOn.
    -->
    <ControlTheme x:Key="{x:Type atom:SplashWindow}" TargetType="atom:SplashWindow">
        <Setter Property="WindowDecorations" Value="None"/>
        <Setter Property="SizeToContent" Value="WidthAndHeight"/>
        <Setter Property="CanResize" Value="False"/>
        <Setter Property="WindowStartupLocation" Value="CenterScreen"/>
        <Setter Property="Topmost" Value="True"/>
        <Setter Property="TransparencyLevelHint" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <!-- Transparent margin reserved for the card shadow. -->
            <!-- layout: fixed template or platform geometry; preserve existing dimensions and hit regions. -->
            <Setter Property="Margin" Value="48"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type atom:Splash}" TargetType="atom:Splash">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- A compiled binding in a setter cannot reach into the template scope by name, so Shadow reads
                    the effective values of Card in the fixed order below. The shadow cache is separate from the
                    content, and Card keeps its existing clipping and appearance customization entries.
                    -->
                    <Canvas>
                        <!-- The canvas does not grow the card from the shadow's layout result. -->
                        <Border Name="Shadow" IsHitTestVisible="False"/>
                    </Canvas>
                    <Border Name="Card" ClipToBounds="True">
                        <Panel>
                            <Image Name="BackgroundImage" Source="{TemplateBinding BackgroundImage}" Stretch="UniformToFill"
                                   IsVisible="{TemplateBinding BackgroundImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <StackPanel Name="Content">
                                <Image Name="Logo" Source="{TemplateBinding Logo}" HorizontalAlignment="Center"
                                       IsVisible="{TemplateBinding Logo, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <TextBlock Name="Title" Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <TextBlock Name="Message" Text="{TemplateBinding Message}" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <atom:SplashProgressBar Name="Progress"
                                                        Value="{TemplateBinding Progress}"
                                                        IsIndeterminate="{TemplateBinding IsIndeterminate}"/>
                            </StackPanel>
                            <Path Name="PART_CloseButton" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Stretch="Uniform" Cursor="Hand" Data="M0,0 L10,10 M10,0 L0,10"/>
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Card">
            <!-- layout: fixed startup card width; custom startup themes may replace this layout. -->
            <Setter Property="Width" Value="420"/>
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorBgContainer}"/>
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}"/>
            <Setter Property="BoxShadow" Value="{atom:OwnerTokenResource BoxShadowsSecondary}"/>
        </Style>
        <Style Selector="^ /template/ Border#Shadow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Canvas.Left" Value="{CompiledBinding $parent[Panel;1].Children[1].Bounds.X}"/>
            <Setter Property="Canvas.Top" Value="{CompiledBinding $parent[Panel;1].Children[1].Bounds.Y}"/>
            <Setter Property="Width" Value="{CompiledBinding $parent[Panel;1].Children[1].Bounds.Width}"/>
            <Setter Property="Height" Value="{CompiledBinding $parent[Panel;1].Children[1].Bounds.Height}"/>
            <Setter Property="CornerRadius" Value="{CompiledBinding $parent[Panel;1].Children[1].(Border.CornerRadius)}"/>
            <Setter Property="BoxShadow" Value="{CompiledBinding $parent[Panel;1].Children[1].(Border.BoxShadow)}"/>
            <Setter Property="CacheMode">
                <BitmapCache/>
            </Setter>
        </Style>
        <Style Selector="^ /template/ StackPanel#Content">
            <Setter Property="Margin" Value="{atom:OwnerTokenResource PaddingLG}"/>
            <Setter Property="Spacing" Value="{atom:OwnerTokenResource SpacingSM}"/>
        </Style>
        <Style Selector="^ /template/ Image#Logo">
            <!-- layout: fixed logo asset slot inside the startup card. -->
            <Setter Property="Width" Value="64"/>
            <!-- layout: fixed logo asset slot inside the startup card. -->
            <Setter Property="Height" Value="64"/>
        </Style>
        <Style Selector="^ /template/ TextBlock#Title">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeHeading4}"/>
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}"/>
        </Style>
        <Style Selector="^ /template/ TextBlock#Message">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}"/>
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextSecondary}"/>
        </Style>
        <Style Selector="^ /template/ atom|SplashProgressBar#Progress">
            <!-- layout: fixed startup progress lane height. -->
            <Setter Property="Height" Value="4"/>
            <!-- layout: pill end is half the fixed4px startup progress lane. -->
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="IndicatorBrush" Value="{atom:OwnerTokenResource ColorPrimary}"/>
            <Setter Property="TrackBrush" Value="{atom:OwnerTokenResource ColorFillSecondary}"/>
        </Style>
        <Style Selector="^ /template/ Path#PART_CloseButton">
            <Setter Property="Width" Value="{atom:OwnerTokenResource IconSizeSM}"/>
            <Setter Property="Height" Value="{atom:OwnerTokenResource IconSizeSM}"/>
            <Setter Property="Margin" Value="{atom:OwnerTokenResource Margin}"/>
            <Setter Property="Stroke" Value="{atom:OwnerTokenResource ColorIcon}"/>
            <Setter Property="StrokeThickness" Value="{atom:OwnerTokenResource LineWidth}"/>
        </Style>
        <Style Selector="^:error /template/ TextBlock#Message">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorError}"/>
        </Style>
        <Style Selector="^:error /template/ atom|SplashProgressBar#Progress">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^:error /template/ Path#PART_CloseButton">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="^:opaque /template/ Border#Card">
            <!-- layout: fixed template or platform geometry; preserve existing dimensions and hit regions. -->
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
        </Style>
        <Style Selector="^:opaque /template/ Border#Shadow">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
