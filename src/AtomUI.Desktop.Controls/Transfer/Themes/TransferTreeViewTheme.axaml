<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:TransferTreeView}" TargetType="atom:TransferTreeView">
        <Setter Property="atom:TreeViewItemHeader.HeaderHeight" Value="{atom:TransferTreeViewTokenResource HeaderHeight}" />
        <Setter Property="atom:TreeViewItemHeader.NodeHoverBackground" Value="{atom:TransferTreeViewTokenResource NodeHoverBg}" />
        <Setter Property="atom:TreeViewItemHeader.NodeSelectedBackground" Value="{atom:TransferTreeViewTokenResource NodeSelectedBg}" />
        <Setter Property="atom:TreeViewItemHeader.NodeSelectedForeground" Value="{atom:TransferTreeViewTokenResource NodeSelectedColor}" />


        <Setter Property="atom:TreeViewItemHeader.ItemMargin" Value="{atom:TransferTreeViewTokenResource TreeItemMargin}" />
        <Setter Property="atom:TreeViewItemHeader.ItemHeaderPadding" Value="{atom:TransferTreeViewTokenResource TreeItemHeaderPadding}" />
        <Setter Property="atom:TreeViewItemHeader.ItemHeaderMargin" Value="{atom:TransferTreeViewTokenResource TreeItemHeaderMargin}" />
        <Setter Property="atom:TreeViewItemHeader.NodeSwitcherMargin" Value="{atom:TransferTreeViewTokenResource TreeNodeSwitcherMargin}" />
        <Setter Property="atom:TreeViewItemHeader.NodeIconMargin" Value="{atom:TransferTreeViewTokenResource TreeNodeIconMargin}" />
        <Setter Property="atom:TreeViewItemHeader.FilterHighlightBrush" Value="{atom:TransferTreeViewTokenResource FilterHighlightColor}" />

        <ControlTheme.BasedOn>
            <atom:TreeViewTheme TargetType="atom:TransferTreeView"/>
        </ControlTheme.BasedOn>
        
        <Setter Property="ToggleType" Value="CheckBox"/>
        <Setter Property="IsCheckStrictly" Value="True"/>
    </ControlTheme>
</ResourceDictionary>
