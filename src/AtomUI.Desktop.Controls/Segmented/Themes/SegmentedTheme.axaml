<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Segmented}" TargetType="atom:Segmented">
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadius, AnchorControlType={x:Type atom:Segmented}}" />
        <Setter Property="SelectedThumbCornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadiusSM, AnchorControlType={x:Type atom:Segmented}}" />

        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>

        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="True">
                    <ItemsPresenter Name="PART_ItemsPresenter">
                        <ItemsPresenter.ItemsPanel>
                            <ItemsPanelTemplate>
                                <atomc:SegmentedStackPanel
                                    Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=atom:Segmented}}"
                                    IsExpanding="{Binding IsExpanding, RelativeSource={RelativeSource AncestorType=atom:Segmented}}" />
                            </ItemsPanelTemplate>
                        </ItemsPresenter.ItemsPanel>
                    </ItemsPresenter>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="Padding" Value="{atom:SegmentedTokenResource TrackPadding}" />
        <Setter Property="Background" Value="{atom:SegmentedTokenResource TrackBg}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SelectedThumbBg" Value="{atom:SegmentedTokenResource ItemSelectedBg}" />
        <Setter Property="SelectedThumbBoxShadows" Value="{atom:OwnerTokenResource Kind=BoxShadowsTertiary, AnchorControlType={x:Type atom:Segmented}}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Style Selector="^[IsExpanding=True]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadiusLG, AnchorControlType={x:Type atom:Segmented}}" />
            <Setter Property="SelectedThumbCornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadius, AnchorControlType={x:Type atom:Segmented}}" />
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadius, AnchorControlType={x:Type atom:Segmented}}" />
            <Setter Property="SelectedThumbCornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadiusSM, AnchorControlType={x:Type atom:Segmented}}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadiusSM, AnchorControlType={x:Type atom:Segmented}}" />
            <Setter Property="SelectedThumbCornerRadius" Value="{atom:OwnerTokenResource Kind=BorderRadiusXS, AnchorControlType={x:Type atom:Segmented}}" />
        </Style>

        <Style Selector="^[Shape=Round]">
            <Setter Property="CornerRadius" Value="9999" />
            <Setter Property="SelectedThumbCornerRadius" Value="9999" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <!-- 对齐 antd 滑块动效：位移与尺寸同时插值，motionDurationSlow(300ms)，motionEaseInOut cubic-bezier(0.645, 0.045, 0.355, 1) -->
                    <PointTransition Property="SelectedThumbPos" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationSlow}" Easing="0.645,0.045,0.355,1" />
                    <SizeTransition Property="SelectedThumbSize" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationSlow}" Easing="0.645,0.045,0.355,1" />
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="x:String">
                <atom:TextBlock Text="{Binding}" />
            </DataTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
