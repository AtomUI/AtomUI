<ControlTheme TargetType="atom:DataGridColumnHeader"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              x:Class="AtomUI.Desktop.Controls.Themes.DataGridColumnHeaderTheme"
              x:ClassModifier="internal"
              xmlns:atom="https://atomui.net"
              xmlns:converters="using:AtomUI.Controls.Converters"
              >
    <ControlTheme.Resources>
        <converters:BorderThicknessFilterConverter x:Key="RightSeparatorThicknessConverter"
            Left="False" Top="False" Bottom="False" />
    </ControlTheme.Resources>
    <Setter Property="BorderThickness" Value="{atom:DataGridTokenResource BorderThickness}" />
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:DataGridColumnHeader">
            <Panel Name="RootFrame">
                <Border Name="PART_Frame" Background="{TemplateBinding Background}">
                    <Panel Name="PART_RootLayout">
                        <Border Name="PART_ContentFrame">
                            <DockPanel LastChildFill="True" Name="ContentLayout">
                                <StackPanel Name="IndicatorsLayout"
                                            Orientation="Horizontal"
                                            DockPanel.Dock="Right"
                                            IsVisible="{TemplateBinding IndicatorLayoutVisible}">
                                    <atom:DataGridSortIndicator
                                        Name="{x:Static atom:DataGridColumnHeaderThemeConstants.SortIndicatorPart}"
                                        Margin="{atom:DataGridTokenResource SortIndicatorLayoutMargin}"
                                        VerticalAlignment="Center"
                                        IsVisible="{TemplateBinding CanUserSort}"
                                        SupportedSortDirections="{TemplateBinding SupportedSortDirections}" />
                                    <atom:DataGridFilterIndicator
                                        Name="{x:Static atom:DataGridColumnHeaderThemeConstants.FilterIndicatorPart}"
                                        VerticalAlignment="Center"
                                        IsVisible="{TemplateBinding FilterIndicatorVisible}" />
                                </StackPanel>
                                <ContentPresenter
                                    Name="ContentPresenter"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </Border>
                        <atom:PixelAlignedBorder Name="PART_VerticalSeparator"
                                                 BorderThickness="{TemplateBinding BorderThickness, Converter={StaticResource RightSeparatorThicknessConverter}}"
                                                 Width="{atom:DataGridTokenResource LineWidth}"
                                                 HorizontalAlignment="Right"
                                                 IsVisible="{TemplateBinding IsSeparatorsVisible}" />
                        <Panel Name="PART_FocusVisual"
                               IsVisible="False"
                               IsHitTestVisible="False">
                            <Rectangle Name="FocusVisualPrimary"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Fill="Transparent"
                                       IsHitTestVisible="False"
                                       StrokeThickness="{atom:DataGridTokenResource LineWidthBold}" />
                            <Rectangle Name="FocusVisualSecondary"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Fill="Transparent"
                                       IsHitTestVisible="False"
                                       StrokeThickness="{atom:DataGridTokenResource LineWidth}" />
                        </Panel>
                    </Panel>
                </Border>
                <!-- layout: 对齐 AntD fixed.ts 的 ::after：冻结列阴影绘制在表头外侧 30px 的条带上，覆盖滚动到分界线下的表头 -->
                <atom:DataGridFrozenColumnShadow Name="FrozenShadow"
                                                 Width="30"
                                                 IsVisible="False"
                                                 IsHitTestVisible="False" />
            </Panel>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|DataGridColumnHeader)">
        <Setter Property="Foreground" Value="{atom:DataGridTokenResource TableHeaderTextColor}" />
        <Setter Property="FontWeight" Value="{atom:OwnerTokenResource FontWeightStrong}" />
        <Setter Property="atom:ToolTip.Placement" Value="Top" />
        <Setter Property="atom:ToolTip.ShowDelay" Value="1000" />
        <Setter Property="atom:ToolTip.ServiceEnabled" Value="False" />
        <Setter Property="atom:ToolTip.IsCustomShowAndHide" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{atom:DataGridTokenResource TableHeaderBg}" />

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="StateTransitionDuration" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Style Selector="^[IsSorterTooltipVisible=True]">
            <Setter Property="atom:ToolTip.ServiceEnabled" Value="True" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ Border#PART_ContentFrame">
                <Setter Property="Padding" Value="{atom:DataGridTokenResource TablePadding}" />
            </Style>
            <Setter Property="FontSize" Value="{atom:DataGridTokenResource TableFontSize}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style Selector="^ /template/ Border#PART_ContentFrame">
                <Setter Property="Padding"
                        Value="{atom:DataGridTokenResource TablePaddingMiddle}" />
            </Style>
            <Setter Property="FontSize" Value="{atom:DataGridTokenResource TableFontSizeMiddle}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ Border#PART_ContentFrame">
                <Setter Property="Padding" Value="{atom:DataGridTokenResource TablePaddingSmall}" />
            </Style>
            <Setter Property="FontSize" Value="{atom:DataGridTokenResource TableFontSizeSmall}" />
        </Style>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_VerticalSeparator">
            <Setter Property="BorderBrush" Value="{atom:DataGridTokenResource TableHeaderCellSplitColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="{atom:OwnerTokenResource FontHeight}" />
        </Style>

        <Style Selector="^[IsSeparatorFullHeight=True] /template/ atom|PixelAlignedBorder#PART_VerticalSeparator">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="NaN" />
        </Style>

        <Style Selector="^ /template/ StackPanel#IndicatorsLayout">
            <Setter Property="Spacing" Value="{atom:OwnerTokenResource UniformlyMarginXXS}" />
        </Style>

        <Style Selector="^ /template/ DockPanel#ContentLayout">
            <Setter Property="HorizontalSpacing" Value="{atom:OwnerTokenResource UniformlyMarginXS}" />
        </Style>
        <Style Selector="^:sort-ascending">
            <Style Selector="^ /template/ atom|DataGridSortIndicator#PART_SortIndicator">
                <Setter Property="CurrentSortDirection" Value="Ascending" />
            </Style>
        </Style>
        <Style Selector="^:sort-descending">
            <Style Selector="^ /template/ atom|DataGridSortIndicator#PART_SortIndicator">
                <Setter Property="CurrentSortDirection" Value="Descending" />
            </Style>
        </Style>
        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ atom|DataGridSortIndicator#PART_SortIndicator">
                <Setter Property="IsHoverMode" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[CanUserSort=True]">
            <Style Selector="^:sort-ascending, ^:sort-descending">
                <Setter Property="Background"
                        Value="{atom:DataGridTokenResource TableHeaderSortBg}" />
            </Style>

            <Style Selector="^ /template/ Border#PART_Frame">
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style Selector="^:pointerover">
                <Setter Property="Background"
                        Value="{atom:DataGridTokenResource TableHeaderSortHoverBg}" />
            </Style>
        </Style>

        <Style Selector="^:drag-indicator">
            <Setter Property="Background" Value="{atom:DataGridTokenResource ColumnReorderActiveBg}" />
        </Style>

        <Style Selector="^[HeaderDragMode=Reorder]">
            <Setter Property="Background"
                    Value="{atom:DataGridTokenResource ColumnReorderActiveBg}" />
        </Style>

        <Style Selector="^[IsShowFrozenShadow=True]">

            <Setter Property="Background" Value="{atom:DataGridTokenResource TableHeaderBg}" />

            <!-- layout: 阴影条带伸出表头，需绘制在相邻滚动列表头之上 -->
            <Setter Property="ZIndex" Value="1" />
            <Style Selector="^ /template/ atom|DataGridFrozenColumnShadow#FrozenShadow">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <!-- First column of the right frozen columns: the shadow strip sits outside the left edge of the header -->
            <Style Selector="^[FrozenShadowPosition=Left] /template/ atom|DataGridFrozenColumnShadow#FrozenShadow">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="RenderTransform" Value="translateX(-30px)" />
                <Setter Property="BoxShadow"
                        Value="{atom:DataGridTokenResource RightFrozenShadows}" />
            </Style>
            <!-- Last column of the left frozen columns: the shadow strip sits outside the right edge of the header -->
            <Style Selector="^[FrozenShadowPosition=Right] /template/ atom|DataGridFrozenColumnShadow#FrozenShadow">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="RenderTransform" Value="translateX(30px)" />
                <Setter Property="BoxShadow"
                        Value="{atom:DataGridTokenResource LeftFrozenShadows}" />
            </Style>
        </Style>

        <Style Selector="^[SortTooltipType=Cancel]">
            <Setter Property="atom:ToolTip.Tip" Value="{atom:DataGridLangResource CancelTooltip}" />
        </Style>

        <Style Selector="^[SortTooltipType=Ascending]">
            <Setter Property="atom:ToolTip.Tip" Value="{atom:DataGridLangResource AscendTooltip}" />
        </Style>

        <Style Selector="^[SortTooltipType=Descending]">
            <Setter Property="atom:ToolTip.Tip" Value="{atom:DataGridLangResource DescendTooltip}" />
        </Style>

    </Style>
</ControlTheme>
