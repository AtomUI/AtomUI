<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:gallery="https://atomui.net/toolkits/gallery-base">
    <ControlTheme x:Key="{x:Type gallery:GalleryStickyTabsHost}"
                  TargetType="{x:Type gallery:GalleryStickyTabsHost}">
        <Setter Property="StickyContentPadding"
                Value="{gallery:GalleryStickyTabsHostTokenResource StickyContentPadding}" />
        <Setter Property="StickyBackground"
                Value="{gallery:GalleryStickyTabsHostTokenResource StickyBackground}" />
        <Setter Property="StickyBorderBrush"
                Value="{gallery:GalleryStickyTabsHostTokenResource StickyBorderBrush}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type gallery:GalleryStickyTabsHost}">
                <atom:ScrollViewer Name="PART_ScrollViewer"
                                   VerticalScrollBarVisibility="Auto"
                                   AllowAutoHide="False"
                                   BringIntoViewOnFocusChange="False"
                                   IsLiteMode="False">
                    <gallery:GalleryStickyTabsPanel Name="PART_StickyPanel">
                        <ContentPresenter Name="PART_HeaderHost"
                                          Content="{TemplateBinding Header}" />
                        <atom:PixelAlignedBorder Name="PART_StickyContentHost"
                                                 Background="{TemplateBinding StickyBackground}"
                                                 BorderBrush="{TemplateBinding StickyBorderBrush}"
                                                 BorderThickness="0,0,0,1"
                                                 IsVisible="{TemplateBinding HasStickyContent}"
                                                 Padding="{TemplateBinding StickyContentPadding}"
                                                 ZIndex="1">
                            <ContentPresenter Content="{TemplateBinding StickyContent}" />
                        </atom:PixelAlignedBorder>
                        <ContentPresenter Name="PART_ContentHost"
                                          Content="{TemplateBinding Content}" />
                    </gallery:GalleryStickyTabsPanel>
                </atom:ScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
