<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImagePreviewNavButton}" TargetType="atom:ImagePreviewNavButton">
        <ControlTheme.BasedOn>
            <atom:IconButtonTheme TargetType="atom:ImagePreviewNavButton" />
        </ControlTheme.BasedOn>
        
        <Style Selector="^:is(atom|ImagePreviewNavButton)">
            <Setter Property="IconWidth" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePreviewOperationSize)}"/>
            <Setter Property="IconHeight" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePreviewOperationSize)}"/>
            <Setter Property="Background" Value="{CompiledBinding $self.(atom:ImageViewer.ThemeNavButtonBgColor)}"/>
            <Setter Property="IconBrush" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePreviewOperationColor)}"/>
            <Setter Property="Padding" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePaddingXS)}"/>
        
            <Style Selector="^:pointerover, ^:pressed">
                <Setter Property="Background" Value="{CompiledBinding $self.(atom:ImageViewer.ThemeNavButtonBgHoverColor)}"/>
                <Setter Property="IconBrush" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePreviewOperationHoverColor)}"/>
            </Style>
        
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{CompiledBinding $self.(atom:ImageViewer.ThemeNavButtonBgColor)}"/>
                <Setter Property="IconBrush" Value="{CompiledBinding $self.(atom:ImageViewer.ThemePreviewOperationColorDisabled)}"/>
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
