<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.IconButtonTheme"
              TargetType="atom:IconButton"
              x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:IconButton">
            <atom:PixelAlignedBorder
                Name="Frame"
                BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{TemplateBinding BorderBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="{TemplateBinding Background}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="{TemplateBinding Padding}">
                <atom:IconPresenter
                    Name="IconPresenter"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="{TemplateBinding Icon}"
                    IconBrush="{TemplateBinding IconBrush}"
                    Width="{TemplateBinding IconWidth}"
                    Height="{TemplateBinding IconHeight}" />
            </atom:PixelAlignedBorder>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|IconButton)">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IconWidth" Value="{atom:IconButtonTokenResource IconSizeSM}" />
        <Setter Property="IconHeight" Value="{atom:IconButtonTokenResource IconSizeSM}" />
        <Setter Property="CornerRadius" Value="{atom:IconButtonTokenResource BorderRadiusSM}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsMotionEnabled" Value="{atom:IconButtonTokenResource EnableMotion}" />

        <Style Selector="^ /template/ atom|IconPresenter atom|Icon">
            <Setter Property="LoadingAnimation" Value="{TemplateBinding LoadingAnimation}" />
            <Setter Property="LoadingAnimationDuration" Value="{TemplateBinding LoadingAnimationDuration}" />
        </Style>

        <Setter Property="IconBrush"
                Value="{atom:IconButtonTokenResource ColorIcon}" />

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions DurationKind="MotionDurationMid">
                    <atom:SolidColorBrushTransition Property="Background" />
                    <atom:SolidColorBrushTransition Property="IconBrush" />
                    <TransformOperationsTransition Property="RenderTransform" />
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="IconBrush"
                    Value="{atom:IconButtonTokenResource ColorIconHover}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="IconBrush"
                    Value="{atom:IconButtonTokenResource ColorText}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="IconBrush"
                    Value="{atom:IconButtonTokenResource ColorTextDisabled}" />
        </Style>
    </Style>

</ControlTheme>
