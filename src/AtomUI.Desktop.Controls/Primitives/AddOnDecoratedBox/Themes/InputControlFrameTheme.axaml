<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.InputControlFrameTheme"
              TargetType="atom:InputControlFrame"
              x:ClassModifier="internal">
    <!-- The frame expresses focus through :focus-within (border and outline shadow). Templates make frames
         focusable for pointer hits on padding; they must never add an adorner frame. -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:InputControlFrame">
            <atom:PixelAlignedBorder
                Name="InnerBoxDecorator"
                Padding="{TemplateBinding Padding}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BoxShadow="{TemplateBinding BoxShadow}"
                BackgroundSizing="InnerBorderEdge">
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </atom:PixelAlignedBorder>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|InputControlFrame)">
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
        
        <Style Selector="^[SizeType=Large]">
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
                <Setter Property="Padding"
                        Value="{atom:OwnerTokenResource InputPaddingLG}" />
            </Style>
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
                <Setter Property="Padding"
                        Value="{atom:OwnerTokenResource InputPaddingLG}" />
            </Style>
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
                <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPadding}" />
            </Style>
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
                <Setter Property="Padding" Value="{atom:OwnerTokenResource InputPadding}" />
            </Style>
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_LeftAddOn">
                <Setter Property="Padding"
                        Value="{atom:OwnerTokenResource InputPaddingSM}" />
            </Style>
            <Style
                Selector="^ /template/ atom|PixelAlignedBorder#PART_RightAddOn">
                <Setter Property="Padding"
                        Value="{atom:OwnerTokenResource InputPaddingSM}" />
            </Style>
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
        </Style>

        <!-- status 不同的时候左右附加区域的主体色设置 -->
        <Style Selector="^[EffectiveStatus=Error]">
        </Style>

        <Style Selector="^[EffectiveStatus=Warning]">
        </Style>

        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />

        <!-- Outline -->
        <Style Selector="^:outline">
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorder}" />
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorBgContainer}" />
        </Style>
        <Style Selector="^:outline[IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimaryHover}" />
        </Style>
        <Style Selector="^:outline:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary}" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputActiveShadow}" />
        </Style>
        <Style Selector="^:outline:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary}" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputActiveShadow}" />
        </Style>

        <!-- Outline + Error -->
        <Style Selector="^:outline[EffectiveStatus=Error]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:outline[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Error][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorErrorBorderHover}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Error]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputErrorActiveShadow}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Error]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputErrorActiveShadow}" />
        </Style>

        <!-- Outline + Warning -->
        <Style Selector="^:outline[EffectiveStatus=Warning]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:outline[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Warning][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarningBorderHover}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Warning]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputWarningActiveShadow}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Warning]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
            <Setter Property="BoxShadow"
                    Value="{atom:OwnerTokenResource InputWarningActiveShadow}" />
        </Style>

        <!-- Filled -->
        <Style Selector="^:filled">
            <Setter Property="Background" Value="{atom:OwnerTokenResource ColorFillTertiary}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorFillTertiary}" />
        </Style>
        <Style Selector="^:filled /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:filled /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorFillTertiary}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorFillTertiary}" />
        </Style>
        <Style Selector="^:filled[IsInnerBoxHover=True]">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorFillSecondary}" />
        </Style>
        <Style Selector="^:filled:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:filled:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary}" />
        </Style>

        <!-- Filled + Error -->
        <Style Selector="^:filled[EffectiveStatus=Error]">
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorErrorBg}" />
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorErrorBg}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:filled[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorErrorBg}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Error][IsInnerBoxHover=True]">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorErrorBgHover}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Error]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
            <Setter Property="Background"
                    Value="Transparent" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Error]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
        </Style>

        <!-- Filled + Warning -->
        <Style Selector="^:filled[EffectiveStatus=Warning]">
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorWarningBg}" />
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorWarningBg}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:filled[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorWarningBg}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Warning][IsInnerBoxHover=True]">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorWarningBgHover}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Warning]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
            <Setter Property="Background"
                    Value="Transparent" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Warning]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>

        <!-- Borderless -->
        <Style Selector="^:borderless /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:borderless /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Underlined -->
        <Style Selector="^:underlined">
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>
        <Style Selector="^:underlined /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:underlined /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:underlined[IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimaryHover}" />
        </Style>
        <Style Selector="^:underlined:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary}" />
        </Style>
        <Style Selector="^:underlined:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorPrimary}" />
        </Style>

        <!-- Underlined + Error -->
        <Style Selector="^:underlined[EffectiveStatus=Error]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Error][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorErrorBorderHover}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Error]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Error]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
        </Style>

        <!-- Underlined + Warning -->
        <Style Selector="^:underlined[EffectiveStatus=Warning]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Warning][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarningBorderHover}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Warning]:focus-within">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>
        <Style Selector="^:underlined[EffectiveStatus=Warning]:pressed">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>

        <!-- Disabled -->
        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:OwnerTokenResource ColorTextDisabled}" />
        </Style>
        <Style Selector="^:disabled:outline, ^:disabled:filled">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>
        <Style Selector="^:disabled:outline /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:disabled:outline /template/ atom|PixelAlignedBorder#PART_RightAddOn,
                         ^:disabled:filled /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:disabled:filled /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>
        <Style Selector="^:disabled:underlined">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>

        <!-- Root brushes of the hosting input control (template-bound into HostBorderBrush / HostBackground) win over
             every state brush above, mirroring antd styles.root; unset hands the surface back to the state machine. -->
        <Style Selector="^:host-border-brush">
            <Setter Property="BorderBrush"
                    Value="{Binding (atom:InputControlFrame).HostBorderBrush, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style Selector="^:host-background">
            <Setter Property="Background"
                    Value="{Binding (atom:InputControlFrame).HostBackground, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:BoxShadowsTransition Property="BoxShadow" atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#InnerBoxDecorator">
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                            <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationMid" />
                            <atom:BoxShadowsTransition Property="BoxShadow" atom:TokenTransitions.Duration="MotionDurationMid" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>
        </Style>
    </Style>

</ControlTheme>
