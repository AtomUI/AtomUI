<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CheckableTagItemsControl}"
                  TargetType="atom:CheckableTagItemsControl">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:CheckableTagItemsControl">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>

        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="{CompiledBinding $parent[atom:CheckableTagItemsControl].Orientation}"
                           ItemSpacing="{CompiledBinding $parent[atom:CheckableTagItemsControl].ItemSpacing}"
                           LineSpacing="{CompiledBinding $parent[atom:CheckableTagItemsControl].LineSpacing}" />
            </ItemsPanelTemplate>
        </Setter>

        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ItemSpacing" Value="{atom:OwnerTokenResource SpacingXS}" />
        <Setter Property="LineSpacing" Value="{atom:OwnerTokenResource SpacingXS}" />
    </ControlTheme>
</ResourceDictionary>
