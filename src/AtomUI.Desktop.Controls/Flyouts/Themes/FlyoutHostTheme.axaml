<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:FlyoutHost}" TargetType="atom:FlyoutHost" x:DataType="atom:FlyoutHost">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ClipToBounds="{TemplateBinding ClipToBounds}"/>
            </ControlTemplate>
        </Setter>

        <Setter Property="ShouldUseOverlayPopup" Value="True"/>
        <Setter Property="MarginToAnchor" Value="{atom:FlyoutHostTokenResource MarginToAnchor}"/>
        <Setter Property="MotionDuration" Value="{atom:OwnerTokenResource MotionDurationMid}"/>
        <Setter Property="OpenMotion" Value="{x:Static atom:PopupMotionDefaults.PopoverOpen}" />
        <Setter Property="CloseMotion" Value="{x:Static atom:PopupMotionDefaults.PopoverClose}" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="PopupRootShadow" Value="{atom:FlyoutHostTokenResource PopupRootShadow}"/>
        <Setter Property="OverlayHostShadow" Value="{atom:FlyoutHostTokenResource OverlayHostShadow}"/>
    </ControlTheme>
</ResourceDictionary>
