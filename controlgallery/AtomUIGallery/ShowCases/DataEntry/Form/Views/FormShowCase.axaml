<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Form.FormShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:viewModels="clr-namespace:AtomUIGallery.ShowCases.Form"
             x:DataType="viewModels:FormViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AtomUIGallery/ShowCases/DataEntry/Form/ShowCaseControls/FormThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Form"
                    Category="{gallery:FormShowCaseLangResource ComponentCategory}"
                    Status="{gallery:FormShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:FormShowCaseLangResource PageSubtitle}"
                    Description="{gallery:FormShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="Form"
                    MetadataValueWidth="220" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="viewModels:FormViewModel">
                    <StackPanel Spacing="24">
                        <gallery:SemanticPartPreview Name="FormItemSemanticPreview"
                                                     Title="FormItem"
                                                     SemanticOwner="{Binding #PasswordSemanticItem}"
                                                     SemanticOwnerType="{x:Type atom:FormItem}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:Form Name="SemanticDemoForm"
                                           LabelColInfo="8*"
                                           WrapperColInfo="16*"
                                           MinWidth="480"
                                                       AttachedToVisualTree="HandleSemanticDemoFormAttached">
                                    <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextUsername}"
                                                   FieldName="username"
                                                   IsRequired="True"
                                                   Help="{gallery:FormShowCaseLangResource SemanticHelpUse4To16Characters}">
                                        <atom:LineEdit />
                                    </atom:FormItem>
                                    <atom:FormItem Name="PasswordSemanticItem"
                                                   LabelText="{gallery:FormShowCaseLangResource P2LabelTextPassword}"
                                                   FieldName="password"
                                                   IsRequired="True"
                                                   ValidateStrategy="Sequential"
                                                   Extra="{gallery:FormShowCaseLangResource SemanticExtraPasswordMustContainLettersAndNumbers}">
                                        <atom:FormItem.Validators>
                                            <atom:FormValidatorProvider>
                                                <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourPassword}" />
                                                <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource SemanticMessageUseAtLeast8Characters}" />
                                            </atom:FormValidatorProvider>
                                        </atom:FormItem.Validators>
                                        <atom:LineEdit PasswordChar="*" />
                                    </atom:FormItem>
                                </atom:Form>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:FormShowCaseLangResource SemanticRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="label"
                                    Description="{gallery:FormShowCaseLangResource SemanticLabelDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="content"
                                    Description="{gallery:FormShowCaseLangResource SemanticContentDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="help"
                                    Description="{gallery:FormShowCaseLangResource SemanticHelpDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="helpItem"
                                    Description="{gallery:FormShowCaseLangResource SemanticHelpItemDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="extra"
                                    Description="{gallery:FormShowCaseLangResource SemanticExtraDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource BasicUsageTitle}"
        Description="{gallery:FormShowCaseLangResource BasicUsageDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left"
                   Name="BasicForm"
                   AttachedToVisualTree="HandleBasicFormAttached">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextUsername}"
                           FieldName="username"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourUsername}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextPassword}"
                           FieldName="password"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourPassword}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit RevealPassword="False"
                               PasswordChar="•"
                               IsEnableRevealButton="True" />
            </atom:FormItem>
            <atom:FormItem FieldName="remember">
                <atom:CheckBox Content="{gallery:FormShowCaseLangResource P2ContentRememberMe}" />
            </atom:FormItem>

            <atom:FormActionsItem>
                <atom:SubmitButton />
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource FormMethodsTitle}"
        Description="{gallery:FormShowCaseLangResource FormMethodsDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left">
            <gallery:NoteFormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextNote}"
                                  FieldName="note"
                                  IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseEnterNote}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </gallery:NoteFormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextGender}"
                           FieldName="gender"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormNotNullValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseEnterGender}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:Select IsAllowClear="True"
                             PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextSelectAOptionAndChangeInputTextAbove}"
                             HorizontalAlignment="Stretch"
                             OptionsSource="{Binding GenderOptions}" />
            </atom:FormItem>
            <gallery:CustomizeGenderFormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextCustomizeGender}"
                                             FieldName="customizeGender"
                                             IsRequired="True"
                                             IsVisible="False">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseEnterCustomizeGender}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </gallery:CustomizeGenderFormItem>

            <atom:FormActionsItem>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:SubmitButton />
                    <atom:ResetButton />
                </StackPanel>
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource FormLayoutTitle}"
        Description="{gallery:FormShowCaseLangResource FormLayoutDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:TextBlock VerticalAlignment="Center" Text="{gallery:FormShowCaseLangResource P2TextFormLayout}" />
                <atom:OptionButtonGroup ButtonStyle="Outline" OptionCheckedChanged="HandleFormLayoutOptionCheckedChanged">
                    <atom:OptionButton  Tag="{x:Static atom:FormLayout.Horizontal}" Content="{gallery:FormShowCaseLangResource P2ContentHorizontal}" />
                    <atom:OptionButton Tag="{x:Static atom:FormLayout.Vertical}" Content="{gallery:FormShowCaseLangResource P2ContentVertical}" />
                    <atom:OptionButton IsChecked="True" Tag="{x:Static atom:FormLayout.Inline}" Content="{gallery:FormShowCaseLangResource P2ContentInline}" />
                </atom:OptionButtonGroup>
            </StackPanel>

            <atom:Form LabelColInfo="8*"
                       WrapperColInfo="16*"
                       Name="LayoutCaseForm"
                       AttachedToVisualTree="HandleLayoutCaseFormAttached"
                       DetachedFromVisualTree="HandleLayoutCaseFormDetached"
                       FormLayout="{Binding FormLayout}"
                       HorizontalAlignment="Left"
                       MinWidth="600">
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextFieldA}" FieldName="FieldA">
                    <atom:LineEdit MinWidth="160"/>
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextFieldB}" FieldName="Field B">
                    <atom:LineEdit MinWidth="160"/>
                </atom:FormItem>

                <atom:FormActionsItem>
                    <atom:SubmitButton />
                </atom:FormActionsItem>
            </atom:Form>
        </StackPanel>


            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource FormLayoutTitle}"
        Description="{gallery:FormShowCaseLangResource FormLayoutDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <atom:Form FormLayout="Horizontal">
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextHorizontal}" FieldName="horizontal"
                               LabelColInfo="4*"
                               WrapperColInfo="20*"
                               IsRequired="True"
                               Layout="Horizontal">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:LineEdit/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextVertical}"
                               FieldName="vertical"
                               IsRequired="True"
                               Layout="Vertical">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:LineEdit/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextVertical2}"
                               FieldName="vertical2"
                               IsRequired="True"
                               Layout="Vertical">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:LineEdit/>
                </atom:FormItem>
            </atom:Form>

            <atom:Separator/>

            <atom:Form FormLayout="Vertical">

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextVertical}"
                               FieldName="vertical"
                               IsRequired="True"
                               Layout="Vertical">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:LineEdit/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextVertical2}"
                               FieldName="vertical2"
                               IsRequired="True"
                               Layout="Vertical">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:LineEdit/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextHorizontal}" FieldName="horizontal"
                               LabelColInfo="4*"
                               WrapperColInfo="20*"
                               IsRequired="True"
                               Layout="Horizontal">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:LineEdit/>
                </atom:FormItem>
            </atom:Form>
        </StackPanel>


            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource LabelCanWrapTitle}"
        Description="{gallery:FormShowCaseLangResource LabelCanWrapDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="120"
                   WrapperColInfo="*"
                   MinWidth="600"
                   HorizontalAlignment="Left"
                   LabelAlign="Left"
                   IsShowColon="False"
                   LabelWrapping="Wrap">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextNormalLabel}"
                           FieldName="username"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourUsername}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextASuperLongLabelText}"
                           FieldName="password"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourUsername}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextASuperLongLabelText}"
                           FieldName="password1">
                <atom:LineEdit />
            </atom:FormItem>

            <atom:FormActionsItem>
                <atom:SubmitButton />
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource FormLayoutTitle}"
        Description="{gallery:FormShowCaseLangResource FormLayoutDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <StackPanel Orientation="Vertical" Spacing="5">
            <atom:CheckBox IsChecked="{Binding IsFormDisabled, Mode=TwoWay}" Content="{gallery:FormShowCaseLangResource P2ContentFormDisabled}" />
            <atom:Form LabelColInfo="8*"
                       WrapperColInfo="16*"
                       MinWidth="600"
                       HorizontalAlignment="Left"
                       IsEnabled="{Binding IsFormDisabled, Converter={x:Static BoolConverters.Not}}">
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextCheckbox}" FieldName="checkbox">
                    <atom:CheckBox Content="{gallery:FormShowCaseLangResource P2ContentCheckbox}" />
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextRadio}" FieldName="radio">
                    <atom:RadioButtonGroup>
                        <atom:RadioButton Content="{gallery:FormShowCaseLangResource P2ContentApple}" />
                        <atom:RadioButton Content="{gallery:FormShowCaseLangResource P2ContentPear}" />
                    </atom:RadioButtonGroup>
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextInput}" FieldName="input">
                    <atom:LineEdit/>
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSelect}" FieldName="select">
                    <atom:Select HorizontalAlignment="Stretch"
                                 OptionsSource="{Binding DemoSelectOptions}" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextTreeSelect}" FieldName="treeSelect">
                    <atom:TreeSelect HorizontalAlignment="Stretch"
                                     ItemsSource="{Binding DemoTreeNodes}" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextCascader}" FieldName="cascader">
                    <atom:Cascader HorizontalAlignment="Stretch"
                                   OptionsSource="{Binding DemoCascaderOptions}" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextDatePicker}" FieldName="datePicker">
                    <atom:DatePicker PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextSelectDate}"/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextRangePicker}" FieldName="rangePicker">
                    <atom:RangeDatePicker PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextStartDate}"
                                          SecondaryPlaceholderText="{gallery:FormShowCaseLangResource P2SecondaryPlaceholderTextEndDate}"/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextInputNumber}" FieldName="inputNumber">
                    <atom:NumericUpDown Width="80"/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextTextArea}" FieldName="textArea">
                    <atom:TextArea Lines="4"/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSwitch}" FieldName="switch">
                    <atom:ToggleSwitch/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextUpload}" FieldName="upload">
                    <atom:Upload Name="AvatarDemoPictureCardUpload" ListType="PictureCard">
                        <StackPanel Orientation="Vertical">
                            <Panel>
                                <antdicons:PlusOutlined IsVisible="{Binding IsTaskRunning ,RelativeSource={RelativeSource AncestorType=atom:Upload}, Converter={x:Static BoolConverters.Not}}"
                                                        StrokeBrush="{Binding Foreground ,RelativeSource={RelativeSource AncestorType=atom:Upload}}"/>
                                <antdicons:LoadingOutlined IsVisible="{Binding IsTaskRunning ,RelativeSource={RelativeSource AncestorType=atom:Upload}}"
                                                           StrokeBrush="{Binding Foreground ,RelativeSource={RelativeSource AncestorType=atom:Upload}}"
                                                           LoadingAnimation="Spin"/>
                            </Panel>
                            <TextBlock Margin="0, 8, 0, 0" Text="{gallery:FormShowCaseLangResource P2TextUpload}" />
                        </StackPanel>
                    </atom:Upload>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextButton}" FieldName="button">
                    <atom:Button Content="{gallery:FormShowCaseLangResource P2ContentButton}" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSlider}" FieldName="slider">
                    <atom:Slider/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextColorPicker}" FieldName="colorPicker">
                    <atom:ColorPicker/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextRate}" FieldName="rate">
                    <atom:Rate/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextMentions}" FieldName="mentions">
                    <atom:Mentions DefaultValue="@afc163"/>
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextTree}" FieldName="tree">
                    <atom:TreeView>
                        <atom:TreeViewItem Header="{gallery:FormShowCaseLangResource P2HeaderParentN1}" ItemKey="0-0">
                            <atom:TreeViewItem Header="{gallery:FormShowCaseLangResource P2HeaderChildN1N1}" ItemKey="0-0-0">
                                <atom:TreeViewItem Header="{gallery:FormShowCaseLangResource P2HeaderGrandchildN1N1N1}" ItemKey="0-0-0-0"/>
                            </atom:TreeViewItem>
                            <atom:TreeViewItem Header="{gallery:FormShowCaseLangResource P2HeaderChildN1N2}" ItemKey="0-0-1"/>
                        </atom:TreeViewItem>
                        <atom:TreeViewItem Header="{gallery:FormShowCaseLangResource P2HeaderParentN2}" ItemKey="0-1">
                            <atom:TreeViewItem Header="{gallery:FormShowCaseLangResource P2HeaderChildN2N1}" ItemKey="0-1-0"/>
                        </atom:TreeViewItem>
                    </atom:TreeView>
                </atom:FormItem>
            </atom:Form>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource FormVariantsTitle}"
        Description="{gallery:FormShowCaseLangResource FormVariantsDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:TextBlock VerticalAlignment="Center" Text="{gallery:FormShowCaseLangResource P2TextFormVariant}" />
                <atom:Segmented SelectionChanged="HandleFormStyleVariantChanged">
                    <atom:SegmentedItem IsSelected="True" Tag="{x:Static atom:InputControlStyleVariant.Outlined}" Content="{gallery:FormShowCaseLangResource P2ContentOutlined}" />
                    <atom:SegmentedItem Tag="{x:Static atom:InputControlStyleVariant.Filled}" Content="{gallery:FormShowCaseLangResource P2ContentFilled}" />
                    <atom:SegmentedItem Tag="{x:Static atom:InputControlStyleVariant.Borderless}" Content="{gallery:FormShowCaseLangResource P2ContentBorderless}" />
                    <atom:SegmentedItem Tag="{x:Static atom:InputControlStyleVariant.Underlined}" Content="{gallery:FormShowCaseLangResource P2ContentUnderlined}" />
                </atom:Segmented>
            </StackPanel>

            <atom:Form LabelColInfo="8*"
                       WrapperColInfo="16*"
                       MinWidth="600"
                       HorizontalAlignment="Left"
                       StyleVariant="{Binding FormStyleVariant}">
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextInput}"
                               FieldName="input"
                               IsRequired="True">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:LineEdit />
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextInputNumber}"
                               FieldName="inputNumber"
                               IsRequired="True">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:NumericUpDown Width="200" />
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextTextArea}"
                               FieldName="textArea"
                               IsRequired="True">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:TextArea Lines="4" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextMentions}"
                               FieldName="mentions"
                               IsRequired="True">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:Mentions />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSelect}"
                               FieldName="select"
                               IsRequired="True">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:Select HorizontalAlignment="Stretch" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextCascader}"
                               FieldName="cascader"
                               IsRequired="True">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:Cascader HorizontalAlignment="Stretch" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextTreeSelect}"
                               FieldName="treeSelect"
                               IsRequired="True">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:TreeSelect HorizontalAlignment="Stretch" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextDatePicker}"
                               FieldName="datePicker"
                               IsRequired="True">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:DatePicker PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextRangePicker}"
                               FieldName="rangePicker"
                               IsRequired="True">
                    <atom:FormItem.Validators>
                        <atom:FormValidatorProvider>
                            <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInput}" />
                        </atom:FormValidatorProvider>
                    </atom:FormItem.Validators>
                    <atom:RangeDatePicker PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextStartDate}"
                                          SecondaryPlaceholderText="{gallery:FormShowCaseLangResource P2SecondaryPlaceholderTextEndDate}" />
                </atom:FormItem>

                <atom:FormActionsItem>
                    <atom:SubmitButton />
                </atom:FormActionsItem>
            </atom:Form>
        </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource RequiredStyleTitle}"
        Description="{gallery:FormShowCaseLangResource RequiredStyleDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:TextBlock VerticalAlignment="Center" Text="{gallery:FormShowCaseLangResource P2TextRequiredMark}" />
                <atom:OptionButtonGroup ButtonStyle="Outline" OptionCheckedChanged="HandleFormRequiredMarkChanged">
                    <atom:OptionButton IsChecked="True" Tag="{x:Static atom:FormRequiredMark.Default}" Content="{gallery:FormShowCaseLangResource P2ContentDefault}" />
                    <atom:OptionButton Tag="{x:Static atom:FormRequiredMark.Optional}" Content="{gallery:FormShowCaseLangResource P2ContentOptional}" />
                    <atom:OptionButton Tag="{x:Static atom:FormRequiredMark.Hidden}" Content="{gallery:FormShowCaseLangResource P2ContentHidden}" />
                    <atom:OptionButton Tag="{x:Static atom:FormRequiredMark.Customize}" Content="{gallery:FormShowCaseLangResource P2ContentCustomize}" />
                </atom:OptionButtonGroup>
            </StackPanel>

            <atom:Form LabelColInfo="8*"
                       WrapperColInfo="16*"
                       HorizontalAlignment="Left"
                       MinWidth="600"
                       FormLayout="Horizontal"
                       RequiredMark="{Binding FormRequiredMark}">
                <atom:Form.CustomRequireMark>
                    <atom:Tag TagColor="Error" Text="{gallery:FormShowCaseLangResource P2ContentRequired}" />
                </atom:Form.CustomRequireMark>
                <atom:Form.CustomOptionalMark>
                    <atom:Tag TagColor="Warning" Text="{gallery:FormShowCaseLangResource P2ContentOptional2}" />
                </atom:Form.CustomOptionalMark>
                <atom:FormItem IsRequired="True" LabelText="{gallery:FormShowCaseLangResource P2LabelTextFieldA}" FieldName="FieldA" Tooltip="{gallery:FormShowCaseLangResource P2TooltipThisIsARequiredField}">
                    <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextInputPlaceholder}"/>
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextFieldB}" FieldName="Field B" Tooltip="{gallery:FormShowCaseLangResource P2TooltipTooltipWithCustomizeIcon}"
                               TooltipIcon="{antdicons:AntDesignIconProvider InfoCircleOutlined}">
                    <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextInputPlaceholder}"/>
                </atom:FormItem>
                <atom:FormActionsItem>
                    <atom:SubmitButton/>
                </atom:FormActionsItem>
            </atom:Form>
        </StackPanel>


            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource RequiredStyleTitle}"
        Description="{gallery:FormShowCaseLangResource RequiredStyleDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:TextBlock VerticalAlignment="Center" Text="{gallery:FormShowCaseLangResource P2TextRequiredMark}" />
                <atom:OptionButtonGroup ButtonStyle="Outline" OptionCheckedChanged="HandleFormSizeTypeChanged">
                    <atom:OptionButton Tag="{x:Static atom:CustomizableSizeType.Small}" Content="{gallery:FormShowCaseLangResource P2ContentSmall}" />
                    <atom:OptionButton Tag="{x:Static atom:CustomizableSizeType.Middle}" IsChecked="True" Content="{gallery:FormShowCaseLangResource P2ContentMiddle}" />
                    <atom:OptionButton Tag="{x:Static atom:CustomizableSizeType.Large}" Content="{gallery:FormShowCaseLangResource P2ContentLarge}" />
                </atom:OptionButtonGroup>
            </StackPanel>

            <atom:Form LabelColInfo="8*"
                       WrapperColInfo="16*"
                       MinWidth="600"
                       HorizontalAlignment="Left"
                       SizeType="{Binding FormSizeType}">
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextInput}"
                               FieldName="input">
                    <atom:LineEdit />
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextInputNumber}"
                               FieldName="inputNumber">
                    <atom:NumericUpDown Width="200" />
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSwitch}"
                               FieldName="switch">
                    <atom:ToggleSwitch />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextMentions}"
                               FieldName="mentions">
                    <atom:Mentions />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSelect}"
                               FieldName="select">
                    <atom:Select HorizontalAlignment="Stretch"
                                 Mode="Multiple"
                                 OptionsSource="{Binding RequiredStyleSelectOptions}" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextCascader}"
                               FieldName="cascader">
                    <atom:Cascader HorizontalAlignment="Stretch" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextTreeSelect}"
                               FieldName="treeSelect">
                    <atom:TreeSelect HorizontalAlignment="Stretch" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextDatePicker}"
                               FieldName="datePicker">
                    <atom:DatePicker PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                </atom:FormItem>

                <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextRangePicker}"
                               FieldName="rangePicker">
                    <atom:RangeDatePicker PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextStartDate}"
                                          SecondaryPlaceholderText="{gallery:FormShowCaseLangResource P2SecondaryPlaceholderTextEndDate}" />
                </atom:FormItem>

                <atom:FormActionsItem>
                    <atom:SubmitButton />
                </atom:FormActionsItem>
            </atom:Form>
        </StackPanel>


            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource NoBlockRuleTitle}"
        Description="{gallery:FormShowCaseLangResource NoBlockRuleDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left"
                   Name="NoBlockRuleForm"
                   Submitted="HandleNoBlockFormSubmitted"
                   Validated="HandleNoBlockFormValidated">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextUrl}"
                           FieldName="url"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseEnterURL}" />
                        <atom:FormUrlValidator Message="{gallery:FormShowCaseLangResource P2MessageURLIsNotAValidUrl}" WarningOnly="True" />
                        <atom:FormStringLengthValidator Message="{gallery:FormShowCaseLangResource P2MessageURLMustBeAtLeastN6Characters}"
                                                        MinimumLength="6"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>

            <atom:FormActionsItem>
               <StackPanel Orientation="Horizontal" Spacing="10">
                   <atom:SubmitButton />
                   <atom:Button ButtonType="Default" Click="HandleFillClicked" Content="{gallery:FormShowCaseLangResource P2ContentFill}" />
               </StackPanel>
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource ValidateTriggerTitle}"
        Description="{gallery:FormShowCaseLangResource ValidateTriggerDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left"
                   IsValidateFeedbackEnabled="True">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextFieldA}"
                           FieldName="fieldA"
                           ValidateTrigger="OnBlur">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringLengthValidator Message="{gallery:FormShowCaseLangResource P2MessageFieldAMustBeUpToN3Characters}"
                                                        MaximumLength="3"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextValidateRequiredOnblur}"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextFieldB}"
                           FieldName="fieldB"
                           ValidateDebounce="00:00:01">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringLengthValidator Message="{gallery:FormShowCaseLangResource P2MessageFieldAMustBeUpToN3Characters}"
                                                        MaximumLength="3"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextValidateRequiredDebounceAfterN1s}"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextFieldC}"
                           FieldName="fieldC"
                           ValidateStrategy="StopWhenFirstFailed">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringLengthValidator Message="{gallery:FormShowCaseLangResource P2MessageFieldAMustBeUpToN6Characters}"
                                                        MaximumLength="6"/>
                        <atom:FormStringLengthValidator Message="{gallery:FormShowCaseLangResource P2MessageContinueInputToExceedN6Chars}"
                                                        MaximumLength="3"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextValidateOneByOne}"/>
            </atom:FormItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource ValidateOnlyTitle}"
        Description="{gallery:FormShowCaseLangResource ValidateOnlyDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left"
                   FormLayout="Vertical">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextName}"
                           FieldName="name"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseEnterName}"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextAge}"
                           FieldName="age"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseEnterAge}"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>

            <atom:FormActionsItem>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:SubmitButton IsWatchValidateResult="True"/>
                    <atom:ResetButton />
                </StackPanel>
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
