    <unit id="PageDescription">
      <segment>
        <source>TabControl and CardTabControl provide document-style navigation, item-template tabs, closable tabs, flexible placement, and optional tab bar actions.</source>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Organize related content into switchable tab panes.</source>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
      </segment>
    </unit>
    <unit id="SemanticAddDescription">
      <segment>
        <source>Add element, set size, color and corner radius styles for the plus button</source>
      </segment>
    </unit>
    <unit id="SemanticCloseDescription">
      <segment>
        <source>Close element, set size and color styles for the close button</source>
      </segment>
    </unit>
    <unit id="SemanticContentDescription">
      <segment>
        <source>Content element, set padding, background and alignment styles for the content panel</source>
      </segment>
    </unit>
    <unit id="SemanticHeaderDescription">
      <segment>
        <source>Header container, set background, padding and alignment styles for the tab strip region</source>
      </segment>
    </unit>
    <unit id="SemanticIconDescription">
      <segment>
        <source>Icon element, set size and margin styles for the tab icon</source>
      </segment>
    </unit>
    <unit id="SemanticIndicatorDescription">
      <segment>
        <source>Indicator element, set color styles for the selected tab ink bar</source>
      </segment>
    </unit>
    <unit id="SemanticItemDescription">
      <segment>
        <source>Item element, set size, padding, hover state and selected state styles for each tab</source>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Style the root frame, header and content panel through generated Semantic Part styles and root visual properties: dashed frame, header background, bold primary tab labels, item padding, content padding and background. The active ink bar color and thickness are customized through the InkBarColor and InkBarThickness tokens.</source>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>Root element, set overall size, padding, border and background styles</source>
      </segment>
    </unit>
