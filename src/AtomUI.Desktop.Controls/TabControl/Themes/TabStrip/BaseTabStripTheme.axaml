<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.BaseTabStripTheme"
              TargetType="atom:BaseTabStrip"
              x:ClassModifier="internal">
    <Setter Property="FontFamily">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
            <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontFamily" />
        </MultiBinding>
    </Setter>

    <Setter Property="FontSize">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
            <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontSize" />
        </MultiBinding>
    </Setter>

    <Setter Property="Template">
        <ControlTemplate TargetType="atom:BaseTabStrip">
            <Border Name="Frame"/>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|BaseTabStrip)">
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource Kind=ColorBorderSecondary}"/>
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource Kind=BorderThickness}"/>
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}"/>

        <!-- 设置 items presenter 面板样式 -->
        <!-- 分为上、右、下、左 -->
        <Style Selector="^[TabStripPlacement=Top]">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style Selector="^[TabStripPlacement=Right]">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="^[TabStripPlacement=Bottom]">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style Selector="^[TabStripPlacement=Left]">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

    </Style>
</ControlTheme>
