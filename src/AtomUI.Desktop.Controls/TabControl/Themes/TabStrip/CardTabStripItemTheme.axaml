<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="CardTabStripItemTheme" TargetType="atom:TabStripItem">
        <ControlTheme.BasedOn>
            <themes:BaseTabStripItemTheme TargetType="atom:TabStripItem" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         Background="{TemplateBinding Background}"
                                         Padding="{TemplateBinding Padding}"
                                         Margin="{TemplateBinding Margin}">
                    <StackPanel Name="ContentLayout" Orientation="Horizontal">
                        <atom:IconPresenter Name="ItemIconPresenter"
                                            Classes.semantic-icon="True"
                                            Icon="{TemplateBinding Icon}" />
                        <ContentPresenter Name="ContentPresenter"
                                          Classes.semantic-label="True"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate, Converter={x:Static atom:BaseTabStripItemTheme.StringToTextBlockConverter}}" />
                        <atom:IconButton Name="PART_ItemCloseButton"
                                         Classes.semantic-close="True"
                                         Icon="{TemplateBinding CloseIcon}"
                                         Opacity="{TemplateBinding CloseButtonOpacity}"
                                         VerticalAlignment="Center" />
                    </StackPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="Margin" Value="{atom:TabControlTokenResource HorizontalItemMargin}" />
        <Setter Property="Background" Value="{atom:TabControlTokenResource CardBg}" />
        <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />

        <Style Selector="^:selected">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
        </Style>

        <Style Selector="^[IsTabReorderDragging=True]">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
        </Style>

        <Style Selector="^[TabStripPlacement=Top], ^[TabStripPlacement=Bottom]">
            <Setter Property="Margin" Value="{atom:TabControlTokenResource HorizontalItemMargin}" />
            <Style Selector="^[SizeType=Large]">
                <Setter Property="Padding" Value="{atom:TabControlTokenResource CardPaddingLG}" />
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Setter Property="Padding" Value="{atom:TabControlTokenResource CardPadding}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Padding" Value="{atom:TabControlTokenResource CardPaddingSM}" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Left], ^[TabStripPlacement=Right]">
            <Style Selector="^[SizeType=Large]">
                <Setter Property="Padding"
                        Value="{atom:TabControlTokenResource VerticalItemPadding}" />
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Setter Property="Padding"
                        Value="{atom:TabControlTokenResource VerticalItemPadding}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Padding"
                        Value="{atom:TabControlTokenResource VerticalItemPadding}" />
            </Style>
        </Style>

        <!-- 设置 items presenter 面板样式 -->
        <!-- 分为上、右、下、左 -->
        <Style Selector="^[TabStripPlacement=Top]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Right]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Bottom]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Left]">
            <Style Selector="^ /template/ atom|IconPresenter#ItemIconPresenter">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorBgContainerDisabled}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
