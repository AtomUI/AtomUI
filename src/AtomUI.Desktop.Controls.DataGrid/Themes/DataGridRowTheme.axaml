<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal"
    xmlns:atom="https://atomui.net">
    <ControlTheme x:Key="{x:Type atom:DataGridRow}" TargetType="atom:DataGridRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="{x:Static atom:DataGridRowThemeConstants.FramePart}"
                        Background="{TemplateBinding Background}">
                    <atom:DataGridFrozenGrid Name="{x:Static atom:DataGridRowThemeConstants.RootLayoutPart}"
                                             RowDefinitions="*, Auto, Auto"
                                             ColumnDefinitions="Auto, *">
                        <Border
                            Name="RowCellsFrame"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="2"
                            Grid.ColumnSpan="2" />
                        <Rectangle
                            Name="InvalidVisualElement"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Opacity="0" />
                        <atom:DataGridRowHeader
                            Name="{x:Static atom:DataGridRowThemeConstants.RowHeaderPart}"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="3"
                            atom:DataGridFrozenGrid.IsFrozen="True" 
                            Background="{TemplateBinding Background}"
                            SizeType="{TemplateBinding SizeType}"
                            />
                        <atom:DataGridCellsPresenter
                            Name="{x:Static atom:DataGridRowThemeConstants.CellsPresenterPart}"
                            Grid.Row="0"
                            Grid.Column="1"
                            atom:DataGridFrozenGrid.IsFrozen="True" />
                        <Border
                            Name="DetailsPresenterFrame"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsVisible="{TemplateBinding IsDetailsVisible}">
                            <atom:DataGridDetailsPresenter
                                Name="{x:Static atom:DataGridRowThemeConstants.DetailsPresenterPart}" />
                        </Border>
                        <Rectangle
                            Name="{x:Static atom:DataGridRowThemeConstants.BottomGridLinePart}"
                            HorizontalAlignment="Stretch"
                            Grid.Row="2"
                            Grid.Column="1" />
                        <Rectangle
                            Name="{x:Static atom:DataGridRowThemeConstants.DropBeforeIndicatorPart}"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            IsVisible="False" />
                        <Rectangle
                            Name="{x:Static atom:DataGridRowThemeConstants.DropAfterIndicatorPart}"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            IsVisible="False" />
                    </atom:DataGridFrozenGrid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Focusable" Value="False" />
        <Style Selector="^ /template/ Rectangle#PART_BottomGridLine">
            <Setter Property="Fill" Value="{atom:DataGridTokenResource TableBorderColor}" />
        </Style>

        <Style Selector="^ /template/ Rectangle#PART_DropBeforeIndicator, ^ /template/ Rectangle#PART_DropAfterIndicator">
            <Setter Property="Fill" Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="Height" Value="2" />
        </Style>
        <Style Selector="^[DropPosition=Before] /template/ Rectangle#PART_DropBeforeIndicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[DropPosition=After] /template/ Rectangle#PART_DropAfterIndicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        
        <Style Selector="^[IsDragging=True]">
            <Setter Property="ZIndex" Value="1000" />
            <Setter Property="Background"
                    Value="{atom:DataGridTokenResource TableRowHoverBg}" />
        </Style>
        
        <Style Selector="^[IsDragging=False]">
            <Setter Property="Background" Value="{atom:DataGridTokenResource TableBg}" />

            <Style Selector="^[IsMotionEnabled=True]">
                <Setter Property="Transitions">
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="^[IsSelected=True]">
                <Setter Property="Background"
                        Value="{atom:DataGridTokenResource TableSelectedRowBg}" />
                <Style Selector="^:row-hover">
                    <Setter Property="Background"
                            Value="{atom:DataGridTokenResource TableSelectedRowHoverBg}" />
                </Style>
            </Style>
            <Style Selector="^[IsSelected=False]">
                <Setter Property="Background" Value="{atom:DataGridTokenResource TableBg}" />
                <Style Selector="^:row-hover">
                    <Setter Property="Background"
                            Value="{atom:DataGridTokenResource TableRowHoverBg}" />
                </Style>
            </Style>

            <Style Selector="^[DropPosition=Before], ^[DropPosition=After]">
                <Setter Property="Background"
                        Value="{atom:DataGridTokenResource TableSelectedRowBg}" />
            </Style>
        </Style>
        
        <Style Selector="^ /template/ Border#DetailsPresenterFrame">
            <Setter Property="Background" Value="{atom:DataGridTokenResource TableExpandedRowBg}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ Border#DetailsPresenterFrame">
                <Setter Property="Padding" Value="{atom:DataGridTokenResource TablePadding}" />
                <Setter Property="TextElement.FontSize"
                        Value="{atom:DataGridTokenResource TableFontSize}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style Selector="^ /template/ Border#DetailsPresenterFrame">
                <Setter Property="Padding"
                        Value="{atom:DataGridTokenResource TablePaddingMiddle}" />
                <Setter Property="TextElement.FontSize"
                        Value="{atom:DataGridTokenResource TableFontSizeMiddle}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ Border#DetailsPresenterFrame">
                <Setter Property="Padding" Value="{atom:DataGridTokenResource TablePaddingSmall}" />
                <Setter Property="TextElement.FontSize"
                        Value="{atom:DataGridTokenResource TableFontSizeSmall}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
