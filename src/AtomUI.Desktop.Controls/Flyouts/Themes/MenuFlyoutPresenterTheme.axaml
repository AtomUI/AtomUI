<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.MenuFlyoutPresenterTheme"
              TargetType="atom:MenuFlyoutPresenter"
              x:ClassModifier="internal">
        <Setter Property="atom:MenuPopupScrollHost.PopupContentPadding" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupContentPadding}" />
        <Setter Property="atom:MenuPopupScrollHost.PopupMinWidth" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupMinWidth}" />
        <Setter Property="atom:MenuPopupScrollHost.PopupMaxWidth" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupMaxWidth}" />
        <Setter Property="atom:MenuPopupScrollHost.PopupBackground" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupBgColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemForeground" Value="{atom:MenuFlyoutPresenterTokenResource ItemColor}" />
        <Setter Property="atom:MenuPopupScrollHost.KeyGestureForeground" Value="{atom:MenuFlyoutPresenterTokenResource KeyGestureColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemMargin" Value="{atom:MenuFlyoutPresenterTokenResource ItemMargin}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemHoverForeground" Value="{atom:MenuFlyoutPresenterTokenResource ItemHoverColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemDisabledForeground" Value="{atom:MenuFlyoutPresenterTokenResource ItemDisabledColor}" />
        <Setter Property="atom:MenuPopupScrollHost.DangerItemForeground" Value="{atom:MenuFlyoutPresenterTokenResource DangerItemColor}" />
        <Setter Property="atom:MenuPopupScrollHost.DangerItemHoverForeground" Value="{atom:MenuFlyoutPresenterTokenResource DangerItemHoverColor}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemBackground" Value="{atom:MenuFlyoutPresenterTokenResource ItemBg}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemHoverBackground" Value="{atom:MenuFlyoutPresenterTokenResource ItemHoverBg}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemHeight" Value="{atom:MenuFlyoutPresenterTokenResource ItemHeight}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemIconSize" Value="{atom:MenuFlyoutPresenterTokenResource ItemIconSize}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemIconEndMargin" Value="{atom:MenuFlyoutPresenterTokenResource ItemIconMarginInlineEnd}" />
        <Setter Property="atom:MenuPopupScrollHost.GroupTitlePadding" Value="{atom:MenuFlyoutPresenterTokenResource GroupTitlePadding}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemCornerRadius" Value="{atom:MenuFlyoutPresenterTokenResource ItemBorderRadius}" />
        <Setter Property="atom:MenuPopupScrollHost.ItemInlinePadding" Value="{atom:MenuFlyoutPresenterTokenResource ItemPaddingInline}" />
        <Setter Property="atom:MenuPopupScrollHost.SeparatorItemHeight" Value="{atom:MenuFlyoutPresenterTokenResource SeparatorItemHeight}" />
        <Setter Property="atom:MenuPopupScrollHost.PopupShadows" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupShadows}" />

    <Setter Property="Template">
        <ControlTemplate TargetType="atom:MenuFlyoutPresenter">
            <atom:ArrowDecoratedBox Name="{x:Static atom:AbstractArrowDecoratedBox.ArrowDecoratorPart}"
                                    IsArrowVisible="{TemplateBinding IsArrowVisible}"
                                    ArrowPosition="{TemplateBinding ArrowPosition}"
                                    Padding="{TemplateBinding Padding}"
                                    MaxHeight="{TemplateBinding MaxPopupHeight}">
                <atom:MenuPopupScrollHost IsScrollEnabled="{TemplateBinding IsScrollEnabled}"
                                          IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                          atom:ScrollViewer.IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                          AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    Grid.IsSharedSizeScope="True" />
                </atom:MenuPopupScrollHost>
            </atom:ArrowDecoratedBox>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|MenuFlyoutPresenter)">
        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="Background" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupBackground)}" />
        <Setter Property="CornerRadius" Value="{atom:PopupTokenResource PopupCornerRadius}" />
        <Setter Property="IsMotionEnabled" Value="{atom:MenuFlyoutPresenterTokenResource EnableMotion}" />
        <Setter Property="Padding" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupContentPadding)}" />
        <Setter Property="ItemHeight" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.ItemHeight)}" />

        <Style Selector="^ /template/ atom|ArrowDecoratedBox#PART_ArrowDecorator">
            <Setter Property="Background" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupBackground)}" />
            <Setter Property="BorderBrush" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupBorderColor}" />
            <Setter Property="BorderThickness" Value="{atom:MenuFlyoutPresenterTokenResource MenuPopupBorderThickness}" />
            <Setter Property="MinWidth" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupMinWidth)}" />
            <Setter Property="MaxWidth" Value="{CompiledBinding $self.(atom:MenuPopupScrollHost.PopupMaxWidth)}" />
        </Style>
    </Style>

</ControlTheme>
