<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    
    <ControlTheme x:Key="{x:Type atom:SkeletonLine}" TargetType="atom:SkeletonLine">
        <ControlTheme.BasedOn>
            <themes:AbstractSkeletonTheme TargetType="atom:SkeletonLine" />
        </ControlTheme.BasedOn>
        
        <Setter Property="Height">
            <MultiBinding Converter="{x:Static themes:AbstractSkeletonTheme.LineHeight}">
                <CompiledBindingExtension Path="$self" DataType="{x:Type atom:SkeletonLine}" />
                <atom:SkeletonTokenResource Kind="TitleHeight" />
                <atom:SkeletonTokenResource Kind="ParagraphLineHeight" />
            </MultiBinding>
        </Setter>

        <Style Selector="^[IsRound=True]">
            <Setter Property="CornerRadius" Value="{atom:SkeletonTokenResource ParagraphLineRoundCornerRadius}"/>
        </Style>
        
        <Style Selector="^[IsRound=False]">
            <Setter Property="CornerRadius" Value="{atom:SkeletonTokenResource BlockRadius}"/>
        </Style>
        
    </ControlTheme>
</ResourceDictionary>