<!-- owner: global Tokens are read from the owner because this theme is also the base of SkeletonNode (its own
     identity). On a SkeletonImage the owner is the SkeletonImage. -->
<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:Class="AtomUI.Desktop.Controls.Themes.SkeletonImageTheme"
    TargetType="atom:SkeletonImage"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes" 
    x:ClassModifier="internal">
    
    <ControlTheme.BasedOn>
        <themes:AbstractSkeletonTheme TargetType="atom:SkeletonImage" />
    </ControlTheme.BasedOn>
    
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:AbstractSkeleton">
            <Panel Name="PART_RootLayout">
                <Panel Name="PART_ContentLayout"
                       Width="{TemplateBinding Height}"
                       Height="{TemplateBinding Height}"
                       HorizontalAlignment="Left">
                    <Border Name="PART_ContentLayer"
                            Classes.semantic-content="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            atom:AbstractSkeleton.IsShimmerBlock="True" />
                    <antdicons:ImageFilled Name="Image"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FillBrush="{atom:SkeletonTokenResource ImageColor}" />
                </Panel>
            </Panel>
        </ControlTemplate>
    </Setter>
    
    <Style Selector="^:is(atom|SkeletonImage)">
        <Setter Property="Height" Value="{atom:SkeletonTokenResource ImageContainerSize}" />
        <Setter Property="Width" Value="{atom:SkeletonTokenResource ImageContainerSize}" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
        <Setter Property="MaxWidth" Value="{atom:SkeletonTokenResource ImageContainerMaxSize}" />
        <Setter Property="MaxHeight" Value="{atom:SkeletonTokenResource ImageContainerMaxSize}" />
    
        <Style Selector="^ /template/ atom|Icon#Image">
            <Setter Property="Width" Value="{atom:SkeletonTokenResource ImageSize}" />
            <Setter Property="Height" Value="{atom:SkeletonTokenResource ImageSize}" />
        </Style>

    </Style>
</ControlTheme>
