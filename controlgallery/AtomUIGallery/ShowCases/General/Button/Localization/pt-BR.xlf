    <unit id="SemanticPartIconDescription">
      <segment>
        <source>The icon region presents the leading or trailing icon and its loading replacement.</source>
        <target state="translated">A região do ícone apresenta o ícone inicial ou final e seu substituto durante o carregamento.</target>
      </segment>
    </unit>
    <unit id="SemanticPartRootDescription">
      <segment>
        <source>The Button root owns interaction states, background, border, and overall layout.</source>
        <target state="translated">A raiz do Button contém os estados de interação, o fundo, a borda e o layout geral.</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Use owner-scoped selectors and Button state selectors to customize published Semantic Parts.</source>
        <target state="translated">Use seletores com escopo do proprietário e seletores de estado do Button para personalizar as Semantic Parts publicadas.</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
