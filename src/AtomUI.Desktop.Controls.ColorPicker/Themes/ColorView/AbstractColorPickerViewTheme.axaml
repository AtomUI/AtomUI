<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:Class="AtomUI.Desktop.Controls.Themes.AbstractColorPickerViewTheme"
    TargetType="atom:AbstractColorPickerView"
    x:ClassModifier="internal">

    <Style Selector="^:is(atom|AbstractColorPickerView)">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="Padding" Value="{atom:OwnerTokenResource PaddingXXS}" />
        <Style Selector="^ /template/ atom|GradientColorSlider#PART_GradientColorSlider">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^ /template/ atom|ColorSpectrum#ColorSpectrum">
            <Setter Property="MinHeight"
                    Value="{atom:ColorPickerTokenResource ColorSpectrumHeight}" />
            <Setter Property="MinWidth" Value="{atom:ColorPickerTokenResource ColorPickerWidth}" />
        </Style>

        <Style Selector="^ /template/ atom|ColorBlock#ColorPreview">
            <Setter Property="Size"
                    Value="{atom:ColorPickerTokenResource ColorPickerPreviewSize}" />
        </Style>

        <Style Selector="^ /template/ StackPanel#ColorPickerContainer">
            <Setter Property="Spacing" Value="{atom:OwnerTokenResource SpacingSM}" />
        </Style>

        <Style Selector="^ /template/ Panel#SliderContainer">
            <Setter Property="Margin"
                    Value="{atom:ColorPickerTokenResource SliderContainerMargin}" />
        </Style>

        <Style Selector="^[IsAlphaEffectiveVisible=False]">
            <Style Selector="^ /template/ atom|ColorSlider#ColorSpectrumThirdComponentSlider">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>
        
        <Style Selector="^ /template/ atom|PixelAlignedBorder#Separator">
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorderSecondary}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
        </Style>
        
        <Style Selector="^ /template/ StackPanel#PART_LayoutRoot">
            <Setter Property="Spacing" Value="{atom:OwnerTokenResource SpacingXS}"/>
        </Style>
    </Style>
</ControlTheme>
