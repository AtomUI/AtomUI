    <unit id="PageDescription">
      <segment>
        <source>Expander reveals content on demand without leaving the current context. It supports multiple expansion directions, size variants, icon placement, icon-only triggers, nested panels, ghost style, and custom spacing.</source>
        <target state="translated">Expander 用於在當前上下文中按需展開內容。它支持多種展開方向、尺寸、圖標位置、僅圖標觸發、嵌套面板、幽靈樣式和自定義間距。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Show or hide a single section of supporting content.</source>
        <target state="translated">展示或隱藏一段可折疊的輔助內容。</target>
      </segment>
    </unit>
