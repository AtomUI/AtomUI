<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Separator}" TargetType="atom:Separator">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atomc:SeparatorRail Name="PART_RailStart"
                                         Classes.semantic-rail="True"
                                         LineColor="{TemplateBinding LineColor}"
                                         LineWidth="{TemplateBinding LineWidth}"
                                         Variant="{TemplateBinding Variant}"
                                         Orientation="{TemplateBinding Orientation}" />
                    <atom:TextBlock Name="PART_Title"
                           Classes.semantic-content="True"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Padding="0"
                           Text="{TemplateBinding Title}"
                           FontSize="{TemplateBinding FontSize}"
                           Foreground="{TemplateBinding TitleColor}"
                           IsVisible="{TemplateBinding Title, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <atomc:SeparatorRail Name="PART_RailEnd"
                                         Classes.semantic-rail="True"
                                         LineColor="{TemplateBinding LineColor}"
                                         LineWidth="{TemplateBinding LineWidth}"
                                         Variant="{TemplateBinding Variant}"
                                         Orientation="{TemplateBinding Orientation}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="TitleColor" Value="{atom:SeparatorTokenResource ColorTextHeading}" />
        <Setter Property="LineColor" Value="{atom:SeparatorTokenResource ColorSplit}" />
        
        <Setter Property="UseSeparatorLayoutTokenResources" Value="True" />
        <Setter Property="LineWidth" Value="{atom:SeparatorTokenResource LineWidth}" />
        
        <Style Selector="^[IsPlain=True]">
            <Style Selector="^ /template/ atom|TextBlock#PART_Title">
                <Setter Property="FontSize" Value="{atom:SeparatorTokenResource FontSize}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
        </Style>
        <Style Selector="^[IsPlain=False]">
            <Style Selector="^ /template/ atom|TextBlock#PART_Title">
                <Setter Property="FontSize" Value="{atom:SeparatorTokenResource FontSizeLG}" />
                <Setter Property="FontWeight" Value="{atom:SeparatorTokenResource TitleFontWeight}" />
            </Style>
        </Style>

        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{atom:SeparatorTokenResource HorizontalMarginBlock}" />
            <Style Selector="^ /template/ atom|TextBlock#PART_Title">
                <Setter Property="IsVisible" Value="True" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Margin" Value="{atom:SeparatorTokenResource HorizontalMarginBlockSM}"/>
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Setter Property="Margin" Value="{atom:SeparatorTokenResource HorizontalMarginBlock}"/>
            </Style>

            <!-- antd has only the md / sm size classes; an unsized divider (AtomUI Large: marginLG) with text uses the
                 with-text gutter margin, while the md / sm size margins (AtomUI Middle / Small) win over it. -->
            <Style Selector="^[SizeType=Large]">
                <Setter Property="Margin" Value="{atom:SeparatorTokenResource HorizontalMarginBlockLG}"/>
                <Style Selector="^:has-title">
                    <Setter Property="Margin" Value="{atom:SeparatorTokenResource HorizontalWithTextGutterMargin}"/>
                </Style>
            </Style>
        </Style>
        
        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style Selector="^ /template/ atom|TextBlock#PART_Title">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            
        </Style>
        
    </ControlTheme>
</ResourceDictionary>
