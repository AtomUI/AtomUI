<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.DataGrid.DataGridShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.DataGrid"
             x:DataType="vm:DataGridViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="DataGrid"
                    Category="{gallery:DataGridShowCaseLangResource ComponentCategory}"
                    Status="{gallery:DataGridShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:DataGridShowCaseLangResource PageSubtitle}"
                    Description="{gallery:DataGridShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls.DataGrid"
                    BaseClass="TemplatedControl"
                    MetadataValueWidth="260" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:DataGridBaseInfo">
                    <gallery:SemanticPartPreview Name="DataGridSemanticPreview"
                                                 SemanticOwner="{Binding #SemanticCaseGrid}"
                                                 SemanticOwnerType="{x:Type atom:DataGrid}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <!-- 对齐上游 style-class 演示:4 个纯文本列,Small 尺寸,pageSize 3。
                                 不设固定 Height:预览画布高度被宿主钳制在视口剩余空间内,
                                 固定高度的内容会被裁剪,自然高度随画布收缩。 -->
                            <atom:DataGrid x:Name="SemanticCaseGrid"
                                           x:DataType="vm:ExpandableRowDataType"
                                           SizeType="Small"
                                           PageSize="3"
                                           IsHideOnSinglePage="True"
                                           Title="{gallery:DataGridShowCaseLangResource SemanticPreviewTitleText}"
                                           Footer="{gallery:DataGridShowCaseLangResource SemanticPreviewFooterText}"
                                           AttachedToVisualTree="HandleExampleDataGridAttached">
                                <atom:DataGrid.Columns>
                                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderDescription}" FieldId="{x:Static vm:DataGridShowCaseFields.Description}" Binding="{Binding Description}" />
                                </atom:DataGrid.Columns>
                            </atom:DataGrid>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:DataGridShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="section"
                                Description="{gallery:DataGridShowCaseLangResource SemanticSectionDescription}" />
                            <gallery:SemanticPartDescription
                                Path="header.wrapper"
                                Description="{gallery:DataGridShowCaseLangResource SemanticHeaderWrapperDescription}" />
                            <gallery:SemanticPartDescription
                                Path="header.cell"
                                Description="{gallery:DataGridShowCaseLangResource SemanticHeaderCellDescription}" />
                            <gallery:SemanticPartDescription
                                Path="title"
                                Description="{gallery:DataGridShowCaseLangResource SemanticTitleDescription}" />
                            <gallery:SemanticPartDescription
                                Path="body.wrapper"
                                Description="{gallery:DataGridShowCaseLangResource SemanticBodyWrapperDescription}" />
                            <gallery:SemanticPartDescription
                                Path="body.row"
                                Description="{gallery:DataGridShowCaseLangResource SemanticBodyRowDescription}" />
                            <gallery:SemanticPartDescription
                                Path="body.cell"
                                Description="{gallery:DataGridShowCaseLangResource SemanticBodyCellDescription}" />
                            <gallery:SemanticPartDescription
                                Path="footer"
                                Description="{gallery:DataGridShowCaseLangResource SemanticFooterDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:DataGridShowCaseLangResource SemanticContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="pagination.root"
                                Description="{gallery:DataGridShowCaseLangResource SemanticPaginationRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="pagination.item"
                                Description="{gallery:DataGridShowCaseLangResource SemanticPaginationItemDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource BasicTitle}"
                          Description="{gallery:DataGridShowCaseLangResource BasicDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <atom:DataGrid x:Name="BasicCaseGrid"
                       IsHideOnSinglePage="True"
                       IsFrameBorderVisible="True"
                       x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
            <atom:DataGrid.Columns>
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DataGridBaseInfo">
                            <atom:HyperLinkTextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" CanUserResize="True" />
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderTags}">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DataGridBaseInfo">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagInfo">
                                        <atom:Tag Text="{Binding Name}" TagColor="{Binding Color}"></atom:Tag>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAction}">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextInvite}" />
                                <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextModify}" />
                                <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextDelete}" />
                            </StackPanel>
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
            </atom:DataGrid.Columns>
        </atom:DataGrid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource SelectionTitle}"
                          Description="{gallery:DataGridShowCaseLangResource SelectionDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:RadioButton x:Name="ExtendedSelection" IsChecked="True" IsCheckedChanged="HandleSelectionModeCheckedChanged" Content="{gallery:DataGridShowCaseLangResource P2ContentExtended}" />
                <atom:RadioButton x:Name="SingleSelection" IsCheckedChanged="HandleSelectionModeCheckedChanged" Content="{gallery:DataGridShowCaseLangResource P2ContentSingle}" />
            </StackPanel>
            <atom:DataGrid x:Name="SelectionDataGrid" SelectionMode="Extended" SelectTriggerType="Cell"
                                   x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridSelectionColumn />
                    <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:DataGridBaseInfo">
                                <atom:HyperLinkTextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                    <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderTags}">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:DataGridBaseInfo">
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagInfo">
                                            <atom:Tag Text="{Binding Name}" TagColor="{Binding Color}"></atom:Tag>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAction}">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="15">
                                    <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextInvite}" />
                                    <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextModify}" />
                                    <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextDelete}" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource DragResizeColumnTitle}"
                          Description="{gallery:DataGridShowCaseLangResource DragResizeColumnDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <atom:DataGrid x:Name="DragResizeColumn" IsHideOnSinglePage="True" CanUserResizeColumns="True"
                                   x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
            <atom:DataGrid.Columns>
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" CanUserResize="True">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DataGridBaseInfo">
                            <atom:HyperLinkTextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" CanUserResize="True"
                                         CanUserSort="True" />
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderTags}">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DataGridBaseInfo">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagInfo">
                                        <atom:Tag Text="{Binding Name}" TagColor="{Binding Color}"></atom:Tag>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAction}">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextInvite}" />
                                <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextModify}" />
                                <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextDelete}" />
                            </StackPanel>
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
            </atom:DataGrid.Columns>
        </atom:DataGrid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource SizeTitle}"
                          Description="{gallery:DataGridShowCaseLangResource SizeDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <StackPanel Spacing="10">
            <atom:DataGrid x:Name="LargeSizeDataGrid" SizeType="Large"
                                   x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>

            <atom:DataGrid x:Name="MiddleSizeDataGrid" SizeType="Middle"
                                   x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>

            <atom:DataGrid x:Name="SmallSizeDataGrid" SizeType="Small"
                                   x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource TableBorderTitleAndFooterTitle}"
                          Description="{gallery:DataGridShowCaseLangResource TableBorderTitleAndFooterDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <atom:DataGrid x:Name="CustomHeaderAndFooterDataGrid"
                       GridLinesVisibility="All"
                       IsFrameBorderVisible="True"
                       Title="{gallery:DataGridShowCaseLangResource P2TitleHeader}"
                       Footer="{gallery:DataGridShowCaseLangResource P2TitleFooter}"
                       x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
            <atom:DataGrid.Columns>
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DataGridBaseInfo">
                            <atom:HyperLinkTextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderCashAssets}" FieldId="{x:Static vm:DataGridShowCaseFields.Money}" Binding="{Binding Money}" />
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}" />
            </atom:DataGrid.Columns>
        </atom:DataGrid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource FilterAndSorterTitle}"
                          Description="{gallery:DataGridShowCaseLangResource FilterAndSorterDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <atom:DataGrid x:Name="FilterAndSortGrid" CanUserFilterColumns="True"
                                   x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
            <atom:DataGrid.Columns>
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Name}"
                                             CanUserSort="True"
                                             SupportedSortDirections="Descending"
                                             >
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DataGridBaseInfo">
                            <atom:HyperLinkTextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}"
                                         SupportedSortDirections="All"
                                         CanUserSort="True">
                </atom:DataGridTextColumn>
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}"
                                         FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}"

                                         CanUserSort="True"
                                         FilterSelectionMode="Multiple"
                                         SupportedSortDirections="Ascending" />
            </atom:DataGrid.Columns>
        </atom:DataGrid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource FilterInTreeTitle}"
                          Description="{gallery:DataGridShowCaseLangResource FilterInTreeDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <atom:DataGrid x:Name="FilterInTreeGrid" CanUserFilterColumns="True"
                                   x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
            <atom:DataGrid.Columns>
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Name}"
                                             CanUserSort="True"
                                             SupportedSortDirections="Descending"
                                             FilterPresenterMode="Tree">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DataGridBaseInfo">
                            <atom:HyperLinkTextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}"

                                         CanUserSort="True">
                </atom:DataGridTextColumn>
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}"
                                         FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}"

                                         CanUserSort="True"
                                         FilterSelectionMode="Multiple"
                                         SupportedSortDirections="Ascending" />
            </atom:DataGrid.Columns>
        </atom:DataGrid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource MultipleSorterTitle}"
                          Description="{gallery:DataGridShowCaseLangResource MultipleSorterDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <atom:DataGrid x:Name="MultiSorterDataGrid" CanUserFilterColumns="True"
                                   x:DataType="vm:MultiSorterDataType"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
            <atom:DataGrid.Columns>
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}"
                                         FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}"

                                         CanUserSort="True" />
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderChineseScore}"
                                         FieldId="{x:Static vm:DataGridShowCaseFields.Chinese}" Binding="{Binding Chinese}"

                                         CanUserSort="True" />
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderMathScore}"
                                         FieldId="{x:Static vm:DataGridShowCaseFields.Math}" Binding="{Binding Math}"

                                         CanUserSort="True" />
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderEnglishScore}"
                                         FieldId="{x:Static vm:DataGridShowCaseFields.English}" Binding="{Binding English}"

                                         CanUserSort="True" />
            </atom:DataGrid.Columns>
        </atom:DataGrid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource ResetFiltersAndSortersTitle}"
                          Description="{gallery:DataGridShowCaseLangResource ResetFiltersAndSortersDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:Button ButtonType="Default" x:Name="SortAgeBtn" Click="HandleSortAgeBtnClick" Content="{gallery:DataGridShowCaseLangResource P2ContentSortAge}" />
                <atom:Button ButtonType="Default" x:Name="ClearFiltersBtn" Click="HandleClearFiltersBtnClick" Content="{gallery:DataGridShowCaseLangResource P2ContentClearFilters}" />
                <atom:Button ButtonType="Default" x:Name="ClearFiltersAndSortersBtn" Click="HandleClearFiltersAndSortersBtnClick" Content="{gallery:DataGridShowCaseLangResource P2ContentClearFiltersAndSorters}" />
            </StackPanel>
            <atom:DataGrid x:Name="ResetFilterAndSortGrid" CanUserFilterColumns="True"
                                   x:DataType="vm:DataGridBaseInfo"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Name}" Binding="{Binding Name}"
                                             CanUserSort="True"
                                             FilterSelectionMode="Multiple" />
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}"

                                             CanUserSort="True">
                    </atom:DataGridTextColumn>
                    <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}"
                                             FieldId="{x:Static vm:DataGridShowCaseFields.Address}" Binding="{Binding Address}"

                                             CanUserSort="True"
                                             FilterSelectionMode="Multiple" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource ExpandableRowTitle}"
                          Description="{gallery:DataGridShowCaseLangResource ExpandableRowDescription}"
                          IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:DataGridViewModel">

        <atom:DataGrid x:Name="ExpandableDataGrid"
                       RowDetailsVisibilityMode="Collapsed"
                       x:DataType="vm:ExpandableRowDataType"
                           AttachedToVisualTree="HandleExampleDataGridAttached">
            <atom:DataGrid.Columns>
                <atom:DataGridDetailExpanderColumn />
                <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DataGridBaseInfo">
                            <atom:HyperLinkTextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" FieldId="{x:Static vm:DataGridShowCaseFields.Age}" Binding="{Binding Age}" />
