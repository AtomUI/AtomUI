<ControlTheme TargetType="atom:WindowTitleBar"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.WindowTitleBarTheme">
    <ControlTheme.Resources>
        <atom:BorderThicknessFilterConverter x:Key="WindowTitleBarLeftPaddingConverter"
                                             Right="False"
                                             Top="False"
                                             Bottom="False" />
    </ControlTheme.Resources>

    <Style Selector="^[OsType=Linux]">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:WindowTitleBar">
                <Border Name="Frame" Background="{TemplateBinding Background}">
                    <atom:WindowTitleBarLayoutPanel
                        Padding="{TemplateBinding Padding}"
                        TitleAlignment="{TemplateBinding TitleAlignment}"
                        OsType="{TemplateBinding OsType}"
                        NativeChromeInsets="{TemplateBinding NativeChromeInsets}"
                        IsCsdEnabled="{TemplateBinding IsCsdEnabled}"
                        WindowState="{TemplateBinding HostWindowState}"
                        HorizontalSpacing="{atom:WindowTitleBarTokenResource HeaderHorizontalSpacing}"
                        ClipToBounds="True">
                        <DockPanel atom:WindowTitleBarLayoutPanel.Role="Leading"
                                   HorizontalSpacing="{atom:WindowTitleBarTokenResource LogoAndLeftAddOnSpacing}"
                                   LastChildFill="False">
                            <ContentPresenter Name="PART_Logo"
                                              DockPanel.Dock="Left"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding EffectiveLogoPresenterContent}"
                                              ContentTemplate="{TemplateBinding EffectiveLogoPresenterContentTemplate}"
                                              IsVisible="{TemplateBinding IsEffectiveLogoVisible}" />
                            <ContentPresenter Name="PART_LeftAddOn"
                                              DockPanel.Dock="Left"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              atom:WindowTitleBarHostContext.IsWindowActive="{TemplateBinding IsWindowActive}"
                                              atom:WindowTitleBarHostContext.HostMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              atom:WindowTitleBarHostContext.HostOsType="{TemplateBinding OsType}"
                                              Content="{TemplateBinding LeftAddOn}"
                                              ContentTemplate="{TemplateBinding LeftAddOnTemplate}"
                                              IsVisible="{TemplateBinding LeftAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </DockPanel>
                        <DockPanel atom:WindowTitleBarLayoutPanel.Role="Title"
                                   LastChildFill="True"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True"
                                   HorizontalSpacing="{atom:WindowTitleBarTokenResource LogoAndTitleSpacing}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              ClipToBounds="True"
                                              TextWrapping="NoWrap"
                                              TextTrimming="CharacterEllipsis"
                                              Content="{TemplateBinding Title}"
                                              ContentTemplate="{TemplateBinding TitleTemplate}"
                                              IsVisible="{TemplateBinding IsEffectiveTitleVisible}" />
                        </DockPanel>
                        <StackPanel atom:WindowTitleBarLayoutPanel.Role="Trailing"
                                    Orientation="Horizontal"
                                    Spacing="{atom:WindowTitleBarTokenResource CaptionGroupSpacing}">
                            <ContentPresenter Name="PART_RightAddOn"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              atom:WindowTitleBarHostContext.IsWindowActive="{TemplateBinding IsWindowActive}"
                                              atom:WindowTitleBarHostContext.HostMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              atom:WindowTitleBarHostContext.HostOsType="{TemplateBinding OsType}"
                                              Content="{TemplateBinding RightAddOn}"
                                              ContentTemplate="{TemplateBinding RightAddOnTemplate}"
                                              IsVisible="{TemplateBinding RightAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <atom:CaptionButtonGroup Name="PART_CaptionButtonGroup"
                                                     OsType="{TemplateBinding OsType}"
                                                     IsWindowActive="{TemplateBinding IsWindowActive}"
                                                     IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                     HostWindowState="{TemplateBinding HostWindowState}"
                                                     IsWindowTopmost="{TemplateBinding IsWindowTopmost}"
                                                     IsMinimizeCaptionButtonVisible="{TemplateBinding IsMinimizeCaptionButtonVisible}"
                                                     IsMaximizeCaptionButtonVisible="{TemplateBinding IsMaximizeCaptionButtonVisible}"
                                                     IsCloseCaptionButtonVisible="{TemplateBinding IsCloseCaptionButtonVisible}"
                                                     IsFullScreenCaptionButtonVisible="{TemplateBinding IsFullScreenCaptionButtonVisible}"
                                                     IsPinCaptionButtonVisible="{TemplateBinding IsPinCaptionButtonVisible}"
                                                     CanMinimize="{TemplateBinding CanMinimize}"
                                                     CanMaximize="{TemplateBinding CanMaximize}"
                                                     IsPinCaptionButtonSupported="{TemplateBinding IsPinCaptionButtonSupported}"
                                                     CaptionButtonCommand="{TemplateBinding CaptionButtonCommand}" />
                        </StackPanel>
                    </atom:WindowTitleBarLayoutPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="^[OsType=Windows]">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:WindowTitleBar">
                <Border Name="Frame" Background="{TemplateBinding Background}">
                    <atom:WindowTitleBarLayoutPanel
                        Padding="{TemplateBinding Padding, Converter={StaticResource WindowTitleBarLeftPaddingConverter}}"
                        TitleAlignment="{TemplateBinding TitleAlignment}"
                        OsType="{TemplateBinding OsType}"
                        NativeChromeInsets="{TemplateBinding NativeChromeInsets}"
                        IsCsdEnabled="{TemplateBinding IsCsdEnabled}"
                        WindowState="{TemplateBinding HostWindowState}"
                        HorizontalSpacing="{atom:WindowTitleBarTokenResource HeaderHorizontalSpacing}"
                        ClipToBounds="True">
                        <DockPanel atom:WindowTitleBarLayoutPanel.Role="Leading"
                                   HorizontalSpacing="{atom:WindowTitleBarTokenResource LogoAndLeftAddOnSpacing}"
                                   LastChildFill="False">
                            <ContentPresenter Name="PART_Logo"
                                              DockPanel.Dock="Left"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding EffectiveLogoPresenterContent}"
                                              ContentTemplate="{TemplateBinding EffectiveLogoPresenterContentTemplate}"
                                              IsVisible="{TemplateBinding IsEffectiveLogoVisible}" />
                            <ContentPresenter Name="PART_LeftAddOn"
                                              DockPanel.Dock="Left"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              atom:WindowTitleBarHostContext.IsWindowActive="{TemplateBinding IsWindowActive}"
                                              atom:WindowTitleBarHostContext.HostMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              atom:WindowTitleBarHostContext.HostOsType="{TemplateBinding OsType}"
                                              Content="{TemplateBinding LeftAddOn}"
                                              ContentTemplate="{TemplateBinding LeftAddOnTemplate}"
                                              IsVisible="{TemplateBinding LeftAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </DockPanel>
                        <DockPanel atom:WindowTitleBarLayoutPanel.Role="Title"
                                   LastChildFill="True"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True"
                                   HorizontalSpacing="{atom:WindowTitleBarTokenResource LogoAndTitleSpacing}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              ClipToBounds="True"
                                              TextWrapping="NoWrap"
                                              TextTrimming="CharacterEllipsis"
                                              Content="{TemplateBinding Title}"
                                              ContentTemplate="{TemplateBinding TitleTemplate}"
                                              IsVisible="{TemplateBinding IsEffectiveTitleVisible}" />
                        </DockPanel>
                        <StackPanel atom:WindowTitleBarLayoutPanel.Role="Trailing"
                                    Orientation="Horizontal">
                            <ContentPresenter Name="PART_RightAddOn"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              atom:WindowTitleBarHostContext.IsWindowActive="{TemplateBinding IsWindowActive}"
                                              atom:WindowTitleBarHostContext.HostMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              atom:WindowTitleBarHostContext.HostOsType="{TemplateBinding OsType}"
                                              Content="{TemplateBinding RightAddOn}"
                                              ContentTemplate="{TemplateBinding RightAddOnTemplate}"
                                              IsVisible="{TemplateBinding RightAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <atom:CaptionButtonGroup Name="PART_CaptionButtonGroup"
                                                     OsType="{TemplateBinding OsType}"
                                                     IsWindowActive="{TemplateBinding IsWindowActive}"
                                                     IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                     HostWindowState="{TemplateBinding HostWindowState}"
                                                     IsWindowTopmost="{TemplateBinding IsWindowTopmost}"
                                                     IsMinimizeCaptionButtonVisible="{TemplateBinding IsMinimizeCaptionButtonVisible}"
                                                     IsMaximizeCaptionButtonVisible="{TemplateBinding IsMaximizeCaptionButtonVisible}"
                                                     IsCloseCaptionButtonVisible="{TemplateBinding IsCloseCaptionButtonVisible}"
                                                     IsFullScreenCaptionButtonVisible="{TemplateBinding IsFullScreenCaptionButtonVisible}"
                                                     IsPinCaptionButtonVisible="{TemplateBinding IsPinCaptionButtonVisible}"
                                                     CanMinimize="{TemplateBinding CanMinimize}"
                                                     CanMaximize="{TemplateBinding CanMaximize}"
                                                     IsPinCaptionButtonSupported="{TemplateBinding IsPinCaptionButtonSupported}"
                                                     CaptionButtonCommand="{TemplateBinding CaptionButtonCommand}" />
                        </StackPanel>
                    </atom:WindowTitleBarLayoutPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="^[OsType=macOS]">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:WindowTitleBar">
                <Border Name="Frame" Background="{TemplateBinding Background}">
                    <atom:WindowTitleBarLayoutPanel
                        Padding="{TemplateBinding Padding}"
                        TitleAlignment="{TemplateBinding TitleAlignment}"
                        OsType="{TemplateBinding OsType}"
                        NativeChromeInsets="{TemplateBinding NativeChromeInsets}"
                        IsCsdEnabled="{TemplateBinding IsCsdEnabled}"
                        WindowState="{TemplateBinding HostWindowState}"
                        HorizontalSpacing="{atom:WindowTitleBarTokenResource HeaderHorizontalSpacing}"
                        ClipToBounds="True">
                        <ContentPresenter Name="PART_LeftAddOn"
                                          atom:WindowTitleBarLayoutPanel.Role="Leading"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          atom:WindowTitleBarHostContext.IsWindowActive="{TemplateBinding IsWindowActive}"
                                          atom:WindowTitleBarHostContext.HostMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                          atom:WindowTitleBarHostContext.HostOsType="{TemplateBinding OsType}"
                                          Content="{TemplateBinding LeftAddOn}"
                                          ContentTemplate="{TemplateBinding LeftAddOnTemplate}"
                                          IsVisible="{TemplateBinding LeftAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <DockPanel atom:WindowTitleBarLayoutPanel.Role="Title"
                                   LastChildFill="True"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True"
                                   HorizontalSpacing="{atom:WindowTitleBarTokenResource LogoAndTitleSpacing}">
                            <ContentPresenter Name="PART_Logo"
                                              DockPanel.Dock="Left"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Content="{TemplateBinding EffectiveLogoPresenterContent}"
                                              ContentTemplate="{TemplateBinding EffectiveLogoPresenterContentTemplate}"
                                              IsVisible="{TemplateBinding IsEffectiveLogoVisible}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              ClipToBounds="True"
                                              TextWrapping="NoWrap"
                                              TextTrimming="CharacterEllipsis"
                                              Content="{TemplateBinding Title}"
                                              ContentTemplate="{TemplateBinding TitleTemplate}"
                                              IsVisible="{TemplateBinding IsEffectiveTitleVisible}" />
                        </DockPanel>
                        <StackPanel atom:WindowTitleBarLayoutPanel.Role="Trailing"
                                    Orientation="Horizontal"
                                    Spacing="{atom:WindowTitleBarTokenResource CaptionGroupSpacing}">
                            <ContentPresenter Name="PART_RightAddOn"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              atom:WindowTitleBarHostContext.IsWindowActive="{TemplateBinding IsWindowActive}"
                                              atom:WindowTitleBarHostContext.HostMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              atom:WindowTitleBarHostContext.HostOsType="{TemplateBinding OsType}"
                                              Content="{TemplateBinding RightAddOn}"
                                              ContentTemplate="{TemplateBinding RightAddOnTemplate}"
                                              IsVisible="{TemplateBinding RightAddOn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <atom:CaptionButtonGroup Name="PART_CaptionButtonGroup"
                                                     OsType="{TemplateBinding OsType}"
                                                     IsWindowActive="{TemplateBinding IsWindowActive}"
                                                     IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                     HostWindowState="{TemplateBinding HostWindowState}"
                                                     IsWindowTopmost="{TemplateBinding IsWindowTopmost}"
                                                     IsMinimizeCaptionButtonVisible="{TemplateBinding IsMinimizeCaptionButtonVisible}"
                                                     IsMaximizeCaptionButtonVisible="{TemplateBinding IsMaximizeCaptionButtonVisible}"
                                                     IsCloseCaptionButtonVisible="{TemplateBinding IsCloseCaptionButtonVisible}"
                                                     IsFullScreenCaptionButtonVisible="{TemplateBinding IsFullScreenCaptionButtonVisible}"
                                                     IsPinCaptionButtonVisible="{TemplateBinding IsPinCaptionButtonVisible}"
                                                     CanMinimize="{TemplateBinding CanMinimize}"
                                                     CanMaximize="{TemplateBinding CanMaximize}"
                                                     IsPinCaptionButtonSupported="{TemplateBinding IsPinCaptionButtonSupported}"
                                                     CaptionButtonCommand="{TemplateBinding CaptionButtonCommand}" />
                        </StackPanel>
                    </atom:WindowTitleBarLayoutPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="^:is(atom|WindowTitleBar)">
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="Padding" Value="{atom:WindowTitleBarTokenResource TitleBarPadding}" />
        <Setter Property="Height" Value="{atom:WindowTitleBarTokenResource Height}" />

        <Setter Property="Foreground" Value="{atom:WindowTitleBarTokenResource ActiveColor}" />
        <Setter Property="FontSize" Value="{atom:WindowTitleBarTokenResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="{atom:WindowTitleBarTokenResource TitleFontWeight}" />

        <Style Selector="^[IsWindowActive=False]">
            <Setter Property="Foreground" Value="{atom:WindowTitleBarTokenResource InactiveColor}" />
        </Style>

        <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />

        <Style Selector="^ /template/ ContentPresenter#PART_Logo">
            <Setter Property="Width" Value="{atom:WindowTitleBarTokenResource LogoSize}" />
            <Setter Property="Height" Value="{atom:WindowTitleBarTokenResource LogoSize}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#PART_LeftAddOn">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Foreground"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>
    </Style>

</ControlTheme>
