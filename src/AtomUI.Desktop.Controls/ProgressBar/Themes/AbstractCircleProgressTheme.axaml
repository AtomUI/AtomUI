<!-- Shared base theme of the circle-shaped progress controls (CircleProgress, DashboardProgress). The circle Own Tokens are
     filled by each control's own theme. -->
<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:atomc="https://atomui.net/common-controls"
              xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
              x:Class="AtomUI.Desktop.Controls.Themes.AbstractCircleProgressTheme"
              TargetType="atomc:AbstractCircleProgress"
              x:ClassModifier="internal">
    <ControlTheme.BasedOn>
        <themes:AbstractProgressBarTheme TargetType="atomc:AbstractCircleProgress" />
    </ControlTheme.BasedOn>

    <Style Selector="^:is(atomc|AbstractCircleProgress)">
        <!-- The percentage size follows the circle size: a theme Setter so a local FontSize still wins. -->
        <Setter Property="FontSize" Value="{Binding ExtraInfoFontSize, RelativeSource={RelativeSource Self}}" />

        <Style Selector="^ /template/ Path#PART_ProgressRail">
            <Setter Property="Stroke"
                    Value="{TemplateBinding GrooveBrush}" />
            <Setter Property="StrokeThickness"
                    Value="{TemplateBinding EffectiveStrokeThickness}" />
            <Setter Property="StrokeLineCap"
                    Value="{TemplateBinding ShapeStrokeLineCap}" />
        </Style>

        <Style Selector="^ /template/ Path#PART_ProgressTrack">
            <Setter Property="Stroke"
                    Value="{TemplateBinding StrokeBrush}" />
            <Setter Property="StrokeThickness"
                    Value="{TemplateBinding EffectiveStrokeThickness}" />
            <Setter Property="StrokeLineCap"
                    Value="{TemplateBinding ShapeStrokeLineCap}" />
        </Style>

        <Style Selector="^ /template/ Path#PART_ProgressSuccess">
            <Setter Property="Stroke"
                    Value="{TemplateBinding SuccessStrokeBrush}" />
            <Setter Property="StrokeThickness"
                    Value="{TemplateBinding EffectiveStrokeThickness}" />
            <Setter Property="StrokeLineCap"
                    Value="{TemplateBinding ShapeStrokeLineCap}" />
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter">
            <Setter Property="Width"
                    Value="{Binding ExtraInfoIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="Height"
                    Value="{Binding ExtraInfoIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
    </Style>
</ControlTheme>
