<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:primitives="using:AtomUI.Desktop.Controls.Primitives">
    <ControlTheme x:Key="{x:Type primitives:SizeTypeAwareIconPresenter}"
                  TargetType="primitives:SizeTypeAwareIconPresenter">
        <Setter Property="Width" Value="{atom:OwnerTokenResource IconSize}" />
        <Setter Property="Height" Value="{atom:OwnerTokenResource IconSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <atom:IconPresenter
                    Name="PART_IconPresenter"
                    Icon="{TemplateBinding Icon}"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"/>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="Width" Value="{atom:OwnerTokenResource IconSizeLG}" />
            <Setter Property="Height" Value="{atom:OwnerTokenResource IconSizeLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Setter Property="Width" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="Height" Value="{atom:OwnerTokenResource IconSize}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Width" Value="{atom:OwnerTokenResource IconSizeSM}" />
            <Setter Property="Height" Value="{atom:OwnerTokenResource IconSizeSM}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
