<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ContextMenu}" TargetType="atom:ContextMenu" x:DataType="atom:ContextMenu">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>

        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        MaxHeight="{TemplateBinding MaxPopupHeight}">
                    <atom:MenuPopupScrollHost IsScrollEnabled="{TemplateBinding IsScrollEnabled}"
                                              IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              atom:ScrollViewer.IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                              AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        KeyboardNavigation.TabNavigation="Continue"
                                        Grid.IsSharedSizeScope="True" />
                    </atom:MenuPopupScrollHost>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="HorizontalOffset" Value="{atom:MenuTokenResource ContextMenuOffsetX}" />
        <Setter Property="VerticalOffset" Value="{atom:MenuTokenResource ContextMenuOffsetY}" />
        <Setter Property="CornerRadius" Value="{atom:PopupTokenResource PopupCornerRadius}" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="OpenMotion" Value="{x:Static atom:PopupMotionDefaults.DropdownOpen}" />
        <Setter Property="CloseMotion" Value="{x:Static atom:PopupMotionDefaults.DropdownClose}" />
        <Setter Property="Padding" Value="{atom:MenuTokenResource MenuPopupContentPadding}" />
        <Setter Property="Background" Value="{atom:MenuTokenResource MenuPopupBgColor}" />
        <Setter Property="MinWidth" Value="{atom:MenuTokenResource MenuPopupMinWidth}" />
        <Setter Property="MaxWidth" Value="{atom:MenuTokenResource MenuPopupMaxWidth}" />
        <Setter Property="ItemHeight" Value="{atom:MenuTokenResource ItemHeight}" />
        <Setter Property="DisplayPageSize" Value="8" />
        <Setter Property="ShouldUseOverlayPopup" Value="True" />
        <Setter Property="MotionDuration" Value="{atom:OwnerTokenResource MotionDurationMid}"/>
        <Setter Property="PopupRootShadow"
                Value="{atom:PopupTokenResource PopupRootShadow}" />
        <Setter Property="OverlayHostShadow"
                Value="{atom:PopupTokenResource OverlayHostShadow}" />

    </ControlTheme>
</ResourceDictionary>
