<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    xmlns:atom="https://atomui.net"
    >
    <ControlTheme x:Key="{x:Type atom:Form}" TargetType="atom:Form">
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>

        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BoxShadow="{TemplateBinding BoxShadow}">
                    <ItemsPresenter Name="PART_ItemsPresenter">
                        <ItemsPresenter.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="{Binding FormLayoutOrientation, RelativeSource={RelativeSource AncestorType=atom:Form}}"
                                            Spacing="{Binding FormLayoutSpacing, RelativeSource={RelativeSource AncestorType=atom:Form}}"/>
                            </ItemsPanelTemplate>
                        </ItemsPresenter.ItemsPanel>
                    </ItemsPresenter>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Style Selector="^[FormLayout=Inline]">
            <Setter Property="FormLayoutSpacing" Value="{atom:FormTokenResource InlineItemSpacing}" />
        </Style>
        <Setter Property="ErrorMessageForeground" Value="{atom:FormTokenResource ColorErrorText}" />
        <Setter Property="WarningMessageForeground" Value="{atom:FormTokenResource ColorWarningText}" />
        
        <Setter Property="FeedbackTemplate">
            <DataTemplate DataType="atom:Form">
                <atom:FormValidateFeedback SuccessFeedback="{Binding SuccessFeedback}"
                                           SuccessFeedbackTemplate="{Binding SuccessFeedbackTemplate}"
                                           ErrorFeedback="{Binding ErrorFeedback}"
                                           ErrorFeedbackTemplate="{Binding ErrorFeedbackTemplate}"
                                           WarningFeedback="{Binding WarningFeedback}"
                                           WarningFeedbackTemplate="{Binding WarningFeedbackTemplate}"
                                           ValidatingFeedback="{Binding ValidatingFeedback}"
                                           ValidatingFeedbackTemplate="{Binding ValidatingFeedbackTemplate}"/>
            </DataTemplate>
        </Setter>
        
        <Setter Property="SuccessFeedbackTemplate">
            <DataTemplate>
                <antdicons:CheckCircleFilled
                    FillBrush="{atom:FormTokenResource ColorSuccess}"
                    Width="{atom:FormTokenResource IconSize}"
                    Height="{atom:FormTokenResource IconSize}"/>
            </DataTemplate>
        </Setter>
        <Setter Property="ErrorFeedbackTemplate">
            <DataTemplate>
                <antdicons:CloseCircleFilled
                    FillBrush="{atom:FormTokenResource ColorError}"
                    Width="{atom:FormTokenResource IconSize}"
                    Height="{atom:FormTokenResource IconSize}"/>
            </DataTemplate>
        </Setter>
        <Setter Property="WarningFeedbackTemplate">
            <DataTemplate>
                <antdicons:ExclamationCircleFilled
                    FillBrush="{atom:FormTokenResource ColorWarning}"
                    />
            </DataTemplate>
        </Setter>
        <Setter Property="ValidatingFeedbackTemplate">
            <DataTemplate>
                <antdicons:LoadingOutlined
                    LoadingAnimation="Spin"
                    StrokeBrush="{atom:FormTokenResource ColorIcon}"/>
            </DataTemplate>
        </Setter>
        
        <Setter Property="ItemDeleteButtonIcon">
            <atom:IconTemplate>
                <antdicons:MinusCircleOutlined/>
            </atom:IconTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
