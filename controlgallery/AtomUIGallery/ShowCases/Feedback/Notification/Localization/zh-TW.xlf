    <unit id="PageDescription">
      <segment>
        <source>Notification displays rich feedback cards near the edge of the window. It supports semantic types, custom icons, placement, manual duration, hover pause, and auto-close progress.</source>
        <target state="translated">Notification 在窗口邊緣顯示信息更豐富的反饋卡片，支持語義類型、自定義圖標、彈出位置、手動時長、懸停暫停和自動關閉進度。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Desktop notifications for longer feedback and non-blocking updates.</source>
        <target state="translated">用於較長反饋和非阻塞更新的桌面通知。</target>
      </segment>
    </unit>
    <unit id="PlacementDescription">
      <segment>
        <source>A notification box can appear from the top bottom topLeft topRight bottomLeft or bottomRight of the viewport via placement.</source>
        <target state="translated">通知框可通過 placement 從視口頂部、底部、左上、右上、左下或右下出現。</target>
      </segment>
    </unit>
    <unit id="PlacementTitle">
      <segment>
        <source>Placement</source>
        <target state="translated">彈出位置</target>
      </segment>
    </unit>
    <unit id="ProgressDescription">
      <segment>
        <source>Show progress bar for auto-closing notification.</source>
        <target state="translated">為自動關閉的通知顯示進度條。</target>
      </segment>
    </unit>
    <unit id="ProgressTitle">
      <segment>
        <source>Show with progress</source>
        <target state="translated">顯示進度</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="SemanticActionsDescription">
      <segment>
        <source>The action group element at the bottom-right of the notice. It hosts the caller actions.</source>
        <target state="translated">通知右下角的操作組元素，承載呼叫方傳入的操作內容。</target>
      </segment>
    </unit>
    <unit id="SemanticCloseDescription">
      <segment>
        <source>The close button overlay at the top-right corner. Customize its position, size and interaction.</source>
        <target state="translated">右上角的關閉按鈕覆蓋元素，可自訂位置、尺寸與互動。</target>
      </segment>
    </unit>
    <unit id="SemanticDescriptionDescription">
      <segment>
        <source>The description element below the title. Customize its font size, color and padding.</source>
        <target state="translated">標題下方的描述元素，可自訂字號、顏色與內距。</target>
      </segment>
    </unit>
    <unit id="SemanticIconDescription">
      <segment>
        <source>The status icon element. Customize its size, brush and line height.</source>
        <target state="translated">狀態圖示元素，可自訂尺寸、筆刷與行高。</target>
      </segment>
    </unit>
    <unit id="SemanticListContentDescription">
      <segment>
        <source>The notice arrangement container of the notification list. Customize its direction, order and alignment.</source>
        <target state="translated">通知清單的項目排列容器，可自訂排列方向、順序與對齊。</target>
      </segment>
    </unit>
    <unit id="SemanticListRootDescription">
      <segment>
        <source>The notification list root. It hosts the cards, queue, timeout and host layer lifecycle.</source>
        <target state="translated">通知清單根元素，承載卡片、佇列、逾時與宿主層生命週期。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Mirrors the upstream style-class demo: default and error-branched styles shape the notice root, icon, title and description through owner-scoped Semantic Part styles.</source>
        <target state="translated">對齊上游 style-class 範例：透過 owner 作用域的語義部件樣式自訂通知根元素、圖示、標題與描述。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
        <target state="translated">自訂語義結構的樣式</target>
      </segment>
    </unit>
    <unit id="SemanticProgressDescription">
      <segment>
        <source>The progress overlay at the bottom of the notice. It shows the remaining auto-close time.</source>
        <target state="translated">通知底部的進度覆蓋元素，顯示剩餘自動關閉時間。</target>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>The notice root. It hosts the content, type, close state and enter/leave motion.</source>
        <target state="translated">通知項根元素，承載內容、類型、關閉狀態與進出場動效。</target>
      </segment>
    </unit>
    <unit id="SemanticSectionDescription">
      <segment>
        <source>The content section that wraps the title and description. Customize the vertical gap and alignment.</source>
        <target state="translated">包裹標題與描述內容的區域元素，可自訂縱向間距與對齊。</target>
      </segment>
    </unit>
    <unit id="SemanticTitleDescription">
      <segment>
        <source>The title element. Customize its color, font size, line height and right padding.</source>
        <target state="translated">標題元素，可自訂顏色、字號、行高與右側留白。</target>
      </segment>
    </unit>
    <unit id="SemanticWrapperDescription">
      <segment>
        <source>The wrapping element for the icon and section. Customize the layout, alignment and icon gap.</source>
        <target state="translated">圖示與內容區域的包裹元素，可自訂佈局、對齊與圖示間距。</target>
      </segment>
    </unit>
    <unit id="StackDescription">
      <segment>
        <source>Stack is disabled by default. This example enables it; notifications stack when their amount is over threshold, and hover expands all notifications.</source>
        <target state="translated">預設關閉堆疊。本示例將其開啟；通知數量超過閾值後會摺疊顯示，懸停堆疊區域可展開全部通知。</target>
      </segment>
    </unit>
    <unit id="StackEnabledLabel">
      <segment>
        <source>Enabled:</source>
        <target state="translated">開啟：</target>
      </segment>
    </unit>
    <unit id="StackThresholdLabel">
      <segment>
        <source>Threshold:</source>
        <target state="translated">閾值：</target>
      </segment>
    </unit>
    <unit id="StackTitle">
      <segment>
        <source>Stack</source>
        <target state="translated">堆疊</target>
      </segment>
    </unit>
    <unit id="WithIconDescription">
      <segment>
        <source>A notification box with a icon at the left side.</source>
        <target state="translated">左側帶圖標的通知框。</target>
      </segment>
    </unit>
    <unit id="WithIconTitle">
      <segment>
        <source>Notification with icon</source>
        <target state="translated">帶圖標通知</target>
      </segment>
    </unit>
