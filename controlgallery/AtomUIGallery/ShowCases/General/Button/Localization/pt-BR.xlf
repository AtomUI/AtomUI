    <unit id="PageDescription">
      <segment>
        <source>Button is the primary action control in AtomUI. Use type, shape, size, icon and loading states to build predictable workflows without losing the Ant Design interaction model.</source>
        <target state="translated">Botão é o primário ação controle em AtomUI. Usar tipo, forma, tamanho, ícone e carregando states para build predictable workflows sem losing o Ant Design interaction model.</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Trigger actions and express intent with clear visual priority.</source>
        <target state="translated">Gatilho ações e express intent com limpar visual priority.</target>
      </segment>
    </unit>
