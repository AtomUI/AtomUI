    <unit id="PageDescription">
      <segment>
        <source>PopupConfirm combines a trigger control with a confirmation flyout. It is useful when an operation needs a quick second step but does not justify a blocking modal dialog.</source>
        <target state="translated">PopupConfirm combines a gatilho controle com a confirmation flyout. Isso é useful quando an operação needs a quick segundo etapa but does não justify a blocking modal diálogo.</target>
      </segment>
    </unit>
