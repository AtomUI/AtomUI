    <unit id="PageDescription">
      <segment>
        <source>Slider supports single-value and range selection, horizontal or vertical orientation, snap-to-tick behavior, formatted tooltips, marks, included tracks, disabled states, and keyboard interaction.</source>
      </segment>
    </unit>
    <unit id="PageSubtitle">
