<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <atom:BorderThicknessFilterConverter x:Key="BorderThicknessFilterConverter" Left="False" Right="False" Bottom="False"/>
    <ControlTheme x:Key="{x:Type atom:TimePickerPresenter}" TargetType="atom:TimePickerPresenter">
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:TimePickerPresenter">
                <Border>
                    <DockPanel Name="PART_MainLayout" LastChildFill="True" Classes.semantic-popup-container="True">
                        <atom:PixelAlignedBorder Name="PART_ButtonsFrame"
                                                 Classes.semantic-popup-footer="True"
                                                 BorderThickness="{TemplateBinding BorderThickness, Converter={StaticResource BorderThicknessFilterConverter}}"
                                                 IsVisible="{TemplateBinding IsButtonsPanelVisible}"
                                                 DockPanel.Dock="Bottom">
                            <Panel Name="PART_ButtonsLayout">
                                <atom:Button
                                    Name="PART_NowButton"
                                    ButtonType="Link"
                                    IsVisible="{TemplateBinding IsShowNow}"
                                    HorizontalAlignment="Left"
                                    SizeType="Small"
                                    Content="{atom:TimePickerLangResource Now}" />
                                <atom:Button
                                    Name="PART_ConfirmButton"
                                    ButtonType="Primary"
                                    IsVisible="{TemplateBinding IsNeedConfirm}"
                                    IsEnabled="{TemplateBinding CanConfirm}"
                                    HorizontalAlignment="Right"
                                    SizeType="Small"
                                    Content="{atom:CommonLangResource Ok}" />
                            </Panel>
                        </atom:PixelAlignedBorder>
                        <atom:TimeView Name="PART_TimeView"
                                       IsShowHeader="False"
                                       SelectorRowCount="8"
                                       IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                       MinuteIncrement="{TemplateBinding MinuteIncrement}"
                                       SecondIncrement="{TemplateBinding SecondIncrement}"
                                       SelectedTime="{TemplateBinding TempSelectedTime}"
                                       IsChangeOnScroll="{TemplateBinding IsChangeOnScroll}"
                                       ClockIdentifier="{TemplateBinding ClockIdentifier}"/>
                    </DockPanel>
                </Border>
                
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^[IsNeedConfirm=False] /template/ atom|Button#PART_NowButton">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_ButtonsFrame">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
        </Style>
        
        <Style Selector="^ /template/ Panel#PART_ButtonsLayout">
            <Setter Property="Margin" Value="{atom:DatePickerTokenResource ButtonsPanelMargin}" />
        </Style>
        
    </ControlTheme>
</ResourceDictionary>
