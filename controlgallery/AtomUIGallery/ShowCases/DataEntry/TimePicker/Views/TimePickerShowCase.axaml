<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.TimePicker.TimePickerShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.TimePicker"
             x:DataType="vm:TimePickerViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="TimePicker"
                    Category="{gallery:TimePickerShowCaseLangResource ComponentCategory}"
                    Status="{gallery:TimePickerShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:TimePickerShowCaseLangResource PageSubtitle}"
                    Description="{gallery:TimePickerShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="InfoPickerInput" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:TimePickerViewModel">
                    <gallery:SemanticPartPreview Name="TimePickerSemanticPreview"
                                                 Title="TimePicker"
                                                 SemanticOwner="{Binding #TimeRangeSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:RangeTimePicker}"
                                                 PreviewStageMinHeight="560"
                                                 PreviewContentAlignment="Top">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:RangeTimePicker Name="TimeRangeSemanticOwner"
                                                  Width="420"
                                                  IsMotionEnabled="False"
                                                  IsPickerOpen="True"
                                                  IsPopupPinnedOpen="True"
                                                  ClockIdentifier="HourClock12"
                                                  RangeStartSelectedTime="10:09:20"
                                                  RangeEndSelectedTime="12:12:20"
                                                  PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextStartTime}"
                                                  SecondaryPlaceholderText="{gallery:TimePickerShowCaseLangResource P2SecondaryPlaceholderTextEndTime}" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="prefix"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticPrefixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="input"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticInputDescription}" />
                            <gallery:SemanticPartDescription
                                Path="secondaryInput"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticSecondaryInputDescription}" />
                            <gallery:SemanticPartDescription
                                Path="suffix"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticSuffixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="clear"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticClearDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.root"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticPopupRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.container"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticPopupContainerDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.content"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticPopupContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.column"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticPopupColumnDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.item"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticPopupItemDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.footer"
                                Description="{gallery:TimePickerShowCaseLangResource SemanticPopupFooterDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource BasicTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource BasicDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}" PickerDisplayTime="00:00:00" IsShowNow="True" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource NeedConfirmTitle}"
        Description="{gallery:TimePickerShowCaseLangResource NeedConfirmDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
                <WrapPanel ItemSpacing="24" LineSpacing="20">
                    <StackPanel Width="190" Spacing="8">
                        <TextBlock Text="IsNeedConfirm=True" FontWeight="Medium" />
                        <atom:TimePicker IsNeedConfirm="True"
                                         Width="160"
                                         HorizontalAlignment="Left"
                                         PickerDisplayTime="00:00:00"
                                         PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}"
                                         SelectedTime="{Binding ConfirmRequiredSelectedTime}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{gallery:TimePickerShowCaseLangResource P2TextSelectedTime}"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                            <TextBlock Text="{Binding ConfirmRequiredSelectedTimeText}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Width="190" Spacing="8">
                        <TextBlock Text="IsNeedConfirm=False" FontWeight="Medium" />
                        <atom:TimePicker IsNeedConfirm="False"
                                         Width="160"
                                         HorizontalAlignment="Left"
                                         PickerDisplayTime="00:00:00"
                                         PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}"
                                         SelectedTime="{Binding NoConfirmSelectedTime}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{gallery:TimePickerShowCaseLangResource P2TextSelectedTime}"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                            <TextBlock Text="{Binding NoConfirmSelectedTimeText}" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource BindingTitle}"
        BadgeText="v6.0.8"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource BindingDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="16">
            <StackPanel Orientation="Vertical" Spacing="12">
                <atom:TimePicker SelectedTime="{Binding BoundSelectedTime}"
                                 PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <atom:TextBlock VerticalAlignment="Center"
                                    Text="{gallery:TimePickerShowCaseLangResource P2TextSelectedTime}" />
                    <atom:TextBlock VerticalAlignment="Center"
                                    Text="{Binding BoundSelectedTimeText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <atom:Button SizeType="Small"
                                 Click="SetBoundSelectedTimeToNoon"
                                 Content="{gallery:TimePickerShowCaseLangResource P2ContentSetNoon}" />
                    <atom:Button SizeType="Small"
                                 Click="ClearBoundSelectedTime"
                                 Content="{gallery:TimePickerShowCaseLangResource P2ContentClear}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Vertical" Spacing="12">
                <atom:RangeTimePicker RangeStartSelectedTime="{Binding BoundRangeStartSelectedTime}"
                                      RangeEndSelectedTime="{Binding BoundRangeEndSelectedTime}"
                                      PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextStartTime}"
                                      SecondaryPlaceholderText="{gallery:TimePickerShowCaseLangResource P2SecondaryPlaceholderTextEndTime}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <atom:TextBlock VerticalAlignment="Center"
                                    Text="{gallery:TimePickerShowCaseLangResource P2TextSelectedTimeRange}" />
                    <atom:TextBlock VerticalAlignment="Center"
                                    Text="{Binding BoundRangeSelectedTimeText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <atom:Button SizeType="Small"
                                 Click="SetBoundSelectedTimeRangeToWorkHours"
                                 Content="{gallery:TimePickerShowCaseLangResource P2ContentSetWorkHours}" />
                    <atom:Button SizeType="Small"
                                 Click="ClearBoundSelectedTimeRange"
                                 Content="{gallery:TimePickerShowCaseLangResource P2ContentClear}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource PickerDisplayTimeTitle}"
        BadgeText="v6.0.8"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource PickerDisplayTimeDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}"
                         PickerDisplayTime="14:25:30"
                         ClockIdentifier="HourClock24" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource HourFormatsTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource HourFormatsDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}" IsNeedConfirm="True" IsShowNow="True"
                         ClockIdentifier="HourClock24" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource ThreeSizesTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource ThreeSizesDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <DockPanel Margin="0, 0, 0, 0">
            <DockPanel.Styles>
                <Style Selector="atom|TimePicker.size-demo-picker[SizeType=Custom]">
                    <Setter Property="Height" Value="38" />
                    <Setter Property="FontSize" Value="15" />
                </Style>
                <Style Selector="atom|RangeTimePicker.size-demo-picker[SizeType=Custom]">
                    <Setter Property="Height" Value="38" />
                    <Setter Property="FontSize" Value="15" />
                </Style>
            </DockPanel.Styles>
            <StackPanel Orientation="Horizontal" Spacing="5" DockPanel.Dock="Top">
                <atom:TextBlock VerticalAlignment="Center" Text="{gallery:TimePickerShowCaseLangResource P2TextExpandDirection}" />
                <atom:OptionButtonGroup ButtonStyle="Outline"
                                        Name="PickerSizeTypeOptionGroup"
                                        OptionCheckedChanged="HandlePickerSizeTypeOptionCheckedChanged">
                    <atom:OptionButton Content="{gallery:TimePickerShowCaseLangResource P2ContentLarge}" />
                    <atom:OptionButton IsChecked="True" Content="{gallery:TimePickerShowCaseLangResource P2ContentDefault}" />
                    <atom:OptionButton Content="{gallery:TimePickerShowCaseLangResource P2ContentSmall}" />
                    <atom:OptionButton Content="{gallery:TimePickerShowCaseLangResource P2ContentCustom}" />
                </atom:OptionButtonGroup>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0, 20, 0, 0" Spacing="10">
                <atom:TimePicker Classes="size-demo-picker"
                                 PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}"
                                 SizeType="{Binding PickerSizeType}"
                                 DefaultTime="12:08:23" />
                <atom:RangeTimePicker Classes="size-demo-picker"
                                      PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextStartTime}"
                                      SecondaryPlaceholderText="{gallery:TimePickerShowCaseLangResource P2SecondaryPlaceholderTextEndTime}"
                                      RangeStartDefaultTime="10:09:20"
                                      RangeEndDefaultTime="12:12:20"
                                      SizeType="{Binding PickerSizeType}" />
            </StackPanel>
        </DockPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource DisabledTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource DisabledDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}" IsEnabled="False" DefaultTime="12:08:23" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource IntervalOptionTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource IntervalOptionDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}"
                             DefaultTime="12:08:23"
                             MinuteIncrement="15"
                             SecondIncrement="10" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource TwelveHoursTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource TwelveHoursDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}"
                             DefaultTime="12:08:23"
                             ClockIdentifier="HourClock12" />
            <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}"
                             DefaultTime="12:08:23"
                             ClockIdentifier="HourClock24" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource VariantsTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource VariantsDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextOutline}"
                                 StyleVariant="Outlined" />
                <atom:RangeTimePicker StyleVariant="Outlined"
                                      PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextOutline}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextFilled}"
                                 StyleVariant="Filled" />
                <atom:RangeTimePicker StyleVariant="Filled"
                                      PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextFilled}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:TimePicker PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextBorderless}"
                                 StyleVariant="Borderless" />
                <atom:RangeTimePicker StyleVariant="Borderless"
                                      PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextBorderless}" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource StatusTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource StatusDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:TimePicker Status="Default"
                                 PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}" />
                <atom:RangeTimePicker StyleVariant="Outlined"
                                      Status="Default"
                                      PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextStartTime}"
                                      SecondaryPlaceholderText="{gallery:TimePickerShowCaseLangResource P2SecondaryPlaceholderTextEndTime}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:TimePicker Status="Warning"
                                 PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}" />
                <atom:RangeTimePicker StyleVariant="Outlined"
                                      Status="Warning"
                                      PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextStartTime}"
                                      SecondaryPlaceholderText="{gallery:TimePickerShowCaseLangResource P2SecondaryPlaceholderTextEndTime}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:TimePicker Status="Error"
                                 PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextSelectTime}" />
                <atom:RangeTimePicker StyleVariant="Outlined"
                                      Status="Error"
                                      PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextStartTime}"
                                      SecondaryPlaceholderText="{gallery:TimePickerShowCaseLangResource P2SecondaryPlaceholderTextEndTime}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource TimeRangePickerTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:TimePickerShowCaseLangResource TimeRangePickerDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:RangeTimePicker Status="Default"
                                  PlaceholderText="{gallery:TimePickerShowCaseLangResource P2PlaceholderTextStartTime}"
                                  SecondaryPlaceholderText="{gallery:TimePickerShowCaseLangResource P2SecondaryPlaceholderTextEndTime}"
                                  RangeStartDefaultTime="10:09:20"
                                  RangeEndDefaultTime="12:12:20" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TimePickerShowCaseLangResource SemanticPartStyleTitle}"
        Description="{gallery:TimePickerShowCaseLangResource SemanticPartStyleDescription}"
        SourceKey="timepicker-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TimePickerViewModel">
        <StackPanel HorizontalAlignment="Left" Spacing="20">
            <StackPanel.Styles>
                <Style Selector="atom|TimePicker.semantic-styles-demo">
                    <atom:TimePickerPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#1890FF" />
                        </Style>
                    </atom:TimePickerPrefixStyle>
                    <atom:TimePickerPopupRootStyle x:SetterTargetType="atom:ArrowDecoratedBox">
                        <Setter Property="BorderBrush" Value="#1890FF" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:TimePickerPopupRootStyle>
                    <atom:TimePickerPopupItemStyle x:SetterTargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#722ED1" />
                    </atom:TimePickerPopupItemStyle>
                </Style>
                <Style Selector="atom|RangeTimePicker.semantic-styles-demo">
                    <atom:RangeTimePickerInputStyle x:SetterTargetType="TextBox">
                        <Setter Property="FontStyle" Value="Italic" />
                    </atom:RangeTimePickerInputStyle>
                    <atom:RangeTimePickerPopupColumnStyle x:SetterTargetType="Panel">
                        <Setter Property="Width" Value="56" />
                    </atom:RangeTimePickerPopupColumnStyle>
                </Style>
            </StackPanel.Styles>
            <atom:TimePicker Classes="semantic-styles-demo"
                             Width="300"
                             IsNeedConfirm="False"
                             IsShowNow="True"
                             ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                             PlaceholderText="Object" />
            <atom:RangeTimePicker Classes="semantic-styles-demo"
                                  Width="420"
                                  ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                                  PlaceholderText="Range" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
