<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:converters="using:Avalonia.Controls.Converters"
    x:ClassModifier="internal">
    <converters:CornerRadiusFilterConverter x:Key="CornerRadiusFilterConverter"
                                            Filter="BottomLeft, BottomRight"/>
    <ControlTheme x:Key="{x:Type atom:CardActionPanel}" TargetType="atom:CardActionPanel">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame" Padding="{TemplateBinding Padding}"
                        CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource CornerRadiusFilterConverter}}"
                        Background="{TemplateBinding Background}">
                    <UniformGrid Name="PART_GridPanel"
                                 ColumnSpacing="1"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="{atom:CardTokenResource ActionsBg, WhenExplicit=True}" />
        <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightLG, SourceControlType={x:Type atom:Card}}"/>
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize, SourceControlType={x:Type atom:Card}}"/>
     
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextDescription, SourceControlType={x:Type atom:Card}}"/>
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorderSecondary, SourceControlType={x:Type atom:Card}}"/>
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness, SourceControlType={x:Type atom:Card}}"/>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorPrimary, SourceControlType={x:Type atom:Card}}"/>
        </Style>
        


        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <atom:SolidColorBrushTransition Property="Foreground" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </atom:TokenTransitions>
            </Setter>
        </Style>

    </ControlTheme>
</ResourceDictionary>
