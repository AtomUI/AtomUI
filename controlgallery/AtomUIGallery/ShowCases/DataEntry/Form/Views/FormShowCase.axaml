                </atom:FormItem.Validators>
                <atom:TreeSelect IsAllowClear="True"
                                 PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextIMTreeselect}"
                                 HorizontalAlignment="Stretch"
                                 IsPopupMatchSelectWidth="False"
                                 ItemsSource="{Binding ValidationTreeNodes}" />
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSuccess}"
                           FieldName="success"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormAssertValidator AssertResult="True"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:NumericUpDown IsAllowClear="True" HorizontalAlignment="Stretch"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSuccess}"
                           FieldName="success"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormAssertValidator AssertResult="True"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit IsAllowClear="True" PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextWithAllowclear}"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextWarning}"
                           FieldName="warning"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormAssertValidator AssertResult="False" WarningOnly="True"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit RevealPassword="False"
                               PasswordChar="•"
                               IsEnableRevealButton="True"
                               PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextWithInputPassword}"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextError}"
                           FieldName="error"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormAssertValidator AssertResult="False"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit RevealPassword="False"
                               PasswordChar="•"
                               IsAllowClear="True"
                               IsEnableRevealButton="True"
                               PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextWithInputPasswordAndAllowclear}"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextFail}"
                           FieldName="fail"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormAssertValidator AssertResult="False"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:Mentions/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextFail}"
                           FieldName="fail"
                           Help="{gallery:FormShowCaseLangResource P2HelpShouldHaveSomething}"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormAssertValidator AssertResult="False"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:TextArea IsShowCount="True"
                               IsAllowClear="True"/>
            </atom:FormItem>

            <atom:FormActionsItem>
                <atom:SubmitButton/>
            </atom:FormActionsItem>
        </atom:Form>


            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource DynamicFormItemTitle}"
        Description="{gallery:FormShowCaseLangResource DynamicFormItemDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left"
                   Name="DynamicForm">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextPassengers}"
                           FieldName="passengers">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputPassengerSNameOrDeleteThisField}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextPassengers1}"
                           FieldName="passengers1">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputPassengerSNameOrDeleteThisField}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>

            <atom:FormActionsItem>
                <atom:Button ButtonType="Dashed" HorizontalAlignment="Stretch" Icon="{antdicons:AntDesignIconProvider PlusOutlined}"
                             Click="HandleAddFormItem" Content="{gallery:FormShowCaseLangResource P2ContentAddField}" />
            </atom:FormActionsItem>
            <atom:FormActionsItem>
                <atom:Button ButtonType="Dashed" HorizontalAlignment="Stretch" Icon="{antdicons:AntDesignIconProvider PlusOutlined}"
                             Click="HandleAddFormItemAtHead" Content="{gallery:FormShowCaseLangResource P2ContentAddFieldAtHead}" />
            </atom:FormActionsItem>
            <atom:FormActionsItem>
                <atom:SubmitButton />
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource InlineLoginFormTitle}"
        Description="{gallery:FormShowCaseLangResource InlineLoginFormDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left"
                   FormLayout="Inline">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextUsername}"
                           FieldName="username">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourUsername}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit InnerLeftContent="{antdicons:AntDesignIconProvider UserOutlined}"
                               PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextUsername}"
                               Width="200"/>
            </atom:FormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextPassword}"
                           FieldName="password">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourPassword}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit InnerLeftContent="{antdicons:AntDesignIconProvider LockOutlined}"
                               PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextPassword}"
                               Width="200"/>
            </atom:FormItem>
            <atom:FormActionsItem>
                <atom:SubmitButton IsWatchValidateResult="True" Content="{gallery:FormShowCaseLangResource P2ContentLogIn}"/>
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource LoginFormTitle}"
        Description="{gallery:FormShowCaseLangResource LoginFormDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="400"
                   HorizontalAlignment="Left"
                   IsHideItemLabel="True">
            <atom:FormItem FieldName="username">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourUsername}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit InnerLeftContent="{antdicons:AntDesignIconProvider UserOutlined}"
                               PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextUsername}"/>
            </atom:FormItem>
            <atom:FormItem FieldName="password">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourPassword}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit InnerLeftContent="{antdicons:AntDesignIconProvider LockOutlined}"
                               PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextPassword}"/>
            </atom:FormItem>
            <atom:FormItem FieldName="remember">
                <atom:FormItemDecorator HorizontalAlignment="Stretch"
                                        Theme="{StaticResource LoginOptionsDecoratorTheme}">
                    <atom:CheckBox IsChecked="True"
                                   Content="{gallery:FormShowCaseLangResource P2ContentRememberMe}" />
                    <atom:FormItemDecorator.Extra>
                        <atom:HyperLinkTextBlock HorizontalAlignment="Right"
                                                 Focusable="True"
                                                 Text="{gallery:FormShowCaseLangResource P2ContentForgotPassword}" />
                    </atom:FormItemDecorator.Extra>
                </atom:FormItemDecorator>
            </atom:FormItem>
            <atom:FormActionsItem>
                <StackPanel>
                    <atom:SubmitButton Content="{gallery:FormShowCaseLangResource P2ContentLogIn}" HorizontalAlignment="Stretch"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{gallery:FormShowCaseLangResource P2TextOr}" />
                        <atom:HyperLinkTextBlock Text="{gallery:FormShowCaseLangResource P2ContentRegisterNow}" />
                    </StackPanel>
                </StackPanel>
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource RegistrationTitle}"
        Description="{gallery:FormShowCaseLangResource RegistrationDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextEmail}"
                           FieldName="email"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourEMail}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextPassword}"
                           FieldName="password"
                           IsRequired="True"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourPassword}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit RevealPassword="False"
                               PasswordChar="•"
                               IsEnableRevealButton="True" />
            </atom:FormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextConfirmPassword}"
                           FieldName="confirm"
                           IsRequired="True"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseConfirmYourPassword}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit RevealPassword="False"
                               PasswordChar="•"
                               IsEnableRevealButton="True" />
            </atom:FormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextNickname}"
                           FieldName="nickname"
                           IsRequired="True"
                           Tooltip="{gallery:FormShowCaseLangResource P2TooltipWhatDoYouWantOthersToCallYou}">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourNickname}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit />
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextHabitualResidence}"
                           FieldName="residence"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormNotNullValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseSelectYourHabitualResidence}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:Cascader HorizontalAlignment="Stretch"
                               IsAllowClear="True"
                               OptionsSource="{Binding PresetCascaderOptions}" />
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextPhoneNumber}"
                           FieldName="phone"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputYourPhoneNumber}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <gallery:PhoneNumber/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextDonation}"
                           FieldName="donation"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormNotNullValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputDonationAmount}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <gallery:Donation/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextWebsite}"
                           FieldName="website"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputWebsite}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextWebsite}"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextIntro}"
                           FieldName="intro"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputIntro}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:TextArea IsShowCount="True" MaxLength="100"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextGender}"
                           FieldName="gender"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormNotNullValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseSelectGender}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:Select DefaultValues="male"
                             HorizontalAlignment="Stretch"
                             OptionsSource="{Binding PresetGenderOptions}" />
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextCaptcha}"
                           FieldName="captcha"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseInputTheCaptchaYouGot}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <gallery:Captcha/>
            </atom:FormItem>

            <atom:FormItem FieldName="agreement"
                           IsRequired="True">
                <atom:CheckBox IsChecked="True">
                   <StackPanel Orientation="Horizontal" Spacing="5">
                       <TextBlock Text="{gallery:FormShowCaseLangResource P2TextIHaveReadThe}" />
                       <atom:HyperLinkTextBlock Text="{gallery:FormShowCaseLangResource P2ContentAgreement}" />
                   </StackPanel>
                </atom:CheckBox>
            </atom:FormItem>
            <atom:FormActionsItem>
                <atom:SubmitButton Content="{gallery:FormShowCaseLangResource P2ContentRegister}"/>
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource CustomizedFormControlsTitle}"
        Description="{gallery:FormShowCaseLangResource CustomizedFormControlsDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="8*"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left"
                   FormLayout="Inline">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextPrice}"
                           FieldName="price"
                           Width="350">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <gallery:PriceValidator Message="{gallery:FormShowCaseLangResource P2MessagePriceMustBeGreaterThanZero}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <gallery:PriceInput />
            </atom:FormItem>
            <atom:FormActionsItem>
                <atom:SubmitButton />
            </atom:FormActionsItem>
        </atom:Form>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource OtherFormControlsTitle}"
        Description="{gallery:FormShowCaseLangResource OtherFormControlsDescription}"
        IsOccupyEntireRow="True"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
        <atom:Form LabelColInfo="200"
                   WrapperColInfo="16*"
                   MinWidth="600"
                   HorizontalAlignment="Left">
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextPlainText}"
                           FieldName="plainText">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormAssertValidator AssertResult="False" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:TextBlock Text="{gallery:FormShowCaseLangResource P2TextChina}"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSelect}"
                           FieldName="select"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormNotNullValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseSelectYourCountry}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:Select PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextPleaseSelectACountry}"
                             HorizontalAlignment="Stretch"
                             OptionsSource="{Binding CountryOptions}" />
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSelectMultiple}"
                           FieldName="select-multiple"
                           IsValidateFeedbackEnabled="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormNotNullValidator Message="{gallery:FormShowCaseLangResource P2MessagePleaseSelectYourFavouriteColors}" />
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:Select PlaceholderText="{gallery:FormShowCaseLangResource P2PlaceholderTextPleaseSelectFavouriteColors}"
                             HorizontalAlignment="Stretch"
                             Mode="Multiple"
                             IsAllowClear="True"
                             OptionsSource="{Binding ColorOptions}" />
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextInputNumber}" FieldName="inputNumber">
               <atom:FormItemDecorator>
                   <atom:NumericUpDown Minimum="1" Maximum="10" Width="120"/>
                   <atom:FormItemDecorator.Extra>
                       machines
                   </atom:FormItemDecorator.Extra>
               </atom:FormItemDecorator>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSwitch}" FieldName="switch">
                <atom:ToggleSwitch/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextSlider}" FieldName="slider">
                <atom:Slider Name="FormSliderItem" AttachedToVisualTree="HandleFormSliderItemAttached" Minimum="0" Maximum="100"/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextRadioGroup}" FieldName="radioGroup">
                <atom:RadioButtonGroup>
                    <atom:RadioButton Tag="a" Content="{gallery:FormShowCaseLangResource P2ContentItemN1}" />
                    <atom:RadioButton Tag="b" Content="{gallery:FormShowCaseLangResource P2ContentItemN2}" />
                    <atom:RadioButton Tag="c" Content="{gallery:FormShowCaseLangResource P2ContentItemN3}" />
                </atom:RadioButtonGroup>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextOptionButtonGroup}" FieldName="optionButtonGroup">
                <atom:OptionButtonGroup>
                    <atom:OptionButton Tag="a" Content="{gallery:FormShowCaseLangResource P2ContentItemN1}" />
                    <atom:OptionButton Tag="b" Content="{gallery:FormShowCaseLangResource P2ContentItemN2}" />
                    <atom:OptionButton Tag="c" Content="{gallery:FormShowCaseLangResource P2ContentItemN3}" />
                </atom:OptionButtonGroup>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextCheckboxGroup}" FieldName="checkboxGroup">
                <atom:CheckBoxGroup Width="150" HorizontalAlignment="Left">
                    <atom:CheckBox Tag="a" Content="{gallery:FormShowCaseLangResource P2ContentA}" />
                    <atom:CheckBox Tag="b" IsChecked="True" IsEnabled="False" Content="{gallery:FormShowCaseLangResource P2ContentB}" />
                    <atom:CheckBox Tag="c" Content="{gallery:FormShowCaseLangResource P2ContentC}" />
                    <atom:CheckBox Tag="d" Content="{gallery:FormShowCaseLangResource P2ContentD}" />
                    <atom:CheckBox Tag="e" Content="{gallery:FormShowCaseLangResource P2ContentE}" />
                    <atom:CheckBox Tag="f" Content="{gallery:FormShowCaseLangResource P2ContentF}" />
                </atom:CheckBoxGroup>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextRate}" FieldName="rate">
                <atom:Rate/>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextUpload}" FieldName="upload"
                           Help="{gallery:FormShowCaseLangResource P2HelpLongUpload}">
                <atom:Upload>
                    <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}" Content="{gallery:FormShowCaseLangResource P2ContentClickToUpload}" />
                </atom:Upload>
            </atom:FormItem>
            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextDragger}" FieldName="dragger"
                           Margin="0, 10, 0, 0">
                <atom:Upload Name="DragAndDropUpload">
                    <atom:UploadDefaultDropArea/>
                </atom:Upload>
            </atom:FormItem>

            <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextColorPicker}" FieldName="colorPicker"
                           IsRequired="True">
                <atom:FormItem.Validators>
                    <atom:FormValidatorProvider>
                        <atom:FormNotNullValidator Message="{gallery:FormShowCaseLangResource P2MessageColorIsRequired}"/>
                    </atom:FormValidatorProvider>
                </atom:FormItem.Validators>
                <atom:ColorPicker/>
            </atom:FormItem>

            <atom:FormActionsItem>
                <atom:SubmitButton/>
            </atom:FormActionsItem>
        </atom:Form>


            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:FormShowCaseLangResource SemanticStylingTitle}"
        Description="{gallery:FormShowCaseLangResource SemanticStylingDescription}"
        SourceKey="form-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        Span="Full"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="viewModels:FormViewModel">
                <StackPanel Orientation="Vertical"
                            Spacing="32">
                    <StackPanel.Styles>
                        <Style Selector="atom|Form.semantic-card">
                            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
                            <Setter Property="Padding" Value="{atom:SharedTokenResource Padding}" />
                            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
                            <Setter Property="BoxShadow" Value="0 2 8 0 #1A000000" />
                        </Style>
                        <Style Selector="atom|Form.semantic-function">
                            <Setter Property="BorderBrush" Value="#1677FF" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                        <Style Selector="atom|Form.semantic-object atom|FormItem">
                            <atom:FormItemLabelStyle x:SetterTargetType="TextBlock">
                                <Setter Property="Foreground" Value="#333333" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="TextAlignment" Value="Right" />
                            </atom:FormItemLabelStyle>
                        </Style>
                        <Style Selector="atom|Form.semantic-function atom|FormItem">
                            <atom:FormItemLabelStyle x:SetterTargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1677FF" />
                                <Setter Property="TextAlignment" Value="Right" />
                            </atom:FormItemLabelStyle>
                        </Style>
                        <Style Selector="atom|Form.semantic-card atom|FormItem">
                            <atom:FormItemContentStyle x:SetterTargetType="ContentPresenter">
                                <Setter Property="Padding" Value="12,0,0,0" />
                            </atom:FormItemContentStyle>
                        </Style>
                    </StackPanel.Styles>

                    <atom:Form Classes="semantic-card semantic-object"
                               MaxWidth="800"
                               LabelColInfo="4*"
                               WrapperColInfo="20*">
                        <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextUsername}"
                                       FieldName="username"
                                       IsRequired="True">
                            <atom:FormItem.Validators>
                                <atom:FormValidatorProvider>
                                    <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource SemanticStyleMessagePleaseEnterUsername}" />
                                </atom:FormValidatorProvider>
                            </atom:FormItem.Validators>
                            <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource SemanticStyleUsernamePlaceholder}" />
                        </atom:FormItem>
                        <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextEmail}"
                                       FieldName="email"
                                       IsRequired="True">
                            <atom:FormItem.Validators>
                                <atom:FormValidatorProvider>
                                    <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource SemanticStyleMessagePleaseEnterEmail}" />
                                </atom:FormValidatorProvider>
                            </atom:FormItem.Validators>
                            <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource SemanticStyleEmailPlaceholder}" />
                        </atom:FormItem>
                        <atom:FormActionsItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <atom:SubmitButton Content="{gallery:FormShowCaseLangResource SemanticStyleSubmitButtonText}" />
                                <atom:ResetButton Content="{gallery:FormShowCaseLangResource SemanticStyleResetButtonText}" />
                            </StackPanel>
                        </atom:FormActionsItem>
                    </atom:Form>

                    <atom:Form Classes="semantic-card semantic-function"
                               MaxWidth="800"
                               StyleVariant="Filled"
                               LabelColInfo="4*"
                               WrapperColInfo="20*">
                        <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextUsername}"
                                       FieldName="username"
                                       IsRequired="True">
                            <atom:FormItem.Validators>
                                <atom:FormValidatorProvider>
                                    <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource SemanticStyleMessagePleaseEnterUsername}" />
                                </atom:FormValidatorProvider>
                            </atom:FormItem.Validators>
                            <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource SemanticStyleUsernamePlaceholder}" />
                        </atom:FormItem>
                        <atom:FormItem LabelText="{gallery:FormShowCaseLangResource P2LabelTextEmail}"
                                       FieldName="email"
                                       IsRequired="True">
                            <atom:FormItem.Validators>
                                <atom:FormValidatorProvider>
                                    <atom:FormStringNotEmptyValidator Message="{gallery:FormShowCaseLangResource SemanticStyleMessagePleaseEnterEmail}" />
                                </atom:FormValidatorProvider>
                            </atom:FormItem.Validators>
                            <atom:LineEdit PlaceholderText="{gallery:FormShowCaseLangResource SemanticStyleEmailPlaceholder}" />
                        </atom:FormItem>
                        <atom:FormActionsItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <atom:SubmitButton Content="{gallery:FormShowCaseLangResource SemanticStyleSubmitButtonText}" />
                                <atom:ResetButton Content="{gallery:FormShowCaseLangResource SemanticStyleResetButtonText}" />
                            </StackPanel>
                        </atom:FormActionsItem>
                    </atom:Form>
                </StackPanel>

            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
