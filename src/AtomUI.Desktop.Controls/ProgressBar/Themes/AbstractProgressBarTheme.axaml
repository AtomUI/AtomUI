<!-- The shared base theme of every progress control. Its TargetType has no Token identity: global Tokens are read through
     OwnerTokenResource and resolve to the hosting progress control (ProgressBar, StepsProgressBar, CircleProgress,
     DashboardProgress). The Own Tokens (DefaultColor, RemainingColor, ...) are read by each control's own theme. -->
<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:Class="AtomUI.Desktop.Controls.Themes.AbstractProgressBarTheme"
    TargetType="atomc:AbstractProgressBar"
    x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="atomc:AbstractProgressBar">
            <Canvas>
                <LayoutTransformControl Name="PART_LayoutTransformControl">
                    <Label Name="PART_PercentageLabel"
                           Padding="0"
                           Margin="0"
                           VerticalContentAlignment="Center"
                           IsEnabled="{TemplateBinding IsEnabled}" />
                </LayoutTransformControl>
                <atomc:ProgressInfoPresenter Name="PART_ProgressInfoContentPresenter"
                                  IsVisible="False" />
            </Canvas>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atomc|AbstractProgressBar)">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="ExceptionIconBrush" Value="{atom:OwnerTokenResource ColorError}" />
        <Setter Property="SuccessIconBrush" Value="{atom:OwnerTokenResource ColorSuccess}" />

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <DoubleTransition Property="Value" atom:TokenTransitions.Duration="MotionDurationVerySlow" Easing="ExponentialEaseOut" />
                        <atom:SolidColorBrushTransition Property="StrokeBrush" atom:TokenTransitions.Duration="MotionDurationFast" />
                        <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="MotionDurationFast" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Style Selector="^[IsEnabled=True]">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextLabel}" />
            <Setter Property="SuccessStrokeBrush" Value="{atom:OwnerTokenResource ColorSuccess}" />
        </Style>

        <Style Selector="^[IsCompleted=True]">
            <Style Selector="^ /template/ LayoutTransformControl#PART_LayoutTransformControl">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <!-- Normal and Active keep the StrokeBrush of the control theme (the control's DefaultColor). -->
        <Style Selector="^[Status=Normal]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ExceptionCompletedIconPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^[IsCompleted=True]">
                <Setter Property="StrokeBrush" Value="{atom:OwnerTokenResource ColorSuccess}" />
                <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[Status=Active]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ExceptionCompletedIconPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^[IsCompleted=True]">
                <Setter Property="StrokeBrush" Value="{atom:OwnerTokenResource ColorSuccess}" />
                <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[Status=Exception]">
            <Setter Property="StrokeBrush" Value="{atom:OwnerTokenResource ColorError}" />

            <Style Selector="^ /template/ atom|IconPresenter#PART_ExceptionCompletedIconPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>

            <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^[IsCompleted=True]">
                <Setter Property="StrokeBrush" Value="{atom:OwnerTokenResource ColorSuccess}" />
                <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[Status=Success]">
            <Setter Property="StrokeBrush" Value="{atom:OwnerTokenResource ColorSuccess}" />

            <Style Selector="^ /template/ atom|IconPresenter#PART_ExceptionCompletedIconPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>

            <Style Selector="^[IsCompleted=True]">
                <Setter Property="StrokeBrush" Value="{atom:OwnerTokenResource ColorSuccess}" />
                <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#PART_ExceptionCompletedIconPresenter">
            <Setter Property="IconBrush"
                    Value="{Binding ExceptionIconBrush, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#PART_SuccessCompletedIconPresenter">
            <Setter Property="IconBrush"
                    Value="{Binding SuccessIconBrush, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="GrooveBrush"
                    Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
            <Setter Property="StrokeBrush"
                    Value="{atom:OwnerTokenResource ControlItemBgActiveDisabled}" />
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
            <Setter Property="ExceptionIconBrush" Value="{atom:OwnerTokenResource ControlItemBgActiveDisabled}" />
            <Setter Property="SuccessIconBrush" Value="{atom:OwnerTokenResource ControlItemBgActiveDisabled}" />
        </Style>
    </Style>
</ControlTheme>
