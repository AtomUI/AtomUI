<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SelectFilterTextBox}" TargetType="atom:SelectFilterTextBox">
        <ControlTheme.BasedOn>
            <themes:EmbeddedTextBoxTheme TargetType="{x:Type atom:SelectFilterTextBox}" />
        </ControlTheme.BasedOn>

        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- Embedded in the select frame, which already shows the focus state. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />

        <!-- EmbeddedTextBoxTheme makes the filter IsCustomFontSize: its font is the host's FontSize (template- or
             code-bound by Select, Cascader and TreeSelect), which follows the host's size presets. -->
        <Style Selector="^ /template/ :is(TextPresenter)#PART_TextPresenter">
            <!-- layout -->
            <Setter Property="Margin" Value="2 0 2 0" />
        </Style>

        <Style Selector="^ /template/ atom|TextBlock#Placeholder">
            <!-- layout -->
            <Setter Property="Margin" Value="2 0 2 0" />
        </Style>

        <Style Selector="^[Focusable=False][IsReadOnly=True]">
            <Setter Property="Cursor" Value="Hand" />
            <Style Selector="^ /template/ atom|ScrollViewer#ScrollViewer">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
