<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(AtomUITargetFrameworks)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <RootNamespace>AtomUI.Controls</RootNamespace>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>GeneratedFiles</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../AtomUI.Core/AtomUI.Core.csproj" />
        <ProjectReference Include="../AtomUI.Generator/AtomUI.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AtomUI.Controls" />
        <InternalsVisibleTo Include="AtomUI.Controls.Tests" />
        <InternalsVisibleTo Include="AtomUI.Controls.Shared.Tests" />
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls" />
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls.Tests" />
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls.DataGrid" />
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls.ColorPicker" />
        <InternalsVisibleTo Include="AtomUI.Desktop.Controls.Extras" />
        <InternalsVisibleTo Include="AtomUI.Mobile.Controls" />
        <InternalsVisibleTo Include="AtomUI.Toolkits.GalleryBase" />
        <InternalsVisibleTo Include="AtomUI.AI.Controls" />
        <InternalsVisibleTo Include="AtomUI.AI.Controls.Tests" />
    </ItemGroup>
</Project>
