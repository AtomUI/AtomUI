    <unit id="PageDescription">
      <segment>
        <source>TabControl and CardTabControl provide document-style navigation, item-template tabs, closable tabs, flexible placement, and optional tab bar actions.</source>
        <target state="translated">TabControl 和 CardTabControl 提供文件式導航、資料模板標籤、可關閉標籤、彈性位置以及可選的標籤列操作。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Organize related content into switchable tab panes.</source>
        <target state="translated">將相關內容組織為可切換的標籤頁。</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">範例</target>
      </segment>
    </unit>
    <unit id="SemanticAddDescription">
      <segment>
        <source>Add element, set size, color and corner radius styles for the plus button</source>
        <target state="translated">新增元素，設定加號按鈕的尺寸、顏色與圓角樣式</target>
      </segment>
    </unit>
    <unit id="SemanticCloseDescription">
      <segment>
        <source>Close element, set size and color styles for the close button</source>
        <target state="translated">關閉元素，設定關閉按鈕的尺寸與顏色樣式</target>
      </segment>
    </unit>
    <unit id="SemanticContentDescription">
      <segment>
        <source>Content element, set padding, background and alignment styles for the content panel</source>
        <target state="translated">內容元素，設定內容面板的內邊距、背景與對齊樣式</target>
      </segment>
    </unit>
    <unit id="SemanticHeaderDescription">
      <segment>
        <source>Header container, set background, padding and alignment styles for the tab strip region</source>
        <target state="translated">標頭容器，設定頁籤條區域的背景、內邊距與對齊樣式</target>
      </segment>
    </unit>
    <unit id="SemanticIconDescription">
      <segment>
        <source>Icon element, set size and margin styles for the tab icon</source>
        <target state="translated">圖示元素，設定頁籤圖示的尺寸與間距樣式</target>
      </segment>
    </unit>
    <unit id="SemanticIndicatorDescription">
      <segment>
        <source>Indicator element, set color styles for the selected tab ink bar</source>
        <target state="translated">指示條元素，設定選中頁籤墨條的顏色樣式</target>
      </segment>
    </unit>
    <unit id="SemanticItemDescription">
      <segment>
        <source>Item element, set size, padding, hover state and selected state styles for each tab</source>
        <target state="translated">頁籤元素，設定頁籤的尺寸、內邊距、懸停態與選中態樣式</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Style the root frame, header and content panel through generated Semantic Part styles and root visual properties: dashed frame, header background, bold primary tab labels, item padding, content padding and background. The active ink bar color and thickness are customized through the InkBarColor and InkBarThickness tokens.</source>
        <target state="translated">透過生成的 Semantic Part 樣式與 root 視覺屬性自訂根框架、標頭與內容面板：虛線邊框、標頭背景、加粗主色頁籤文字、頁籤內邊距、內容區內邊距與背景。選中墨條顏色與厚度透過 InkBarColor 與 InkBarThickness Token 自訂。</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
        <target state="translated">自訂語義結構的樣式</target>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>Root element, set overall size, padding, border and background styles</source>
        <target state="translated">根元素，設定整體尺寸、內邊距、邊框與背景樣式</target>
      </segment>
    </unit>
    <unit id="TabControlAddCloseDescription">
      <segment>
        <source>Hide default plus icon, and bind event for customized trigger.</source>
        <target state="translated">隱藏默認加號圖標，並為自定義觸發器綁定事件。</target>
      </segment>
    </unit>
    <unit id="TabControlAddCloseTitle">
      <segment>
        <source>Add and close tab</source>
        <target state="translated">新增和關閉標籤</target>
      </segment>
    </unit>
    <unit id="TabControlBasicDescription">
      <segment>
        <source>Default activate first tab.</source>
        <target state="translated">默認激活第一個標籤頁。</target>
      </segment>
    </unit>
    <unit id="TabControlBasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基礎用法</target>
      </segment>
    </unit>
    <unit id="TabControlCardShapePositionDescription">
      <segment>
        <source>Tab's position: left, right, top or bottom. Will auto switch to top in mobile.</source>
        <target state="translated">標籤位置可設為 left、right、top 或 bottom，在移動端會自動切換為 top。</target>
      </segment>
    </unit>
    <unit id="TabControlCardShapePositionTitle">
      <segment>
        <source>Card Shape Position</source>
        <target state="translated">卡片形態位置</target>
      </segment>
    </unit>
    <unit id="TabControlCardTypeDescription">
      <segment>
        <source>Another type of Tabs, which doesn't support vertical mode.</source>
        <target state="translated">另一種標籤頁類型，不支持垂直模式。</target>
      </segment>
    </unit>
    <unit id="TabControlCardTypeTitle">
      <segment>
