<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StringToTextBlockConverter"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap" />
    <ControlTheme x:Key="{x:Type atom:Expander}" TargetType="atom:Expander">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- ClipContentToCornerRadius is required, not an optional optimization. PART_Frame paints the rounded
                corners itself, but header and body are its child nodes and each has its own background.
                ClipToBounds only clips to a rectangle, not to the corner radius, so without it the opaque
                backgrounds of the children tile out to the square bounds and cover the corners, and the radius
                visually disappears. The default theme's HeaderBg is ColorFillAlter with alpha about 2%, where the
                defect is nearly invisible; it shows as soon as a user sets an opaque background through a Semantic
                Part or IsGhostStyle. With it on, this node clips the whole subtree to the rounded inner frame,
                independent of the expand state and ExpandDirection.
                -->
                <atom:PixelAlignedBorder Name="PART_Frame"
                                         ClipToBounds="True"
                                         ClipContentToCornerRadius="True"
                                         BorderThickness="{TemplateBinding EffectiveBorderThickness}">
                    <DockPanel Name="PART_MainLayout"
                               LastChildFill="True">
                        <LayoutTransformControl Name="PART_HeaderLayoutTransform">
                            <atom:PixelAlignedBorder Name="PART_HeaderDecorator"
                                                     TemplatedControl.IsTemplateFocusTarget="True"
                                                     Classes.semantic-header="True"
                                                     Padding="{TemplateBinding HeaderPadding}">
                                <Grid Name="PART_HeaderLayout"
                                      ColumnDefinitions="Auto, *, Auto, Auto">
                                    <atom:IconButton
                                        Name="PART_ExpandButton"
                                        Classes.semantic-icon="True"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                        Icon="{TemplateBinding ExpandIcon}"
                                        IsVisible="{TemplateBinding IsShowExpandIcon}"
                                        IsEnabled="{TemplateBinding IsEnabled}" />
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      Classes.semantic-title="True"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      HorizontalContentAlignment="Left"
                                                      VerticalContentAlignment="Center"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      Grid.Column="1" />
                                    <ContentPresenter
                                        Name="PART_AddOnContentPresenter"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Content="{TemplateBinding AddOnContent}"
                                        ContentTemplate="{TemplateBinding AddOnContentTemplate}"
                                        Grid.Column="2" />
                                </Grid>
                            </atom:PixelAlignedBorder>
                        </LayoutTransformControl>

                        <atom:ContentViewport
                            Name="PART_ContentViewport"
                            ClipToBounds="True"
                            atom:Motion.IsVisible="{TemplateBinding IsExpanded}"
                            atom:Motion.IsEnabled="{TemplateBinding IsMotionEnabled}"
                            atom:Motion.DurationOverride="{TemplateBinding MotionDuration}">
                            <atom:Motion.Enter>
                                <atom:ExpandMotion />
                            </atom:Motion.Enter>
                            <atom:Motion.Leave>
                                <atom:CollapseMotion />
                            </atom:Motion.Leave>
                            <atom:PixelAlignedBorder
                                BorderBrush="{atom:ExpanderTokenResource ColorBorder}"
                                BorderThickness="{TemplateBinding ContentBorderThickness}">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Classes.semantic-body="True"
                                                  Content="{TemplateBinding Content, Converter={StaticResource StringToTextBlockConverter}}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding ContentPadding}" />
                            </atom:PixelAlignedBorder>
                        </atom:ContentViewport>
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="MotionDuration" Value="{atom:ExpanderTokenResource MotionDurationSlow}" />
        <Setter Property="IsMotionEnabled" Value="{atom:ExpanderTokenResource EnableMotion}" />
        <Setter Property="BorderThickness" Value="{atom:ExpanderTokenResource BorderThickness}" />
        
        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="CornerRadius"
                    Value="{atom:ExpanderTokenResource ExpanderBorderRadius}" />
            <Setter Property="BorderBrush" Value="{atom:ExpanderTokenResource ColorBorder}" />
        </Style>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
            <Setter Property="Background" Value="{atom:ExpanderTokenResource HeaderBg}" />
        </Style>

        <!-- antd: the content paints contentBg; borderless expanders paint headerBg, ghost expanders nothing. -->
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{atom:ExpanderTokenResource ContentBg}" />
        </Style>

        <!-- The header weight sits on the semantic header, so header and title semantic styles still override it. -->
        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
            <Setter Property="TextElement.FontWeight" Value="{atom:ExpanderTokenResource HeaderFontWeight}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{atom:ExpanderTokenResource HeaderColor}" />
            <!-- layout: one pixel optical nudge that centres the title text on the expand icon -->
            <Setter Property="Margin" Value="0, 1, 0, 0" />
        </Style>

        <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
            <Setter Property="IconWidth" Value="{atom:ExpanderTokenResource IconSizeSM}" />
            <Setter Property="IconHeight" Value="{atom:ExpanderTokenResource IconSizeSM}" />
        </Style>

        <Style Selector="^[ExpandIconPosition=Start]">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Margin"
                        Value="{atom:ExpanderTokenResource LeftExpandButtonHMargin}" />
            </Style>
        </Style>

        <Style Selector="^[ExpandIconPosition=End]">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Grid.Column" Value="3" />
                <Setter Property="Margin"
                        Value="{atom:ExpanderTokenResource RightExpandButtonHMargin}" />
            </Style>
        </Style>

        <Style Selector="^:custom-header-padding">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Margin"
                        Value="{TemplateBinding EffectiveExpandButtonMargin}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="Margin" Value="0" />
            </Style>
        </Style>

        <Style Selector="^:up">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style Selector="^ /template/ atom|ContentViewport#PART_ContentViewport">
                <Setter Property="atom:Motion.LayoutDirection" Value="Top" />
            </Style>
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Bottom" />
            </Style>
        </Style>

        <Style Selector="^:down">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^:left">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style Selector="^ /template/ atom|ContentViewport#PART_ContentViewport">
                <Setter Property="atom:Motion.LayoutDirection" Value="Left" />
            </Style>
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Right" />
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
            </Style>
        </Style>

        <Style Selector="^:right">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style Selector="^ /template/ atom|ContentViewport#PART_ContentViewport">
                <Setter Property="atom:Motion.LayoutDirection" Value="Right" />
            </Style>
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
            </Style>
        </Style>

        <Style Selector="^:expanded">
            <Style Selector="^:up">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
                </Style>
            </Style>

            <Style Selector="^:down">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(90deg)" />
                </Style>
            </Style>

            <Style Selector="^:left">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(90deg)" />
                </Style>
            </Style>

            <Style Selector="^:right">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:not(:custom-header-padding)">
            <Style Selector="^[SizeType=Large]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource HeaderPaddingLG}" />
                </Style>

            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                    <Setter Property="Padding" Value="{atom:ExpanderTokenResource HeaderPadding}" />
                </Style>

            </Style>
            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource HeaderPaddingSM}" />
                </Style>

            </Style>
        </Style>

        <Style Selector="^:not(:custom-content-padding)">
            <Style Selector="^[SizeType=Large]">

                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource ContentPaddingLG}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource ContentPadding}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource ContentPaddingSM}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="TextElement.FontSize"
                        Value="{atom:ExpanderTokenResource FontSizeLG}" />
                <Setter Property="TextBlock.LineHeight"
                        Value="{atom:ExpanderTokenResource FontHeightLG}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="TextElement.FontSize"
                        Value="{atom:ExpanderTokenResource FontSize}" />
                <Setter Property="TextBlock.LineHeight"
                        Value="{atom:ExpanderTokenResource FontHeight}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="TextElement.FontSize"
                        Value="{atom:ExpanderTokenResource FontSize}" />
                <Setter Property="TextBlock.LineHeight"
                        Value="{atom:ExpanderTokenResource FontHeight}" />
            </Style>
            
        </Style>

        <!-- One keyboard stop, on the element that toggles: the header in Header mode, the expand button
             in Icon mode. -->
        <Style Selector="^[TriggerType=Header]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </Style>

        <Style Selector="^[TriggerType=Icon]">
            <Setter Property="IsTabStop" Value="False" />
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Style>

        <Style Selector="^[IsBorderless=True]">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{atom:ExpanderTokenResource HeaderBg}" />
            </Style>
        </Style>

        <Style Selector="^[IsGhostStyle=True]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="Background" Value="{atom:ExpanderTokenResource ColorTransparent}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{atom:ExpanderTokenResource ColorTransparent}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:ExpanderTokenResource ColorTextDisabled}" />
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator ContentPresenter">
                <Setter Property="Foreground"
                        Value="{atom:ExpanderTokenResource ColorTextDisabled}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
