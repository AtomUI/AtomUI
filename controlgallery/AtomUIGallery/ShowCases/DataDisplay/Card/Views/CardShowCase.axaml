<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Card.CardShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Card"
             x:DataType="vm:CardViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Card"
                    Category="{gallery:CardShowCaseLangResource ComponentCategory}"
                    Status="{gallery:CardShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:CardShowCaseLangResource PageSubtitle}"
                    Description="{gallery:CardShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="HeaderedContentControl" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:CardViewModel">
                    <StackPanel>
                        <atom:TextBlock Margin="24,24,24,0"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="Card" />
                        <gallery:SemanticPartPreview Name="CardSemanticPreview"
                                                     SemanticOwnerType="{x:Type atom:Card}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:Card Name="CardSemanticOwner"
                                           Width="300"
                                           Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}">
                                    <atom:Card.Extra>
                                        <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                                    </atom:Card.Extra>
                                    <atom:Card.Cover>
                                        <Image Height="140"
                                               Stretch="UniformToFill"
                                               Source="/Assets/CardShowCase/Cover2.png" />
                                    </atom:Card.Cover>
                                    <atom:CardMetaContent Header="{gallery:CardShowCaseLangResource P2HeaderEuropeStreetBeat}"
                                                          Content="{gallery:CardShowCaseLangResource P2ContentThisIsTheDescription}" />
                                    <atom:Card.Actions>
                                        <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EditOutlined}" />
                                        <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}" />
                                        <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EllipsisOutlined}" />
                                    </atom:Card.Actions>
                                </atom:Card>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:CardShowCaseLangResource SemanticCardRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="header"
                                    Description="{gallery:CardShowCaseLangResource SemanticCardHeaderDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="title"
                                    Description="{gallery:CardShowCaseLangResource SemanticCardTitleDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="extra"
                                    Description="{gallery:CardShowCaseLangResource SemanticCardExtraDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="cover"
                                    Description="{gallery:CardShowCaseLangResource SemanticCardCoverDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="body"
                                    Description="{gallery:CardShowCaseLangResource SemanticCardBodyDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="actions"
                                    Description="{gallery:CardShowCaseLangResource SemanticCardActionsDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>

                        <atom:TextBlock Margin="24,0,24,0"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="CardMetaContent" />
                        <gallery:SemanticPartPreview Name="CardMetaSemanticPreview"
                                                     SemanticOwnerType="{x:Type atom:CardMetaContent}"
                                                     SemanticOwner="{Binding #CardMetaSemanticOwner}">
                            <gallery:SemanticPartPreview.PreviewContent>
                                <atom:Card Width="300">
                                    <atom:CardMetaContent Name="CardMetaSemanticOwner"
                                                          Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}"
                                                          Content="{gallery:CardShowCaseLangResource P2ContentThisIsTheDescription}">
                                        <atom:CardMetaContent.Avatar>
                                            <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar1.svg" />
                                        </atom:CardMetaContent.Avatar>
                                    </atom:CardMetaContent>
                                </atom:Card>
                            </gallery:SemanticPartPreview.PreviewContent>
                            <gallery:SemanticPartPreview.PartDescriptions>
                                <gallery:SemanticPartDescription
                                    Path="root"
                                    Description="{gallery:CardShowCaseLangResource SemanticMetaRootDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="section"
                                    Description="{gallery:CardShowCaseLangResource SemanticMetaSectionDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="avatar"
                                    Description="{gallery:CardShowCaseLangResource SemanticMetaAvatarDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="title"
                                    Description="{gallery:CardShowCaseLangResource SemanticMetaTitleDescription}" />
                                <gallery:SemanticPartDescription
                                    Path="description"
                                    Description="{gallery:CardShowCaseLangResource SemanticMetaDescriptionDescription}" />
                            </gallery:SemanticPartPreview.PartDescriptions>
                        </gallery:SemanticPartPreview>
                    </StackPanel>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource BasicTitle}"
                                      Description="{gallery:CardShowCaseLangResource BasicDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <WrapPanel ItemSpacing="20" LineSpacing="20">
                        <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderLargeSizeCard}" SizeType="Large" Width="300">
                            <atom:Card.Extra>
                                <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                            </atom:Card.Extra>
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                            </StackPanel>
                        </atom:Card>

                        <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderDefaultSizeCard}" SizeType="Middle" Width="300">
                            <atom:Card.Extra>
                                <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                            </atom:Card.Extra>
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                            </StackPanel>
                        </atom:Card>

                        <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderSmallSizeCard}" SizeType="Small" Width="300">
                            <atom:Card.Extra>
                                <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                            </atom:Card.Extra>
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                            </StackPanel>
                        </atom:Card>
                    </WrapPanel>

                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource NoBorderTitle}"
                                      Description="{gallery:CardShowCaseLangResource NoBorderDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <Border Padding="20" Background="{Binding BorderlessFrameBg}">
                        <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}" Width="300" StyleVariant="Borderless" HorizontalAlignment="Left">
                            <atom:Card.Extra>
                                <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                            </atom:Card.Extra>
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                            </StackPanel>
                        </atom:Card>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource SimpleCardTitle}"
                                      Description="{gallery:CardShowCaseLangResource SimpleCardDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <atom:Card Width="300" HorizontalAlignment="Left">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                            <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                            <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                        </StackPanel>
                    </atom:Card>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource CustomizedContentTitle}"
                                      Description="{gallery:CardShowCaseLangResource CustomizedContentDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <atom:Card Width="240" IsHoverable="True" HorizontalAlignment="Left">
                        <atom:Card.Cover>
                            <Image Source="/Assets/CardShowCase/Cover1.png" />
                        </atom:Card.Cover>
                        <atom:CardMetaContent Header="{gallery:CardShowCaseLangResource P2HeaderEuropeStreetBeat}"
                                              Content="www.instagram.com" />
                    </atom:Card>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource CardInColumnTitle}"
                                      Description="{gallery:CardShowCaseLangResource CardInColumnDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <Border Padding="20" Background="{Binding BorderlessFrameBg}">
                        <Grid RowDefinitions="*" ColumnDefinitions="*, *, *" ColumnSpacing="20">
                            <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}" StyleVariant="Borderless" Grid.Row="0" Grid.Column="0"
                                       HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Vertical" Spacing="3">
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                </StackPanel>
                            </atom:Card>
                            <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}" StyleVariant="Borderless" Grid.Row="0" Grid.Column="1"
                                       HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Vertical" Spacing="3">
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                </StackPanel>
                            </atom:Card>
                            <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}" StyleVariant="Borderless" Grid.Row="0" Grid.Column="2"
                                       HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Vertical" Spacing="3">
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                </StackPanel>
                            </atom:Card>
                        </Grid>
                    </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource GridCardTitle}"
                                      Description="{gallery:CardShowCaseLangResource GridCardDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <atom:Card HorizontalAlignment="Stretch" Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle2}" SizeType="Large">
                        <atom:CardGridContent ColumnDefinitions="*, *, *, *"
                                              RowDefinitions="Auto, Auto">
                            <atom:CardGridItem Row="0" Column="0" Content="{gallery:CardShowCaseLangResource P2ContentContent}" />
                            <atom:CardGridItem Row="0" Column="1" IsHoverable="False" Content="{gallery:CardShowCaseLangResource P2ContentContent}" />
                            <atom:CardGridItem Row="0" Column="2" Content="{gallery:CardShowCaseLangResource P2ContentContent}" />
                            <atom:CardGridItem Row="0" Column="3" Content="{gallery:CardShowCaseLangResource P2ContentContent}" />
                            <atom:CardGridItem Row="1" Column="0" Content="{gallery:CardShowCaseLangResource P2ContentContent}" />
                            <atom:CardGridItem Row="1" Column="1" Content="{gallery:CardShowCaseLangResource P2ContentContent}" />
                            <atom:CardGridItem Row="1" Column="2" Content="{gallery:CardShowCaseLangResource P2ContentContent}" />
                        </atom:CardGridContent>
                    </atom:Card>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource InnerCardTitle}"
                                      Description="{gallery:CardShowCaseLangResource InnerCardDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}" HorizontalAlignment="Stretch" SizeType="Large">
                        <StackPanel Orientation="Vertical" Spacing="20">
                            <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}" HorizontalAlignment="Stretch" IsInnerMode="True">
                                <atom:Card.Extra>
                                    <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                                </atom:Card.Extra>
                                <StackPanel Orientation="Vertical" Spacing="3">
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                </StackPanel>
                            </atom:Card>

                            <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}" HorizontalAlignment="Stretch" IsInnerMode="True">
                                <atom:Card.Extra>
                                    <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                                </atom:Card.Extra>
                                <StackPanel Orientation="Vertical" Spacing="3">
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextCardContent}" />
                                </StackPanel>
                            </atom:Card>
                        </StackPanel>
                    </atom:Card>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource LoadingCardTitle}"
                                      Description="{gallery:CardShowCaseLangResource LoadingCardDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <StackPanel Orientation="Vertical" Spacing="20">
                        <atom:ToggleSwitch IsChecked="{Binding IsLoading, Mode=TwoWay}" />
                        <atom:Card MinWidth="300" IsLoading="{Binding IsLoading}" HorizontalAlignment="Left">
                            <atom:CardMetaContent Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}">
                                <atom:CardMetaContent.Avatar>
                                    <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar1.svg" />
                                </atom:CardMetaContent.Avatar>
                                <StackPanel Orientation="Vertical" Spacing="3">
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextThisIsTheDescription}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextThisIsTheDescription}" />
                                </StackPanel>
                            </atom:CardMetaContent>
                            <atom:Card.Actions>
                                <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EditOutlined}" />
                                <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}" />
                                <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EllipsisOutlined}" />
                            </atom:Card.Actions>
                        </atom:Card>

                        <atom:Card MinWidth="300" IsLoading="{Binding IsLoading}" HorizontalAlignment="Left">
                            <atom:CardMetaContent Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}">
                                <atom:CardMetaContent.Avatar>
                                    <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar2.svg" />
                                </atom:CardMetaContent.Avatar>
                                <StackPanel Orientation="Vertical" Spacing="3">
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextThisIsTheDescription}" />
                                    <atom:TextBlock Text="{gallery:CardShowCaseLangResource P2TextThisIsTheDescription}" />
                                </StackPanel>
                            </atom:CardMetaContent>
                            <atom:Card.Actions>
                                <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EditOutlined}" />
                                <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}" />
                                <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EllipsisOutlined}" />
                            </atom:Card.Actions>
                        </atom:Card>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource WithTabsTitle}"
                                      Description="{gallery:CardShowCaseLangResource WithTabsDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <StackPanel Orientation="Vertical" Spacing="20">
                        <atom:Card Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}" HorizontalAlignment="Stretch" SizeType="Large">
                            <atom:Card.Extra>
                                <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                            </atom:Card.Extra>
                            <atom:CardTabsContent>
                                <atom:TabItem Header="{gallery:CardShowCaseLangResource P2HeaderTab1}" Content="{gallery:CardShowCaseLangResource P2ContentContent1}" />
                                <atom:TabItem Header="{gallery:CardShowCaseLangResource P2HeaderTab2}" Content="{gallery:CardShowCaseLangResource P2ContentContent2}" />
                            </atom:CardTabsContent>
                        </atom:Card>

                        <atom:Card HorizontalAlignment="Stretch">
                            <atom:CardTabsContent>
                                <atom:CardTabsContent.TabBarExtraContent>
                                    <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                                </atom:CardTabsContent.TabBarExtraContent>
                                <atom:TabItem Header="{gallery:CardShowCaseLangResource P2HeaderArticle}" Content="{gallery:CardShowCaseLangResource P2ContentArticleContent}" />
                                <atom:TabItem Header="{gallery:CardShowCaseLangResource P2HeaderApp}" Content="{gallery:CardShowCaseLangResource P2ContentAppContent}" />
                                <atom:TabItem Header="{gallery:CardShowCaseLangResource P2HeaderProject}" Content="{gallery:CardShowCaseLangResource P2ContentProjectContent}" />
                            </atom:CardTabsContent>
                        </atom:Card>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource MoreContentConfigurationTitle}"
                                      Description="{gallery:CardShowCaseLangResource MoreContentConfigurationDescription}"
                                      IsOccupyEntireRow="True"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                    <atom:Card Width="300" HorizontalAlignment="Left">
                        <atom:Card.Cover>
                            <Image Source="/Assets/CardShowCase/Cover2.png" />
                        </atom:Card.Cover>

                        <atom:CardMetaContent Header="{gallery:CardShowCaseLangResource P2HeaderCardTitle}"
                                              Content="{gallery:CardShowCaseLangResource P2ContentThisIsTheDescription}">
                            <atom:CardMetaContent.Avatar>
                                <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar1.svg" />
                            </atom:CardMetaContent.Avatar>
                        </atom:CardMetaContent>
                        <atom:Card.Actions>
                            <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EditOutlined}" />
                            <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}" />
                            <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EllipsisOutlined}" />
                        </atom:Card.Actions>
                    </atom:Card>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CardShowCaseLangResource SemanticPartStyleTitle}"
                                      Description="{gallery:CardShowCaseLangResource SemanticPartStyleDescription}"
                                      SourceKey="card-semantic-part"
                                      BadgeText="v6.1.3"
                                      Span="Full"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CardViewModel">
                            <WrapPanel ItemSpacing="16"
                                       LineSpacing="16">
                                <WrapPanel.Styles>
                                    <Style Selector="atom|Card.semantic-card">
                                        <Setter Property="Width" Value="300" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush"
                                                Value="{atom:SharedTokenResource ColorBorderSecondary}" />
                                        <Setter Property="CornerRadius"
                                                Value="{atom:SharedTokenResource BorderRadius}" />
                                        <Setter Property="BoxShadow" Value="0 2 8 0 #1A000000" />
                                        <atom:CardHeaderStyle x:SetterTargetType="atom:DashedBorder">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="24,0,24,8" />
                                        </atom:CardHeaderStyle>
                                        <atom:CardBodyStyle x:SetterTargetType="Border">
                                            <Setter Property="Padding" Value="24,0,24,24" />
                                        </atom:CardBodyStyle>
                                    </Style>
                                    <Style Selector="atom|Card.semantic-object">
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="BoxShadow" Value="0 2 8 0 #0F000000" />
                                        <atom:CardTitleStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </atom:CardTitleStyle>
                                    </Style>
                                    <Style Selector="atom|Card.semantic-function[StyleVariant=Outlined]">
                                        <Setter Property="Width" Value="300" />
                                        <Setter Property="BorderBrush" Value="#696FC7" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="BoxShadow" Value="0 2 8 0 #A7AAE1" />
                                        <atom:CardExtraStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#696FC7" />
                                        </atom:CardExtraStyle>
                                        <atom:CardTitleStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#A7AAE1" />
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </atom:CardTitleStyle>
                                    </Style>
                                    <Style Selector="atom|CardMetaContent.semantic-meta">
                                        <atom:CardMetaContentTitleStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#A7AAE1" />
                                        </atom:CardMetaContentTitleStyle>
                                        <atom:CardMetaContentDescriptionStyle x:SetterTargetType="ContentPresenter">
                                            <Setter Property="Foreground" Value="#A7AAE1" />
                                        </atom:CardMetaContentDescriptionStyle>
                                    </Style>
                                </WrapPanel.Styles>

                                <atom:Card Classes="semantic-card semantic-object"
                                           SizeType="Large"
                                           Header="{gallery:CardShowCaseLangResource P2HeaderObjectCard}"
                                           StyleVariant="Borderless">
                                    <atom:Card.Extra>
                                        <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}" />
                                    </atom:Card.Extra>
                                    <atom:CardMetaContent Header="{gallery:CardShowCaseLangResource P2HeaderObjectCardMeta}"
                                                          Content="{gallery:CardShowCaseLangResource P2ContentThisIsTheDescription}">
                                        <atom:CardMetaContent.Avatar>
                                            <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar1.svg" />
                                        </atom:CardMetaContent.Avatar>
                                    </atom:CardMetaContent>
                                    <atom:Card.Actions>
                                        <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=HeartOutlined}"
                                                               IconBrush="#ff6b6b" />
                                        <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=ShareAltOutlined}"
                                                               IconBrush="#4ecdc4" />
                                        <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EditOutlined}"
                                                               IconBrush="#45b7d1" />
                                    </atom:Card.Actions>
                                </atom:Card>

                                <atom:Card Classes="semantic-card semantic-function"
                                           SizeType="Large"
                                           Header="{gallery:CardShowCaseLangResource P2HeaderFunctionCard}">
                                    <atom:Card.Extra>
                                        <atom:HyperLinkButton Content="{gallery:CardShowCaseLangResource P2ContentMore}"
                                                              Foreground="#A7AAE1" />
                                    </atom:Card.Extra>
                                    <atom:CardMetaContent Classes="semantic-meta"
                                                          Header="{gallery:CardShowCaseLangResource P2HeaderFunctionCardMeta}"
                                                          Content="{gallery:CardShowCaseLangResource P2ContentThisIsTheDescription}">
                                        <atom:CardMetaContent.Avatar>
                                            <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar1.svg" />
                                        </atom:CardMetaContent.Avatar>
                                    </atom:CardMetaContent>
                                    <atom:Card.Actions>
                                        <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=HeartOutlined}"
                                                               IconBrush="#ff6b6b" />
                                        <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=ShareAltOutlined}"
                                                               IconBrush="#4ecdc4" />
                                        <atom:CardActionButton Icon="{antdicons:AntDesignIconProvider Kind=EditOutlined}"
                                                               IconBrush="#45b7d1" />
                                    </atom:Card.Actions>
                                </atom:Card>
                            </WrapPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
