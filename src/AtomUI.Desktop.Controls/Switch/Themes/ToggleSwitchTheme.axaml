<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ToggleSwitch}" TargetType="atom:ToggleSwitch">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                              IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"/>
                    <atom:ToggleSwitchContentPanel Name="PART_MainContainer"
                                                   ClipToBounds="True"
                                                   OnContentOffset="{TemplateBinding OnContentOffset}"
                                                   OffContentOffset="{TemplateBinding OffContentOffset}">
                        <ContentPresenter Name="PART_OnContentPresenter"
                                          Classes.semantic-content="True"
                                          Content="{TemplateBinding OnContent}"
                                          ContentTemplate="{TemplateBinding OnContentTemplate}"
                                          IsVisible="{TemplateBinding OnContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter Name="PART_OffContentPresenter"
                                          Classes.semantic-content="True"
                                          Content="{TemplateBinding OffContent}"
                                          ContentTemplate="{TemplateBinding OffContentTemplate}"
                                          IsVisible="{TemplateBinding OffContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </atom:ToggleSwitchContentPanel>
                    <atom:SwitchKnob Name="PART_SwitchKnob"
                                     atom:TransitionInitialization.Mode="Owner"
                                     Classes.semantic-indicator="True"
                                     IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                     KnobWidthExtension="{TemplateBinding KnobWidthExtension}"
                                     RenderTransform="{TemplateBinding KnobRenderTransform}"
                                     RenderTransformOrigin="0%,0%"
                                     IsCheckedState="{TemplateBinding IsChecked}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{atom:ToggleSwitchTokenResource ColorTextLightSolid}" />
        <Style Selector="^[IsChecked=False]">
            <Setter Property="Foreground" Value="{atom:ToggleSwitchTokenResource UncheckedContentColor}" />
        </Style>
        <Setter Property="IsMotionEnabled" Value="{atom:ToggleSwitchTokenResource EnableMotion}" />
        <Setter Property="IsWaveSpiritEnabled"
                Value="{atom:ToggleSwitchTokenResource EnableWaveSpirit}" />
        
        <Style Selector="^ /template/ atom|WaveSpiritDecorator#PART_WaveSpirit">
            <Setter Property="WaveType" Value="PillWave"/>
        </Style>

        <Setter Property="TrackPadding" Value="{atom:ToggleSwitchTokenResource TrackPadding}" />
        <Setter Property="EnableHandlePressStretch" Value="{atom:ToggleSwitchTokenResource EnableHandlePressStretch}" />
        <Setter Property="UseContentMarginTokenResources" Value="True" />

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <TransformOperationsTransition Property="KnobRenderTransform" atom:TokenTransitions.Duration="MotionDurationMid"/>
                        <DoubleTransition Property="KnobWidthExtension" atom:TokenTransitions.Duration="MotionDurationMid"/>
                        <PointTransition Property="OnContentOffset" atom:TokenTransitions.Duration="MotionDurationMid"/>
                        <PointTransition Property="OffContentOffset" atom:TokenTransitions.Duration="MotionDurationMid"/>
                        <atom:SolidColorBrushTransition Property="GrooveBackground" atom:TokenTransitions.Duration="MotionDurationMid"/>
                        <DoubleTransition Property="Opacity" atom:TokenTransitions.Duration="MotionDurationMid"/>
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <!-- As in antd, a disabled or loading switch is dimmed once as a whole (groove, knob and content). -->
        <Style Selector="^[IsLoading=True], ^:disabled">
            <Setter Property="Opacity"
                    Value="{atom:ToggleSwitchTokenResource SwitchDisabledOpacity}" />
        </Style>

        <Style Selector="^[IsChecked=True]">
            <Setter Property="GrooveBackground"
                    Value="{atom:ToggleSwitchTokenResource SwitchColor}" />
        </Style>

        <Style Selector="^[IsChecked=True]:pointerover">
            <Setter Property="GrooveBackground"
                    Value="{atom:ToggleSwitchTokenResource TrackCheckedHoverBg}" />
        </Style>

        <Style Selector="^[IsChecked=False]">
            <Setter Property="GrooveBackground"
                    Value="{atom:ToggleSwitchTokenResource TrackBg}" />
        </Style>

        <Style Selector="^[IsChecked=False]:pointerover">
            <Setter Property="GrooveBackground"
                    Value="{atom:ToggleSwitchTokenResource TrackHoverBg}" />
        </Style>

        <!-- The track outline (none by default: TrackBorderThickness 0) lies inside the track. -->
        <Setter Property="GrooveBorderThickness" Value="{atom:ToggleSwitchTokenResource TrackBorderThickness}" />
        <Setter Property="GrooveBorderBrush" Value="{atom:ToggleSwitchTokenResource TrackBorderColor}" />
        <Style Selector="^[IsChecked=True]">
            <Setter Property="GrooveBorderBrush"
                    Value="{atom:ToggleSwitchTokenResource TrackCheckedBorderColor}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize"
                    Value="{atom:ToggleSwitchTokenResource ExtraInfoFontSizeSM}" />
            <Setter Property="KnobSize" Value="{atom:ToggleSwitchTokenResource HandleSizeSM}" />
            <Setter Property="TrackHeight" Value="{atom:ToggleSwitchTokenResource TrackHeightSM}" />
            <Setter Property="TrackMinWidth"
                    Value="{atom:ToggleSwitchTokenResource TrackMinWidthSM}" />
            <Setter Property="IconSize" Value="{atom:ToggleSwitchTokenResource ContentIconSizeSM}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom], ^[SizeType=Large]">
            <Setter Property="FontSize"
                    Value="{atom:ToggleSwitchTokenResource ExtraInfoFontSize}" />
            <Setter Property="KnobSize" Value="{atom:ToggleSwitchTokenResource HandleSize}" />
            <Setter Property="TrackHeight" Value="{atom:ToggleSwitchTokenResource TrackHeight}" />
            <Setter Property="TrackMinWidth"
                    Value="{atom:ToggleSwitchTokenResource TrackMinWidth}" />
            <Setter Property="IconSize" Value="{atom:ToggleSwitchTokenResource ContentIconSize}" />
        </Style>

        <Style Selector="^ /template/ atom|SwitchKnob#PART_SwitchKnob">
            <Setter Property="Background"
                    Value="{atom:ToggleSwitchTokenResource HandleBg}" />
            <Setter Property="KnobBoxShadow"
                    Value="{atom:ToggleSwitchTokenResource HandleShadow}" />
            <Setter Property="LoadIndicatorBrush"
                    Value="{atom:ToggleSwitchTokenResource OffStateLoadIndicatorColor}" />
            <Style Selector="^[IsCheckedState=True]">
                <Setter Property="Background"
                        Value="{atom:ToggleSwitchTokenResource HandleCheckedBg}" />
                <Setter Property="LoadIndicatorBrush"
                        Value="{atom:ToggleSwitchTokenResource SwitchColor}" />
            </Style>
        </Style>

        <Style Selector="^:pointerover /template/ atom|SwitchKnob#PART_SwitchKnob">
            <Setter Property="Background"
                    Value="{atom:ToggleSwitchTokenResource HandleHoverBg}" />
            <Style Selector="^[IsCheckedState=True]">
                <Setter Property="Background"
                        Value="{atom:ToggleSwitchTokenResource HandleCheckedHoverBg}" />
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
