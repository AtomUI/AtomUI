<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.ComboBox.ComboBoxShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.ComboBox"
             x:DataType="vm:ComboBoxViewModel"
             x:CompileBindings="True">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="ComboBox"
                    Category="{gallery:ComboBoxShowCaseLangResource ComponentCategory}"
                    Status="{gallery:ComboBoxShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:ComboBoxShowCaseLangResource PageSubtitle}"
                    Description="{gallery:ComboBoxShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="ComboBox" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:ComboBoxViewModel">
                    <gallery:SemanticPartPreview Name="ComboBoxSemanticPreview"
                                                 Title="ComboBox"
                                                 SemanticOwner="{Binding #ComboBoxSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:ComboBox}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <!--
                                按 AtomUI 标准方式钉住模板内 Popup：IsPopupPinnedOpen 与 Select / AutoComplete 等
                                控件一致为 public。控件在弹层打开前先抑制 light-dismiss（ApplyPopupPinnedOpenSettings），
                                因此钉住的弹层不会创建遮罩，也不会阻断卡片悬停。
                                过滤模式开启以便 input 部件可见（与 placeholder 互斥）。
                            -->
                            <atom:ComboBox Name="ComboBoxSemanticOwner"
                                           Width="320"
                                           IsMotionEnabled="False"
                                           IsEditable="True"
                                           IsFilterEnabled="True"
                                           IsPopupPinnedOpen="True"
                                           IsDropDownOpen="True"
                                           ContentLeftAddOn="prefix"
                                           ItemsSource="{Binding SemanticPreviewItems}"
                                           PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}">
                                <atom:ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <atom:TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </atom:ComboBox.ItemTemplate>
                            </atom:ComboBox>
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="prefix"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticPrefixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="frame"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticFrameDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="placeholder"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticPlaceholderDescription}" />
                            <gallery:SemanticPartDescription
                                Path="input"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticInputDescription}" />
                            <gallery:SemanticPartDescription
                                Path="suffix"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticSuffixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="indicator"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticIndicatorDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.root"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticPopupRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.list"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticPopupListDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.listItem"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticPopupListItemDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.empty"
                                Description="{gallery:ComboBoxShowCaseLangResource SemanticPopupEmptyDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource BasicTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource BasicDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300">
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
        </atom:ComboBox>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource ItemsSourceTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource ItemsSourceDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <atom:ComboBox Name="TplComboBox"
                       PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                       ItemsSource="{Binding ComboBoxItems}">
            <atom:ComboBox.ItemTemplate>
                <DataTemplate>
                    <atom:TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                </DataTemplate>
            </atom:ComboBox.ItemTemplate>
        </atom:ComboBox>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource BindingTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource BindingDescription}"
        BadgeText="v6.0.8"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <StackPanel Spacing="8" MinWidth="320">
            <TextBlock Text="{gallery:ComboBoxShowCaseLangResource BindingSelectedItemLabel}"
                       FontWeight="SemiBold" />
            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                           Width="300"
                           IsAllowClear="True"
                           ItemsSource="{Binding ComboBoxItems}"
                           SelectedItem="{Binding BoundSelectedItem}">
                <atom:ComboBox.ItemTemplate>
                    <DataTemplate>
                        <atom:TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                    </DataTemplate>
                </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>
            <WrapPanel ItemSpacing="8">
                <atom:Button SizeType="Small"
                             Command="{Binding SetBoundSelectedItemCommand}"
                             Content="{gallery:ComboBoxShowCaseLangResource BindingSetButton}" />
                <atom:Button SizeType="Small"
                             Command="{Binding ClearBoundSelectedItemCommand}"
                             Content="{gallery:ComboBoxShowCaseLangResource BindingClearButton}" />
            </WrapPanel>
            <TextBlock Text="{gallery:ComboBoxShowCaseLangResource BindingViewModelValueLabel}" />
            <TextBlock Text="{Binding BoundSelectedItemText}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource EditableFilterTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource EditableFilterDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextTypeToFilter}"
                       Width="300"
                       IsEditable="True"
                       IsFilterEnabled="True">
            <atom:ComboBoxItem Content="Alpha" />
            <atom:ComboBoxItem Content="Alpine" />
            <atom:ComboBoxItem Content="Beta" />
            <atom:ComboBoxItem Content="Gamma" />
            <atom:ComboBoxItem Content="Delta" />
        </atom:ComboBox>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource DisabledTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource DisabledDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300" IsEnabled="False">
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
            <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
        </atom:ComboBox>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource ThreeSizesTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource ThreeSizesDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:ComboBox SizeType="Large" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderSizeTypeLarge}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>
            <atom:ComboBox SizeType="Middle" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderSizeTypeMiddle}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>
            <atom:ComboBox SizeType="Small" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderSizeTypeSmall}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>
            <atom:ComboBox SizeType="Custom"
                           Height="36"
                           FontSize="15"
                           PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderSizeTypeCustom}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource VariantsTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource VariantsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ComboBox StyleVariant="Outlined" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox StyleVariant="Filled" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox StyleVariant="Borderless" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource PrePostTabTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource PrePostTabDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           LeftAddOn="http://"
                           RightAddOn=".com">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           RightAddOn="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           LeftAddOn="http://"
                           ContentRightAddOn=".com">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>


    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource PrefixSuffixTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource PrefixSuffixDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=UserOutlined, FillBrush=#D7D7D7}"
                           ContentRightAddOn="{antdicons:AntDesignIconProvider Kind=InfoCircleOutlined, FillBrush=#8C8C8C}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           ContentLeftAddOn="￥"
                           ContentRightAddOn="RMB">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           ContentLeftAddOn="￥"
                           ContentRightAddOn="RMB" IsEnabled="False">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource StatusTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource StatusDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           Status="Error">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           Status="Warning">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           Status="Error"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           Status="Warning"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           Status="Error"
                           StyleVariant="Filled"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           Status="Warning"
                           StyleVariant="Filled"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           Status="Error"
                           StyleVariant="Borderless"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           Status="Warning"
                           StyleVariant="Borderless"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>

        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
        Title="{gallery:ComboBoxShowCaseLangResource StyleClassTitle}"
        Description="{gallery:ComboBoxShowCaseLangResource StyleClassDescription}"
        SourceKey="combo-box-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:ComboBoxViewModel">
        <StackPanel HorizontalAlignment="Left" Spacing="20">
            <!--
                边框定制示例刻意选用非 primary 色：outlined 默认边框是灰、聚焦后是 ColorPrimary(蓝)，
                若仍用蓝色会与聚焦态无法区分，看不出定制是否生效。
            -->
            <StackPanel.Styles>
                <Style Selector="atom|ComboBox.semantic-styles-demo">
                    <atom:ComboBoxFrameStyle x:SetterTargetType="atom:PixelAlignedBorder">
                        <Setter Property="BorderBrush" Value="#52C41A" />
                    </atom:ComboBoxFrameStyle>
                    <atom:ComboBoxPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#52C41A" />
                        </Style>
                    </atom:ComboBoxPrefixStyle>
                    <atom:ComboBoxSuffixStyle x:SetterTargetType="StackPanel">
                        <Setter Property="TextElement.Foreground" Value="#52C41A" />
                    </atom:ComboBoxSuffixStyle>
                    <atom:ComboBoxIndicatorStyle x:SetterTargetType="atom:IconButton">
                        <Setter Property="IconBrush" Value="#52C41A" />
                    </atom:ComboBoxIndicatorStyle>
                </Style>
                <Style Selector="atom|ComboBox.semantic-styles-filled-demo">
                    <atom:ComboBoxFrameStyle x:SetterTargetType="atom:PixelAlignedBorder">
                        <Setter Property="BorderBrush" Value="#722ED1" />
                    </atom:ComboBoxFrameStyle>
                    <atom:ComboBoxPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#722ED1" />
                        </Style>
                    </atom:ComboBoxPrefixStyle>
                    <atom:ComboBoxSuffixStyle x:SetterTargetType="StackPanel">
                        <Setter Property="TextElement.Foreground" Value="#722ED1" />
                    </atom:ComboBoxSuffixStyle>
                    <atom:ComboBoxIndicatorStyle x:SetterTargetType="atom:IconButton">
                        <Setter Property="IconBrush" Value="#722ED1" />
                    </atom:ComboBoxIndicatorStyle>
                    <atom:ComboBoxPopupRootStyle x:SetterTargetType="Border">
                        <Setter Property="BorderBrush" Value="#722ED1" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:ComboBoxPopupRootStyle>
                </Style>
            </StackPanel.Styles>
            <atom:ComboBox Classes="semantic-styles-demo"
                           Name="ObjectStylesComboBox"
                           Width="300"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                           ItemsSource="{Binding StyleClassItems}"
                           PlaceholderText="Object">
                <atom:ComboBox.ItemTemplate>
                    <DataTemplate>
                        <atom:TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                    </DataTemplate>
                </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>
            <atom:ComboBox Classes="semantic-styles-demo semantic-styles-filled-demo"
                           Name="FunctionStylesComboBox"
                           Width="300"
                           StyleVariant="Filled"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                           ItemsSource="{Binding StyleClassItems}"
                           PlaceholderText="Function">
                <atom:ComboBox.ItemTemplate>
                    <DataTemplate>
                        <atom:TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                    </DataTemplate>
                </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
