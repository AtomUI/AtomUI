<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:system="using:System"
    x:Class="AtomUI.Desktop.Controls.Themes.AbstractSkeletonTheme"
    TargetType="atom:AbstractSkeleton"
    x:ClassModifier="internal">
    
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:AbstractSkeleton">
            <Panel Name="PART_RootLayout">
                <Border Name="PART_ActiveAnimationLayer"
                        Classes.semantic-content="True"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="{TemplateBinding IsActive}"/>
                <Border Name="PART_ContentLayer"
                        Classes.semantic-content="True"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="{TemplateBinding IsActive, Converter={x:Static BoolConverters.Not}}"/>
            </Panel>
        </ControlTemplate>
    </Setter>
    
    <Style Selector="^:is(atom|AbstractSkeleton)">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="{atom:SkeletonTokenResource GradientFromColor}"/>
        <Setter Property="MotionDuration" Value="{atom:SkeletonTokenResource LoadingMotionDuration}"/>
        <Setter Property="LoadingBackgroundStart" Value="{atom:SkeletonTokenResource LoadingBackgroundStart}"/>
        <Setter Property="LoadingBackgroundMiddle" Value="{atom:SkeletonTokenResource LoadingBackgroundMiddle}"/>
        <Setter Property="LoadingBackgroundEnd" Value="{atom:SkeletonTokenResource LoadingBackgroundEnd}"/>

        <Style Selector="^:is(atom|AbstractSkeleton).semantic-preview-owner">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MaxWidth" Value="{x:Static system:Double.PositiveInfinity}" />
        </Style>
    </Style>
</ControlTheme>
