<!-- owner: this shared theme also serves SubmitButton and ResetButton; each terminal supplies its Own inputs. -->
<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:antdicons="https://atomui.net/icons/antdesign"
              x:Class="AtomUI.Desktop.Controls.Themes.ButtonTheme"
              TargetType="atom:Button">
        <Setter Property="atom:ButtonThemeInputs.ThemeBorderColorDisabled" Value="{atom:ButtonTokenResource BorderColorDisabled}" />
        <Setter Property="atom:ButtonThemeInputs.ThemeCirclePadding" Value="{atom:ButtonTokenResource CirclePadding}" />
        <Setter Property="atom:ButtonThemeInputs.ThemeContentFontSize" Value="{atom:ButtonTokenResource ContentFontSize}" />
        <Setter Property="atom:ButtonThemeInputs.ThemeContentPadding" Value="{atom:ButtonTokenResource ContentPadding}" />
        <Setter Property="atom:ButtonThemeInputs.ThemeDefaultBorderColorDisabled" Value="{atom:ButtonTokenResource DefaultBorderColorDisabled}" />
        <Setter Property="atom:ButtonThemeInputs.ThemeFontWeight" Value="{atom:ButtonTokenResource FontWeight}" />
        <Setter Property="atom:ButtonThemeInputs.ThemeIconEndMargin" Value="{atom:ButtonTokenResource IconEndMargin}" />
        <Setter Property="atom:ButtonThemeInputs.ThemeIconMargin" Value="{atom:ButtonTokenResource IconMargin}" />
        <Setter Property="atom:ButtonThemeInputs.ThemeIconOnyPadding" Value="{atom:ButtonTokenResource IconOnyPadding}" />
        <Setter Property="atom:ButtonThemeInputs.ThemeOnlyIconSize" Value="{atom:ButtonTokenResource OnlyIconSize}" />

        <Style Selector="^[SizeType=Small]">
            <Setter Property="atom:ButtonThemeInputs.ThemeContentFontSize" Value="{atom:ButtonTokenResource ContentFontSizeSM}" />
            <Setter Property="atom:ButtonThemeInputs.ThemeContentPadding" Value="{atom:ButtonTokenResource ContentPaddingSM}" />
            <Setter Property="atom:ButtonThemeInputs.ThemeIconOnyPadding" Value="{atom:ButtonTokenResource IconOnyPaddingSM}" />
            <Setter Property="atom:ButtonThemeInputs.ThemeOnlyIconSize" Value="{atom:ButtonTokenResource OnlyIconSizeSM}" />
        </Style>
        <Style Selector="^[SizeType=Large]">
            <Setter Property="atom:ButtonThemeInputs.ThemeContentFontSize" Value="{atom:ButtonTokenResource ContentFontSizeLG}" />
            <Setter Property="atom:ButtonThemeInputs.ThemeContentPadding" Value="{atom:ButtonTokenResource ContentPaddingLG}" />
            <Setter Property="atom:ButtonThemeInputs.ThemeIconOnyPadding" Value="{atom:ButtonTokenResource IconOnyPaddingLG}" />
            <Setter Property="atom:ButtonThemeInputs.ThemeOnlyIconSize" Value="{atom:ButtonTokenResource OnlyIconSizeLG}" />
        </Style>

    <Style Selector="^:is(atom|Button)">
        <Style Selector="^[ButtonType=Default], ^[ButtonType=Link], ^[ButtonType=Primary], ^[ButtonType=Text]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                  IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}" />
                        <Border Padding="{TemplateBinding Padding}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding EffectiveIconVisible}" />
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Classes.semantic-content="True"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </DockPanel>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[ButtonType=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                  IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding EffectiveIconVisible}" />
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Classes.semantic-content="True"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[EffectiveVariant=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                  IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding EffectiveIconVisible}" />
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Classes.semantic-content="True"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 公用样式开始 -->

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background"
                                                        atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="Foreground"
                                                        atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="BorderBrush"
                                                        atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="IsWaveSpiritEnabled"
                Value="{atom:OwnerTokenResource EnableWaveSpirit}" />
        <Setter Property="FontWeight" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeFontWeight)}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^[SizeType=Large]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightLG}" />
            <Setter Property="FontSize" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeContentFontSize)}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource IconSizeLG}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource IconSizeLG}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeContentPadding)}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeIconOnyPadding)}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeContentFontSize)}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource IconSize}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeContentPadding)}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeIconOnyPadding)}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightSM}" />
            <Setter Property="FontSize" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeContentFontSize)}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource IconSizeSM}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource IconSizeSM}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeContentPadding)}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeIconOnyPadding)}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Custom]">
            <Setter Property="FontSize" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeContentFontSize)}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource IconSize}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeContentPadding)}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeIconOnyPadding)}" />
            </Style>
        </Style>

        <Style Selector="^:icononly">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon, ^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Margin" Value="0" />
            </Style>
        </Style>

        <Style Selector="^:icononly:loading[SizeType=Large]">
            <Setter Property="IconWidth" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeOnlyIconSize)}" />
            <Setter Property="IconHeight" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeOnlyIconSize)}" />
        </Style>
        <Style Selector="^:icononly:loading[SizeType=Middle]">
            <Setter Property="IconWidth" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeOnlyIconSize)}" />
            <Setter Property="IconHeight" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeOnlyIconSize)}" />
        </Style>
        <Style Selector="^:icononly:loading[SizeType=Custom]">
            <Setter Property="IconWidth" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeOnlyIconSize)}" />
            <Setter Property="IconHeight" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeOnlyIconSize)}" />
        </Style>
        <Style Selector="^:icononly:loading[SizeType=Small]">
            <Setter Property="IconWidth" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeOnlyIconSize)}" />
            <Setter Property="IconHeight" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeOnlyIconSize)}" />
        </Style>

        <Style Selector="^[IconPlacement=Start]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="DockPanel.Dock" Value="Left" />
            </Style>
        </Style>

        <Style Selector="^[IconPlacement=End]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="DockPanel.Dock" Value="Right" />
            </Style>
        </Style>

        <Style Selector="^:not(:icononly)">
            <Style Selector="^[IconPlacement=Start] /template/ atom|IconPresenter#PART_ButtonIcon, ^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Margin" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeIconMargin)}" />
            </Style>
            <Style Selector="^[IconPlacement=End] /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="Margin" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeIconEndMargin)}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:loading">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Setter Property="Opacity" Value="{atom:OwnerTokenResource OpacityLoading}" />
        </Style>

        <Style Selector="^[Shape=Circle]">
            <Setter Property="Padding" Value="{Binding $self.(atom:ButtonThemeInputs.ThemeCirclePadding)}" />
        </Style>


        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:OwnerTokenResource ColorTextDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{Binding $self.(atom:ButtonThemeInputs.ThemeBorderColorDisabled)}" />

            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
        </Style>
        <Style Selector="^[EffectiveColor=Default]:disabled">
            <Setter Property="BorderBrush"
                    Value="{Binding $self.(atom:ButtonThemeInputs.ThemeDefaultBorderColorDisabled)}" />
        </Style>
        <!-- 公用样式结束 -->

        <!-- Color / Variant 视觉变量开始 -->
        <Style Selector="^:not(:disabled)">
            <Setter Property="Foreground"
                    Value="{Binding VariantAppearance.Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Background"
                    Value="{Binding VariantAppearance.Background, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding VariantAppearance.Border, RelativeSource={RelativeSource Self}}" />

            <Style Selector="^:pointerover">
                <Setter Property="Foreground"
                        Value="{Binding VariantAppearance.TextHover, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantAppearance.BackgroundHover, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantAppearance.BorderHover, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style Selector="^:pressed">
                <Setter Property="Foreground"
                        Value="{Binding VariantAppearance.TextPressed, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantAppearance.BackgroundPressed, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantAppearance.BorderPressed, RelativeSource={RelativeSource Self}}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveVariant=Text]:disabled, ^[EffectiveVariant=Link]:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#ShadowsFrame">
            <Setter Property="BoxShadow"
                    Value="{Binding VariantAppearance.Shadow, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
        <!-- Color / Variant 视觉变量结束 -->
    </Style>
</ControlTheme>
