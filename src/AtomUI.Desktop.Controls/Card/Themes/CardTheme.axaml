<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:converters="using:Avalonia.Controls.Converters"
    x:ClassModifier="internal">
    <converters:CornerRadiusFilterConverter x:Key="CornerRadiusFilterConverter" Filter="TopLeft, TopRight" />
    <ControlTheme x:Key="{x:Type atom:Card}" TargetType="atom:Card">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.ForegroundConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedForeground" />
                <atom:OwnerTokenResource Kind="ColorText" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="ColorText" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame" Padding="{TemplateBinding Padding}"
                                         BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                         Background="{TemplateBinding Background}"
                                         ClipToBounds="False"
                                         BoxShadow="{TemplateBinding BoxShadow}">
                    <DockPanel LastChildFill="True">
                        <atom:PixelAlignedBorder Name="HeaderFrame"
                                                 Classes.semantic-header="True"
                                                 DockPanel.Dock="Top"
                                                 BorderThickness="{TemplateBinding HeaderBorderThickness}">
                            <DockPanel LastChildFill="True">
                                <ContentPresenter Name="HeaderExtra"
                                                  Classes.semantic-extra="True"
                                                  DockPanel.Dock="Right"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Extra}"
                                                  ContentTemplate="{TemplateBinding ExtraTemplate}" />
                                <ContentPresenter Name="TitlePresenter"
                                                  Classes.semantic-title="True"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  VerticalAlignment="Center" />
                            </DockPanel>
                        </atom:PixelAlignedBorder>
                        <atom:CardActionPanel Name="PART_ActionPanel"
                                              Classes.semantic-actions="True"
                                              DockPanel.Dock="Bottom"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              IsVisible="{TemplateBinding IsActionsPanelVisible}" />
                        <Border Name="CoverFrame"
                                Classes.semantic-cover="True"
                                CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource CornerRadiusFilterConverter}}"
                                ClipToBounds="True"
                                DockPanel.Dock="Top">
                            <ContentPresenter Name="CoverContentPresenter"
                                              Content="{TemplateBinding Cover}"
                                              ContentTemplate="{TemplateBinding CoverTemplate}"
                                              VerticalContentAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch" />
                        </Border>
                        <Border Name="CardContent"
                                Classes.semantic-body="True">
                            <atom:Skeleton IsLoading="{TemplateBinding IsLoading}"
                                           IsActive="True"
                                           ParagraphRows="4"
                                           IsShowTitle="False"
                                           ClipToBounds = "False"
                                           Content="{TemplateBinding Content}"
                                           ContentTemplate="{TemplateBinding ContentTemplate}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG, SourceControlType={x:Type atom:Card}}" />
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorderSecondary, SourceControlType={x:Type atom:Card}}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness, SourceControlType={x:Type atom:Card}}" />
        <Setter Property="Background" Value="{atom:OwnerTokenResource ColorBgContainer, SourceControlType={x:Type atom:Card}}" />

        <Style Selector="^:headerless">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Setter Property="BoxShadow" Value="0 1 2 -1 #00000000, 0 3 6 0 #00000000, 0 5 12 4 #00000000" />
        <Style Selector="^[StyleVariant=Borderless]">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="{atom:OwnerTokenResource BoxShadowsTertiary, SourceControlType={x:Type atom:Card}}" />
        </Style>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
            <Setter Property="Background" Value="{atom:CardTokenResource HeaderBg}" />
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorBorderSecondary, SourceControlType={x:Type atom:Card}}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#HeaderExtra">
            <Setter Property="Foreground" Value="{atom:CardTokenResource ExtraColor, WhenExplicit=True}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#TitlePresenter">
            <Setter Property="TextElement.FontWeight"
                    Value="{atom:OwnerTokenResource FontWeightStrong, SourceControlType={x:Type atom:Card}}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="MinHeight" Value="{atom:CardTokenResource HeaderHeightLG}" />
                <Setter Property="Padding" Value="{atom:CardTokenResource HeaderPaddingLG}" />
                <Setter Property="TextElement.FontSize"
                        Value="{atom:CardTokenResource HeaderFontSizeLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="MinHeight" Value="{atom:CardTokenResource HeaderHeight}" />
                <Setter Property="Padding" Value="{atom:CardTokenResource HeaderPadding}" />
                <Setter Property="TextElement.FontSize"
                        Value="{atom:CardTokenResource HeaderFontSize}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="MinHeight" Value="{atom:CardTokenResource HeaderHeightSM}" />
                <Setter Property="Padding" Value="{atom:CardTokenResource HeaderPaddingSM}" />
                <Setter Property="TextElement.FontSize"
                        Value="{atom:CardTokenResource HeaderFontSizeSM}" />
            </Style>

        </Style>

        <Style Selector="^[IsInnerMode=True]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#HeaderFrame">
                <Setter Property="Background" Value="{atom:OwnerTokenResource ColorFillAlter, SourceControlType={x:Type atom:Card}}" />
            </Style>
        </Style>

        <Style Selector="^[ContentType=Meta],^[ContentType=Default]">
            <Style Selector="^[SizeType=Large]">
                <Style Selector="^ /template/ Border#CardContent">
                    <Setter Property="Padding" Value="{atom:CardTokenResource BodyPaddingLG}" />
                </Style>
            </Style>

            <Style Selector="^[SizeType=Middle]">
                <Style Selector="^ /template/ Border#CardContent">
                    <Setter Property="Padding" Value="{atom:CardTokenResource BodyPadding}" />
                </Style>
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ Border#CardContent">
                    <Setter Property="Padding" Value="{atom:CardTokenResource BodyPaddingSM}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[IsHoverable=True]">
            <Setter Property="Cursor" Value="Hand" />
            <Style Selector="^:pointerover">
                <Setter Property="BoxShadow" Value="{atom:CardTokenResource CardShadows}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Style>

        <Style Selector="^:not(:headerless)">
            <Style Selector="^ /template/ Border#CoverFrame">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <atom:BoxShadowsTransition Property="BoxShadow" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationFast}" />
                </atom:TokenTransitions>
            </Setter>
        </Style>

    </ControlTheme>
</ResourceDictionary>
