<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.AbstractUploadPictureContentTheme"
              TargetType="atom:Button"
              x:ClassModifier="internal">
    <Style Selector="^:is(atom|AbstractUploadPictureContent)">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="CornerRadius" Value="{atom:UploadTokenResource BorderRadiusLG}" />
        <Setter Property="BorderBrush" Value="{atom:UploadTokenResource ColorBorder}" />
        <Setter Property="BorderThickness" Value="{atom:UploadTokenResource BorderThickness}" />
        <Setter Property="Padding" Value="{atom:UploadTokenResource PaddingXS}" />
        <Setter Property="Foreground" Value="{atom:UploadTokenResource ColorTextSecondary}" />
        
        <Style Selector="^[Status=Failed]">
            <Setter Property="Foreground" Value="{atom:UploadTokenResource ColorError}" />
            <Setter Property="BorderBrush" Value="{atom:UploadTokenResource ColorError}" />
        </Style>
        
        <Style Selector="^[Status=Cancelled]">
            <Setter Property="Foreground" Value="{atom:UploadTokenResource ColorError}" />
            <Setter Property="BorderBrush" Value="{atom:UploadTokenResource ColorError}" />
        </Style>
        
        <Style Selector="^ /template/ Border#Mask">
            <Setter Property="Background" Value="{atom:UploadTokenResource ColorBgMask}" />
            <Setter Property="TemplatedControl.Foreground"
                    Value="{atom:UploadTokenResource ColorTextLightSolid}" />
        </Style>

        <Style Selector="^[Status=Success]:pointerover">
            <Setter Property="MaskOpacity" Value="1" />
        </Style>

        <Style Selector="^[Status=Failed]:pointerover">
            <Setter Property="MaskOpacity" Value="1" />
        </Style>

        <Style Selector="^[Status=Cancelled]:pointerover">
            <Setter Property="MaskOpacity" Value="1" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconButton">
            <Setter Property="IconBrush" Value="{atom:UploadTokenResource ColorTextLightSolid}" />
            <Setter Property="IconWidth" Value="{atom:UploadTokenResource FontSizeLG}" />
            <Setter Property="IconHeight" Value="{atom:UploadTokenResource FontSizeLG}" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconButton:pointerover">
            <Setter Property="IconBrush" Value="{atom:UploadTokenResource ColorTextLightSolid}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <DoubleTransition Property="MaskOpacity" atom:TokenTransitions.Duration="MotionDurationSlow" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </Style>

</ControlTheme>
