<!-- owner: global Tokens are read from the owner because this theme is the base of DatePicker and TimePicker, each
     with its own identity. -->
<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.InfoPickerInputTheme"
              TargetType="atom:InfoPickerInput">
    <Setter Property="OpenMotion" Value="{x:Static atom:PopupMotionDefaults.SelectOpen}" />
    <Setter Property="CloseMotion" Value="{x:Static atom:PopupMotionDefaults.SelectClose}" />
    <!-- Focus is shown by the input frame (border + outline shadow), not a separate adorner. -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <!-- The focus outline shadow is drawn outside the input frame and must not be clipped by the host. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:InfoPickerInput">
            <Panel>
                <!-- Keyboard stops follow Ant Design pickers: the input(s), then the clear button. The frame is focusable only
                     for pointer hits on its padding; it is a local tab group ordered by TabIndex because the clear button
                     precedes the inputs in the frame's visual tree. -->
                <atom:AddOnDecoratedBox
                    Name="{x:Static atom:AddOnDecoratedBox.AddOnDecoratedBoxPart}"
                    Focusable="True"
                    IsTabStop="False"
                    KeyboardNavigation.TabNavigation="Local"
                    Classes.semantic-scope-input="True"
                    MinWidth="{TemplateBinding MinWidth}"
                    StyleVariant="{TemplateBinding StyleVariant}"
                    SizeType="{TemplateBinding SizeType}"
                    Status="{TemplateBinding Status}"
                    FormStatus="{TemplateBinding FormStatus}"
                    IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                    DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    LeftAddOn="{TemplateBinding LeftAddOn}"
                    LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                    RightAddOn="{TemplateBinding RightAddOn}"
                    RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    ContentLeftAddOnTemplate="{TemplateBinding ContentLeftAddOnTemplate}"
                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}"
                    HostBorderBrush="{TemplateBinding BorderBrush}">
                    <atom:AddOnDecoratedBox.ContentLeftAddOn>
                        <atom:AddOnContentPresenter
                            Classes.semantic-prefix="True"
                            Content="{CompiledBinding $parent[atom:InfoPickerInput].ContentLeftAddOn}"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            Focusable="False" />
                    </atom:AddOnDecoratedBox.ContentLeftAddOn>
                    <atom:AddOnDecoratedBox.ContentRightAddOn>
                        <StackPanel Orientation="Horizontal"
                                    Classes.semantic-suffix="True"
                                    Spacing="{atom:OwnerTokenResource SpacingXS}">
                            <atom:PickerClearUpButton
                                Name="PART_ClearUpButton"
                                Icon="{CompiledBinding $parent[atom:InfoPickerInput].InfoIcon}"
                                FormFeedback="{CompiledBinding $parent[atom:InfoPickerInput].FormFeedback}"
                                IsInClearMode="{CompiledBinding $parent[atom:InfoPickerInput].IsClearButtonVisible}"
                                IsVisible="{CompiledBinding $parent[atom:InfoPickerInput].InfoIcon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Classes.semantic-scope-handle="True" />
                            <atom:AddOnContentPresenter Name="PART_ContentRightAddOnPresenter"
                                                        Content="{CompiledBinding $parent[atom:InfoPickerInput].ContentRightAddOn}"
                                                        ContentTemplate="{CompiledBinding $parent[atom:InfoPickerInput].ContentRightAddOnTemplate}" />
                        </StackPanel>
                    </atom:AddOnDecoratedBox.ContentRightAddOn>
                    <atom:InfoPickerTextBox Name="PART_InfoInputBox"
                                          KeyboardNavigation.TabIndex="0"
                                          Classes.semantic-input="True"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          TextWrapping="NoWrap"
                                          AcceptsReturn="False"
                                          Width="{TemplateBinding PreferredInputWidth}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontStyle="{TemplateBinding FontStyle}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Text="{TemplateBinding Text}"
                                          PlaceholderText="{TemplateBinding PlaceholderText}"
                                          DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                                          IsReadOnly="{TemplateBinding IsReadOnly}" />
                </atom:AddOnDecoratedBox>

                <atom:Popup Name="PART_Popup"
                            OpenMotion="{TemplateBinding OpenMotion}"
                            CloseMotion="{TemplateBinding CloseMotion}"
                            WindowManagerAddShadowHint="False"
                            IsLightDismissEnabled="True"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                            ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                            RequestedPlacement="{TemplateBinding PickerPlacement}"
                            IsPointAtCenter="{TemplateBinding IsPointAtCenter}"
                            IsHorizontalFlipped="{TemplateBinding IsPopupHorizontalFlipped, Mode=TwoWay}"
                            IsVerticalFlipped="{TemplateBinding IsPopupVerticalFlipped, Mode=TwoWay}"
                            MarginToAnchor="{TemplateBinding MarginToAnchor}">
                    <atom:ArrowDecoratedBox Classes.semantic-popup-root="True"
                                            Content="{TemplateBinding PickerPresenter}"
                                            IsArrowVisible="{TemplateBinding IsArrowVisibleEffective}"
                                            ArrowPosition="{TemplateBinding ArrowPosition}"
                                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"/>
                </atom:Popup>
            </Panel>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|InfoPickerInput)">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsArrowVisible" Value="True" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="MarginToAnchor" Value="{atom:PopupTokenResource MarginToAnchor}" />
        <Setter Property="ShouldUseOverlayPopup" Value="True" />
        <!-- The input frame paints its focus shadow outside the control bounds (as Select / ComboBox / NumericUpDown). -->
        <Setter Property="ClipToBounds" Value="False" />

        <!-- Only a hover preview is dimmed; the candidate keeps the normal text color while open, as in Ant Design. -->
        <Style Selector="^:previewing">
            <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_InfoInputBox">
                <Setter Property="Foreground"
                        Value="{atom:OwnerTokenResource ColorTextPlaceholder}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ atom|InfoPickerTextBox">
                <Setter Property="Foreground"
                        Value="{atom:OwnerTokenResource ColorTextDisabled}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeLG}" />
            <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_InfoInputBox">
                <Setter Property="MaxHeight" Value="{atom:OwnerTokenResource FontHeightLG}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}" />
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_InfoInputBox">
                <Setter Property="MaxHeight" Value="{atom:OwnerTokenResource FontHeight}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSizeSM}" />
            <Style Selector="^ /template/ atom|InfoPickerTextBox#PART_InfoInputBox">
                <Setter Property="MaxHeight" Value="{atom:OwnerTokenResource FontHeightSM}" />
            </Style>
        </Style>

    </Style>

</ControlTheme>
