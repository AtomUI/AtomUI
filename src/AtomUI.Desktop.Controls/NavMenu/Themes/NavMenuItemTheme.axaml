<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:converters="using:AtomUI.Desktop.Controls.Converters"
    x:ClassModifier="internal">
    <converters:NavMenuIsSubMenuOpenConverter x:Key="IsSubMenuOpenConverter" />
    <ControlTheme x:Key="{x:Type atom:NavMenuItem}" TargetType="atom:NavMenuItem">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"
                            Spacing="{TemplateBinding EntryItemSpacing}" />
            </ItemsPanelTemplate>
        </Setter>

        <Style Selector="^[Mode=Horizontal]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:HorizontalNavMenuItemHeader Name="PART_Header"
                                                           Classes.semantic-scope-header="True"
                                                           Icon="{TemplateBinding Icon}"
                                                           Header="{TemplateBinding Header}"
                                                           HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                                           HasSubMenu="{TemplateBinding HasSubMenu}"
                                                           IsSubMenuOpen="{TemplateBinding IsSubMenuOpen}"
                                                           IsDarkStyle="{TemplateBinding IsDarkStyle}"
                                                           IsItemBackgroundEnabled="{TemplateBinding IsItemBackgroundEnabled}"
                                                           IsEnabled="{TemplateBinding IsEnabled}"
                                                           IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                           IsSelected="{TemplateBinding SelectingItemsControl.IsSelected}"
                                                           IsInSelectedPath="{TemplateBinding IsInSelectedPath}"
                                                           IsKeyboardActive="{TemplateBinding IsKeyboardActive}"
                                                           IsPointerHold="{TemplateBinding IsPointerHold}"
                                                           IsInlineCollapsed="{TemplateBinding IsInlineCollapsed}"
                                                           IsTopLevel="{TemplateBinding IsTopLevel}" />
                        <atom:Popup Name="PART_Popup"
                                    WindowManagerAddShadowHint="False"
                                    IsLightDismissEnabled="False"
                                    ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}">
                            <atom:Popup.IsOpen>
                                <MultiBinding Converter="{StaticResource IsSubMenuOpenConverter}">
                                    <Binding Path="IsSubMenuOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="HasSubMenu" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </atom:Popup.IsOpen>
                            <atom:NavMenuPopupFrame Name="PART_PopupFrame"
                                                     Classes.semantic-popup-root="True"
                                                     MinWidth="{TemplateBinding EffectivePopupMinWidth}">
                                <atom:ScrollViewer IsScrollChainingEnabled="False"
                                                   IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                   IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                                   AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}">
                                    <ItemsPresenter
                                        Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        Grid.IsSharedSizeScope="True"
                                        KeyboardNavigation.TabNavigation="Continue" />
                                </atom:ScrollViewer>
                            </atom:NavMenuPopupFrame>
                        </atom:Popup>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[Mode=Vertical]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:VerticalNavMenuItemHeader Name="PART_Header"
                                                         Classes.semantic-scope-header="True"
                                                         Icon="{TemplateBinding Icon}"
                                                         Header="{TemplateBinding Header}"
                                                         NodeHeader="{TemplateBinding NodeHeader}"
                                                         HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                                         HasSubMenu="{TemplateBinding HasSubMenu}"
                                                         IsSubMenuOpen="{TemplateBinding IsSubMenuOpen}"
                                                         IsDarkStyle="{TemplateBinding IsDarkStyle}"
                                                         IsItemBackgroundEnabled="{TemplateBinding IsItemBackgroundEnabled}"
                                                         IsEnabled="{TemplateBinding IsEnabled}"
                                                         IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                         IsSelected="{TemplateBinding SelectingItemsControl.IsSelected}"
                                                         IsInSelectedPath="{TemplateBinding IsInSelectedPath}"
                                                         IsKeyboardActive="{TemplateBinding IsKeyboardActive}"
                                                         IsPointerHold="{TemplateBinding IsPointerHold}"
                                                         IsInlineCollapsed="{TemplateBinding IsInlineCollapsed}"
                                                         atom:ToolTip.Tip="{TemplateBinding EffectiveCollapsedTooltip}"
                                                         atom:ToolTip.Placement="{TemplateBinding CollapsedTooltipPlacement}"
                                                         atom:ToolTip.ShowDelay="{TemplateBinding CollapsedTooltipShowDelay}"
                                                         atom:ToolTip.BetweenShowDelay="{TemplateBinding CollapsedTooltipBetweenShowDelay}" />
                        <atom:Popup Name="PART_Popup"
                                    WindowManagerAddShadowHint="False"
                                    IsLightDismissEnabled="False"
                                    ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}">
                            <atom:Popup.IsOpen>
                                <MultiBinding Converter="{StaticResource IsSubMenuOpenConverter}">
                                    <Binding Path="IsSubMenuOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="HasSubMenu" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </atom:Popup.IsOpen>

                            <atom:NavMenuPopupFrame Name="PART_PopupFrame"
                                                     Classes.semantic-popup-root="True">
                                <atom:ScrollViewer IsScrollChainingEnabled="False"
                                                   IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                   IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                                                   AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}">
                                    <ItemsPresenter Name="PART_ItemsPresenter"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    Grid.IsSharedSizeScope="True" />
                                </atom:ScrollViewer>
                            </atom:NavMenuPopupFrame>
                        </atom:Popup>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[Mode=Inline]">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Vertical">
                        <atom:InlineNavMenuItemHeader
                            Name="PART_Header"
                            Classes.semantic-scope-header="True"
                            Icon="{TemplateBinding Icon}"
                            Header="{TemplateBinding Header}"
                            HeaderTemplate="{TemplateBinding HeaderTemplate}"
                            Level="{TemplateBinding Level}"
                            HasSubMenu="{TemplateBinding HasSubMenu}"
                            IsSubMenuOpen="{TemplateBinding IsSubMenuOpen}"
                            IsDarkStyle="{TemplateBinding IsDarkStyle}"
                            IsItemBackgroundEnabled="{TemplateBinding IsItemBackgroundEnabled}"
                            IsEnabled="{TemplateBinding IsEnabled}"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                            IsSelected="{TemplateBinding SelectingItemsControl.IsSelected}"
                            Focusable="{TemplateBinding Focusable}"
                            IsInSelectedPath="{TemplateBinding IsInSelectedPath}"
                            IsKeyboardActive="{TemplateBinding IsKeyboardActive}"
                            IsPointerHold="{TemplateBinding IsPointerHold}"
                            IsInlineCollapsed="{TemplateBinding IsInlineCollapsed}" />

                        <atom:ContentViewport
                            Name="PART_ChildItemsViewport"
                            atom:Motion.IsVisible="{TemplateBinding IsSubMenuOpen}"
                            atom:Motion.IsEnabled="{TemplateBinding IsMotionEnabled}"
                            atom:Motion.DurationOverride="{TemplateBinding OpenCloseMotionDuration}">
                            <atom:Motion.Enter>
                                <atom:ExpandMotion />
                            </atom:Motion.Enter>
                            <atom:Motion.Leave>
                                <atom:CollapseMotion />
                            </atom:Motion.Leave>
                            <Border Name="PART_ChildItemsFrame">
                                <ItemsPresenter Name="ChildItemsPresenter"
                                                Focusable="False"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Border>
                        </atom:ContentViewport>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />

        <Style Selector="^[Mode=Horizontal],^[Mode=Vertical]">
            <Setter Property="PopupMinWidth"
                    Value="{atom:NavMenuTokenResource MenuPopupMinWidth}" />

            <Style Selector="^ /template/ atom|NavMenuPopupFrame#PART_PopupFrame">
                <Setter Property="Background"
                        Value="{atom:NavMenuTokenResource MenuPopupBg}" />
                <Setter Property="CornerRadius"
                        Value="{atom:PopupTokenResource PopupCornerRadius}" />
                <Setter Property="MinWidth"
                        Value="{atom:NavMenuTokenResource MenuPopupMinWidth}" />
                <Setter Property="PopupMaxWidth"
                        Value="{atom:NavMenuTokenResource MenuPopupMaxWidth}" />
                <Setter Property="PopupMaxHeight"
                        Value="{atom:NavMenuTokenResource MenuPopupMaxHeight}" />
                <Setter Property="Padding"
                        Value="{atom:NavMenuTokenResource MenuPopupContentPadding}" />
            </Style>
        </Style>

        <Style Selector="^[IsDarkStyle=True]">
            <Style Selector="^ /template/ atom|NavMenuPopupFrame#PART_PopupFrame">
                <Setter Property="Background"
                        Value="{atom:NavMenuTokenResource DarkMenuPopupBg}" />
            </Style>
        </Style>

        <Style Selector="^[Mode=Horizontal],^[Mode=Vertical]">
            <Style Selector="^ /template/ atom|Popup#PART_Popup">
                <Setter Property="RequestedPlacement" Value="RightEdgeAlignedTop" />
                <Setter Property="HorizontalOffset" Value="{atom:SharedTokenResource SpacingXS}" />
                <Setter Property="VerticalOffset" Value="{atom:SharedTokenResource SpacingXXS}" />
            </Style>
        </Style>

        <Style Selector="^[Mode=Horizontal]:toplevel">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
            <Style Selector="^ /template/ atom|Popup#PART_Popup">
                <Setter Property="RequestedPlacement" Value="Bottom" />
                <Setter Property="VerticalOffset" Value="{atom:SharedTokenResource SpacingXXS}" />
                <Setter Property="HorizontalOffset" Value="0" />
            </Style>
        </Style>

        <Style Selector="^[Mode=Inline]">
            <Setter Property="OpenCloseMotionDuration"
                    Value="{atom:SharedTokenResource MotionDurationMid}" />

            <Setter Property="Focusable" Value="False" />
            <Style Selector="^[IsItemBackgroundEnabled=True]">
                <Style Selector="^ /template/ Border#PART_ChildItemsFrame">
                    <Setter Property="Margin"
                            Value="{atom:NavMenuTokenResource VerticalChildItemsMargin}" />
                    <Setter Property="Background"
                            Value="{atom:NavMenuTokenResource SubMenuItemBg}" />
                </Style>

                <Style Selector="^[IsDarkStyle=True]">
                    <Style Selector="^ /template/ Border#PART_ChildItemsFrame">
                        <Setter Property="Background"
                                Value="{atom:NavMenuTokenResource DarkSubMenuItemBg}" />
                    </Style>
                </Style>
            </Style>

            <Style Selector="^[IsItemBackgroundEnabled=False]">
                <Style Selector="^ /template/ Border#PART_ChildItemsFrame">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
