<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:TabControl}" TargetType="atom:TabControl">
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSize" Value="{atom:TabControlTokenResource TitleFontSize}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSizeLG" Value="{atom:TabControlTokenResource TitleFontSizeLG}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTitleFontSizeSM" Value="{atom:TabControlTokenResource TitleFontSizeSM}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemMargin" Value="{atom:TabControlTokenResource HorizontalItemMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemColor" Value="{atom:TabControlTokenResource ItemColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemHoverColor" Value="{atom:TabControlTokenResource ItemHoverColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemSelectedColor" Value="{atom:TabControlTokenResource ItemSelectedColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeItemIconMargin" Value="{atom:TabControlTokenResource ItemIconMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeMenuIndicatorPaddingHorizontal" Value="{atom:TabControlTokenResource MenuIndicatorPaddingHorizontal}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeMenuIndicatorPaddingVertical" Value="{atom:TabControlTokenResource MenuIndicatorPaddingVertical}" />

        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowLeft" Value="{atom:TabControlTokenResource BoxShadowTabsOverflowLeft}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowRight" Value="{atom:TabControlTokenResource BoxShadowTabsOverflowRight}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowTop" Value="{atom:TabControlTokenResource BoxShadowTabsOverflowTop}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeBoxShadowTabsOverflowBottom" Value="{atom:TabControlTokenResource BoxShadowTabsOverflowBottom}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeCloseIconMargin" Value="{atom:TabControlTokenResource CloseIconMargin}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeInkBarColor" Value="{atom:TabControlTokenResource InkBarColor}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeInkBarThickness" Value="{atom:TabControlTokenResource InkBarThickness}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemGutter" Value="{atom:TabControlTokenResource HorizontalItemGutter}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemPadding" Value="{atom:TabControlTokenResource HorizontalItemPadding}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemPaddingLG" Value="{atom:TabControlTokenResource HorizontalItemPaddingLG}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeHorizontalItemPaddingSM" Value="{atom:TabControlTokenResource HorizontalItemPaddingSM}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeVerticalItemGutter" Value="{atom:TabControlTokenResource VerticalItemGutter}" />
        <Setter Property="atom:TabOverflowEdgeIndicator.ThemeTabAndContentGutter" Value="{atom:TabControlTokenResource TabAndContentGutter}" />

        <ControlTheme.BasedOn>
            <themes:BaseTabControlTheme TargetType="atom:TabControl" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame"
                                         Background="{TemplateBinding Background}"
                                         BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         Padding="{TemplateBinding Padding}"
                                         StrokeDashArray="{TemplateBinding BorderDashArray}"
                                         StrokeDaskOffset="{TemplateBinding BorderDashOffset}">
                    <DockPanel>
                        <Panel Name="PART_AlignWrapper"
                               DockPanel.Dock="{TemplateBinding TabStripPlacement}"
                               Margin="{TemplateBinding TabStripMargin}">
                            <Border Classes.semantic-header="True"
                                    Padding="{TemplateBinding EffectiveHeaderPadding}">
                                <DockPanel LastChildFill="True" Name="HeaderLayout">
                                    <ContentPresenter Name="HeaderStartExtraContent"
                                                      Content="{TemplateBinding HeaderStartExtraContent}"
                                                      ContentTemplate="{TemplateBinding HeaderStartExtraContentTemplate}" />
                                    <ContentPresenter Name="HeaderEndExtraContent"
                                                      Content="{TemplateBinding HeaderEndExtraContent}"
                                                      ContentTemplate="{TemplateBinding HeaderEndExtraContentTemplate}" />
                                    <atom:TabScrollViewer
                                        Name="PART_TabsContainer"
                                        IsScrollChainingEnabled="False"
                                        TabStripPlacement="{TemplateBinding TabStripPlacement}"
                                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                        IsPopupPinnedOpen="{TemplateBinding IsPopupPinnedOpen}"
                                        OverflowPopupTemplate="{TemplateBinding OverflowPopupTemplate}">
                                        <Panel>
                                            <ItemsPresenter
                                                Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                                            <Border
                                                Name="PART_SelectedItemIndicator"
                                                Classes.semantic-indicator="True"
                                                RenderTransform="{TemplateBinding SelectedIndicatorRenderTransform}"/>
                                        </Panel>
                                    </atom:TabScrollViewer>
                                </DockPanel>
                            </Border>
                        </Panel>

                        <ContentPresenter Classes.semantic-content="True"
                                          Padding="{TemplateBinding ContentPadding}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="SelectedIndicatorThickness"
                Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeInkBarThickness)}" />
        <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
            <Setter Property="Background" Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeInkBarColor)}" />
        </Style>

        <Style Selector="^[TabStripPlacement=Top]">
          
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="HorizontalSpacing" Value="{atom:TabControlTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ Panel#PART_AlignWrapper > Border">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeHorizontalItemGutter)}" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Right]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="VerticalSpacing" Value="{atom:TabControlTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Bottom"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ Panel#PART_AlignWrapper > Border">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeVerticalItemGutter)}" />
                <Setter Property="Orientation" Value="Vertical" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Bottom]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="HorizontalSpacing" Value="{atom:TabControlTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ Panel#PART_AlignWrapper > Border">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeHorizontalItemGutter)}" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^[TabStripPlacement=Left]">
            <Style Selector="^ /template/ DockPanel#HeaderLayout">
                <Setter Property="VerticalSpacing" Value="{atom:TabControlTokenResource SpacingXS}"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderStartExtraContent">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            
            <Style Selector="^ /template/ ContentPresenter#HeaderEndExtraContent">
                <Setter Property="DockPanel.Dock" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <!-- tabs 是否居中 -->
            <Style Selector="^[TabAlignmentCenter=True]">
                <Style Selector="^ /template/ Panel#PART_AlignWrapper > Border">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style>

            <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter StackPanel">
                <Setter Property="Spacing"
                        Value="{Binding $self.(atom:TabOverflowEdgeIndicator.ThemeVerticalItemGutter)}" />
                <Setter Property="Orientation" Value="Vertical" />
            </Style>

            <Style Selector="^ /template/ Border#PART_SelectedItemIndicator">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <TransformOperationsTransition Property="SelectedIndicatorRenderTransform" atom:TokenTransitions.Duration="MotionDurationSlow" Easing="CubicEaseOut" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
