<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.DatePicker.DatePickerShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:AtomUIGallery.ShowCases.DatePicker"
             x:DataType="vm:DatePickerViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="DatePicker"
                    Category="{gallery:DatePickerShowCaseLangResource ComponentCategory}"
                    Status="{gallery:DatePickerShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:DatePickerShowCaseLangResource PageSubtitle}"
                    Description="{gallery:DatePickerShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="InfoPickerInput" />
                        </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:DatePickerViewModel">
                    <gallery:SemanticPartPreview Name="DatePickerSemanticPreview"
                                                 Title="DatePicker"
                                                 SemanticOwner="{Binding #DatePickerSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:RangeDatePicker}"
                                                 PreviewStageMinHeight="560"
                                                 PreviewContentAlignment="Top">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <!-- 双月日历弹层约 470px 高:舞台最小高度 560 且锚点置顶,
                                 让弹层向下展开,避免翻转向上遮挡页面 Tabs;
                                 舞台随宿主钳制高度收缩,不产生可视区之外的布局。 -->
                            <atom:RangeDatePicker Name="DatePickerSemanticOwner"
                                                      VerticalAlignment="Top"
                                                      Width="420"
                                                      IsMotionEnabled="False"
                                                      IsPopupPinnedOpen="True"
                                                      IsPickerOpen="True"
                                                      ContentLeftAddOn="prefix"
                                                      RangeStartSelectedDate="{Binding SemanticPreviewRangeStart}"
                                                      RangeEndSelectedDate="{Binding SemanticPreviewRangeEnd}"
                                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartDate}"
                                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="prefix"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticPrefixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="input"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticInputDescription}" />
                            <gallery:SemanticPartDescription
                                Path="secondaryInput"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticSecondaryInputDescription}" />
                            <gallery:SemanticPartDescription
                                Path="suffix"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticSuffixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="clear"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticClearDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.root"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticPopupRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.container"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticPopupContainerDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.header"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticPopupHeaderDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.body"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticPopupBodyDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.content"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticPopupContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.cell"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticPopupCellDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.footer"
                                Description="{gallery:DatePickerShowCaseLangResource SemanticPopupFooterDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource BasicTitle}"
        Description="{gallery:DatePickerShowCaseLangResource BasicDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:DatePicker PickerMode="Date"
                             PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" />
            <atom:DatePicker PickerMode="Week"
                             PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectWeek}" />
            <atom:DatePicker PickerMode="Month"
                             PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectMonth}" />
            <atom:DatePicker PickerMode="Quarter"
                             PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectQuarter}" />
            <atom:DatePicker PickerMode="Year"
                             PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectYear}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource SwitchableTitle}"
        Description="{gallery:DatePickerShowCaseLangResource SwitchableDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <atom:Select Width="104"
                         Mode="Single"
                         OptionsSource="{Binding PickerTypeOptions}"
                         SelectedOption="{Binding SelectedPickerOption}" />
            <Grid>
                <atom:TimePicker Width="240"
                                 PlaceholderText="{Binding SelectedPickerPlaceholderText}"
                                 IsVisible="{Binding IsTimePickerVisible}" />
                <atom:DatePicker Width="240"
                                 PlaceholderText="{Binding SelectedPickerPlaceholderText}"
                                 IsVisible="{Binding IsDatePickerVisible}"
                                 PickerMode="{Binding SelectedPickerMode}" />
            </Grid>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource BindingTitle}"
        Description="{gallery:DatePickerShowCaseLangResource BindingDescription}"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="16">
            <StackPanel Orientation="Vertical" Spacing="12">
                <atom:DatePicker Width="240"
                                 SelectedDateTime="{Binding BoundSelectedDateTime}"
                                 PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <atom:TextBlock VerticalAlignment="Center"
                                    Text="{gallery:DatePickerShowCaseLangResource P2TextSelectedDateTime}" />
                    <atom:TextBlock VerticalAlignment="Center"
                                    Text="{Binding BoundSelectedDateTimeText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <atom:Button SizeType="Small"
                                 Click="SetBoundSelectedDateTimeTomorrow"
                                 Content="{gallery:DatePickerShowCaseLangResource P2ContentSetTomorrow}" />
                    <atom:Button SizeType="Small"
                                 Click="ClearBoundSelectedDateTime"
                                 Content="{gallery:DatePickerShowCaseLangResource P2ContentClear}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Vertical" Spacing="12">
                <atom:RangeDatePicker PickerMode="Date"
                                      IsShowTime="False"
                                      RangeStartSelectedDate="{Binding BoundRangeStartSelectedDate}"
                                      RangeEndSelectedDate="{Binding BoundRangeEndSelectedDate}"
                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartDate}"
                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <atom:TextBlock VerticalAlignment="Center"
                                    Text="{gallery:DatePickerShowCaseLangResource P2TextSelectedDateRange}" />
                    <atom:TextBlock VerticalAlignment="Center"
                                    Text="{Binding BoundRangeSelectedDateText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <atom:Button SizeType="Small"
                                 Click="SetBoundSelectedDateRangeThisWeek"
                                 Content="{gallery:DatePickerShowCaseLangResource P2ContentSetThisWeek}" />
                    <atom:Button SizeType="Small"
                                 Click="ClearBoundSelectedDateRange"
                                 Content="{gallery:DatePickerShowCaseLangResource P2ContentClear}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource PickerDisplayDateTitle}"
        Description="{gallery:DatePickerShowCaseLangResource PickerDisplayDateDescription}"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <atom:DatePicker PickerDisplayDate="2026-10-20"
                         PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource MinMaxTitle}"
        Description="{gallery:DatePickerShowCaseLangResource MinMaxDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
                <atom:DatePicker SelectedDateTime="2019-09-03"
                                 MinDate="2019-08-01"
                                 MaxDate="2020-10-31"
                                 PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource RangePickerTitle}"
        Description="{gallery:DatePickerShowCaseLangResource RangePickerDescription}"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:RangeDatePicker PickerMode="Date"
                                  IsShowTime="False"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartDate}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}" />
            <atom:RangeDatePicker PickerMode="Date"
                                  IsShowTime="True"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartDate}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}" />
            <atom:RangeDatePicker PickerMode="Week"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartWeek}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndWeek}" />
            <atom:RangeDatePicker PickerMode="Month"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartMonth}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndMonth}" />
            <atom:RangeDatePicker PickerMode="Quarter"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartQuarter}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndQuarter}" />
            <atom:RangeDatePicker PickerMode="Year"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartYear}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndYear}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource NeedConfirmTitle}"
        Description="{gallery:DatePickerShowCaseLangResource NeedConfirmDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:DatePicker IsNeedConfirm="True" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" />
            <atom:RangeDatePicker IsNeedConfirm="True" IsShowTime="False" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource ChooseTimeTitle}"
        Description="{gallery:DatePickerShowCaseLangResource ChooseTimeDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:DatePicker IsNeedConfirm="True" IsShowTime="True" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" />
            <atom:RangeDatePicker IsNeedConfirm="True" IsShowTime="True" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource DisabledTitle}"
        Description="{gallery:DatePickerShowCaseLangResource DisabledDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:DatePicker IsNeedConfirm="True" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" SelectedDateTime="2024-01-20"
                             IsEnabled="False" />
            <atom:DatePicker IsNeedConfirm="True" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" IsShowTime="True"
                             SelectedDateTime="2024-01-20 12:22:23 AM" IsEnabled="False" />
            <atom:RangeDatePicker IsNeedConfirm="True"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}"
                                  RangeStartDefaultDate="2024-01-20"
                                  RangeEndDefaultDate="2024-03-20"
                                  IsEnabled="False" />
            <atom:RangeDatePicker IsNeedConfirm="True"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}"
                                  IsShowTime="True"
                                  RangeStartDefaultDate="2024-01-20 12:22:23 AM"
                                  RangeEndDefaultDate="2024-02-20 07:22:23 AM"
                                  IsEnabled="False" />
            <atom:RangeDatePicker IsNeedConfirm="True"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}"
                                  IsShowTime="True"
                                  RangeStartDefaultDate="2024-01-20 12:22:23 AM"
                                  RangeEndDefaultDate="2024-02-20 07:22:23 AM" />
            <atom:DatePicker IsNeedConfirm="True" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" SelectedDateTime="2024-01-20" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource ThreeSizesTitle}"
        Description="{gallery:DatePickerShowCaseLangResource ThreeSizesDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">

        <DockPanel Margin="0, 0, 0, 0">
            <DockPanel.Styles>
                <Style Selector="atom|DatePicker.size-demo-picker[SizeType=Custom]">
                    <Setter Property="Height" Value="38" />
                    <Setter Property="FontSize" Value="15" />
                </Style>
                <Style Selector="atom|RangeDatePicker.size-demo-picker[SizeType=Custom]">
                    <Setter Property="Height" Value="38" />
                    <Setter Property="FontSize" Value="15" />
                </Style>
            </DockPanel.Styles>
            <StackPanel Orientation="Horizontal" Spacing="5" DockPanel.Dock="Top">
                <atom:TextBlock VerticalAlignment="Center" Text="{gallery:DatePickerShowCaseLangResource P2TextExpandDirection}" />
                <atom:OptionButtonGroup ButtonStyle="Outline"
                                        Name="PickerSizeTypeOptionGroup"
                                        OptionCheckedChanged="HandlePickerSizeTypeOptionCheckedChanged">
                    <atom:OptionButton Content="{gallery:DatePickerShowCaseLangResource P2ContentLarge}" />
                    <atom:OptionButton IsChecked="True" Content="{gallery:DatePickerShowCaseLangResource P2ContentDefault}" />
                    <atom:OptionButton Content="{gallery:DatePickerShowCaseLangResource P2ContentSmall}" />
                    <atom:OptionButton Content="{gallery:DatePickerShowCaseLangResource P2ContentCustom}" />
                </atom:OptionButtonGroup>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0, 20, 0, 0" Spacing="10">
                <atom:DatePicker Classes="size-demo-picker" IsNeedConfirm="True" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" SelectedDateTime="2024-01-20"
                                 SizeType="{Binding PickerSizeType}" />
                <atom:RangeDatePicker Classes="size-demo-picker"
                                      IsNeedConfirm="True"
                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}"
                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}"
                                      IsShowTime="True"
                                      RangeStartDefaultDate="2024-01-20 12:22:23 AM"
                                      RangeEndDefaultDate="2024-02-20 07:22:23 AM"
                                      SizeType="{Binding PickerSizeType}" />
            </StackPanel>
        </DockPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource StatusTitle}"
        Description="{gallery:DatePickerShowCaseLangResource StatusDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:DatePicker Status="Default"
                                 PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectTime}" />
                <atom:RangeDatePicker StyleVariant="Outlined"
                                      Status="Default"
                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartDate}"
                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:DatePicker Status="Warning"
                                 PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectTime}" />
                <atom:RangeDatePicker StyleVariant="Outlined"
                                      Status="Warning"
                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartDate}"
                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:DatePicker Status="Error"
                                 PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectTime}" />
                <atom:RangeDatePicker StyleVariant="Outlined"
                                      Status="Error"
                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartDate}"
                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource VariantsTitle}"
        Description="{gallery:DatePickerShowCaseLangResource VariantsDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:DatePicker StyleVariant="Outlined"
                                 PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextOutline}" />
                <atom:RangeDatePicker StyleVariant="Outlined"
                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextOutline}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24"
                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextOutline}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:DatePicker StyleVariant="Filled"
                                 PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextFilled}" />
                <atom:RangeDatePicker StyleVariant="Filled"
                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextFilled}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24"
                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextFilled}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:DatePicker StyleVariant="Filled"
                                 Status="Error"
                                 PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextFilled}" />
                <atom:RangeDatePicker StyleVariant="Filled"
                                      Status="Error"
                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextFilled}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24"
                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextFilled}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <atom:DatePicker StyleVariant="Borderless"
                                 PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextBorderless}" />
                <atom:RangeDatePicker StyleVariant="Borderless"
                                      SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextBorderless}"
                                      IsNeedConfirm="True"
                                      ClockIdentifier="HourClock24"
                                      PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextBorderless}" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource PlacementTitle}"
        Description="{gallery:DatePickerShowCaseLangResource PlacementDescription}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">

        <StackPanel Spacing="20">
            <StackPanel Spacing="8">
                <atom:TextBlock Text="{gallery:DatePickerShowCaseLangResource P2TextPlacement}" />
                <atom:OptionButtonGroup ButtonStyle="Outline"
                                        Name="PickerPlacementOptionGroup"
                                        OptionCheckedChanged="HandlePickerPlacementCheckedChanged">
                    <atom:OptionButton Content="{gallery:DatePickerShowCaseLangResource P2ContentTopleft}" />
                    <atom:OptionButton Content="{gallery:DatePickerShowCaseLangResource P2ContentTopright}" />
                    <atom:OptionButton IsChecked="true" Content="{gallery:DatePickerShowCaseLangResource P2ContentBottomleft}" />
                    <atom:OptionButton Content="{gallery:DatePickerShowCaseLangResource P2ContentBottomright}" />
                </atom:OptionButtonGroup>
            </StackPanel>

            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:DatePicker IsNeedConfirm="True" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" SelectedDateTime="2024-01-20"
                                 PickerPlacement="{Binding PickerPlacement}" />
                <atom:RangeDatePicker IsNeedConfirm="True" PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" IsShowTime="True"
                                      RangeStartDefaultDate="2024-01-20 12:22:23 AM"
                                      RangeEndDefaultDate="2024-02-20 07:22:23 AM"
                                      PickerPlacement="{Binding PickerPlacement}" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:DatePickerShowCaseLangResource StyleClassTitle}"
        Description="{gallery:DatePickerShowCaseLangResource StyleClassDescription}"
        SourceKey="datepicker-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:DatePickerViewModel">
        <StackPanel HorizontalAlignment="Left" Spacing="20">
            <StackPanel.Styles>
                <Style Selector="atom|DatePicker.semantic-styles-demo">
                    <atom:DatePickerInputStyle x:SetterTargetType="TextBox">
                        <Setter Property="FontStyle" Value="Italic" />
                    </atom:DatePickerInputStyle>
                    <atom:DatePickerPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#1890FF" />
                        </Style>
                    </atom:DatePickerPrefixStyle>
                    <atom:DatePickerSuffixStyle x:SetterTargetType="StackPanel">
                        <Setter Property="TextElement.Foreground" Value="#1890FF" />
                    </atom:DatePickerSuffixStyle>
                    <atom:DatePickerPopupRootStyle x:SetterTargetType="atom:ArrowDecoratedBox">
                        <Setter Property="BorderBrush" Value="#1890FF" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:DatePickerPopupRootStyle>
                </Style>
                <Style Selector="atom|RangeDatePicker.semantic-styles-filled-demo">
                    <Setter Property="BorderBrush" Value="#722ED1" />
                    <atom:RangeDatePickerInputStyle x:SetterTargetType="TextBox">
                        <Setter Property="FontStyle" Value="Italic" />
                    </atom:RangeDatePickerInputStyle>
                    <atom:RangeDatePickerSecondaryInputStyle x:SetterTargetType="TextBox">
                        <Setter Property="FontStyle" Value="Italic" />
                    </atom:RangeDatePickerSecondaryInputStyle>
                    <atom:RangeDatePickerPopupCellStyle x:SetterTargetType="Button">
                        <Setter Property="Foreground" Value="#722ED1" />
                    </atom:RangeDatePickerPopupCellStyle>
                    <atom:RangeDatePickerPopupFooterStyle x:SetterTargetType="Border">
                        <Setter Property="BorderBrush" Value="#722ED1" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:RangeDatePickerPopupFooterStyle>
                    <atom:RangeDatePickerPopupRootStyle x:SetterTargetType="atom:ArrowDecoratedBox">
                        <Setter Property="BorderBrush" Value="#722ED1" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:RangeDatePickerPopupRootStyle>
                </Style>
            </StackPanel.Styles>
            <atom:DatePicker Classes="semantic-styles-demo"
                             Name="ObjectStylesDatePicker"
                             Width="300"
                             ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                             PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextSelectDate}" />
            <atom:RangeDatePicker Classes="semantic-styles-filled-demo"
                                  Name="FunctionStylesRangeDatePicker"
                                  Width="420"
                                  StyleVariant="Filled"
                                  PlaceholderText="{gallery:DatePickerShowCaseLangResource P2PlaceholderTextStartDate}"
                                  SecondaryPlaceholderText="{gallery:DatePickerShowCaseLangResource P2SecondaryPlaceholderTextEndDate}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
