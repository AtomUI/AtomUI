<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:TreeSelectAddOnDecoratedBox}" TargetType="atom:TreeSelectAddOnDecoratedBox">
        <ControlTheme.BasedOn>
            <atom:AddOnDecoratedBoxTheme TargetType="atom:TreeSelectAddOnDecoratedBox" />
        </ControlTheme.BasedOn>

        <Style Selector="^:is(atom|TreeSelectAddOnDecoratedBox)">
            <Style Selector="^^[IsMultiple=True]">
                <Style Selector="^[IsSelectionEmpty=False]">
                    <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                        <Setter Property="Padding"
                                Value="{Binding (atom:AddOnDecoratedBox).EffectiveContentFramePadding, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Style>
                    <Style Selector="^[SizeType=Large]">
                        <Setter Property="ContentFramePadding"
                                Value="{Binding $self.(atom:SelectTag.ThemeMultiModePaddingLG)}" />
                        <Setter Property="CompactContentFramePadding"
                                Value="{Binding $self.(atom:SelectTag.ThemeMultiModePaddingSM)}" />
                        <Setter Property="ContentMinHeight"
                                Value="{Binding $self.(atom:SelectTag.ThemeMultipleItemHeightLG)}" />
                        <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentLeftAddOn">
                            <Setter Property="Margin"
                                    Value="{Binding $self.(atom:SelectTag.ThemeMultiModePrefixIndentLG)}" />
                        </Style>
                    </Style>
                    <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                        <Setter Property="ContentFramePadding"
                                Value="{Binding $self.(atom:SelectTag.ThemeMultiModePadding)}" />
                        <Setter Property="CompactContentFramePadding"
                                Value="{Binding $self.(atom:SelectTag.ThemeMultiModePaddingSM)}" />
                        <Setter Property="ContentMinHeight"
                                Value="{Binding $self.(atom:SelectTag.ThemeMultipleItemHeight)}" />
                        <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentLeftAddOn">
                            <Setter Property="Margin"
                                    Value="{Binding $self.(atom:SelectTag.ThemeMultiModePrefixIndent)}" />
                        </Style>
                    </Style>
                    <Style Selector="^[SizeType=Small]">
                        <Setter Property="ContentFramePadding"
                                Value="{Binding $self.(atom:SelectTag.ThemeMultiModePaddingSM)}" />
                        <Setter Property="CompactContentFramePadding"
                                Value="{Binding $self.(atom:SelectTag.ThemeMultiModePaddingSM)}" />
                        <Setter Property="ContentMinHeight"
                                Value="{Binding $self.(atom:SelectTag.ThemeMultipleItemHeightSM)}" />
                        <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentLeftAddOn">
                            <Setter Property="Margin"
                                    Value="{Binding $self.(atom:SelectTag.ThemeMultiModePrefixIndentSM)}" />
                        </Style>
                    </Style>
                </Style>
                
                <Style Selector="^[IsSelectionEmpty=True]">
                    <Style Selector="^[SizeType=Large]">
                        <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                            <Setter Property="Padding"
                                    Value="{Binding $self.(atom:SelectTag.ThemeSingleModePaddingLG)}" />
                        </Style>
                    </Style>
                    <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                        <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                            <Setter Property="Padding"
                                    Value="{Binding $self.(atom:SelectTag.ThemeSingleModePadding)}" />
                        </Style>

                    </Style>
                    <Style Selector="^[SizeType=Small]">
                        <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                            <Setter Property="Padding"
                                    Value="{Binding $self.(atom:SelectTag.ThemeSingleModePaddingSM)}" />
                        </Style>
                    </Style>
                </Style>
            </Style>

            <!-- The frame theme (InputControlFrameTheme) owns the variant and status state machine and reads it from
                 the owner; an open drop-down keeps the active border while the input itself may not hold focus. -->
            <Style Selector="^:outline[IsDropDownOpen=True], ^:filled[IsDropDownOpen=True]">
                <Setter Property="BorderBrush" Value="{atom:TreeSelectTokenResource ColorPrimary}" />
                <Style Selector="^[EffectiveStatus=Error]">
                    <Setter Property="BorderBrush" Value="{atom:TreeSelectTokenResource ColorError}" />
                </Style>
                <Style Selector="^[EffectiveStatus=Warning]">
                    <Setter Property="BorderBrush" Value="{atom:TreeSelectTokenResource ColorWarning}" />
                </Style>
            </Style>

            <!-- Re-project the root border of the TreeSelect after the open state above (see InputControlFrameTheme). -->
            <Style Selector="^:host-border-brush">
                <Setter Property="BorderBrush"
                        Value="{Binding (atom:InputControlFrame).HostBorderBrush, RelativeSource={RelativeSource Self}}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
