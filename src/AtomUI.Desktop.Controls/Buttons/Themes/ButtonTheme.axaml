<!-- owner: this shared theme also serves SubmitButton and ResetButton; each terminal supplies its Own inputs. -->
<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:antdicons="https://atomui.net/icons/antdesign"
              xmlns:documents="using:Avalonia.Controls.Documents"
              x:Class="AtomUI.Desktop.Controls.Themes.ButtonTheme"
              TargetType="atom:Button">
        <Setter Property="ThemeBorderColorDisabled" Value="{atom:ButtonTokenResource BorderColorDisabled}" />
        <Setter Property="ThemeCirclePadding" Value="{atom:ButtonTokenResource CirclePadding}" />
        <Setter Property="ThemeContentFontSize" Value="{atom:ButtonTokenResource ContentFontSize}" />
        <Setter Property="ThemeContentPadding" Value="{atom:ButtonTokenResource ContentPadding}" />
        <Setter Property="ThemeDefaultBorderColorDisabled" Value="{atom:ButtonTokenResource DefaultBorderColorDisabled}" />
        <Setter Property="ThemeFontWeight" Value="{atom:ButtonTokenResource FontWeight}" />
        <Setter Property="ThemeIconEndMargin" Value="{atom:ButtonTokenResource IconEndMargin}" />
        <Setter Property="ThemeIconMargin" Value="{atom:ButtonTokenResource IconMargin}" />
        <Setter Property="ThemeIconOnyPadding" Value="{atom:ButtonTokenResource IconOnyPadding}" />
        <Setter Property="ThemeOnlyIconSize" Value="{atom:ButtonTokenResource OnlyIconSize}" />

        <Style Selector="^[SizeType=Small]">
            <Setter Property="ThemeContentFontSize" Value="{atom:ButtonTokenResource ContentFontSizeSM}" />
            <Setter Property="ThemeContentPadding" Value="{atom:ButtonTokenResource ContentPaddingSM}" />
            <Setter Property="ThemeIconOnyPadding" Value="{atom:ButtonTokenResource IconOnyPaddingSM}" />
            <Setter Property="ThemeOnlyIconSize" Value="{atom:ButtonTokenResource OnlyIconSizeSM}" />
        </Style>
        <Style Selector="^[SizeType=Large]">
            <Setter Property="ThemeContentFontSize" Value="{atom:ButtonTokenResource ContentFontSizeLG}" />
            <Setter Property="ThemeContentPadding" Value="{atom:ButtonTokenResource ContentPaddingLG}" />
            <Setter Property="ThemeIconOnyPadding" Value="{atom:ButtonTokenResource IconOnyPaddingLG}" />
            <Setter Property="ThemeOnlyIconSize" Value="{atom:ButtonTokenResource OnlyIconSizeLG}" />
        </Style>

    <Style Selector="^:is(atom|Button)">
        <Style Selector="^[ButtonType=Default], ^[ButtonType=Link], ^[ButtonType=Primary], ^[ButtonType=Text]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                  IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}" />
                        <Border Padding="{TemplateBinding Padding}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding EffectiveIconVisible}" />
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Classes.semantic-content="True"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </DockPanel>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[ButtonType=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                  IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding EffectiveIconVisible}" />
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Classes.semantic-content="True"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[EffectiveVariant=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                  IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Classes.semantic-icon="True"
                                    Width="{TemplateBinding IconWidth}"
                                    Height="{TemplateBinding IconHeight}"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding EffectiveIconVisible}" />
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Classes.semantic-content="True"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 公用样式开始 -->

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background"
                                                        atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="Foreground"
                                                        atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="BorderBrush"
                                                        atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>

            <Style Selector="^[PressMoves=True][IsExternalPopupTrigger=False]:not(:popup-trigger)">
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <atom:SolidColorBrushTransition Property="Background"
                                                            atom:TokenTransitions.Duration="MotionDurationMid" />
                            <atom:SolidColorBrushTransition Property="Foreground"
                                                            atom:TokenTransitions.Duration="MotionDurationMid" />
                            <atom:SolidColorBrushTransition Property="BorderBrush"
                                                            atom:TokenTransitions.Duration="MotionDurationMid" />
                            <TransformOperationsTransition Property="RenderTransform"
                                                           Duration="0:0:0.15"
                                                           Easing="0.4,0,0.2,1" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>
        </Style>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="IsWaveSpiritEnabled"
                Value="{atom:OwnerTokenResource EnableWaveSpirit}" />
        <Setter Property="FontWeight" Value="{CompiledBinding $self.ThemeFontWeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^[SizeType=Large]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightLG}" />
            <Setter Property="FontSize" Value="{CompiledBinding $self.ThemeContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource IconSizeLG}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource IconSizeLG}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{CompiledBinding $self.ThemeContentPadding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{CompiledBinding $self.ThemeIconOnyPadding}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{CompiledBinding $self.ThemeContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource IconSize}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{CompiledBinding $self.ThemeContentPadding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{CompiledBinding $self.ThemeIconOnyPadding}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightSM}" />
            <Setter Property="FontSize" Value="{CompiledBinding $self.ThemeContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource IconSizeSM}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource IconSizeSM}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{CompiledBinding $self.ThemeContentPadding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{CompiledBinding $self.ThemeIconOnyPadding}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Custom]">
            <Setter Property="FontSize" Value="{CompiledBinding $self.ThemeContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
            <Setter Property="IconWidth" Value="{atom:OwnerTokenResource IconSize}" />
            <Setter Property="IconHeight" Value="{atom:OwnerTokenResource IconSize}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{CompiledBinding $self.ThemeContentPadding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{CompiledBinding $self.ThemeIconOnyPadding}" />
            </Style>
        </Style>

        <Style Selector="^:icononly">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon, ^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Margin" Value="0" />
            </Style>
        </Style>

        <Style Selector="^:icononly:loading[SizeType=Large]">
            <Setter Property="IconWidth" Value="{CompiledBinding $self.ThemeOnlyIconSize}" />
            <Setter Property="IconHeight" Value="{CompiledBinding $self.ThemeOnlyIconSize}" />
        </Style>
        <Style Selector="^:icononly:loading[SizeType=Middle]">
            <Setter Property="IconWidth" Value="{CompiledBinding $self.ThemeOnlyIconSize}" />
            <Setter Property="IconHeight" Value="{CompiledBinding $self.ThemeOnlyIconSize}" />
        </Style>
        <Style Selector="^:icononly:loading[SizeType=Custom]">
            <Setter Property="IconWidth" Value="{CompiledBinding $self.ThemeOnlyIconSize}" />
            <Setter Property="IconHeight" Value="{CompiledBinding $self.ThemeOnlyIconSize}" />
        </Style>
        <Style Selector="^:icononly:loading[SizeType=Small]">
            <Setter Property="IconWidth" Value="{CompiledBinding $self.ThemeOnlyIconSize}" />
            <Setter Property="IconHeight" Value="{CompiledBinding $self.ThemeOnlyIconSize}" />
        </Style>

        <Style Selector="^[IconPlacement=Start]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="DockPanel.Dock" Value="Left" />
            </Style>
        </Style>

        <Style Selector="^[IconPlacement=End]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="DockPanel.Dock" Value="Right" />
            </Style>
        </Style>

        <Style Selector="^:not(:icononly)">
            <Style Selector="^[IconPlacement=Start] /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="Margin" Value="{TemplateBinding ThemeIconMargin}" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Margin" Value="{TemplateBinding ThemeIconMargin}" />
            </Style>
            <Style Selector="^[IconPlacement=End] /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="Margin" Value="{TemplateBinding ThemeIconEndMargin}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:loading">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Setter Property="Opacity" Value="{atom:OwnerTokenResource OpacityLoading}" />
        </Style>

        <Style Selector="^[Shape=Circle]">
            <Setter Property="Padding" Value="{CompiledBinding $self.ThemeCirclePadding}" />
        </Style>


        <Style Selector="^:disabled[DisablesWithOpacity=False]">
            <Setter Property="Foreground"
                    Value="{atom:OwnerTokenResource ColorTextDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{CompiledBinding $self.ThemeBorderColorDisabled}" />

            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
        </Style>
        <Style Selector="^[EffectiveColor=Default]:disabled[DisablesWithOpacity=False]">
            <Setter Property="BorderBrush"
                    Value="{CompiledBinding $self.ThemeDefaultBorderColorDisabled}" />
        </Style>
        <Style Selector="^:disabled[DisablesWithOpacity=True]">
            <Setter Property="Opacity" Value="{CompiledBinding $self.ThemeDisabledOpacity}" />
        </Style>
        <!-- 公用样式结束 -->

        <!-- Color / Variant 视觉变量开始 -->
        <Style Selector="^:not(:disabled), ^[DisablesWithOpacity=True]">
            <Setter Property="Foreground"
                    Value="{Binding VariantAppearance.Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Background"
                    Value="{Binding VariantAppearance.Background, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding VariantAppearance.Border, RelativeSource={RelativeSource Self}}" />

            <Style Selector="^:is(atom|Button):pointerover:not(:disabled)">
                <Setter Property="Foreground"
                        Value="{Binding VariantAppearance.TextHover, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantAppearance.BackgroundHover, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantAppearance.BorderHover, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style Selector="^:is(atom|Button):pressed[PressMoves=False]">
                <Setter Property="Foreground"
                        Value="{Binding VariantAppearance.TextPressed, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantAppearance.BackgroundPressed, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantAppearance.BorderPressed, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^:is(atom|Button)[PressMoves=True]:pressed:not(:disabled)">
                <Style Selector="^:pressed-text">
                    <Setter Property="Foreground" Value="{Binding VariantAppearance.TextPressed, RelativeSource={RelativeSource Self}}" />
                </Style>
                <Style Selector="^:pressed-background">
                    <Setter Property="Background" Value="{Binding VariantAppearance.BackgroundPressed, RelativeSource={RelativeSource Self}}" />
                </Style>
                <Style Selector="^:pressed-border">
                    <Setter Property="BorderBrush" Value="{Binding VariantAppearance.BorderPressed, RelativeSource={RelativeSource Self}}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[EffectiveVariant=Text]:disabled[DisablesWithOpacity=False], ^[EffectiveVariant=Link]:disabled[DisablesWithOpacity=False]">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Shadcn applies the press offset to the button itself and excludes popup triggers. -->
        <Style Selector="^[PressMoves=True][IsExternalPopupTrigger=False]:pressed:not(:disabled):not(:popup-trigger)">
            <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
        </Style>

        <Style Selector="^[UnderlinesLinkOnHover=True][EffectiveVariant=Link]:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, ^[EffectiveVariant=Link]:link-underlined /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="documents:Inline.TextDecorations" Value="{x:Static atom:ButtonThemeInputs.LinkUnderline}" />
        </Style>

        <Style Selector="^[UsesThemeRecipe=True][EffectiveColor=Default]:not(:disabled)">
            <Style Selector="^:flyout-open, ^[IsExternalPopupOpen=True]">
                <Style Selector="^[EffectiveVariant=Outlined], ^[EffectiveVariant=Text]">
                    <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
                    <Setter Property="Background" Value="{atom:OwnerTokenResource ColorFillContent}" />
                </Style>
                <Style Selector="^:is(atom|Button)[EffectiveVariant=Filled]">
                    <Setter Property="Foreground" Value="{Binding VariantAppearance.Text, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="Background" Value="{Binding VariantAppearance.Background, RelativeSource={RelativeSource Self}}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^ /template/ Border#ShadowsFrame">
            <Setter Property="BoxShadow"
                    Value="{Binding VariantAppearance.Shadow, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
        <!-- Color / Variant 视觉变量结束 -->
    </Style>
</ControlTheme>
