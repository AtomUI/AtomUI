<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:TransferListView}" TargetType="atom:TransferListView">
        <Setter Property="atom:GroupHeaderItem.ThemeContentPadding" Value="{atom:TransferListViewTokenResource ContentPadding}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemColor" Value="{atom:TransferListViewTokenResource ItemColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemHoverColor" Value="{atom:TransferListViewTokenResource ItemHoverColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemSelectedColor" Value="{atom:TransferListViewTokenResource ItemSelectedColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemDisabledColor" Value="{atom:TransferListViewTokenResource ItemDisabledColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemBgColor" Value="{atom:TransferListViewTokenResource ItemBgColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemHoverBgColor" Value="{atom:TransferListViewTokenResource ItemHoverBgColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemSelectedBgColor" Value="{atom:TransferListViewTokenResource ItemSelectedBgColor}" />
        <Setter Property="atom:GroupHeaderItem.ThemeItemPadding" Value="{atom:TransferListViewTokenResource ItemPadding}" />
        <Style Selector="^[SizeType=Small]">
            <Setter Property="atom:GroupHeaderItem.ThemeItemPadding" Value="{atom:TransferListViewTokenResource ItemPaddingSM}" />
        </Style>
        <Style Selector="^[SizeType=Large]">
            <Setter Property="atom:GroupHeaderItem.ThemeItemPadding" Value="{atom:TransferListViewTokenResource ItemPaddingLG}" />
        </Style>
        <Setter Property="atom:GroupHeaderItem.ThemeItemMargin" Value="{atom:TransferListViewTokenResource ItemMargin}" />
        <Setter Property="atom:GroupHeaderItem.ThemeGroupHeaderColor" Value="{atom:TransferListViewTokenResource GroupHeaderColor}" />



        <ControlTheme.BasedOn>
            <atom:ListViewTheme TargetType="atom:TransferListView" />
        </ControlTheme.BasedOn>

        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="PaginationVisibility" Value="Bottom" />
        <Setter Property="BottomPaginationAlign" Value="Start" />
        <Setter Property="IsHideOnSinglePage" Value="False" />
        <Style Selector="^ /template/ ContentPresenter#TopPaginationPresenter">
            <Setter Property="Margin" Value="{atom:TransferListViewTokenResource PaginationMargin}"/>
        </Style>
        
        <Style Selector="^ /template/ ContentPresenter#BottomPaginationPresenter">
            <Setter Property="Margin" Value="{atom:TransferListViewTokenResource PaginationMargin}"/>
        </Style>
        
        <Style Selector="^[IsPaginationEnabled=False]">
            <Style Selector="^ /template/ ContentPresenter#TopPaginationPresenter">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
        
            <Style Selector="^ /template/ ContentPresenter#BottomPaginationPresenter">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
        </Style>
        
    </ControlTheme>
</ResourceDictionary>
