<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StringToTextBlockConverter" VerticalAlignment="Center" />
    <ControlTheme x:Key="{x:Type atom:PaginationNavItem}" TargetType="atom:PaginationNavItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:PixelAlignedBorder Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}"
                                             CornerRadius="{TemplateBinding CornerRadius}"
                                             BorderThickness="{TemplateBinding BorderThickness}" />
                    <atom:IconPresenter Name="IconPresenter"
                                         IsVisible="False"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Icon="{TemplateBinding Icon}"
                                         IsEnabled="{TemplateBinding IsEnabled}" />
                    <atom:IconPresenter Name="JumpIconPresenter"
                                         IsVisible="False"
                                         Opacity="0"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Icon="{TemplateBinding JumpIcon}"
                                         IsEnabled="{TemplateBinding IsEnabled}" />
                    <!-- The inline padding (PaginationItemPaddingInline) keeps wide page numbers off the item border. -->
                    <ContentPresenter Name="ContentPresenter"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Content="{TemplateBinding Content, Mode=Default, Converter={StaticResource StringToTextBlockConverter}}"
                                      IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
        <Setter Property="FontSize" Value="{atom:OwnerTokenResource FontSize}" />
        <Setter Property="Padding"
                Value="{atom:PaginationTokenResource PaginationItemPaddingInline}" />
        <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorTransparent}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
        <!-- The icon presenters are registered parts (owner reads on them resolve to IconPresenter): the item reads its
             host's icon size and brushes and the presenters bind them. -->
        <Setter Property="JumpIconBrush" Value="{atom:OwnerTokenResource ColorPrimary}" />
        <Setter Property="EllipsisIconBrush" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
        <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
            <Setter Property="IconBrush" Value="{TemplateBinding Foreground}" />
            <Setter Property="Width" Value="{TemplateBinding ItemIconSize}" />
            <Setter Property="Height" Value="{TemplateBinding ItemIconSize}" />
        </Style>
        <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
            <Setter Property="IconBrush" Value="{TemplateBinding JumpIconBrush}" />
            <Setter Property="Width" Value="{TemplateBinding ItemIconSize}" />
            <Setter Property="Height" Value="{TemplateBinding ItemIconSize}" />
        </Style>

        <Style Selector="^[PaginationItemType=PageIndicator]">
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="^[PaginationItemType=Previous], ^[PaginationItemType=Next]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[PaginationItemType=JumpPrevious], ^[PaginationItemType=JumpNext]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="IconBrush" Value="{TemplateBinding EllipsisIconBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Opacity" Value="0" />
            </Style>
            <Style Selector="^:pointerover, ^:focus-visible">
                <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[IsEnabled=True]">
            <Setter Property="Cursor" Value="Hand" />

            <Style Selector="^[PaginationItemType=PageIndicator]">
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorPrimary}" />
                    <Setter Property="Background"
                            Value="{atom:PaginationTokenResource ItemActiveBg}" />
                    <Setter Property="FontWeight" Value="{atom:OwnerTokenResource FontWeightStrong}" />
                    <Setter Property="BorderBrush"
                            Value="{atom:OwnerTokenResource ColorPrimary}" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Foreground"
                                Value="{atom:OwnerTokenResource ColorPrimaryHover}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:OwnerTokenResource ColorPrimaryHover}" />
                    </Style>
                </Style>
                <Style Selector="^:not(:selected)">
                    <Setter Property="Background" Value="{atom:PaginationTokenResource ItemBg}" />
                    <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Background"
                                Value="{atom:OwnerTokenResource ColorBgTextHover}" />
                    </Style>
                    <Style Selector="^:pressed">
                        <Setter Property="Background"
                                Value="{atom:OwnerTokenResource ColorBgTextActive}" />
                    </Style>
                </Style>
            </Style>

            <Style Selector="^[PaginationItemType=Previous], ^[PaginationItemType=Next]">
                <Setter Property="Background"
                        Value="{atom:OwnerTokenResource ColorTransparent}" />
                <Setter Property="Foreground"
                        Value="{atom:OwnerTokenResource ColorText}" />
                <Style Selector="^:pointerover">
                    <Setter Property="Background"
                            Value="{atom:OwnerTokenResource ColorBgTextHover}" />
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background"
                            Value="{atom:OwnerTokenResource ColorBgTextActive}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSize}" />
            <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSize}" />
            <Setter Property="ItemIconSize" Value="{atom:OwnerTokenResource IconSizeLG}" />

        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSize}" />
            <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSize}" />
            <Setter Property="ItemIconSize" Value="{atom:OwnerTokenResource IconSize}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSizeSM}" />
            <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSizeSM}" />
            <Setter Property="ItemIconSize" Value="{atom:OwnerTokenResource IconSizeSM}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:PaginationTokenResource ItemActiveColorDisabled}" />
            <Style Selector="^:selected">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background"
                        Value="{atom:PaginationTokenResource ItemActiveBgDisabled}" />
            </Style>

            <Style Selector="^[PaginationItemType=JumpPrevious], ^[PaginationItemType=JumpNext]">
                <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="^ /template/ atom|IconPresenter#JumpIconPresenter">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IconBrush" Value="{TemplateBinding EllipsisIconBrush}" />
                </Style>
            </Style>

        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter, ^ /template/ atom|IconPresenter#JumpIconPresenter">
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" atom:TokenTransitions.Duration="MotionDurationMid" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
