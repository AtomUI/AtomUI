<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CascaderViewFilterList}" TargetType="atom:CascaderViewFilterList">
        <ControlTheme.BasedOn>
            <atom:ListBoxTheme TargetType="atom:CascaderViewFilterList" />
        </ControlTheme.BasedOn>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type atom:CascaderViewFilterListItem}" TargetType="atom:CascaderViewFilterListItem">
        <ControlTheme.BasedOn>
            <atom:ListBoxItemTheme TargetType="atom:CascaderViewFilterListItem" />
        </ControlTheme.BasedOn>
        <Setter Property="BorderThickness" Value="0" />

        <Style Selector="^:is(atom|CascaderViewFilterListItem)">
            <Style Selector="^:pointerover:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:ListBoxTokenResource ItemColor}" />
                <Setter Property="Background" Value="{atom:ListBoxTokenResource ItemBgColor}" />
            </Style>

            <Style Selector="^[IsSelected=False][IsCandidateSelected=True]:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:ListBoxTokenResource ItemHoverColor}" />
                <Setter Property="Background" Value="{atom:ListViewTokenResource ItemHoverBgColor}" />
            </Style>

            <Style Selector="^[IsSelected=True]:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:ListBoxTokenResource ItemSelectedColor}" />
                <Setter Property="Background" Value="{atom:ListBoxTokenResource ItemSelectedBgColor}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
