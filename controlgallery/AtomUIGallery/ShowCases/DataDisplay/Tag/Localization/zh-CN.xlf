    <unit id="PageDescription">
      <segment>
        <source>Tag displays short labels with preset, status and custom colors across Filled, Solid and Outlined variants.</source>
        <target state="translated">Tag 用于展示短标签，支持预设、状态和自定义颜色，并可组合浅色填充、实色填充和描边形态。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Label, categorize and mark status with compact colored chips.</source>
        <target state="translated">用紧凑的彩色标签进行标记、分类和状态表达。</target>
      </segment>
    </unit>
