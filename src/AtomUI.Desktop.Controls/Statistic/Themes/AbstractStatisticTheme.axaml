<ControlTheme TargetType="atom:AbstractStatistic"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.AbstractStatisticTheme"
              x:ClassModifier="internal">
    <Setter Property="FontFamily">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
            <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontFamily" />
        </MultiBinding>
    </Setter>
    <Setter Property="FontSize">
        <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
            <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
            <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
            <atom:OwnerTokenResource Kind="FontSize" />
        </MultiBinding>
    </Setter>
    <Style Selector="^:is(atom|AbstractStatistic)">
        <Style Selector="^ /template/ ContentPresenter#HeaderPresenter">
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource Kind=ColorTextDescription, AnchorControlType={x:Type atom:AbstractStatistic}}" />
            <Setter Property="FontSize" Value="{atom:StatisticTokenResource TitleFontSize}" />
        </Style>

        <Setter Property="ContentForeground" Value="{atom:OwnerTokenResource ColorTextHeading}" />
        <Setter Property="ContentFontSize" Value="{atom:StatisticTokenResource ContentFontSize}" />

        <Style Selector="^ /template/ StackPanel#ContentLayout">
            <Setter Property="TextElement.Foreground" Value="{TemplateBinding ContentForeground}" />
            <Setter Property="TextElement.FontSize" Value="{TemplateBinding ContentFontSize}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#ValuePrefixAddOn atom|Icon">
            <Setter Property="FillBrush"
                    Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}" />
            <Setter Property="StrokeBrush"
                    Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}" />
            <Setter Property="Width"
                    Value="{Binding (TextElement.FontSize), RelativeSource={RelativeSource AncestorType=StackPanel}}" />
            <Setter Property="Height"
                    Value="{Binding (TextElement.FontSize), RelativeSource={RelativeSource AncestorType=StackPanel}}" />
        </Style>
    </Style>
</ControlTheme>
