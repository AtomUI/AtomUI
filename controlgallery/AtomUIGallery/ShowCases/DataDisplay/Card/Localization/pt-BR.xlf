    <unit id="PageDescription">
      <segment>
        <source>Card presents information in a contained surface. It supports headers, extra actions, cover media, metadata, grid sections, tabs, loading placeholders, hover feedback, and borderless presentation.</source>
        <target state="translated">Cartão presents informação em a contained surface. Isso oferece suporte headers, extra ações, cover media, metadata, grid sections, guias, carregando placeholders, sobreposição feedback, e sem borda presentation.</target>
      </segment>
    </unit>
