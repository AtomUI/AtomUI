<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Package-wide compiler severity also covers source-generator diagnostics on external AXAML. -->
        <WarningsAsErrors>$(WarningsAsErrors);ATOMUIGEN041;ATOMUIGEN042;ATOMUIGEN043;ATOMUIGEN044;ATOMUIGEN045;ATOMUIGEN047</WarningsAsErrors>
        <AtomUIThemeConsumptionAnalysis>true</AtomUIThemeConsumptionAnalysis>
        <TargetFrameworks>$(AtomUITargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>GeneratedFiles</CompilerGeneratedFilesOutputPath>
        <AtomUIGenerateControlThemeAssetResources>true</AtomUIGenerateControlThemeAssetResources>
        <AtomUIRegistrationPackageId>$(AssemblyName)</AtomUIRegistrationPackageId>
        <RootNamespace>AtomUI.Desktop.Controls</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../AtomUI.Generator/AtomUI.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"/>
        <ProjectReference Include="../AtomUI.Desktop.Controls/AtomUI.Desktop.Controls.csproj" />
    </ItemGroup>

</Project>
