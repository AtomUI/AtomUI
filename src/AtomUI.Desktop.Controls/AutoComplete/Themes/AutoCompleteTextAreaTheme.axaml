<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:AutoCompleteTextArea}" TargetType="atom:AutoCompleteTextArea">
        <ControlTheme.BasedOn>
            <atom:AbstractAutoCompleteTheme TargetType="atom:AutoCompleteTextArea" />
        </ControlTheme.BasedOn>

        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.PresetFontSizeConverter}">
                <CompiledBindingExtension Path="$self.SizeType" />
                <atom:OwnerTokenResource Kind="FontSize" />
                <atom:OwnerTokenResource Kind="FontSizeSM" />
                <atom:OwnerTokenResource Kind="FontSizeLG" />
            </MultiBinding>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:AutoCompleteTextAreaBox Foreground="{CompiledBinding $parent[atom:AutoCompleteTextArea].Foreground, Priority=LocalValue}"
                                                  FontFamily="{TemplateBinding FontFamily}"
                                                  FontSize="{CompiledBinding $parent[atom:AutoCompleteTextArea].FontSize, Priority=LocalValue}"
                                                  Name="{x:Static atom:AutoCompleteThemeConstants.TextBoxPart}"
                                                  Classes.semantic-scope-input="True"
                                                  IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                  IsAllowClear="{TemplateBinding IsAllowClear}"
                                                  StyleVariant="{TemplateBinding StyleVariant}"
                                                  Status="{TemplateBinding Status}"
                                                  FormStatus="{TemplateBinding FormStatus}"
                                                  DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                                                  CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                                                  InnerLeftContent="{TemplateBinding ContentLeftAddOn}"
                                                  InnerLeftContentTemplate="{TemplateBinding ContentLeftAddOnTemplate}"
                                                  InnerRightContent="{TemplateBinding ContentRightAddOn}"
                                                  InnerRightContentTemplate="{TemplateBinding ContentRightAddOnTemplate}"
                                                  SizeType="{TemplateBinding SizeType}"
                                                  PlaceholderText="{TemplateBinding PlaceholderText}"
                                                  PlaceholderForeground="{CompiledBinding $parent[atom:AutoCompleteTextArea].PlaceholderForeground, Priority=LocalValue}"
                                                  IsReadOnly="{TemplateBinding IsReadOnly}"
                                                  Focusable="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}"
                                                  Lines="{TemplateBinding Lines}"
                                                  IsAutoSize="{TemplateBinding IsAutoSize}"
                                                  IsShowCount="{TemplateBinding IsShowCount}"
                                                  IsResizable="{TemplateBinding IsResizable}"
                                                  IsDropDownOpen="{TemplateBinding IsDropDownOpen}"
                                                  ClearIcon="{TemplateBinding ClearIcon}"
                                                  FormFeedback="{TemplateBinding FormFeedback}">
                        <atom:AutoCompleteTextAreaBox.LineHeight>
                            <MultiBinding Converter="{x:Static atom:CompoundInputTypographyBindings.LineHeight}" Priority="LocalValue">
                                <CompiledBindingExtension Path="$self.FontFamily" />
                                <CompiledBindingExtension Path="$self.FontSize" />
                                <CompiledBindingExtension Path="$self.FontStyle" />
                                <CompiledBindingExtension Path="$self.FontWeight" />
                                <CompiledBindingExtension Path="$self.FontStretch" />
                                <CompiledBindingExtension Path="$self.SizeType" />
                                <atom:AutoCompleteTextAreaTokenResource Kind="FontHeight" WhenExplicit="True" />
                                <atom:AutoCompleteTextAreaTokenResource Kind="FontHeight" />
                                <atom:AutoCompleteTextAreaTokenResource Kind="FontHeightSM" WhenExplicit="True" />
                                <atom:AutoCompleteTextAreaTokenResource Kind="FontHeightSM" />
                                <atom:AutoCompleteTextAreaTokenResource Kind="FontHeightLG" WhenExplicit="True" />
                                <atom:AutoCompleteTextAreaTokenResource Kind="FontHeightLG" />
                            </MultiBinding>
                        </atom:AutoCompleteTextAreaBox.LineHeight>
                    </atom:AutoCompleteTextAreaBox>

                    <atom:Popup Name="{x:Static atom:AutoCompleteThemeConstants.PopupPart}"
                                OpenMotion="{TemplateBinding OpenMotion}"
                                CloseMotion="{TemplateBinding CloseMotion}"
                                WindowManagerAddShadowHint="False"
                                IsLightDismissEnabled="True"
                                OverlayDismissEventPassThrough="True"
                                ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                RequestedPlacement="{TemplateBinding PopupPlacement}">

                        <Border Name="PopupFrame"
                                Classes.semantic-popup-root="True"
                                MaxHeight="{TemplateBinding MaxPopupHeight}"
                                MinWidth="{TemplateBinding MinPopupWidth}"
                                Padding="{TemplateBinding PopupContentPadding}">
                            <atom:CandidateList Name="{x:Static atom:AutoCompleteThemeConstants.CandidateListPart}"
                                                Classes.semantic-popup-list="True"
                                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                SelectionMode="Single"
                                                ItemTemplate="{TemplateBinding OptionTemplate}" />
                        </Border>
                    </atom:Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
