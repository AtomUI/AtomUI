<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SearchEditDecoratedBox}" TargetType="atom:SearchEditDecoratedBox">
        <ControlTheme.BasedOn>
            <atom:AddOnDecoratedBoxTheme TargetType="atom:SearchEditDecoratedBox" />
        </ControlTheme.BasedOn>

        <Setter Property="Template">
            <ControlTemplate>
                <atom:SearchEditPanel Name="RootLayout" ClipToBounds="False">
                    <atom:PixelAlignedBorder
                        Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.LeftAddOnPart}"
                        VerticalAlignment="Stretch"
                        Focusable="False"
                        BackgroundSizing="InnerBorderEdge"
                        BorderThickness="{TemplateBinding LeftAddOnBorderThickness}"
                        CornerRadius="{TemplateBinding LeftAddOnCornerRadius}"
                        IsVisible="{Binding Child, ElementName=PART_LeftAddOnPresenter, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <atom:AddOnContentPresenter
                            Name="PART_LeftAddOnPresenter"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Focusable="False"
                            Content="{TemplateBinding LeftAddOn}"
                            ContentTemplate="{TemplateBinding LeftAddOnTemplate}" />
                    </atom:PixelAlignedBorder>

                    <atom:Button
                        Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.RightAddOnPart}"
                        Focusable="False"
                        IsEnabled="{TemplateBinding IsEnabled}"
                        BackgroundSizing="OuterBorderEdge"
                        IsLoading="{TemplateBinding IsSearchButtonLoading}"
                        Content="{TemplateBinding SearchButtonText}"
                        Height="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}"
                        SizeType="{TemplateBinding SizeType}"
                        Theme="{TemplateBinding SearchButtonTheme}"
                        BorderThickness="{Binding RightAddOnBorderThickness, RelativeSource={RelativeSource TemplatedParent}, Priority=LocalValue}"
                        CornerRadius="{Binding RightAddOnCornerRadius, RelativeSource={RelativeSource TemplatedParent}, Priority=LocalValue}">
                        <atom:Button.Icon>
                            <antdicons:SearchOutlined Classes="skip-status" />
                        </atom:Button.Icon>
                    </atom:Button>

                    <atom:AddOnDecoratedBoxContentFrame Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentFramePart}"
                                                        BorderThickness="{TemplateBinding InnerBoxBorderThickness}"
                                                        CornerRadius="{TemplateBinding InnerBoxCornerRadius}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        Background="{TemplateBinding Background}"
                                                        BoxShadow="{TemplateBinding BoxShadow}"
                                                        BackgroundSizing="OuterBorderEdge">
                        <DockPanel Name="ContentLayout" LastChildFill="True">
                            <atom:AddOnContentPresenter
                                Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentLeftAddOnPart}"
                                Classes.semantic-scope-prefix="True"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"
                                Focusable="False"
                                Content="{TemplateBinding ContentLeftAddOn}"
                                ContentTemplate="{TemplateBinding ContentLeftAddOnTemplate}" />

                            <atom:AddOnContentPresenter
                                DockPanel.Dock="Right"
                                Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentRightAddOnPart}"
                                Classes.semantic-scope-suffix="True"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Right"
                                Focusable="False"
                                Content="{TemplateBinding ContentRightAddOn}"
                                ContentTemplate="{TemplateBinding ContentRightAddOnTemplate}" />

                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </DockPanel>
                    </atom:AddOnDecoratedBoxContentFrame>
                </atom:SearchEditPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="ClipToBounds" Value="False" />
        <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
            <Setter Property="ZIndex" Value="{x:Static atom:AddOnDecoratedBoxThemeConstants.NormalZIndex}" />
        </Style>

        <Style Selector="^[SearchButtonStyle=Default]">
            <Style
                Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame:focus-within">
                <Setter Property="ZIndex" Value="{x:Static atom:AddOnDecoratedBoxThemeConstants.ActivatedZIndex}" />
            </Style>
            <Style
                Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame:pointerover">
                <Setter Property="ZIndex" Value="{x:Static atom:AddOnDecoratedBoxThemeConstants.ActivatedZIndex}" />
            </Style>

            <Style Selector="^ /template/ atom|Button#PART_RightAddOn">
                <Setter Property="ZIndex" Value="{x:Static atom:AddOnDecoratedBoxThemeConstants.NormalZIndex}" />
                <Setter Property="IsIconVisible" Value="True" />
                <Setter Property="ButtonType" Value="Default" />
            </Style>

            <Style Selector="^[StyleVariant=Outlined]">
                <Style
                    Selector="^ /template/ atom|Button#PART_RightAddOn:pressed">
                    <Setter Property="ZIndex" Value="{x:Static atom:AddOnDecoratedBoxThemeConstants.ActivatedZIndex}" />
                </Style>

                <Style
                    Selector="^ /template/ atom|Button#PART_RightAddOn:pointerover">
                    <Setter Property="ZIndex" Value="{x:Static atom:AddOnDecoratedBoxThemeConstants.ActivatedZIndex}" />
                </Style>
            </Style>

        </Style>

        <Style Selector="^[SearchButtonStyle=Primary]">
            <Style Selector="^ /template/ atom|Button#PART_RightAddOn">
                <Setter Property="IsIconVisible" Value="True" />
                <Setter Property="ButtonType" Value="Primary" />
            </Style>
            <Style Selector="^[StyleVariant=Outlined]">
                <Style Selector="^ /template/ atom|Button#PART_RightAddOn">
                    <Setter Property="ZIndex" Value="{x:Static atom:AddOnDecoratedBoxThemeConstants.ActivatedZIndex}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:not(^[StyleVariant=Outlined])">
            <Style Selector="^ /template/ atom|Button#PART_RightAddOn">
                <Setter Property="ButtonType" Value="Text" />
            </Style>
        </Style>

        <Style Selector="^[StyleVariant=Filled]">
            <Style Selector="^ /template/ atom|Button#PART_RightAddOn[ButtonType=Text]">
                <Setter Property="Background" Value="{atom:SearchEditTokenResource ColorFillTertiary}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveStatus=Error]">
            <Style Selector="^ /template/ atom|Button#PART_RightAddOn[ButtonType=Text]">
                <Setter Property="Background" Value="{atom:SearchEditTokenResource ColorErrorBg}" />
            </Style>
            <Style Selector="^ /template/ atom|Button#PART_RightAddOn[ButtonType=Text]:pointerover">
                <Setter Property="Background" Value="{atom:SearchEditTokenResource ColorErrorBgHover}" />
            </Style>
            <Style Selector="^ /template/ atom|Button#PART_RightAddOn[ButtonType=Text]:pressed">
                <Setter Property="Background" Value="{atom:SearchEditTokenResource ColorErrorBgActive}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveStatus=Warning]">
            <Style Selector="^ /template/ atom|Button#PART_RightAddOn[ButtonType=Text]">
                <Setter Property="Background" Value="{atom:SearchEditTokenResource ColorWarningBg}" />
            </Style>
            <Style Selector="^ /template/ atom|Button#PART_RightAddOn[ButtonType=Text]:pointerover">
                <Setter Property="Background" Value="{atom:SearchEditTokenResource ColorWarningHover}" />
            </Style>
            <Style Selector="^ /template/ atom|Button#PART_RightAddOn[ButtonType=Text]:pressed">
                <Setter Property="Background" Value="{atom:SearchEditTokenResource ColorWarningActive}" />
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
