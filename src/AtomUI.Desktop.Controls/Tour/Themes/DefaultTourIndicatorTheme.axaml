<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:DefaultTourIndicator}" TargetType="atom:DefaultTourIndicator">

        <Setter Property="ItemSpacing" Value="{atom:OwnerTokenResource Kind=SpacingXXS, AnchorControlType={x:Type atom:DefaultTourIndicator}}" />
        <Setter Property="IndicatorSize" Value="{atom:TourTokenResource IndicatorSize}" />
        <Setter Property="IndicatorColor" Value="{atom:OwnerTokenResource Kind=ColorFill, AnchorControlType={x:Type atom:DefaultTourIndicator}}" />
        <Setter Property="IndicatorActiveColor"
                Value="{atom:OwnerTokenResource Kind=ColorPrimary, AnchorControlType={x:Type atom:DefaultTourIndicator}}" />

        <Setter Property="Template">
            <ControlTemplate>
                <!-- Code-created dots have no TemplatedParent. Give them a local
                     implicit ControlTheme so defaults stay below owner semantic
                     styles; ordinary local StyleTriggers would override that entry.
                     Layout remains N*size+(N+1)*spacing. -->
                <StackPanel Name="DotsLayout"
                            Orientation="Horizontal"
                            Margin="{TemplateBinding ItemSpacing}"
                            Spacing="{TemplateBinding ItemSpacing}">
                    <StackPanel.Resources>
                        <ControlTheme x:Key="{x:Type Ellipse}" TargetType="Ellipse">
                            <Setter Property="Width" Value="{Binding IndicatorSize, RelativeSource={RelativeSource AncestorType=atom:DefaultTourIndicator}}" />
                            <Setter Property="Height" Value="{Binding IndicatorSize, RelativeSource={RelativeSource AncestorType=atom:DefaultTourIndicator}}" />
                            <Setter Property="Fill" Value="{Binding IndicatorColor, RelativeSource={RelativeSource AncestorType=atom:DefaultTourIndicator}}" />
                            <Style Selector="^.semantic-popup-indicator.active">
                                <Setter Property="Fill" Value="{Binding IndicatorActiveColor, RelativeSource={RelativeSource AncestorType=atom:DefaultTourIndicator}}" />
                            </Style>
                        </ControlTheme>
                    </StackPanel.Resources>
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[StyleType=Primary]">
            <Setter Property="IndicatorColor"
                    Value="{atom:TourTokenResource PrimaryPrevBtnBg}" />
            <Setter Property="IndicatorActiveColor"
                    Value="{atom:OwnerTokenResource Kind=ColorTextLightSolid, AnchorControlType={x:Type atom:DefaultTourIndicator}}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
