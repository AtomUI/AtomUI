<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:AtomUI.Desktop.Controls.Primitives"
    xmlns:atom="https://atomui.net"
    >
    <ControlTheme x:Key="{x:Type primitives:IndicatorScrollBarThumb}"
                  TargetType="primitives:IndicatorScrollBarThumb">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                </Border>
            </ControlTemplate>
        </Setter>
                
        <!-- The previous non-host duration binding was inert (0ms). Keep that
             default, and opt in through an explicitly configured owner duration. -->
        <Style Selector="^ /template/ Border#Frame">
            <Setter Property="Transitions">
                <atom:TokenTransitions UnconfiguredDuration="0:0:0">
                    <atom:SolidColorBrushTransition Property="Background" Easing="LinearEasing"
                                                   Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </atom:TokenTransitions>
            </Setter>
        </Style>

        <Setter Property="Background" Value="{atom:ScrollViewerTokenResource ThumbBg}"/>
        <Setter Property="CornerRadius" Value="{atom:ScrollViewerTokenResource IndicatorThumbCornerRadius}"/>
        <Setter Property="MinHeight"
                Value="{atom:ScrollViewerTokenResource LiteModeThumbThickness}" />
        <Setter Property="Width" Value="{atom:ScrollViewerTokenResource NormalModeThumbThickness}" />
    </ControlTheme>
</ResourceDictionary>
