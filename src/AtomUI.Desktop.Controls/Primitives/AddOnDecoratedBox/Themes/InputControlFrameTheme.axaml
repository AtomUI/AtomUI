<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.InputControlFrameTheme"
              TargetType="atom:InputControlFrame"
              x:ClassModifier="internal">
    <!-- The frame expresses focus through :focus-within (border and outline shadow). Templates make frames
         focusable for pointer hits on padding; they must never add an adorner frame. -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:InputControlFrame">
            <atom:PixelAlignedBorder
                Name="InnerBoxDecorator"
                Padding="{TemplateBinding Padding}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BoxShadow="{TemplateBinding BoxShadow}"
                BackgroundSizing="InnerBorderEdge">
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </atom:PixelAlignedBorder>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|InputControlFrame)">
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
        <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
        
        <!-- Addon padding per size lives in AddOnDecoratedBoxTheme, the only theme with addon parts. -->
        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadius}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
        </Style>

        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />

        <!-- The surface values of each StyleVariant x EffectiveStatus are theme variables that InputControlFrame reads
             from the owner's effective Tokens (Frame*); these styles map the interaction states onto them. Within a
             variant the later style wins: base, hover, then focus-within / pressed. -->
        <Style Selector="^:outline, ^:filled, ^:underlined">
            <Setter Property="BorderBrush"
                    Value="{CompiledBinding $self.FrameBorderBrush, Converter={x:Static atom:InputControlFrame.ThemeVariableConverter}}" />
        </Style>
        <Style Selector="^:outline, ^:filled">
            <Setter Property="Background"
                    Value="{CompiledBinding $self.FrameBackground, Converter={x:Static atom:InputControlFrame.ThemeVariableConverter}}" />
        </Style>
        <Style Selector="^:outline[IsInnerBoxHover=True], ^:underlined[IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{CompiledBinding $self.FrameHoverBorderBrush, Converter={x:Static atom:InputControlFrame.ThemeVariableConverter}}" />
        </Style>
        <Style Selector="^:filled[IsInnerBoxHover=True]">
            <Setter Property="Background"
                    Value="{CompiledBinding $self.FrameHoverBackground, Converter={x:Static atom:InputControlFrame.ThemeVariableConverter}}" />
        </Style>
        <Style Selector="^:outline:focus-within, ^:outline:pressed">
            <Setter Property="BorderBrush"
                    Value="{CompiledBinding $self.FrameActiveBorderBrush, Converter={x:Static atom:InputControlFrame.ThemeVariableConverter}}" />
            <Setter Property="BoxShadow"
                    Value="{CompiledBinding $self.FrameActiveShadow, Converter={x:Static atom:InputControlFrame.ThemeVariableConverter}}" />
        </Style>
        <Style Selector="^:filled:focus-within">
            <Setter Property="BorderBrush"
                    Value="{CompiledBinding $self.FrameActiveBorderBrush, Converter={x:Static atom:InputControlFrame.ThemeVariableConverter}}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:filled:pressed, ^:underlined:focus-within, ^:underlined:pressed">
            <Setter Property="BorderBrush"
                    Value="{CompiledBinding $self.FrameActiveBorderBrush, Converter={x:Static atom:InputControlFrame.ThemeVariableConverter}}" />
        </Style>

        <!-- Add-on parts -->
        <Style Selector="^:outline[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:outline[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorError}" />
        </Style>
        <Style Selector="^:outline[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:outline[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorWarning}" />
        </Style>
        <Style Selector="^:filled /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:filled /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorFillTertiary}" />
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorFillTertiary}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:filled[EffectiveStatus=Error] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorErrorBg}" />
        </Style>
        <Style Selector="^:filled[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:filled[EffectiveStatus=Warning] /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorWarningBg}" />
        </Style>
        <Style Selector="^:borderless /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:borderless /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:underlined /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:underlined /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Disabled -->
        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:OwnerTokenResource ColorTextDisabled}" />
        </Style>
        <Style Selector="^:disabled:outline, ^:disabled:filled">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>
        <Style Selector="^:disabled:outline /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:disabled:outline /template/ atom|PixelAlignedBorder#PART_RightAddOn,
                         ^:disabled:filled /template/ atom|PixelAlignedBorder#PART_LeftAddOn,
                         ^:disabled:filled /template/ atom|PixelAlignedBorder#PART_RightAddOn">
            <Setter Property="Background"
                    Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>
        <Style Selector="^:disabled:underlined">
            <Setter Property="BorderBrush"
                    Value="{atom:OwnerTokenResource ColorBorder}" />
        </Style>

        <!-- Root brushes of the hosting input control (template-bound into HostBorderBrush / HostBackground) win over
             every state brush above, mirroring antd styles.root; unset hands the surface back to the state machine. -->
        <Style Selector="^:host-border-brush">
            <Setter Property="BorderBrush"
                    Value="{Binding (atom:InputControlFrame).HostBorderBrush, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style Selector="^:host-background">
            <Setter Property="Background"
                    Value="{Binding (atom:InputControlFrame).HostBackground, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationMid" />
                        <atom:BoxShadowsTransition Property="BoxShadow" atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#InnerBoxDecorator">
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="MotionDurationMid" />
                            <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationMid" />
                            <atom:BoxShadowsTransition Property="BoxShadow" atom:TokenTransitions.Duration="MotionDurationMid" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>
        </Style>
    </Style>

</ControlTheme>
