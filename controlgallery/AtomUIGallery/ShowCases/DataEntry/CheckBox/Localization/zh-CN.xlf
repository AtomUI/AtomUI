    <unit id="PageDescription">
      <segment>
        <source>CheckBox supports checked, unchecked, indeterminate, disabled, controlled, grouped, and check-all states for forms and option lists.</source>
        <target state="translated">CheckBox 支持选中、未选中、半选、禁用、受控、分组和全选状态，适用于表单和选项列表。</target>
      </segment>
    </unit>
