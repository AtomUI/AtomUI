<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>AtomUI.Build.Tasks.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/AtomUI.Toolchain/AtomUI.Toolchain.csproj" />
        <ProjectReference Include="../../src/AtomUI.Generator/AtomUI.Generator.csproj"
                          ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
        <AssemblyMetadata Include="FixtureGeneratorAssembly"
                          Value="$([System.IO.Path]::GetFullPath('$(OutputPathWithoutFramework)/netstandard2.0/AtomUI.Generator.dll'))" />
    </ItemGroup>
</Project>
