<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net"
                    xmlns:viewer="clr-namespace:AtomUI.Desktop.Controls.Internal.DateViewer"
                    xmlns:controls="clr-namespace:AtomUI.Desktop.Controls"
                    x:ClassModifier="internal">
        <!-- The Calendar forwards its Token owner to the DateViewer of its template, so these cells read the hosting
             Calendar's (or LunarCalendar's) global Tokens from the owner; the Calendar Own Tokens are read explicitly. -->
        <ControlTheme x:Key="CalendarDateCellTheme" TargetType="viewer:DateViewerCell">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate TargetType="viewer:DateViewerCell">
                    <Border Name="PART_Item"
                            Background="{TemplateBinding Background}"
                            Cursor="Hand"
                            Focusable="False"
                            Padding="0"
                            ClipToBounds="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Name="PART_CellInner"
                                TemplatedControl.IsTemplateFocusTarget="True"
                                Background="Transparent"
                                Cursor="Hand"
                                ClipToBounds="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Grid ClipToBounds="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ContentControl Name="PART_CellContent"
                                                Classes.semantic-cell-content="True"
                                                Content="{TemplateBinding Context}" ContentTemplate="{TemplateBinding CellTemplate}"
                                                Cursor="Hand"
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                ClipToBounds="False"
                                                IsVisible="False" />
                                <atom:TextBlock Name="PART_Value"
                                                Cursor="Hand"
                                                Grid.Row="0"
                                                Text="{TemplateBinding DisplayText}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                <Border Grid.Row="0" Name="PART_CellOutline" Grid.RowSpan="2"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>

            <!-- 基础单元格视觉 -->
            <Style Selector="^ /template/ Border#PART_Item">
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationSlow" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#PART_CellInner">
                <Setter Property="MinWidth" Value="{atom:OwnerTokenResource ControlHeightSM}" />
                <Setter Property="MinHeight" Value="{atom:OwnerTokenResource ControlHeightSM}" />
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <atom:SolidColorBrushTransition Property="Background" atom:TokenTransitions.Duration="MotionDurationSlow" />
                            <atom:SolidColorBrushTransition Property="BorderBrush" atom:TokenTransitions.Duration="MotionDurationSlow" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ atom|TextBlock#PART_Value">
                <!-- Foreground inherits from the cell; state colors belong to the cell theme. -->
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <atom:SolidColorBrushTransition Property="Foreground" atom:TokenTransitions.Duration="MotionDurationSlow" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>

            <!-- Mini 布局 -->
            <Style Selector="^[Presentation=Compact] /template/ Border#PART_Item">
                <Setter Property="Height" Value="{atom:OwnerTokenResource ControlHeightSM}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="^[Presentation=Compact] /template/ Border#PART_CellInner">
                <Setter Property="Width" Value="{atom:OwnerTokenResource ControlHeightSM}" />
                <Setter Property="Height" Value="{atom:OwnerTokenResource ControlHeightSM}" />
                <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="^[Presentation=Compact] /template/ Border#PART_CellOutline">
                <Setter Property="CornerRadius" Value="{atom:OwnerTokenResource BorderRadiusSM}" />
            </Style>
            <Style Selector="^[Presentation=Compact]:month /template/ Border#PART_CellInner">
                <Setter Property="Width" Value="{atom:CalendarTokenResource YearMonthCellWidth}" />
            </Style>
            <!-- Without custom cell content the value is centered in the whole cell box (Ant Design line-height
                 centering); the Auto row alone would leave it near the top of the box. -->
            <Style Selector="^[Presentation=Compact]:not(:cell-template) /template/ atom|TextBlock#PART_Value">
                <Setter Property="Grid.RowSpan" Value="2" />
            </Style>

            <!-- Fullscreen 布局 -->
            <Style Selector="^[Presentation=Content] /template/ Border#PART_Item">
                <Setter Property="Margin" Value="{atom:CalendarTokenResource FullCellMargin}" />
            </Style>
            <Style Selector="^[Presentation=Content] /template/ Border#PART_CellInner">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorFillSecondary}" />
                <Setter Property="BorderThickness" Value="{atom:CalendarTokenResource FullCellBorderThickness}" />
                <Setter Property="MinHeight" Value="{Binding $parent[controls:Calendar].EffectiveFullCellMinHeight}" />
                <Setter Property="Padding" Value="{atom:CalendarTokenResource FullCellPadding}" />
            </Style>
            <Style Selector="^[Presentation=Content] /template/ atom|TextBlock#PART_Value">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!-- 今天 -->
            <Style Selector="^[Presentation=Compact]:date:today /template/ Border#PART_CellOutline">
                <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorPrimary}" />
                <Setter Property="BorderThickness" Value="{atom:OwnerTokenResource BorderThickness}" />
            </Style>
            <Style Selector="^[Presentation=Content]:date:today /template/ Border#PART_CellInner">
                <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorPrimary}" />
            </Style>

            <!-- 选中 -->
            <Style Selector="^[Presentation=Compact]:selected:not(:disabled) /template/ Border#PART_CellInner">
                <Setter Property="Background" Value="{atom:OwnerTokenResource ColorPrimary}" />
            </Style>
            <Style Selector="^[Presentation=Content]:selected /template/ Border#PART_CellInner">
                <Setter Property="Background" Value="{atom:CalendarTokenResource ItemActiveBg}" />
            </Style>

            <!-- 键盘焦点：Compact 使用共享焦点描边包围日期块（与日期选择器面板一致，选中的主色块上也清晰可见）；
                 Content 由格子顶部主色线表达，不叠加描边。 -->
            <Style Selector="^[Presentation=Content]">
                <Setter Property="FocusAdorner" Value="{x:Null}" />
            </Style>
            <Style Selector="^[Presentation=Content]:focus-visible /template/ Border#PART_CellInner">
                <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorPrimary}" />
                <Setter Property="BorderThickness" Value="{atom:CalendarTokenResource FullCellBorderThickness}" />
            </Style>

            <!-- 禁用 -->
            <Style Selector="^:disabled">
                <Setter Property="Cursor" Value="Arrow" />
            </Style>
            <Style Selector="^:disabled /template/ Border#PART_Item">
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <Style Selector="^[Presentation=Compact]:disabled">
                <Setter Property="Background" Value="{atom:OwnerTokenResource ColorBgContainerDisabled}" />
            </Style>
            <Style Selector="^[Presentation=Compact]:date:disabled:today /template/ Border#PART_CellOutline">
                <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
            </Style>

            <!-- hover（非禁用非周序号） -->
            <Style Selector="^:pointerover:not(:disabled):not(:week):not(:selected) /template/ Border#PART_CellInner">
                <Setter Property="Background" Value="{atom:OwnerTokenResource ControlItemBgHover}" />
            </Style>
            <Style Selector="^[Presentation=Content]:not(:week) /template/ ContentControl#PART_CellContent">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:cell-template /template/ ContentControl#PART_CellContent">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:full-template /template/ ContentControl#PART_CellContent">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.RowSpan" Value="2" />
                <Setter Property="ContentTemplate" Value="{Binding EffectiveFullCellTemplate, RelativeSource={RelativeSource TemplatedParent}}" />
            </Style>
            <Style Selector="^:full-template /template/ atom|TextBlock#PART_Value">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^[Presentation=Compact]:selected:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextLightSolid}" />
            </Style>
            <Style Selector="^[Presentation=Content]:selected:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorPrimary}" />
            </Style>
            <Style Selector="^:week">
                <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
            </Style>
            <Style Selector="^:outside, ^:disabled">
                <Setter Property="Foreground" Value="{atom:OwnerTokenResource ColorTextDisabled}" />
            </Style>
        </ControlTheme>
</ResourceDictionary>
