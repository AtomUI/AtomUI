<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">

    <ControlTheme x:Key="{x:Type atom:NumericUpDown}" TargetType="atom:NumericUpDown">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:NumericUpDownSpinner
                    Name="PART_Spinner"
                    Classes.semantic-scope-spinner="True"
                    Padding="{TemplateBinding Padding}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                    IsSpinEnabled="{TemplateBinding AllowSpin}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    SizeType="{TemplateBinding SizeType}"
                    StyleVariant="{TemplateBinding StyleVariant}"
                    Status="{TemplateBinding Status}"
                    FormStatus="{TemplateBinding FormStatus}"
                    DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                    IsButtonSpinnerVisible="{TemplateBinding ShowButtonSpinner}"
                    IsButtonSpinnerFloatable="True"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    LeftAddOn="{TemplateBinding LeftAddOn}"
                    LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                    RightAddOn="{TemplateBinding RightAddOn}"
                    RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                    SpinnerHandleWidth="{TemplateBinding SpinnerHandleWidth}"
                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                    <atom:ButtonSpinner.InnerLeftContent>
                        <atom:AddOnContentPresenter
                            Name="PART_InnerLeftContentPresenter"
                            Classes.semantic-prefix="True"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            Focusable="False" />
                    </atom:ButtonSpinner.InnerLeftContent>
                    <atom:NumericUpDownInputPanel Name="PART_InputPanel" LastChildFill="True">
                        <StackPanel Orientation="Horizontal"
                                    Name="PART_SuffixGroup"
                                    Classes.semantic-suffix="True"
                                    DockPanel.Dock="Right"
                                    Spacing="{atom:SharedTokenResource UniformlyPaddingXXS}">
                            <atom:InputClearIconButton
                                Name="PART_ClearButton"
                                Classes.semantic-clear="True"
                                VerticalAlignment="Center"
                                Icon="{TemplateBinding ClearIcon}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                IsPassthroughMouseEvent="False" />
                            <atom:AddOnContentPresenter
                                Name="PART_InnerRightContentPresenter"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Right"
                                Focusable="False"
                                Content="{TemplateBinding InnerRightContent}"
                                ContentTemplate="{TemplateBinding InnerRightContentTemplate}" />
                        </StackPanel>
                        <atom:EmbeddedTextBox
                            Name="PART_TextBox"
                            Classes.semantic-input="True"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Padding="0"
                            FontSize="{TemplateBinding FontSize}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontStyle="{TemplateBinding FontStyle}"
                            FontWeight="{TemplateBinding FontWeight}"
                            TextWrapping="NoWrap"
                            AcceptsReturn="False"
                            DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                            SizeType="Custom"
                            IsCustomFontSize="{TemplateBinding IsCustomFontSize}"
                            IsReadOnly="{TemplateBinding IsReadOnly}"
                            Text="{TemplateBinding Text, Mode=TwoWay}"
                            PlaceholderText="{TemplateBinding PlaceholderText}"
                            PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                        />
                        </atom:NumericUpDownInputPanel>
                </atom:NumericUpDownSpinner>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[Mode=Spinner][ShowButtonSpinner=True]">
            <Setter Property="Template">
                <ControlTemplate>
                    <atom:NumericUpDownSpinner
                        Name="PART_Spinner"
                        Classes.semantic-scope-spinner="True"
                        Padding="{TemplateBinding Padding}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                        IsSpinEnabled="{TemplateBinding AllowSpin}"
                        IsEnabled="{TemplateBinding IsEnabled}"
                        SizeType="{TemplateBinding SizeType}"
                        StyleVariant="{TemplateBinding StyleVariant}"
                        Status="{TemplateBinding Status}"
                        FormStatus="{TemplateBinding FormStatus}"
                        DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                        IsButtonSpinnerVisible="{TemplateBinding ShowButtonSpinner}"
                        IsButtonSpinnerFloatable="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        LeftAddOn="{TemplateBinding LeftAddOn}"
                        LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                        RightAddOn="{TemplateBinding RightAddOn}"
                        RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                        SpinnerHandleWidth="{TemplateBinding SpinnerHandleWidth}"
                        CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                        CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                        IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                        <atom:ButtonSpinner.InnerLeftContent>
                            <!-- Spinner 模式下 prefix 渲染在 −/+ 手柄之间的输入区内；
                                 外边距跟随手柄的 InputPadding token。空内容时 presenter
                                 自折叠（AddOnContentPresenter），外边距随之不占位。 -->
                            <atom:AddOnContentPresenter
                                Name="PART_InnerLeftContentPresenter"
                                Classes.semantic-prefix="True"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"
                                Focusable="False" />
                        </atom:ButtonSpinner.InnerLeftContent>
                        <atom:NumericUpDownInputPanel Name="PART_InputPanel" LastChildFill="True">
                            <StackPanel Orientation="Horizontal"
                                        Name="PART_SuffixGroup"
                                        Classes.semantic-suffix="True"
                                        DockPanel.Dock="Right"
                                        Margin="0,0,8,0"
                                        Spacing="{atom:SharedTokenResource UniformlyPaddingXXS}">
                                <atom:InputClearIconButton
                                    Name="PART_ClearButton"
                                    Classes.semantic-clear="True"
                                    VerticalAlignment="Center"
                                    Icon="{TemplateBinding ClearIcon}"
                                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                    IsPassthroughMouseEvent="False" />
                                <atom:AddOnContentPresenter
                                    Name="PART_InnerRightContentPresenter"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Focusable="False"
                                    Content="{TemplateBinding InnerRightContent}"
                                    ContentTemplate="{TemplateBinding InnerRightContentTemplate}" />
                            </StackPanel>
                            <atom:EmbeddedTextBox
                                Name="PART_TextBox"
                                Classes.semantic-input="True"
                                VerticalContentAlignment="Center"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Padding="0"
                                FontSize="{TemplateBinding FontSize}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight="{TemplateBinding FontWeight}"
                                TextWrapping="NoWrap"
                                AcceptsReturn="False"
                                DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                                SizeType="Custom"
                                IsCustomFontSize="{TemplateBinding IsCustomFontSize}"
                                IsReadOnly="{TemplateBinding IsReadOnly}"
                                Text="{TemplateBinding Text, Mode=TwoWay}"
                                TextAlignment="Center"
                                PlaceholderText="{TemplateBinding PlaceholderText}"
                            PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                            />
                        </atom:NumericUpDownInputPanel>
                    </atom:NumericUpDownSpinner>
                </ControlTemplate>
            </Setter>

        </Style>

        <Setter Property="IsMotionEnabled"
                Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="SpinnerHandleWidth"
                Value="{atom:ButtonSpinnerTokenResource HandleWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="PlaceholderForeground" Value="{atom:SharedTokenResource ColorTextPlaceholder}" />

        <Setter Property="BorderThickness" Value="{atom:NumericUpDownTokenResource BorderThickness}" />
        <Style Selector="^[SizeType=Large]">
            <Setter Property="Padding" Value="{atom:NumericUpDownTokenResource InputPaddingLG}" />
            <Setter Property="CornerRadius" Value="{atom:NumericUpDownTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="Padding" Value="{atom:NumericUpDownTokenResource InputPadding}" />
            <Setter Property="CornerRadius" Value="{atom:NumericUpDownTokenResource BorderRadius}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Padding" Value="{atom:NumericUpDownTokenResource InputPaddingSM}" />
            <Setter Property="CornerRadius" Value="{atom:NumericUpDownTokenResource BorderRadiusSM}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
