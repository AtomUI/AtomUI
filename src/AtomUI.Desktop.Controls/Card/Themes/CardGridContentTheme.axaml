<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CardGridContent}" TargetType="atom:CardGridContent">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <ItemsPresenter Name="PART_ItemsPresenter" ClipToBounds="False">
                            <ItemsPresenter.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <atom:CardGridPanel LineWidth="{atom:CardTokenResource LineWidth}" />
                                </ItemsPanelTemplate>
                            </ItemsPresenter.ItemsPanel>
                        </ItemsPresenter>
                        <Canvas IsHitTestVisible="False">
                            <Path Data="{TemplateBinding SeparatorGeometry}"
                                  Stretch="None"
                                  Fill="{atom:CardTokenResource ColorBorderSecondary}" />
                        </Canvas>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="ClipToBounds" Value="False"/>
    </ControlTheme>
</ResourceDictionary>
