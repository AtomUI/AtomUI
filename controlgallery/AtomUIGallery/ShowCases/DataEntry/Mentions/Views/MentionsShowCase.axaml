<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Mentions.MentionsShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Mentions"
             x:DataType="vm:MentionsViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryShowCaseHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryShowCaseHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Mentions"
                    Category="{gallery:MentionsShowCaseLangResource ComponentCategory}"
                    Status="{gallery:MentionsShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:MentionsShowCaseLangResource PageSubtitle}"
                    Description="{gallery:MentionsShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="TemplatedControl" />
            </gallery:GalleryShowCaseHost.Header>

            <gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>
                <DataTemplate x:DataType="vm:MentionsViewModel">
                    <gallery:SemanticPartPreview Name="MentionsSemanticPreview"
                                                 Title="Mentions"
                                                 SemanticOwner="{Binding #MentionsSemanticOwner}"
                                                 SemanticOwnerType="{x:Type atom:Mentions}">
                        <gallery:SemanticPartPreview.PreviewContent>
                            <atom:Mentions Name="MentionsSemanticOwner"
                                           Width="420"
                                           IsAllowClear="True"
                                           IsMotionEnabled="False"
                                           IsDropDownOpen="True"
                                           IsPopupPinnedOpen="True"
                                           ContentLeftAddOn="prefix"
                                           OptionsSource="{Binding SemanticPreviewOptions}"
                                           PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextInputToMentionPeopleToMentionTag}" />
                        </gallery:SemanticPartPreview.PreviewContent>
                        <gallery:SemanticPartPreview.PartDescriptions>
                            <gallery:SemanticPartDescription
                                Path="root"
                                Description="{gallery:MentionsShowCaseLangResource SemanticRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="prefix"
                                Description="{gallery:MentionsShowCaseLangResource SemanticPrefixDescription}" />
                            <gallery:SemanticPartDescription
                                Path="content"
                                Description="{gallery:MentionsShowCaseLangResource SemanticContentDescription}" />
                            <gallery:SemanticPartDescription
                                Path="placeholder"
                                Description="{gallery:MentionsShowCaseLangResource SemanticPlaceholderDescription}" />
                            <gallery:SemanticPartDescription
                                Path="input"
                                Description="{gallery:MentionsShowCaseLangResource SemanticInputDescription}" />
                            <gallery:SemanticPartDescription
                                Path="clear"
                                Description="{gallery:MentionsShowCaseLangResource SemanticClearDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.root"
                                Description="{gallery:MentionsShowCaseLangResource SemanticPopupRootDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.list"
                                Description="{gallery:MentionsShowCaseLangResource SemanticPopupListDescription}" />
                            <gallery:SemanticPartDescription
                                Path="popup.listItem"
                                Description="{gallery:MentionsShowCaseLangResource SemanticPopupListItemDescription}" />
                        </gallery:SemanticPartPreview.PartDescriptions>
                    </gallery:SemanticPartPreview>
                </DataTemplate>
            </gallery:GalleryShowCaseHost.SemanticPartsContentTemplate>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource BasicTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource BasicDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <atom:Mentions Name="BasicMentions"
                       HorizontalAlignment="Stretch"
                       OptionsSource="{Binding BasicMentionOptions}"
                       DefaultValue="@afc163"/>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource ValueBindingTitle}"
        IsDeferredContentEnabled="True"
        BadgeText="v6.0.8"
        Description="{gallery:MentionsShowCaseLangResource ValueBindingDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <StackPanel Orientation="Vertical" Spacing="12">
            <atom:Mentions HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           IsAllowClear="True"
                           Value="{Binding BoundValue}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <atom:TextBlock VerticalAlignment="Center"
                                Text="{gallery:MentionsShowCaseLangResource P2TextBoundValue}" />
                <atom:TextBlock VerticalAlignment="Center"
                                Text="{Binding BoundValueText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Button SizeType="Small"
                             Command="{Binding SetBoundValueCommand}"
                             Content="{gallery:MentionsShowCaseLangResource P2ContentSetMention}" />
                <atom:Button SizeType="Small"
                             Command="{Binding ClearBoundValueCommand}"
                             Content="{gallery:MentionsShowCaseLangResource P2ContentClear}" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource SizeTypeTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource SizeTypeDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
            <atom:Mentions HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextLarge}"
                           SizeType="Large"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=UserOutlined}" />
            <atom:Mentions HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextMiddle}"
                           SizeType="Middle"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=UserOutlined}" />
            <atom:Mentions HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextSmall}"
                           SizeType="Small"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=UserOutlined}" />
            <atom:Mentions Name="CustomSizeTypeMentions"
                           HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextCustom}"
                           SizeType="Custom"
                           Height="38"
                           FontSize="15"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=UserOutlined}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource VariantsTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource VariantsDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Mentions HorizontalAlignment="Stretch" StyleVariant="Outlined" PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextOutlined}"/>
            <atom:Mentions HorizontalAlignment="Stretch" StyleVariant="Filled" PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextFilled}"/>
            <atom:Mentions HorizontalAlignment="Stretch" StyleVariant="Borderless" PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextBorderless}"/>
            <atom:Mentions HorizontalAlignment="Stretch" StyleVariant="Underlined" PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextUnderlined}"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource AsynchronousLoadingTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource AsynchronousLoadingDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <atom:Mentions HorizontalAlignment="Stretch" OptionsAsyncLoader="{Binding MentionOptionAsyncLoader}"/>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource CustomizeTriggerTokenTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource CustomizeTriggerTokenDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <atom:Mentions HorizontalAlignment="Stretch"
                       TriggerPrefix="{Binding MentionTriggers}"
                       CandidateTriggered="HandleCandidateTriggered"
                       PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextInputToMentionPeopleToMentionTag}"/>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource DisabledOrReadOnlyTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource DisabledOrReadOnlyDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Mentions Name="DisabledMentions"
                           HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           IsEnabled="False"
                           PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextThisIsDisabledMentions}"/>
            <atom:Mentions Name="ReadonlyMentions"
                           HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           PlaceholderText="{gallery:MentionsShowCaseLangResource P2PlaceholderTextThisIsReadonlyMentions}"
                           IsReadOnly="True"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource PlacementTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource PlacementDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <atom:Mentions Name="PlacementMentions"
                       HorizontalAlignment="Stretch"
                       OptionsSource="{Binding BasicMentionOptions}"
                       Placement="Top"/>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource StatusTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource StatusDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Mentions Name="ErrorMentions"
                           HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           Status="Error"
                           DefaultValue="@afc163"/>
            <atom:Mentions Name="WarningMentions"
                           HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           DefaultValue="@afc163"
                           Status="Warning"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource AutoSizeTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource AutoSizeDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <atom:Mentions Name="AutoSizeMentions"
                       HorizontalAlignment="Stretch"
                       OptionsSource="{Binding BasicMentionOptions}"
                       IsAutoSize="True"/>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource WithClearIconTitle}"
        IsDeferredContentEnabled="True"
        Description="{gallery:MentionsShowCaseLangResource WithClearIconDescription}">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <StackPanel Orientation="Vertical" Spacing="10">
            <atom:Mentions Name="ClearableMentions1"
                           HorizontalAlignment="Stretch"
                           OptionsSource="{Binding BasicMentionOptions}"
                           IsAllowClear="True"/>
            <atom:Mentions HorizontalAlignment="Stretch"
                           Name="ClearableMentions2"
                           OptionsSource="{Binding BasicMentionOptions}"
                           IsAllowClear="True"
                           Lines="3"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:MentionsShowCaseLangResource StyleClassTitle}"
        Description="{gallery:MentionsShowCaseLangResource StyleClassDescription}"
        SourceKey="mentions-semantic-part"
        BadgeText="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
        IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:MentionsViewModel">
        <StackPanel HorizontalAlignment="Left" Spacing="20">
            <StackPanel.Styles>
                <Style Selector="atom|Mentions.semantic-styles-demo">
                    <atom:MentionsPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#1890FF" />
                        </Style>
                    </atom:MentionsPrefixStyle>
                    <atom:MentionsPopupRootStyle x:SetterTargetType="Border">
                        <Setter Property="BorderBrush" Value="#1890FF" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:MentionsPopupRootStyle>
                </Style>
                <Style Selector="atom|Mentions.semantic-styles-filled-demo">
                    <atom:MentionsPrefixStyle x:SetterTargetType="ContentPresenter">
                        <Style Selector="^ atom|Icon">
                            <Setter Property="StrokeBrush" Value="#722ED1" />
                        </Style>
                    </atom:MentionsPrefixStyle>
                    <atom:MentionsPopupRootStyle x:SetterTargetType="Border">
                        <Setter Property="BorderBrush" Value="#722ED1" />
                        <Setter Property="BorderThickness" Value="1" />
                    </atom:MentionsPopupRootStyle>
                </Style>
            </StackPanel.Styles>
            <atom:Mentions Classes="semantic-styles-demo"
                           Name="ObjectStylesMentions"
                           Width="300"
                           IsAllowClear="True"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                           OptionsSource="{Binding StyleClassOptions}"
                           PlaceholderText="Object" />
            <atom:Mentions Classes="semantic-styles-demo semantic-styles-filled-demo"
                           Name="FunctionStylesMentions"
                           Width="300"
                           IsAllowClear="True"
                           StyleVariant="Filled"
                           ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=MehOutlined}"
                           OptionsSource="{Binding StyleClassOptions}"
                           PlaceholderText="Function" />
            <atom:Mentions Classes="semantic-styles-demo"
                           Name="MultilineStylesMentions"
                           Width="300"
                           Lines="3"
                           IsAllowClear="True"
                           OptionsSource="{Binding StyleClassOptions}"
                           PlaceholderText="Multiline" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryShowCaseHost>
    </Grid>
</UserControl>
