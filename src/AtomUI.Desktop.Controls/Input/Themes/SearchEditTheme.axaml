<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SearchEdit}" TargetType="atom:SearchEdit" x:DataType="atom:SearchEdit">
        <ControlTheme.Resources>
            <atom:PlaceholderHorizontalAlignmentConverter x:Key="PlaceholderHorizontalAlignmentConverter" />
        </ControlTheme.Resources>
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:SearchEditTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:SearchEditTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <CompiledBindingExtension Path="$self.SizeType" />
                <CompiledBindingExtension Path="$self.IsCustomFontSize" />
                <atom:SearchEditTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:SearchEditTokenResource Kind="FontSize" />
                <atom:SearchEditTokenResource Kind="FontSizeSM" WhenExplicit="True" />
                <atom:SearchEditTokenResource Kind="FontSizeSM" />
                <atom:SearchEditTokenResource Kind="FontSizeLG" WhenExplicit="True" />
                <atom:SearchEditTokenResource Kind="FontSizeLG" />
            </MultiBinding>
        </Setter>
        <Setter Property="Foreground" Value="{atom:SearchEditTokenResource ColorText}" />
        <Setter Property="Template">
            <ControlTemplate>
                <atom:SearchEditDecoratedBox
                    Name="{x:Static atom:AddOnDecoratedBox.AddOnDecoratedBoxPart}"
                    Classes.semantic-scope-input-frame="True"
                    LeftAddOn="{TemplateBinding LeftAddOn}"
                    LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                    RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                    ContentFramePadding="{TemplateBinding Padding}"
                    Foreground="{TemplateBinding Foreground}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    StyleVariant="{TemplateBinding StyleVariant}"
                    SizeType="{TemplateBinding SizeType}"
                    Status="{TemplateBinding Status}"
                    FormStatus="{TemplateBinding FormStatus}"
                    IsInputFocusWithin="{TemplateBinding IsKeyboardFocusWithin}"
                    DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                    SearchButtonStyle="{TemplateBinding SearchButtonStyle}"
                    SearchButtonText="{TemplateBinding SearchButtonText}"
                    SearchButtonTheme="{TemplateBinding SearchButtonTheme}"
                    IsSearchButtonLoading="{TemplateBinding IsOperating}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}"
                    Focusable="True">
                    <atom:SearchEditDecoratedBox.ContentLeftAddOn>
                        <atom:AddOnContentPresenter
                            Classes.semantic-prefix="True"
                            Content="{Binding InnerLeftContent, RelativeSource={RelativeSource AncestorType=atom:SearchEdit}}"
                            ContentTemplate="{Binding InnerLeftContentTemplate, RelativeSource={RelativeSource AncestorType=atom:SearchEdit}}"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            Focusable="False" />
                    </atom:SearchEditDecoratedBox.ContentLeftAddOn>
                    <atom:SearchEditDecoratedBox.ContentRightAddOn>
                        <StackPanel Orientation="Horizontal"
                                    Classes.semantic-suffix="True"
                                    Spacing="{atom:SearchEditTokenResource UniformlyPaddingXXS}">
                            <atom:InputClearIconButton
                                Name="PART_ClearButton"
                                Classes.semantic-clear="True"
                                VerticalAlignment="Center"
                                Icon="{Binding $parent[atom:SearchEdit].ClearIcon}"
                                IsVisible="{Binding $parent[atom:SearchEdit].IsEffectiveShowClearButton}"
                                IsMotionEnabled="{Binding $parent[atom:SearchEdit].IsMotionEnabled}" />
                            <atom:RevealButton
                                Name="PART_RevealButton"
                                VerticalAlignment="Center"
                                IsChecked="{Binding $parent[atom:SearchEdit].RevealPassword, Mode=TwoWay}"
                                IsVisible="{Binding $parent[atom:SearchEdit].IsEnableRevealButton}"
                                IsMotionEnabled="{Binding $parent[atom:SearchEdit].IsMotionEnabled}" />
                            <atom:AddOnContentPresenter
                                Name="InnerRightContentPresenter"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Right"
                                Focusable="False"
                                Content="{Binding $parent[atom:SearchEdit].InnerRightContent}"
                                ContentTemplate="{Binding $parent[atom:SearchEdit].InnerRightContentTemplate}" />
                        </StackPanel>
                    </atom:SearchEditDecoratedBox.ContentRightAddOn>

                    <atom:ScrollViewer
                        Name="PART_ScrollViewer"
                        Cursor="Ibeam"
                        AllowAutoHide="{TemplateBinding ScrollViewer.AllowAutoHide}"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                        IsScrollChainingEnabled="{TemplateBinding ScrollViewer.IsScrollChainingEnabled}">
                        <Panel Classes.semantic-content="True">
                            <atom:TextBlock
                                Name="Placeholder"
                                Classes.semantic-placeholder="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment, Converter={StaticResource PlaceholderHorizontalAlignmentConverter}}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{TemplateBinding PlaceholderForeground}"
                                Text="{TemplateBinding PlaceholderText}"
                                LineHeight="{TemplateBinding LineHeight}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextWrapping="{TemplateBinding TextWrapping}"
                                IsVisible="{TemplateBinding IsPlaceholderTextVisible}" />
                            <atom:InputTextPresenter
                                Name="PART_TextPresenter"
                                Classes.semantic-input="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                CaretBrush="{TemplateBinding CaretBrush}"
                                CaretIndex="{TemplateBinding CaretIndex}"
                                LineHeight="{TemplateBinding LineHeight}"
                                PasswordChar="{TemplateBinding PasswordChar}"
                                RevealPassword="{TemplateBinding RevealPassword}"
                                SelectionBrush="{TemplateBinding SelectionBrush}"
                                SelectionStart="{TemplateBinding SelectionStart}"
                                SelectionEnd="{TemplateBinding SelectionEnd}"
                                SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                Text="{TemplateBinding Text, Mode=TwoWay}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextWrapping="{TemplateBinding TextWrapping}" />
                        </Panel>
                    </atom:ScrollViewer>
                </atom:SearchEditDecoratedBox>
            </ControlTemplate>
        </Setter>
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="SelectionBrush" Value="{atom:SearchEditTokenResource SelectionBackground}" />
        <Setter Property="CaretBrush" Value="{atom:SearchEditTokenResource ColorText}" />
        <Setter Property="SelectionForegroundBrush"
                Value="{atom:SearchEditTokenResource SelectionForeground}" />
        <Setter Property="PlaceholderForeground" Value="{atom:SearchEditTokenResource ColorTextPlaceholder}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />

        <Setter Property="IsMotionEnabled" Value="{atom:SearchEditTokenResource EnableMotion}" />
        <Setter Property="SearchButtonTheme">
            <themes:SearchButtonTheme TargetType="{x:Type atom:Button}" />
        </Setter>

        <Style Selector="^[StyleVariant=Borderless]">
            <Style Selector="^[Status=Error]">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:SearchEditTokenResource ColorErrorText}" />
                </Style>
            </Style>
            <Style Selector="^:error">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:SearchEditTokenResource ColorErrorText}" />
                </Style>
            </Style>
            <Style Selector="^:warning">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:SearchEditTokenResource ColorWarningText}" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^[StyleVariant=Filled]">
            <Style Selector="^[Status=Error]">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:SearchEditTokenResource ColorErrorText}" />
                </Style>
            </Style>
            <Style Selector="^:error">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:SearchEditTokenResource ColorErrorText}" />
                </Style>
            </Style>
            <Style Selector="^:warning">
                <Style Selector="^ /template/ atom|ScrollViewer#PART_ScrollViewer">
                    <Setter Property="Foreground"
                            Value="{atom:SearchEditTokenResource ColorWarningText}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[StyleVariant=Outlined] /template/ atom|SearchEditDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default][IsInnerBoxHover=True],
                         ^[StyleVariant=Underlined] /template/ atom|SearchEditDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default][IsInnerBoxHover=True]">
            <Setter Property="BorderBrush"
                    Value="{atom:SearchEditTokenResource ColorPrimaryHover}" />
        </Style>
        <Style Selector="^:focus-within[StyleVariant=Outlined] /template/ atom|SearchEditDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default],
                         ^:focus-within[StyleVariant=Underlined] /template/ atom|SearchEditDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default]">
            <Setter Property="BorderBrush"
                    Value="{atom:SearchEditTokenResource ColorPrimary}" />
            <Setter Property="BoxShadow"
                    Value="{atom:SearchEditTokenResource InputActiveShadow}" />
        </Style>
        <Style Selector="^:focus-within[StyleVariant=Filled] /template/ atom|SearchEditDecoratedBox#PART_AddOnDecoratedBox[EffectiveStatus=Default]">
            <Setter Property="BorderBrush"
                    Value="{atom:SearchEditTokenResource ColorPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BoxShadow"
                    Value="{atom:SearchEditTokenResource InputActiveShadow}" />
        </Style>

        <Setter Property="BorderThickness" Value="{atom:SearchEditTokenResource BorderThickness}" />
        <Style Selector="^[SizeType=Large]">
            <Setter Property="Padding" Value="{atom:SearchEditTokenResource InputPaddingLG}" />
            <Setter Property="CornerRadius" Value="{atom:SearchEditTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="Padding" Value="{atom:SearchEditTokenResource InputPadding}" />
            <Setter Property="CornerRadius" Value="{atom:SearchEditTokenResource BorderRadius}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Padding" Value="{atom:SearchEditTokenResource InputPaddingSM}" />
            <Setter Property="CornerRadius" Value="{atom:SearchEditTokenResource BorderRadiusSM}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
