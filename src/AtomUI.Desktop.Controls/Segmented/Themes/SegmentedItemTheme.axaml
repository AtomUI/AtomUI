<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:SegmentedItem}" TargetType="atom:SegmentedItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <DockPanel LastChildFill="True">
                        <atom:IconPresenter Name="IconPresenter"
                                            Classes.semantic-icon="True"
                                            Icon="{TemplateBinding Icon}"
                                            IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter Name="Content"
                                          Classes.semantic-label="True"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          TextTrimming="CharacterEllipsis"
                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
            <Setter Property="IconBrush"
                    Value="{atom:SegmentedTokenResource ItemColor}" />
        </Style>

        <Style Selector="^:selected">
            <!-- The selected background is always carried by the track-layer thumb (including while the thumb is
            flying); the item paints no selected background itself, so the target item does not light up early.
            -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{atom:SegmentedTokenResource ItemSelectedColor}" />

            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:SegmentedTokenResource ItemSelectedColor}" />
            </Style>
        </Style>

        <Style Selector="^:not(^:selected)">
            <Setter Property="Foreground" Value="{atom:SegmentedTokenResource ItemColor}" />
            <Setter Property="Background" Value="Transparent" />

            <Style Selector="^:pointerover">
                <Setter Property="Foreground"
                        Value="{atom:SegmentedTokenResource ItemHoverColor}" />
                <Setter Property="Background"
                        Value="{atom:SegmentedTokenResource ItemHoverBg}" />
                <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                    <Setter Property="IconBrush"
                            Value="{atom:SegmentedTokenResource ItemHoverColor}" />
                </Style>
            </Style>

            <Style Selector="^:pressed">
                <Setter Property="Background"
                        Value="{atom:SegmentedTokenResource ItemActiveBg}" />
                <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                    <Setter Property="IconBrush"
                            Value="{atom:SegmentedTokenResource ItemSelectedColor}" />
                </Style>
            </Style>
        </Style>

        <!-- While the thumb flies, the hover/pressed masks of the unselected items are suppressed, as in the antd rule
        thumb ~ item::after transparent.
        -->
        <Style Selector="^[IsThumbMotionActive=True]:not(^:selected)">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <atom:TokenTransitions>
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background"
                                                        atom:TokenTransitions.Duration="MotionDurationMid" />
                        <!-- The text color follows the selected value immediately and softens the switch (the antd item
                        color transition).
                        -->
                        <atom:SolidColorBrushTransition Property="Foreground"
                                                        atom:TokenTransitions.Duration="MotionDurationMid" />
                    </Transitions>
                </atom:TokenTransitions>
            </Setter>
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Transitions">
                    <atom:TokenTransitions>
                        <Transitions>
                            <atom:SolidColorBrushTransition Property="IconBrush"
                                                            atom:TokenTransitions.Duration="MotionDurationMid" />
                        </Transitions>
                    </atom:TokenTransitions>
                </Setter>
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius"
                    Value="{atom:SegmentedTokenResource BorderRadius}" />
            <Setter Property="FontSize"
                    Value="{atom:SegmentedTokenResource FontSizeLG}" />
            <Setter Property="MinHeight"
                    Value="{atom:SegmentedTokenResource ItemMinHeightLG}" />
            <Setter Property="Padding"
                    Value="{atom:SegmentedTokenResource SegmentedItemPadding}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius"
                    Value="{atom:SegmentedTokenResource BorderRadiusSM}" />
            <Setter Property="FontSize"
                    Value="{atom:SegmentedTokenResource FontSize}" />
            <Setter Property="MinHeight"
                    Value="{atom:SegmentedTokenResource ItemMinHeight}" />
            <Setter Property="Padding"
                    Value="{atom:SegmentedTokenResource SegmentedItemPadding}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius"
                    Value="{atom:SegmentedTokenResource BorderRadiusXS}" />
            <Setter Property="FontSize"
                    Value="{atom:SegmentedTokenResource FontSize}" />
            <Setter Property="MinHeight"
                    Value="{atom:SegmentedTokenResource ItemMinHeightSM}" />
            <Setter Property="Padding"
                    Value="{atom:SegmentedTokenResource SegmentedItemPaddingSM}" />
        </Style>

        <Style Selector="^[Shape=Round]">
            <!-- layout: capsule item, a radius larger than any half height -->
            <Setter Property="CornerRadius" Value="9999" />
        </Style>

        <Style Selector="^:has-icon">
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Margin"
                        Value="{atom:SegmentedTokenResource SegmentedItemContentMargin}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width"
                        Value="{atom:SegmentedTokenResource IconSizeLG}" />
                <Setter Property="Height"
                        Value="{atom:SegmentedTokenResource IconSizeLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width"
                        Value="{atom:SegmentedTokenResource IconSize}" />
                <Setter Property="Height"
                        Value="{atom:SegmentedTokenResource IconSize}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width"
                        Value="{atom:SegmentedTokenResource IconSizeSM}" />
                <Setter Property="Height"
                        Value="{atom:SegmentedTokenResource IconSizeSM}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:SegmentedTokenResource ColorTextDisabled}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IconBrush"
                        Value="{atom:SegmentedTokenResource ColorTextDisabled}" />
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
