<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CascaderAddOnDecoratedBox}" TargetType="atom:CascaderAddOnDecoratedBox">
        <ControlTheme.BasedOn>
            <atom:AddOnDecoratedBoxTheme TargetType="atom:CascaderAddOnDecoratedBox" />
        </ControlTheme.BasedOn>

        <Style Selector="^:is(atom|CascaderAddOnDecoratedBox)">
            <Style Selector="^^[IsMultiple=True]">
                <Style Selector="^[IsSelectionEmpty=False]">
                    <Style Selector="^[SizeType=Large]">
                        <Setter Property="PresetContentPadding"
                                Value="{atom:SelectTokenResource MultiModePaddingLG}" />
                        <Setter Property="CompactContentFramePadding"
                                Value="{atom:SelectTokenResource MultiModePaddingSM}" />
                        <Setter Property="ContentMinHeight"
                                Value="{atom:SelectTokenResource MultipleItemHeightLG}" />
                        <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentLeftAddOn">
                            <Setter Property="Margin"
                                    Value="{atom:SelectTokenResource MultiModePrefixIndentLG}" />
                        </Style>
                    </Style>
                    <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                        <Setter Property="PresetContentPadding"
                                Value="{atom:SelectTokenResource MultiModePadding}" />
                        <Setter Property="CompactContentFramePadding"
                                Value="{atom:SelectTokenResource MultiModePaddingSM}" />
                        <Setter Property="ContentMinHeight"
                                Value="{atom:SelectTokenResource MultipleItemHeight}" />
                        <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentLeftAddOn">
                            <Setter Property="Margin"
                                    Value="{atom:SelectTokenResource MultiModePrefixIndent}" />
                        </Style>
                    </Style>
                    <Style Selector="^[SizeType=Small]">
                        <Setter Property="PresetContentPadding"
                                Value="{atom:SelectTokenResource MultiModePaddingSM}" />
                        <Setter Property="CompactContentFramePadding"
                                Value="{atom:SelectTokenResource MultiModePaddingSM}" />
                        <Setter Property="ContentMinHeight"
                                Value="{atom:SelectTokenResource MultipleItemHeightSM}" />
                        <Style Selector="^ /template/ atom|AddOnContentPresenter#PART_ContentLeftAddOn">
                            <Setter Property="Margin"
                                    Value="{atom:SelectTokenResource MultiModePrefixIndentSM}" />
                        </Style>
                    </Style>
                </Style>
                
                <Style Selector="^[IsSelectionEmpty=True]">
                    <Style Selector="^[SizeType=Large]">
                        <Setter Property="PresetContentPadding" Value="{atom:SelectTokenResource SingleModePaddingLG}" />
                    </Style>
                    <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                        <Setter Property="PresetContentPadding" Value="{atom:SelectTokenResource SingleModePadding}" />

                    </Style>
                    <Style Selector="^[SizeType=Small]">
                        <Setter Property="PresetContentPadding" Value="{atom:SelectTokenResource SingleModePadding}" />
                    </Style>
                </Style>
            </Style>

            <Style Selector="^[StyleVariant=Outlined]">
                <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />

                <Style Selector="^[IsInnerBoxHover=True]">
                    <Setter Property="BorderBrush"
                            Value="{atom:CascaderTokenResource ColorPrimaryHover}" />
                </Style>

                <Style Selector="^:focus-within">
                    <Setter Property="BorderBrush"
                            Value="{atom:CascaderTokenResource ColorPrimary}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="BorderBrush"
                            Value="{atom:CascaderTokenResource ColorPrimary}" />
                </Style>
                
                <Style Selector="^[IsDropDownOpen=True]">
                    <Setter Property="BorderBrush"
                            Value="{atom:CascaderTokenResource ColorPrimary}" />
                </Style>

                <Style Selector="^[EffectiveStatus=Error]">
                    <Setter Property="BorderBrush"
                            Value="{atom:SharedTokenResource ColorError}" />

                    <Style Selector="^[IsInnerBoxHover=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorErrorBorderHover}" />
                    </Style>

                    <Style Selector="^:focus-within">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorError}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorError}" />
                    </Style>
                    
                    <Style Selector="^[IsDropDownOpen=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorError}" />
                    </Style>
                </Style>

                <Style Selector="^[EffectiveStatus=Warning]">
                    <Setter Property="BorderBrush"
                            Value="{atom:SharedTokenResource ColorWarning}" />

                    <Style Selector="^[IsInnerBoxHover=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorWarningBorderHover}" />
                    </Style>

                    <Style Selector="^:focus-within">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorWarning}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorWarning}" />
                    </Style>
                    <Style Selector="^[IsDropDownOpen=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorWarning}" />
                    </Style>
                </Style>
            </Style>

            <Style Selector="^[StyleVariant=Filled]">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background"
                        Value="{atom:SharedTokenResource ColorFillTertiary}" />

                <Style Selector="^[IsInnerBoxHover=True]">
                    <Setter Property="Background"
                            Value="{atom:SharedTokenResource ColorFillSecondary}" />
                </Style>

                <Style Selector="^:focus-within">
                    <Setter Property="BorderBrush"
                            Value="{atom:CascaderTokenResource ColorPrimary}" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="BorderBrush"
                            Value="{atom:CascaderTokenResource ColorPrimary}" />
                </Style>
                
                <Style Selector="^[IsDropDownOpen=True]">
                    <Setter Property="BorderBrush"
                            Value="{atom:CascaderTokenResource ColorPrimary}" />
                </Style>

                <Style Selector="^[EffectiveStatus=Error]">
                    <Setter Property="BorderBrush"
                            Value="Transparent" />
                    <Setter Property="Background"
                            Value="{atom:SharedTokenResource ColorErrorBg}" />

                    <Style Selector="^[IsInnerBoxHover=True]">
                        <Setter Property="Background"
                                Value="{atom:SharedTokenResource ColorErrorBgHover}" />
                    </Style>

                    <Style Selector="^:focus-within">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorError}" />
                        <Setter Property="Background"
                                Value="{atom:CascaderTokenResource ColorTransparent}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorError}" />
                    </Style>
                    
                    <Style Selector="^[IsDropDownOpen=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorError}" />
                    </Style>
                </Style>

                <Style Selector="^[EffectiveStatus=Warning]">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Background"
                            Value="{atom:SharedTokenResource ColorWarningBg}" />

                    <Style Selector="^[IsInnerBoxHover=True]">
                        <Setter Property="Background"
                                Value="{atom:SharedTokenResource ColorWarningBgHover}" />
                    </Style>

                    <Style Selector="^:focus-within">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorWarning}" />
                        <Setter Property="Background"
                                Value="{atom:CascaderTokenResource ColorTransparent}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorWarning}" />
                    </Style>
                    
                    <Style Selector="^[IsDropDownOpen=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:SharedTokenResource ColorWarning}" />
                    </Style>
                </Style>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
