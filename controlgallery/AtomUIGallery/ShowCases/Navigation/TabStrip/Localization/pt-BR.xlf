    <unit id="PageDescription">
      <segment>
        <source>TabStrip and CardTabStrip provide lightweight tab navigation for custom content hosts, including item-template tabs, closable tabs, placement control, and add-tab actions.</source>
        <target state="translated">Faixa de guias e CardTabStrip fornecer leve guia navegação para personalizado conteúdo hosts, incluindo item-template guias, closable guias, posicionamento controle, e adicionar-guia ações.</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Render tab headers independently from selected content.</source>
        <target state="translated">Renderizar guia headers independently de selecionado conteúdo.</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">Exemplos</target>
      </segment>
    </unit>
    <unit id="SemanticAddDescription">
      <segment>
        <source>Add element, set size, color and corner radius styles for the plus button</source>
        <target state="translated">Elemento de adição, define tamanho, cor e estilos de raio de canto para o botão de mais</target>
      </segment>
    </unit>
    <unit id="SemanticCloseDescription">
      <segment>
        <source>Close element, set size and color styles for the close button</source>
        <target state="translated">Elemento de fechamento, define tamanho e estilos de cor para o botão de fechar</target>
      </segment>
    </unit>
    <unit id="SemanticIconDescription">
      <segment>
        <source>Icon element, set size and margin styles for the tab icon</source>
        <target state="translated">Elemento de ícone, define tamanho e estilos de margem para o ícone da aba</target>
      </segment>
    </unit>
    <unit id="SemanticItemDescription">
      <segment>
        <source>Item element, set size, padding, hover state and selected state styles for each tab</source>
        <target state="translated">Elemento de item, define tamanho, preenchimento, estado de foco e estado selecionado para cada aba</target>
      </segment>
    </unit>
    <unit id="SemanticLabelDescription">
      <segment>
        <source>Label element, set font and color styles for the tab title</source>
        <target state="translated">Elemento de rótulo, define estilos de fonte e cor para o título da aba</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleDescription">
      <segment>
        <source>Style tabs through generated Semantic Part styles: tab spacing and selected background, icon and title margins, and plus button corner radius.</source>
        <target state="translated">Personalize as abas por meio dos estilos de Semantic Part gerados: espaçamento de abas e fundo selecionado, margens de ícone e título e raio de canto do botão de mais.</target>
      </segment>
    </unit>
    <unit id="SemanticPartStyleTitle">
      <segment>
        <source>Custom Semantic Part styling</source>
        <target state="translated">Estilo personalizado de Semantic Part</target>
      </segment>
    </unit>
    <unit id="SemanticRootDescription">
      <segment>
        <source>Root element, set overall size, padding, border and background styles</source>
        <target state="translated">Elemento raiz, define tamanho geral, preenchimento, borda e estilos de fundo</target>
      </segment>
    </unit>
    <unit id="TabStripAddCloseDescription">
      <segment>
        <source>Hide default plus icon, and bind event for customized trigger.</source>
        <target state="translated">Hide padrão plus ícone, e bind event para customized gatilho.</target>
      </segment>
    </unit>
    <unit id="TabStripAddCloseTitle">
