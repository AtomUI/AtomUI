<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:GradientColorPicker}" TargetType="atom:GradientColorPicker">
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorBlockDisabledOpacity" Value="{atom:GradientColorPickerTokenResource ColorBlockDisabledOpacity}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeColorBlockInnerShadows" Value="{atom:GradientColorPickerTokenResource ColorBlockInnerShadows}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeTransparentBgSize" Value="{atom:GradientColorPickerTokenResource TransparentBgSize}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeTriggerPadding" Value="{atom:GradientColorPickerTokenResource TriggerPadding}" />
        <Setter Property="atom:ColorPickerThemeInputs.ThemeTriggerTextMargin" Value="{atom:GradientColorPickerTokenResource TriggerTextMargin}" />

        <ControlTheme.BasedOn>
            <themes:AbstractColorPickerTheme TargetType="atom:GradientColorPicker" />
        </ControlTheme.BasedOn>

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:PixelAlignedBorder Name="PART_Frame"
                                             BorderThickness="{TemplateBinding BorderThickness}"
                                             BorderBrush="{TemplateBinding BorderBrush}"
                                             CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                             Padding="{TemplateBinding TriggerPadding}"
                                             Background="{TemplateBinding Background}">
                        <DockPanel LastChildFill="True">
                            <atom:ColorBlock Name="PART_ColorIndicator"
                                             Classes.semantic-body="True"
                                             SizeType="{TemplateBinding SizeType}"
                                             Size="{TemplateBinding ColorBlockSize}"
                                             Background="{TemplateBinding ColorBlockBackground}"
                                             VerticalAlignment="Top"
                                             DockPanel.Dock="Left"/>
                            <Panel VerticalAlignment="Center">
                                <WrapPanel Name="PART_ColorTextPanel"
                                           Classes.semantic-description="True"
                                           IsVisible="{TemplateBinding IsTextVisible}">
                                    <WrapPanel.Styles>
                                        <Style Selector=":is(TextBlock).active-stop">
                                            <Setter Property="Foreground"
                                                    Value="{CompiledBinding $parent[atom:GradientColorPicker].InactiveStopTextColor}" />
                                        </Style>
                                    </WrapPanel.Styles>
                                </WrapPanel>
                            </Panel>
                        </DockPanel>
                    </atom:PixelAlignedBorder>
                    <atom:Popup Name="PART_Popup"
                                OpenMotion="{TemplateBinding OpenMotion}"
                                CloseMotion="{TemplateBinding CloseMotion}"
                                IsPopupPinnedOpen="{TemplateBinding IsPopupPinnedOpen}"
                                WindowManagerAddShadowHint="False"
                                IsLightDismissEnabled="{TemplateBinding IsLightDismissEnabled}"
                                IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                ShouldUseOverlayLayer="{TemplateBinding ShouldUseOverlayPopup}"
                                RequestedPlacement="{TemplateBinding Placement}"
                                PlacementAnchor="{TemplateBinding PlacementAnchor}"
                                PlacementGravity="{TemplateBinding PlacementGravity}"
                                IsPointAtCenter="{TemplateBinding IsPointAtCenter}"
                                MarginToAnchor="{TemplateBinding MarginToAnchor}">
                        <atom:ColorPickerPopupRootFrame Classes.semantic-popup-root="True">
                            <atom:ArrowDecoratedBox IsArrowVisible="{TemplateBinding IsArrowVisibleEffective}"
                                                    ArrowPosition="{TemplateBinding ArrowPosition}"
                                                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}">
                                <ContentPresenter Content="{TemplateBinding PickerPresenter}" />
                            </atom:ArrowDecoratedBox>
                        </atom:ColorPickerPopupRootFrame>
                    </atom:Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="InactiveStopTextColor"
                Value="{atom:GradientColorPickerTokenResource ColorTextDisabled}" />
        <Style Selector="^ /template/ WrapPanel#PART_ColorTextPanel">
            <Setter Property="TextElement.Foreground"
                    Value="{atom:GradientColorPickerTokenResource ColorText}" />
            <Setter Property="Margin" Value="{CompiledBinding $self.(atom:ColorPickerThemeInputs.ThemeTriggerTextMargin)}" />
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ WrapPanel#PART_ColorTextPanel">
                <Setter Property="TextElement.Foreground"
                        Value="{atom:GradientColorPickerTokenResource ColorTextDisabled}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
