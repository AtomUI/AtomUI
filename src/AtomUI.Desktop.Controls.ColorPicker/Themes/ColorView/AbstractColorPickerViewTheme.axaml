<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:Class="AtomUI.Desktop.Controls.Themes.AbstractColorPickerViewTheme"
    TargetType="atom:AbstractColorPickerView"
    x:ClassModifier="internal">

    <ControlTheme.Resources>
        <atom:BorderThicknessFilterConverter x:Key="ColorPickerSeparatorBorderConverter" Top="False" Right="False" Bottom="False" />
    </ControlTheme.Resources>
    <Style Selector="^:is(atom|AbstractColorPickerView)">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="Padding" Value="{atom:OwnerTokenResource PaddingXXS}" />
        <Style Selector="^[HostIsMotionEnabled=False]">
            <Setter Property="IsMotionEnabled" Value="False" />
        </Style>
        <Style Selector="^ /template/ atom|GradientColorSlider#PART_GradientColorSlider">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^ /template/ atom|ColorSpectrum#ColorSpectrum">
            <Setter Property="MinHeight"
                    Value="{CompiledBinding $self.(atom:ColorPickerThemeInputs.ThemeColorSpectrumHeight)}" />
            <Setter Property="MinWidth" Value="{CompiledBinding $self.(atom:ColorPickerThemeInputs.ThemeColorPickerWidth)}" />
        </Style>

        <Style Selector="^ /template/ atom|ColorBlock#ColorPreview">
            <Setter Property="Size"
                    Value="{CompiledBinding $self.(atom:ColorPickerThemeInputs.ThemeColorPickerPreviewSize)}" />
        </Style>

        <Style Selector="^ /template/ StackPanel#ColorPickerContainer">
            <Setter Property="Spacing" Value="{atom:OwnerTokenResource SpacingSM}" />
        </Style>

        <Style Selector="^ /template/ Panel#SliderContainer">
            <Setter Property="Margin"
                    Value="{CompiledBinding $self.(atom:ColorPickerThemeInputs.ThemeSliderContainerMargin)}" />
        </Style>

        <Style Selector="^[IsAlphaEffectiveVisible=False]">
            <Style Selector="^ /template/ atom|ColorSlider#ColorSpectrumThirdComponentSlider">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>
        
        <Style Selector="^ /template/ atom|PixelAlignedBorder#Separator">
            <Setter Property="BorderBrush" Value="{atom:OwnerTokenResource ColorBorderSecondary}"/>
            <Setter Property="BorderThickness" Value="{CompiledBinding $self.(atom:ColorPickerThemeInputs.ThemeSeparatorThickness), Converter={StaticResource ColorPickerSeparatorBorderConverter}}" />
        </Style>
        
        <Style Selector="^ /template/ StackPanel#PART_LayoutRoot">
            <Setter Property="Spacing" Value="{atom:OwnerTokenResource SpacingXS}"/>
        </Style>
    </Style>
</ControlTheme>
