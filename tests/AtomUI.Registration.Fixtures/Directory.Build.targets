<Project>
    <Import Project="../../Directory.Build.targets" />
    <ItemGroup Condition="'$(FixtureFullRegistrationDescriptor)' != ''">
        <TrimmerRootDescriptor Include="$(FixtureFullRegistrationDescriptor)" />
    </ItemGroup>
    <!-- Fault injection only: production consumers never configure the backend. -->
    <Target Name="FixtureOverrideTypeMapBackend" BeforeTargets="AtomUIPrepareTypeMapBackend" Condition="'$(FixtureTypeMapBackendOverride)' != ''">
        <ItemGroup>
            <AtomUIRegistrationToolCandidate Remove="@(AtomUIRegistrationToolCandidate->WithMetadataValue('Kind', 'Backend'))" />
            <AtomUIRegistrationToolCandidate Include="$(FixtureTypeMapBackendOverride)" Kind="Backend" />
        </ItemGroup>
    </Target>
</Project>
