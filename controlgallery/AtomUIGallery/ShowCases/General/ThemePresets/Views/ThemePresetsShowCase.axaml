<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.ThemePresets"
             xmlns:theme="using:AtomUI.Theme"
             x:Class="AtomUIGallery.ShowCases.ThemePresets.ThemePresetsShowCase"
             x:DataType="vm:ThemePresetsViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost>
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader Title="{vm:ThemePresetsShowCaseLangResource PageTitle}"
                    Category="{vm:ThemePresetsShowCaseLangResource ComponentCategory}"
                    Subtitle="{vm:ThemePresetsShowCaseLangResource PageSubtitle}"
                    Description="{vm:ThemePresetsShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Theme" Package="AtomUI.Core" BaseClass="ThemeConfigProvider" />
            </gallery:GalleryStickyTabsHost.Header>
            <StackPanel Margin="28,10,28,28" Spacing="20">
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemePresetItem">
                            <atom:Button Margin="0,0,12,8" Click="SelectPreset">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="12" Height="12" Fill="{Binding AccentBrush}" IsVisible="{Binding !HasIcon}" />
                                    <ContentControl Content="{Binding Symbol}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </atom:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Orientation="Horizontal">
                    <atom:CheckBox Name="DarkMode" Content="{vm:ThemePresetsShowCaseLangResource Dark}" IsChecked="{Binding IsDark, Mode=TwoWay}" Margin="0,0,20,8" />
                    <atom:CheckBox Name="CompactMode" Content="{vm:ThemePresetsShowCaseLangResource Compact}" IsChecked="{Binding IsCompact, Mode=TwoWay}" Margin="0,0,20,8" />
                    <atom:Button Name="CopyThemeButton" Content="{vm:ThemePresetsShowCaseLangResource CopyTheme}" Command="{Binding CopyThemeXml}" />
                    <TextBlock Name="CopySuccessFeedback" Margin="12,6,0,0" Text="{vm:ThemePresetsShowCaseLangResource Copied}" IsVisible="{Binding CopySucceeded}" />
                    <TextBlock Name="CopyFailureFeedback" Margin="12,6,0,0" Text="{vm:ThemePresetsShowCaseLangResource CopyFailed}" IsVisible="{Binding CopyFailed}" />
                </WrapPanel>
                <TextBlock Text="{Binding PreviewThemeId}" />
                <theme:ThemeConfigProvider Name="PreviewProvider" Config="{Binding PreviewConfig}">
                    <Border Background="{atom:SharedTokenResource ColorBgContainer}" TextElement.Foreground="{atom:SharedTokenResource ColorText}" Padding="24" CornerRadius="{atom:SharedTokenResource BorderRadiusLG}">
                        <Grid>
                        <StackPanel Spacing="24">
                            <WrapPanel Orientation="Horizontal">
                                <atom:Button Name="PreviewPrimary" ButtonType="Primary" Content="{vm:ThemePresetsShowCaseLangResource Primary}" Margin="0,0,12,8" />
                                <atom:Button Content="{vm:ThemePresetsShowCaseLangResource Default}" Margin="0,0,12,8" />
                                <atom:Button ButtonType="Dashed" Content="{vm:ThemePresetsShowCaseLangResource Dashed}" Margin="0,0,12,8" />
                                <atom:Button ButtonType="Text" Content="{vm:ThemePresetsShowCaseLangResource Text}" Margin="0,0,12,8" />
                                <atom:Button ButtonType="Link" Content="{vm:ThemePresetsShowCaseLangResource Link}" />
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal">
                                <atom:LineEdit Name="PreviewInput" Width="180" PlaceholderText="{vm:ThemePresetsShowCaseLangResource Placeholder}" Margin="0,0,12,8" />
                                <atom:NumericUpDown Width="130" Value="42" Margin="0,0,12,8" />
                                <atom:Select Width="160" OptionsSource="{Binding People}" Margin="0,0,12,8" />
                                <atom:DatePicker Width="180" />
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal">
                                <atom:CheckBox IsChecked="True" Content="{vm:ThemePresetsShowCaseLangResource Option}" Margin="0,0,20,0" />
                                <atom:RadioButton IsChecked="True" Content="{vm:ThemePresetsShowCaseLangResource Option}" Margin="0,0,20,0" />
                                <atom:ToggleSwitch IsChecked="True" Margin="0,0,20,0" />
                                <atom:Slider Width="200" Value="35" />
                            </WrapPanel>
                            <atom:TabControl>
                                <atom:TabItem Header="{vm:ThemePresetsShowCaseLangResource TabOne}"><TextBlock Text="{vm:ThemePresetsShowCaseLangResource CardBody}" Margin="0,12" /></atom:TabItem>
                                <atom:TabItem Header="{vm:ThemePresetsShowCaseLangResource TabTwo}"><TextBlock Text="{vm:ThemePresetsShowCaseLangResource CardBody}" Margin="0,12" /></atom:TabItem>
                            </atom:TabControl>
                            <atom:Steps Current="1">
                                <atom:StepsItem Header="{vm:ThemePresetsShowCaseLangResource Finished}" />
                                <atom:StepsItem Header="{vm:ThemePresetsShowCaseLangResource Current}" />
                                <atom:StepsItem Header="{vm:ThemePresetsShowCaseLangResource Waiting}" />
                            </atom:Steps>
                            <atom:ProgressBar Value="65" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <atom:Tag Text="{vm:ThemePresetsShowCaseLangResource Preview}" TagColor="Green" />
                                <atom:CountBadge Count="5"><atom:Button Content="{vm:ThemePresetsShowCaseLangResource Notification}" Click="ShowNotification" /></atom:CountBadge>
                                <atom:Button Content="{vm:ThemePresetsShowCaseLangResource OpenDialog}" Click="OpenDialog" />
                            </StackPanel>
                            <atom:Alert Message="{vm:ThemePresetsShowCaseLangResource Alert}" Type="Success" />
                            <atom:Card Header="{vm:ThemePresetsShowCaseLangResource CardTitle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{vm:ThemePresetsShowCaseLangResource CardBody}" />
                                    <atom:DataGrid Height="150" ItemsSource="{Binding PreviewSource}" AutoGenerateColumns="False">
                                        <atom:DataGrid.Columns>
                                            <atom:DataGridTextColumn x:DataType="vm:PreviewRow" Header="{vm:ThemePresetsShowCaseLangResource Name}" FieldId="{x:Static vm:ThemePresetsViewModel.NameField}" Binding="{Binding Name}" Width="*" />
                                            <atom:DataGridTextColumn x:DataType="vm:PreviewRow" Header="{vm:ThemePresetsShowCaseLangResource Role}" FieldId="{x:Static vm:ThemePresetsViewModel.RoleField}" Binding="{Binding Role}" Width="*" />
                                        </atom:DataGrid.Columns>
                                    </atom:DataGrid>
                                </StackPanel>
                            </atom:Card>
                            <atom:Dialog Name="PreviewDialog" Title="{vm:ThemePresetsShowCaseLangResource Preview}" IsModal="False" StandardButtons="Ok,Cancel" HostMinWidth="320" HostMaxWidth="480">
                                <TextBlock Text="{vm:ThemePresetsShowCaseLangResource CardBody}" />
                            </atom:Dialog>
                        </StackPanel>
                        <Panel Name="NotificationOverlay" IsHitTestVisible="True" />
                        </Grid>
                    </Border>
                </theme:ThemeConfigProvider>
            </StackPanel>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
