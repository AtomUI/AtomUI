<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImageGroupPreviewer}" TargetType="atom:ImageGroupPreviewer">
        <Setter Property="FontFamily">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontFamilyConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontFamily" />
                <atom:OwnerTokenResource Kind="FontFamily" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontFamily" />
            </MultiBinding>
        </Setter>
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static atom:ControlTypographyBindings.FontSizeConverter}">
                <x:Static Member="atom:ControlTypographyBindings.InheritedFontSize" />
                <atom:OwnerTokenResource Kind="FontSize" WhenExplicit="True" />
                <atom:OwnerTokenResource Kind="FontSize" />
            </MultiBinding>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Background="{TemplateBinding Background}"
                                         Padding="{TemplateBinding Padding}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding CornerRadius}">
                    <ItemsControl Name="PART_CoverItemsControl"
                                  Classes.semantic-scope-items="True"
                                  ItemsSource="{TemplateBinding EffectiveItems}"
                                  ItemsPanel="{TemplateBinding ItemsPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="atom:ImagePreviewEntry">
                                <atom:ImagePreviewerCover ImageSource="{Binding ThumbnailImage}"
                                                          OwnerPadding="{Binding Padding, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          OwnerBorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          OwnerCornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          IsLoading="{Binding IsThumbnailLoading}"
                                                          IsFailed="{Binding IsThumbnailFailed}"
                                                          LoadingContent="{Binding LoadingContent, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          LoadingContentTemplate="{Binding LoadingContentTemplate, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          ErrorContent="{Binding ErrorContent, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          ErrorContentTemplate="{Binding ErrorContentTemplate, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          Width="{Binding CoverWidth, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}"
                                                          Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType=atom:ImageGroupPreviewer}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="CoverWidth" Value="{atom:ImagePreviewerTokenResource CoverImageWidth}" />
        <Setter Property="IsMotionEnabled" Value="{atom:OwnerTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        
    </ControlTheme>
</ResourceDictionary>
