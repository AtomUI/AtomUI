# SkeletonParagraph).
# Keep in step with tests/AtomUI.Generator.Tests/ThemeAssets/MigratedFamilyAnalyzerGateTests.cs.
[{ListBox,ListView,TreeView,Skeleton}/**]
dotnet_diagnostic.ATOMUIGEN041.severity = error
dotnet_diagnostic.ATOMUIGEN042.severity = error
dotnet_diagnostic.ATOMUIGEN043.severity = error
dotnet_diagnostic.ATOMUIGEN044.severity = error
dotnet_diagnostic.ATOMUIGEN045.severity = error
dotnet_diagnostic.ATOMUIGEN047.severity = error
