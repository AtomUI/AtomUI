<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:WaveSpiritDecorator}" TargetType="atom:WaveSpiritDecorator">
        <Setter Property="WaveBrush" Value="{atom:OwnerTokenResource ColorPrimary}"/>
        <Setter Property="UseOwnerWaveTokenResources" Value="True"/>
    </ControlTheme>
</ResourceDictionary>
